    "chapter": "150",
    "verse": "1",
    "text": "Halelujah. Chvalte Boha silného pro svatost jeho, chvalte jej pro rozšíření síly jeho."
  },
  {
    "id": 30760,
    "book": "psalms                                  ",
    "chapter": "150",
    "verse": "2",
    "text": "Chvalte jej ze všelijaké moci jeho, chvalte jej podlé veliké důstojnosti jeho."
  },
  {
    "id": 30761,
    "book": "psalms                                  ",
    "chapter": "150",
    "verse": "3",
    "text": "Chvalte jej zvukem trouby, chvalte jej na loutnu a citaru."
  },
  {
    "id": 30762,
    "book": "psalms                                  ",
    "chapter": "150",
    "verse": "4",
    "text": "Chvalte jej na buben a píšťalu, chvalte jej na husle a varhany."
