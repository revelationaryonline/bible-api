[
  {
    "id": 23054,
    "book": "secondSamuel                            ",
    "chapter": "22",
    "verse": "1",
    "text": "E DAVIDE proferì al Signore le parole di questo cantico22.1 cantico Esod. 15.1. Giud. 5.1., al giorno che il Signore l'ebbe riscosso dalla mano di tutti i suoi nemici, e dalla mano di Saulle22.1 Saulle Sal. 34.19.;"
  },
  {
    "id": 23055,
    "book": "secondSamuel                            ",
    "chapter": "22",
    "verse": "2",
    "text": "e disse:"
  },
  {
    "id": 23056,
    "book": "secondSamuel                            ",
    "chapter": "22",
    "verse": "3",
    "text": "Egli è l'Iddio della mia rupe, io spererò in lui;"
  },
  {
    "id": 23057,
    "book": "secondSamuel                            ",
    "chapter": "22",
    "verse": "4",
    "text": "Io invocai il Signore, al quale appartiene ogni lode,"
  },
  {
    "id": 23058,
    "book": "secondSamuel                            ",
    "chapter": "22",
    "verse": "5",
    "text": "Perciocchè onde di morte mi aveano intorniato,"
  },
  {
    "id": 23059,
    "book": "secondSamuel                            ",
    "chapter": "22",
    "verse": "6",
    "text": "Legami di sepolcro22.6 sepolcro Sal. 116.3 ecc., mi aveano circondato,"
  },
  {
    "id": 23060,
    "book": "secondSamuel                            ",
    "chapter": "22",
    "verse": "7",
    "text": "Mentre io era distretto, io invocai il Signore22.7 Signore Sal. 120.1 ecc. Gion. 2.2.,"
  },
  {
    "id": 23061,
    "book": "secondSamuel                            ",
    "chapter": "22",
    "verse": "8",
    "text": "Allora la terra fu smossa, e tremò;"
  },
  {
    "id": 23062,
    "book": "secondSamuel                            ",
    "chapter": "22",
    "verse": "9",
    "text": "Fumo gli saliva per le nari,"
  },
  {
    "id": 23063,
    "book": "secondSamuel                            ",
    "chapter": "22",
    "verse": "10",
    "text": "Ed egli abbassò i cieli22.10 cieli Sal. 144.5. Is. 64.1., e discese,"
  },
  {
    "id": 23064,
    "book": "secondSamuel                            ",
    "chapter": "22",
    "verse": "11",
    "text": "E cavalcava sopra Cherubini, e volava,"
  },
  {
    "id": 23065,
    "book": "secondSamuel                            ",
    "chapter": "22",
    "verse": "12",
    "text": "Ed avea poste d'intorno a sè, per tabernacoli, tenebre,"
  },
  {
    "id": 23066,
    "book": "secondSamuel                            ",
    "chapter": "22",
    "verse": "13",
    "text": "Dallo splendore che scoppiava davanti a lui,"
  },
  {
    "id": 23067,
    "book": "secondSamuel                            ",
    "chapter": "22",
    "verse": "14",
    "text": "Il Signore tonò dal cielo22.14 cielo Giud. 5.20. 1 Sam. 7.10.,"
  },
  {
    "id": 23068,
    "book": "secondSamuel                            ",
    "chapter": "22",
    "verse": "15",
    "text": "Ed avventò saette, e disperse coloro;"
  },
  {
    "id": 23069,
    "book": "secondSamuel                            ",
    "chapter": "22",
    "verse": "16",
    "text": "E, per lo sgridare del Signore,"
  },
  {
    "id": 23070,
    "book": "secondSamuel                            ",
    "chapter": "22",
    "verse": "17",
    "text": "Egli da alto distese la mano,"
  },
  {
    "id": 23071,
    "book": "secondSamuel                            ",
    "chapter": "22",
    "verse": "18",
    "text": "Egli mi riscosse dal mio potente nemico,"
  },
  {
    "id": 23072,
    "book": "secondSamuel                            ",
    "chapter": "22",
    "verse": "19",
    "text": "Essi mi erano venuti incontro al giorno della mia calamità;"
  },
  {
    "id": 23073,
    "book": "secondSamuel                            ",
    "chapter": "22",
    "verse": "20",
    "text": "E mi trasse fuori in luogo largo;"
  },
  {
    "id": 23074,
    "book": "secondSamuel                            ",
    "chapter": "22",
    "verse": "21",
    "text": "Il Signore mi ha fatta la retribuzione secondo la mia giustizia22.21 giustizia 1 Sam. 26.23. 1 Re. 8.32.;"
  },
  {
    "id": 23075,
    "book": "secondSamuel                            ",
    "chapter": "22",
    "verse": "22",
    "text": "Perciocchè io ho osservate le vie del Signore22.22 Signore Gen. 18.19. Sal. 119.3; 128.1. Prov. 8.32.,"
  },
  {
    "id": 23076,
    "book": "secondSamuel                            ",
    "chapter": "22",
    "verse": "23",
    "text": "Perciocchè io ho tenute davanti agli occhi tutte le sue leggi,"
  },
  {
    "id": 23077,
    "book": "secondSamuel                            ",
    "chapter": "22",
    "verse": "24",
    "text": "E sono stato intiero inverso lui,"
  },
  {
    "id": 23078,
    "book": "secondSamuel                            ",
    "chapter": "22",
    "verse": "25",
    "text": "E il Signore mi ha fatta la retribuzione secondo la mia giustizia,"
  },
  {
    "id": 23079,
    "book": "secondSamuel                            ",
    "chapter": "22",
    "verse": "26",
    "text": "Tu ti mostri pietoso inverso il pio22.26 pio Mat. 5.7.,"
  },
  {
    "id": 23080,
    "book": "secondSamuel                            ",
    "chapter": "22",
    "verse": "27",
    "text": "Puro inverso il puro,"
  },
  {
    "id": 23081,
    "book": "secondSamuel                            ",
    "chapter": "22",
    "verse": "28",
    "text": "E salvi la gente afflitta22.28 afflitta Esod. 3.7,8. Sal. 72.12,13.,"
  },
  {
    "id": 23082,
    "book": "secondSamuel                            ",
    "chapter": "22",
    "verse": "29",
    "text": "Perciocchè tu sei la mia lampana, o Signore;"
  },
  {
    "id": 23083,
    "book": "secondSamuel                            ",
    "chapter": "22",
    "verse": "30",
    "text": "Perciocchè per te io rompo tutta una schiera;"
  },
  {
    "id": 23084,
    "book": "secondSamuel                            ",
    "chapter": "22",
    "verse": "31",
    "text": "La via di Dio è intiera22.31 intiera Deut. 32.4. Apoc. 15.3.;"
  },
  {
    "id": 23085,
    "book": "secondSamuel                            ",
    "chapter": "22",
    "verse": "32",
    "text": "Perciocchè, chi è Dio, fuor che il Signore22.32 Signore 1 Sam. 2.2. Is. 45.5,6.?"
  },
  {
    "id": 23086,
    "book": "secondSamuel                            ",
    "chapter": "22",
    "verse": "33",
    "text": "Iddio è la mia forza; e il mio valore22.33 valore Sal. 27.1; 28.7,8; 31.4. Is. 12.2.;"
  },
  {
    "id": 23087,
    "book": "secondSamuel                            ",
    "chapter": "22",
    "verse": "34",
    "text": "Egli rende i miei piedi simili a quelli delle cerve,"
  },
  {
    "id": 23088,
    "book": "secondSamuel                            ",
    "chapter": "22",
    "verse": "35",
    "text": "Egli ammaestra le mie mani alla battaglia,"
  },
  {
    "id": 23089,
    "book": "secondSamuel                            ",
    "chapter": "22",
    "verse": "36",
    "text": "Tu mi hai ancora dato lo scudo della tua salvezza,"
  },
  {
    "id": 23090,
    "book": "secondSamuel                            ",
    "chapter": "22",
    "verse": "37",
    "text": "Tu hai allargati i miei passi sotto me,"
  },
  {
    "id": 23091,
    "book": "secondSamuel                            ",
    "chapter": "22",
    "verse": "38",
    "text": "Io ho perseguiti i miei nemici, e li ho sterminati;"
  },
  {
    "id": 23092,
    "book": "secondSamuel                            ",
    "chapter": "22",
    "verse": "39",
    "text": "Io li ho distrutti, e li ho trafitti, e non son potuti risorgere;"
  },
  {
    "id": 23093,
    "book": "secondSamuel                            ",
    "chapter": "22",
    "verse": "40",
    "text": "E tu mi hai cinto di prodezza per la guerra;"
  },
  {
    "id": 23094,
    "book": "secondSamuel                            ",
    "chapter": "22",
    "verse": "41",
    "text": "Ed hai fatte voltar le spalle a' miei nemici22.41 nemici Esod. 23.27.,"
  },
  {
    "id": 23095,
    "book": "secondSamuel                            ",
    "chapter": "22",
    "verse": "42",
    "text": "Essi riguardavano in qua ed in là, ma non vi fu chi li salvasse;"
  },
  {
    "id": 23096,
    "book": "secondSamuel                            ",
    "chapter": "22",
    "verse": "43",
    "text": "Ed io li ho stritolati minuto come polvere della terra;"
  },
  {
    "id": 23097,
    "book": "secondSamuel                            ",
    "chapter": "22",
    "verse": "44",
    "text": "Tu mi hai ancora scampato dalle brighe del mio popolo22.44 popolo 2 Sam. 3.1; 5.1; 19.9 ecc.; 20.1 ecc.;"
  },
  {
    "id": 23098,
    "book": "secondSamuel                            ",
    "chapter": "22",
    "verse": "45",
    "text": "Gli stranieri si sono infinti inverso me;"
  },
  {
    "id": 23099,
    "book": "secondSamuel                            ",
    "chapter": "22",
    "verse": "46",
    "text": "Gli stranieri son divenuti fiacchi,"
  },
  {
    "id": 23100,
    "book": "secondSamuel                            ",
    "chapter": "22",
    "verse": "47",
    "text": "Viva il Signore, e benedetta sia la mia Rocca;"
  },
  {
    "id": 23101,
    "book": "secondSamuel                            ",
    "chapter": "22",
    "verse": "48",
    "text": "Iddio è quel che mi dà modo di far le mie vendette,"
  },
  {
    "id": 23102,
    "book": "secondSamuel                            ",
    "chapter": "22",
    "verse": "49",
    "text": "Ed è quel che mi trae fuori da' miei nemici;"
  },
  {
    "id": 23103,
    "book": "secondSamuel                            ",
    "chapter": "22",
    "verse": "50",
    "text": "Perciò, o Signore, io ti celebrerò fra le nazioni,"
  },
  {
    "id": 23104,
    "book": "secondSamuel                            ",
    "chapter": "22",
    "verse": "51",
    "text": "Il quale rende magnifiche le vittorie del suo re,"
  }
]