[
  {
    "id": 20232,
    "book": "judges                                  ",
    "chapter": "5",
    "verse": "1",
    "text": "ORA in quel giorno, Debora, con Barac, figliuolo di Abinoam, cantò questo Cantico5.1 Cantico Esod. 15.1 e rif., dicendo:"
  },
  {
    "id": 20233,
    "book": "judges                                  ",
    "chapter": "5",
    "verse": "2",
    "text": "Benedite il Signore:"
  },
  {
    "id": 20234,
    "book": "judges                                  ",
    "chapter": "5",
    "verse": "3",
    "text": "Ascoltate, o re; e voi principi, porgete le orecchie5.3 orecchie Deut. 32.1 ecc. Sal. 2.10.;"
  },
  {
    "id": 20235,
    "book": "judges                                  ",
    "chapter": "5",
    "verse": "4",
    "text": "O Signore, quando tu uscisti di Seir,"
  },
  {
    "id": 20236,
    "book": "judges                                  ",
    "chapter": "5",
    "verse": "5",
    "text": "I monti colarono, per la presenza del Signore;"
  },
  {
    "id": 20237,
    "book": "judges                                  ",
    "chapter": "5",
    "verse": "6",
    "text": "Al tempo di Samgar5.6 Samgar Giud. 3.31 e rif., figliuolo di Anat;"
  },
  {
    "id": 20238,
    "book": "judges                                  ",
    "chapter": "5",
    "verse": "7",
    "text": "Le villate in Israele erano venute meno;"
  },
  {
    "id": 20239,
    "book": "judges                                  ",
    "chapter": "5",
    "verse": "8",
    "text": "Quando Israele ha scelti nuovi dii,"
  },
  {
    "id": 20240,
    "book": "judges                                  ",
    "chapter": "5",
    "verse": "9",
    "text": "Il cuor mio è inverso i rettori d'Israele,"
  },
  {
    "id": 20241,
    "book": "judges                                  ",
    "chapter": "5",
    "verse": "10",
    "text": "Voi, che cavalcate asine bianche,"
  },
  {
    "id": 20242,
    "book": "judges                                  ",
    "chapter": "5",
    "verse": "11",
    "text": "Essendo lo strepito degli arcieri venuto meno,"
  },
  {
    "id": 20243,
    "book": "judges                                  ",
    "chapter": "5",
    "verse": "12",
    "text": "Destati, destati, Debora;"
  },
  {
    "id": 20244,
    "book": "judges                                  ",
    "chapter": "5",
    "verse": "13",
    "text": "A tal'ora il Signore ha fatto signoreggiare colui ch'era scampato;"
  },
  {
    "id": 20245,
    "book": "judges                                  ",
    "chapter": "5",
    "verse": "14",
    "text": "Da Efraim, da coloro la cui radice è in Amalec,"
  },
  {
    "id": 20246,
    "book": "judges                                  ",
    "chapter": "5",
    "verse": "15",
    "text": "I principali d'Issacar sono stati anch'essi con Debora,"
  },
  {
    "id": 20247,
    "book": "judges                                  ",
    "chapter": "5",
    "verse": "16",
    "text": "Perchè sei tu dimorato fra le sbarre delle stalle,"
  },
  {
    "id": 20248,
    "book": "judges                                  ",
    "chapter": "5",
    "verse": "17",
    "text": "Galaad è dimorato di là dal Giordano;"
  },
  {
    "id": 20249,
    "book": "judges                                  ",
    "chapter": "5",
    "verse": "18",
    "text": "Zabulon è un popolo che ha esposta la sua vita alla morte;"
  },
  {
    "id": 20250,
    "book": "judges                                  ",
    "chapter": "5",
    "verse": "19",
    "text": "I re son venuti, hanno combattuto;"
  },
  {
    "id": 20251,
    "book": "judges                                  ",
    "chapter": "5",
    "verse": "20",
    "text": "Ei s'è combattuto dal cielo;"
  },
  {
    "id": 20252,
    "book": "judges                                  ",
    "chapter": "5",
    "verse": "21",
    "text": "Il torrente di Chison li ha strascinati via;"
  },
  {
    "id": 20253,
    "book": "judges                                  ",
    "chapter": "5",
    "verse": "22",
    "text": "Allora i cavalli si tritarono l'unghie,"
  },
  {
    "id": 20254,
    "book": "judges                                  ",
    "chapter": "5",
    "verse": "23",
    "text": "Maledite Meroz, ha detto l'Angelo del Signore;"
  },
  {
    "id": 20255,
    "book": "judges                                  ",
    "chapter": "5",
    "verse": "24",
    "text": "Sia benedetta, sopra tutte le donne, Iael,"
  },
  {
    "id": 20256,
    "book": "judges                                  ",
    "chapter": "5",
    "verse": "25",
    "text": "Egli chiese dell'acqua, ed ella gli diè del latte;"
  },
  {
    "id": 20257,
    "book": "judges                                  ",
    "chapter": "5",
    "verse": "26",
    "text": "Ella diè della man sinistra al piuolo,"
  },
  {
    "id": 20258,
    "book": "judges                                  ",
    "chapter": "5",
    "verse": "27",
    "text": "Egli si chinò fra i piedi di essa,"
  },
  {
    "id": 20259,
    "book": "judges                                  ",
    "chapter": "5",
    "verse": "28",
    "text": "La madre di Sisera riguardava per la finestra;"
  },
  {
    "id": 20260,
    "book": "judges                                  ",
    "chapter": "5",
    "verse": "29",
    "text": "Le più savie delle sue dame le rispondevano,"
  },
  {
    "id": 20261,
    "book": "judges                                  ",
    "chapter": "5",
    "verse": "30",
    "text": "Non hanno essi trovata la preda5.30 preda Esod. 15.9.? non la spartiscono essi?"
  },
  {
    "id": 20262,
    "book": "judges                                  ",
    "chapter": "5",
    "verse": "31",
    "text": "Così periscano, o Signore, tutti i tuoi nemici;"
  },
  {
    "id": 20263,
    "book": "judges                                  ",
    "chapter": "5",
    "verse": "32",
    "text": "Poi il paese ebbe riposo quarant'anni."
  }
]