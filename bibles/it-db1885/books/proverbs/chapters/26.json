[
  {
    "id": 28113,
    "book": "proverbs                                ",
    "chapter": "26",
    "verse": "1",
    "text": "Come la neve non si conviene alla state,"
  },
  {
    "id": 28114,
    "book": "proverbs                                ",
    "chapter": "26",
    "verse": "2",
    "text": "Come il passero vaga, e la rondinella vola,"
  },
  {
    "id": 28115,
    "book": "proverbs                                ",
    "chapter": "26",
    "verse": "3",
    "text": "La sferza al cavallo, ed il capestro all'asino,"
  },
  {
    "id": 28116,
    "book": "proverbs                                ",
    "chapter": "26",
    "verse": "4",
    "text": "Non rispondere allo stolto secondo la sua follia;"
  },
  {
    "id": 28117,
    "book": "proverbs                                ",
    "chapter": "26",
    "verse": "5",
    "text": "Rispondi allo stolto, come si conviene alla sua follia26.5 follia Mat. 16.1-4; 21.23-27.;"
  },
  {
    "id": 28118,
    "book": "proverbs                                ",
    "chapter": "26",
    "verse": "6",
    "text": "Chi si taglia i piedi ne beve l'ingiuria;"
  },
  {
    "id": 28119,
    "book": "proverbs                                ",
    "chapter": "26",
    "verse": "7",
    "text": "Lo zoppo zoppica delle sue due gambe;"
  },
  {
    "id": 28120,
    "book": "proverbs                                ",
    "chapter": "26",
    "verse": "8",
    "text": "Chi dà gloria allo stolto"
  },
  {
    "id": 28121,
    "book": "proverbs                                ",
    "chapter": "26",
    "verse": "9",
    "text": "La sentenza nella bocca degli stolti"
  },
  {
    "id": 28122,
    "book": "proverbs                                ",
    "chapter": "26",
    "verse": "10",
    "text": "I grandi tormentano ognuno,"
  },
  {
    "id": 28123,
    "book": "proverbs                                ",
    "chapter": "26",
    "verse": "11",
    "text": "Come il cane ritorna al suo vomito26.11 vomito 2 Piet. 2.22.,"
  },
  {
    "id": 28124,
    "book": "proverbs                                ",
    "chapter": "26",
    "verse": "12",
    "text": "Hai tu veduto un uomo che si reputi savio26.12 savio Luc. 18.11 ecc. Rom. 12.16.?"
  },
  {
    "id": 28125,
    "book": "proverbs                                ",
    "chapter": "26",
    "verse": "13",
    "text": "Il pigro dice: Il leopardo è in su la strada,"
  },
  {
    "id": 28126,
    "book": "proverbs                                ",
    "chapter": "26",
    "verse": "14",
    "text": "Come l'uscio si volge sopra i suoi arpioni,"
  },
  {
    "id": 28127,
    "book": "proverbs                                ",
    "chapter": "26",
    "verse": "15",
    "text": "Il pigro nasconde la mano nel seno;"
  },
  {
    "id": 28128,
    "book": "proverbs                                ",
    "chapter": "26",
    "verse": "16",
    "text": "Al pigro par di esser savio,"
  },
  {
    "id": 28129,
    "book": "proverbs                                ",
    "chapter": "26",
    "verse": "17",
    "text": "Colui che passando trascorre in ira per una questione che non gli tocca,"
  },
  {
    "id": 28130,
    "book": "proverbs                                ",
    "chapter": "26",
    "verse": "18",
    "text": "Quale è colui che, infingendosi di scherzare, avventa razzi,"
  },
  {
    "id": 28131,
    "book": "proverbs                                ",
    "chapter": "26",
    "verse": "19",
    "text": "Tale è colui che inganna il suo prossimo,"
  },
  {
    "id": 28132,
    "book": "proverbs                                ",
    "chapter": "26",
    "verse": "20",
    "text": "Il fuoco si spegne, quando mancano legne;"
  },
  {
    "id": 28133,
    "book": "proverbs                                ",
    "chapter": "26",
    "verse": "21",
    "text": "Il carbone è per far brace, e le legne per far fuoco;"
  },
  {
    "id": 28134,
    "book": "proverbs                                ",
    "chapter": "26",
    "verse": "22",
    "text": "Le parole del rapportatore paiono lusinghevoli;"
  },
  {
    "id": 28135,
    "book": "proverbs                                ",
    "chapter": "26",
    "verse": "23",
    "text": "Le labbra ardenti, e il cuor malvagio,"
  },
  {
    "id": 28136,
    "book": "proverbs                                ",
    "chapter": "26",
    "verse": "24",
    "text": "Chi odia s'infinge nel suo parlare,"
  },
  {
    "id": 28137,
    "book": "proverbs                                ",
    "chapter": "26",
    "verse": "25",
    "text": "Quando egli parlerà di una voce graziosa, non fidartici;"
  },
  {
    "id": 28138,
    "book": "proverbs                                ",
    "chapter": "26",
    "verse": "26",
    "text": "L'odio si copre con inganno;"
  },
  {
    "id": 28139,
    "book": "proverbs                                ",
    "chapter": "26",
    "verse": "27",
    "text": "Chi cava una fossa caderà in essa;"
  },
  {
    "id": 28140,
    "book": "proverbs                                ",
    "chapter": "26",
    "verse": "28",
    "text": "La lingua bugiarda odia quelli ch'ella ha fiaccati;"
  }
]