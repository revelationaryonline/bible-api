[
  {
    "id": 27574,
    "book": "proverbs                                ",
    "chapter": "8",
    "verse": "1",
    "text": "LA Sapienza non grida ella8.1 ella Prov. 1.20 e rif.; 9.3.?"
  },
  {
    "id": 27575,
    "book": "proverbs                                ",
    "chapter": "8",
    "verse": "2",
    "text": "Ella sta in piè in capo de' luoghi elevati, in su la via,"
  },
  {
    "id": 27576,
    "book": "proverbs                                ",
    "chapter": "8",
    "verse": "3",
    "text": "Ella grida presso alle porte, alla bocca della città,"
  },
  {
    "id": 27577,
    "book": "proverbs                                ",
    "chapter": "8",
    "verse": "4",
    "text": "Dicendo: Io grido a voi, o uomini principali;"
  },
  {
    "id": 27578,
    "book": "proverbs                                ",
    "chapter": "8",
    "verse": "5",
    "text": "Semplici, intendete che cosa sia avvedimento;"
  },
  {
    "id": 27579,
    "book": "proverbs                                ",
    "chapter": "8",
    "verse": "6",
    "text": "Ascoltate; perciocchè io proporrò cose eccellenti;"
  },
  {
    "id": 27580,
    "book": "proverbs                                ",
    "chapter": "8",
    "verse": "7",
    "text": "Conciossiachè il mio palato ragionerà di verità;"
  },
  {
    "id": 27581,
    "book": "proverbs                                ",
    "chapter": "8",
    "verse": "8",
    "text": "Tutti i detti della mia bocca son con giustizia;"
  },
  {
    "id": 27582,
    "book": "proverbs                                ",
    "chapter": "8",
    "verse": "9",
    "text": "Essi tutti son diritti agl'intendenti,"
  },
  {
    "id": 27583,
    "book": "proverbs                                ",
    "chapter": "8",
    "verse": "10",
    "text": "Ricevete il mio ammaestramento, e non dell'argento;"
  },
  {
    "id": 27584,
    "book": "proverbs                                ",
    "chapter": "8",
    "verse": "11",
    "text": "Perciocchè la sapienza è migliore che le perle;"
  },
  {
    "id": 27585,
    "book": "proverbs                                ",
    "chapter": "8",
    "verse": "12",
    "text": "Io, la Sapienza, abito nell'avvedimento,"
  },
  {
    "id": 27586,
    "book": "proverbs                                ",
    "chapter": "8",
    "verse": "13",
    "text": "Il timor del Signore è odiare il male8.13 male Sal. 97.10. Prov. 16.6.;"
  },
  {
    "id": 27587,
    "book": "proverbs                                ",
    "chapter": "8",
    "verse": "14",
    "text": "A me appartiene il consiglio8.14 consiglio Is. 9.5. e la buona ragione;"
  },
  {
    "id": 27588,
    "book": "proverbs                                ",
    "chapter": "8",
    "verse": "15",
    "text": "Per me regnano i re8.15 re Dan. 2.21. Rom. 13.1-7.,"
  },
  {
    "id": 27589,
    "book": "proverbs                                ",
    "chapter": "8",
    "verse": "16",
    "text": "Per me signoreggiano i signori,"
  },
  {
    "id": 27590,
    "book": "proverbs                                ",
    "chapter": "8",
    "verse": "17",
    "text": "Io amo quelli che mi amano8.17 amano Giov. 14.21.;"
  },
  {
    "id": 27591,
    "book": "proverbs                                ",
    "chapter": "8",
    "verse": "18",
    "text": "Ricchezze e gloria son meco;"
  },
  {
    "id": 27592,
    "book": "proverbs                                ",
    "chapter": "8",
    "verse": "19",
    "text": "Il mio frutto è migliore che oro, anzi che oro finissimo;"
  },
  {
    "id": 27593,
    "book": "proverbs                                ",
    "chapter": "8",
    "verse": "20",
    "text": "Io cammino per la via della giustizia,"
  },
  {
    "id": 27594,
    "book": "proverbs                                ",
    "chapter": "8",
    "verse": "21",
    "text": "Per fare eredare il vero essere a quelli che mi amano,"
  },
  {
    "id": 27595,
    "book": "proverbs                                ",
    "chapter": "8",
    "verse": "22",
    "text": "IL Signore mi possedeva al principio della sua via8.22 via Gen. 1.1 ecc. Giov. 1.1-3.,"
  },
  {
    "id": 27596,
    "book": "proverbs                                ",
    "chapter": "8",
    "verse": "23",
    "text": "Io sono stata costituita in principato ab eterno,"
  },
  {
    "id": 27597,
    "book": "proverbs                                ",
    "chapter": "8",
    "verse": "24",
    "text": "Avanti che fossero abissi,"
  },
  {
    "id": 27598,
    "book": "proverbs                                ",
    "chapter": "8",
    "verse": "25",
    "text": "Io fui prodotta innanzi che i monti fossero profondati8.25 profondati Sal. 90.2.,"
  },
  {
    "id": 27599,
    "book": "proverbs                                ",
    "chapter": "8",
    "verse": "26",
    "text": "Mentre egli non avea ancora fatta la terra, nè le campagne,"
  },
  {
    "id": 27600,
    "book": "proverbs                                ",
    "chapter": "8",
    "verse": "27",
    "text": "Quando egli ordinava i cieli, io v'era;"
  },
  {
    "id": 27601,
    "book": "proverbs                                ",
    "chapter": "8",
    "verse": "28",
    "text": "Quando egli fermava il cielo disopra;"
  },
  {
    "id": 27602,
    "book": "proverbs                                ",
    "chapter": "8",
    "verse": "29",
    "text": "Quando egli poneva il suo termine al mare8.29 mare Gen. 1.9,10.,"
  },
  {
    "id": 27603,
    "book": "proverbs                                ",
    "chapter": "8",
    "verse": "30",
    "text": "Ed era appo lui8.30 lui Giov. 1.1,2,18. come un allievo,"
  },
  {
    "id": 27604,
    "book": "proverbs                                ",
    "chapter": "8",
    "verse": "31",
    "text": "Io mi sollazzo nella parte abitata della sua terra;"
  },
  {
    "id": 27605,
    "book": "proverbs                                ",
    "chapter": "8",
    "verse": "32",
    "text": "Ora dunque, figliuoli, ascoltatemi:"
  },
  {
    "id": 27606,
    "book": "proverbs                                ",
    "chapter": "8",
    "verse": "33",
    "text": "Ascoltate l'ammaestramento, e diventate savi,"
  },
  {
    "id": 27607,
    "book": "proverbs                                ",
    "chapter": "8",
    "verse": "34",
    "text": "Beato l'uomo che mi ascolta8.34 ascolta Prov. 3.13,18. Mat. 17.5.,"
  },
  {
    "id": 27608,
    "book": "proverbs                                ",
    "chapter": "8",
    "verse": "35",
    "text": "Perciocchè chi mi trova trova la vita,"
  },
  {
    "id": 27609,
    "book": "proverbs                                ",
    "chapter": "8",
    "verse": "36",
    "text": "Ma chi pecca contro a me fa ingiuria all'anima sua;"
  }
]