[
  {
    "id": 28016,
    "book": "proverbs                                ",
    "chapter": "23",
    "verse": "1",
    "text": "Quando tu sederai a tavola con alcun signore,"
  },
  {
    "id": 28017,
    "book": "proverbs                                ",
    "chapter": "23",
    "verse": "2",
    "text": "Altrimenti, se tu sei ingordo,"
  },
  {
    "id": 28018,
    "book": "proverbs                                ",
    "chapter": "23",
    "verse": "3",
    "text": "Non appetire le sue delizie;"
  },
  {
    "id": 28019,
    "book": "proverbs                                ",
    "chapter": "23",
    "verse": "4",
    "text": "Non affaticarti per arricchire23.4 arricchire Prov. 28.20. 1 Tim. 6.9,10.;"
  },
  {
    "id": 28020,
    "book": "proverbs                                ",
    "chapter": "23",
    "verse": "5",
    "text": "In un batter d'occhio le ricchezze non sono più;"
  },
  {
    "id": 28021,
    "book": "proverbs                                ",
    "chapter": "23",
    "verse": "6",
    "text": "Non mangiare il pan dell'uomo che è d'occhio maligno23.6 maligno Sal. 141.4.,"
  },
  {
    "id": 28022,
    "book": "proverbs                                ",
    "chapter": "23",
    "verse": "7",
    "text": "Perciocchè, come egli è villano nell'anima sua,"
  },
  {
    "id": 28023,
    "book": "proverbs                                ",
    "chapter": "23",
    "verse": "8",
    "text": "Tu vomiterai il boccone che ne avrai mangiato,"
  },
  {
    "id": 28024,
    "book": "proverbs                                ",
    "chapter": "23",
    "verse": "9",
    "text": "Non parlare in presenza dello stolto;"
  },
  {
    "id": 28025,
    "book": "proverbs                                ",
    "chapter": "23",
    "verse": "10",
    "text": "Non rimuovere il termine antico23.10 antico Prov. 22.28 e rif.;"
  },
  {
    "id": 28026,
    "book": "proverbs                                ",
    "chapter": "23",
    "verse": "11",
    "text": "Perciocchè il lor riscotitore è potente;"
  },
  {
    "id": 28027,
    "book": "proverbs                                ",
    "chapter": "23",
    "verse": "12",
    "text": "Porgi il tuo cuore all'ammaestramento,"
  },
  {
    "id": 28028,
    "book": "proverbs                                ",
    "chapter": "23",
    "verse": "13",
    "text": "Non risparmiare la correzione al fanciullo23.13 fanciullo Prov. 13.24 e rif.;"
  },
  {
    "id": 28029,
    "book": "proverbs                                ",
    "chapter": "23",
    "verse": "14",
    "text": "Tu lo batterai con la verga,"
  },
  {
    "id": 28030,
    "book": "proverbs                                ",
    "chapter": "23",
    "verse": "15",
    "text": "Figliuol mio, se il tuo cuore è savio,"
  },
  {
    "id": 28031,
    "book": "proverbs                                ",
    "chapter": "23",
    "verse": "16",
    "text": "E le mie reni gioiranno,"
  },
  {
    "id": 28032,
    "book": "proverbs                                ",
    "chapter": "23",
    "verse": "17",
    "text": "Il cuor tuo non porti invidia a' peccatori23.17 peccatori Sal. 37.1 e rif.;"
  },
  {
    "id": 28033,
    "book": "proverbs                                ",
    "chapter": "23",
    "verse": "18",
    "text": "Perciocchè, se vi è premio,"
  },
  {
    "id": 28034,
    "book": "proverbs                                ",
    "chapter": "23",
    "verse": "19",
    "text": "Ascolta, figliuol mio, e sii savio;"
  },
  {
    "id": 28035,
    "book": "proverbs                                ",
    "chapter": "23",
    "verse": "20",
    "text": "Non esser de' bevitori di vino23.20 vino Prov. 20.1 e rif. Is. 5.22. Luc. 21.34. Rom. 13.13.;"
  },
  {
    "id": 28036,
    "book": "proverbs                                ",
    "chapter": "23",
    "verse": "21",
    "text": "Perciocchè l'ubbriaco ed il ghiotto impoveriranno23.21 impoveriranno Prov. 19.15 e rif.;"
  },
  {
    "id": 28037,
    "book": "proverbs                                ",
    "chapter": "23",
    "verse": "22",
    "text": "Ubbidisci a tuo padre23.22 padre Prov. 1.8 e rif., il qual ti ha generato;"
  },
  {
    "id": 28038,
    "book": "proverbs                                ",
    "chapter": "23",
    "verse": "23",
    "text": "Compera verità23.23 verità Prov. 4.5,7. Mat. 13.44-46., e non venderla,"
  },
  {
    "id": 28039,
    "book": "proverbs                                ",
    "chapter": "23",
    "verse": "24",
    "text": "Il padre del giusto gioirà grandemente23.24 grandemente Prov. 10.1 e rif.;"
  },
  {
    "id": 28040,
    "book": "proverbs                                ",
    "chapter": "23",
    "verse": "25",
    "text": "Fa' che tuo padre e tua madre si rallegrino;"
  },
  {
    "id": 28041,
    "book": "proverbs                                ",
    "chapter": "23",
    "verse": "26",
    "text": "Figliuol mio, recami il tuo cuore,"
  },
  {
    "id": 28042,
    "book": "proverbs                                ",
    "chapter": "23",
    "verse": "27",
    "text": "Perciocchè la meretrice è una fossa profonda,"
  },
  {
    "id": 28043,
    "book": "proverbs                                ",
    "chapter": "23",
    "verse": "28",
    "text": "Ed anche ella sta agli agguati, come un ladrone23.28 ladrone Prov. 7.12. Eccl. 7.26.;"
  },
  {
    "id": 28044,
    "book": "proverbs                                ",
    "chapter": "23",
    "verse": "29",
    "text": "A cui avvengono i guai? a cui i lai?"
  },
  {
    "id": 28045,
    "book": "proverbs                                ",
    "chapter": "23",
    "verse": "30",
    "text": "A quelli che si fermano lungamente appresso il vino;"
  },
  {
    "id": 28046,
    "book": "proverbs                                ",
    "chapter": "23",
    "verse": "31",
    "text": "Non riguardare il vino, quando rosseggia,"
  },
  {
    "id": 28047,
    "book": "proverbs                                ",
    "chapter": "23",
    "verse": "32",
    "text": "Egli morderà alla fine come il serpente,"
  },
  {
    "id": 28048,
    "book": "proverbs                                ",
    "chapter": "23",
    "verse": "33",
    "text": "Allora gli occhi tuoi vedranno cose strane,"
  },
  {
    "id": 28049,
    "book": "proverbs                                ",
    "chapter": "23",
    "verse": "34",
    "text": "E tu sarai come chi giace in mezzo al mare,"
  },
  {
    "id": 28050,
    "book": "proverbs                                ",
    "chapter": "23",
    "verse": "35",
    "text": "Tu dirai: Altri mi ha battuto, ed io non ne ho sentita la doglia;"
  }
]