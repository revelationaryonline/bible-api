    "book": "proverbs                                ",
    "chapter": "5",
    "verse": "10",
    "text": "Che talora i forestieri non si sazino delle tue facoltà;"
  },
  {
    "id": 27499,
    "book": "proverbs                                ",
    "chapter": "5",
    "verse": "11",
    "text": "E che tu non gema alla fine,"
