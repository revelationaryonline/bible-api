    "book": "proverbs                                ",
    "chapter": "5",
    "verse": "15",
    "text": "Bevi delle acque della tua cisterna5.15 cisterna Prov. 9.17. Cant. 4.12.,"
  },
  {
    "id": 27504,
    "book": "proverbs                                ",
    "chapter": "5",
    "verse": "16",
