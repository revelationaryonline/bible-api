[
  {
    "id": 28256,
    "book": "proverbs                                ",
    "chapter": "31",
    "verse": "1",
    "text": "Le parole del re Lemuel; il sermone profetico, col quale sua madre l'ammaestrò."
  },
  {
    "id": 28257,
    "book": "proverbs                                ",
    "chapter": "31",
    "verse": "2",
    "text": "CHE, figliuol mio? Che, figliuolo del seno mio31.2 mio Is. 49.15.?"
  },
  {
    "id": 28258,
    "book": "proverbs                                ",
    "chapter": "31",
    "verse": "3",
    "text": "Non dar la tua forza alle donne,"
  },
  {
    "id": 28259,
    "book": "proverbs                                ",
    "chapter": "31",
    "verse": "4",
    "text": "Ei non si conviene ai re, o Lemuel,"
  },
  {
    "id": 28260,
    "book": "proverbs                                ",
    "chapter": "31",
    "verse": "5",
    "text": "Che talora eglino, avendo bevuto, non dimentichino gli statuti,"
  },
  {
    "id": 28261,
    "book": "proverbs                                ",
    "chapter": "31",
    "verse": "6",
    "text": "Date la cervogia al miserabile,"
  },
  {
    "id": 28262,
    "book": "proverbs                                ",
    "chapter": "31",
    "verse": "7",
    "text": "Acciocchè bevano, e dimentichino la lor miseria,"
  },
  {
    "id": 28263,
    "book": "proverbs                                ",
    "chapter": "31",
    "verse": "8",
    "text": "Apri la tua bocca per lo mutolo31.8 mutolo Giob. 29.15,16.,"
  },
  {
    "id": 28264,
    "book": "proverbs                                ",
    "chapter": "31",
    "verse": "9",
    "text": "Apri la tua bocca; giudica giustamente31.9 giustamente Lev. 19.15. Deut. 1.16.;"
  },
  {
    "id": 28265,
    "book": "proverbs                                ",
    "chapter": "31",
    "verse": "10",
    "text": "Chi troverà una donna di valore31.10 valore Prov. 12.4 e rif.; 19.14.?"
  },
  {
    "id": 28266,
    "book": "proverbs                                ",
    "chapter": "31",
    "verse": "11",
    "text": "Il cuor del suo marito si fida in lei;"
  },
  {
    "id": 28267,
    "book": "proverbs                                ",
    "chapter": "31",
    "verse": "12",
    "text": "Ella gli fa del bene, e non del male,"
  },
  {
    "id": 28268,
    "book": "proverbs                                ",
    "chapter": "31",
    "verse": "13",
    "text": "Ella cerca della lana e del lino,"
  },
  {
    "id": 28269,
    "book": "proverbs                                ",
    "chapter": "31",
    "verse": "14",
    "text": "Ella è come le navi de' mercatanti:"
  },
  {
    "id": 28270,
    "book": "proverbs                                ",
    "chapter": "31",
    "verse": "15",
    "text": "Ella si leva, mentre è ancora notte31.15 notte Prov. 20.13. Rom. 12.11.,"
  },
  {
    "id": 28271,
    "book": "proverbs                                ",
    "chapter": "31",
    "verse": "16",
    "text": "Ella considera un campo, e l'acquista;"
  },
  {
    "id": 28272,
    "book": "proverbs                                ",
    "chapter": "31",
    "verse": "17",
    "text": "Ella si cinge i lombi di forza,"
  },
  {
    "id": 28273,
    "book": "proverbs                                ",
    "chapter": "31",
    "verse": "18",
    "text": "Perciocchè il suo traffico è buono, ella lo gusta;"
  },
  {
    "id": 28274,
    "book": "proverbs                                ",
    "chapter": "31",
    "verse": "19",
    "text": "Ella mette la mano al fuso,"
  },
  {
    "id": 28275,
    "book": "proverbs                                ",
    "chapter": "31",
    "verse": "20",
    "text": "Ella allarga la mano all'afflitto,"
  },
  {
    "id": 28276,
    "book": "proverbs                                ",
    "chapter": "31",
    "verse": "21",
    "text": "Ella non teme della neve per la sua famiglia;"
  },
  {
    "id": 28277,
    "book": "proverbs                                ",
    "chapter": "31",
    "verse": "22",
    "text": "Ella si fa de' capoletti;"
  },
  {
    "id": 28278,
    "book": "proverbs                                ",
    "chapter": "31",
    "verse": "23",
    "text": "Il suo marito è conosciuto nelle porte,"
  },
  {
    "id": 28279,
    "book": "proverbs                                ",
    "chapter": "31",
    "verse": "24",
    "text": "Ella fa de' veli, e li vende;"
  },
  {
    "id": 28280,
    "book": "proverbs                                ",
    "chapter": "31",
    "verse": "25",
    "text": "Ella è vestita di gloria e d'onore;"
  },
  {
    "id": 28281,
    "book": "proverbs                                ",
    "chapter": "31",
    "verse": "26",
    "text": "Ella apre la bocca con sapienza,"
  },
  {
    "id": 28282,
    "book": "proverbs                                ",
    "chapter": "31",
    "verse": "27",
    "text": "Ella considera gli andamenti della sua casa,"
  },
  {
    "id": 28283,
    "book": "proverbs                                ",
    "chapter": "31",
    "verse": "28",
    "text": "I suoi figliuoli si levano, e la predicano beata,"
  },
  {
    "id": 28284,
    "book": "proverbs                                ",
    "chapter": "31",
    "verse": "29",
    "text": "Dicendo: Molte donne si son portate valorosamente;"
  },
  {
    "id": 28285,
    "book": "proverbs                                ",
    "chapter": "31",
    "verse": "30",
    "text": "La grazia è cosa fallace, e la bellezza è cosa vana;"
  },
  {
    "id": 28286,
    "book": "proverbs                                ",
    "chapter": "31",
    "verse": "31",
    "text": "Datele del frutto delle sue mani;"
  }
]