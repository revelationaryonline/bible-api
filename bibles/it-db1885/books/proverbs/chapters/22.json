[
  {
    "id": 27987,
    "book": "proverbs                                ",
    "chapter": "22",
    "verse": "1",
    "text": "La fama è più a pregiare che grandi ricchezze22.1 ricchezze Eccl. 7.1.;"
  },
  {
    "id": 27988,
    "book": "proverbs                                ",
    "chapter": "22",
    "verse": "2",
    "text": "Il ricco e il povero si scontrano l'un l'altro;"
  },
  {
    "id": 27989,
    "book": "proverbs                                ",
    "chapter": "22",
    "verse": "3",
    "text": "L' uomo avveduto vede il male, e si nasconde22.3 nasconde Prov. 14.16 e rif.;"
  },
  {
    "id": 27990,
    "book": "proverbs                                ",
    "chapter": "22",
    "verse": "4",
    "text": "Il premio della mansuetudine e del timor del Signore"
  },
  {
    "id": 27991,
    "book": "proverbs                                ",
    "chapter": "22",
    "verse": "5",
    "text": "Spine e lacci son nella via dell'uomo perverso;"
  },
  {
    "id": 27992,
    "book": "proverbs                                ",
    "chapter": "22",
    "verse": "6",
    "text": "Ammaestra il fanciullo, secondo la via ch'egli ha da tenere22.6 tenere Efes. 6.4. 2 Tim. 3.15.;"
  },
  {
    "id": 27993,
    "book": "proverbs                                ",
    "chapter": "22",
    "verse": "7",
    "text": "Il ricco signoreggia sopra i poveri22.7 poveri Giac. 2.1-6.;"
  },
  {
    "id": 27994,
    "book": "proverbs                                ",
    "chapter": "22",
    "verse": "8",
    "text": "Chi semina iniquità mieterà vanità22.8 venità Giob. 4.8 e rif.;"
  },
  {
    "id": 27995,
    "book": "proverbs                                ",
    "chapter": "22",
    "verse": "9",
    "text": "L'uomo che è d'occhio benigno sarà benedetto;"
  },
  {
    "id": 27996,
    "book": "proverbs                                ",
    "chapter": "22",
    "verse": "10",
    "text": "Caccia lo schernitore, e le contese usciranno fuori22.10 fuori Gen. 21.9,10.;"
  },
  {
    "id": 27997,
    "book": "proverbs                                ",
    "chapter": "22",
    "verse": "11",
    "text": "Chi ama la purità del cuore"
  },
  {
    "id": 27998,
    "book": "proverbs                                ",
    "chapter": "22",
    "verse": "12",
    "text": "Gli occhi del Signore guardano l'uomo dotato di conoscimento;"
  },
  {
    "id": 27999,
    "book": "proverbs                                ",
    "chapter": "22",
    "verse": "13",
    "text": "Il pigro dice: Il leone è fuori22.13 fuori Prov. 26.13.;"
  },
  {
    "id": 28000,
    "book": "proverbs                                ",
    "chapter": "22",
    "verse": "14",
    "text": "La bocca delle donne straniere22.14 straniere Prov. 2.16 e rif. è una fossa profonda;"
  },
  {
    "id": 28001,
    "book": "proverbs                                ",
    "chapter": "22",
    "verse": "15",
    "text": "La follia è attaccata al cuor del fanciullo;"
  },
  {
    "id": 28002,
    "book": "proverbs                                ",
    "chapter": "22",
    "verse": "16",
    "text": "Chi fa torto al povero, per accrescere il suo,"
  },
  {
    "id": 28003,
    "book": "proverbs                                ",
    "chapter": "22",
    "verse": "17",
    "text": "INCHINA il tuo orecchio, ed ascolta le parole de' Savi,"
  },
  {
    "id": 28004,
    "book": "proverbs                                ",
    "chapter": "22",
    "verse": "18",
    "text": "Perciocchè ti sarà cosa soave, se tu le guardi nel tuo cuore,"
  },
  {
    "id": 28005,
    "book": "proverbs                                ",
    "chapter": "22",
    "verse": "19",
    "text": "Io te le ho pur fatte assapere,"
  },
  {
    "id": 28006,
    "book": "proverbs                                ",
    "chapter": "22",
    "verse": "20",
    "text": "Non ti ho io scritto cose eccellenti"
  },
  {
    "id": 28007,
    "book": "proverbs                                ",
    "chapter": "22",
    "verse": "21",
    "text": "Per farti conoscere la certezza delle parole di verità;"
  },
  {
    "id": 28008,
    "book": "proverbs                                ",
    "chapter": "22",
    "verse": "22",
    "text": "Non predare il povero, perchè egli è povero22.22 povero Esod. 23.6 e rif.;"
  },
  {
    "id": 28009,
    "book": "proverbs                                ",
    "chapter": "22",
    "verse": "23",
    "text": "Perciocchè il Signore difenderà la causa loro,"
  },
  {
    "id": 28010,
    "book": "proverbs                                ",
    "chapter": "22",
    "verse": "24",
    "text": "Non accompagnarti con l'uomo collerico;"
  },
  {
    "id": 28011,
    "book": "proverbs                                ",
    "chapter": "22",
    "verse": "25",
    "text": "Che talora tu non impari i suoi costumi,"
  },
  {
    "id": 28012,
    "book": "proverbs                                ",
    "chapter": "22",
    "verse": "26",
    "text": "Non esser di quelli che percuotono nella palma della mano,"
  },
  {
    "id": 28013,
    "book": "proverbs                                ",
    "chapter": "22",
    "verse": "27",
    "text": "Per qual cagione, se tu non avessi da pagare,"
  },
  {
    "id": 28014,
    "book": "proverbs                                ",
    "chapter": "22",
    "verse": "28",
    "text": "Non rimuovere il termine antico,"
  },
  {
    "id": 28015,
    "book": "proverbs                                ",
    "chapter": "22",
    "verse": "29",
    "text": "Hai tu mai veduto un uomo spedito nelle sue faccende?"
  }
]