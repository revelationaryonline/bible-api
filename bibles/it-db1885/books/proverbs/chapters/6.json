[
  {
    "id": 27512,
    "book": "proverbs                                ",
    "chapter": "6",
    "verse": "1",
    "text": "FIGLIUOL mio, se tu hai fatta sicurtà al tuo prossimo,"
  },
  {
    "id": 27513,
    "book": "proverbs                                ",
    "chapter": "6",
    "verse": "2",
    "text": "Tu sei allacciato con le parole della tua bocca,"
  },
  {
    "id": 27514,
    "book": "proverbs                                ",
    "chapter": "6",
    "verse": "3",
    "text": "Ora fa' questo, figliuol mio, e riscuotiti;"
  },
  {
    "id": 27515,
    "book": "proverbs                                ",
    "chapter": "6",
    "verse": "4",
    "text": "Non lasciar dormire gli occhi tuoi,"
  },
  {
    "id": 27516,
    "book": "proverbs                                ",
    "chapter": "6",
    "verse": "5",
    "text": "Riscuotiti, come un cavriuolo di mano del cacciatore,"
  },
  {
    "id": 27517,
    "book": "proverbs                                ",
    "chapter": "6",
    "verse": "6",
    "text": "Va', pigro, alla formica6.6 formica Giob. 12.7. Prov. 30.24 ecc.;"
  },
  {
    "id": 27518,
    "book": "proverbs                                ",
    "chapter": "6",
    "verse": "7",
    "text": "Conciossiachè ella non abbia nè capitano,"
  },
  {
    "id": 27519,
    "book": "proverbs                                ",
    "chapter": "6",
    "verse": "8",
    "text": "E pure ella apparecchia nella state il suo cibo,"
  },
  {
    "id": 27520,
    "book": "proverbs                                ",
    "chapter": "6",
    "verse": "9",
    "text": "Infino a quando, o pigro, giacerai?"
  },
  {
    "id": 27521,
    "book": "proverbs                                ",
    "chapter": "6",
    "verse": "10",
    "text": "Dormendo un poco, sonnecchiando un poco,"
  },
  {
    "id": 27522,
    "book": "proverbs                                ",
    "chapter": "6",
    "verse": "11",
    "text": "La tua povertà verrà come un viandante,"
  },
  {
    "id": 27523,
    "book": "proverbs                                ",
    "chapter": "6",
    "verse": "12",
    "text": "L'uomo scellerato, l'uomo da nulla,"
  },
  {
    "id": 27524,
    "book": "proverbs                                ",
    "chapter": "6",
    "verse": "13",
    "text": "Egli ammicca con gli occhi, parla co' piedi,"
  },
  {
    "id": 27525,
    "book": "proverbs                                ",
    "chapter": "6",
    "verse": "14",
    "text": "Egli ha delle perversità nel suo cuore,"
  },
  {
    "id": 27526,
    "book": "proverbs                                ",
    "chapter": "6",
    "verse": "15",
    "text": "Perciò in un momento verrà la sua ruina;"
  },
  {
    "id": 27527,
    "book": "proverbs                                ",
    "chapter": "6",
    "verse": "16",
    "text": "Il Signore odia queste sei cose;"
  },
  {
    "id": 27528,
    "book": "proverbs                                ",
    "chapter": "6",
    "verse": "17",
    "text": "Gli occhi altieri6.17 altieri Sal. 18.26; 101.5., la lingua bugiarda6.17 bugiarda Sal. 120.2,3. Prov. 12.22.,"
  },
  {
    "id": 27529,
    "book": "proverbs                                ",
    "chapter": "6",
    "verse": "18",
    "text": "Il cuore che divisa pensieri d'iniquità6.18 iniquità Gen. 6.5,6.,"
  },
  {
    "id": 27530,
    "book": "proverbs                                ",
    "chapter": "6",
    "verse": "19",
    "text": "Il falso testimonio che sbocca menzogne6.19 menzogne Prov. 19.5,9.,"
  },
  {
    "id": 27531,
    "book": "proverbs                                ",
    "chapter": "6",
    "verse": "20",
    "text": "FIGLIUOL mio, guarda il comandamento di tuo padre,"
  },
  {
    "id": 27532,
    "book": "proverbs                                ",
    "chapter": "6",
    "verse": "21",
    "text": "Tienli del continuo legati in sul tuo cuore,"
  },
  {
    "id": 27533,
    "book": "proverbs                                ",
    "chapter": "6",
    "verse": "22",
    "text": "Quando tu camminerai, quello ti guiderà;"
  },
  {
    "id": 27534,
    "book": "proverbs                                ",
    "chapter": "6",
    "verse": "23",
    "text": "Perciocchè il comandamento è una lampana,"
  },
  {
    "id": 27535,
    "book": "proverbs                                ",
    "chapter": "6",
    "verse": "24",
    "text": "Per guardarti dalla femmina malvagia6.24 malvagia Prov. 2.16 e rif.,"
  },
  {
    "id": 27536,
    "book": "proverbs                                ",
    "chapter": "6",
    "verse": "25",
    "text": "Non invaghirti nel tuo cuore della sua bellezza6.25 bellezza Mat. 5.28.;"
  },
  {
    "id": 27537,
    "book": "proverbs                                ",
    "chapter": "6",
    "verse": "26",
    "text": "Perciocchè per una donna meretrice si viene fino ad un pezzo di pane6.26 pane Prov. 29.3.;"
  },
  {
    "id": 27538,
    "book": "proverbs                                ",
    "chapter": "6",
    "verse": "27",
    "text": "Alcuno prenderà egli del fuoco in seno,"
  },
  {
    "id": 27539,
    "book": "proverbs                                ",
    "chapter": "6",
    "verse": "28",
    "text": "Alcuno camminerà egli sopra le brace,"
  },
  {
    "id": 27540,
    "book": "proverbs                                ",
    "chapter": "6",
    "verse": "29",
    "text": "Così avviene a chi entra dalla moglie del suo prossimo;"
  },
  {
    "id": 27541,
    "book": "proverbs                                ",
    "chapter": "6",
    "verse": "30",
    "text": "Ei non si scusa il ladro, quando egli ruba"
  },
  {
    "id": 27542,
    "book": "proverbs                                ",
    "chapter": "6",
    "verse": "31",
    "text": "Anzi, se è colto, restituisce il furto a sette doppi6.31 doppi Esod. 22.1,4.,"
  },
  {
    "id": 27543,
    "book": "proverbs                                ",
    "chapter": "6",
    "verse": "32",
    "text": "Chi commette adulterio con una donna è scemo di senno6.32 senno Prov. 7.6 ecc.;"
  },
  {
    "id": 27544,
    "book": "proverbs                                ",
    "chapter": "6",
    "verse": "33",
    "text": "Egli troverà ferite ed ignominia;"
  },
  {
    "id": 27545,
    "book": "proverbs                                ",
    "chapter": "6",
    "verse": "34",
    "text": "Perciocchè la gelosia è un furor dell'uomo6.34 uomo Prov. 27.4. Cant. 8.6.;"
  },
  {
    "id": 27546,
    "book": "proverbs                                ",
    "chapter": "6",
    "verse": "35",
    "text": "Egli non avrà riguardo ad alcun riscatto;"
  }
]