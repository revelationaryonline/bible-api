[
  {
    "id": 27547,
    "book": "proverbs                                ",
    "chapter": "7",
    "verse": "1",
    "text": "Figliuol mio, guarda i miei detti,"
  },
  {
    "id": 27548,
    "book": "proverbs                                ",
    "chapter": "7",
    "verse": "2",
    "text": "Guarda i miei comandamenti, e tu viverai7.2 viverai Prov. 4.4 e rif.;"
  },
  {
    "id": 27549,
    "book": "proverbs                                ",
    "chapter": "7",
    "verse": "3",
    "text": "Legateli alle dita,"
  },
  {
    "id": 27550,
    "book": "proverbs                                ",
    "chapter": "7",
    "verse": "4",
    "text": "Di' alla sapienza: Tu sei mia sorella;"
  },
  {
    "id": 27551,
    "book": "proverbs                                ",
    "chapter": "7",
    "verse": "5",
    "text": "Acciocchè esse ti guardino dalla donna straniera,"
  },
  {
    "id": 27552,
    "book": "proverbs                                ",
    "chapter": "7",
    "verse": "6",
    "text": "Perciocchè io riguardava una volta per la finestra della mia casa,"
  },
  {
    "id": 27553,
    "book": "proverbs                                ",
    "chapter": "7",
    "verse": "7",
    "text": "E vidi tra gli scempi,"
  },
  {
    "id": 27554,
    "book": "proverbs                                ",
    "chapter": "7",
    "verse": "8",
    "text": "Il qual passava per la strada, presso al cantone della casa d'una tal donna;"
  },
  {
    "id": 27555,
    "book": "proverbs                                ",
    "chapter": "7",
    "verse": "9",
    "text": "In su la sera, in sul vespro del dì7.9 dì Giob. 24.15.."
  },
  {
    "id": 27556,
    "book": "proverbs                                ",
    "chapter": "7",
    "verse": "10",
    "text": "Ed ecco, una donna gli venne incontro,"
  },
  {
    "id": 27557,
    "book": "proverbs                                ",
    "chapter": "7",
    "verse": "11",
    "text": "Strepitosa, e sviata;"
  },
  {
    "id": 27558,
    "book": "proverbs                                ",
    "chapter": "7",
    "verse": "12",
    "text": "Essendo ora fuori, or per le piazze;"
  },
  {
    "id": 27559,
    "book": "proverbs                                ",
    "chapter": "7",
    "verse": "13",
    "text": "Ed essa lo prese, e lo baciò,"
  },
  {
    "id": 27560,
    "book": "proverbs                                ",
    "chapter": "7",
    "verse": "14",
    "text": "Io avea sopra me il voto di sacrificii da render grazie;"
  },
  {
    "id": 27561,
    "book": "proverbs                                ",
    "chapter": "7",
    "verse": "15",
    "text": "Però ti sono uscita incontro,"
  },
  {
    "id": 27562,
    "book": "proverbs                                ",
    "chapter": "7",
    "verse": "16",
    "text": "Io ho acconcio il mio letto con capoletti"
  },
  {
    "id": 27563,
    "book": "proverbs                                ",
    "chapter": "7",
    "verse": "17",
    "text": "Io ho profumato il mio letto"
  },
  {
    "id": 27564,
    "book": "proverbs                                ",
    "chapter": "7",
    "verse": "18",
    "text": "Vieni, inebbriamoci d'amori infino alla mattina,"
  },
  {
    "id": 27565,
    "book": "proverbs                                ",
    "chapter": "7",
    "verse": "19",
    "text": "Perciocchè il marito non è in casa sua;"
  },
  {
    "id": 27566,
    "book": "proverbs                                ",
    "chapter": "7",
    "verse": "20",
    "text": "Egli ha preso in mano un sacchetto di danari;"
  },
  {
    "id": 27567,
    "book": "proverbs                                ",
    "chapter": "7",
    "verse": "21",
    "text": "Ella lo piegò con le molte sue lusinghe7.21 lusinghe Prov. 5.3.,"
  },
  {
    "id": 27568,
    "book": "proverbs                                ",
    "chapter": "7",
    "verse": "22",
    "text": "Ed egli andò dietro a lei subitamente,"
  },
  {
    "id": 27569,
    "book": "proverbs                                ",
    "chapter": "7",
    "verse": "23",
    "text": "Come l'uccello si affretta al laccio,"
  },
  {
    "id": 27570,
    "book": "proverbs                                ",
    "chapter": "7",
    "verse": "24",
    "text": "Ora dunque, figliuoli, ascoltatemi,"
  },
  {
    "id": 27571,
    "book": "proverbs                                ",
    "chapter": "7",
    "verse": "25",
    "text": "Il cuor tuo non dichini alle vie d'una tal donna;"
  },
  {
    "id": 27572,
    "book": "proverbs                                ",
    "chapter": "7",
    "verse": "26",
    "text": "Perciocchè ella ne ha fatti cader molti uccisi;"
  },
  {
    "id": 27573,
    "book": "proverbs                                ",
    "chapter": "7",
    "verse": "27",
    "text": "La sua casa è la via dell'inferno7.27 inferno Prov. 2.18; 5.5; 9.18.,"
  }
]