[
  {
    "id": 24503,
    "book": "lamentations                            ",
    "chapter": "3",
    "verse": "1",
    "text": "IO son l'uomo che ha veduta afflizione3.1 afflizione ver. 3.27,39 e rif.,"
  },
  {
    "id": 24504,
    "book": "lamentations                            ",
    "chapter": "3",
    "verse": "2",
    "text": "Egli mi ha condotto, e fatto camminar nelle tenebre,"
  },
  {
    "id": 24505,
    "book": "lamentations                            ",
    "chapter": "3",
    "verse": "3",
    "text": "Certo, egli mi ritorna addosso,"
  },
  {
    "id": 24506,
    "book": "lamentations                            ",
    "chapter": "3",
    "verse": "4",
    "text": "Egli ha fatta invecchiar la mia carne, e la mia pelle;"
  },
  {
    "id": 24507,
    "book": "lamentations                            ",
    "chapter": "3",
    "verse": "5",
    "text": "Egli ha fatti degli edificii contro a me,"
  },
  {
    "id": 24508,
    "book": "lamentations                            ",
    "chapter": "3",
    "verse": "6",
    "text": "Egli mi ha fatto dimorare in luoghi tenebrosi,"
  },
  {
    "id": 24509,
    "book": "lamentations                            ",
    "chapter": "3",
    "verse": "7",
    "text": "Egli mi ha assiepato d'ogn'intorno, sì che non posso uscire;"
  },
  {
    "id": 24510,
    "book": "lamentations                            ",
    "chapter": "3",
    "verse": "8",
    "text": "Eziandio quando grido e sclamo,"
  },
  {
    "id": 24511,
    "book": "lamentations                            ",
    "chapter": "3",
    "verse": "9",
    "text": "Egli ha chiuse le mie vie di pietre conce a scarpello,"
  },
  {
    "id": 24512,
    "book": "lamentations                            ",
    "chapter": "3",
    "verse": "10",
    "text": "Egli mi è stato un orso all'agguato,"
  },
  {
    "id": 24513,
    "book": "lamentations                            ",
    "chapter": "3",
    "verse": "11",
    "text": "Egli ha traviate le mie vie,"
  },
  {
    "id": 24514,
    "book": "lamentations                            ",
    "chapter": "3",
    "verse": "12",
    "text": "Egli ha teso l'arco suo,"
  },
  {
    "id": 24515,
    "book": "lamentations                            ",
    "chapter": "3",
    "verse": "13",
    "text": "Egli mi ha fitti nelle reni"
  },
  {
    "id": 24516,
    "book": "lamentations                            ",
    "chapter": "3",
    "verse": "14",
    "text": "Io sono in derisione a tutti i popoli,"
  },
  {
    "id": 24517,
    "book": "lamentations                            ",
    "chapter": "3",
    "verse": "15",
    "text": "Egli mi ha saziato di amaritudini,"
  },
  {
    "id": 24518,
    "book": "lamentations                            ",
    "chapter": "3",
    "verse": "16",
    "text": "Egli mi ha stritolati i denti con della ghiaia,"
  },
  {
    "id": 24519,
    "book": "lamentations                            ",
    "chapter": "3",
    "verse": "17",
    "text": "E tu hai allontanata l'anima mia dalla pace,"
  },
  {
    "id": 24520,
    "book": "lamentations                            ",
    "chapter": "3",
    "verse": "18",
    "text": "E ho detto: Il Signore ha fatta perire la mia forza,"
  },
  {
    "id": 24521,
    "book": "lamentations                            ",
    "chapter": "3",
    "verse": "19",
    "text": "Ricordati della mia afflizione,"
  },
  {
    "id": 24522,
    "book": "lamentations                            ",
    "chapter": "3",
    "verse": "20",
    "text": "L'anima mia se ne ricorda del continuo,"
  },
  {
    "id": 24523,
    "book": "lamentations                            ",
    "chapter": "3",
    "verse": "21",
    "text": "Questo mi torna alla mente,"
  },
  {
    "id": 24524,
    "book": "lamentations                            ",
    "chapter": "3",
    "verse": "22",
    "text": "Se non siamo stati del tutto consumati3.22 consumati Is. 1.9 e rif. Mal. 3.6.,"
  },
  {
    "id": 24525,
    "book": "lamentations                            ",
    "chapter": "3",
    "verse": "23",
    "text": "Si rinnovano ogni mattina;"
  },
  {
    "id": 24526,
    "book": "lamentations                            ",
    "chapter": "3",
    "verse": "24",
    "text": "Il Signore è la mia parte3.24 parte Sal. 16.5; 73.26 e rif., ha detto l'anima mia;"
  },
  {
    "id": 24527,
    "book": "lamentations                            ",
    "chapter": "3",
    "verse": "25",
    "text": "Il Signore è buono a quelli che l'aspettano3.25 aspettano Sal. 130.5-8. Is. 30.18.,"
  },
  {
    "id": 24528,
    "book": "lamentations                            ",
    "chapter": "3",
    "verse": "26",
    "text": "Buona cosa è di aspettare in silenzio3.26 silenzio Sal. 37.7 e rif."
  },
  {
    "id": 24529,
    "book": "lamentations                            ",
    "chapter": "3",
    "verse": "27",
    "text": "Buona cosa è all'uomo di portare il giogo3.27 giogo Sal. 94.12; 119.71."
  },
  {
    "id": 24530,
    "book": "lamentations                            ",
    "chapter": "3",
    "verse": "28",
    "text": "Sieda egli pur solitario3.28 solitario Ger. 15.17., ed in silenzio,"
  },
  {
    "id": 24531,
    "book": "lamentations                            ",
    "chapter": "3",
    "verse": "29",
    "text": "Metta pur la sua bocca nella polvere3.29 polvere Giob. 42.6.!"
  },
  {
    "id": 24532,
    "book": "lamentations                            ",
    "chapter": "3",
    "verse": "30",
    "text": "Porga pur la guancia a chi lo percuote3.30 percuote Is. 50.6. Mat. 5.39.;"
  },
  {
    "id": 24533,
    "book": "lamentations                            ",
    "chapter": "3",
    "verse": "31",
    "text": "Poichè il Signore non rigetta in perpetuo;"
  },
  {
    "id": 24534,
    "book": "lamentations                            ",
    "chapter": "3",
    "verse": "32",
    "text": "Anzi, se affligge, ha altresì compassione,"
  },
  {
    "id": 24535,
    "book": "lamentations                            ",
    "chapter": "3",
    "verse": "33",
    "text": "Perciocchè s'egli affligge,"
  },
  {
    "id": 24536,
    "book": "lamentations                            ",
    "chapter": "3",
    "verse": "34",
    "text": "Mentre altri trita sotto i suoi piedi"
  },
  {
    "id": 24537,
    "book": "lamentations                            ",
    "chapter": "3",
    "verse": "35",
    "text": "Mentre altri pervertisce la ragion dell'uomo,"
  },
  {
    "id": 24538,
    "book": "lamentations                            ",
    "chapter": "3",
    "verse": "36",
    "text": "Mentre altri fa torto all'uomo nella sua lite;"
  },
  {
    "id": 24539,
    "book": "lamentations                            ",
    "chapter": "3",
    "verse": "37",
    "text": "Chi è colui che abbia detta qualche cosa, e quella sia avvenuta,"
  },
  {
    "id": 24540,
    "book": "lamentations                            ",
    "chapter": "3",
    "verse": "38",
    "text": "Non procedono i mali ed i beni"
  },
  {
    "id": 24541,
    "book": "lamentations                            ",
    "chapter": "3",
    "verse": "39",
    "text": "Perchè si rammarica l'uomo vivente?"
  },
  {
    "id": 24542,
    "book": "lamentations                            ",
    "chapter": "3",
    "verse": "40",
    "text": "Esaminiamo le nostre vie,"
  },
  {
    "id": 24543,
    "book": "lamentations                            ",
    "chapter": "3",
    "verse": "41",
    "text": "Alziamo i nostri cuori3.41 cuori Sal. 25.1; 86.4., e le palme delle mani,"
  },
  {
    "id": 24544,
    "book": "lamentations                            ",
    "chapter": "3",
    "verse": "42",
    "text": "Noi abbiam misfatto, e siamo stati ribelli3.42 ribelli Dan. 9.5.;"
  },
  {
    "id": 24545,
    "book": "lamentations                            ",
    "chapter": "3",
    "verse": "43",
    "text": "Tu ci hai coperti d'ira, e ci hai perseguitati;"
  },
  {
    "id": 24546,
    "book": "lamentations                            ",
    "chapter": "3",
    "verse": "44",
    "text": "Tu hai distesa una nuvola intorno a te,"
  },
  {
    "id": 24547,
    "book": "lamentations                            ",
    "chapter": "3",
    "verse": "45",
    "text": "Tu ci hai fatti essere spazzature,"
  },
  {
    "id": 24548,
    "book": "lamentations                            ",
    "chapter": "3",
    "verse": "46",
    "text": "Tutti i nostri nemici hanno aperta la bocca contro a noi."
  },
  {
    "id": 24549,
    "book": "lamentations                            ",
    "chapter": "3",
    "verse": "47",
    "text": "Noi siamo incorsi in ispavento, ed in fossa;"
  },
  {
    "id": 24550,
    "book": "lamentations                            ",
    "chapter": "3",
    "verse": "48",
    "text": "L'occhio mio cola in rivi d'acque3.48 acque Ger. 9.1 e rif.,"
  },
  {
    "id": 24551,
    "book": "lamentations                            ",
    "chapter": "3",
    "verse": "49",
    "text": "L'occhio mio stilla, senza posa,"
  },
  {
    "id": 24552,
    "book": "lamentations                            ",
    "chapter": "3",
    "verse": "50",
    "text": "Finchè il Signore non riguarda,"
  },
  {
    "id": 24553,
    "book": "lamentations                            ",
    "chapter": "3",
    "verse": "51",
    "text": "L'occhio mio affanna l'anima mia,"
  },
  {
    "id": 24554,
    "book": "lamentations                            ",
    "chapter": "3",
    "verse": "52",
    "text": "Quelli che senza cagione, mi son nemici,"
  },
  {
    "id": 24555,
    "book": "lamentations                            ",
    "chapter": "3",
    "verse": "53",
    "text": "Hanno troncata la vita mia, e l'hanno messa nella fossa3.53 fossa Ger. 37.16; 38.6,9.;"
  },
  {
    "id": 24556,
    "book": "lamentations                            ",
    "chapter": "3",
    "verse": "54",
    "text": "Le acque mi hanno inondato fin sopra il capo;"
  },
  {
    "id": 24557,
    "book": "lamentations                            ",
    "chapter": "3",
    "verse": "55",
    "text": "Io ho invocato il tuo Nome, o Signore,"
  },
  {
    "id": 24558,
    "book": "lamentations                            ",
    "chapter": "3",
    "verse": "56",
    "text": "Tu hai udita la mia voce3.56 voce Sal. 116.1.;"
  },
  {
    "id": 24559,
    "book": "lamentations                            ",
    "chapter": "3",
    "verse": "57",
    "text": "Tu ti sei accostato al giorno che io ti ho invocato3.57 invocato Giac. 4.8.;"
  },
  {
    "id": 24560,
    "book": "lamentations                            ",
    "chapter": "3",
    "verse": "58",
    "text": "O Signore, tu hai dibattute le querele dell'anima mia3.58 mia Sal. 35.1. Ger. 51.36.;"
  },
  {
    "id": 24561,
    "book": "lamentations                            ",
    "chapter": "3",
    "verse": "59",
    "text": "O Signore, tu vedi il torto che mi è fatto;"
  },
  {
    "id": 24562,
    "book": "lamentations                            ",
    "chapter": "3",
    "verse": "60",
    "text": "Tu vedi tutte le lor vendette,"
  },
  {
    "id": 24563,
    "book": "lamentations                            ",
    "chapter": "3",
    "verse": "61",
    "text": "Tu odi, Signore, i loro obbrobri,"
  },
  {
    "id": 24564,
    "book": "lamentations                            ",
    "chapter": "3",
    "verse": "62",
    "text": "Le parole di quelli che mi si levano incontro,"
  },
  {
    "id": 24565,
    "book": "lamentations                            ",
    "chapter": "3",
    "verse": "63",
    "text": "Riguarda, quando si seggono, e quando si levano3.63 levano Sal. 139.1,2.;"
  },
  {
    "id": 24566,
    "book": "lamentations                            ",
    "chapter": "3",
    "verse": "64",
    "text": "O Signore, rendi loro la retribuzione,"
  },
  {
    "id": 24567,
    "book": "lamentations                            ",
    "chapter": "3",
    "verse": "65",
    "text": "Da' loro ingombramento di cuore,"
  },
  {
    "id": 24568,
    "book": "lamentations                            ",
    "chapter": "3",
    "verse": "66",
    "text": "Perseguili in ira,"
  }
]