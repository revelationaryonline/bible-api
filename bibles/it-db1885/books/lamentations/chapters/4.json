[
  {
    "id": 24569,
    "book": "lamentations                            ",
    "chapter": "4",
    "verse": "1",
    "text": "COME è oscurato l'oro,"
  },
  {
    "id": 24570,
    "book": "lamentations                            ",
    "chapter": "4",
    "verse": "2",
    "text": "Come i nobili figliuoli di Sion,"
  },
  {
    "id": 24571,
    "book": "lamentations                            ",
    "chapter": "4",
    "verse": "3",
    "text": "Vi sono anche de' gran pesci marini che porgon le poppe,"
  },
  {
    "id": 24572,
    "book": "lamentations                            ",
    "chapter": "4",
    "verse": "4",
    "text": "La lingua del bambino di poppa"
  },
  {
    "id": 24573,
    "book": "lamentations                            ",
    "chapter": "4",
    "verse": "5",
    "text": "Quelli che mangiavano cibi delicati"
  },
  {
    "id": 24574,
    "book": "lamentations                            ",
    "chapter": "4",
    "verse": "6",
    "text": "E la pena dell'iniquità della figliuola del mio popolo è stata maggiore"
  },
  {
    "id": 24575,
    "book": "lamentations                            ",
    "chapter": "4",
    "verse": "7",
    "text": "I principi di essa erano più puri che neve,"
  },
  {
    "id": 24576,
    "book": "lamentations                            ",
    "chapter": "4",
    "verse": "8",
    "text": "Il loro sguardo è divenuto fosco più che la nerezza stessa;"
  },
  {
    "id": 24577,
    "book": "lamentations                            ",
    "chapter": "4",
    "verse": "9",
    "text": "Più felici sono stati gli uccisi con la spada,"
  },
  {
    "id": 24578,
    "book": "lamentations                            ",
    "chapter": "4",
    "verse": "10",
    "text": "Donne pietose4.10 pietose Is. 49.15. Lam. 2.20., colle proprie mani,"
  },
  {
    "id": 24579,
    "book": "lamentations                            ",
    "chapter": "4",
    "verse": "11",
    "text": "Il Signore ha adempiuta la sua ira,"
  },
  {
    "id": 24580,
    "book": "lamentations                            ",
    "chapter": "4",
    "verse": "12",
    "text": "I re della terra, e tutti gli abitatori del mondo,"
  },
  {
    "id": 24581,
    "book": "lamentations                            ",
    "chapter": "4",
    "verse": "13",
    "text": "Quest'è avvenuto per i peccati de' profeti di essa,"
  },
  {
    "id": 24582,
    "book": "lamentations                            ",
    "chapter": "4",
    "verse": "14",
    "text": "I ciechi sono andati vagando per le strade,"
  },
  {
    "id": 24583,
    "book": "lamentations                            ",
    "chapter": "4",
    "verse": "15",
    "text": "Ei si gridava loro: Traetevi addietro; ciò è immondo;"
  },
  {
    "id": 24584,
    "book": "lamentations                            ",
    "chapter": "4",
    "verse": "16",
    "text": "La faccia del Signore li ha dispersi;"
  },
  {
    "id": 24585,
    "book": "lamentations                            ",
    "chapter": "4",
    "verse": "17",
    "text": "Mentre siamo durati, i nostri occhi si son consumati"
  },
  {
    "id": 24586,
    "book": "lamentations                            ",
    "chapter": "4",
    "verse": "18",
    "text": "Ci hanno cacciati, seguendo i nostri passi,"
  },
  {
    "id": 24587,
    "book": "lamentations                            ",
    "chapter": "4",
    "verse": "19",
    "text": "Quelli che ci hanno perseguiti"
  },
  {
    "id": 24588,
    "book": "lamentations                            ",
    "chapter": "4",
    "verse": "20",
    "text": "Il respiro delle nostre nari,"
  },
  {
    "id": 24589,
    "book": "lamentations                            ",
    "chapter": "4",
    "verse": "21",
    "text": "Gioisci pure, e rallegrati, figliuola di Edom;"
  },
  {
    "id": 24590,
    "book": "lamentations                            ",
    "chapter": "4",
    "verse": "22",
    "text": "La pena della tua iniquità è finita, figliuola di Sion4.22 Sion Is. 40.2.;"
  }
]