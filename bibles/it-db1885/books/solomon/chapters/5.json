[
  {
    "id": 1733,
    "book": "solomon                                 ",
    "chapter": "5",
    "verse": "1",
    "text": "O Sposa, sorella mia, io son venuto nell'orto mio;"
  },
  {
    "id": 1734,
    "book": "solomon                                 ",
    "chapter": "5",
    "verse": "2",
    "text": "IO dormiva, ma il mio cuore vegliava;"
  },
  {
    "id": 1735,
    "book": "solomon                                 ",
    "chapter": "5",
    "verse": "3",
    "text": "Ed io risposi: Io ho spogliata la mia gonna, come la rivestirei?"
  },
  {
    "id": 1736,
    "book": "solomon                                 ",
    "chapter": "5",
    "verse": "4",
    "text": "L'amico mio mise la mano per lo buco dell'uscio,"
  },
  {
    "id": 1737,
    "book": "solomon                                 ",
    "chapter": "5",
    "verse": "5",
    "text": "Io mi levai, per aprire al mio amico;"
  },
  {
    "id": 1738,
    "book": "solomon                                 ",
    "chapter": "5",
    "verse": "6",
    "text": "Io apersi all'amico mio;"
  },
  {
    "id": 1739,
    "book": "solomon                                 ",
    "chapter": "5",
    "verse": "7",
    "text": "Le guardie, che vanno attorno alla città, mi trovarono,"
  },
  {
    "id": 1740,
    "book": "solomon                                 ",
    "chapter": "5",
    "verse": "8",
    "text": "Io vi scongiuro, figliuole di Gerusalemme,"
  },
  {
    "id": 1741,
    "book": "solomon                                 ",
    "chapter": "5",
    "verse": "9",
    "text": "Che è il tuo amico, più che un altro amico,"
  },
  {
    "id": 1742,
    "book": "solomon                                 ",
    "chapter": "5",
    "verse": "10",
    "text": "Il mio amico è bianco e vermiglio,"
  },
  {
    "id": 1743,
    "book": "solomon                                 ",
    "chapter": "5",
    "verse": "11",
    "text": "Il suo capo è oro finissimo,"
  },
  {
    "id": 1744,
    "book": "solomon                                 ",
    "chapter": "5",
    "verse": "12",
    "text": "I suoi occhi paiono colombe presso a ruscelli d'acque;"
  },
  {
    "id": 1745,
    "book": "solomon                                 ",
    "chapter": "5",
    "verse": "13",
    "text": "Le sue guance son simili ad un'aia d'aromati,"
  },
  {
    "id": 1746,
    "book": "solomon                                 ",
    "chapter": "5",
    "verse": "14",
    "text": "Le sue mani paiono anelli d'oro,"
  },
  {
    "id": 1747,
    "book": "solomon                                 ",
    "chapter": "5",
    "verse": "15",
    "text": "Le sue gambe son come colonne di marmo,"
  },
  {
    "id": 1748,
    "book": "solomon                                 ",
    "chapter": "5",
    "verse": "16",
    "text": "Il suo palato è tutto dolcezze,"
  }
]