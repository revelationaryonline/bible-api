[
  {
    "id": 1689,
    "book": "solomon                                 ",
    "chapter": "2",
    "verse": "1",
    "text": "Io son la rosa di Saron,"
  },
  {
    "id": 1690,
    "book": "solomon                                 ",
    "chapter": "2",
    "verse": "2",
    "text": "Quale è il giglio fra le spine,"
  },
  {
    "id": 1691,
    "book": "solomon                                 ",
    "chapter": "2",
    "verse": "3",
    "text": "Quale è il melo fra gli alberi d'un bosco,"
  },
  {
    "id": 1692,
    "book": "solomon                                 ",
    "chapter": "2",
    "verse": "4",
    "text": "Egli mi ha condotta nella casa del convito,"
  },
  {
    "id": 1693,
    "book": "solomon                                 ",
    "chapter": "2",
    "verse": "5",
    "text": "Confortatemi con delle schiacciate d'uva,"
  },
  {
    "id": 1694,
    "book": "solomon                                 ",
    "chapter": "2",
    "verse": "6",
    "text": "Sia la sua man sinistra sotto al mio capo,"
  },
  {
    "id": 1695,
    "book": "solomon                                 ",
    "chapter": "2",
    "verse": "7",
    "text": "IO vi scongiuro, o figliuole di Gerusalemme,"
  },
  {
    "id": 1696,
    "book": "solomon                                 ",
    "chapter": "2",
    "verse": "8",
    "text": "Ecco la voce del mio amico;"
  },
  {
    "id": 1697,
    "book": "solomon                                 ",
    "chapter": "2",
    "verse": "9",
    "text": "L'amico mio è simile ad un cavriuolo,"
  },
  {
    "id": 1698,
    "book": "solomon                                 ",
    "chapter": "2",
    "verse": "10",
    "text": "Il mio amico mi ha fatto motto, e mi ha detto:"
  },
  {
    "id": 1699,
    "book": "solomon                                 ",
    "chapter": "2",
    "verse": "11",
    "text": "Perciocchè, ecco, il verno è passato;"
  },
  {
    "id": 1700,
    "book": "solomon                                 ",
    "chapter": "2",
    "verse": "12",
    "text": "I fiori si veggono sulla terra;"
  },
  {
    "id": 1701,
    "book": "solomon                                 ",
    "chapter": "2",
    "verse": "13",
    "text": "Il fico ha messi i suoi ficucci,"
  },
  {
    "id": 1702,
    "book": "solomon                                 ",
    "chapter": "2",
    "verse": "14",
    "text": "O colomba mia, che stai nelle fessure delle rocce,"
  },
  {
    "id": 1703,
    "book": "solomon                                 ",
    "chapter": "2",
    "verse": "15",
    "text": "Pigliateci le volpi,"
  },
  {
    "id": 1704,
    "book": "solomon                                 ",
    "chapter": "2",
    "verse": "16",
    "text": "Il mio amico è mio, ed io son sua;"
  },
  {
    "id": 1705,
    "book": "solomon                                 ",
    "chapter": "2",
    "verse": "17",
    "text": "Ritornatene, amico mio,"
  }
]