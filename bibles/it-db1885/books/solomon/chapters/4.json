[
  {
    "id": 1717,
    "book": "solomon                                 ",
    "chapter": "4",
    "verse": "1",
    "text": "Eccoti bella, amica mia, eccoti bella;"
  },
  {
    "id": 1718,
    "book": "solomon                                 ",
    "chapter": "4",
    "verse": "2",
    "text": "I tuoi denti son come una mandra di pecore tutte uguali,"
  },
  {
    "id": 1719,
    "book": "solomon                                 ",
    "chapter": "4",
    "verse": "3",
    "text": "Le tue labbra somigliano un filo tinto in iscarlatto,"
  },
  {
    "id": 1720,
    "book": "solomon                                 ",
    "chapter": "4",
    "verse": "4",
    "text": "Il tuo collo somiglia la torre di Davide,"
  },
  {
    "id": 1721,
    "book": "solomon                                 ",
    "chapter": "4",
    "verse": "5",
    "text": "I tuoi due seni"
  },
  {
    "id": 1722,
    "book": "solomon                                 ",
    "chapter": "4",
    "verse": "6",
    "text": "Finchè spiri l'aura del giorno,"
  },
  {
    "id": 1723,
    "book": "solomon                                 ",
    "chapter": "4",
    "verse": "7",
    "text": "Tu sei tutta bella, amica mia,"
  },
  {
    "id": 1724,
    "book": "solomon                                 ",
    "chapter": "4",
    "verse": "8",
    "text": "Vieni meco dal Libano, o Sposa,"
  },
  {
    "id": 1725,
    "book": "solomon                                 ",
    "chapter": "4",
    "verse": "9",
    "text": "Tu mi hai involato il cuore, o Sposa, sorella mia;"
  },
  {
    "id": 1726,
    "book": "solomon                                 ",
    "chapter": "4",
    "verse": "10",
    "text": "Quanto son belli i tuoi amori, o Sposa, sorella mia!"
  },
  {
    "id": 1727,
    "book": "solomon                                 ",
    "chapter": "4",
    "verse": "11",
    "text": "O Sposa, le tue labbra stillano favi di miele;"
  },
  {
    "id": 1728,
    "book": "solomon                                 ",
    "chapter": "4",
    "verse": "12",
    "text": "O Sposa, sorella mia, tu sei un orto serrato,"
  },
  {
    "id": 1729,
    "book": "solomon                                 ",
    "chapter": "4",
    "verse": "13",
    "text": "Le tue piante novelle sono un giardino di melagrani,"
  },
  {
    "id": 1730,
    "book": "solomon                                 ",
    "chapter": "4",
    "verse": "14",
    "text": "Di nardo e di gruogo; di canna odorosa, e di cinnamomo,"
  },
  {
    "id": 1731,
    "book": "solomon                                 ",
    "chapter": "4",
    "verse": "15",
    "text": "O fonte degli orti,"
  },
  {
    "id": 1732,
    "book": "solomon                                 ",
    "chapter": "4",
    "verse": "16",
    "text": "Levati, Aquilone, e vieni, Austro;"
  }
]