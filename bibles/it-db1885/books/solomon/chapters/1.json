    "book": "solomon                                 ",
    "chapter": "1",
    "verse": "5",
    "text": "O figliuole di Gerusalemme, io son bruna, ma bella;"
  },
  {
    "id": 1677,
    "book": "solomon                                 ",
    "chapter": "1",
    "verse": "6",
    "text": "Non riguardate che io son bruna;"
