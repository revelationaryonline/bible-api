[
  {
    "id": 1749,
    "book": "solomon                                 ",
    "chapter": "6",
    "verse": "1",
    "text": "Ove è andato il tuo amico,"
  },
  {
    "id": 1750,
    "book": "solomon                                 ",
    "chapter": "6",
    "verse": "2",
    "text": "Il mio amico è disceso nel suo orto,"
  },
  {
    "id": 1751,
    "book": "solomon                                 ",
    "chapter": "6",
    "verse": "3",
    "text": "Io son dell'amico mio; e l'amico mio,"
  },
  {
    "id": 1752,
    "book": "solomon                                 ",
    "chapter": "6",
    "verse": "4",
    "text": "Amica mia, tu sei bella come Tirsa,"
  },
  {
    "id": 1753,
    "book": "solomon                                 ",
    "chapter": "6",
    "verse": "5",
    "text": "Rivolgi gli occhi tuoi, che non mi guardino fiso;"
  },
  {
    "id": 1754,
    "book": "solomon                                 ",
    "chapter": "6",
    "verse": "6",
    "text": "I tuoi denti son simili ad una mandra di pecore"
  },
  {
    "id": 1755,
    "book": "solomon                                 ",
    "chapter": "6",
    "verse": "7",
    "text": "La tua tempia, per entro la tua chioma,"
  },
  {
    "id": 1756,
    "book": "solomon                                 ",
    "chapter": "6",
    "verse": "8",
    "text": "Vi son sessanta regine, ed ottanta concubine,"
  },
  {
    "id": 1757,
    "book": "solomon                                 ",
    "chapter": "6",
    "verse": "9",
    "text": "Ma la colomba mia, la compiuta mia,"
  },
  {
    "id": 1758,
    "book": "solomon                                 ",
    "chapter": "6",
    "verse": "10",
    "text": "Chi è costei, che apparisce simile all'alba,"
  },
  {
    "id": 1759,
    "book": "solomon                                 ",
    "chapter": "6",
    "verse": "11",
    "text": "Io son discesa al giardino delle noci,"
  },
  {
    "id": 1760,
    "book": "solomon                                 ",
    "chapter": "6",
    "verse": "12",
    "text": "Io non mi sono avveduta che il mio desiderio mi ha renduta simile"
  },
  {
    "id": 1761,
    "book": "solomon                                 ",
    "chapter": "6",
    "verse": "13",
    "text": "Ritorna, ritorna, o Sullamita;"
  }
]