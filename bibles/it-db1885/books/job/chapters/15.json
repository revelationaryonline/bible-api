[
  {
    "id": 18603,
    "book": "job                                     ",
    "chapter": "15",
    "verse": "1",
    "text": "ED Elifaz Temanita rispose e disse:"
  },
  {
    "id": 18604,
    "book": "job                                     ",
    "chapter": "15",
    "verse": "2",
    "text": "Deve un uomo savio pronunziare opinioni vane,"
  },
  {
    "id": 18605,
    "book": "job                                     ",
    "chapter": "15",
    "verse": "3",
    "text": "Ed argomentar con parole inutili,"
  },
  {
    "id": 18606,
    "book": "job                                     ",
    "chapter": "15",
    "verse": "4",
    "text": "Sì certo, tu annulli il timor di Dio,"
  },
  {
    "id": 18607,
    "book": "job                                     ",
    "chapter": "15",
    "verse": "5",
    "text": "Perciocchè la tua bocca dimostra la tua iniquità,"
  },
  {
    "id": 18608,
    "book": "job                                     ",
    "chapter": "15",
    "verse": "6",
    "text": "La tua bocca ti condanna, e non io;"
  },
  {
    "id": 18609,
    "book": "job                                     ",
    "chapter": "15",
    "verse": "7",
    "text": "Sei tu il primiero uomo che sia nato nel mondo?"
  },
  {
    "id": 18610,
    "book": "job                                     ",
    "chapter": "15",
    "verse": "8",
    "text": "Hai tu udito il segreto di Dio,"
  },
  {
    "id": 18611,
    "book": "job                                     ",
    "chapter": "15",
    "verse": "9",
    "text": "Che sai tu, che noi non sappiamo?"
  },
  {
    "id": 18612,
    "book": "job                                     ",
    "chapter": "15",
    "verse": "10",
    "text": "Fra noi vi è eziandio alcun canuto, alcun molto vecchio,"
  },
  {
    "id": 18613,
    "book": "job                                     ",
    "chapter": "15",
    "verse": "11",
    "text": "Son le consolazioni di Dio troppo poca cosa per te?"
  },
  {
    "id": 18614,
    "book": "job                                     ",
    "chapter": "15",
    "verse": "12",
    "text": "Perchè ti trasporta il cuor tuo?"
  },
  {
    "id": 18615,
    "book": "job                                     ",
    "chapter": "15",
    "verse": "13",
    "text": "Che tu rivolga il tuo soffio,"
  },
  {
    "id": 18616,
    "book": "job                                     ",
    "chapter": "15",
    "verse": "14",
    "text": "Che cosa è l'uomo, ch'egli sia puro?"
  },
  {
    "id": 18617,
    "book": "job                                     ",
    "chapter": "15",
    "verse": "15",
    "text": "Ecco, egli non si fida ne' suoi santi,"
  },
  {
    "id": 18618,
    "book": "job                                     ",
    "chapter": "15",
    "verse": "16",
    "text": "Quanto più abbominevole e puzzolente"
  },
  {
    "id": 18619,
    "book": "job                                     ",
    "chapter": "15",
    "verse": "17",
    "text": "Io ti dichiarerò, ascoltami pure,"
  },
  {
    "id": 18620,
    "book": "job                                     ",
    "chapter": "15",
    "verse": "18",
    "text": "Il che i savi hanno narrato,"
  },
  {
    "id": 18621,
    "book": "job                                     ",
    "chapter": "15",
    "verse": "19",
    "text": "A' quali soli la terra fu data,"
  },
  {
    "id": 18622,
    "book": "job                                     ",
    "chapter": "15",
    "verse": "20",
    "text": "L'empio è tormentato tutti i giorni della sua vita;"
  },
  {
    "id": 18623,
    "book": "job                                     ",
    "chapter": "15",
    "verse": "21",
    "text": "Egli ha negli orecchi un romor di spaventi;"
  },
  {
    "id": 18624,
    "book": "job                                     ",
    "chapter": "15",
    "verse": "22",
    "text": "Egli non si fida punto di potere uscir delle tenebre;"
  },
  {
    "id": 18625,
    "book": "job                                     ",
    "chapter": "15",
    "verse": "23",
    "text": "Egli va tapinando per cercar dove sia del pane;"
  },
  {
    "id": 18626,
    "book": "job                                     ",
    "chapter": "15",
    "verse": "24",
    "text": "Angoscia e tribolazione lo spaventano;"
  },
  {
    "id": 18627,
    "book": "job                                     ",
    "chapter": "15",
    "verse": "25",
    "text": "Perciocchè egli ha distesa la sua mano contro a Dio,"
  },
  {
    "id": 18628,
    "book": "job                                     ",
    "chapter": "15",
    "verse": "26",
    "text": "E gli è corso col collo fermo,"
  },
  {
    "id": 18629,
    "book": "job                                     ",
    "chapter": "15",
    "verse": "27",
    "text": "Perciocchè egli ha coperto il suo viso di grasso,"
  },
  {
    "id": 18630,
    "book": "job                                     ",
    "chapter": "15",
    "verse": "28",
    "text": "Ed è abitato in città desolate, in case disabitate,"
  },
  {
    "id": 18631,
    "book": "job                                     ",
    "chapter": "15",
    "verse": "29",
    "text": "Egli non arricchirà, e le sue facoltà non saranno stabili,"
  },
  {
    "id": 18632,
    "book": "job                                     ",
    "chapter": "15",
    "verse": "30",
    "text": "Egli non si dipartirà giammai dalle tenebre,"
  },
  {
    "id": 18633,
    "book": "job                                     ",
    "chapter": "15",
    "verse": "31",
    "text": "Non confidisi già nella vanità, dalla quale è sedotto;"
  },
  {
    "id": 18634,
    "book": "job                                     ",
    "chapter": "15",
    "verse": "32",
    "text": "Questo mutamento si compierà fuor del suo tempo15.32 tempo Sal. 55.23. Eccl. 7.17.,"
  },
  {
    "id": 18635,
    "book": "job                                     ",
    "chapter": "15",
    "verse": "33",
    "text": "Il suo agresto sarà rapito come quel d'una vigna15.33 vigna Is. 18.5.,"
  },
  {
    "id": 18636,
    "book": "job                                     ",
    "chapter": "15",
    "verse": "34",
    "text": "Perciocchè la raunanza de' profani sarà deserta,"
  },
  {
    "id": 18637,
    "book": "job                                     ",
    "chapter": "15",
    "verse": "35",
    "text": "I quali concepiscono perversità, e partoriscono iniquità,"
  }
]