[
  {
    "id": 19193,
    "book": "job                                     ",
    "chapter": "38",
    "verse": "1",
    "text": "ALLORA il Signore rispose a Giobbe da un turbo38.1 turbo Esod. 19.16,18. 1 Re. 19.11 ecc. Ezec. 1.4. Na. 1.3., e disse:"
  },
  {
    "id": 19194,
    "book": "job                                     ",
    "chapter": "38",
    "verse": "2",
    "text": "Chi è costui, che oscura il consiglio"
  },
  {
    "id": 19195,
    "book": "job                                     ",
    "chapter": "38",
    "verse": "3",
    "text": "Deh! cigniti i lombi come un valente uomo,"
  },
  {
    "id": 19196,
    "book": "job                                     ",
    "chapter": "38",
    "verse": "4",
    "text": "Ove eri, quando io fondava la terra?"
  },
  {
    "id": 19197,
    "book": "job                                     ",
    "chapter": "38",
    "verse": "5",
    "text": "Chi ha disposte le misure di essa, se tu il sai?"
  },
  {
    "id": 19198,
    "book": "job                                     ",
    "chapter": "38",
    "verse": "6",
    "text": "Sopra che sono state fondate le sue basi?"
  },
  {
    "id": 19199,
    "book": "job                                     ",
    "chapter": "38",
    "verse": "7",
    "text": "Quando le stelle della mattina cantavano tutte insieme,"
  },
  {
    "id": 19200,
    "book": "job                                     ",
    "chapter": "38",
    "verse": "8",
    "text": "E chi rinchiuse il mare con porte38.8 porte Gen. 1.9. Sal. 33.7; 104.9."
  },
  {
    "id": 19201,
    "book": "job                                     ",
    "chapter": "38",
    "verse": "9",
    "text": "Quando io posi le nuvole per suo vestimento,"
  },
  {
    "id": 19202,
    "book": "job                                     ",
    "chapter": "38",
    "verse": "10",
    "text": "E determinai sopra esso il mio statuto,"
  },
  {
    "id": 19203,
    "book": "job                                     ",
    "chapter": "38",
    "verse": "11",
    "text": "E dissi: Tu verrai fin qua, e non passerai più innanzi;"
  },
  {
    "id": 19204,
    "book": "job                                     ",
    "chapter": "38",
    "verse": "12",
    "text": "Hai tu, da che tu sei in vita, comandato alla mattina?"
  },
  {
    "id": 19205,
    "book": "job                                     ",
    "chapter": "38",
    "verse": "13",
    "text": "Per occupar l'estremità della terra,"
  },
  {
    "id": 19206,
    "book": "job                                     ",
    "chapter": "38",
    "verse": "14",
    "text": "E far che la terra si muti in diverse forme, come argilla stampata;"
  },
  {
    "id": 19207,
    "book": "job                                     ",
    "chapter": "38",
    "verse": "15",
    "text": "E che la luce di queste cose sia divietata agli empi,"
  },
  {
    "id": 19208,
    "book": "job                                     ",
    "chapter": "38",
    "verse": "16",
    "text": "Sei tu entrato infino a' gorghi del mare,"
  },
  {
    "id": 19209,
    "book": "job                                     ",
    "chapter": "38",
    "verse": "17",
    "text": "Le porte della morte ti son esse scoperte,"
  },
  {
    "id": 19210,
    "book": "job                                     ",
    "chapter": "38",
    "verse": "18",
    "text": "Hai tu compresa la larghezza della terra?"
  },
  {
    "id": 19211,
    "book": "job                                     ",
    "chapter": "38",
    "verse": "19",
    "text": "Quale è la via del luogo ove dimora la luce?"
  },
  {
    "id": 19212,
    "book": "job                                     ",
    "chapter": "38",
    "verse": "20",
    "text": "Perchè tu vada a prendere essa luce, e la meni al termine del suo corso,"
  },
  {
    "id": 19213,
    "book": "job                                     ",
    "chapter": "38",
    "verse": "21",
    "text": "Sì, tu il sai; perciocchè allora nascesti,"
  },
  {
    "id": 19214,
    "book": "job                                     ",
    "chapter": "38",
    "verse": "22",
    "text": "Sei tu entrato dentro a' tesori della neve,"
  },
  {
    "id": 19215,
    "book": "job                                     ",
    "chapter": "38",
    "verse": "23",
    "text": "La quale io riserbo per lo tempo del nemico,"
  },
  {
    "id": 19216,
    "book": "job                                     ",
    "chapter": "38",
    "verse": "24",
    "text": "Per qual via scoppia la fiamma,"
  },
  {
    "id": 19217,
    "book": "job                                     ",
    "chapter": "38",
    "verse": "25",
    "text": "Chi ha fatti de' condotti alla piena delle acque,"
  },
  {
    "id": 19218,
    "book": "job                                     ",
    "chapter": "38",
    "verse": "26",
    "text": "Per far piovere in su la terra, ove non è niuno;"
  },
  {
    "id": 19219,
    "book": "job                                     ",
    "chapter": "38",
    "verse": "27",
    "text": "Per satollare il luogo desolato e deserto;"
  },
  {
    "id": 19220,
    "book": "job                                     ",
    "chapter": "38",
    "verse": "28",
    "text": "La pioggia ha ella un padre?"
  },
  {
    "id": 19221,
    "book": "job                                     ",
    "chapter": "38",
    "verse": "29",
    "text": "Del cui ventre è uscito il ghiaccio,"
  },
  {
    "id": 19222,
    "book": "job                                     ",
    "chapter": "38",
    "verse": "30",
    "text": "Chi fa che le acque si nascondano, e divengano come una pietra;"
  },
  {
    "id": 19223,
    "book": "job                                     ",
    "chapter": "38",
    "verse": "31",
    "text": "Puoi tu legare le delizie delle Gallinelle,"
  },
  {
    "id": 19224,
    "book": "job                                     ",
    "chapter": "38",
    "verse": "32",
    "text": "Puoi tu fare uscire i segni settentrionali al tempo loro,"
  },
  {
    "id": 19225,
    "book": "job                                     ",
    "chapter": "38",
    "verse": "33",
    "text": "Conosci tu gli ordini costituiti de' cieli?"
  },
  {
    "id": 19226,
    "book": "job                                     ",
    "chapter": "38",
    "verse": "34",
    "text": "Puoi tu, alzando la tua voce alla nuvola,"
  },
  {
    "id": 19227,
    "book": "job                                     ",
    "chapter": "38",
    "verse": "35",
    "text": "Puoi tu mandare i folgori,"
  },
  {
    "id": 19228,
    "book": "job                                     ",
    "chapter": "38",
    "verse": "36",
    "text": "Chi ha messa la sapienza nell'interior dell'uomo38.36 uomo Giob. 32.8 e rif. Sal. 51.6. Eccl. 2.26.?"
  },
  {
    "id": 19229,
    "book": "job                                     ",
    "chapter": "38",
    "verse": "37",
    "text": "Chi annovera le nuvole con sapienza?"
  },
  {
    "id": 19230,
    "book": "job                                     ",
    "chapter": "38",
    "verse": "38",
    "text": "Dopo che la polvere è stata stemperata, come un metallo fonduto;"
  }
]