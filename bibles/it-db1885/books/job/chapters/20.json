[
  {
    "id": 18726,
    "book": "job                                     ",
    "chapter": "20",
    "verse": "1",
    "text": "E SOFAR Naamatita rispose, e disse:"
  },
  {
    "id": 18727,
    "book": "job                                     ",
    "chapter": "20",
    "verse": "2",
    "text": "Perciò i miei pensamenti m'incitano a rispondere,"
  },
  {
    "id": 18728,
    "book": "job                                     ",
    "chapter": "20",
    "verse": "3",
    "text": "Io ho udita la mia vituperosa riprensione;"
  },
  {
    "id": 18729,
    "book": "job                                     ",
    "chapter": "20",
    "verse": "4",
    "text": "Non sai tu questo, che è stato d'ogni tempo,"
  },
  {
    "id": 18730,
    "book": "job                                     ",
    "chapter": "20",
    "verse": "5",
    "text": "Che il trionfo degli empi è di breve durata,"
  },
  {
    "id": 18731,
    "book": "job                                     ",
    "chapter": "20",
    "verse": "6",
    "text": "Avvegnachè la sua altezza salisse fino al cielo,"
  },
  {
    "id": 18732,
    "book": "job                                     ",
    "chapter": "20",
    "verse": "7",
    "text": "Pur perirà egli in perpetuo, come lo sterco suo;"
  },
  {
    "id": 18733,
    "book": "job                                     ",
    "chapter": "20",
    "verse": "8",
    "text": "Egli se ne volerà via come un sogno, e non sarà più ritrovato,"
  },
  {
    "id": 18734,
    "book": "job                                     ",
    "chapter": "20",
    "verse": "9",
    "text": "L'occhio che l'avrà veduto nol vedrà più,"
  },
  {
    "id": 18735,
    "book": "job                                     ",
    "chapter": "20",
    "verse": "10",
    "text": "I suoi figliuoli procacceranno il favor de' poveri,"
  },
  {
    "id": 18736,
    "book": "job                                     ",
    "chapter": "20",
    "verse": "11",
    "text": "Le sue ossa saranno ripiene degli eccessi della sua gioventù20.11 gioventù Sal. 25.7.,"
  },
  {
    "id": 18737,
    "book": "job                                     ",
    "chapter": "20",
    "verse": "12",
    "text": "Se il male gli è stato dolce nella bocca,"
  },
  {
    "id": 18738,
    "book": "job                                     ",
    "chapter": "20",
    "verse": "13",
    "text": "Se l'ha riserbato, e non l'ha gittato fuori;"
  },
  {
    "id": 18739,
    "book": "job                                     ",
    "chapter": "20",
    "verse": "14",
    "text": "Il suo cibo gli si cangerà nelle sue viscere,"
  },
  {
    "id": 18740,
    "book": "job                                     ",
    "chapter": "20",
    "verse": "15",
    "text": "Egli avrà trangugiate le ricchezze, ma egli le vomiterà;"
  },
  {
    "id": 18741,
    "book": "job                                     ",
    "chapter": "20",
    "verse": "16",
    "text": "Egli avrà succiato il veleno dell'aspido,"
  },
  {
    "id": 18742,
    "book": "job                                     ",
    "chapter": "20",
    "verse": "17",
    "text": "Egli non vedrà i ruscelli,"
  },
  {
    "id": 18743,
    "book": "job                                     ",
    "chapter": "20",
    "verse": "18",
    "text": "Egli renderà ciò che con fatica avrà acquistato, e non l'inghiottirà;"
  },
  {
    "id": 18744,
    "book": "job                                     ",
    "chapter": "20",
    "verse": "19",
    "text": "Perciocchè egli ha oppressato altrui, egli lascerà dietro a sè de' bisognosi;"
  },
  {
    "id": 18745,
    "book": "job                                     ",
    "chapter": "20",
    "verse": "20",
    "text": "Perciocchè egli non ha mai sentito riposo nel suo ventre,"
  },
  {
    "id": 18746,
    "book": "job                                     ",
    "chapter": "20",
    "verse": "21",
    "text": "Nulla gli rimarrà da mangiare,"
  },
  {
    "id": 18747,
    "book": "job                                     ",
    "chapter": "20",
    "verse": "22",
    "text": "Quando egli sarà ripieno a sufficienza, allora sarà distretto;"
  },
  {
    "id": 18748,
    "book": "job                                     ",
    "chapter": "20",
    "verse": "23",
    "text": "Quando egli sarà per empiersi il ventre,"
  },
  {
    "id": 18749,
    "book": "job                                     ",
    "chapter": "20",
    "verse": "24",
    "text": "Quando egli fuggirà dalle armi di ferro,"
  },
  {
    "id": 18750,
    "book": "job                                     ",
    "chapter": "20",
    "verse": "25",
    "text": "Come prima la saetta sarà tratta fuori,"
  },
  {
    "id": 18751,
    "book": "job                                     ",
    "chapter": "20",
    "verse": "26",
    "text": "Tutte le tenebre saran nascoste ne' suoi nascondimenti;"
  },
  {
    "id": 18752,
    "book": "job                                     ",
    "chapter": "20",
    "verse": "27",
    "text": "I cieli scopriranno la sua iniquità,"
  },
  {
    "id": 18753,
    "book": "job                                     ",
    "chapter": "20",
    "verse": "28",
    "text": "La rendita della sua casa sarà trasportata ad altri;"
  },
  {
    "id": 18754,
    "book": "job                                     ",
    "chapter": "20",
    "verse": "29",
    "text": "Questa è la parte assegnata da Dio all'uomo empio,"
  }
]