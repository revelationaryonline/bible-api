[
  {
    "id": 18528,
    "book": "job                                     ",
    "chapter": "12",
    "verse": "1",
    "text": "E GIOBBE rispose, e disse:"
  },
  {
    "id": 18529,
    "book": "job                                     ",
    "chapter": "12",
    "verse": "2",
    "text": "Sì, veramente voi siete tutt'un popolo,"
  },
  {
    "id": 18530,
    "book": "job                                     ",
    "chapter": "12",
    "verse": "3",
    "text": "Anch'io ho senno come voi;"
  },
  {
    "id": 18531,
    "book": "job                                     ",
    "chapter": "12",
    "verse": "4",
    "text": "Io son quell'uomo ch'è schernito dal suo amico12.4 amico Giob. 17.2,6; 21.3; 30.1.;"
  },
  {
    "id": 18532,
    "book": "job                                     ",
    "chapter": "12",
    "verse": "5",
    "text": "Colui che sta per isdrucciolare col piè,"
  },
  {
    "id": 18533,
    "book": "job                                     ",
    "chapter": "12",
    "verse": "6",
    "text": "I tabernacoli de' ladroni prosperano12.6 prosperano Giob. 21.7. Sal. 37.1,35.,"
  },
  {
    "id": 18534,
    "book": "job                                     ",
    "chapter": "12",
    "verse": "7",
    "text": "E in vero, domandane pur le bestie, ed esse tu l'insegneranno;"
  },
  {
    "id": 18535,
    "book": "job                                     ",
    "chapter": "12",
    "verse": "8",
    "text": "Ovvero, ragionane con la terra, ed essa te l'insegnerà;"
  },
  {
    "id": 18536,
    "book": "job                                     ",
    "chapter": "12",
    "verse": "9",
    "text": "Fra tutte queste creature,"
  },
  {
    "id": 18537,
    "book": "job                                     ",
    "chapter": "12",
    "verse": "10",
    "text": "Nella cui mano è l'anima d'ogni uomo vivente,"
  },
  {
    "id": 18538,
    "book": "job                                     ",
    "chapter": "12",
    "verse": "11",
    "text": "L'orecchio non prova egli le parole,"
  },
  {
    "id": 18539,
    "book": "job                                     ",
    "chapter": "12",
    "verse": "12",
    "text": "Ne' vecchi è la sapienza,"
  },
  {
    "id": 18540,
    "book": "job                                     ",
    "chapter": "12",
    "verse": "13",
    "text": "Appo lui è la sapienza e la forza12.13 forza Giob. 9.4; 36.5.;"
  },
  {
    "id": 18541,
    "book": "job                                     ",
    "chapter": "12",
    "verse": "14",
    "text": "Ecco, se egli ruina, la cosa non può esser riedificata;"
  },
  {
    "id": 18542,
    "book": "job                                     ",
    "chapter": "12",
    "verse": "15",
    "text": "Ecco, se egli rattiene le acque, elle si seccano12.15 seccano 1 Re. 8.35; 17.1.;"
  },
  {
    "id": 18543,
    "book": "job                                     ",
    "chapter": "12",
    "verse": "16",
    "text": "Appo lui è forza e ragione;"
  },
  {
    "id": 18544,
    "book": "job                                     ",
    "chapter": "12",
    "verse": "17",
    "text": "Egli ne mena i consiglieri spogliati,"
  },
  {
    "id": 18545,
    "book": "job                                     ",
    "chapter": "12",
    "verse": "18",
    "text": "Egli scioglie il legame dei re,"
  },
  {
    "id": 18546,
    "book": "job                                     ",
    "chapter": "12",
    "verse": "19",
    "text": "Egli ne mena i rettori spogliati,"
  },
  {
    "id": 18547,
    "book": "job                                     ",
    "chapter": "12",
    "verse": "20",
    "text": "Egli toglie la favella agli eloquenti,"
  },
  {
    "id": 18548,
    "book": "job                                     ",
    "chapter": "12",
    "verse": "21",
    "text": "Egli spande lo sprezzo sopra i nobili12.21 nobili Sal. 107.40. Dan. 2.21,22.,"
  },
  {
    "id": 18549,
    "book": "job                                     ",
    "chapter": "12",
    "verse": "22",
    "text": "Egli rivela le cose profonde12.22 profonde Mat. 10.26. 1 Cor. 4.5., traendole fuor delle tenebre;"
  },
  {
    "id": 18550,
    "book": "job                                     ",
    "chapter": "12",
    "verse": "23",
    "text": "Egli accresce le nazioni, ed altesì le distrugge;"
  },
  {
    "id": 18551,
    "book": "job                                     ",
    "chapter": "12",
    "verse": "24",
    "text": "Egli toglie il senno a' capi de' popoli della terra,"
  },
  {
    "id": 18552,
    "book": "job                                     ",
    "chapter": "12",
    "verse": "25",
    "text": "Vanno a tentone per le tenebre, senza luce alcuna:"
  }
]