[
  {
    "id": 18932,
    "book": "job                                     ",
    "chapter": "29",
    "verse": "1",
    "text": "E GIOBBE riprese il suo ragionamento, e disse:"
  },
  {
    "id": 18933,
    "book": "job                                     ",
    "chapter": "29",
    "verse": "2",
    "text": "Oh! fossi io pure come a' mesi di prima,"
  },
  {
    "id": 18934,
    "book": "job                                     ",
    "chapter": "29",
    "verse": "3",
    "text": "Quando egli faceva rilucere la sua lampana sopra il mio capo,"
  },
  {
    "id": 18935,
    "book": "job                                     ",
    "chapter": "29",
    "verse": "4",
    "text": "Come io era al tempo della mia giovanezza,"
  },
  {
    "id": 18936,
    "book": "job                                     ",
    "chapter": "29",
    "verse": "5",
    "text": "Mentre l'Onnipotente era ancora meco,"
  },
  {
    "id": 18937,
    "book": "job                                     ",
    "chapter": "29",
    "verse": "6",
    "text": "Mentre io lavava i miei passi nel burro,"
  },
  {
    "id": 18938,
    "book": "job                                     ",
    "chapter": "29",
    "verse": "7",
    "text": "Quando io andava fuori alla porta per la città,"
  },
  {
    "id": 18939,
    "book": "job                                     ",
    "chapter": "29",
    "verse": "8",
    "text": "I fanciulli, veggendomi, si nascondevano;"
  },
  {
    "id": 18940,
    "book": "job                                     ",
    "chapter": "29",
    "verse": "9",
    "text": "I principali si rattenevano di parlare,"
  },
  {
    "id": 18941,
    "book": "job                                     ",
    "chapter": "29",
    "verse": "10",
    "text": "La voce de' rettori era celata,"
  },
  {
    "id": 18942,
    "book": "job                                     ",
    "chapter": "29",
    "verse": "11",
    "text": "L'orecchio che mi udiva mi celebrava beato;"
  },
  {
    "id": 18943,
    "book": "job                                     ",
    "chapter": "29",
    "verse": "12",
    "text": "Perciocchè io liberava il povero che gridava,"
  },
  {
    "id": 18944,
    "book": "job                                     ",
    "chapter": "29",
    "verse": "13",
    "text": "La benedizione di chi periva veniva sopra me;"
  },
  {
    "id": 18945,
    "book": "job                                     ",
    "chapter": "29",
    "verse": "14",
    "text": "Io mi vestiva di giustizia29.14 giustizia Deut. 24.13. Efes. 6.14 ecc. 1 Tess. 5.8., ed ella altresì mi rivestiva;"
  },
  {
    "id": 18946,
    "book": "job                                     ",
    "chapter": "29",
    "verse": "15",
    "text": "Io era occhi al cieco,"
  },
  {
    "id": 18947,
    "book": "job                                     ",
    "chapter": "29",
    "verse": "16",
    "text": "Io era padre a' bisognosi,"
  },
  {
    "id": 18948,
    "book": "job                                     ",
    "chapter": "29",
    "verse": "17",
    "text": "E rompeva i mascellari al perverso29.17 perverso Prov. 30.14.,"
  },
  {
    "id": 18949,
    "book": "job                                     ",
    "chapter": "29",
    "verse": "18",
    "text": "Onde io diceva: Io morrò nel mio nido29.18 nido Sal. 30.6.,"
  },
  {
    "id": 18950,
    "book": "job                                     ",
    "chapter": "29",
    "verse": "19",
    "text": "La mia radice era aperta alle acque29.19 acque Sal. 1.3. Ger. 17.8.,"
  },
  {
    "id": 18951,
    "book": "job                                     ",
    "chapter": "29",
    "verse": "20",
    "text": "La mia gloria si rinnovava in me,"
  },
  {
    "id": 18952,
    "book": "job                                     ",
    "chapter": "29",
    "verse": "21",
    "text": "Altri mi ascoltava, ed aspettava che io avessi parlato;"
  },
  {
    "id": 18953,
    "book": "job                                     ",
    "chapter": "29",
    "verse": "22",
    "text": "Dopo che io avea parlato, niuno replicava;"
  },
  {
    "id": 18954,
    "book": "job                                     ",
    "chapter": "29",
    "verse": "23",
    "text": "Essi mi aspettavano come la pioggia,"
  },
  {
    "id": 18955,
    "book": "job                                     ",
    "chapter": "29",
    "verse": "24",
    "text": "Se io rideva verso loro, essi nol credevano,"
  },
  {
    "id": 18956,
    "book": "job                                     ",
    "chapter": "29",
    "verse": "25",
    "text": "Se mi piaceva d'andar con loro, io sedeva in capo,"
  }
]