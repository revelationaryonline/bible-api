[
  {
    "id": 18378,
    "book": "job                                     ",
    "chapter": "6",
    "verse": "1",
    "text": "E GIOBBE rispose e disse:"
  },
  {
    "id": 18379,
    "book": "job                                     ",
    "chapter": "6",
    "verse": "2",
    "text": "Fosse pur lo sdegno mio ben pesato,"
  },
  {
    "id": 18380,
    "book": "job                                     ",
    "chapter": "6",
    "verse": "3",
    "text": "Perciocchè ora sarebbe trovata più pesante che la rena del mare;"
  },
  {
    "id": 18381,
    "book": "job                                     ",
    "chapter": "6",
    "verse": "4",
    "text": "Perchè le saette dell'Onnipotente sono dentro di me,"
  },
  {
    "id": 18382,
    "book": "job                                     ",
    "chapter": "6",
    "verse": "5",
    "text": "L'asino salvatico raglia egli presso all'erba?"
  },
  {
    "id": 18383,
    "book": "job                                     ",
    "chapter": "6",
    "verse": "6",
    "text": "Una cosa insipida si mangia ella senza sale?"
  },
  {
    "id": 18384,
    "book": "job                                     ",
    "chapter": "6",
    "verse": "7",
    "text": "Le cose che l'anima mia avrebbe ricusate pur di toccare"
  },
  {
    "id": 18385,
    "book": "job                                     ",
    "chapter": "6",
    "verse": "8",
    "text": "Oh! venisse pur quel ch'io chieggio,"
  },
  {
    "id": 18386,
    "book": "job                                     ",
    "chapter": "6",
    "verse": "9",
    "text": "E piacesse a Dio di tritarmi,"
  },
  {
    "id": 18387,
    "book": "job                                     ",
    "chapter": "6",
    "verse": "10",
    "text": "Questa sarebbe pure ancora la mia consolazione,"
  },
  {
    "id": 18388,
    "book": "job                                     ",
    "chapter": "6",
    "verse": "11",
    "text": "Quale è la mia forza, per isperare?"
  },
  {
    "id": 18389,
    "book": "job                                     ",
    "chapter": "6",
    "verse": "12",
    "text": "La mia forza è ella come la forza delle pietre?"
  },
  {
    "id": 18390,
    "book": "job                                     ",
    "chapter": "6",
    "verse": "13",
    "text": "Non è egli così che io non ho più alcun ristoro in me?"
  },
  {
    "id": 18391,
    "book": "job                                     ",
    "chapter": "6",
    "verse": "14",
    "text": "Benignità dovrebbe essere usata dall'amico"
  },
  {
    "id": 18392,
    "book": "job                                     ",
    "chapter": "6",
    "verse": "15",
    "text": "I miei fratelli mi hanno fallito6.15 fallito Sal. 38.11; 41.9., a guisa di un ruscello,"
  },
  {
    "id": 18393,
    "book": "job                                     ",
    "chapter": "6",
    "verse": "16",
    "text": "I quali sono scuri per lo ghiaccio;"
  },
  {
    "id": 18394,
    "book": "job                                     ",
    "chapter": "6",
    "verse": "17",
    "text": "Ma poi, al tempo che corrono, vengono meno,"
  },
  {
    "id": 18395,
    "book": "job                                     ",
    "chapter": "6",
    "verse": "18",
    "text": "I sentieri del corso loro si contorcono,"
  },
  {
    "id": 18396,
    "book": "job                                     ",
    "chapter": "6",
    "verse": "19",
    "text": "Le schiere de' viandanti di Tema li riguardavano,"
  },
  {
    "id": 18397,
    "book": "job                                     ",
    "chapter": "6",
    "verse": "20",
    "text": "Ma si vergognano di esservisi fidati;"
  },
  {
    "id": 18398,
    "book": "job                                     ",
    "chapter": "6",
    "verse": "21",
    "text": "Perciocchè ora voi siete venuti a niente;"
  },
  {
    "id": 18399,
    "book": "job                                     ",
    "chapter": "6",
    "verse": "22",
    "text": "Vi ho io detto: Datemi,"
  },
  {
    "id": 18400,
    "book": "job                                     ",
    "chapter": "6",
    "verse": "23",
    "text": "E liberatemi di man del nemico,"
  },
  {
    "id": 18401,
    "book": "job                                     ",
    "chapter": "6",
    "verse": "24",
    "text": "Insegnatemi, ed io mi tacerò;"
  },
  {
    "id": 18402,
    "book": "job                                     ",
    "chapter": "6",
    "verse": "25",
    "text": "Quanto son potenti le parole di dirittura!"
  },
  {
    "id": 18403,
    "book": "job                                     ",
    "chapter": "6",
    "verse": "26",
    "text": "Stimate voi che parlare sia convincere?"
  },
  {
    "id": 18404,
    "book": "job                                     ",
    "chapter": "6",
    "verse": "27",
    "text": "E pure ancora voi vi gittate addosso all'orfano,"
  },
  {
    "id": 18405,
    "book": "job                                     ",
    "chapter": "6",
    "verse": "28",
    "text": "Ora dunque piacciavi riguardare a me,"
  },
  {
    "id": 18406,
    "book": "job                                     ",
    "chapter": "6",
    "verse": "29",
    "text": "Deh! ravvedetevi; che non siavi iniquità;"
  },
  {
    "id": 18407,
    "book": "job                                     ",
    "chapter": "6",
    "verse": "30",
    "text": "Evvi egli iniquità nella mia lingua?"
  }
]