[
  {
    "id": 18819,
    "book": "job                                     ",
    "chapter": "23",
    "verse": "1",
    "text": "E GIOBBE rispose, e disse:"
  },
  {
    "id": 18820,
    "book": "job                                     ",
    "chapter": "23",
    "verse": "2",
    "text": "Ancor oggi il mio lamento è ribellione;"
  },
  {
    "id": 18821,
    "book": "job                                     ",
    "chapter": "23",
    "verse": "3",
    "text": "Oh! sapessi io pure ove trovare Iddio!"
  },
  {
    "id": 18822,
    "book": "job                                     ",
    "chapter": "23",
    "verse": "4",
    "text": "Io sporrei per ordine la mia ragione nel suo cospetto23.4 cospetto Giob. 13.3; 16.21.,"
  },
  {
    "id": 18823,
    "book": "job                                     ",
    "chapter": "23",
    "verse": "5",
    "text": "Io saprei le parole ch'egli mi risponderebbe,"
  },
  {
    "id": 18824,
    "book": "job                                     ",
    "chapter": "23",
    "verse": "6",
    "text": "Contenderebbe egli meco con grandezza di forza23.6 forza Is. 27.4,8; 57.16.?"
  },
  {
    "id": 18825,
    "book": "job                                     ",
    "chapter": "23",
    "verse": "7",
    "text": "Ivi l'uomo diritto verrebbe a ragione con lui,"
  },
  {
    "id": 18826,
    "book": "job                                     ",
    "chapter": "23",
    "verse": "8",
    "text": "Ecco, se io vo innanzi, egli non vi è;"
  },
  {
    "id": 18827,
    "book": "job                                     ",
    "chapter": "23",
    "verse": "9",
    "text": "Se a man sinistra, quando egli opera, io nol veggo;"
  },
  {
    "id": 18828,
    "book": "job                                     ",
    "chapter": "23",
    "verse": "10",
    "text": "Quando egli avrà conosciuta la mia via,"
  },
  {
    "id": 18829,
    "book": "job                                     ",
    "chapter": "23",
    "verse": "11",
    "text": "Il mio piè si è attenuto alle sue pedate;"
  },
  {
    "id": 18830,
    "book": "job                                     ",
    "chapter": "23",
    "verse": "12",
    "text": "Ed anche non ho rimosso d'innanzi a me il comandamento delle sue labbra;"
  },
  {
    "id": 18831,
    "book": "job                                     ",
    "chapter": "23",
    "verse": "13",
    "text": "Ma, se egli è in un proponimento, chi ne lo storrà?"
  },
  {
    "id": 18832,
    "book": "job                                     ",
    "chapter": "23",
    "verse": "14",
    "text": "Egli certo compierà ciò ch'egli ha statuito di me;"
  },
  {
    "id": 18833,
    "book": "job                                     ",
    "chapter": "23",
    "verse": "15",
    "text": "Perciò io sono smarrito per cagion di lui;"
  },
  {
    "id": 18834,
    "book": "job                                     ",
    "chapter": "23",
    "verse": "16",
    "text": "Certo Iddio mi ha fatto struggere il cuore,"
  },
  {
    "id": 18835,
    "book": "job                                     ",
    "chapter": "23",
    "verse": "17",
    "text": "Perchè non sono io stato troncato, per non veder le tenebre?"
  }
]