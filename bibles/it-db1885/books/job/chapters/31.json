[
  {
    "id": 18988,
    "book": "job                                     ",
    "chapter": "31",
    "verse": "1",
    "text": "Io avea fatto patto con gli occhi miei;"
  },
  {
    "id": 18989,
    "book": "job                                     ",
    "chapter": "31",
    "verse": "2",
    "text": "E pur quale è la parte che Iddio mi ha mandata da alto?"
  },
  {
    "id": 18990,
    "book": "job                                     ",
    "chapter": "31",
    "verse": "3",
    "text": "La ruina non è ella per lo perverso,"
  },
  {
    "id": 18991,
    "book": "job                                     ",
    "chapter": "31",
    "verse": "4",
    "text": "Non vede egli le mie vie31.4 vie Prov. 15.3. Ger. 32.19.?"
  },
  {
    "id": 18992,
    "book": "job                                     ",
    "chapter": "31",
    "verse": "5",
    "text": "Se io son proceduto con falsità,"
  },
  {
    "id": 18993,
    "book": "job                                     ",
    "chapter": "31",
    "verse": "6",
    "text": "Pesimi pure Iddio con bilance giuste,"
  },
  {
    "id": 18994,
    "book": "job                                     ",
    "chapter": "31",
    "verse": "7",
    "text": "Se i miei passi si sono stornati dalla diritta via,"
  },
  {
    "id": 18995,
    "book": "job                                     ",
    "chapter": "31",
    "verse": "8",
    "text": "Semini pure io, e un altro se lo mangi;"
  },
  {
    "id": 18996,
    "book": "job                                     ",
    "chapter": "31",
    "verse": "9",
    "text": "Se il mio cuore è stato allettato dietro ad alcuna donna,"
  },
  {
    "id": 18997,
    "book": "job                                     ",
    "chapter": "31",
    "verse": "10",
    "text": "Macini pur la mia moglie ad un altro,"
  },
  {
    "id": 18998,
    "book": "job                                     ",
    "chapter": "31",
    "verse": "11",
    "text": "Perciocchè quello è una scelleratezza31.11 scelleratezza Lev. 20.10. Deut. 22.22.,"
  },
  {
    "id": 18999,
    "book": "job                                     ",
    "chapter": "31",
    "verse": "12",
    "text": "Conciossiachè quello sarebbe stato un fuoco"
  },
  {
    "id": 19000,
    "book": "job                                     ",
    "chapter": "31",
    "verse": "13",
    "text": "Se io ho disdegnato di comparire in giudicio col mio servitore,"
  },
  {
    "id": 19001,
    "book": "job                                     ",
    "chapter": "31",
    "verse": "14",
    "text": "E che farei io, quando Iddio si leverà?"
  },
  {
    "id": 19002,
    "book": "job                                     ",
    "chapter": "31",
    "verse": "15",
    "text": "Colui che mi ha fatto nel seno non ha egli fatto ancora lui?"
  },
  {
    "id": 19003,
    "book": "job                                     ",
    "chapter": "31",
    "verse": "16",
    "text": "Se io ho rifiutato a' poveri ciò che desideravano,"
  },
  {
    "id": 19004,
    "book": "job                                     ",
    "chapter": "31",
    "verse": "17",
    "text": "E se ho mangiato tutto solo il mio boccone,"
  },
  {
    "id": 19005,
    "book": "job                                     ",
    "chapter": "31",
    "verse": "18",
    "text": "(Conciossiachè dalla mia faciullezza esso sia stato allevato meco,"
  },
  {
    "id": 19006,
    "book": "job                                     ",
    "chapter": "31",
    "verse": "19",
    "text": "Se ho veduto che alcuno perisse per mancamento di vestimento,"
  },
  {
    "id": 19007,
    "book": "job                                     ",
    "chapter": "31",
    "verse": "20",
    "text": "Se le sue reni non mi hanno benedetto,"
  },
  {
    "id": 19008,
    "book": "job                                     ",
    "chapter": "31",
    "verse": "21",
    "text": "Se io ho levata la mano contro all'orfano,"
  },
  {
    "id": 19009,
    "book": "job                                     ",
    "chapter": "31",
    "verse": "22",
    "text": "Caggiami la paletta della spalla,"
  },
  {
    "id": 19010,
    "book": "job                                     ",
    "chapter": "31",
    "verse": "23",
    "text": "Perciocchè io avea spavento della ruina mandata da Dio31.23 Dio Is. 13.6. Gioel. 1.15.,"
  },
  {
    "id": 19011,
    "book": "job                                     ",
    "chapter": "31",
    "verse": "24",
    "text": "Se ho posto l'oro per mia speranza;"
  },
  {
    "id": 19012,
    "book": "job                                     ",
    "chapter": "31",
    "verse": "25",
    "text": "Se mi son rallegrato perchè le mie facoltà fosser grandi,"
  },
  {
    "id": 19013,
    "book": "job                                     ",
    "chapter": "31",
    "verse": "26",
    "text": "Se ho riguardato il sole, quando risplendeva;"
  },
  {
    "id": 19014,
    "book": "job                                     ",
    "chapter": "31",
    "verse": "27",
    "text": "E se il mio cuore è stato di nascosto sedotto,"
  },
  {
    "id": 19015,
    "book": "job                                     ",
    "chapter": "31",
    "verse": "28",
    "text": "Questa ancora è una iniquità da giudici;"
  },
  {
    "id": 19016,
    "book": "job                                     ",
    "chapter": "31",
    "verse": "29",
    "text": "Se mi son rallegrato della calamità del mio nemico31.29 nemico Prov. 17.5.,"
  },
  {
    "id": 19017,
    "book": "job                                     ",
    "chapter": "31",
    "verse": "30",
    "text": "Io che non pure ho recato il mio palato a peccare,"
  },
  {
    "id": 19018,
    "book": "job                                     ",
    "chapter": "31",
    "verse": "31",
    "text": "Se la gente del mio tabernacolo non ha detto:"
  },
  {
    "id": 19019,
    "book": "job                                     ",
    "chapter": "31",
    "verse": "32",
    "text": "Il forestiere non è restato la notte in su la strada;"
  },
  {
    "id": 19020,
    "book": "job                                     ",
    "chapter": "31",
    "verse": "33",
    "text": "Se io ho coperto il mio misfatto31.33 misfatto Gen. 3.8,12. Prov. 28.13. Os. 6.7., come fanno gli uomini,"
  },
  {
    "id": 19021,
    "book": "job                                     ",
    "chapter": "31",
    "verse": "34",
    "text": "Quantunque io potessi spaventare una gran moltitudine,"
  },
  {
    "id": 19022,
    "book": "job                                     ",
    "chapter": "31",
    "verse": "35",
    "text": "Oh! avessi io pure chi mi ascoltasse!"
  },
  {
    "id": 19023,
    "book": "job                                     ",
    "chapter": "31",
    "verse": "36",
    "text": "Se io non la porto in su la spalla,"
  },
  {
    "id": 19024,
    "book": "job                                     ",
    "chapter": "31",
    "verse": "37",
    "text": "Io gli renderei conto di tutti i miei passi,"
  },
  {
    "id": 19025,
    "book": "job                                     ",
    "chapter": "31",
    "verse": "38",
    "text": "Se la mia terra grida contro a me,"
  },
  {
    "id": 19026,
    "book": "job                                     ",
    "chapter": "31",
    "verse": "39",
    "text": "Se ho mangiati i suoi frutti senza pagamento31.39 pagamento Giac. 5.4.,"
  },
  {
    "id": 19027,
    "book": "job                                     ",
    "chapter": "31",
    "verse": "40",
    "text": "In luogo del grano nascami il tribolo,"
  }
]