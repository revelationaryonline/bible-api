[
  {
    "id": 18429,
    "book": "job                                     ",
    "chapter": "8",
    "verse": "1",
    "text": "E BILDAD Suhita rispose, e disse:"
  },
  {
    "id": 18430,
    "book": "job                                     ",
    "chapter": "8",
    "verse": "2",
    "text": "Infino a quando proferirai tali ragionamenti,"
  },
  {
    "id": 18431,
    "book": "job                                     ",
    "chapter": "8",
    "verse": "3",
    "text": "Iddio pervertirebbe egli il giudicio?"
  },
  {
    "id": 18432,
    "book": "job                                     ",
    "chapter": "8",
    "verse": "4",
    "text": "Se i tuoi figliuoli hanno peccato contro a lui8.4 lui Giob. 1.5,18.,"
  },
  {
    "id": 18433,
    "book": "job                                     ",
    "chapter": "8",
    "verse": "5",
    "text": "Ma quant'è a te, se tu ricerchi Iddio,"
  },
  {
    "id": 18434,
    "book": "job                                     ",
    "chapter": "8",
    "verse": "6",
    "text": "Se tu sei puro e diritto,"
  },
  {
    "id": 18435,
    "book": "job                                     ",
    "chapter": "8",
    "verse": "7",
    "text": "E la tua condizione di prima sarà stata piccola,"
  },
  {
    "id": 18436,
    "book": "job                                     ",
    "chapter": "8",
    "verse": "8",
    "text": "Perciocchè domanda pur le età primiere8.8 primiere Deut. 4.32; 32.7.,"
  },
  {
    "id": 18437,
    "book": "job                                     ",
    "chapter": "8",
    "verse": "9",
    "text": "Imperocchè, quant'è a noi, siamo sol da ieri in qua,"
  },
  {
    "id": 18438,
    "book": "job                                     ",
    "chapter": "8",
    "verse": "10",
    "text": "Non insegnerannoti essi, e non parlerannoti,"
  },
  {
    "id": 18439,
    "book": "job                                     ",
    "chapter": "8",
    "verse": "11",
    "text": "Il giunco sorgerà egli senza pantano?"
  },
  {
    "id": 18440,
    "book": "job                                     ",
    "chapter": "8",
    "verse": "12",
    "text": "E pure, mentre è ancor verde, e non è ancora segata,"
  },
  {
    "id": 18441,
    "book": "job                                     ",
    "chapter": "8",
    "verse": "13",
    "text": "Tali son le vie di tutti quelli che dimenticano Iddio,"
  },
  {
    "id": 18442,
    "book": "job                                     ",
    "chapter": "8",
    "verse": "14",
    "text": "La cui speranza sarà troncata,"
  },
  {
    "id": 18443,
    "book": "job                                     ",
    "chapter": "8",
    "verse": "15",
    "text": "Egli si appoggerà in su la casa sua, ma quella non istarà ferma;"
  },
  {
    "id": 18444,
    "book": "job                                     ",
    "chapter": "8",
    "verse": "16",
    "text": "Egli è verdeggiante al sole,"
  },
  {
    "id": 18445,
    "book": "job                                     ",
    "chapter": "8",
    "verse": "17",
    "text": "Le sue radici s'intralciano presso alla fonte,"
  },
  {
    "id": 18446,
    "book": "job                                     ",
    "chapter": "8",
    "verse": "18",
    "text": "Ma, se alcuno lo manderà in ruina, divellendolo dal luogo suo,"
  },
  {
    "id": 18447,
    "book": "job                                     ",
    "chapter": "8",
    "verse": "19",
    "text": "Ecco, tale è l'allegrezza della sua via,"
  },
  {
    "id": 18448,
    "book": "job                                     ",
    "chapter": "8",
    "verse": "20",
    "text": "Ecco, Iddio non disdegna l'uomo intiero;"
  },
  {
    "id": 18449,
    "book": "job                                     ",
    "chapter": "8",
    "verse": "21",
    "text": "Ancora empierà egli la tua bocca di riso,"
  },
  {
    "id": 18450,
    "book": "job                                     ",
    "chapter": "8",
    "verse": "22",
    "text": "Quelli che ti odiano saranno vestiti di vergogna;"
  }
]