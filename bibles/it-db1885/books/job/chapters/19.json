[
  {
    "id": 18697,
    "book": "job                                     ",
    "chapter": "19",
    "verse": "1",
    "text": "E GIOBBE rispose, e disse:"
  },
  {
    "id": 18698,
    "book": "job                                     ",
    "chapter": "19",
    "verse": "2",
    "text": "Infino a quando addoglierete voi l'anima mia,"
  },
  {
    "id": 18699,
    "book": "job                                     ",
    "chapter": "19",
    "verse": "3",
    "text": "Già dieci volte voi mi avete fatta onta;"
  },
  {
    "id": 18700,
    "book": "job                                     ",
    "chapter": "19",
    "verse": "4",
    "text": "Ma pure, sia così certamente che io abbia fallito,"
  },
  {
    "id": 18701,
    "book": "job                                     ",
    "chapter": "19",
    "verse": "5",
    "text": "Se pur volete innalzarvi sopra a me,"
  },
  {
    "id": 18702,
    "book": "job                                     ",
    "chapter": "19",
    "verse": "6",
    "text": "Sappiate ora che Iddio mi ha sovvertito,"
  },
  {
    "id": 18703,
    "book": "job                                     ",
    "chapter": "19",
    "verse": "7",
    "text": "Ecco, io grido violenza, e non sono esaudito;"
  },
  {
    "id": 18704,
    "book": "job                                     ",
    "chapter": "19",
    "verse": "8",
    "text": "Egli ha abbarrata la mia via sì che io non posso passare;"
  },
  {
    "id": 18705,
    "book": "job                                     ",
    "chapter": "19",
    "verse": "9",
    "text": "Egli mi ha spogliato della mia gloria,"
  },
  {
    "id": 18706,
    "book": "job                                     ",
    "chapter": "19",
    "verse": "10",
    "text": "Egli mi ha disfatto d'ogn'intorno, sì che io me ne vo via;"
  },
  {
    "id": 18707,
    "book": "job                                     ",
    "chapter": "19",
    "verse": "11",
    "text": "Ed ha accesa la sua ira contro a me,"
  },
  {
    "id": 18708,
    "book": "job                                     ",
    "chapter": "19",
    "verse": "12",
    "text": "Le sue schiere son venute tutte insieme,"
  },
  {
    "id": 18709,
    "book": "job                                     ",
    "chapter": "19",
    "verse": "13",
    "text": "Egli ha allontanati d'appresso a me i miei fratelli;"
  },
  {
    "id": 18710,
    "book": "job                                     ",
    "chapter": "19",
    "verse": "14",
    "text": "I miei prossimi se ne son rimasti,"
  },
  {
    "id": 18711,
    "book": "job                                     ",
    "chapter": "19",
    "verse": "15",
    "text": "I miei famigliari, e le mie serventi, mi tengono per istraniero;"
  },
  {
    "id": 18712,
    "book": "job                                     ",
    "chapter": "19",
    "verse": "16",
    "text": "Io chiamo il mio servitore, ed egli non risponde,"
  },
  {
    "id": 18713,
    "book": "job                                     ",
    "chapter": "19",
    "verse": "17",
    "text": "Il mio fiato è divenuto stranio alla mia moglie,"
  },
  {
    "id": 18714,
    "book": "job                                     ",
    "chapter": "19",
    "verse": "18",
    "text": "Fino a' piccoli fanciulli mi disdegnano;"
  },
  {
    "id": 18715,
    "book": "job                                     ",
    "chapter": "19",
    "verse": "19",
    "text": "Tutti i miei consiglieri segreti mi abbominano;"
  },
  {
    "id": 18716,
    "book": "job                                     ",
    "chapter": "19",
    "verse": "20",
    "text": "Le mie ossa sono attaccate alla mia pelle ed alla mia carne;"
  },
  {
    "id": 18717,
    "book": "job                                     ",
    "chapter": "19",
    "verse": "21",
    "text": "Abbiate pietà di me, abbiate pietà di me, o voi amici miei;"
  },
  {
    "id": 18718,
    "book": "job                                     ",
    "chapter": "19",
    "verse": "22",
    "text": "Perchè mi perseguitate voi come Iddio,"
  },
  {
    "id": 18719,
    "book": "job                                     ",
    "chapter": "19",
    "verse": "23",
    "text": "Oh! fosser pur ora scritti i miei ragionamenti!"
  },
  {
    "id": 18720,
    "book": "job                                     ",
    "chapter": "19",
    "verse": "24",
    "text": "Oh! fossero in sempiterno intagliati con uno scarpello di ferro"
  },
  {
    "id": 18721,
    "book": "job                                     ",
    "chapter": "19",
    "verse": "25",
    "text": "Ora, quant'è a me, io so che il mio Redentore19.25 Redentore Gen. 48.16. Sal. 103.4. Is. 43.14; 44.6-24; 49.7. vive,"
  },
  {
    "id": 18722,
    "book": "job                                     ",
    "chapter": "19",
    "verse": "26",
    "text": "E quantunque, dopo la mia pelle, questo corpo sia roso,"
  },
  {
    "id": 18723,
    "book": "job                                     ",
    "chapter": "19",
    "verse": "27",
    "text": "Il quale io vedrò, gli occhi miei lo vedranno, e non un altro;"
  },
  {
    "id": 18724,
    "book": "job                                     ",
    "chapter": "19",
    "verse": "28",
    "text": "Anzi dovreste dire: Perchè lo perseguitiamo noi?"
  },
  {
    "id": 18725,
    "book": "job                                     ",
    "chapter": "19",
    "verse": "29",
    "text": "Temiate della spada;"
  }
]