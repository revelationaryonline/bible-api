[
  {
    "id": 19083,
    "book": "job                                     ",
    "chapter": "34",
    "verse": "1",
    "text": "ED Elihu proseguì a parlare, e disse:"
  },
  {
    "id": 19084,
    "book": "job                                     ",
    "chapter": "34",
    "verse": "2",
    "text": "Voi savi, udite i miei ragionamenti;"
  },
  {
    "id": 19085,
    "book": "job                                     ",
    "chapter": "34",
    "verse": "3",
    "text": "Perciocchè l'orecchio esamina i ragionamenti,"
  },
  {
    "id": 19086,
    "book": "job                                     ",
    "chapter": "34",
    "verse": "4",
    "text": "Proponiamoci la dirittura,"
  },
  {
    "id": 19087,
    "book": "job                                     ",
    "chapter": "34",
    "verse": "5",
    "text": "Conciossiachè Giobbe abbia detto: Io son giusto34.5 giusto Giob. 33.9 e rif.;"
  },
  {
    "id": 19088,
    "book": "job                                     ",
    "chapter": "34",
    "verse": "6",
    "text": "Mentirei io intorno alla mia ragione?"
  },
  {
    "id": 19089,
    "book": "job                                     ",
    "chapter": "34",
    "verse": "7",
    "text": "Quale è l'uomo simile a Giobbe,"
  },
  {
    "id": 19090,
    "book": "job                                     ",
    "chapter": "34",
    "verse": "8",
    "text": "E che cammina in compagnia con gli operatori d'iniquità,"
  },
  {
    "id": 19091,
    "book": "job                                     ",
    "chapter": "34",
    "verse": "9",
    "text": "Perciocchè egli ha detto: L'uomo non fa niun profitto"
  },
  {
    "id": 19092,
    "book": "job                                     ",
    "chapter": "34",
    "verse": "10",
    "text": "Perciò, uomini di senno, ascoltatemi;"
  },
  {
    "id": 19093,
    "book": "job                                     ",
    "chapter": "34",
    "verse": "11",
    "text": "Perciocchè egli rende all'uomo secondo l'opera sua,"
  },
  {
    "id": 19094,
    "book": "job                                     ",
    "chapter": "34",
    "verse": "12",
    "text": "Sì veramente Iddio non opera empiamente,"
  },
  {
    "id": 19095,
    "book": "job                                     ",
    "chapter": "34",
    "verse": "13",
    "text": "Chi gli ha commesso il governo della terra?"
  },
  {
    "id": 19096,
    "book": "job                                     ",
    "chapter": "34",
    "verse": "14",
    "text": "Se egli ponesse mente all'uomo,"
  },
  {
    "id": 19097,
    "book": "job                                     ",
    "chapter": "34",
    "verse": "15",
    "text": "Ogni carne insieme trapasserebbe,"
  },
  {
    "id": 19098,
    "book": "job                                     ",
    "chapter": "34",
    "verse": "16",
    "text": "Se pur tu hai del senno, ascolta questo;"
  },
  {
    "id": 19099,
    "book": "job                                     ",
    "chapter": "34",
    "verse": "17",
    "text": "Di vero, colui che odia la dirittura signoreggerebbe egli34.17 egli Gen. 18.25. 2 Sam. 23.3.?"
  },
  {
    "id": 19100,
    "book": "job                                     ",
    "chapter": "34",
    "verse": "18",
    "text": "Direbbesi egli ad un re: Scellerato?"
  },
  {
    "id": 19101,
    "book": "job                                     ",
    "chapter": "34",
    "verse": "19",
    "text": "Quanto meno a colui che non ha riguardo alla qualità de' principi34.19 principi Deut. 10.17. Fat. 10.34. Rom. 2.11. Gal. 2.6. Efes. 6.9. 1 Piet. 1.17.,"
  },
  {
    "id": 19102,
    "book": "job                                     ",
    "chapter": "34",
    "verse": "20",
    "text": "Essi muoiono in un momento,"
  },
  {
    "id": 19103,
    "book": "job                                     ",
    "chapter": "34",
    "verse": "21",
    "text": "Perciocchè gli occhi suoi son sopra le vie dell'uomo,"
  },
  {
    "id": 19104,
    "book": "job                                     ",
    "chapter": "34",
    "verse": "22",
    "text": "Non vi è oscurità, nè ombra di morte alcuna,"
  },
  {
    "id": 19105,
    "book": "job                                     ",
    "chapter": "34",
    "verse": "23",
    "text": "Perciocchè Iddio non ha più riguardo all'uomo,"
  },
  {
    "id": 19106,
    "book": "job                                     ",
    "chapter": "34",
    "verse": "24",
    "text": "Egli fiacca i possenti incomprensibilmente,"
  },
  {
    "id": 19107,
    "book": "job                                     ",
    "chapter": "34",
    "verse": "25",
    "text": "Perciò, conoscendo egli le opere loro,"
  },
  {
    "id": 19108,
    "book": "job                                     ",
    "chapter": "34",
    "verse": "26",
    "text": "Egli li sbatte come empi,"
  },
  {
    "id": 19109,
    "book": "job                                     ",
    "chapter": "34",
    "verse": "27",
    "text": "Perciocchè si son rivolti indietro da lui34.27 lui 1 Sam. 15.11.,"
  },
  {
    "id": 19110,
    "book": "job                                     ",
    "chapter": "34",
    "verse": "28",
    "text": "Facendo pervenire infino a lui il grido del povero,"
  },
  {
    "id": 19111,
    "book": "job                                     ",
    "chapter": "34",
    "verse": "29",
    "text": "Se egli rimanda in pace, chi condannerà?"
  },
  {
    "id": 19112,
    "book": "job                                     ",
    "chapter": "34",
    "verse": "30",
    "text": "Acciocchè l'uomo profano non regni più"
  },
  {
    "id": 19113,
    "book": "job                                     ",
    "chapter": "34",
    "verse": "31",
    "text": "Certo ei ti si conveniva indirizzarti a Dio, dicendo:"
  },
  {
    "id": 19114,
    "book": "job                                     ",
    "chapter": "34",
    "verse": "32",
    "text": "Se vi è alcuna cosa, oltre a ciò che io veggo, mostramelo;"
  },
  {
    "id": 19115,
    "book": "job                                     ",
    "chapter": "34",
    "verse": "33",
    "text": "Vorresti tu, ch'egli ti facesse la retribuzione di ciò ch'è proceduto da te?"
  },
  {
    "id": 19116,
    "book": "job                                     ",
    "chapter": "34",
    "verse": "34",
    "text": "Gli uomini di senno diranno meco,"
  },
  {
    "id": 19117,
    "book": "job                                     ",
    "chapter": "34",
    "verse": "35",
    "text": "Che Giobbe non parla con conoscimento,"
  },
  {
    "id": 19118,
    "book": "job                                     ",
    "chapter": "34",
    "verse": "36",
    "text": "O padre mio, sia pur Giobbe provato infino all'ultimo,"
  },
  {
    "id": 19119,
    "book": "job                                     ",
    "chapter": "34",
    "verse": "37",
    "text": "Perciocchè altrimenti egli aggiungerà misfatto al suo peccato,"
  }
]