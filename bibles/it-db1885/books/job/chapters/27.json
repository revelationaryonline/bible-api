[
  {
    "id": 18881,
    "book": "job                                     ",
    "chapter": "27",
    "verse": "1",
    "text": "E GIOBBE riprese il suo ragionamento, e disse:"
  },
  {
    "id": 18882,
    "book": "job                                     ",
    "chapter": "27",
    "verse": "2",
    "text": "Come Iddio che mi ha tolta la mia ragione27.2 ragione Giob. 34.5.,"
  },
  {
    "id": 18883,
    "book": "job                                     ",
    "chapter": "27",
    "verse": "3",
    "text": "Mentre il mio fiato sarà in me,"
  },
  {
    "id": 18884,
    "book": "job                                     ",
    "chapter": "27",
    "verse": "4",
    "text": "Le mie labbra giammai non parleranno perversamente,"
  },
  {
    "id": 18885,
    "book": "job                                     ",
    "chapter": "27",
    "verse": "5",
    "text": "Tolga, Iddio che giammai, finchè io muoia, consenta che voi abbiate ragione;"
  },
  {
    "id": 18886,
    "book": "job                                     ",
    "chapter": "27",
    "verse": "6",
    "text": "Io ho presa in mano la difesa della mia giustizia, io non la lascerò;"
  },
  {
    "id": 18887,
    "book": "job                                     ",
    "chapter": "27",
    "verse": "7",
    "text": "Il mio nemico sia come l'empio,"
  },
  {
    "id": 18888,
    "book": "job                                     ",
    "chapter": "27",
    "verse": "8",
    "text": "Perciocchè qual sarà la speranza dell'ipocrita,"
  },
  {
    "id": 18889,
    "book": "job                                     ",
    "chapter": "27",
    "verse": "9",
    "text": "Iddio ascolterà egli il suo grido,"
  },
  {
    "id": 18890,
    "book": "job                                     ",
    "chapter": "27",
    "verse": "10",
    "text": "Prenderà egli il suo diletto nell'Onnipotente?"
  },
  {
    "id": 18891,
    "book": "job                                     ",
    "chapter": "27",
    "verse": "11",
    "text": "Io vi ammaestrerò intorno alla mano di Dio27.11 Dio Sal. 32.8. Prov. 4.11.;"
  },
  {
    "id": 18892,
    "book": "job                                     ",
    "chapter": "27",
    "verse": "12",
    "text": "Ecco, voi tutti avete vedute queste cose;"
  },
  {
    "id": 18893,
    "book": "job                                     ",
    "chapter": "27",
    "verse": "13",
    "text": "Questa è la porzione dell'uomo empio, appo Iddio;"
  },
  {
    "id": 18894,
    "book": "job                                     ",
    "chapter": "27",
    "verse": "14",
    "text": "Se i suoi figliuoli moltiplicano, ciò è per la spada27.14 spada Deut. 28.41. Est. 9.7-10.;"
  },
  {
    "id": 18895,
    "book": "job                                     ",
    "chapter": "27",
    "verse": "15",
    "text": "Quelli che gli saranno sopravvivuti saranno sepolti nella morte stessa,"
  },
  {
    "id": 18896,
    "book": "job                                     ",
    "chapter": "27",
    "verse": "16",
    "text": "Avvegnachè avesse accumulato dell'argento come della polvere,"
  },
  {
    "id": 18897,
    "book": "job                                     ",
    "chapter": "27",
    "verse": "17",
    "text": "Egli li avrà messi insieme, ma il giusto se ne vestirà,"
  },
  {
    "id": 18898,
    "book": "job                                     ",
    "chapter": "27",
    "verse": "18",
    "text": "Egli avrà edificato, ma la sua casa sarà come la tignuola,"
  },
  {
    "id": 18899,
    "book": "job                                     ",
    "chapter": "27",
    "verse": "19",
    "text": "Avvegnachè sia stato ricco, giacerà, e non sarà raccolto27.19 raccolto Ger. 8.1,2. Ezec. 29.5.;"
  },
  {
    "id": 18900,
    "book": "job                                     ",
    "chapter": "27",
    "verse": "20",
    "text": "Spaventi lo coglieranno come acque,"
  },
  {
    "id": 18901,
    "book": "job                                     ",
    "chapter": "27",
    "verse": "21",
    "text": "Il vento orientale lo porterà via, ed egli se ne andrà;"
  },
  {
    "id": 18902,
    "book": "job                                     ",
    "chapter": "27",
    "verse": "22",
    "text": "Iddio adunque gli traboccherà addosso queste cose, e non lo risparmierà;"
  },
  {
    "id": 18903,
    "book": "job                                     ",
    "chapter": "27",
    "verse": "23",
    "text": "Altri si batterà a palme sopra lui,"
  }
]