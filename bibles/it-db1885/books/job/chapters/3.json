[
  {
    "id": 18304,
    "book": "job                                     ",
    "chapter": "3",
    "verse": "1",
    "text": "DOPO questo, Giobbe aprì la sua bocca, e maledisse il suo giorno."
  },
  {
    "id": 18305,
    "book": "job                                     ",
    "chapter": "3",
    "verse": "2",
    "text": "E prese a dire:"
  },
  {
    "id": 18306,
    "book": "job                                     ",
    "chapter": "3",
    "verse": "3",
    "text": "Possa perire il giorno nel quale io nacqui,"
  },
  {
    "id": 18307,
    "book": "job                                     ",
    "chapter": "3",
    "verse": "4",
    "text": "Quel giorno sia tenebroso; Iddio non ne abbia cura da alto,"
  },
  {
    "id": 18308,
    "book": "job                                     ",
    "chapter": "3",
    "verse": "5",
    "text": "Tenebre, ed ombra di morte rendanlo immondo;"
  },
  {
    "id": 18309,
    "book": "job                                     ",
    "chapter": "3",
    "verse": "6",
    "text": "Caligine ingombri quella notte;"
  },
  {
    "id": 18310,
    "book": "job                                     ",
    "chapter": "3",
    "verse": "7",
    "text": "Ecco, quella notte sia solitaria,"
  },
  {
    "id": 18311,
    "book": "job                                     ",
    "chapter": "3",
    "verse": "8",
    "text": "Maledicanla coloro che maledicono i giorni,"
  },
  {
    "id": 18312,
    "book": "job                                     ",
    "chapter": "3",
    "verse": "9",
    "text": "Oscurinsi le stelle del suo vespro;"
  },
  {
    "id": 18313,
    "book": "job                                     ",
    "chapter": "3",
    "verse": "10",
    "text": "Perciocchè non serrò gli usci del seno di mia madre,"
  },
  {
    "id": 18314,
    "book": "job                                     ",
    "chapter": "3",
    "verse": "11",
    "text": "Perchè non morii io dalla matrice?"
  },
  {
    "id": 18315,
    "book": "job                                     ",
    "chapter": "3",
    "verse": "12",
    "text": "Perchè mi furono pòrte le ginocchia3.12 ginocchia Gen. 30.3; 50.23.?"
  },
  {
    "id": 18316,
    "book": "job                                     ",
    "chapter": "3",
    "verse": "13",
    "text": "Conciossiachè ora giacerei, e mi riposerei;"
  },
  {
    "id": 18317,
    "book": "job                                     ",
    "chapter": "3",
    "verse": "14",
    "text": "Con i re, e con i consiglieri della terra,"
  },
  {
    "id": 18318,
    "book": "job                                     ",
    "chapter": "3",
    "verse": "15",
    "text": "Ovvero co' principi, che aveano dell'oro,"
  },
  {
    "id": 18319,
    "book": "job                                     ",
    "chapter": "3",
    "verse": "16",
    "text": "Ovvero anche del tutto non sarei stato, come un abortivo nascosto,"
  },
  {
    "id": 18320,
    "book": "job                                     ",
    "chapter": "3",
    "verse": "17",
    "text": "Quivi cessano gli empi di travagliare altrui,"
  },
  {
    "id": 18321,
    "book": "job                                     ",
    "chapter": "3",
    "verse": "18",
    "text": "Parimente i prigioni hanno requie,"
  },
  {
    "id": 18322,
    "book": "job                                     ",
    "chapter": "3",
    "verse": "19",
    "text": "Quivi è il piccolo e il grande;"
  },
  {
    "id": 18323,
    "book": "job                                     ",
    "chapter": "3",
    "verse": "20",
    "text": "Perchè dà egli la luce al miserabile,"
  },
  {
    "id": 18324,
    "book": "job                                     ",
    "chapter": "3",
    "verse": "21",
    "text": "I quali aspettano la morte, e pure ella non viene;"
  },
  {
    "id": 18325,
    "book": "job                                     ",
    "chapter": "3",
    "verse": "22",
    "text": "E si rallegrano, fino a festeggiarne,"
  },
  {
    "id": 18326,
    "book": "job                                     ",
    "chapter": "3",
    "verse": "23",
    "text": "Perchè dà egli la luce all'uomo, la cui via è nascosta,"
  },
  {
    "id": 18327,
    "book": "job                                     ",
    "chapter": "3",
    "verse": "24",
    "text": "Conciossiachè, avanti che io prenda il mio cibo, il mio sospiro venga,"
  },
  {
    "id": 18328,
    "book": "job                                     ",
    "chapter": "3",
    "verse": "25",
    "text": "Perchè ciò di che io avea spavento mi è avvenuto,"
  },
  {
    "id": 18329,
    "book": "job                                     ",
    "chapter": "3",
    "verse": "26",
    "text": "Io non ho avuta tranquillità, nè riposo, nè quiete;"
  }
]