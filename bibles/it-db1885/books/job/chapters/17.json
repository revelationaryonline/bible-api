[
  {
    "id": 18660,
    "book": "job                                     ",
    "chapter": "17",
    "verse": "1",
    "text": "Il mio spirito si dissolve,"
  },
  {
    "id": 18661,
    "book": "job                                     ",
    "chapter": "17",
    "verse": "2",
    "text": "Non ho io appresso di me degli schernitori?"
  },
  {
    "id": 18662,
    "book": "job                                     ",
    "chapter": "17",
    "verse": "3",
    "text": "Deh! metti pegno, dammi sicurtà per piatir teco;"
  },
  {
    "id": 18663,
    "book": "job                                     ",
    "chapter": "17",
    "verse": "4",
    "text": "Perciocchè, quant'è a costoro, tu hai nascosto il senno al cuor loro,"
  },
  {
    "id": 18664,
    "book": "job                                     ",
    "chapter": "17",
    "verse": "5",
    "text": "Di chi parla fra gli amici per lusinga"
  },
  {
    "id": 18665,
    "book": "job                                     ",
    "chapter": "17",
    "verse": "6",
    "text": "Egli mi ha posto per servir di proverbio a' popoli,"
  },
  {
    "id": 18666,
    "book": "job                                     ",
    "chapter": "17",
    "verse": "7",
    "text": "E l'occhio mio è tutto raggrinzato di sdegno,"
  },
  {
    "id": 18667,
    "book": "job                                     ",
    "chapter": "17",
    "verse": "8",
    "text": "Gli uomini diritti stupiranno di questo,"
  },
  {
    "id": 18668,
    "book": "job                                     ",
    "chapter": "17",
    "verse": "9",
    "text": "Ma pure il giusto si atterrà alla sua via,"
  },
  {
    "id": 18669,
    "book": "job                                     ",
    "chapter": "17",
    "verse": "10",
    "text": "Or ravvedetevi pure voi tutti, e poi venite;"
  },
  {
    "id": 18670,
    "book": "job                                     ",
    "chapter": "17",
    "verse": "11",
    "text": "I miei giorni son passati via17.11 via Giob. 7.6 e rif.; 9.25.;"
  },
  {
    "id": 18671,
    "book": "job                                     ",
    "chapter": "17",
    "verse": "12",
    "text": "La notte mi è cangiata in giorno,"
  },
  {
    "id": 18672,
    "book": "job                                     ",
    "chapter": "17",
    "verse": "13",
    "text": "Se io mi trattengo di speranza, il sepolcro sarà la mia casa,"
  },
  {
    "id": 18673,
    "book": "job                                     ",
    "chapter": "17",
    "verse": "14",
    "text": "Già ho gridato alla fossa: Tu sei mio padre;"
  },
  {
    "id": 18674,
    "book": "job                                     ",
    "chapter": "17",
    "verse": "15",
    "text": "Ed ove è ora la mia speranza?"
  },
  {
    "id": 18675,
    "book": "job                                     ",
    "chapter": "17",
    "verse": "16",
    "text": "Le mie speranze scenderanno nel fondo del sepolcro;"
  }
]