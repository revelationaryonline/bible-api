[
  {
    "id": 19136,
    "book": "job                                     ",
    "chapter": "36",
    "verse": "1",
    "text": "ED Elihu proseguì, e disse:"
  },
  {
    "id": 19137,
    "book": "job                                     ",
    "chapter": "36",
    "verse": "2",
    "text": "Aspettami un poco, ed io ti mostrerò"
  },
  {
    "id": 19138,
    "book": "job                                     ",
    "chapter": "36",
    "verse": "3",
    "text": "Io prenderò il mio discorso da lungi,"
  },
  {
    "id": 19139,
    "book": "job                                     ",
    "chapter": "36",
    "verse": "4",
    "text": "Perciocchè di vero il mio parlare non è con menzogna;"
  },
  {
    "id": 19140,
    "book": "job                                     ",
    "chapter": "36",
    "verse": "5",
    "text": "Ecco, Iddio è potente, ma non però disdegna alcuno;"
  },
  {
    "id": 19141,
    "book": "job                                     ",
    "chapter": "36",
    "verse": "6",
    "text": "Egli non lascia viver l'empio,"
  },
  {
    "id": 19142,
    "book": "job                                     ",
    "chapter": "36",
    "verse": "7",
    "text": "Egli non rimuove gli occhi suoi d'addosso a' giusti36.7 giusti Sal. 33.18; 34.15.;"
  },
  {
    "id": 19143,
    "book": "job                                     ",
    "chapter": "36",
    "verse": "8",
    "text": "E se pur son messi ne' ceppi,"
  },
  {
    "id": 19144,
    "book": "job                                     ",
    "chapter": "36",
    "verse": "9",
    "text": "Egli dichiara loro i lor fatti,"
  },
  {
    "id": 19145,
    "book": "job                                     ",
    "chapter": "36",
    "verse": "10",
    "text": "Ovvero, apre loro l'orecchio, per far loro ricevere correzione;"
  },
  {
    "id": 19146,
    "book": "job                                     ",
    "chapter": "36",
    "verse": "11",
    "text": "Se ubbidiscono, e gli servono,"
  },
  {
    "id": 19147,
    "book": "job                                     ",
    "chapter": "36",
    "verse": "12",
    "text": "Ma se non ubbidiscono, passano per la spada36.12 spada Is. 1.19,20.,"
  },
  {
    "id": 19148,
    "book": "job                                     ",
    "chapter": "36",
    "verse": "13",
    "text": "Ma i profani di cuore accrescono l'ira36.13 ira Rom. 2.5.,"
  },
  {
    "id": 19149,
    "book": "job                                     ",
    "chapter": "36",
    "verse": "14",
    "text": "La lor persona morrà in giovanezza36.14 giovanezza Giob. 22.15,16. Sal. 55.23.,"
  },
  {
    "id": 19150,
    "book": "job                                     ",
    "chapter": "36",
    "verse": "15",
    "text": "Ma egli libera gli afflitti nella loro afflizione,"
  },
  {
    "id": 19151,
    "book": "job                                     ",
    "chapter": "36",
    "verse": "16",
    "text": "Ancora te avrebbe egli ritratto dall'afflizione,"
  },
  {
    "id": 19152,
    "book": "job                                     ",
    "chapter": "36",
    "verse": "17",
    "text": "Ma tu sei venuto al colmo del giudicio di un empio;"
  },
  {
    "id": 19153,
    "book": "job                                     ",
    "chapter": "36",
    "verse": "18",
    "text": "Perciocchè egli è in ira, guarda che talora egli non ti atterri con battiture;"
  },
  {
    "id": 19154,
    "book": "job                                     ",
    "chapter": "36",
    "verse": "19",
    "text": "Farà egli alcuna stima delle tue ricchezze36.19 ricchezze Prov. 11.4.?"
  },
  {
    "id": 19155,
    "book": "job                                     ",
    "chapter": "36",
    "verse": "20",
    "text": "Non ansar dietro a quella notte,"
  },
  {
    "id": 19156,
    "book": "job                                     ",
    "chapter": "36",
    "verse": "21",
    "text": "Guardati che tu non ti rivolga alla vanità;"
  },
  {
    "id": 19157,
    "book": "job                                     ",
    "chapter": "36",
    "verse": "22",
    "text": "Ecco, Iddio è eccelso nella sua potenza;"
  },
  {
    "id": 19158,
    "book": "job                                     ",
    "chapter": "36",
    "verse": "23",
    "text": "Chi gli ha ordinato come egli deve procedere?"
  },
  {
    "id": 19159,
    "book": "job                                     ",
    "chapter": "36",
    "verse": "24",
    "text": "Ricordati di magnificar le opere sue36.24 sue Sal. 92.5. Apoc. 15.3.,"
  },
  {
    "id": 19160,
    "book": "job                                     ",
    "chapter": "36",
    "verse": "25",
    "text": "Ogni uomo le vede,"
  },
  {
    "id": 19161,
    "book": "job                                     ",
    "chapter": "36",
    "verse": "26",
    "text": "Ecco, Iddio è grande, e noi nol possiamo conoscere;"
  },
  {
    "id": 19162,
    "book": "job                                     ",
    "chapter": "36",
    "verse": "27",
    "text": "Perciocchè egli rattiene le acque che non istillino;"
  },
  {
    "id": 19163,
    "book": "job                                     ",
    "chapter": "36",
    "verse": "28",
    "text": "La quale le nuvole stillano,"
  },
  {
    "id": 19164,
    "book": "job                                     ",
    "chapter": "36",
    "verse": "29",
    "text": "Oltre a ciò, potrà alcuno intender le distese delle nubi,"
  },
  {
    "id": 19165,
    "book": "job                                     ",
    "chapter": "36",
    "verse": "30",
    "text": "Ecco, egli spande sopra esso la sua luce,"
  },
  {
    "id": 19166,
    "book": "job                                     ",
    "chapter": "36",
    "verse": "31",
    "text": "Perciocchè, per queste cose egli giudica i popoli,"
  },
  {
    "id": 19167,
    "book": "job                                     ",
    "chapter": "36",
    "verse": "32",
    "text": "Egli nasconde la fiamma nelle palme delle sue mani,"
  },
  {
    "id": 19168,
    "book": "job                                     ",
    "chapter": "36",
    "verse": "33",
    "text": "Egli le dichiara la sua volontà se deve incontrar bestiame,"
  }
]