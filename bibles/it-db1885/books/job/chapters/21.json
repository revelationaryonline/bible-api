[
  {
    "id": 18755,
    "book": "job                                     ",
    "chapter": "21",
    "verse": "1",
    "text": "E GIOBBE rispose, e disse:"
  },
  {
    "id": 18756,
    "book": "job                                     ",
    "chapter": "21",
    "verse": "2",
    "text": "Date udienza al mio ragionamento,"
  },
  {
    "id": 18757,
    "book": "job                                     ",
    "chapter": "21",
    "verse": "3",
    "text": "Comportatemi che io parli;"
  },
  {
    "id": 18758,
    "book": "job                                     ",
    "chapter": "21",
    "verse": "4",
    "text": "Quant'è a me, il mio lamento si addirizza egli ad un uomo?"
  },
  {
    "id": 18759,
    "book": "job                                     ",
    "chapter": "21",
    "verse": "5",
    "text": "Riguardate a me, e stupite,"
  },
  {
    "id": 18760,
    "book": "job                                     ",
    "chapter": "21",
    "verse": "6",
    "text": "Io stesso, quando me ne ricordo, sono tutto attonito,"
  },
  {
    "id": 18761,
    "book": "job                                     ",
    "chapter": "21",
    "verse": "7",
    "text": "Perchè vivono gli empi?"
  },
  {
    "id": 18762,
    "book": "job                                     ",
    "chapter": "21",
    "verse": "8",
    "text": "La lor progenie è stabilita nel lor cospetto, insieme con loro;"
  },
  {
    "id": 18763,
    "book": "job                                     ",
    "chapter": "21",
    "verse": "9",
    "text": "Le case loro non sono se non pace, senza spavento;"
  },
  {
    "id": 18764,
    "book": "job                                     ",
    "chapter": "21",
    "verse": "10",
    "text": "I lor tori ammontano, e non fallano;"
  },
  {
    "id": 18765,
    "book": "job                                     ",
    "chapter": "21",
    "verse": "11",
    "text": "Essi mandano fuori i lor fanciulletti come pecore;"
  },
  {
    "id": 18766,
    "book": "job                                     ",
    "chapter": "21",
    "verse": "12",
    "text": "Essi alzano la voce col tamburo e con la cetera;"
  },
  {
    "id": 18767,
    "book": "job                                     ",
    "chapter": "21",
    "verse": "13",
    "text": "Logorano la loro età in piacere,"
  },
  {
    "id": 18768,
    "book": "job                                     ",
    "chapter": "21",
    "verse": "14",
    "text": "Quantunque abbiano detto a Dio: Dipartiti da noi;"
  },
  {
    "id": 18769,
    "book": "job                                     ",
    "chapter": "21",
    "verse": "15",
    "text": "Che è l'Onnipotente, che noi gli serviamo21.15 serviamo Esod. 5.2. Giob. 34.9; 35.3. Mal. 3.14.?"
  },
  {
    "id": 18770,
    "book": "job                                     ",
    "chapter": "21",
    "verse": "16",
    "text": "Ecco, il ben loro non è egli nelle lor mani?"
  },
  {
    "id": 18771,
    "book": "job                                     ",
    "chapter": "21",
    "verse": "17",
    "text": "Quante volte avviene egli che la lampana degli empi sia spenta,"
  },
  {
    "id": 18772,
    "book": "job                                     ",
    "chapter": "21",
    "verse": "18",
    "text": "E che sieno come paglia al vento,"
  },
  {
    "id": 18773,
    "book": "job                                     ",
    "chapter": "21",
    "verse": "19",
    "text": "E che Iddio riserbi a' lor figliuoli la violenza da loro usata21.19 usata Esod. 20.5.;"
  },
  {
    "id": 18774,
    "book": "job                                     ",
    "chapter": "21",
    "verse": "20",
    "text": "E che gli occhi loro veggano la lor ruina,"
  },
  {
    "id": 18775,
    "book": "job                                     ",
    "chapter": "21",
    "verse": "21",
    "text": "Perciocchè del rimanente, quale affezione avranno essi alle lor case,"
  },
  {
    "id": 18776,
    "book": "job                                     ",
    "chapter": "21",
    "verse": "22",
    "text": "Potrebbesi insegnar scienza a Dio21.22 Dio Is. 40.13; 45.9. Rom. 11.34. 1 Cor. 2.16.?"
  },
  {
    "id": 18777,
    "book": "job                                     ",
    "chapter": "21",
    "verse": "23",
    "text": "Colui muore nel colmo della felicità,"
  },
  {
    "id": 18778,
    "book": "job                                     ",
    "chapter": "21",
    "verse": "24",
    "text": "Le sue secchie son piene di latte,"
  },
  {
    "id": 18779,
    "book": "job                                     ",
    "chapter": "21",
    "verse": "25",
    "text": "E costui muore, essendo in amaritudine d'animo,"
  },
  {
    "id": 18780,
    "book": "job                                     ",
    "chapter": "21",
    "verse": "26",
    "text": "Amendue giacciono nella polvere21.26 polvere Eccl. 9.2.,"
  },
  {
    "id": 18781,
    "book": "job                                     ",
    "chapter": "21",
    "verse": "27",
    "text": "Ecco, io conosco i vostri pensamenti,"
  },
  {
    "id": 18782,
    "book": "job                                     ",
    "chapter": "21",
    "verse": "28",
    "text": "Perciocchè voi direte: Ove è la casa del magnifico?"
  },
  {
    "id": 18783,
    "book": "job                                     ",
    "chapter": "21",
    "verse": "29",
    "text": "Non vi siete voi giammai informati da coloro che fanno viaggi?"
  },
  {
    "id": 18784,
    "book": "job                                     ",
    "chapter": "21",
    "verse": "30",
    "text": "Che il malvagio è riparato al giorno della ruina,"
  },
  {
    "id": 18785,
    "book": "job                                     ",
    "chapter": "21",
    "verse": "31",
    "text": "Chi gli rappresenterà la sua via in faccia?"
  },
  {
    "id": 18786,
    "book": "job                                     ",
    "chapter": "21",
    "verse": "32",
    "text": "Poi appresso egli è portato ne' sepolcri,"
  },
  {
    "id": 18787,
    "book": "job                                     ",
    "chapter": "21",
    "verse": "33",
    "text": "I cespi della valle gli son dolci;"
  },
  {
    "id": 18788,
    "book": "job                                     ",
    "chapter": "21",
    "verse": "34",
    "text": "Come dunque mi consolate voi vanamente?"
  }
]