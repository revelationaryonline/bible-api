[
  {
    "id": 18676,
    "book": "job                                     ",
    "chapter": "18",
    "verse": "1",
    "text": "E BILDAD Suhita rispose, e disse:"
  },
  {
    "id": 18677,
    "book": "job                                     ",
    "chapter": "18",
    "verse": "2",
    "text": "Fino a quando non metterete fine a' ragionamenti?"
  },
  {
    "id": 18678,
    "book": "job                                     ",
    "chapter": "18",
    "verse": "3",
    "text": "Perchè siamo noi riputati per bestie?"
  },
  {
    "id": 18679,
    "book": "job                                     ",
    "chapter": "18",
    "verse": "4",
    "text": "O tu, che laceri l'anima tua nel tuo cruccio,"
  },
  {
    "id": 18680,
    "book": "job                                     ",
    "chapter": "18",
    "verse": "5",
    "text": "Sì, la luce degli empi sarà spenta18.5 spenta Prov. 13.9; 20.20; 24.20.,"
  },
  {
    "id": 18681,
    "book": "job                                     ",
    "chapter": "18",
    "verse": "6",
    "text": "La luce sarà oscurata nel lor tabernacolo."
  },
  {
    "id": 18682,
    "book": "job                                     ",
    "chapter": "18",
    "verse": "7",
    "text": "I lor fieri passi saran ristretti,"
  },
  {
    "id": 18683,
    "book": "job                                     ",
    "chapter": "18",
    "verse": "8",
    "text": "Perciocchè essi si gitteranno nel laccio co' piedi loro,"
  },
  {
    "id": 18684,
    "book": "job                                     ",
    "chapter": "18",
    "verse": "9",
    "text": "Il laccio prenderà loro il calcagno,"
  },
  {
    "id": 18685,
    "book": "job                                     ",
    "chapter": "18",
    "verse": "10",
    "text": "La fune sarà loro nascosta in terra,"
  },
  {
    "id": 18686,
    "book": "job                                     ",
    "chapter": "18",
    "verse": "11",
    "text": "Spaventi li conturberanno d'ogn'intorno,"
  },
  {
    "id": 18687,
    "book": "job                                     ",
    "chapter": "18",
    "verse": "12",
    "text": "La lor forza sarà affamata,"
  },
  {
    "id": 18688,
    "book": "job                                     ",
    "chapter": "18",
    "verse": "13",
    "text": "Il primogenito della morte divorerà le membra della lor pelle;"
  },
  {
    "id": 18689,
    "book": "job                                     ",
    "chapter": "18",
    "verse": "14",
    "text": "La lor confidanza sarà divelta dal lor tabernacolo18.14 tabernacolo Sal. 112.10. Prov. 10.28.;"
  },
  {
    "id": 18690,
    "book": "job                                     ",
    "chapter": "18",
    "verse": "15",
    "text": "Abiteranno ne' lor tabernacoli che non saranno più loro;"
  },
  {
    "id": 18691,
    "book": "job                                     ",
    "chapter": "18",
    "verse": "16",
    "text": "Disotto le lor radici si seccheranno,"
  },
  {
    "id": 18692,
    "book": "job                                     ",
    "chapter": "18",
    "verse": "17",
    "text": "La lor memoria perirà d'in su la terra18.17 terra Sal. 34.16. Prov. 10.7.,"
  },
  {
    "id": 18693,
    "book": "job                                     ",
    "chapter": "18",
    "verse": "18",
    "text": "Saranno spinti dalla luce nelle tenebre,"
  },
  {
    "id": 18694,
    "book": "job                                     ",
    "chapter": "18",
    "verse": "19",
    "text": "Non avranno figliuoli, nè nipoti fra il lor popolo,"
  },
  {
    "id": 18695,
    "book": "job                                     ",
    "chapter": "18",
    "verse": "20",
    "text": "La posterità stupirà del lor giorno,"
  },
  {
    "id": 18696,
    "book": "job                                     ",
    "chapter": "18",
    "verse": "21",
    "text": "Certo tali saranno gli abitacoli de' perversi,"
  }
]