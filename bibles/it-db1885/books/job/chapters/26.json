[
  {
    "id": 18867,
    "book": "job                                     ",
    "chapter": "26",
    "verse": "1",
    "text": "E GIOBBE rispose, e disse:"
  },
  {
    "id": 18868,
    "book": "job                                     ",
    "chapter": "26",
    "verse": "2",
    "text": "O quanto hai tu bene aiutato il debole,"
  },
  {
    "id": 18869,
    "book": "job                                     ",
    "chapter": "26",
    "verse": "3",
    "text": "O quanto hai tu ben consigliato colui che è privo di sapienza,"
  },
  {
    "id": 18870,
    "book": "job                                     ",
    "chapter": "26",
    "verse": "4",
    "text": "A cui hai tu tenuti questi ragionamenti?"
  },
  {
    "id": 18871,
    "book": "job                                     ",
    "chapter": "26",
    "verse": "5",
    "text": "I giganti sono stati formati da Dio,"
  },
  {
    "id": 18872,
    "book": "job                                     ",
    "chapter": "26",
    "verse": "6",
    "text": "L'inferno è ignudo davanti a lui26.6 lui Sal. 139.8,11. Prov. 15.11. Ebr. 4.13.,"
  },
  {
    "id": 18873,
    "book": "job                                     ",
    "chapter": "26",
    "verse": "7",
    "text": "Egli distende l'Aquilone in sul vuoto,"
  },
  {
    "id": 18874,
    "book": "job                                     ",
    "chapter": "26",
    "verse": "8",
    "text": "Egli serra le acque nelle sue nuvole,"
  },
  {
    "id": 18875,
    "book": "job                                     ",
    "chapter": "26",
    "verse": "9",
    "text": "Egli tavola la superficie del suo trono,"
  },
  {
    "id": 18876,
    "book": "job                                     ",
    "chapter": "26",
    "verse": "10",
    "text": "Egli ha con la sesta posto un certo termine intorno alle acque26.10 acque Sal. 33.7; 104.9. Prov. 8.29. Ger. 5.22.,"
  },
  {
    "id": 18877,
    "book": "job                                     ",
    "chapter": "26",
    "verse": "11",
    "text": "Le colonne de' cieli sono scrollate,"
  },
  {
    "id": 18878,
    "book": "job                                     ",
    "chapter": "26",
    "verse": "12",
    "text": "Egli ha fesso il mare con la sua forza26.12 forza Esod. 14.21 e rif.,"
  },
  {
    "id": 18879,
    "book": "job                                     ",
    "chapter": "26",
    "verse": "13",
    "text": "Egli ha col suo Spirito adorni i cieli26.13 cieli Sal. 33.6.;"
  },
  {
    "id": 18880,
    "book": "job                                     ",
    "chapter": "26",
    "verse": "14",
    "text": "Ecco, queste cose son solo alcune particelle delle sue vie;"
  }
]