[
  {
    "id": 18904,
    "book": "job                                     ",
    "chapter": "28",
    "verse": "1",
    "text": "Certo l'argento ha la sua miniera,"
  },
  {
    "id": 18905,
    "book": "job                                     ",
    "chapter": "28",
    "verse": "2",
    "text": "Il ferro si trae dalla polvere,"
  },
  {
    "id": 18906,
    "book": "job                                     ",
    "chapter": "28",
    "verse": "3",
    "text": "L'uomo ha posto un termine alle tenebre,"
  },
  {
    "id": 18907,
    "book": "job                                     ",
    "chapter": "28",
    "verse": "4",
    "text": "Ove i torrenti che il piè avea dimenticati scoppiano fuori,"
  },
  {
    "id": 18908,
    "book": "job                                     ",
    "chapter": "28",
    "verse": "5",
    "text": "La terra, che produce il pane28.5 pane Sal. 104.14.,"
  },
  {
    "id": 18909,
    "book": "job                                     ",
    "chapter": "28",
    "verse": "6",
    "text": "Le pietre di essa sono il luogo degli zaffiri,"
  },
  {
    "id": 18910,
    "book": "job                                     ",
    "chapter": "28",
    "verse": "7",
    "text": "Niuno uccello rapace ne sa il sentiero,"
  },
  {
    "id": 18911,
    "book": "job                                     ",
    "chapter": "28",
    "verse": "8",
    "text": "I leoncini della leonessa non calcarono giammai que' luoghi,"
  },
  {
    "id": 18912,
    "book": "job                                     ",
    "chapter": "28",
    "verse": "9",
    "text": "L'uomo mette la mano a' macigni;"
  },
  {
    "id": 18913,
    "book": "job                                     ",
    "chapter": "28",
    "verse": "10",
    "text": "Egli fa de' condotti a' rivi per mezzo le rupi;"
  },
  {
    "id": 18914,
    "book": "job                                     ",
    "chapter": "28",
    "verse": "11",
    "text": "Egli tura i fiumi che non gocciolino,"
  },
  {
    "id": 18915,
    "book": "job                                     ",
    "chapter": "28",
    "verse": "12",
    "text": "Ma la sapienza, onde si trarrà ella?"
  },
  {
    "id": 18916,
    "book": "job                                     ",
    "chapter": "28",
    "verse": "13",
    "text": "L'uomo non conosce il prezzo di essa;"
  },
  {
    "id": 18917,
    "book": "job                                     ",
    "chapter": "28",
    "verse": "14",
    "text": "L'abisso dice: Ella non è in me;"
  },
  {
    "id": 18918,
    "book": "job                                     ",
    "chapter": "28",
    "verse": "15",
    "text": "Ei non si può dare oro per essa,"
  },
  {
    "id": 18919,
    "book": "job                                     ",
    "chapter": "28",
    "verse": "16",
    "text": "Ella non può essere apprezzata ad oro di Ofir,"
  },
  {
    "id": 18920,
    "book": "job                                     ",
    "chapter": "28",
    "verse": "17",
    "text": "Nè l'oro, nè il diamante, non posson pareggiarla di prezzo;"
  },
  {
    "id": 18921,
    "book": "job                                     ",
    "chapter": "28",
    "verse": "18",
    "text": "Appo lei non si fa menzione di coralli, nè di perle;"
  },
  {
    "id": 18922,
    "book": "job                                     ",
    "chapter": "28",
    "verse": "19",
    "text": "Il topazio di Etiopia non la può pareggiar di prezzo;"
  },
  {
    "id": 18923,
    "book": "job                                     ",
    "chapter": "28",
    "verse": "20",
    "text": "Onde viene adunque la sapienza?"
  },
  {
    "id": 18924,
    "book": "job                                     ",
    "chapter": "28",
    "verse": "21",
    "text": "Conciossiachè ella sia nascosta agli occhi d'ogni vivente,"
  },
  {
    "id": 18925,
    "book": "job                                     ",
    "chapter": "28",
    "verse": "22",
    "text": "Il luogo della perdizione e la morte dicono:"
  },
  {
    "id": 18926,
    "book": "job                                     ",
    "chapter": "28",
    "verse": "23",
    "text": "Iddio solo intende la via di essa,"
  },
  {
    "id": 18927,
    "book": "job                                     ",
    "chapter": "28",
    "verse": "24",
    "text": "Perciocchè egli riguarda fino all'estremità della terra,"
  },
  {
    "id": 18928,
    "book": "job                                     ",
    "chapter": "28",
    "verse": "25",
    "text": "Quando egli dava il peso al vento,"
  },
  {
    "id": 18929,
    "book": "job                                     ",
    "chapter": "28",
    "verse": "26",
    "text": "Quando egli poneva il suo ordine alla pioggia,"
  },
  {
    "id": 18930,
    "book": "job                                     ",
    "chapter": "28",
    "verse": "27",
    "text": "Allora egli la vedeva, e la contava;"
  },
  {
    "id": 18931,
    "book": "job                                     ",
    "chapter": "28",
    "verse": "28",
    "text": "Ma egli ha detto all'uomo:"
  }
]