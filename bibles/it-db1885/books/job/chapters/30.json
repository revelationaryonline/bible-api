[
  {
    "id": 18957,
    "book": "job                                     ",
    "chapter": "30",
    "verse": "1",
    "text": "Ma ora, quelli che son minori d'età di me si ridono di me,"
  },
  {
    "id": 18958,
    "book": "job                                     ",
    "chapter": "30",
    "verse": "2",
    "text": "Ed anche, che mi avrebbe giovato la forza delle lor mani?"
  },
  {
    "id": 18959,
    "book": "job                                     ",
    "chapter": "30",
    "verse": "3",
    "text": "Di bisogno e di fame,"
  },
  {
    "id": 18960,
    "book": "job                                     ",
    "chapter": "30",
    "verse": "4",
    "text": "Coglievano la malva presso agli arboscelli,"
  },
  {
    "id": 18961,
    "book": "job                                     ",
    "chapter": "30",
    "verse": "5",
    "text": "Erano scacciati d'infra la gente;"
  },
  {
    "id": 18962,
    "book": "job                                     ",
    "chapter": "30",
    "verse": "6",
    "text": "Dimoravano ne' dirupi delle valli,"
  },
  {
    "id": 18963,
    "book": "job                                     ",
    "chapter": "30",
    "verse": "7",
    "text": "Ruggivano fra gli arboscelli;"
  },
  {
    "id": 18964,
    "book": "job                                     ",
    "chapter": "30",
    "verse": "8",
    "text": "Erano gente da nulla, senza nome,"
  },
  {
    "id": 18965,
    "book": "job                                     ",
    "chapter": "30",
    "verse": "9",
    "text": "Ed ora io son la lor canzone,"
  },
  {
    "id": 18966,
    "book": "job                                     ",
    "chapter": "30",
    "verse": "10",
    "text": "Essi mi abbominano, si allontanano da me,"
  },
  {
    "id": 18967,
    "book": "job                                     ",
    "chapter": "30",
    "verse": "11",
    "text": "Perciocchè Iddio ha sciolto il mio legame, e mi ha afflitto;"
  },
  {
    "id": 18968,
    "book": "job                                     ",
    "chapter": "30",
    "verse": "12",
    "text": "I giovanetti si levano contro a me dalla man destra, mi spingono i piedi,"
  },
  {
    "id": 18969,
    "book": "job                                     ",
    "chapter": "30",
    "verse": "13",
    "text": "Hanno tagliato il mio cammino, si avanzano alla mia perdizione,"
  },
  {
    "id": 18970,
    "book": "job                                     ",
    "chapter": "30",
    "verse": "14",
    "text": "Sono entrati come per una larga rottura,"
  },
  {
    "id": 18971,
    "book": "job                                     ",
    "chapter": "30",
    "verse": "15",
    "text": "Spaventi si son volti contro a me,"
  },
  {
    "id": 18972,
    "book": "job                                     ",
    "chapter": "30",
    "verse": "16",
    "text": "Ed ora l'anima mia si versa sopra me,"
  },
  {
    "id": 18973,
    "book": "job                                     ",
    "chapter": "30",
    "verse": "17",
    "text": "Di notte egli mi trafigge l'ossa addosso;"
  },
  {
    "id": 18974,
    "book": "job                                     ",
    "chapter": "30",
    "verse": "18",
    "text": "La mia vesta è tutta cangiata, per la quantità della marcia delle piaghe,"
  },
  {
    "id": 18975,
    "book": "job                                     ",
    "chapter": "30",
    "verse": "19",
    "text": "Egli mi ha gittato nel fango,"
  },
  {
    "id": 18976,
    "book": "job                                     ",
    "chapter": "30",
    "verse": "20",
    "text": "Io grido a te, e tu non mi rispondi;"
  },
  {
    "id": 18977,
    "book": "job                                     ",
    "chapter": "30",
    "verse": "21",
    "text": "Tu ti sei mutato in crudele inverso me30.21 me Giob. 16.9.;"
  },
  {
    "id": 18978,
    "book": "job                                     ",
    "chapter": "30",
    "verse": "22",
    "text": "Tu mi hai levato ad alto; tu mi fai cavalcar sopra il vento,"
  },
  {
    "id": 18979,
    "book": "job                                     ",
    "chapter": "30",
    "verse": "23",
    "text": "Io so certamente che tu mi ridurrai alla morte,"
  },
  {
    "id": 18980,
    "book": "job                                     ",
    "chapter": "30",
    "verse": "24",
    "text": "Pur non istenderà egli la mano nell'avello;"
  },
  {
    "id": 18981,
    "book": "job                                     ",
    "chapter": "30",
    "verse": "25",
    "text": "Non piangeva io per cagion di colui che menava dura vita30.25 vita Sal. 35.13,14. Rom. 12.15.?"
  },
  {
    "id": 18982,
    "book": "job                                     ",
    "chapter": "30",
    "verse": "26",
    "text": "Perchè, avendo io sperato il bene, il mal sia venuto?"
  },
  {
    "id": 18983,
    "book": "job                                     ",
    "chapter": "30",
    "verse": "27",
    "text": "Le mie interiora bollono, e non hanno alcuna posa;"
  },
  {
    "id": 18984,
    "book": "job                                     ",
    "chapter": "30",
    "verse": "28",
    "text": "Io vo bruno attorno, non già del sole;"
  },
  {
    "id": 18985,
    "book": "job                                     ",
    "chapter": "30",
    "verse": "29",
    "text": "Io son diventato fratello degli sciacalli,"
  },
  {
    "id": 18986,
    "book": "job                                     ",
    "chapter": "30",
    "verse": "30",
    "text": "La mia pelle mi si è imbrunita addosso,"
  },
  {
    "id": 18987,
    "book": "job                                     ",
    "chapter": "30",
    "verse": "31",
    "text": "E la mia cetera si è mutata in duolo,"
  }
]