[
  {
    "id": 18553,
    "book": "job                                     ",
    "chapter": "13",
    "verse": "1",
    "text": "Ecco, l'occhio mio ha vedute tutte queste cose,"
  },
  {
    "id": 18554,
    "book": "job                                     ",
    "chapter": "13",
    "verse": "2",
    "text": "Quanto sapete voi, so anch'io;"
  },
  {
    "id": 18555,
    "book": "job                                     ",
    "chapter": "13",
    "verse": "3",
    "text": "E pure io parlerò all'Onnipotente;"
  },
  {
    "id": 18556,
    "book": "job                                     ",
    "chapter": "13",
    "verse": "4",
    "text": "Ma certo, quant'è a voi, voi siete rappezzatori di menzogna;"
  },
  {
    "id": 18557,
    "book": "job                                     ",
    "chapter": "13",
    "verse": "5",
    "text": "Oh! vi taceste pur del tutto,"
  },
  {
    "id": 18558,
    "book": "job                                     ",
    "chapter": "13",
    "verse": "6",
    "text": "Deh! ascoltate la difesa della mia ragione,"
  },
  {
    "id": 18559,
    "book": "job                                     ",
    "chapter": "13",
    "verse": "7",
    "text": "Convienvisi in favor di Dio parlar perversamente,"
  },
  {
    "id": 18560,
    "book": "job                                     ",
    "chapter": "13",
    "verse": "8",
    "text": "Convienvisi aver riguardo alla qualità sua?"
  },
  {
    "id": 18561,
    "book": "job                                     ",
    "chapter": "13",
    "verse": "9",
    "text": "Sarebbe egli ben per voi ch'egli vi esaminasse?"
  },
  {
    "id": 18562,
    "book": "job                                     ",
    "chapter": "13",
    "verse": "10",
    "text": "Egli del certo vi arguirà,"
  },
  {
    "id": 18563,
    "book": "job                                     ",
    "chapter": "13",
    "verse": "11",
    "text": "La sua altezza non vi sgomenterà ella?"
  },
  {
    "id": 18564,
    "book": "job                                     ",
    "chapter": "13",
    "verse": "12",
    "text": "I vostri detti memorandi son simili a cenere;"
  },
  {
    "id": 18565,
    "book": "job                                     ",
    "chapter": "13",
    "verse": "13",
    "text": "Tacetevi, e lasciatemi stare, ed io parlerò;"
  },
  {
    "id": 18566,
    "book": "job                                     ",
    "chapter": "13",
    "verse": "14",
    "text": "Perchè mi strappo io la carne co' denti,"
  },
  {
    "id": 18567,
    "book": "job                                     ",
    "chapter": "13",
    "verse": "15",
    "text": "Ecco, uccidami egli pure; sì spererò in lui13.15 lui Sal. 23.4. Prov. 14.32.;"
  },
  {
    "id": 18568,
    "book": "job                                     ",
    "chapter": "13",
    "verse": "16",
    "text": "Ed egli stesso mi sarà in salvazione;"
  },
  {
    "id": 18569,
    "book": "job                                     ",
    "chapter": "13",
    "verse": "17",
    "text": "Ascoltate attentamente il mio ragionamento;"
  },
  {
    "id": 18570,
    "book": "job                                     ",
    "chapter": "13",
    "verse": "18",
    "text": "Ecco ora, quando io avrò esposta per ordine la mia ragione,"
  },
  {
    "id": 18571,
    "book": "job                                     ",
    "chapter": "13",
    "verse": "19",
    "text": "Chi è colui che voglia litigar meco?"
  },
  {
    "id": 18572,
    "book": "job                                     ",
    "chapter": "13",
    "verse": "20",
    "text": "Sol non farmi due cose,"
  },
  {
    "id": 18573,
    "book": "job                                     ",
    "chapter": "13",
    "verse": "21",
    "text": "Allontana la tua mano d'addosso a me,"
  },
  {
    "id": 18574,
    "book": "job                                     ",
    "chapter": "13",
    "verse": "22",
    "text": "E poi chiama, ed io risponderò;"
  },
  {
    "id": 18575,
    "book": "job                                     ",
    "chapter": "13",
    "verse": "23",
    "text": "Quante iniquità e peccati ho io?"
  },
  {
    "id": 18576,
    "book": "job                                     ",
    "chapter": "13",
    "verse": "24",
    "text": "Perchè nascondi la tua faccia,"
  },
  {
    "id": 18577,
    "book": "job                                     ",
    "chapter": "13",
    "verse": "25",
    "text": "Stritolerai tu una fronda sospinta?"
  },
  {
    "id": 18578,
    "book": "job                                     ",
    "chapter": "13",
    "verse": "26",
    "text": "Che tu mi sentenzii a pene amare,"
  },
  {
    "id": 18579,
    "book": "job                                     ",
    "chapter": "13",
    "verse": "27",
    "text": "E metta i miei piedi ne' ceppi,"
  },
  {
    "id": 18580,
    "book": "job                                     ",
    "chapter": "13",
    "verse": "28",
    "text": "Onde costui si disfa come del legno intarlato,"
  }
]