[
  {
    "id": 18638,
    "book": "job                                     ",
    "chapter": "16",
    "verse": "1",
    "text": "E GIOBBE rispose e disse:"
  },
  {
    "id": 18639,
    "book": "job                                     ",
    "chapter": "16",
    "verse": "2",
    "text": "Io ho più volte udite le stesse cose;"
  },
  {
    "id": 18640,
    "book": "job                                     ",
    "chapter": "16",
    "verse": "3",
    "text": "Finiranno mai le parole di vento?"
  },
  {
    "id": 18641,
    "book": "job                                     ",
    "chapter": "16",
    "verse": "4",
    "text": "Se l'anima vostra fosse nello stato dell'anima mia,"
  },
  {
    "id": 18642,
    "book": "job                                     ",
    "chapter": "16",
    "verse": "5",
    "text": "Ma anzi io vi conforterei con la mia bocca,"
  },
  {
    "id": 18643,
    "book": "job                                     ",
    "chapter": "16",
    "verse": "6",
    "text": "Se io parlo, il mio dolore non però si rallenta;"
  },
  {
    "id": 18644,
    "book": "job                                     ",
    "chapter": "16",
    "verse": "7",
    "text": "Certo, egli ora mi ha straccato;"
  },
  {
    "id": 18645,
    "book": "job                                     ",
    "chapter": "16",
    "verse": "8",
    "text": "E mi hai fatto diventar tutto grinzo16.8 grinzo Giob. 2.7.,"
  },
  {
    "id": 18646,
    "book": "job                                     ",
    "chapter": "16",
    "verse": "9",
    "text": "L'ira sua mi ha lacerato, ed egli procede contro a me da avversario16.9 avversario Giob. 10.16; 30.21.;"
  },
  {
    "id": 18647,
    "book": "job                                     ",
    "chapter": "16",
    "verse": "10",
    "text": "Hanno aperta la bocca contro a me,"
  },
  {
    "id": 18648,
    "book": "job                                     ",
    "chapter": "16",
    "verse": "11",
    "text": "Iddio mi ha messo in poter del perverso,"
  },
  {
    "id": 18649,
    "book": "job                                     ",
    "chapter": "16",
    "verse": "12",
    "text": "Io era in istato tranquillo, ed egli mi ha rotto;"
  },
  {
    "id": 18650,
    "book": "job                                     ",
    "chapter": "16",
    "verse": "13",
    "text": "I suoi arcieri mi hanno intorniato;"
  },
  {
    "id": 18651,
    "book": "job                                     ",
    "chapter": "16",
    "verse": "14",
    "text": "Egli mi rompe di rottura sopra rottura,"
  },
  {
    "id": 18652,
    "book": "job                                     ",
    "chapter": "16",
    "verse": "15",
    "text": "Io ho cucito un sacco sopra la mia pelle,"
  },
  {
    "id": 18653,
    "book": "job                                     ",
    "chapter": "16",
    "verse": "16",
    "text": "La mia faccia è sucida di piangere,"
  },
  {
    "id": 18654,
    "book": "job                                     ",
    "chapter": "16",
    "verse": "17",
    "text": "Quantunque non vi sia violenza nelle mie mani,"
  },
  {
    "id": 18655,
    "book": "job                                     ",
    "chapter": "16",
    "verse": "18",
    "text": "O terra, non nascondere il sangue sparso da me;"
  },
  {
    "id": 18656,
    "book": "job                                     ",
    "chapter": "16",
    "verse": "19",
    "text": "Eziandio ora, ecco, il mio testimonio è ne' cieli16.19 cieli Rom. 1.9.;"
  },
  {
    "id": 18657,
    "book": "job                                     ",
    "chapter": "16",
    "verse": "20",
    "text": "O miei oratori, o amici miei,"
  },
  {
    "id": 18658,
    "book": "job                                     ",
    "chapter": "16",
    "verse": "21",
    "text": "Oh! potesse pur l'uomo piatire con Dio16.21 Dio Giob. 31.35. Eccl. 6.10. Is. 45.9. Rom. 9.20.,"
  },
  {
    "id": 18659,
    "book": "job                                     ",
    "chapter": "16",
    "verse": "22",
    "text": "Perciocchè i miei brevi anni se ne vanno forniti;"
  }
]