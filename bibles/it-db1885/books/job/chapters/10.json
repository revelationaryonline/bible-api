[
  {
    "id": 18486,
    "book": "job                                     ",
    "chapter": "10",
    "verse": "1",
    "text": "L'anima mia si annoia della mia vita10.1 vita 1 Re. 19.4. Gion. 4.3,8.."
  },
  {
    "id": 18487,
    "book": "job                                     ",
    "chapter": "10",
    "verse": "2",
    "text": "Io dirò a Dio: Non condannarmi;"
  },
  {
    "id": 18488,
    "book": "job                                     ",
    "chapter": "10",
    "verse": "3",
    "text": "Ti par egli ben fatto di oppressare,"
  },
  {
    "id": 18489,
    "book": "job                                     ",
    "chapter": "10",
    "verse": "4",
    "text": "Hai tu occhi di carne?"
  },
  {
    "id": 18490,
    "book": "job                                     ",
    "chapter": "10",
    "verse": "5",
    "text": "Sono i tuoi giorni come i giorni dell'uomo mortale?"
  },
  {
    "id": 18491,
    "book": "job                                     ",
    "chapter": "10",
    "verse": "6",
    "text": "Che tu faccia inchiesta della mia iniquità,"
  },
  {
    "id": 18492,
    "book": "job                                     ",
    "chapter": "10",
    "verse": "7",
    "text": "A te si appartiene di conoscere che io non son reo10.7 reo Sal. 139.1,2.;"
  },
  {
    "id": 18493,
    "book": "job                                     ",
    "chapter": "10",
    "verse": "8",
    "text": "Le tue mani mi hanno formato e composto;"
  },
  {
    "id": 18494,
    "book": "job                                     ",
    "chapter": "10",
    "verse": "9",
    "text": "Deh! ricordati che tu mi hai formato come dell'argilla10.9 argilla Gen. 2.7; 3.19. Is. 64.8.;"
  },
  {
    "id": 18495,
    "book": "job                                     ",
    "chapter": "10",
    "verse": "10",
    "text": "Non mi hai tu colato come latte,"
  },
  {
    "id": 18496,
    "book": "job                                     ",
    "chapter": "10",
    "verse": "11",
    "text": "Tu mi hai vestito di pelle e di carne"
  },
  {
    "id": 18497,
    "book": "job                                     ",
    "chapter": "10",
    "verse": "12",
    "text": "Tu mi hai data la vita, ed hai usata benignità inverso me;"
  },
  {
    "id": 18498,
    "book": "job                                     ",
    "chapter": "10",
    "verse": "13",
    "text": "E pur tu avevi riposte queste cose nel cuor tuo;"
  },
  {
    "id": 18499,
    "book": "job                                     ",
    "chapter": "10",
    "verse": "14",
    "text": "Se io ho peccato, tu mi hai notato10.14 notato Giob. 14.16. Sal. 139.1-3.,"
  },
  {
    "id": 18500,
    "book": "job                                     ",
    "chapter": "10",
    "verse": "15",
    "text": "Se io sono stato reo, guai a me10.15 me Is. 3.11.;"
  },
  {
    "id": 18501,
    "book": "job                                     ",
    "chapter": "10",
    "verse": "16",
    "text": "E se pur l'alzo, tu mi cacci a giusa di fiero leone,"
  },
  {
    "id": 18502,
    "book": "job                                     ",
    "chapter": "10",
    "verse": "17",
    "text": "Tu mi produci in faccia nuovi testimoni tuoi;"
  },
  {
    "id": 18503,
    "book": "job                                     ",
    "chapter": "10",
    "verse": "18",
    "text": "Perchè dunque mi hai tratto fuor della matrice?"
  },
  {
    "id": 18504,
    "book": "job                                     ",
    "chapter": "10",
    "verse": "19",
    "text": "Io sarei stato come se non avessi giammai avuto essere;"
  },
  {
    "id": 18505,
    "book": "job                                     ",
    "chapter": "10",
    "verse": "20",
    "text": "I miei giorni non sono eglino poca cosa10.20 cosa Giob. 7.6; 8.9. Sal. 39.5.? cessa dunque,"
  },
  {
    "id": 18506,
    "book": "job                                     ",
    "chapter": "10",
    "verse": "21",
    "text": "Avanti che io me ne vada alla terra delle tenebre,"
  },
  {
    "id": 18507,
    "book": "job                                     ",
    "chapter": "10",
    "verse": "22",
    "text": "Alla terra d'oscurità simile a caligine;"
  }
