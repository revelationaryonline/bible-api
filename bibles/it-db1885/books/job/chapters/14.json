[
  {
    "id": 18581,
    "book": "job                                     ",
    "chapter": "14",
    "verse": "1",
    "text": "L'uomo nato di donna"
  },
  {
    "id": 18582,
    "book": "job                                     ",
    "chapter": "14",
    "verse": "2",
    "text": "Egli esce fuori come un fiore14.2 fiore Sal. 90.5-7; 103.15. Giac. 1.10,11. 1 Piet. 1.24., e poi è reciso;"
  },
  {
    "id": 18583,
    "book": "job                                     ",
    "chapter": "14",
    "verse": "3",
    "text": "E pur tu apri gli occhi tuoi sopra un tale14.3 tale Sal. 144.3.,"
  },
  {
    "id": 18584,
    "book": "job                                     ",
    "chapter": "14",
    "verse": "4",
    "text": "Chi può trarre una cosa monda da una immonda14.4 immonda Giob. 15.14. Sal. 51.5. Giov. 3.6.?"
  },
  {
    "id": 18585,
    "book": "job                                     ",
    "chapter": "14",
    "verse": "5",
    "text": "Poichè i suoi giorni son determinati14.5 determinati Giob. 7.10 e rif.,"
  },
  {
    "id": 18586,
    "book": "job                                     ",
    "chapter": "14",
    "verse": "6",
    "text": "Rivolgiti d'addosso a lui, sì ch'egli abbia alcuna posa,"
  },
  {
    "id": 18587,
    "book": "job                                     ",
    "chapter": "14",
    "verse": "7",
    "text": "Perciocchè quantunque un albero sia tagliato,"
  },
  {
    "id": 18588,
    "book": "job                                     ",
    "chapter": "14",
    "verse": "8",
    "text": "Benchè la sua radice sia invecchiata nella terra,"
  },
  {
    "id": 18589,
    "book": "job                                     ",
    "chapter": "14",
    "verse": "9",
    "text": "Pur nondimeno, tosto ch'egli sentirà l'acqua, rigermoglierà,"
  },
  {
    "id": 18590,
    "book": "job                                     ",
    "chapter": "14",
    "verse": "10",
    "text": "Ma l'uomo muore, e si fiacca;"
  },
  {
    "id": 18591,
    "book": "job                                     ",
    "chapter": "14",
    "verse": "11",
    "text": "Le acque se ne vanno via dal mare,"
  },
  {
    "id": 18592,
    "book": "job                                     ",
    "chapter": "14",
    "verse": "12",
    "text": "Così, quando l'uomo giace in terra, egli non risorge;"
  },
  {
    "id": 18593,
    "book": "job                                     ",
    "chapter": "14",
    "verse": "13",
    "text": "Oh! nascondessimi tu pur sottera,"
  },
  {
    "id": 18594,
    "book": "job                                     ",
    "chapter": "14",
    "verse": "14",
    "text": "Se l'uomo muore, può egli tornare in vita?"
  },
  {
    "id": 18595,
    "book": "job                                     ",
    "chapter": "14",
    "verse": "15",
    "text": "E che tu mi chiami, e che io ti risponda,"
  },
  {
    "id": 18596,
    "book": "job                                     ",
    "chapter": "14",
    "verse": "16",
    "text": "Perciocchè ora tu conti i miei passi14.16 passi Giob. 10.6,14; 13.27; 31.4; 34.21. Sal. 139.1-3. Prov. 5.21. Ger. 32.19.,"
  },
  {
    "id": 18597,
    "book": "job                                     ",
    "chapter": "14",
    "verse": "17",
    "text": "I miei misfatti son suggellati in un sacchetto14.17 sacchetto Deut. 32.34. Os. 13.12.,"
  },
  {
    "id": 18598,
    "book": "job                                     ",
    "chapter": "14",
    "verse": "18",
    "text": "Ma certo, come un monte cadendo scoscende,"
  },
  {
    "id": 18599,
    "book": "job                                     ",
    "chapter": "14",
    "verse": "19",
    "text": "E le acque rodono le pietre,"
  },
  {
    "id": 18600,
    "book": "job                                     ",
    "chapter": "14",
    "verse": "20",
    "text": "Tu lo sopraffai in eterno, ed egli se ne va;"
  },
  {
    "id": 18601,
    "book": "job                                     ",
    "chapter": "14",
    "verse": "21",
    "text": "Se poi i suoi figliuoli sono in onore, egli nol sa14.21 sa Eccl. 9.5.;"
  },
  {
    "id": 18602,
    "book": "job                                     ",
    "chapter": "14",
    "verse": "22",
    "text": "La sua carne si duole sol di lui,"
  }
]