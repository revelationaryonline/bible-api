[
  {
    "id": 19231,
    "book": "job                                     ",
    "chapter": "39",
    "verse": "1",
    "text": "Andrai tu a cacciar preda per il leone?"
  },
  {
    "id": 19232,
    "book": "job                                     ",
    "chapter": "39",
    "verse": "2",
    "text": "Quando si appiattano ne' lor ricetti,"
  },
  {
    "id": 19233,
    "book": "job                                     ",
    "chapter": "39",
    "verse": "3",
    "text": "Chi apparecchia al corvo il suo pasto39.3 pasto Sal. 147.9. Mat. 6.26.,"
  },
  {
    "id": 19234,
    "book": "job                                     ",
    "chapter": "39",
    "verse": "4",
    "text": "Sai tu il tempo che le camozze delle rocce figliano?"
  },
  {
    "id": 19235,
    "book": "job                                     ",
    "chapter": "39",
    "verse": "5",
    "text": "Annoveri tu i mesi del termine del lor portato,"
  },
  {
    "id": 19236,
    "book": "job                                     ",
    "chapter": "39",
    "verse": "6",
    "text": "Elle si chinano, fanno scoppiar fuori il lor feto,"
  },
  {
    "id": 19237,
    "book": "job                                     ",
    "chapter": "39",
    "verse": "7",
    "text": "I lor figli son gagliardi, crescono per le biade,"
  },
  {
    "id": 19238,
    "book": "job                                     ",
    "chapter": "39",
    "verse": "8",
    "text": "Chi ne ha mandato libero l'asino salvatico,"
  },
  {
    "id": 19239,
    "book": "job                                     ",
    "chapter": "39",
    "verse": "9",
    "text": "A cui io ho ordinato il deserto per casa;"
  },
  {
    "id": 19240,
    "book": "job                                     ",
    "chapter": "39",
    "verse": "10",
    "text": "Egli si beffa dello strepito della città;"
  },
  {
    "id": 19241,
    "book": "job                                     ",
    "chapter": "39",
    "verse": "11",
    "text": "I monti, ch'egli va spiando, sono il suo pasco;"
  },
  {
    "id": 19242,
    "book": "job                                     ",
    "chapter": "39",
    "verse": "12",
    "text": "Il liocorno39.12 liocorno Num. 23.22. Deut. 33.17. ti vorrà egli servire?"
  },
  {
    "id": 19243,
    "book": "job                                     ",
    "chapter": "39",
    "verse": "13",
    "text": "Legherai tu il liocorno con la sua fune, per farlo arare al solco?"
  },
  {
    "id": 19244,
    "book": "job                                     ",
    "chapter": "39",
    "verse": "14",
    "text": "Ti fiderai tu in lui, perchè la sua forza è grande?"
  },
  {
    "id": 19245,
    "book": "job                                     ",
    "chapter": "39",
    "verse": "15",
    "text": "Ti fiderai tu in lui ch'egli ti renda la ricolta della tua sementa,"
  },
  {
    "id": 19246,
    "book": "job                                     ",
    "chapter": "39",
    "verse": "16",
    "text": "Le ale de' paoni son esse vaghe per opera tua?"
  },
  {
    "id": 19247,
    "book": "job                                     ",
    "chapter": "39",
    "verse": "17",
    "text": "Fai tu ch'egli abbandoni le sue uova in su la terra,"
  },
  {
    "id": 19248,
    "book": "job                                     ",
    "chapter": "39",
    "verse": "18",
    "text": "E che dimentichi che il piè d'alcuno le schiaccerà,"
  },
  {
    "id": 19249,
    "book": "job                                     ",
    "chapter": "39",
    "verse": "19",
    "text": "Egli è spietato inverso i suoi figli, come se non fosser suoi;"
  },
  {
    "id": 19250,
    "book": "job                                     ",
    "chapter": "39",
    "verse": "20",
    "text": "Perciocchè Iddio l'ha privo di senno,"
  },
  {
    "id": 19251,
    "book": "job                                     ",
    "chapter": "39",
    "verse": "21",
    "text": "Quando egli si solleva in alto,"
  },
  {
    "id": 19252,
    "book": "job                                     ",
    "chapter": "39",
    "verse": "22",
    "text": "Hai tu data la forza al cavallo?"
  },
  {
    "id": 19253,
    "book": "job                                     ",
    "chapter": "39",
    "verse": "23",
    "text": "Lo spaventerai tu come una locusta?"
  },
  {
    "id": 19254,
    "book": "job                                     ",
    "chapter": "39",
    "verse": "24",
    "text": "Egli raspa nella valle, si rallegra della sua forza,"
  },
  {
    "id": 19255,
    "book": "job                                     ",
    "chapter": "39",
    "verse": "25",
    "text": "Egli si beffa della paura, e non si spaventa,"
  },
  {
    "id": 19256,
    "book": "job                                     ",
    "chapter": "39",
    "verse": "26",
    "text": "Il turcasso, e la folgorante lancia,"
  },
  {
    "id": 19257,
    "book": "job                                     ",
    "chapter": "39",
    "verse": "27",
    "text": "D'impazienza e di stizza pare ch'egli voglia trangugiar la terra;"
  },
  {
    "id": 19258,
    "book": "job                                     ",
    "chapter": "39",
    "verse": "28",
    "text": "Come prima la tromba ha sonato, egli dice: Aha, Aha;"
  },
  {
    "id": 19259,
    "book": "job                                     ",
    "chapter": "39",
    "verse": "29",
    "text": "È per il tuo senno che lo sparviere vola?"
  },
  {
    "id": 19260,
    "book": "job                                     ",
    "chapter": "39",
    "verse": "30",
    "text": "L'aquila si leva ella ad alto per lo tuo comandamento?"
  },
  {
    "id": 19261,
    "book": "job                                     ",
    "chapter": "39",
    "verse": "31",
    "text": "Ella dimora e si ripara nelle rupi,"
  },
  {
    "id": 19262,
    "book": "job                                     ",
    "chapter": "39",
    "verse": "32",
    "text": "Di là ella spia il pasto,"
  },
  {
    "id": 19263,
    "book": "job                                     ",
    "chapter": "39",
    "verse": "33",
    "text": "I suoi aquilini ancora sorbiscono il sangue,"
  },
  {
    "id": 19264,
    "book": "job                                     ",
    "chapter": "39",
    "verse": "34",
    "text": "Poi il Signore parlò a Giobbe, e disse:"
  },
  {
    "id": 19265,
    "book": "job                                     ",
    "chapter": "39",
    "verse": "35",
    "text": "Colui che litiga con l'Onnipotente39.35 Onnipotente Giob. 33.13 e rif. lo correggerà egli?"
  },
  {
    "id": 19266,
    "book": "job                                     ",
    "chapter": "39",
    "verse": "36",
    "text": "E Giobbe rispose al Signore, e disse:"
  },
  {
    "id": 19267,
    "book": "job                                     ",
    "chapter": "39",
    "verse": "37",
    "text": "Ecco, io sono avvilito; che ti risponderei io39.37 io Esd. 9.6. Giob. 42.6. Sal. 51.4.?"
  },
  {
    "id": 19268,
    "book": "job                                     ",
    "chapter": "39",
    "verse": "38",
    "text": "Io ho parlato una volta, ma non replicherò più;"
  }
]