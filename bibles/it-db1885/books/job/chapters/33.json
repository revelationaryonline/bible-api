[
  {
    "id": 19050,
    "book": "job                                     ",
    "chapter": "33",
    "verse": "1",
    "text": "Ora dunque, Giobbe, ascolta, ti prego, i miei ragionamenti,"
  },
  {
    "id": 19051,
    "book": "job                                     ",
    "chapter": "33",
    "verse": "2",
    "text": "Ecco, ora io ho aperta la mia bocca,"
  },
  {
    "id": 19052,
    "book": "job                                     ",
    "chapter": "33",
    "verse": "3",
    "text": "Le mie parole saranno secondo la dirittura del mio cuore;"
  },
  {
    "id": 19053,
    "book": "job                                     ",
    "chapter": "33",
    "verse": "4",
    "text": "Lo Spirito di Dio mi ha fatto,"
  },
  {
    "id": 19054,
    "book": "job                                     ",
    "chapter": "33",
    "verse": "5",
    "text": "Se tu puoi, rispondimi;"
  },
  {
    "id": 19055,
    "book": "job                                     ",
    "chapter": "33",
    "verse": "6",
    "text": "Ecco, io sono a Dio, come tu;"
  },
  {
    "id": 19056,
    "book": "job                                     ",
    "chapter": "33",
    "verse": "7",
    "text": "Ecco, il mio spavento non ti sgomenterà,"
  },
  {
    "id": 19057,
    "book": "job                                     ",
    "chapter": "33",
    "verse": "8",
    "text": "Tu hai pur detto, udendolo io,"
  },
  {
    "id": 19058,
    "book": "job                                     ",
    "chapter": "33",
    "verse": "9",
    "text": "Io son puro, senza misfatto;"
  },
  {
    "id": 19059,
    "book": "job                                     ",
    "chapter": "33",
    "verse": "10",
    "text": "Ecco, egli trova delle occasioni contro a me;"
  },
  {
    "id": 19060,
    "book": "job                                     ",
    "chapter": "33",
    "verse": "11",
    "text": "Egli ha messi i miei piedi ne' ceppi,"
  },
  {
    "id": 19061,
    "book": "job                                     ",
    "chapter": "33",
    "verse": "12",
    "text": "Ecco, in questo tu non sei stato giusto; io ti risponderò;"
  },
  {
    "id": 19062,
    "book": "job                                     ",
    "chapter": "33",
    "verse": "13",
    "text": "Perchè hai tu conteso con lui33.13 lui Is. 45.9.,"
  },
  {
    "id": 19063,
    "book": "job                                     ",
    "chapter": "33",
    "verse": "14",
    "text": "Egli è ben vero, che talora Iddio parla una volta,"
  },
  {
    "id": 19064,
    "book": "job                                     ",
    "chapter": "33",
    "verse": "15",
    "text": "In sogno, in vision notturna33.15 notturna Num. 12.6. Giob. 4.13.,"
  },
  {
    "id": 19065,
    "book": "job                                     ",
    "chapter": "33",
    "verse": "16",
    "text": "Allora egli apre loro l'orecchio,"
  },
  {
    "id": 19066,
    "book": "job                                     ",
    "chapter": "33",
    "verse": "17",
    "text": "Per istorre l'uomo dalle opere sue,"
  },
  {
    "id": 19067,
    "book": "job                                     ",
    "chapter": "33",
    "verse": "18",
    "text": "Per iscampar l'anima sua dalla fossa,"
  },
  {
    "id": 19068,
    "book": "job                                     ",
    "chapter": "33",
    "verse": "19",
    "text": "Ma talora altresì l'uomo è castigato con dolori sopra il suo letto,"
  },
  {
    "id": 19069,
    "book": "job                                     ",
    "chapter": "33",
    "verse": "20",
    "text": "E la sua vita gli fa abbominare il cibo,"
  },
  {
    "id": 19070,
    "book": "job                                     ",
    "chapter": "33",
    "verse": "21",
    "text": "La sua carne è consumata, talchè non apparisce più;"
  },
  {
    "id": 19071,
    "book": "job                                     ",
    "chapter": "33",
    "verse": "22",
    "text": "E l'anima sua si accosta alla fossa,"
  },
  {
    "id": 19072,
    "book": "job                                     ",
    "chapter": "33",
    "verse": "23",
    "text": "Ma se allora vi è appresso di lui alcun messo, un parlatore,"
  },
  {
    "id": 19073,
    "book": "job                                     ",
    "chapter": "33",
    "verse": "24",
    "text": "Iddio gli farà grazia, e dirà:"
  },
  {
    "id": 19074,
    "book": "job                                     ",
    "chapter": "33",
    "verse": "25",
    "text": "La sua carne diventerà morbida, più che non è in fanciullezza;"
  },
  {
    "id": 19075,
    "book": "job                                     ",
    "chapter": "33",
    "verse": "26",
    "text": "Egli supplicherà a Dio, ed egli gli sarà placato,"
  },
  {
    "id": 19076,
    "book": "job                                     ",
    "chapter": "33",
    "verse": "27",
    "text": "Ed esso poi si volgerà verso gli uomini, e dirà:"
  },
  {
    "id": 19077,
    "book": "job                                     ",
    "chapter": "33",
    "verse": "28",
    "text": "Così Iddio riscoterà l'anima sua, che non passi nella fossa,"
  },
  {
    "id": 19078,
    "book": "job                                     ",
    "chapter": "33",
    "verse": "29",
    "text": "Ecco, Iddio opera tutte queste cose"
  },
  {
    "id": 19079,
    "book": "job                                     ",
    "chapter": "33",
    "verse": "30",
    "text": "Per ritrarre l'anima sua dalla fossa,"
  },
  {
    "id": 19080,
    "book": "job                                     ",
    "chapter": "33",
    "verse": "31",
    "text": "Attendi, o Giobbe, ascoltami;"
  },
  {
    "id": 19081,
    "book": "job                                     ",
    "chapter": "33",
    "verse": "32",
    "text": "Se tu hai alcuna cosa da dire, rispondimi;"
  },
  {
    "id": 19082,
    "book": "job                                     ",
    "chapter": "33",
    "verse": "33",
    "text": "Se no, ascoltami tu;"
  }
]