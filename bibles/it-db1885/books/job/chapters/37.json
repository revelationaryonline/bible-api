[
  {
    "id": 19169,
    "book": "job                                     ",
    "chapter": "37",
    "verse": "1",
    "text": "Il cuor mi trema eziandio di questo,"
  },
  {
    "id": 19170,
    "book": "job                                     ",
    "chapter": "37",
    "verse": "2",
    "text": "Udite pure il suo tremendo tuono,"
  },
  {
    "id": 19171,
    "book": "job                                     ",
    "chapter": "37",
    "verse": "3",
    "text": "Egli lo lancia sotto tutti i cieli,"
  },
  {
    "id": 19172,
    "book": "job                                     ",
    "chapter": "37",
    "verse": "4",
    "text": "Dopo la quale rugge il tuono; egli tuona con la voce della sua altezza37.4 altezza Sal. 29.3; 68.33.,"
  },
  {
    "id": 19173,
    "book": "job                                     ",
    "chapter": "37",
    "verse": "5",
    "text": "Iddio tuona maravigliosamente con la sua voce;"
  },
  {
    "id": 19174,
    "book": "job                                     ",
    "chapter": "37",
    "verse": "6",
    "text": "Perciocchè egli dice alla neve: Cadi in su la terra37.6 terra Sal. 147.16 ecc.;"
  },
  {
    "id": 19175,
    "book": "job                                     ",
    "chapter": "37",
    "verse": "7",
    "text": "Egli rinchiude ogni uomo in casa,"
  },
  {
    "id": 19176,
    "book": "job                                     ",
    "chapter": "37",
    "verse": "8",
    "text": "E le fiere se n'entrano ne' lor nascondimenti,"
  },
  {
    "id": 19177,
    "book": "job                                     ",
    "chapter": "37",
    "verse": "9",
    "text": "La tempesta viene dall'Austro,"
  },
  {
    "id": 19178,
    "book": "job                                     ",
    "chapter": "37",
    "verse": "10",
    "text": "Iddio, col suo soffio, produce il ghiaccio,"
  },
  {
    "id": 19179,
    "book": "job                                     ",
    "chapter": "37",
    "verse": "11",
    "text": "Egli stanca eziandio le nuvole in adacquar la terra,"
  },
  {
    "id": 19180,
    "book": "job                                     ",
    "chapter": "37",
    "verse": "12",
    "text": "Ed esse si rivolgono in molti giri, secondo gli ordini suoi"
  },
  {
    "id": 19181,
    "book": "job                                     ",
    "chapter": "37",
    "verse": "13",
    "text": "Facendole venire, o per castigo37.13 castigo Esod. 9.18,23. 1 Sam. 12.18,19. Esd. 10.9.,"
  },
  {
    "id": 19182,
    "book": "job                                     ",
    "chapter": "37",
    "verse": "14",
    "text": "Porgi l'orecchio a questo, o Giobbe;"
  },
  {
    "id": 19183,
    "book": "job                                     ",
    "chapter": "37",
    "verse": "15",
    "text": "Sai tu, come Iddio dispone di esse,"
  },
  {
    "id": 19184,
    "book": "job                                     ",
    "chapter": "37",
    "verse": "16",
    "text": "Intendi tu come le nuvole son bilanciate?"
  },
  {
    "id": 19185,
    "book": "job                                     ",
    "chapter": "37",
    "verse": "17",
    "text": "Come i tuoi vestimenti son caldi,"
  },
  {
    "id": 19186,
    "book": "job                                     ",
    "chapter": "37",
    "verse": "18",
    "text": "Hai tu con lui distesi i cieli37.18 cieli Gen. 1.6. Is. 44.24.,"
  },
  {
    "id": 19187,
    "book": "job                                     ",
    "chapter": "37",
    "verse": "19",
    "text": "Insegnaci ciò che noi gli diremo;"
  },
  {
    "id": 19188,
    "book": "job                                     ",
    "chapter": "37",
    "verse": "20",
    "text": "Gli sarebbe egli rapportato quando io avessi parlato?"
  },
  {
    "id": 19189,
    "book": "job                                     ",
    "chapter": "37",
    "verse": "21",
    "text": "Ecco pure gli uomini non possono riguardare il sole,"
  },
  {
    "id": 19190,
    "book": "job                                     ",
    "chapter": "37",
    "verse": "22",
    "text": "E che dal Settentrione è venuta la dorata serenità;"
  },
  {
    "id": 19191,
    "book": "job                                     ",
    "chapter": "37",
    "verse": "23",
    "text": "Egli è l'Onnipotente, noi non possiam trovarlo37.23 trovarlo 1 Tim. 6.16.;"
  },
  {
    "id": 19192,
    "book": "job                                     ",
    "chapter": "37",
    "verse": "24",
    "text": "Perciò gli uomini lo temono37.24 temono Mat. 10.28.;"
  }
]