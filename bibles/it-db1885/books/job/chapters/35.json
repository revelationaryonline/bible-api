[
  {
    "id": 19120,
    "book": "job                                     ",
    "chapter": "35",
    "verse": "1",
    "text": "ED Elihu proseguì il suo ragionamento, e disse:"
  },
  {
    "id": 19121,
    "book": "job                                     ",
    "chapter": "35",
    "verse": "2",
    "text": "Hai tu stimato che ciò convenga alla ragione,"
  },
  {
    "id": 19122,
    "book": "job                                     ",
    "chapter": "35",
    "verse": "3",
    "text": "Di dire: Che mi gioverà ella?"
  },
  {
    "id": 19123,
    "book": "job                                     ",
    "chapter": "35",
    "verse": "4",
    "text": "Io ti risponderò,"
  },
  {
    "id": 19124,
    "book": "job                                     ",
    "chapter": "35",
    "verse": "5",
    "text": "Riguarda i cieli, e vedi;"
  },
  {
    "id": 19125,
    "book": "job                                     ",
    "chapter": "35",
    "verse": "6",
    "text": "Se tu pecchi, che cosa opererai tu contro a lui?"
  },
  {
    "id": 19126,
    "book": "job                                     ",
    "chapter": "35",
    "verse": "7",
    "text": "Se tu sei giusto, che cosa gli darai?"
  },
  {
    "id": 19127,
    "book": "job                                     ",
    "chapter": "35",
    "verse": "8",
    "text": "Come la tua malvagità può nuocer solo ad un uomo simile a te,"
  },
  {
    "id": 19128,
    "book": "job                                     ",
    "chapter": "35",
    "verse": "9",
    "text": "Gli oppressati gridano per la grandezza dell'oppressione,"
  },
  {
    "id": 19129,
    "book": "job                                     ",
    "chapter": "35",
    "verse": "10",
    "text": "Ma niuno dice: Ove è Dio, mio fattore35.10 fattore Is. 51.13.,"
  },
  {
    "id": 19130,
    "book": "job                                     ",
    "chapter": "35",
    "verse": "11",
    "text": "Il qual ci ammaestra più che le bestie della terra35.11 terra Sal. 94.12.,"
  },
  {
    "id": 19131,
    "book": "job                                     ",
    "chapter": "35",
    "verse": "12",
    "text": "Quivi adunque gridano, ed egli non li esaudisce,"
  },
  {
    "id": 19132,
    "book": "job                                     ",
    "chapter": "35",
    "verse": "13",
    "text": "Certamente Iddio non esaudisce la vanità35.13 vanità Prov. 15.29. Is. 1.15.,"
  },
  {
    "id": 19133,
    "book": "job                                     ",
    "chapter": "35",
    "verse": "14",
    "text": "Quanto meno esaudirà egli te, che dici che tu nol riguardi?"
  },
  {
    "id": 19134,
    "book": "job                                     ",
    "chapter": "35",
    "verse": "15",
    "text": "Certo ora quello che l'ira sua ti ha imposto di castigo è come nulla;"
  },
  {
    "id": 19135,
    "book": "job                                     ",
    "chapter": "35",
    "verse": "16",
    "text": "Giobbe adunque indarno apre la sua bocca,"
  }
]