[
  {
    "id": 18836,
    "book": "job                                     ",
    "chapter": "24",
    "verse": "1",
    "text": "Perchè non dirassi che i tempi sono occultati dall'Onnipotente,"
  },
  {
    "id": 18837,
    "book": "job                                     ",
    "chapter": "24",
    "verse": "2",
    "text": "Gli empi muovono i termini24.2 termini Deut. 19.14; 27.17. Prov. 22.28. Os. 5.10.,"
  },
  {
    "id": 18838,
    "book": "job                                     ",
    "chapter": "24",
    "verse": "3",
    "text": "Menano via l'asino degli orfani;"
  },
  {
    "id": 18839,
    "book": "job                                     ",
    "chapter": "24",
    "verse": "4",
    "text": "Fanno torcere i bisognosi dalla via,"
  },
  {
    "id": 18840,
    "book": "job                                     ",
    "chapter": "24",
    "verse": "5",
    "text": "Ecco, son simili ad asini salvatici nel deserto:"
  },
  {
    "id": 18841,
    "book": "job                                     ",
    "chapter": "24",
    "verse": "6",
    "text": "Mietono il campo,"
  },
  {
    "id": 18842,
    "book": "job                                     ",
    "chapter": "24",
    "verse": "7",
    "text": "Fanno passar la notte agl'ignudi senza vestimenti,"
  },
  {
    "id": 18843,
    "book": "job                                     ",
    "chapter": "24",
    "verse": "8",
    "text": "Sono bagnati dalle acque che traboccano da' monti;"
  },
  {
    "id": 18844,
    "book": "job                                     ",
    "chapter": "24",
    "verse": "9",
    "text": "Rapiscono l'orfano dalla poppa,"
  },
  {
    "id": 18845,
    "book": "job                                     ",
    "chapter": "24",
    "verse": "10",
    "text": "Fanno andar gl'ignudi senza vestimenti;"
  },
  {
    "id": 18846,
    "book": "job                                     ",
    "chapter": "24",
    "verse": "11",
    "text": "Quelli che spremono loro l'olio intra i lor muri,"
  },
  {
    "id": 18847,
    "book": "job                                     ",
    "chapter": "24",
    "verse": "12",
    "text": "Gli uomini gemono dalla città"
  },
  {
    "id": 18848,
    "book": "job                                     ",
    "chapter": "24",
    "verse": "13",
    "text": "Essi son di quelli che son ribelli alla luce,"
  },
  {
    "id": 18849,
    "book": "job                                     ",
    "chapter": "24",
    "verse": "14",
    "text": "Il micidiale si leva allo schiarir del dì"
  },
  {
    "id": 18850,
    "book": "job                                     ",
    "chapter": "24",
    "verse": "15",
    "text": "Parimente l'occhio dell'adultero osserva la sera,"
  },
  {
    "id": 18851,
    "book": "job                                     ",
    "chapter": "24",
    "verse": "16",
    "text": "Di notte sconficcano le case,"
  },
  {
    "id": 18852,
    "book": "job                                     ",
    "chapter": "24",
    "verse": "17",
    "text": "Perciocchè la mattina è ad essi tutti ombra di morte;"
  },
  {
    "id": 18853,
    "book": "job                                     ",
    "chapter": "24",
    "verse": "18",
    "text": "Fuggono leggermente, come in su le acque;"
  },
  {
    "id": 18854,
    "book": "job                                     ",
    "chapter": "24",
    "verse": "19",
    "text": "La secchezza e il caldo involano le acque della neve;"
  },
  {
    "id": 18855,
    "book": "job                                     ",
    "chapter": "24",
    "verse": "20",
    "text": "La matrice li dimentica,"
  },
  {
    "id": 18856,
    "book": "job                                     ",
    "chapter": "24",
    "verse": "21",
    "text": "E benchè tormentino la sterile che non partorisce,"
  },
  {
    "id": 18857,
    "book": "job                                     ",
    "chapter": "24",
    "verse": "22",
    "text": "E traggano giù i possenti con la lor forza;"
  },
  {
    "id": 18858,
    "book": "job                                     ",
    "chapter": "24",
    "verse": "23",
    "text": "Pur nondimeno Iddio dà loro a che potersi sicuramente appoggiare,"
  },
  {
    "id": 18859,
    "book": "job                                     ",
    "chapter": "24",
    "verse": "24",
    "text": "Per un poco di tempo sono innalzati, poi non son più;"
  },
  {
    "id": 18860,
    "book": "job                                     ",
    "chapter": "24",
    "verse": "25",
    "text": "Se ora egli non è così, chi mi dimentirà,"
  }
]