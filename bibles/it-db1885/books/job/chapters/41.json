[
  {
    "id": 19288,
    "book": "job                                     ",
    "chapter": "41",
    "verse": "1",
    "text": "Trarrai tu fuori il leviatan41.1 leviatan Sal. 104.26. Is. 27.1. con l'amo,"
  },
  {
    "id": 19289,
    "book": "job                                     ",
    "chapter": "41",
    "verse": "2",
    "text": "Gli metterai tu un uncino al muso?"
  },
  {
    "id": 19290,
    "book": "job                                     ",
    "chapter": "41",
    "verse": "3",
    "text": "Userà egli molti preghi teco?"
  },
  {
    "id": 19291,
    "book": "job                                     ",
    "chapter": "41",
    "verse": "4",
    "text": "Patteggerà egli teco,"
  },
  {
    "id": 19292,
    "book": "job                                     ",
    "chapter": "41",
    "verse": "5",
    "text": "Scherzerai tu con lui, come con un uccello?"
  },
  {
    "id": 19293,
    "book": "job                                     ",
    "chapter": "41",
    "verse": "6",
    "text": "I compagni ne faranno essi un convito?"
  },
  {
    "id": 19294,
    "book": "job                                     ",
    "chapter": "41",
    "verse": "7",
    "text": "Gli empirai tu la pelle di roncigli,"
  },
  {
    "id": 19295,
    "book": "job                                     ",
    "chapter": "41",
    "verse": "8",
    "text": "Pongli pur la mano addosso,"
  },
  {
    "id": 19296,
    "book": "job                                     ",
    "chapter": "41",
    "verse": "9",
    "text": "Ecco, la speranza di pigliarlo è fallace;"
  },
  {
    "id": 19297,
    "book": "job                                     ",
    "chapter": "41",
    "verse": "10",
    "text": "Non vi è alcuno così feroce, che ardisca risvegliarlo;"
  },
  {
    "id": 19298,
    "book": "job                                     ",
    "chapter": "41",
    "verse": "11",
    "text": "Chi mi ha prevenuto in darmi cosa alcuna? ed io gliela renderò41.11 renderò Rom. 11.35.;"
  },
  {
    "id": 19299,
    "book": "job                                     ",
    "chapter": "41",
    "verse": "12",
    "text": "Io non tacerò le membra di quello,"
  },
  {
    "id": 19300,
    "book": "job                                     ",
    "chapter": "41",
    "verse": "13",
    "text": "Chi scoprirà il disopra della sua coverta?"
  },
  {
    "id": 19301,
    "book": "job                                     ",
    "chapter": "41",
    "verse": "14",
    "text": "Chi aprirà gli usci del suo muso?"
  },
  {
    "id": 19302,
    "book": "job                                     ",
    "chapter": "41",
    "verse": "15",
    "text": "I suoi forti scudi sono una cosa superba;"
  },
  {
    "id": 19303,
    "book": "job                                     ",
    "chapter": "41",
    "verse": "16",
    "text": "L'uno si attiene all'altro,"
  },
  {
    "id": 19304,
    "book": "job                                     ",
    "chapter": "41",
    "verse": "17",
    "text": "Sono attaccati gli uni agli altri, ed accoppiati insieme,"
  },
  {
    "id": 19305,
    "book": "job                                     ",
    "chapter": "41",
    "verse": "18",
    "text": "I suoi starnuti fanno sfavillar della luce,"
  },
  {
    "id": 19306,
    "book": "job                                     ",
    "chapter": "41",
    "verse": "19",
    "text": "Della sua gola escono fiaccole,"
  },
  {
    "id": 19307,
    "book": "job                                     ",
    "chapter": "41",
    "verse": "20",
    "text": "Delle sue nari esce un fumo,"
  },
  {
    "id": 19308,
    "book": "job                                     ",
    "chapter": "41",
    "verse": "21",
    "text": "L'alito suo accende i carboni,"
  },
  {
    "id": 19309,
    "book": "job                                     ",
    "chapter": "41",
    "verse": "22",
    "text": "La possa alberga nel suo collo,"
  },
  {
    "id": 19310,
    "book": "job                                     ",
    "chapter": "41",
    "verse": "23",
    "text": "Le polpe della sua carne son compresse;"
  },
  {
    "id": 19311,
    "book": "job                                     ",
    "chapter": "41",
    "verse": "24",
    "text": "Il cuor suo è sodo come una pietra,"
  },
  {
    "id": 19312,
    "book": "job                                     ",
    "chapter": "41",
    "verse": "25",
    "text": "I più forti e valenti hanno paura di lui, quando egli si alza;"
  },
  {
    "id": 19313,
    "book": "job                                     ",
    "chapter": "41",
    "verse": "26",
    "text": "Nè la spada di chi l'aggiungerà potrà durare,"
  },
  {
    "id": 19314,
    "book": "job                                     ",
    "chapter": "41",
    "verse": "27",
    "text": "Egli reputa il ferro per paglia,"
  },
  {
    "id": 19315,
    "book": "job                                     ",
    "chapter": "41",
    "verse": "28",
    "text": "La saetta non lo farà fuggire;"
  },
  {
    "id": 19316,
    "book": "job                                     ",
    "chapter": "41",
    "verse": "29",
    "text": "Gli ordigni son da lui riputati stoppia;"
  },
  {
    "id": 19317,
    "book": "job                                     ",
    "chapter": "41",
    "verse": "30",
    "text": "Egli ha sotto di sè de' testi pungenti;"
  },
  {
    "id": 19318,
    "book": "job                                     ",
    "chapter": "41",
    "verse": "31",
    "text": "Egli fa bollire il profondo mare come una caldaia;"
  },
  {
    "id": 19319,
    "book": "job                                     ",
    "chapter": "41",
    "verse": "32",
    "text": "Egli fa rilucere dietro a sè un sentiero,"
  },
  {
    "id": 19320,
    "book": "job                                     ",
    "chapter": "41",
    "verse": "33",
    "text": "Non vi è alcuno animale in su la terra che gli possa essere assomigliato,"
  },
  {
    "id": 19321,
    "book": "job                                     ",
    "chapter": "41",
    "verse": "34",
    "text": "Egli riguarda ogni cosa eccelsa,"
  }
]