[
  {
    "id": 28757,
    "book": "psalms                                  ",
    "chapter": "35",
    "verse": "1",
    "text": "O SIGNORE, contendi con quelli che contendono meco;"
  },
  {
    "id": 28758,
    "book": "psalms                                  ",
    "chapter": "35",
    "verse": "2",
    "text": "Prendi lo scudo e la targa35.2 targa Sal. 5.12; 91.4.;"
  },
  {
    "id": 28759,
    "book": "psalms                                  ",
    "chapter": "35",
    "verse": "3",
    "text": "E trai fuori la lancia, e serra il passo a quelli che mi perseguitano;"
  },
  {
    "id": 28760,
    "book": "psalms                                  ",
    "chapter": "35",
    "verse": "4",
    "text": "Sien confusi e svergognati quelli che cercano l'anima mia;"
  },
  {
    "id": 28761,
    "book": "psalms                                  ",
    "chapter": "35",
    "verse": "5",
    "text": "Sien come pula al vento35.5 vento Sal. 1.4 e rif.,"
  },
  {
    "id": 28762,
    "book": "psalms                                  ",
    "chapter": "35",
    "verse": "6",
    "text": "Sia la via loro tutta tenebre, e sdruccioli;"
  },
  {
    "id": 28763,
    "book": "psalms                                  ",
    "chapter": "35",
    "verse": "7",
    "text": "Perciocchè senza cagione hanno fatta una fossa nascosta,"
  },
  {
    "id": 28764,
    "book": "psalms                                  ",
    "chapter": "35",
    "verse": "8",
    "text": "Venga loro una sprovveduta ruina35.8 ruina 1 Tess. 5.3.,"
  },
  {
    "id": 28765,
    "book": "psalms                                  ",
    "chapter": "35",
    "verse": "9",
    "text": "Allora l'anima mia festeggerà nel Signore,"
  },
  {
    "id": 28766,
    "book": "psalms                                  ",
    "chapter": "35",
    "verse": "10",
    "text": "Tutte le ossa mie diranno: O Signore, chi è pari a te,"
  },
  {
    "id": 28767,
    "book": "psalms                                  ",
    "chapter": "35",
    "verse": "11",
    "text": "Falsi testimoni si levano35.11 levano Sal. 27.12 e rif.;"
  },
  {
    "id": 28768,
    "book": "psalms                                  ",
    "chapter": "35",
    "verse": "12",
    "text": "Mi rendono male per bene35.12 bene Ger. 18.20. Giov. 10.32.;"
  },
  {
    "id": 28769,
    "book": "psalms                                  ",
    "chapter": "35",
    "verse": "13",
    "text": "E pure io, quando essi erano infermi, mi vestiva d'un cilicio."
  },
  {
    "id": 28770,
    "book": "psalms                                  ",
    "chapter": "35",
    "verse": "14",
    "text": "Io andava attorno, come se fosse stato per un mio amico, ovver fratello;"
  },
  {
    "id": 28771,
    "book": "psalms                                  ",
    "chapter": "35",
    "verse": "15",
    "text": "Ma quando io son zoppicato, essi se ne son rallegrati,"
  },
  {
    "id": 28772,
    "book": "psalms                                  ",
    "chapter": "35",
    "verse": "16",
    "text": "Insieme con profani beffatori giocolari,"
  },
  {
    "id": 28773,
    "book": "psalms                                  ",
    "chapter": "35",
    "verse": "17",
    "text": "O Signore, infino a quando vedrai queste cose?"
  },
  {
    "id": 28774,
    "book": "psalms                                  ",
    "chapter": "35",
    "verse": "18",
    "text": "Io ti celebrerò in gran raunanza;"
  },
  {
    "id": 28775,
    "book": "psalms                                  ",
    "chapter": "35",
    "verse": "19",
    "text": "Non rallegrinsi di me quelli che mi son nemici a torto;"
  },
  {
    "id": 28776,
    "book": "psalms                                  ",
    "chapter": "35",
    "verse": "20",
    "text": "Perciocchè non parlano giammai di pace;"
  },
  {
    "id": 28777,
    "book": "psalms                                  ",
    "chapter": "35",
    "verse": "21",
    "text": "Ed allargano la lor bocca contro a me,"
  },
  {
    "id": 28778,
    "book": "psalms                                  ",
    "chapter": "35",
    "verse": "22",
    "text": "O Signore, tu hai vedute queste cose; non tacere;"
  },
  {
    "id": 28779,
    "book": "psalms                                  ",
    "chapter": "35",
    "verse": "23",
    "text": "Risvegliati, e destati, per farmi ragione;"
  },
  {
    "id": 28780,
    "book": "psalms                                  ",
    "chapter": "35",
    "verse": "24",
    "text": "O Signore Iddio mio, giudicami secondo la tua giustizia35.24 giustizia 2 Tess. 1.6.,"
  },
  {
    "id": 28781,
    "book": "psalms                                  ",
    "chapter": "35",
    "verse": "25",
    "text": "E non dicano nel cuor loro: Ehi! anima nostra;"
  },
  {
    "id": 28782,
    "book": "psalms                                  ",
    "chapter": "35",
    "verse": "26",
    "text": "Sieno svergognati e confusi tutti quanti"
  },
  {
    "id": 28783,
    "book": "psalms                                  ",
    "chapter": "35",
    "verse": "27",
    "text": "Cantino, e rallegrinsi"
  },
  {
    "id": 28784,
    "book": "psalms                                  ",
    "chapter": "35",
    "verse": "28",
    "text": "E la mia lingua risonerà la tua giustizia"
  }
]