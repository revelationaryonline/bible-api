[
  {
    "id": 29860,
    "book": "psalms                                  ",
    "chapter": "101",
    "verse": "1",
    "text": "IO canterò un cantico di benignità e di giudicio;"
  },
  {
    "id": 29861,
    "book": "psalms                                  ",
    "chapter": "101",
    "verse": "2",
    "text": "Io comporrò una maestrevol canzone intorno alla via intiera."
  },
  {
    "id": 29862,
    "book": "psalms                                  ",
    "chapter": "101",
    "verse": "3",
    "text": "Io non mi proporrò davanti agli occhi cosa alcuna scellerata;"
  },
  {
    "id": 29863,
    "book": "psalms                                  ",
    "chapter": "101",
    "verse": "4",
    "text": "Il cuor perverso si dipartirà da me;"
  },
  {
    "id": 29864,
    "book": "psalms                                  ",
    "chapter": "101",
    "verse": "5",
    "text": "Io sterminerò chi sparlerà in segreto contro al suo prossimo;"
  },
  {
    "id": 29865,
    "book": "psalms                                  ",
    "chapter": "101",
    "verse": "6",
    "text": "Io avrò l'occhio sugli uomini leali della terra"
  },
  {
    "id": 29866,
    "book": "psalms                                  ",
    "chapter": "101",
    "verse": "7",
    "text": "Chi usa frode nelle sue opere non abiterà dentro alla mia casa;"
  },
  {
    "id": 29867,
    "book": "psalms                                  ",
    "chapter": "101",
    "verse": "8",
    "text": "Ogni mattina io distruggerò tutti gli empi del paese;"
  }
]