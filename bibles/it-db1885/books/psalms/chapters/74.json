[
  {
    "id": 29395,
    "book": "psalms                                  ",
    "chapter": "74",
    "verse": "1",
    "text": "O DIO, perchè ci hai scacciati in perpetuo?"
  },
  {
    "id": 29396,
    "book": "psalms                                  ",
    "chapter": "74",
    "verse": "2",
    "text": "Ricordati della tua raunanza, la quale tu acquistasti anticamente;"
  },
  {
    "id": 29397,
    "book": "psalms                                  ",
    "chapter": "74",
    "verse": "3",
    "text": "Muovi i passi verso le ruine perpetue74.3 perpetue Is. 61.4.,"
  },
  {
    "id": 29398,
    "book": "psalms                                  ",
    "chapter": "74",
    "verse": "4",
    "text": "I tuoi nemici han ruggito in mezzo del tuo Tempio;"
  },
  {
    "id": 29399,
    "book": "psalms                                  ",
    "chapter": "74",
    "verse": "5",
    "text": "Ciò sarà noto; come chi, levando ad alto delle scuri,"
  },
  {
    "id": 29400,
    "book": "psalms                                  ",
    "chapter": "74",
    "verse": "6",
    "text": "Così ora hanno essi, con iscuri e martelli,"
  },
  {
    "id": 29401,
    "book": "psalms                                  ",
    "chapter": "74",
    "verse": "7",
    "text": "Hanno messi a fuoco e fiamma i tuoi santuari74.7 santuari 2 Re. 25.9.,"
  },
  {
    "id": 29402,
    "book": "psalms                                  ",
    "chapter": "74",
    "verse": "8",
    "text": "Hanno detto nel cuor loro: Prediamoli tutti quanti;"
  },
  {
    "id": 29403,
    "book": "psalms                                  ",
    "chapter": "74",
    "verse": "9",
    "text": "Noi non veggiam più i nostri segni;"
  },
  {
    "id": 29404,
    "book": "psalms                                  ",
    "chapter": "74",
    "verse": "10",
    "text": "Infino a quando, o Dio, oltraggerà l'avversario?"
  },
  {
    "id": 29405,
    "book": "psalms                                  ",
    "chapter": "74",
    "verse": "11",
    "text": "Perchè ritiri la tua mano e la tua destra?"
  },
  {
    "id": 29406,
    "book": "psalms                                  ",
    "chapter": "74",
    "verse": "12",
    "text": "Ora Iddio già ab antico è il mio Re74.12 Re Sal. 44.4.."
  },
  {
    "id": 29407,
    "book": "psalms                                  ",
    "chapter": "74",
    "verse": "13",
    "text": "Tu, colla tua forza, spartisti il mare74.13 mare Esod. 14.21. Is. 51.9,10.;"
  },
  {
    "id": 29408,
    "book": "psalms                                  ",
    "chapter": "74",
    "verse": "14",
    "text": "Tu fiaccasti i capi del leviatan74.14 leviatan Giob. 41.1 e rif.,"
  },
  {
    "id": 29409,
    "book": "psalms                                  ",
    "chapter": "74",
    "verse": "15",
    "text": "Tu facesti scoppiar fonti e torrenti74.15 torrenti Esod. 17.5,6. Num. 20.11.;"
  },
  {
    "id": 29410,
    "book": "psalms                                  ",
    "chapter": "74",
    "verse": "16",
    "text": "Tuo è il giorno, tua eziandio è la notte;"
  },
  {
    "id": 29411,
    "book": "psalms                                  ",
    "chapter": "74",
    "verse": "17",
    "text": "Tu hai posti tutti i termini della terra74.17 terra Fat. 17.26.;"
  },
  {
    "id": 29412,
    "book": "psalms                                  ",
    "chapter": "74",
    "verse": "18",
    "text": "Ricordati di questo: che il nemico ha oltraggiato il Signore74.18 Signore Apoc. 16.19; 18.5.,"
  },
  {
    "id": 29413,
    "book": "psalms                                  ",
    "chapter": "74",
    "verse": "19",
    "text": "Non dare alle fiere la vita della tua tortola;"
  },
  {
    "id": 29414,
    "book": "psalms                                  ",
    "chapter": "74",
    "verse": "20",
    "text": "Riguarda al Patto74.20 Patto Gen. 17.7,8 e rif. Lev. 26.44,45. Sal. 106.45. Ger. 33.20,21.,"
  },
  {
    "id": 29415,
    "book": "psalms                                  ",
    "chapter": "74",
    "verse": "21",
    "text": "Non ritornisene il misero indietro svergognato;"
  },
  {
    "id": 29416,
    "book": "psalms                                  ",
    "chapter": "74",
    "verse": "22",
    "text": "Levati, o Dio, dibatti la tua lite;"
  },
  {
    "id": 29417,
    "book": "psalms                                  ",
    "chapter": "74",
    "verse": "23",
    "text": "Non dimenticar le grida de' tuoi nemici;"
  }
]