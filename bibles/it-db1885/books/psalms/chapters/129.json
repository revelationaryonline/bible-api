[
  {
    "id": 30479,
    "book": "psalms                                  ",
    "chapter": "129",
    "verse": "1",
    "text": "OR dica Israele:"
  },
  {
    "id": 30480,
    "book": "psalms                                  ",
    "chapter": "129",
    "verse": "2",
    "text": "Mi hanno spesse volte assalito dalla mia fanciullezza;"
  },
  {
    "id": 30481,
    "book": "psalms                                  ",
    "chapter": "129",
    "verse": "3",
    "text": "Degli aratori hanno arato sopra il mio dosso;"
  },
  {
    "id": 30482,
    "book": "psalms                                  ",
    "chapter": "129",
    "verse": "4",
    "text": "Il Signore è giusto;"
  },
  {
    "id": 30483,
    "book": "psalms                                  ",
    "chapter": "129",
    "verse": "5",
    "text": "Tutti quelli che odiano Sion"
  },
  {
    "id": 30484,
    "book": "psalms                                  ",
    "chapter": "129",
    "verse": "6",
    "text": "Sieno come l'erba de' tetti,"
  },
  {
    "id": 30485,
    "book": "psalms                                  ",
    "chapter": "129",
    "verse": "7",
    "text": "Della quale il mietitore non empie la sua mano,"
  },
  {
    "id": 30486,
    "book": "psalms                                  ",
    "chapter": "129",
    "verse": "8",
    "text": "Per la quale eziandio i passanti non dicono:"
  }
]