[
  {
    "id": 30177,
    "book": "psalms                                  ",
    "chapter": "115",
    "verse": "1",
    "text": "NON a noi, Signore, non a noi,"
  },
  {
    "id": 30178,
    "book": "psalms                                  ",
    "chapter": "115",
    "verse": "2",
    "text": "Perchè direbbero le genti:"
  },
  {
    "id": 30179,
    "book": "psalms                                  ",
    "chapter": "115",
    "verse": "3",
    "text": "Or l'Iddio nostro è pur ne' cieli"
  },
  {
    "id": 30180,
    "book": "psalms                                  ",
    "chapter": "115",
    "verse": "4",
    "text": "Gl'idoli di quelle sono oro ed argento;"
  },
  {
    "id": 30181,
    "book": "psalms                                  ",
    "chapter": "115",
    "verse": "5",
    "text": "Hanno bocca, e non parlano115.5 parlano Is. 46.6,7. Abac. 2.18,19.;"
  },
  {
    "id": 30182,
    "book": "psalms                                  ",
    "chapter": "115",
    "verse": "6",
    "text": "Hanno orecchie, e non odono;"
  },
  {
    "id": 30183,
    "book": "psalms                                  ",
    "chapter": "115",
    "verse": "7",
    "text": "Hanno mani, e non toccano;"
  },
  {
    "id": 30184,
    "book": "psalms                                  ",
    "chapter": "115",
    "verse": "8",
    "text": "Simili ad essi sieno quelli che li fanno;"
  },
  {
    "id": 30185,
    "book": "psalms                                  ",
    "chapter": "115",
    "verse": "9",
    "text": "O Israele, confidati nel Signore115.9 Signore Sal. 25.2 e rif.;"
  },
  {
    "id": 30186,
    "book": "psalms                                  ",
    "chapter": "115",
    "verse": "10",
    "text": "O casa d'Aaronne, confidatevi, nel Signore;"
  },
  {
    "id": 30187,
    "book": "psalms                                  ",
    "chapter": "115",
    "verse": "11",
    "text": "O voi che temete il Signore, confidatevi in lui;"
  },
  {
    "id": 30188,
    "book": "psalms                                  ",
    "chapter": "115",
    "verse": "12",
    "text": "Il Signore si ricorda di noi; egli ci benedirà;"
  },
  {
    "id": 30189,
    "book": "psalms                                  ",
    "chapter": "115",
    "verse": "13",
    "text": "Egli benedirà quelli che lo temono115.13 temono Sal. 128.1,4.,"
  },
  {
    "id": 30190,
    "book": "psalms                                  ",
    "chapter": "115",
    "verse": "14",
    "text": "Il Signore vi accrescerà le sue grazie,"
  },
  {
    "id": 30191,
    "book": "psalms                                  ",
    "chapter": "115",
    "verse": "15",
    "text": "Voi siete benedetti dal Signore"
  },
  {
    "id": 30192,
    "book": "psalms                                  ",
    "chapter": "115",
    "verse": "16",
    "text": "Quant'è al cielo, il cielo è per lo Signore;"
  },
  {
    "id": 30193,
    "book": "psalms                                  ",
    "chapter": "115",
    "verse": "17",
    "text": "I morti non loderanno già il Signore115.17 Signore Sal. 6.5 e rif.,"
  },
  {
    "id": 30194,
    "book": "psalms                                  ",
    "chapter": "115",
    "verse": "18",
    "text": "Ma noi benediremo il Signore,"
  }
]