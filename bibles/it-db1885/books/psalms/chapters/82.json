    "chapter": "82",
    "verse": "1",
    "text": "IDDIO è presente nella raunanza di Dio;"
  },
  {
    "id": 29581,
    "book": "psalms                                  ",
    "chapter": "82",
    "verse": "2",
    "text": "Infino a quando giudicherete voi ingiustamente,"
  },
  {
    "id": 29582,
    "book": "psalms                                  ",
    "chapter": "82",
    "verse": "3",
    "text": "Fate ragione al misero ed all'orfano;"
  },
  {
    "id": 29583,
    "book": "psalms                                  ",
    "chapter": "82",
    "verse": "4",
    "text": "Liberate il misero ed il bisognoso82.4 bisognoso Giob. 29.12. Prov. 24.11,12.;"
  },
  {
    "id": 29584,
    "book": "psalms                                  ",
    "chapter": "82",
    "verse": "5",
    "text": "Essi non hanno alcun conoscimento, nè senno82.5 senno Ger. 4.22. Mic. 3.1.;"
  },
  {
    "id": 29585,
    "book": "psalms                                  ",
    "chapter": "82",
    "verse": "6",
    "text": "Io ho detto: Voi siete dii82.6 dii Ver. Giov. 10.34.;"
  },
  {
    "id": 29586,
    "book": "psalms                                  ",
    "chapter": "82",
    "verse": "7",
    "text": "Tuttavolta voi morrete come un altro uomo,"
  },
  {
    "id": 29587,
    "book": "psalms                                  ",
    "chapter": "82",
    "verse": "8",
    "text": "Levati, o Dio, giudica la terra;"
