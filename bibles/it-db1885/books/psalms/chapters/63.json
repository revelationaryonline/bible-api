  {
    "id": 29187,
    "book": "psalms                                  ",
    "chapter": "63",
    "verse": "2",
    "text": "Così ti ho io mirato nel santuario,"
  },
  {
    "id": 29188,
    "book": "psalms                                  ",
    "chapter": "63",
    "verse": "3",
    "text": "Perciocchè la tua benignità è cosa buona più che la vita63.3 vita Sal. 30.5.,"
  },
  {
    "id": 29189,
    "book": "psalms                                  ",
    "chapter": "63",
    "verse": "4",
    "text": "Così ti benedirò in vita mia63.4 mia Sal. 104.33; 146.2.;"
  },
  {
    "id": 29190,
    "book": "psalms                                  ",
    "chapter": "63",
    "verse": "5",
    "text": "L'anima mia è saziata come di grasso e di midolla;"
  },
  {
    "id": 29191,
    "book": "psalms                                  ",
    "chapter": "63",
    "verse": "6",
    "text": "Quando io mi ricordo di te sul mio letto."
  },
  {
    "id": 29192,
    "book": "psalms                                  ",
    "chapter": "63",
    "verse": "7",
    "text": "Perciocchè tu mi sei stato in aiuto,"
  },
  {
    "id": 29193,
    "book": "psalms                                  ",
    "chapter": "63",
    "verse": "8",
    "text": "L'anima mia è attaccata dietro a te;"
