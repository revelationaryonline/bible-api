  {
    "id": 30725,
    "book": "psalms                                  ",
    "chapter": "148",
    "verse": "8",
    "text": "Fuoco, e gragnuola; neve, e vapore,"
  },
  {
    "id": 30726,
    "book": "psalms                                  ",
    "chapter": "148",
    "verse": "9",
    "text": "Monti, e colli tutti;"
