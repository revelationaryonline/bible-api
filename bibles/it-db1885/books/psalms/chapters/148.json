  },
  {
    "id": 30723,
    "book": "psalms                                  ",
    "chapter": "148",
    "verse": "6",
    "text": "Ed egli le ha stabilite per sempre ed in perpetuo148.6 perpetuo Sal. 119.90,91. Ger. 31.35,36; 33.25.;"
  },
  {
