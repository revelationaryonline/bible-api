[
  {
    "id": 29440,
    "book": "psalms                                  ",
    "chapter": "77",
    "verse": "1",
    "text": "LA mia voce s'indirizza a Dio, ed io grido;"
  },
  {
    "id": 29441,
    "book": "psalms                                  ",
    "chapter": "77",
    "verse": "2",
    "text": "Nel giorno della mia distretta, io ho cercato il Signore77.2 Signore Sal. 50.15 e rif.;"
  },
  {
    "id": 29442,
    "book": "psalms                                  ",
    "chapter": "77",
    "verse": "3",
    "text": "Io mi ricordo di Dio, e romoreggio;"
  },
  {
    "id": 29443,
    "book": "psalms                                  ",
    "chapter": "77",
    "verse": "4",
    "text": "Tu hai ritenuti gli occhi miei in continue vegghie;"
  },
  {
    "id": 29444,
    "book": "psalms                                  ",
    "chapter": "77",
    "verse": "5",
    "text": "Io ripenso a' giorni antichi,"
  },
  {
    "id": 29445,
    "book": "psalms                                  ",
    "chapter": "77",
    "verse": "6",
    "text": "Io mi ricordo come già io sonava;"
  },
  {
    "id": 29446,
    "book": "psalms                                  ",
    "chapter": "77",
    "verse": "7",
    "text": "Il Signore mi rigetterà egli in perpetuo?"
  },
  {
    "id": 29447,
    "book": "psalms                                  ",
    "chapter": "77",
    "verse": "8",
    "text": "È la sua benignità venuta meno per sempre mai?"
  },
  {
    "id": 29448,
    "book": "psalms                                  ",
    "chapter": "77",
    "verse": "9",
    "text": "Iddio ha egli dimenticato di aver pietà77.9 pietà Is. 49.15.?"
  },
  {
    "id": 29449,
    "book": "psalms                                  ",
    "chapter": "77",
    "verse": "10",
    "text": "Io ho adunque detto: Se io son fiacco,"
  },
  {
    "id": 29450,
    "book": "psalms                                  ",
    "chapter": "77",
    "verse": "11",
    "text": "Io mi rammemoro le opere del Signore;"
  },
  {
    "id": 29451,
    "book": "psalms                                  ",
    "chapter": "77",
    "verse": "12",
    "text": "E medito tutti i tuoi fatti,"
  },
  {
    "id": 29452,
    "book": "psalms                                  ",
    "chapter": "77",
    "verse": "13",
    "text": "O Dio, le tue vie si veggono nel Santuario77.13 Santuario Sal. 73.17.;"
  },
  {
    "id": 29453,
    "book": "psalms                                  ",
    "chapter": "77",
    "verse": "14",
    "text": "Tu sei l'Iddio che fai maraviglie;"
  },
  {
    "id": 29454,
    "book": "psalms                                  ",
    "chapter": "77",
    "verse": "15",
    "text": "Tu hai, col tuo braccio, riscosso il tuo popolo77.15 popolo Esod. 6.6. Deut. 9.29.;"
  },
  {
    "id": 29455,
    "book": "psalms                                  ",
    "chapter": "77",
    "verse": "16",
    "text": "Le acque ti videro, o Dio;"
  },
  {
    "id": 29456,
    "book": "psalms                                  ",
    "chapter": "77",
    "verse": "17",
    "text": "Le nubi versarono diluvi d'acque;"
  },
  {
    "id": 29457,
    "book": "psalms                                  ",
    "chapter": "77",
    "verse": "18",
    "text": "Il suon de' tuoi tuoni fu per lo giro del cielo;"
  },
  {
    "id": 29458,
    "book": "psalms                                  ",
    "chapter": "77",
    "verse": "19",
    "text": "La tua via fu per mezzo il mare,"
  },
  {
    "id": 29459,
    "book": "psalms                                  ",
    "chapter": "77",
    "verse": "20",
    "text": "Tu conducesti il tuo popolo, come una greggia77.20 greggia Esod. 13.21 e rif.,"
  }
]