[
  {
    "id": 29460,
    "book": "psalms                                  ",
    "chapter": "78",
    "verse": "1",
    "text": "ASCOLTA, o popol mio, la mia dottrina;"
  },
  {
    "id": 29461,
    "book": "psalms                                  ",
    "chapter": "78",
    "verse": "2",
    "text": "Io aprirò la mia bocca in sentenza;"
  },
  {
    "id": 29462,
    "book": "psalms                                  ",
    "chapter": "78",
    "verse": "3",
    "text": "Le quali noi abbiamo udite, e sappiamo,"
  },
  {
    "id": 29463,
    "book": "psalms                                  ",
    "chapter": "78",
    "verse": "4",
    "text": "Noi non le celeremo a' lor figliuoli, alla generazione a venire78.4 venire Deut. 4.9; 6.7.;"
  },
  {
    "id": 29464,
    "book": "psalms                                  ",
    "chapter": "78",
    "verse": "5",
    "text": "Egli ha fermata la testimonianza in Giacobbe,"
  },
  {
    "id": 29465,
    "book": "psalms                                  ",
    "chapter": "78",
    "verse": "6",
    "text": "Acciocchè la generazione a venire, i figliuoli che nascerebbero, le sapessero,"
  },
  {
    "id": 29466,
    "book": "psalms                                  ",
    "chapter": "78",
    "verse": "7",
    "text": "E ponessero in Dio la loro speranza,"
  },
  {
    "id": 29467,
    "book": "psalms                                  ",
    "chapter": "78",
    "verse": "8",
    "text": "E non fossero come i lor padri,"
  },
  {
    "id": 29468,
    "book": "psalms                                  ",
    "chapter": "78",
    "verse": "9",
    "text": "I figliuoli di Efraim, gente di guerra, buoni arcieri,"
  },
  {
    "id": 29469,
    "book": "psalms                                  ",
    "chapter": "78",
    "verse": "10",
    "text": "Non avevano osservato il patto di Dio78.10 Dio 2 Re. 17.15.,"
  },
  {
    "id": 29470,
    "book": "psalms                                  ",
    "chapter": "78",
    "verse": "11",
    "text": "Ed avevano dimenticate le sue opere,"
  },
  {
    "id": 29471,
    "book": "psalms                                  ",
    "chapter": "78",
    "verse": "12",
    "text": "Egli aveva fatti miracoli in presenza de' padri loro,"
  },
  {
    "id": 29472,
    "book": "psalms                                  ",
    "chapter": "78",
    "verse": "13",
    "text": "Egli aveva fesso il mare, e li aveva fatti passare per mezzo78.13 mezzo Esod. 14.21 e rif.;"
  },
  {
    "id": 29473,
    "book": "psalms                                  ",
    "chapter": "78",
    "verse": "14",
    "text": "E li aveva condotti di giorno colla nuvola,"
  },
  {
    "id": 29474,
    "book": "psalms                                  ",
    "chapter": "78",
    "verse": "15",
    "text": "Egli aveva schiantate le rupi nel deserto,"
  },
  {
    "id": 29475,
    "book": "psalms                                  ",
    "chapter": "78",
    "verse": "16",
    "text": "Ed aveva fatto uscir de' ruscelli della roccia,"
  },
  {
    "id": 29476,
    "book": "psalms                                  ",
    "chapter": "78",
    "verse": "17",
    "text": "Ma essi continuarono a peccar contro a lui,"
  },
  {
    "id": 29477,
    "book": "psalms                                  ",
    "chapter": "78",
    "verse": "18",
    "text": "E tentarono Iddio nel cuor loro,"
  },
  {
    "id": 29478,
    "book": "psalms                                  ",
    "chapter": "78",
    "verse": "19",
    "text": "E parlarono contro a Dio78.19 Dio Esod. 16.2. Num. 11.4 ecc.,"
  },
  {
    "id": 29479,
    "book": "psalms                                  ",
    "chapter": "78",
    "verse": "20",
    "text": "Ecco, egli percosse la roccia, e ne colarono acque,"
  },
  {
    "id": 29480,
    "book": "psalms                                  ",
    "chapter": "78",
    "verse": "21",
    "text": "Perciò, il Signore, avendoli uditi, si adirò fieramente78.21 fieramente Num. 11.1,10.;"
  },
  {
    "id": 29481,
    "book": "psalms                                  ",
    "chapter": "78",
    "verse": "22",
    "text": "Perciocchè non avevano creduto in Dio78.22 Dio Ebr. 3.18. Giuda 5.,"
  },
  {
    "id": 29482,
    "book": "psalms                                  ",
    "chapter": "78",
    "verse": "23",
    "text": "E pure egli aveva comandato alle nuvole di sopra,"
  },
  {
    "id": 29483,
    "book": "psalms                                  ",
    "chapter": "78",
    "verse": "24",
    "text": "Ed aveva fatta piovere sopra loro la manna da mangiare,"
  },
  {
    "id": 29484,
    "book": "psalms                                  ",
    "chapter": "78",
    "verse": "25",
    "text": "L'uomo mangiò del pane degli Angeli;"
  },
  {
    "id": 29485,
    "book": "psalms                                  ",
    "chapter": "78",
    "verse": "26",
    "text": "Egli fece levar nel cielo il vento orientale,"
  },
  {
    "id": 29486,
    "book": "psalms                                  ",
    "chapter": "78",
    "verse": "27",
    "text": "E fece piover sopra loro della carne, a guisa di polvere;"
  },
  {
    "id": 29487,
    "book": "psalms                                  ",
    "chapter": "78",
    "verse": "28",
    "text": "E li fece cadere in mezzo al lor campo,"
  },
  {
    "id": 29488,
    "book": "psalms                                  ",
    "chapter": "78",
    "verse": "29",
    "text": "Ed essi mangiarono, e furono grandemente satollati;"
  },
  {
    "id": 29489,
    "book": "psalms                                  ",
    "chapter": "78",
    "verse": "30",
    "text": "Essi non si erano ancora stolti dalla lor cupidigia;"
  },
  {
    "id": 29490,
    "book": "psalms                                  ",
    "chapter": "78",
    "verse": "31",
    "text": "Quando l'ira montò a Dio contro a loro,"
  },
  {
    "id": 29491,
    "book": "psalms                                  ",
    "chapter": "78",
    "verse": "32",
    "text": "Con tutto ciò peccarono ancora78.32 ancora Num. cap. 14,16,17.,"
  },
  {
    "id": 29492,
    "book": "psalms                                  ",
    "chapter": "78",
    "verse": "33",
    "text": "Laonde egli consumò i lor giorni in vanità,"
  },
  {
    "id": 29493,
    "book": "psalms                                  ",
    "chapter": "78",
    "verse": "34",
    "text": "Quando egli li uccideva, essi lo richiedevano,"
  },
  {
    "id": 29494,
    "book": "psalms                                  ",
    "chapter": "78",
    "verse": "35",
    "text": "E si ricordavano che Iddio era la lor Rocca78.35 Rocca Deut. 32.4 e rif.,"
  },
  {
    "id": 29495,
    "book": "psalms                                  ",
    "chapter": "78",
    "verse": "36",
    "text": "Ma lo lusingavano colla lor bocca78.36 bocca Ezec. 33.31.,"
  },
  {
    "id": 29496,
    "book": "psalms                                  ",
    "chapter": "78",
    "verse": "37",
    "text": "E il cuor loro non era diritto inverso lui,"
  },
  {
    "id": 29497,
    "book": "psalms                                  ",
    "chapter": "78",
    "verse": "38",
    "text": "E pure egli, che è pietoso78.38 pietoso Num. 14.18,20. Is. 48.9., purgò la loro iniquità, e non li distrusse;"
  },
  {
    "id": 29498,
    "book": "psalms                                  ",
    "chapter": "78",
    "verse": "39",
    "text": "E si ricordò ch'erano carne78.39 carne Sal. 103.14-16.;"
  },
  {
    "id": 29499,
    "book": "psalms                                  ",
    "chapter": "78",
    "verse": "40",
    "text": "Quante volte lo provocarono essi a sdegno nel deserto,"
  },
  {
    "id": 29500,
    "book": "psalms                                  ",
    "chapter": "78",
    "verse": "41",
    "text": "E tornarono a tentare Iddio78.41 Iddio Num. 14.22.,"
  },
  {
    "id": 29501,
    "book": "psalms                                  ",
    "chapter": "78",
    "verse": "42",
    "text": "Essi non si erano ricordati della sua mano,"
  },
  {
    "id": 29502,
    "book": "psalms                                  ",
    "chapter": "78",
    "verse": "43",
    "text": "(Come egli aveva eseguiti i suoi segni in Egitto,"
  },
  {
    "id": 29503,
    "book": "psalms                                  ",
    "chapter": "78",
    "verse": "44",
    "text": "Ed aveva cangiati i fiumi, e i rivi degli Egizi in sangue78.44 sangue Esod. 7.20.,"
  },
  {
    "id": 29504,
    "book": "psalms                                  ",
    "chapter": "78",
    "verse": "45",
    "text": "Ed aveva mandata contro a loro una mischia d'insetti che li mangiarono;"
  },
  {
    "id": 29505,
    "book": "psalms                                  ",
    "chapter": "78",
    "verse": "46",
    "text": "Ed aveva dati i lor frutti a' bruchi,"
  },
  {
    "id": 29506,
    "book": "psalms                                  ",
    "chapter": "78",
    "verse": "47",
    "text": "Ed aveva guastate le lor vigne colla gragnuola78.47 gragnuola Esod. 9.23-25.,"
  },
  {
    "id": 29507,
    "book": "psalms                                  ",
    "chapter": "78",
    "verse": "48",
    "text": "Ed aveva dati alla grandine i lor bestiami,"
  },
  {
    "id": 29508,
    "book": "psalms                                  ",
    "chapter": "78",
    "verse": "49",
    "text": "Ed aveva mandato sopra loro l'ardore della sua ira,"
  },
  {
    "id": 29509,
    "book": "psalms                                  ",
    "chapter": "78",
    "verse": "50",
    "text": "Ed aveva appianato il sentiero alla sua ira,"
  },
  {
    "id": 29510,
    "book": "psalms                                  ",
    "chapter": "78",
    "verse": "51",
    "text": "Ed aveva percossi tutti i primogeniti in Egitto78.51 Egitto Esod. 12.29.,"
  },
  {
    "id": 29511,
    "book": "psalms                                  ",
    "chapter": "78",
    "verse": "52",
    "text": "E ne aveva fatto partire il suo popolo, a guisa di pecore;"
  },
  {
    "id": 29512,
    "book": "psalms                                  ",
    "chapter": "78",
    "verse": "53",
    "text": "E l'aveva guidato sicuramente, senza spavento78.53 spavento Esod. 14.19,20.;"
  },
  {
    "id": 29513,
    "book": "psalms                                  ",
    "chapter": "78",
    "verse": "54",
    "text": "Ed egli li aveva introdotti nella contrada della sua santità,"
  },
  {
    "id": 29514,
    "book": "psalms                                  ",
    "chapter": "78",
    "verse": "55",
    "text": "Ed aveva scacciate le nazioni d'innanzi a loro,"
  },
  {
    "id": 29515,
    "book": "psalms                                  ",
    "chapter": "78",
    "verse": "56",
    "text": "Ed avevano tentato, e provocato a sdegno l'Iddio altissimo,"
  },
  {
    "id": 29516,
    "book": "psalms                                  ",
    "chapter": "78",
    "verse": "57",
    "text": "Anzi si erano tratti indietro,"
  },
  {
    "id": 29517,
    "book": "psalms                                  ",
    "chapter": "78",
    "verse": "58",
    "text": "E l'avevano provocato ad ira co' loro alti luoghi78.58 luoghi Deut. 12.2 e rif.,"
  },
  {
    "id": 29518,
    "book": "psalms                                  ",
    "chapter": "78",
    "verse": "59",
    "text": "Iddio aveva udite queste cose, e se n'era gravemente adirato,"
  },
  {
    "id": 29519,
    "book": "psalms                                  ",
    "chapter": "78",
    "verse": "60",
    "text": "Ed aveva abbandonato il tabernacolo di Silo78.60 Silo 1 Sam. 4.11. Ger. 7.12,14.;"
  },
  {
    "id": 29520,
    "book": "psalms                                  ",
    "chapter": "78",
    "verse": "61",
    "text": "Ed aveva abbandonata la sua forza, ad esser menata in cattività,"
  },
  {
    "id": 29521,
    "book": "psalms                                  ",
    "chapter": "78",
    "verse": "62",
    "text": "Ed aveva dato il suo popolo alla spada78.62 spada 1 Sam. 4.10.,"
  },
  {
    "id": 29522,
    "book": "psalms                                  ",
    "chapter": "78",
    "verse": "63",
    "text": "Il fuoco aveva consumati i suoi giovani;"
  },
  {
    "id": 29523,
    "book": "psalms                                  ",
    "chapter": "78",
    "verse": "64",
    "text": "I suoi sacerdoti erano caduti per la spada78.64 spada 1 Sam. 4.11; 22.18.;"
  },
  {
    "id": 29524,
    "book": "psalms                                  ",
    "chapter": "78",
    "verse": "65",
    "text": "Poi il Signore si risvegliò,"
  },
  {
    "id": 29525,
    "book": "psalms                                  ",
    "chapter": "78",
    "verse": "66",
    "text": "E percosse i suoi nemici da tergo,"
  },
  {
    "id": 29526,
    "book": "psalms                                  ",
    "chapter": "78",
    "verse": "67",
    "text": "Ed avendo riprovato il tabernacolo di Giuseppe,"
  },
  {
    "id": 29527,
    "book": "psalms                                  ",
    "chapter": "78",
    "verse": "68",
    "text": "Egli elesse la tribù di Giuda;"
  },
  {
    "id": 29528,
    "book": "psalms                                  ",
    "chapter": "78",
    "verse": "69",
    "text": "Ed edificò il suo santuario78.69 santuario 1 Re. cap. 6, a guisa di palazzi eccelsi;"
  },
  {
    "id": 29529,
    "book": "psalms                                  ",
    "chapter": "78",
    "verse": "70",
    "text": "Ed elesse Davide, suo servitore,"
  },
  {
    "id": 29530,
    "book": "psalms                                  ",
    "chapter": "78",
    "verse": "71",
    "text": "Di dietro alle bestie allattanti"
  },
  {
    "id": 29531,
    "book": "psalms                                  ",
    "chapter": "78",
    "verse": "72",
    "text": "Ed egli li pasturò, secondo l'integrità del suo cuore78.72 cuore 1 Re. 9.4.;"
  }
]