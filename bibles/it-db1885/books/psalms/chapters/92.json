[
  {
    "id": 29758,
    "book": "psalms                                  ",
    "chapter": "92",
    "verse": "1",
    "text": "EGLI è una bella cosa di celebrare il Signore,"
  },
  {
    "id": 29759,
    "book": "psalms                                  ",
    "chapter": "92",
    "verse": "2",
    "text": "Di predicare per ogni mattina la tua benignità,"
  },
  {
    "id": 29760,
    "book": "psalms                                  ",
    "chapter": "92",
    "verse": "3",
    "text": "In sul decacordo, e in sul saltero;"
  },
  {
    "id": 29761,
    "book": "psalms                                  ",
    "chapter": "92",
    "verse": "4",
    "text": "Perciocchè, o Signore, tu mi hai rallegrato colle tue opere92.4 opere Sal. 111.2. Apoc. 15.3.;"
  },
  {
    "id": 29762,
    "book": "psalms                                  ",
    "chapter": "92",
    "verse": "5",
    "text": "Quanto son grandi, o Signore, le tue opere92.5 opere Giob. cap. 38-41. Sal. 40.5.!"
  },
  {
    "id": 29763,
    "book": "psalms                                  ",
    "chapter": "92",
    "verse": "6",
    "text": "L'uomo stolto non conosce,"
  },
  {
    "id": 29764,
    "book": "psalms                                  ",
    "chapter": "92",
    "verse": "7",
    "text": "Che gli empi germogliano come l'erba,"
  },
  {
    "id": 29765,
    "book": "psalms                                  ",
    "chapter": "92",
    "verse": "8",
    "text": "Ma tu, o Signore,"
  },
  {
    "id": 29766,
    "book": "psalms                                  ",
    "chapter": "92",
    "verse": "9",
    "text": "Perciocchè, ecco, i tuoi nemici, o Signore;"
  },
  {
    "id": 29767,
    "book": "psalms                                  ",
    "chapter": "92",
    "verse": "10",
    "text": "Ma tu alzerai il mio corno, come quello di un liocorno;"
  },
  {
    "id": 29768,
    "book": "psalms                                  ",
    "chapter": "92",
    "verse": "11",
    "text": "E l'occhio mio riguarderà i miei nemici;"
  },
  {
    "id": 29769,
    "book": "psalms                                  ",
    "chapter": "92",
    "verse": "12",
    "text": "Il giusto fiorirà come la palma,"
  },
  {
    "id": 29770,
    "book": "psalms                                  ",
    "chapter": "92",
    "verse": "13",
    "text": "Quelli che saran piantati nella Casa del Signore"
  },
  {
    "id": 29771,
    "book": "psalms                                  ",
    "chapter": "92",
    "verse": "14",
    "text": "Nell'estrema vecchiezza ancor frutteranno,"
  },
  {
    "id": 29772,
    "book": "psalms                                  ",
    "chapter": "92",
    "verse": "15",
    "text": "Per predicare che il Signore, la mia Rocca92.15 Rocca Deut. 32.4 e rif., è diritto;"
  }
]