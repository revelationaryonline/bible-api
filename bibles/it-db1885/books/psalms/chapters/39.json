[
  {
    "id": 28859,
    "book": "psalms                                  ",
    "chapter": "39",
    "verse": "1",
    "text": "IO aveva detto: Io prenderò guardia alle mie vie,"
  },
  {
    "id": 28860,
    "book": "psalms                                  ",
    "chapter": "39",
    "verse": "2",
    "text": "Io sono stato mutolo e cheto;"
  },
  {
    "id": 28861,
    "book": "psalms                                  ",
    "chapter": "39",
    "verse": "3",
    "text": "Il mio cuore si è riscaldato dentro di me39.3 me Ger. 20.9. Luc. 24.32.;"
  },
  {
    "id": 28862,
    "book": "psalms                                  ",
    "chapter": "39",
    "verse": "4",
    "text": "O Signore, fammi conoscere il mio fine,"
  },
  {
    "id": 28863,
    "book": "psalms                                  ",
    "chapter": "39",
    "verse": "5",
    "text": "Ecco tu hai ridotti i miei dì alla misura di un palmo,"
  },
  {
    "id": 28864,
    "book": "psalms                                  ",
    "chapter": "39",
    "verse": "6",
    "text": "Certo l'uomo va e viene in figura39.6 figura 1 Cor. 7.31. Giac. 4.14.;"
  },
  {
    "id": 28865,
    "book": "psalms                                  ",
    "chapter": "39",
    "verse": "7",
    "text": "Ma ora, Signore, che aspetto io?"
  },
  {
    "id": 28866,
    "book": "psalms                                  ",
    "chapter": "39",
    "verse": "8",
    "text": "Liberami da tutti i miei misfatti;"
  },
  {
    "id": 28867,
    "book": "psalms                                  ",
    "chapter": "39",
    "verse": "9",
    "text": "Io ammutolisco, io non aprirò la bocca39.9 bocca Lev. 10.3. Giob. 39.36-38.;"
  },
  {
    "id": 28868,
    "book": "psalms                                  ",
    "chapter": "39",
    "verse": "10",
    "text": "Toglimi d'addosso la tua piaga;"
  },
  {
    "id": 28869,
    "book": "psalms                                  ",
    "chapter": "39",
    "verse": "11",
    "text": "Se tu castighi alcuno con castigamenti d'iniquità,"
  },
  {
    "id": 28870,
    "book": "psalms                                  ",
    "chapter": "39",
    "verse": "12",
    "text": "Signore, ascolta la mia orazione, e porgi l'orecchio al mio grido,"
  },
  {
    "id": 28871,
    "book": "psalms                                  ",
    "chapter": "39",
    "verse": "13",
    "text": "Cessati da me, acciocchè io mi rinforzi,"
  }
