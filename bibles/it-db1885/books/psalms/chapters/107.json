[
  {
    "id": 30046,
    "book": "psalms                                  ",
    "chapter": "107",
    "verse": "1",
    "text": "CELEBRATE il Signore107.1 Signore Sal. 106.1 e rif.; perciocchè egli è buono107.1 buono Sal. 119.68. Mat. 19.17.."
  },
  {
    "id": 30047,
    "book": "psalms                                  ",
    "chapter": "107",
    "verse": "2",
    "text": "Così dicano quelli che sono stati riscattati dal Signore,"
  },
  {
    "id": 30048,
    "book": "psalms                                  ",
    "chapter": "107",
    "verse": "3",
    "text": "E li ha raccolti da' diversi paesi107.3 paesi Is. 43.5,6. Ger. 29.14; 31.10. Ezec. 39.27,28.,"
  },
  {
    "id": 30049,
    "book": "psalms                                  ",
    "chapter": "107",
    "verse": "4",
    "text": "Essi andavano errando per deserti, per cammini di solitudine;"
  },
  {
    "id": 30050,
    "book": "psalms                                  ",
    "chapter": "107",
    "verse": "5",
    "text": "Erano affamati ed assetati;"
  },
  {
    "id": 30051,
    "book": "psalms                                  ",
    "chapter": "107",
    "verse": "6",
    "text": "Ma, avendo gridato al Signore, mentre erano in distretta107.6 distretta Sal. 50.15 e rif. Os. 5.15.,"
  },
  {
    "id": 30052,
    "book": "psalms                                  ",
    "chapter": "107",
    "verse": "7",
    "text": "E li ha condotti per diritto cammino,"
  },
  {
    "id": 30053,
    "book": "psalms                                  ",
    "chapter": "107",
    "verse": "8",
    "text": "Celebrino adunque appo il Signore la sua benignità,"
  },
  {
    "id": 30054,
    "book": "psalms                                  ",
    "chapter": "107",
    "verse": "9",
    "text": "Perciocchè egli ha saziata l'anima assetata107.9 assetata Sal. 34.10. Luc. 1.53.,"
  },
  {
    "id": 30055,
    "book": "psalms                                  ",
    "chapter": "107",
    "verse": "10",
    "text": "Così dicano quelli che dimoravano in tenebre ed in ombra di morte107.10 morte Is. 42.7; 49.9. Luc. 1.79.,"
  },
  {
    "id": 30056,
    "book": "psalms                                  ",
    "chapter": "107",
    "verse": "11",
    "text": "Perciocchè erano stati ribelli alle parole del Signore107.11 Signore Deut. 1.26. Sal. 106.7,43.,"
  },
  {
    "id": 30057,
    "book": "psalms                                  ",
    "chapter": "107",
    "verse": "12",
    "text": "Onde egli aveva abbattuto il cuor loro con affanni,"
  },
  {
    "id": 30058,
    "book": "psalms                                  ",
    "chapter": "107",
    "verse": "13",
    "text": "Ma, avendo gridato al Signore, mentre erano in distretta,"
  },
  {
    "id": 30059,
    "book": "psalms                                  ",
    "chapter": "107",
    "verse": "14",
    "text": "E li ha tratti fuor delle tenebre, e dell'ombra della morte107.14 morte Fat. 12.7 ecc.; 16.26 ecc.;"
  },
  {
    "id": 30060,
    "book": "psalms                                  ",
    "chapter": "107",
    "verse": "15",
    "text": "Celebrino adunque appo il Signore la sua benignità,"
  },
  {
    "id": 30061,
    "book": "psalms                                  ",
    "chapter": "107",
    "verse": "16",
    "text": "Perciocchè egli ha rotte le porte di rame,"
  },
  {
    "id": 30062,
    "book": "psalms                                  ",
    "chapter": "107",
    "verse": "17",
    "text": "Così dicano gli stolti, ch'erano afflitti per li lor misfatti,"
  },
  {
    "id": 30063,
    "book": "psalms                                  ",
    "chapter": "107",
    "verse": "18",
    "text": "La cui anima abbominava ogni cibo;"
  },
  {
    "id": 30064,
    "book": "psalms                                  ",
    "chapter": "107",
    "verse": "19",
    "text": "Ma, avendo gridato al Signore, mentre erano in distretta,"
  },
  {
    "id": 30065,
    "book": "psalms                                  ",
    "chapter": "107",
    "verse": "20",
    "text": "Egli ha mandata la sua parola, e li ha sanati107.20 sanati 2 Re. 20.4,5. Mat. 8.8.,"
  },
  {
    "id": 30066,
    "book": "psalms                                  ",
    "chapter": "107",
    "verse": "21",
    "text": "Celebrino adunque appo il Signore la sua benignità,"
  },
  {
    "id": 30067,
    "book": "psalms                                  ",
    "chapter": "107",
    "verse": "22",
    "text": "E sacrifichino sacrificii di lode107.22 lode Lev. 7.12. Ebr. 13.15.,"
  },
  {
    "id": 30068,
    "book": "psalms                                  ",
    "chapter": "107",
    "verse": "23",
    "text": "Così dicano quelli che scendono nel mare sopra navi,"
  },
  {
    "id": 30069,
    "book": "psalms                                  ",
    "chapter": "107",
    "verse": "24",
    "text": "Essi veggono le opere del Signore,"
  },
  {
    "id": 30070,
    "book": "psalms                                  ",
    "chapter": "107",
    "verse": "25",
    "text": "Perciocchè, alla sua parola, egli fa levare il vento di tempesta107.25 tempesta Sal. 148.8. Gion. 1.4.,"
  },
  {
    "id": 30071,
    "book": "psalms                                  ",
    "chapter": "107",
    "verse": "26",
    "text": "Salgono al cielo, poi scendono agli abissi;"
  },
  {
    "id": 30072,
    "book": "psalms                                  ",
    "chapter": "107",
    "verse": "27",
    "text": "Saltano, e traballano come un ebbro;"
  },
  {
    "id": 30073,
    "book": "psalms                                  ",
    "chapter": "107",
    "verse": "28",
    "text": "Ma, gridando al Signore, mentre sono in distretta,"
  },
  {
    "id": 30074,
    "book": "psalms                                  ",
    "chapter": "107",
    "verse": "29",
    "text": "Egli acqueta la tempesta,"
  },
  {
    "id": 30075,
    "book": "psalms                                  ",
    "chapter": "107",
    "verse": "30",
    "text": "Ed essi si rallegrano che sono acquetate;"
  },
  {
    "id": 30076,
    "book": "psalms                                  ",
    "chapter": "107",
    "verse": "31",
    "text": "Celebrino adunque appo il Signore la sua benignità,"
  },
  {
    "id": 30077,
    "book": "psalms                                  ",
    "chapter": "107",
    "verse": "32",
    "text": "Ed esaltinlo nella raunanza del popolo,"
  },
  {
    "id": 30078,
    "book": "psalms                                  ",
    "chapter": "107",
    "verse": "33",
    "text": "Egli riduce i fiumi in deserto107.33 deserto 1 Re. 17.1,7.,"
  },
  {
    "id": 30079,
    "book": "psalms                                  ",
    "chapter": "107",
    "verse": "34",
    "text": "La terra fertile in salsuggine,"
  },
  {
    "id": 30080,
    "book": "psalms                                  ",
    "chapter": "107",
    "verse": "35",
    "text": "Egli riduce i deserti in guazzi d'acque."
  },
  {
    "id": 30081,
    "book": "psalms                                  ",
    "chapter": "107",
    "verse": "36",
    "text": "E fa quivi abitar gli affamati,"
  },
  {
    "id": 30082,
    "book": "psalms                                  ",
    "chapter": "107",
    "verse": "37",
    "text": "E seminano campi, e piantano vigne,"
  },
  {
    "id": 30083,
    "book": "psalms                                  ",
    "chapter": "107",
    "verse": "38",
    "text": "Ed egli li benedice, e moltiplicano grandemente;"
  },
  {
    "id": 30084,
    "book": "psalms                                  ",
    "chapter": "107",
    "verse": "39",
    "text": "Poi vengono al meno, e sono abbassati"
  },
  {
    "id": 30085,
    "book": "psalms                                  ",
    "chapter": "107",
    "verse": "40",
    "text": "Egli spande lo sprezzo sopra i nobili,"
  },
  {
    "id": 30086,
    "book": "psalms                                  ",
    "chapter": "107",
    "verse": "41",
    "text": "E innalza il bisognoso dalla miseria107.41 miseria 1 Sam. 2.8. Sal. 113.7,8.,"
  },
  {
    "id": 30087,
    "book": "psalms                                  ",
    "chapter": "107",
    "verse": "42",
    "text": "Gli uomini diritti, veggendo queste cose, si rallegrano;"
  },
  {
    "id": 30088,
    "book": "psalms                                  ",
    "chapter": "107",
    "verse": "43",
    "text": "Chi è savio? osservi queste cose,"
  }
]