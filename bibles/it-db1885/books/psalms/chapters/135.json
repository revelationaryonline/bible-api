[
  {
    "id": 30522,
    "book": "psalms                                  ",
    "chapter": "135",
    "verse": "1",
    "text": "ALLELUIA."
  },
  {
    "id": 30523,
    "book": "psalms                                  ",
    "chapter": "135",
    "verse": "2",
    "text": "Che state nella Casa del Signore135.2 Signore Luc. 2.37.,"
  },
  {
    "id": 30524,
    "book": "psalms                                  ",
    "chapter": "135",
    "verse": "3",
    "text": "Lodate il Signore; perciocchè il Signore è buono;"
  },
  {
    "id": 30525,
    "book": "psalms                                  ",
    "chapter": "135",
    "verse": "4",
    "text": "Conciossiachè il Signore si abbia eletto Giacobbe"
  },
  {
    "id": 30526,
    "book": "psalms                                  ",
    "chapter": "135",
    "verse": "5",
    "text": "Certo io conosco che il Signore è grande,"
  },
  {
    "id": 30527,
    "book": "psalms                                  ",
    "chapter": "135",
    "verse": "6",
    "text": "Il Signore fa tutto ciò che gli piace"
  },
  {
    "id": 30528,
    "book": "psalms                                  ",
    "chapter": "135",
    "verse": "7",
    "text": "Egli fa salire i vapori dall'estremità dalle terra;"
  },
  {
    "id": 30529,
    "book": "psalms                                  ",
    "chapter": "135",
    "verse": "8",
    "text": "Egli è quel che percosse i primogeniti di Egitto135.8 Egitto Esod. 12.12,29.,"
  },
  {
    "id": 30530,
    "book": "psalms                                  ",
    "chapter": "135",
    "verse": "9",
    "text": "Che mandò segni e prodigi, in mezzo di te, o Egitto135.9 Egitto Esod. cap. 7-14.;"
  },
  {
    "id": 30531,
    "book": "psalms                                  ",
    "chapter": "135",
    "verse": "10",
    "text": "Che percosse nazioni grandi,"
  },
  {
    "id": 30532,
    "book": "psalms                                  ",
    "chapter": "135",
    "verse": "11",
    "text": "Sihon, re degli Amorrei,"
  },
  {
    "id": 30533,
    "book": "psalms                                  ",
    "chapter": "135",
    "verse": "12",
    "text": "E diede i lor paesi per eredità,"
  },
  {
    "id": 30534,
    "book": "psalms                                  ",
    "chapter": "135",
    "verse": "13",
    "text": "O Signore, il tuo Nome è in eterno135.13 eterno Esod. 3.15. Sal. 102.12.;"
  },
  {
    "id": 30535,
    "book": "psalms                                  ",
    "chapter": "135",
    "verse": "14",
    "text": "Quando il Signore avrà fatti i suoi giudicii sopra il suo popolo,"
  },
  {
    "id": 30536,
    "book": "psalms                                  ",
    "chapter": "135",
    "verse": "15",
    "text": "Gl'idoli delle genti135.15 genti Sal. 115.4-8 e rif. sono argento ed oro,"
  },
  {
    "id": 30537,
    "book": "psalms                                  ",
    "chapter": "135",
    "verse": "16",
    "text": "Hanno bocca, e non parlano;"
  },
  {
    "id": 30538,
    "book": "psalms                                  ",
    "chapter": "135",
    "verse": "17",
    "text": "Hanno orecchi, e non odono;"
  },
  {
    "id": 30539,
    "book": "psalms                                  ",
    "chapter": "135",
    "verse": "18",
    "text": "Simili ad essi sieno quelli che li fanno;"
  },
  {
    "id": 30540,
    "book": "psalms                                  ",
    "chapter": "135",
    "verse": "19",
    "text": "Casa d'Israele, benedite il Signore135.19 Signore Sal. 115.9 ecc.;"
  },
  {
    "id": 30541,
    "book": "psalms                                  ",
    "chapter": "135",
    "verse": "20",
    "text": "Casa di Levi, benedite il Signore;"
  },
  {
    "id": 30542,
    "book": "psalms                                  ",
    "chapter": "135",
    "verse": "21",
    "text": "Benedetto sia da Sion il Signore,"
  }
]