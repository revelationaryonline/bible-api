[
  {
    "id": 29918,
    "book": "psalms                                  ",
    "chapter": "104",
    "verse": "1",
    "text": "BENEDICI, anima mia, il Signore104.1 Signore Sal. 103.1 e rif.;"
  },
  {
    "id": 29919,
    "book": "psalms                                  ",
    "chapter": "104",
    "verse": "2",
    "text": "Egli si ammanta di luce come di una vesta;"
  },
  {
    "id": 29920,
    "book": "psalms                                  ",
    "chapter": "104",
    "verse": "3",
    "text": "Egli fa i palchi delle sue sale nelle acque;"
  },
  {
    "id": 29921,
    "book": "psalms                                  ",
    "chapter": "104",
    "verse": "4",
    "text": "Egli fa i venti suoi Angeli,"
  },
  {
    "id": 29922,
    "book": "psalms                                  ",
    "chapter": "104",
    "verse": "5",
    "text": "Egli ha fondata la terra sulle sue basi104.5 basi Giob. 26.7. Sal. 24.2.;"
  },
  {
    "id": 29923,
    "book": "psalms                                  ",
    "chapter": "104",
    "verse": "6",
    "text": "Tu l'avevi già coperta dell'abisso, come d'una vesta;"
  },
  {
    "id": 29924,
    "book": "psalms                                  ",
    "chapter": "104",
    "verse": "7",
    "text": "Esse fuggirono per lo tuo sgridare;"
  },
  {
    "id": 29925,
    "book": "psalms                                  ",
    "chapter": "104",
    "verse": "8",
    "text": "Erano salite sopra i monti; ma discesero nelle valli104.8 valli Gen. 8.5.,"
  },
  {
    "id": 29926,
    "book": "psalms                                  ",
    "chapter": "104",
    "verse": "9",
    "text": "Tu hai loro posto un termine, il qual non trapasseranno104.9 trapasseranno Giob. 26.10; 38.10,11. Ger. 5.22.;"
  },
  {
    "id": 29927,
    "book": "psalms                                  ",
    "chapter": "104",
    "verse": "10",
    "text": "Egli è quel che manda le fonti per le valli,"
  },
  {
    "id": 29928,
    "book": "psalms                                  ",
    "chapter": "104",
    "verse": "11",
    "text": "Abbeverano tutte le bestie della campagna;"
  },
  {
    "id": 29929,
    "book": "psalms                                  ",
    "chapter": "104",
    "verse": "12",
    "text": "Presso a quelle si riparano gli uccelli del cielo;"
  },
  {
    "id": 29930,
    "book": "psalms                                  ",
    "chapter": "104",
    "verse": "13",
    "text": "Egli adacqua i monti dalle sue stanze sovrane104.13 sovrane Sal. 65.9,10; 147.8.;"
  },
  {
    "id": 29931,
    "book": "psalms                                  ",
    "chapter": "104",
    "verse": "14",
    "text": "Egli fa germogliar l'erba per le bestie104.14 bestie Gen. 1.29,30.;"
  },
  {
    "id": 29932,
    "book": "psalms                                  ",
    "chapter": "104",
    "verse": "15",
    "text": "Egli rallegra il cuor dell'uomo col vino104.15 vino Giud. 9.13. Prov. 13.6,7.,"
  },
  {
    "id": 29933,
    "book": "psalms                                  ",
    "chapter": "104",
    "verse": "16",
    "text": "Gli alberi del Signore ne son saziati;"
  },
  {
    "id": 29934,
    "book": "psalms                                  ",
    "chapter": "104",
    "verse": "17",
    "text": "Dove gli uccelli si annidano;"
  },
  {
    "id": 29935,
    "book": "psalms                                  ",
    "chapter": "104",
    "verse": "18",
    "text": "Gli alti monti sono per li cavriuoli;"
  },
  {
    "id": 29936,
    "book": "psalms                                  ",
    "chapter": "104",
    "verse": "19",
    "text": "Egli ha fatta la luna per le stagioni104.19 stagioni Gen. 1.14.;"
  },
  {
    "id": 29937,
    "book": "psalms                                  ",
    "chapter": "104",
    "verse": "20",
    "text": "Tu mandi le tenebre104.20 tenebre Is. 45.7., ed e' si fa notte,"
  },
  {
    "id": 29938,
    "book": "psalms                                  ",
    "chapter": "104",
    "verse": "21",
    "text": "I leoncelli rugghiano dietro alla preda,"
  },
  {
    "id": 29939,
    "book": "psalms                                  ",
    "chapter": "104",
    "verse": "22",
    "text": "Ma, tosto ch'è levato il sole, si raccolgono,"
  },
  {
    "id": 29940,
    "book": "psalms                                  ",
    "chapter": "104",
    "verse": "23",
    "text": "Allora l'uomo esce alla sua opera,"
  },
  {
    "id": 29941,
    "book": "psalms                                  ",
    "chapter": "104",
    "verse": "24",
    "text": "Quanto grandi sono, o Signore, le tue opere!"
  },
  {
    "id": 29942,
    "book": "psalms                                  ",
    "chapter": "104",
    "verse": "25",
    "text": "Ecco, il mar grande ed ampio:"
  },
  {
    "id": 29943,
    "book": "psalms                                  ",
    "chapter": "104",
    "verse": "26",
    "text": "Quivi nuotano le navi,"
  },
  {
    "id": 29944,
    "book": "psalms                                  ",
    "chapter": "104",
    "verse": "27",
    "text": "Tutti gli animali sperano in te,"
  },
  {
    "id": 29945,
    "book": "psalms                                  ",
    "chapter": "104",
    "verse": "28",
    "text": "Se tu lo dài loro, lo ricolgono;"
  },
  {
    "id": 29946,
    "book": "psalms                                  ",
    "chapter": "104",
    "verse": "29",
    "text": "Se tu nascondi la tua faccia, sono smarriti;"
  },
  {
    "id": 29947,
    "book": "psalms                                  ",
    "chapter": "104",
    "verse": "30",
    "text": "Se tu rimandi il tuo spirito son creati104.30 creati Is. 32.15. Ezec. 37.9 ecc.;"
  },
  {
    "id": 29948,
    "book": "psalms                                  ",
    "chapter": "104",
    "verse": "31",
    "text": "Sia la gloria del Signore in eterno;"
  },
  {
    "id": 29949,
    "book": "psalms                                  ",
    "chapter": "104",
    "verse": "32",
    "text": "Il quale se riguarda verso la terra, ella trema;"
  },
  {
    "id": 29950,
    "book": "psalms                                  ",
    "chapter": "104",
    "verse": "33",
    "text": "Io canterò al Signore, mentre viverò;"
  },
  {
    "id": 29951,
    "book": "psalms                                  ",
    "chapter": "104",
    "verse": "34",
    "text": "Il mio ragionamento gli sarà piacevole,"
  },
  {
    "id": 29952,
    "book": "psalms                                  ",
    "chapter": "104",
    "verse": "35",
    "text": "Vengano meno i peccatori d'in su la terra,"
  }
]