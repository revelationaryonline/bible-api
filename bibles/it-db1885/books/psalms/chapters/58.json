[
  {
    "id": 29126,
    "book": "psalms                                  ",
    "chapter": "58",
    "verse": "1",
    "text": "DI vero, parlate voi giustamente?"
  },
  {
    "id": 29127,
    "book": "psalms                                  ",
    "chapter": "58",
    "verse": "2",
    "text": "Anzi voi fabbricate perversità nel cuor vostro;"
  },
  {
    "id": 29128,
    "book": "psalms                                  ",
    "chapter": "58",
    "verse": "3",
    "text": "Questi empi sono stati alienati fin dalla matrice;"
  },
  {
    "id": 29129,
    "book": "psalms                                  ",
    "chapter": "58",
    "verse": "4",
    "text": "Hanno del veleno simile al veleno del serpente;"
  },
  {
    "id": 29130,
    "book": "psalms                                  ",
    "chapter": "58",
    "verse": "5",
    "text": "Il qual non ascolta la voce degl'incantatori58.5 incantatori Eccl. 10.11. Ger. 8.17.,"
  },
  {
    "id": 29131,
    "book": "psalms                                  ",
    "chapter": "58",
    "verse": "6",
    "text": "O Dio, stritola loro i denti nella lor bocca;"
  },
  {
    "id": 29132,
    "book": "psalms                                  ",
    "chapter": "58",
    "verse": "7",
    "text": "Struggansi come acque, e vadansene via;"
  },
  {
    "id": 29133,
    "book": "psalms                                  ",
    "chapter": "58",
    "verse": "8",
    "text": "Trapassino, come una lumaca che si disfa;"
  },
  {
    "id": 29134,
    "book": "psalms                                  ",
    "chapter": "58",
    "verse": "9",
    "text": "Avanti che le vostre pignatte sentano il fuoco del pruno,"
  },
  {
    "id": 29135,
    "book": "psalms                                  ",
    "chapter": "58",
    "verse": "10",
    "text": "Il giusto si rallegrerà, quando avrà veduta la vendetta;"
  },
  {
    "id": 29136,
    "book": "psalms                                  ",
    "chapter": "58",
    "verse": "11",
    "text": "E ciascuno dirà: Certo egli vi è frutto pel giusto;"
  }
]