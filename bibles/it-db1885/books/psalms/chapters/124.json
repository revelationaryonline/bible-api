    "chapter": "124",
    "verse": "1",
    "text": "DICA pure ora Israele:"
  },
  {
    "id": 30450,
    "book": "psalms                                  ",
    "chapter": "124",
    "verse": "2",
    "text": "Se non che il Signore fu per noi,"
  },
  {
    "id": 30451,
    "book": "psalms                                  ",
    "chapter": "124",
    "verse": "3",
    "text": "Essi ci avrebbero tranghiottiti tutti vivi,"
  },
  {
    "id": 30452,
    "book": "psalms                                  ",
    "chapter": "124",
    "verse": "4",
    "text": "Allora le acque ci avrebbero inondati;"
  },
  {
    "id": 30453,
    "book": "psalms                                  ",
    "chapter": "124",
    "verse": "5",
    "text": "Allora le acque gonfiate"
  },
  {
    "id": 30454,
    "book": "psalms                                  ",
    "chapter": "124",
    "verse": "6",
    "text": "Benedetto sia il Signore,"
  },
  {
    "id": 30455,
    "book": "psalms                                  ",
    "chapter": "124",
    "verse": "7",
    "text": "L'anima nostra è scampata dal laccio degli uccellatori, come un uccelletto;"
  },
  {
    "id": 30456,
    "book": "psalms                                  ",
    "chapter": "124",
    "verse": "8",
    "text": "Il nostro aiuto è nel Nome del Signore124.8 Signore Sal. 121.2.,"
  }
]