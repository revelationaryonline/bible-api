[
  {
    "id": 28551,
    "book": "psalms                                  ",
    "chapter": "22",
    "verse": "1",
    "text": "DIO mio, Dio mio, perchè mi hai lasciato22.1 lasciato Mat. 27.46. Mar. 15.34.?"
  },
  {
    "id": 28552,
    "book": "psalms                                  ",
    "chapter": "22",
    "verse": "2",
    "text": "O Dio mio, io grido di giorno, e tu non rispondi;"
  },
  {
    "id": 28553,
    "book": "psalms                                  ",
    "chapter": "22",
    "verse": "3",
    "text": "E pur tu sei il Santo,"
  },
  {
    "id": 28554,
    "book": "psalms                                  ",
    "chapter": "22",
    "verse": "4",
    "text": "I nostri padri si son confidati in te;"
  },
  {
    "id": 28555,
    "book": "psalms                                  ",
    "chapter": "22",
    "verse": "5",
    "text": "Gridarono a te, e furon liberati;"
  },
  {
    "id": 28556,
    "book": "psalms                                  ",
    "chapter": "22",
    "verse": "6",
    "text": "Ma io sono un verme, e non un uomo;"
  },
  {
    "id": 28557,
    "book": "psalms                                  ",
    "chapter": "22",
    "verse": "7",
    "text": "Chiunque mi vede, si beffa di me22.7 me Mat. 27.39-44. Mar. 15.29-32. Luc. 23.35,36.,"
  },
  {
    "id": 28558,
    "book": "psalms                                  ",
    "chapter": "22",
    "verse": "8",
    "text": "Dicendo: Egli si rimette nel Signore; liberilo dunque;"
  },
  {
    "id": 28559,
    "book": "psalms                                  ",
    "chapter": "22",
    "verse": "9",
    "text": "Certo, tu sei quel che mi hai tratto fuor del seno;"
  },
  {
    "id": 28560,
    "book": "psalms                                  ",
    "chapter": "22",
    "verse": "10",
    "text": "Io fui gettato sopra te dalla matrice;"
  },
  {
    "id": 28561,
    "book": "psalms                                  ",
    "chapter": "22",
    "verse": "11",
    "text": "Non allontanarti da me; perciocchè l'angoscia è vicina,"
  },
  {
    "id": 28562,
    "book": "psalms                                  ",
    "chapter": "22",
    "verse": "12",
    "text": "Grandi tori mi hanno circondato;"
  },
  {
    "id": 28563,
    "book": "psalms                                  ",
    "chapter": "22",
    "verse": "13",
    "text": "Hanno aperta la lor gola contro a me,"
  },
  {
    "id": 28564,
    "book": "psalms                                  ",
    "chapter": "22",
    "verse": "14",
    "text": "Io mi scolo come acqua,"
  },
  {
    "id": 28565,
    "book": "psalms                                  ",
    "chapter": "22",
    "verse": "15",
    "text": "Il mio vigore è asciutto come un testo22.15 testo Prov. 17.22.,"
  },
  {
    "id": 28566,
    "book": "psalms                                  ",
    "chapter": "22",
    "verse": "16",
    "text": "Perciocchè cani mi hanno circondato;"
  },
  {
    "id": 28567,
    "book": "psalms                                  ",
    "chapter": "22",
    "verse": "17",
    "text": "Io posso contar tutte le mie ossa;"
  },
  {
    "id": 28568,
    "book": "psalms                                  ",
    "chapter": "22",
    "verse": "18",
    "text": "Si spartiscono fra loro i miei vestimenti,"
  },
  {
    "id": 28569,
    "book": "psalms                                  ",
    "chapter": "22",
    "verse": "19",
    "text": "Tu dunque, Signore, non allontanarti;"
  },
  {
    "id": 28570,
    "book": "psalms                                  ",
    "chapter": "22",
    "verse": "20",
    "text": "Riscuoti l'anima mia dalla spada,"
  },
  {
    "id": 28571,
    "book": "psalms                                  ",
    "chapter": "22",
    "verse": "21",
    "text": "Salvami dalla gola del leone22.21 leone 2 Tim. 4.17.,"
  },
  {
    "id": 28572,
    "book": "psalms                                  ",
    "chapter": "22",
    "verse": "22",
    "text": "Io racconterò il tuo Nome a' miei fratelli22.22 fratelli Rom. 8.29. Ebr. 2.12.;"
  },
  {
    "id": 28573,
    "book": "psalms                                  ",
    "chapter": "22",
    "verse": "23",
    "text": "Voi che temete il Signore, lodatelo;"
  },
  {
    "id": 28574,
    "book": "psalms                                  ",
    "chapter": "22",
    "verse": "24",
    "text": "Perciocchè egli non ha sprezzata, nè disdegnata l'afflizione dell'afflitto;"
  },
  {
    "id": 28575,
    "book": "psalms                                  ",
    "chapter": "22",
    "verse": "25",
    "text": "Da te io ho l'argomento della mia lode in grande raunanza22.25 raunanza Sal. 35.18; 40.9,10.;"
  },
  {
    "id": 28576,
    "book": "psalms                                  ",
    "chapter": "22",
    "verse": "26",
    "text": "I mansueti mangeranno, e saranno saziati22.26 saziati Giov. 6.51.;"
  },
  {
    "id": 28577,
    "book": "psalms                                  ",
    "chapter": "22",
    "verse": "27",
    "text": "Tutte le estremità della terra ne avranno memoria,"
  },
  {
    "id": 28578,
    "book": "psalms                                  ",
    "chapter": "22",
    "verse": "28",
    "text": "Perciocchè al Signore appartiene il regno22.28 regno Zac. 14.9. Mat. 6.13.;"
  },
  {
    "id": 28579,
    "book": "psalms                                  ",
    "chapter": "22",
    "verse": "29",
    "text": "Tutti i grassi della terra mangeranno ed adoreranno;"
  },
  {
    "id": 28580,
    "book": "psalms                                  ",
    "chapter": "22",
    "verse": "30",
    "text": "La lor posterità gli servirà;"
  },
  {
    "id": 28581,
    "book": "psalms                                  ",
    "chapter": "22",
    "verse": "31",
    "text": "Essi verranno, ed annunzieranno la sua giustizia22.31 giustizia Sal. 78.6; 86.9; 102.18. Is. 60.3. Rom. 3.21,22.;"
  }
]