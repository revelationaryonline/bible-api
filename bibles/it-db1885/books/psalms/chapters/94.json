[
  {
    "id": 29778,
    "book": "psalms                                  ",
    "chapter": "94",
    "verse": "1",
    "text": "O SIGNORE Iddio delle vendette94.1 vendette Deut. 32.35. Na. 1.2.;"
  },
  {
    "id": 29779,
    "book": "psalms                                  ",
    "chapter": "94",
    "verse": "2",
    "text": "Innalzati, o Giudice della terra94.2 terra Gen. 18.25 e rif.;"
  },
  {
    "id": 29780,
    "book": "psalms                                  ",
    "chapter": "94",
    "verse": "3",
    "text": "Infino a quando, o Signore,"
  },
  {
    "id": 29781,
    "book": "psalms                                  ",
    "chapter": "94",
    "verse": "4",
    "text": "Infino a quando sgorgheranno parole dure?"
  },
  {
    "id": 29782,
    "book": "psalms                                  ",
    "chapter": "94",
    "verse": "5",
    "text": "Signore, essi tritano il tuo popolo,"
  },
  {
    "id": 29783,
    "book": "psalms                                  ",
    "chapter": "94",
    "verse": "6",
    "text": "Uccidono la vedova e il forestiere,"
  },
  {
    "id": 29784,
    "book": "psalms                                  ",
    "chapter": "94",
    "verse": "7",
    "text": "E dicono: Il Signore non ne vede,"
  },
  {
    "id": 29785,
    "book": "psalms                                  ",
    "chapter": "94",
    "verse": "8",
    "text": "O voi i più stolti del popolo, intendete;"
  },
  {
    "id": 29786,
    "book": "psalms                                  ",
    "chapter": "94",
    "verse": "9",
    "text": "Colui che ha piantata l'orecchia94.9 orecchia Esod. 4.11. Prov. 20.12. non udirebbe egli?"
  },
  {
    "id": 29787,
    "book": "psalms                                  ",
    "chapter": "94",
    "verse": "10",
    "text": "Colui che gastiga le genti,"
  },
  {
    "id": 29788,
    "book": "psalms                                  ",
    "chapter": "94",
    "verse": "11",
    "text": "Il Signore conosce i pensieri degli uomini94.11 uomini 1 Cor. 3.20.,"
  },
  {
    "id": 29789,
    "book": "psalms                                  ",
    "chapter": "94",
    "verse": "12",
    "text": "Beato l'uomo il qual tu correggi94.12 correggi Giob. 5.17. Prov. 3.11. 1 Cor. 11.32. Ebr. 12.5-11., Signore,"
  },
  {
    "id": 29790,
    "book": "psalms                                  ",
    "chapter": "94",
    "verse": "13",
    "text": "Per dargli riposo, liberandolo da' giorni dell'avversità,"
  },
  {
    "id": 29791,
    "book": "psalms                                  ",
    "chapter": "94",
    "verse": "14",
    "text": "Perciocchè il Signore non lascerà il suo popolo,"
  },
  {
    "id": 29792,
    "book": "psalms                                  ",
    "chapter": "94",
    "verse": "15",
    "text": "Perciocchè il giudicio ritornerà a giustizia,"
  },
  {
    "id": 29793,
    "book": "psalms                                  ",
    "chapter": "94",
    "verse": "16",
    "text": "Chi si leverà per me contro a' maligni?"
  },
  {
    "id": 29794,
    "book": "psalms                                  ",
    "chapter": "94",
    "verse": "17",
    "text": "Se il Signore non fosse stato mio aiuto94.17 aiuto Sal. 124.1 ecc.,"
  },
  {
    "id": 29795,
    "book": "psalms                                  ",
    "chapter": "94",
    "verse": "18",
    "text": "Quando io ho detto: Il mio piè vacilla;"
  },
  {
    "id": 29796,
    "book": "psalms                                  ",
    "chapter": "94",
    "verse": "19",
    "text": "Quando io sono stato in gran pensieri dentro di me,"
  },
  {
    "id": 29797,
    "book": "psalms                                  ",
    "chapter": "94",
    "verse": "20",
    "text": "Il seggio delle malizie che forma iniquità in luogo di statuti94.20 statuti Is. 10.1.,"
  },
  {
    "id": 29798,
    "book": "psalms                                  ",
    "chapter": "94",
    "verse": "21",
    "text": "Essi corrono a schiere contro all'anima del giusto,"
  },
  {
    "id": 29799,
    "book": "psalms                                  ",
    "chapter": "94",
    "verse": "22",
    "text": "Ma il Signore mi è in vece d'alto ricetto;"
  },
  {
    "id": 29800,
    "book": "psalms                                  ",
    "chapter": "94",
    "verse": "23",
    "text": "Ed egli farà lor tornare addosso la loro iniquità,"
  }
]