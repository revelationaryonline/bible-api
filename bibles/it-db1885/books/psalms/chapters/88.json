[
  {
    "id": 29655,
    "book": "psalms                                  ",
    "chapter": "88",
    "verse": "1",
    "text": "O SIGNORE Iddio della mia salute,"
  },
  {
    "id": 29656,
    "book": "psalms                                  ",
    "chapter": "88",
    "verse": "2",
    "text": "Venga la mia orazione in tua presenza;"
  },
  {
    "id": 29657,
    "book": "psalms                                  ",
    "chapter": "88",
    "verse": "3",
    "text": "Perciocchè l'anima mia è sazia di mali;"
  },
  {
    "id": 29658,
    "book": "psalms                                  ",
    "chapter": "88",
    "verse": "4",
    "text": "Io son reputato del numero di quelli che scendono nella fossa;"
  },
  {
    "id": 29659,
    "book": "psalms                                  ",
    "chapter": "88",
    "verse": "5",
    "text": "Io sono spacciato fra i morti,"
  },
  {
    "id": 29660,
    "book": "psalms                                  ",
    "chapter": "88",
    "verse": "6",
    "text": "Tu mi hai posto in una fossa bassissima,"
  },
  {
    "id": 29661,
    "book": "psalms                                  ",
    "chapter": "88",
    "verse": "7",
    "text": "L'ira tua si è posata sopra me,"
  },
  {
    "id": 29662,
    "book": "psalms                                  ",
    "chapter": "88",
    "verse": "8",
    "text": "Tu hai allontanati da me i miei conoscenti,"
  },
  {
    "id": 29663,
    "book": "psalms                                  ",
    "chapter": "88",
    "verse": "9",
    "text": "L'occhio mio è doglioso d'afflizione;"
  },
  {
    "id": 29664,
    "book": "psalms                                  ",
    "chapter": "88",
    "verse": "10",
    "text": "Opererai tu alcuna maraviglia inverso i morti?"
  },
  {
    "id": 29665,
    "book": "psalms                                  ",
    "chapter": "88",
    "verse": "11",
    "text": "La tua benignità si narrerà ella nel sepolcro?"
  },
  {
    "id": 29666,
    "book": "psalms                                  ",
    "chapter": "88",
    "verse": "12",
    "text": "Le tue maraviglie si conosceranno esse nelle tenebre?"
  },
  {
    "id": 29667,
    "book": "psalms                                  ",
    "chapter": "88",
    "verse": "13",
    "text": "Ora quant'è a me, o Signore, io grido a te;"
  },
  {
    "id": 29668,
    "book": "psalms                                  ",
    "chapter": "88",
    "verse": "14",
    "text": "Perchè scacci, o Signore, l'anima mia?"
  },
  {
    "id": 29669,
    "book": "psalms                                  ",
    "chapter": "88",
    "verse": "15",
    "text": "Io son povero, e vengo meno fin dalla mia giovanezza;"
  },
  {
    "id": 29670,
    "book": "psalms                                  ",
    "chapter": "88",
    "verse": "16",
    "text": "Le tue ire mi son passate addosso;"
  },
  {
    "id": 29671,
    "book": "psalms                                  ",
    "chapter": "88",
    "verse": "17",
    "text": "Mi han circondato come acque tuttodì;"
  },
  {
    "id": 29672,
    "book": "psalms                                  ",
    "chapter": "88",
    "verse": "18",
    "text": "Tu hai allontanati da me amici e compagni;"
  }
]