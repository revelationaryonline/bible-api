[
  {
    "id": 28785,
    "book": "psalms                                  ",
    "chapter": "36",
    "verse": "1",
    "text": "IL misfatto dell'empio mi dice dentro al cuore,"
  },
  {
    "id": 28786,
    "book": "psalms                                  ",
    "chapter": "36",
    "verse": "2",
    "text": "Perciocchè egli si lusinga appo sè stesso36.2 stesso Deut. 29.19.,"
  },
  {
    "id": 28787,
    "book": "psalms                                  ",
    "chapter": "36",
    "verse": "3",
    "text": "Le parole della sua bocca sono iniquità e frode;"
  },
  {
    "id": 28788,
    "book": "psalms                                  ",
    "chapter": "36",
    "verse": "4",
    "text": "Egli divisa iniquità sopra il suo letto;"
  },
  {
    "id": 28789,
    "book": "psalms                                  ",
    "chapter": "36",
    "verse": "5",
    "text": "O Signore, la tua benignità arriva infino al cielo,"
  },
  {
    "id": 28790,
    "book": "psalms                                  ",
    "chapter": "36",
    "verse": "6",
    "text": "La tua giustizia è simile a monti altissimi;"
  },
  {
    "id": 28791,
    "book": "psalms                                  ",
    "chapter": "36",
    "verse": "7",
    "text": "O Dio, quanto preziosa è la tua benignità!"
  },
  {
    "id": 28792,
    "book": "psalms                                  ",
    "chapter": "36",
    "verse": "8",
    "text": "Son saziati del grasso della tua Casa;"
  },
  {
    "id": 28793,
    "book": "psalms                                  ",
    "chapter": "36",
    "verse": "9",
    "text": "Perciocchè appo te è la fonte della vita36.9 vita Ger. 2.13. Giov. 4.10,14.;"
  },
  {
    "id": 28794,
    "book": "psalms                                  ",
    "chapter": "36",
    "verse": "10",
    "text": "Stendi la tua benignità inverso quelli che ti conoscono,"
  },
  {
    "id": 28795,
    "book": "psalms                                  ",
    "chapter": "36",
    "verse": "11",
    "text": "Non vengami addosso il piè del superbo;"
  },
  {
    "id": 28796,
    "book": "psalms                                  ",
    "chapter": "36",
    "verse": "12",
    "text": "Ecco là, gli operatori d'iniquità son caduti;"
  }
