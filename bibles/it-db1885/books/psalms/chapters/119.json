[
  {
    "id": 30245,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "1",
    "text": "BEATI coloro che sono intieri di via119.1 via Gen. 17.1. Prov. 11.20; 13.6.,"
  },
  {
    "id": 30246,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "2",
    "text": "Beati coloro che guardano le sue testimonianze,"
  },
  {
    "id": 30247,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "3",
    "text": "I quali eziandio non operano iniquità119.3 iniquità 1 Giov. 3.9; 5.18.;"
  },
  {
    "id": 30248,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "4",
    "text": "Tu hai ordinato che i tuoi comandamenti"
  },
  {
    "id": 30249,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "5",
    "text": "Oh! sieno pure addirizzate le mie vie,"
  },
  {
    "id": 30250,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "6",
    "text": "Allora io non sarò svergognato119.6 svergognato Giob. 22.26. 1 Giov. 2.28.,"
  },
  {
    "id": 30251,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "7",
    "text": "Io ti celebrerò con dirittura di cuore,"
  },
  {
    "id": 30252,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "8",
    "text": "Io osserverò i tuoi statuti;"
  },
  {
    "id": 30253,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "9",
    "text": "Come renderà il fanciullo la sua via pura119.9 pura Sal. 25.7.?"
  },
  {
    "id": 30254,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "10",
    "text": "Io ti ho cercato con tutto il mio cuore119.10 cuore 2 Cron. 15.15.;"
  },
  {
    "id": 30255,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "11",
    "text": "Io ho riposta la tua parola nel mio cuore119.11 cuore Sal. 37.31. Luc. 2.19,51.;"
  },
  {
    "id": 30256,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "12",
    "text": "Tu sei benedetto, o Signore;"
  },
  {
    "id": 30257,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "13",
    "text": "Io ho colle mie labbra raccontate"
  },
  {
    "id": 30258,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "14",
    "text": "Io gioisco nella via delle tue testimonianze,"
  },
  {
    "id": 30259,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "15",
    "text": "Io ragiono de' tuoi comandamenti,"
  },
  {
    "id": 30260,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "16",
    "text": "Io mi diletto ne' tuoi statuti119.16 statuti Sal. 1.2.;"
  },
  {
    "id": 30261,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "17",
    "text": "Fa' del bene al tuo servitore,"
  },
  {
    "id": 30262,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "18",
    "text": "Apri gli occhi miei, ed io riguarderò"
  },
  {
    "id": 30263,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "19",
    "text": "Io son forestiere in terra119.19 terra Gen. 47.9. 1 Cron. 29.15. 2 Cor. 5.6. Ebr. 11.13.;"
  },
  {
    "id": 30264,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "20",
    "text": "L'anima mia si stritola di affezione"
  },
  {
    "id": 30265,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "21",
    "text": "Tu sgridi i superbi maledetti"
  },
  {
    "id": 30266,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "22",
    "text": "Togli d'addosso a me il vituperio e lo sprezzo;"
  },
  {
    "id": 30267,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "23",
    "text": "Eziandio, mentre i principi sedevano, e ragionavano contro a me,"
  },
  {
    "id": 30268,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "24",
    "text": "Ed anche le tue testimonianze sono i miei diletti"
  },
  {
    "id": 30269,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "25",
    "text": "L'anima mia è attaccata alla polvere;"
  },
  {
    "id": 30270,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "26",
    "text": "Io ti ho narrate le mie vie, e tu mi hai risposto;"
  },
  {
    "id": 30271,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "27",
    "text": "Fammi intender la via de' tuoi comandamenti,"
  },
  {
    "id": 30272,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "28",
    "text": "L'anima mia stilla di cordoglio;"
  },
  {
    "id": 30273,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "29",
    "text": "Rimuovi da me la via della menzogna;"
  },
  {
    "id": 30274,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "30",
    "text": "Io ho scelta la via della verità;"
  },
  {
    "id": 30275,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "31",
    "text": "Io mi son tenuto alle tue testimonianze;"
  },
  {
    "id": 30276,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "32",
    "text": "Correrò nella via de' tuoi comandamenti,"
  },
  {
    "id": 30277,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "33",
    "text": "Insegnami, Signore, la via de' tuoi statuti;"
  },
  {
    "id": 30278,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "34",
    "text": "Dammi intelletto119.34 intelletto Prov. 2.6. Giac. 1.5., ed io guarderò la tua Legge;"
  },
  {
    "id": 30279,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "35",
    "text": "Conducimi per lo sentiero de' tuoi comandamenti;"
  },
  {
    "id": 30280,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "36",
    "text": "Inchina il mio cuore alle tue testimonianze,"
  },
  {
    "id": 30281,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "37",
    "text": "Storna gli occhi miei, che non riguardino a vanità;"
  },
  {
    "id": 30282,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "38",
    "text": "Attieni la tua parola al tuo servitore,"
  },
  {
    "id": 30283,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "39",
    "text": "Rimuovi da me il mio vituperio, del quale io temo;"
  },
  {
    "id": 30284,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "40",
    "text": "Ecco, io desidero affettuosamente i tuoi comandamenti;"
  },
  {
    "id": 30285,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "41",
    "text": "Ed avvenganmi le tue benignità, o Signore;"
  },
  {
    "id": 30286,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "42",
    "text": "Ed io risponderò a colui che mi fa vituperio;"
  },
  {
    "id": 30287,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "43",
    "text": "E non ritrarmi del tutto dalla bocca la parola della verità;"
  },
  {
    "id": 30288,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "44",
    "text": "Ed io osserverò la tua Legge del continuo,"
  },
  {
    "id": 30289,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "45",
    "text": "E camminerò al largo;"
  },
  {
    "id": 30290,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "46",
    "text": "E parlerò delle tue testimonianze davanti ai re119.46 re Mat. 10.18,19. Fat. 26.1,2.,"
  },
  {
    "id": 30291,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "47",
    "text": "E mi diletterò ne' tuoi comandamenti,"
  },
  {
    "id": 30292,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "48",
    "text": "Ed alzerò le palme delle mie mani a' tuoi comandamenti, i quali io amo;"
  },
  {
    "id": 30293,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "49",
    "text": "Ricordati della parola detta al tuo servitore,"
  },
  {
    "id": 30294,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "50",
    "text": "Questa è la mia consolazione nella mia afflizione,"
  },
  {
    "id": 30295,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "51",
    "text": "I superbi mi hanno grandemente schernito;"
  },
  {
    "id": 30296,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "52",
    "text": "Signore, io mi son ricordato de' tuoi giudicii ab antico;"
  },
  {
    "id": 30297,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "53",
    "text": "Tremito mi occupa, per gli empi"
  },
  {
    "id": 30298,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "54",
    "text": "I tuoi statuti sono stati i miei cantici"
  },
  {
    "id": 30299,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "55",
    "text": "O Signore, di notte io mi son ricordato del tuo Nome,"
  },
  {
    "id": 30300,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "56",
    "text": "Questo mi è avvenuto,"
  },
  {
    "id": 30301,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "57",
    "text": "Il Signore è la mia parte119.57 parte Sal. 16.5 e rif.;"
  },
  {
    "id": 30302,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "58",
    "text": "Io ti ho supplicato con tutto il cuore;"
  },
  {
    "id": 30303,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "59",
    "text": "Io ho fatta ragione delle mie vie119.59 vie Luc. 15.17,18.;"
  },
  {
    "id": 30304,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "60",
    "text": "Io mi sono affrettato, e non mi sono indugiato"
  },
  {
    "id": 30305,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "61",
    "text": "Schiere d'empi mi hanno predato;"
  },
  {
    "id": 30306,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "62",
    "text": "Io mi levo a mezzanotte, per celebrarti119.62 celebrarti Fat. 16.25.,"
  },
  {
    "id": 30307,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "63",
    "text": "Io son compagno di tutti quelli che ti temono,"
  },
  {
    "id": 30308,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "64",
    "text": "Signore, la terra è piena della tua benignità;"
  },
  {
    "id": 30309,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "65",
    "text": "Signore, tu hai usata beneficenza inverso il tuo servitore,"
  },
  {
    "id": 30310,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "66",
    "text": "Insegnami buon senno ed intendimento;"
  },
  {
    "id": 30311,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "67",
    "text": "Avanti che io fossi afflitto, io andava errando119.67 errando Ebr. 12.10,11.;"
  },
  {
    "id": 30312,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "68",
    "text": "Tu sei buono119.68 buono Sal. 106.1 e rif. e benefattore;"
  },
  {
    "id": 30313,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "69",
    "text": "I superbi hanno acconciate delle bugie contro a me;"
  },
  {
    "id": 30314,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "70",
    "text": "Il cuor loro è condenso come grasso119.70 grasso Is. 6.10. Fat. 28.27.;"
  },
  {
    "id": 30315,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "71",
    "text": "Egli è stato buono per me, che io sono stato afflitto119.71 afflitto Ebr. 12.10,11.;"
  },
  {
    "id": 30316,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "72",
    "text": "La Legge della tua bocca mi è migliore"
  },
  {
    "id": 30317,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "73",
    "text": "Le tue mani mi hanno fatto e formato119.73 formato Sal. 100.3 e rif.; 139.14.;"
  },
  {
    "id": 30318,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "74",
    "text": "Quelli che ti temono mi vedranno, e si rallegreranno;"
  },
  {
    "id": 30319,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "75",
    "text": "O Signore, io so che i tuoi giudicii non sono altro che giustizia;"
  },
  {
    "id": 30320,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "76",
    "text": "Deh! sia la tua benignità per consolarmi,"
  },
  {
    "id": 30321,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "77",
    "text": "Avvenganmi le tue misericordie, acciocchè io viva;"
  },
  {
    "id": 30322,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "78",
    "text": "Sien confusi i superbi, perciocchè a torto mi sovvertono;"
  },
  {
    "id": 30323,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "79",
    "text": "Rivolgansi a me quelli che ti temono."
  },
  {
    "id": 30324,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "80",
    "text": "Sia il mio cuore intiero ne' tuoi statuti;"
  },
  {
    "id": 30325,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "81",
    "text": "L'anima mia vien meno dietro alla tua salute;"
  },
  {
    "id": 30326,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "82",
    "text": "Gli occhi miei vengono meno dietro alla tua parola,"
  },
  {
    "id": 30327,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "83",
    "text": "Perciocchè io son divenuto come un otro al fumo;"
  },
  {
    "id": 30328,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "84",
    "text": "Quanti hanno da essere i giorni del tuo servitore119.84 servitore Sal. 39.4.?"
  },
  {
    "id": 30329,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "85",
    "text": "I superbi mi hanno cavate delle fosse119.85 fosse Sal. 35.7,8. Prov. 16.27.;"
  },
  {
    "id": 30330,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "86",
    "text": "Tutti i tuoi comandamenti son verità;"
  },
  {
    "id": 30331,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "87",
    "text": "Mi hanno pressochè distrutto ed atterrato;"
  },
  {
    "id": 30332,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "88",
    "text": "Vivificami secondo la tua benignità,"
  },
  {
    "id": 30333,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "89",
    "text": "O Signore, la tua parola è in eterno;"
  },
  {
    "id": 30334,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "90",
    "text": "La tua verità è per ogni età;"
  },
  {
    "id": 30335,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "91",
    "text": "Il cielo e la terra stanno anche oggi fermi, per li tuoi ordini119.91 ordini Ger. 33.25.,"
  },
  {
    "id": 30336,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "92",
    "text": "Se la tua Legge non fosse stata ogni mio diletto,"
  },
  {
    "id": 30337,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "93",
    "text": "Giammai non dimenticherò i tuoi comandamenti;"
  },
  {
    "id": 30338,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "94",
    "text": "Io son tuo, salvami;"
  },
  {
    "id": 30339,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "95",
    "text": "Gli empi mi hanno atteso, per farmi perire;"
  },
  {
    "id": 30340,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "96",
    "text": "Io ho veduto che tutte le cose le più perfette hanno fine;"
  },
  {
    "id": 30341,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "97",
    "text": "Oh! quanto amo la tua Legge!"
  },
  {
    "id": 30342,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "98",
    "text": "Per li tuoi comandamenti tu mi rendi più savio che i miei nemici119.98 nemici Deut. 4.6,8.;"
  },
  {
    "id": 30343,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "99",
    "text": "Io son più intendente che tutti i miei dottori;"
  },
  {
    "id": 30344,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "100",
    "text": "Io son più avveduto che i vecchi119.100 vecchi Giob. 32.7-9.;"
  },
  {
    "id": 30345,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "101",
    "text": "Io ho rattenuti i miei piedi da ogni sentiero malvagio119.101 malvagio Prov. 1.15.;"
  },
  {
    "id": 30346,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "102",
    "text": "Io non mi sono stornato dalle tue leggi;"
  },
  {
    "id": 30347,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "103",
    "text": "Oh! quanto son dolci le tue parole al mio palato119.103 palato Sal. 19.10. Prov. 8.11.!"
  },
  {
    "id": 30348,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "104",
    "text": "Io son divenuto avveduto per li tuoi comandamenti;"
  },
  {
    "id": 30349,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "105",
    "text": "La tua parola è una lampana al mio piè,"
  },
  {
    "id": 30350,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "106",
    "text": "Io ho giurato, e l'atterrò,"
  },
  {
    "id": 30351,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "107",
    "text": "Io son sommamente afflitto;"
  },
  {
    "id": 30352,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "108",
    "text": "Deh! Signore, gradisci le offerte volontarie della mia bocca119.108 bocca Ebr. 13.15.,"
  },
  {
    "id": 30353,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "109",
    "text": "Io ho l'anima mia del continuo in palma di mano;"
  },
  {
    "id": 30354,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "110",
    "text": "Gli empi mi hanno tesi de' lacci;"
  },
  {
    "id": 30355,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "111",
    "text": "Le tue testimonianze son la mia eredità in perpetuo119.111 perpetuo Deut. 33.4.;"
  },
  {
    "id": 30356,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "112",
    "text": "Io ho inchinato il mio cuore a mettere in opera i tuoi statuti,"
  },
  {
    "id": 30357,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "113",
    "text": "Io odio i discorsi;"
  },
  {
    "id": 30358,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "114",
    "text": "Tu sei il mio nascondimento119.114 nascondimento Sal. 32.7; 91.1., ed il mio scudo;"
  },
  {
    "id": 30359,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "115",
    "text": "Ritraetevi da me, maligni119.115 maligni Mat. 7.23.;"
  },
  {
    "id": 30360,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "116",
    "text": "Sostienmi, secondo la tua parola, ed io viverò;"
  },
  {
    "id": 30361,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "117",
    "text": "Confortami, ed io sarò salvato;"
  },
  {
    "id": 30362,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "118",
    "text": "Tu calpesti tutti quelli che si sviano da' tuoi statuti;"
  },
  {
    "id": 30363,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "119",
    "text": "Tu riduci al niente tutti gli empi della terra, come schiume;"
  },
  {
    "id": 30364,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "120",
    "text": "La mia carne si raccapriccia tutta per lo spavento di te;"
  },
  {
    "id": 30365,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "121",
    "text": "Io ho fatto ciò che è diritto e giusto;"
  },
  {
    "id": 30366,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "122",
    "text": "Da' sicurtà per lo tuo servitore in bene119.122 bene Ebr. 7.22.,"
  },
  {
    "id": 30367,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "123",
    "text": "Gli occhi miei vengono meno dietro alla tua salute,"
  },
  {
    "id": 30368,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "124",
    "text": "Opera inverso il tuo servitore secondo la tua benignità,"
  },
  {
    "id": 30369,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "125",
    "text": "Io son tuo servitore; dammi intelletto;"
  },
  {
    "id": 30370,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "126",
    "text": "Egli è tempo che il Signore operi;"
  },
  {
    "id": 30371,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "127",
    "text": "Perciò io amo i tuoi comandamenti più che oro;"
  },
  {
    "id": 30372,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "128",
    "text": "Perciò approvo, come diritti, tutti i tuoi comandamenti intorno ad ogni cosa;"
  },
  {
    "id": 30373,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "129",
    "text": "Le tue testimonianze son cose maravigliose;"
  },
  {
    "id": 30374,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "130",
    "text": "La dichiarazione delle tue parole allumina,"
  },
  {
    "id": 30375,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "131",
    "text": "Io ho aperta la bocca, ed ho ansato;"
  },
  {
    "id": 30376,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "132",
    "text": "Riguarda a me, ed abbi pietà di me,"
  },
  {
    "id": 30377,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "133",
    "text": "Ferma i miei passi nella tua parola119.133 parola Sal. 17.5.;"
  },
  {
    "id": 30378,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "134",
    "text": "Riscuotimi dall'oppressione degli uomini119.134 uomini Luc. 1.74.;"
  },
  {
    "id": 30379,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "135",
    "text": "Fa' rilucere il tuo volto sopra il tuo servitore119.135 servitore Num. 6.25. Sal. 4.6.;"
  },
  {
    "id": 30380,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "136",
    "text": "Ed insegnami i tuoi statuti."
  },
  {
    "id": 30381,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "137",
    "text": "O Signore, tu sei giusto119.137 giusto Esd. 9.15. Ger. 12.1. Dan. 9.7.,"
  },
  {
    "id": 30382,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "138",
    "text": "Tu hai strettamente comandata la giustizia,"
  },
  {
    "id": 30383,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "139",
    "text": "Il mio zelo mi consuma119.139 consuma Sal. 69.9. Giov. 2.17.;"
  },
  {
    "id": 30384,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "140",
    "text": "La tua parola è sommamente purgata119.140 purgata Sal. 12.6; 18.29. Prov. 30.5.;"
  },
  {
    "id": 30385,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "141",
    "text": "Io son piccolo e sprezzato;"
  },
  {
    "id": 30386,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "142",
    "text": "La tua giustizia è una giustizia eterna,"
  },
  {
    "id": 30387,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "143",
    "text": "Tribolazione e distretta mi hanno colto;"
  },
  {
    "id": 30388,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "144",
    "text": "Le tue testimonianze sono una giustizia eterna;"
  },
  {
    "id": 30389,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "145",
    "text": "Io ho gridato con tutto il cuore; rispondimi, Signore;"
  },
  {
    "id": 30390,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "146",
    "text": "Io ti ho invocato; salvami,"
  },
  {
    "id": 30391,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "147",
    "text": "Io mi son fatto avanti all'alba119.147 alba Sal. 5.3; 88.13., ed ho gridato;"
  },
  {
    "id": 30392,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "148",
    "text": "Gli occhi miei prevengono le vigilie della notte."
  },
  {
    "id": 30393,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "149",
    "text": "Ascolta la mia voce, secondo la tua benignità;"
  },
  {
    "id": 30394,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "150",
    "text": "Quelli che vanno dietro a scelleratezza,"
  },
  {
    "id": 30395,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "151",
    "text": "O Signore, tu sei vicino119.151 vicino Sal. 145.18.;"
  },
  {
    "id": 30396,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "152",
    "text": "Gran tempo è che io so questo delle tue testimonianze,"
  },
  {
    "id": 30397,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "153",
    "text": "Riguarda alla mia afflizione, e trammene fuori;"
  },
  {
    "id": 30398,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "154",
    "text": "Dibatti la mia lite119.154 lite 1 Sam. 24.16. Sal. 35.1., e riscuotimi;"
  },
  {
    "id": 30399,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "155",
    "text": "La salute è lungi dagli empi;"
  },
  {
    "id": 30400,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "156",
    "text": "Le tue misericordie son grandi, Signore119.156 Signore 2 Sam. 24.14.;"
  },
  {
    "id": 30401,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "157",
    "text": "I miei persecutori ed i miei nemici son molti;"
  },
  {
    "id": 30402,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "158",
    "text": "Io ho veduti i disleali, e ne ho sentita gran noia119.158 noia Sal. 139.21. Ezec. 9.4.;"
  },
  {
    "id": 30403,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "159",
    "text": "Vedi quanto amo i tuoi comandamenti!"
  },
  {
    "id": 30404,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "160",
    "text": "La somma della tua parola è verità;"
  },
  {
    "id": 30405,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "161",
    "text": "I principi m'hanno perseguitato senza cagione;"
  },
  {
    "id": 30406,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "162",
    "text": "Io mi rallegro per la tua parola,"
  },
  {
    "id": 30407,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "163",
    "text": "Io odio ed abbomino la menzogna;"
  },
  {
    "id": 30408,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "164",
    "text": "Io ti lodo sette volte il dì,"
  },
  {
    "id": 30409,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "165",
    "text": "Quelli che amano la tua Legge godono di molta pace119.165 pace Prov. 3.1,2. Is. 32.17.;"
  },
  {
    "id": 30410,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "166",
    "text": "Signore, io ho sperato nella tua salute119.166 salute Gen. 49.18.;"
  },
  {
    "id": 30411,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "167",
    "text": "L'anima mia ha osservate le tue testimonianze;"
  },
  {
    "id": 30412,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "168",
    "text": "Io ho osservati i tuoi comandamenti, e le tue testimonianze;"
  },
  {
    "id": 30413,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "169",
    "text": "Pervenga il mio grido al tuo cospetto, o Signore;"
  },
  {
    "id": 30414,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "170",
    "text": "Venga la mia supplicazione in tua presenza;"
  },
  {
    "id": 30415,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "171",
    "text": "Le mie labbra sgorgheranno lode,"
  },
  {
    "id": 30416,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "172",
    "text": "La mia lingua ragionerà della tua parola;"
  },
  {
    "id": 30417,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "173",
    "text": "Siami in aiuto la tua mano;"
  },
  {
    "id": 30418,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "174",
    "text": "Signore, io ho desiderata la tua salute;"
  },
  {
    "id": 30419,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "175",
    "text": "Viva l'anima mia, ed ella ti loderà;"
  },
  {
    "id": 30420,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "176",
    "text": "Io vo errando, come una pecora smarrita119.176 smarrita Is. 53.6. Luc. 15.4 ecc. 1 Piet. 2.25.; cerca il tuo servitore;"
  }
]