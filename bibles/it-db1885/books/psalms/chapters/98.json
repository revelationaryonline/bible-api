    "chapter": "98",
    "verse": "1",
    "text": "CANTATE al Signore un nuovo cantico;"
  },
  {
    "id": 29838,
    "book": "psalms                                  ",
    "chapter": "98",
    "verse": "2",
    "text": "Il Signore ha fatta conoscer la sua salute;"
  },
  {
    "id": 29839,
    "book": "psalms                                  ",
    "chapter": "98",
    "verse": "3",
    "text": "Egli si è ricordato della sua benignità, e della sua verità,"
  },
  {
    "id": 29840,
    "book": "psalms                                  ",
    "chapter": "98",
    "verse": "4",
    "text": "O abitanti di tutta la terra,"
