    "book": "psalms                                  ",
    "chapter": "98",
    "verse": "7",
    "text": "Rimbombi il mare, e ciò che è in esso;"
  },
  {
    "id": 29844,
    "book": "psalms                                  ",
    "chapter": "98",
    "verse": "8",
    "text": "Battansi i fiumi a palme;"
