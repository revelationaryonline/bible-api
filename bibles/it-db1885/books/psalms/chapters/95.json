[
  {
    "id": 29801,
    "book": "psalms                                  ",
    "chapter": "95",
    "verse": "1",
    "text": "VENITE, cantiamo lietamente al Signore;"
  },
  {
    "id": 29802,
    "book": "psalms                                  ",
    "chapter": "95",
    "verse": "2",
    "text": "Andiamogli incontro con lodi,"
  },
  {
    "id": 29803,
    "book": "psalms                                  ",
    "chapter": "95",
    "verse": "3",
    "text": "Perciocchè il Signore è Dio grande,"
  },
  {
    "id": 29804,
    "book": "psalms                                  ",
    "chapter": "95",
    "verse": "4",
    "text": "Perciocchè egli tiene in mano le profondità della terra;"
  },
  {
    "id": 29805,
    "book": "psalms                                  ",
    "chapter": "95",
    "verse": "5",
    "text": "Ed a lui appartiene il mare, perchè egli l'ha fatto95.5 fatto Gen. 1.9,10.;"
  },
  {
    "id": 29806,
    "book": "psalms                                  ",
    "chapter": "95",
    "verse": "6",
    "text": "Venite, adoriamo, ed inchiniamoci;"
  },
  {
    "id": 29807,
    "book": "psalms                                  ",
    "chapter": "95",
    "verse": "7",
    "text": "Perciocchè egli è il nostro Dio;"
  },
  {
    "id": 29808,
    "book": "psalms                                  ",
    "chapter": "95",
    "verse": "8",
    "text": "Oggi, se udite la sua voce95.8 voce Ebr. 3.7 ecc.; 4.7.,"
  },
  {
    "id": 29809,
    "book": "psalms                                  ",
    "chapter": "95",
    "verse": "9",
    "text": "Ove i padri vostri mi tentarono,"
  },
  {
    "id": 29810,
    "book": "psalms                                  ",
    "chapter": "95",
    "verse": "10",
    "text": "Lo spazio di quarant'anni quella generazione mi fu di noia;"
  },
  {
    "id": 29811,
    "book": "psalms                                  ",
    "chapter": "95",
    "verse": "11",
    "text": "Perciò giurai nell'ira mia:"
  }
]