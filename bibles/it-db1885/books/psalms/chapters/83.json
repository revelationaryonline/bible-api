[
  {
    "id": 29588,
    "book": "psalms                                  ",
    "chapter": "83",
    "verse": "1",
    "text": "O DIO, non istartene cheto;"
  },
  {
    "id": 29589,
    "book": "psalms                                  ",
    "chapter": "83",
    "verse": "2",
    "text": "Perciocchè ecco, i tuoi nemici romoreggiano83.2 romoreggiano Sal. 2.1 e rif.;"
  },
  {
    "id": 29590,
    "book": "psalms                                  ",
    "chapter": "83",
    "verse": "3",
    "text": "Hanno preso un cauto consiglio contro al tuo popolo,"
  },
  {
    "id": 29591,
    "book": "psalms                                  ",
    "chapter": "83",
    "verse": "4",
    "text": "Hanno detto: Venite, e distruggiamoli,"
  },
  {
    "id": 29592,
    "book": "psalms                                  ",
    "chapter": "83",
    "verse": "5",
    "text": "Perciocchè si son di pari consentimento consigliati insieme,"
  },
  {
    "id": 29593,
    "book": "psalms                                  ",
    "chapter": "83",
    "verse": "6",
    "text": "Le tende di Edom, e gl'Ismaeliti;"
  },
  {
    "id": 29594,
    "book": "psalms                                  ",
    "chapter": "83",
    "verse": "7",
    "text": "I Ghebaliti, gli Ammoniti, e gli Amalechiti;"
  },
  {
    "id": 29595,
    "book": "psalms                                  ",
    "chapter": "83",
    "verse": "8",
    "text": "Gli Assiri eziandio si son congiunti con loro;"
  },
  {
    "id": 29596,
    "book": "psalms                                  ",
    "chapter": "83",
    "verse": "9",
    "text": "Fa' loro come tu facesti a Madian83.9 Madian Num. 31.7. Giud. 7.22.;"
  },
  {
    "id": 29597,
    "book": "psalms                                  ",
    "chapter": "83",
    "verse": "10",
    "text": "I quali furono sconfitti in Endor,"
  },
  {
    "id": 29598,
    "book": "psalms                                  ",
    "chapter": "83",
    "verse": "11",
    "text": "Fa' che i lor principi sieno come Oreb e Zeeb;"
  },
  {
    "id": 29599,
    "book": "psalms                                  ",
    "chapter": "83",
    "verse": "12",
    "text": "Perciocchè hanno detto:"
  },
  {
    "id": 29600,
    "book": "psalms                                  ",
    "chapter": "83",
    "verse": "13",
    "text": "Dio mio, falli essere come una palla83.13 palla Is. 17.13,14.;"
  },
  {
    "id": 29601,
    "book": "psalms                                  ",
    "chapter": "83",
    "verse": "14",
    "text": "Come il fuoco brucia un bosco,"
  },
  {
    "id": 29602,
    "book": "psalms                                  ",
    "chapter": "83",
    "verse": "15",
    "text": "Così perseguitali colla tua tempesta,"
  },
  {
    "id": 29603,
    "book": "psalms                                  ",
    "chapter": "83",
    "verse": "16",
    "text": "Empi le lor facce di vituperio;"
  },
  {
    "id": 29604,
    "book": "psalms                                  ",
    "chapter": "83",
    "verse": "17",
    "text": "Sieno svergognati, e conturbati in perpetuo;"
  },
  {
    "id": 29605,
    "book": "psalms                                  ",
    "chapter": "83",
    "verse": "18",
    "text": "E conoscano che tu, il cui Nome è il Signore83.18 Signore Esod. 6.3.,"
  }
]