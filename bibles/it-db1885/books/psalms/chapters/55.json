[
  {
    "id": 29079,
    "book": "psalms                                  ",
    "chapter": "55",
    "verse": "1",
    "text": "O DIO, porgi l'orecchio alla mia orazione;"
  },
  {
    "id": 29080,
    "book": "psalms                                  ",
    "chapter": "55",
    "verse": "2",
    "text": "Attendi a me, e rispondimi;"
  },
  {
    "id": 29081,
    "book": "psalms                                  ",
    "chapter": "55",
    "verse": "3",
    "text": "Per lo gridar del nemico, per l'oppressione dell'empio;"
  },
  {
    "id": 29082,
    "book": "psalms                                  ",
    "chapter": "55",
    "verse": "4",
    "text": "Il mio cuore è angosciato dentro di me;"
  },
  {
    "id": 29083,
    "book": "psalms                                  ",
    "chapter": "55",
    "verse": "5",
    "text": "Paura e tremito mi è sopraggiunto;"
  },
  {
    "id": 29084,
    "book": "psalms                                  ",
    "chapter": "55",
    "verse": "6",
    "text": "Onde io ho detto: Oh! avessi io delle ale, come le colombe!"
  },
  {
    "id": 29085,
    "book": "psalms                                  ",
    "chapter": "55",
    "verse": "7",
    "text": "Ecco, io me ne fuggirei lontano;"
  },
  {
    "id": 29086,
    "book": "psalms                                  ",
    "chapter": "55",
    "verse": "8",
    "text": "Io mi affretterei di scampare"
  },
  {
    "id": 29087,
    "book": "psalms                                  ",
    "chapter": "55",
    "verse": "9",
    "text": "Disperdili, Signore; dividi le lor lingue;"
  },
  {
    "id": 29088,
    "book": "psalms                                  ",
    "chapter": "55",
    "verse": "10",
    "text": "Essa n'è circondata d'intorno alle sue mura, giorno e notte;"
  },
  {
    "id": 29089,
    "book": "psalms                                  ",
    "chapter": "55",
    "verse": "11",
    "text": "Dentro di essa non vi è altro che malizie;"
  },
  {
    "id": 29090,
    "book": "psalms                                  ",
    "chapter": "55",
    "verse": "12",
    "text": "Perciocchè non è stato un mio nemico che mi ha fatto vituperio;"
  },
  {
    "id": 29091,
    "book": "psalms                                  ",
    "chapter": "55",
    "verse": "13",
    "text": "Anzi, sei stato tu, ch'eri, secondo la mia estimazione,"
  },
  {
    "id": 29092,
    "book": "psalms                                  ",
    "chapter": "55",
    "verse": "14",
    "text": "Che comunicavamo dolcemente insieme i nostri segreti,"
  },
  {
    "id": 29093,
    "book": "psalms                                  ",
    "chapter": "55",
    "verse": "15",
    "text": "Metta loro la morte la mano addosso,"
  },
  {
    "id": 29094,
    "book": "psalms                                  ",
    "chapter": "55",
    "verse": "16",
    "text": "Quant'è a me, io griderò a Dio,"
  },
  {
    "id": 29095,
    "book": "psalms                                  ",
    "chapter": "55",
    "verse": "17",
    "text": "La sera, la mattina, e in sul mezzodì, io orerò55.17 orerò Dan. 6.10. Luc. 18.1. Fat. 3.1; 10.3,9,30. 1 Tess. 5.17. e romoreggerò;"
  },
  {
    "id": 29096,
    "book": "psalms                                  ",
    "chapter": "55",
    "verse": "18",
    "text": "Egli riscuoterà l'anima mia dall'assalto che mi è dato,"
  },
  {
    "id": 29097,
    "book": "psalms                                  ",
    "chapter": "55",
    "verse": "19",
    "text": "Iddio mi udirà, e li abbatterà;"
  },
  {
    "id": 29098,
    "book": "psalms                                  ",
    "chapter": "55",
    "verse": "20",
    "text": "Hanno messa la mano addosso a quelli che vivevano in buona pace con loro;"
  },
  {
    "id": 29099,
    "book": "psalms                                  ",
    "chapter": "55",
    "verse": "21",
    "text": "Le lor bocche son più dolci che burro;"
  },
  {
    "id": 29100,
    "book": "psalms                                  ",
    "chapter": "55",
    "verse": "22",
    "text": "Rimetti nel Signore il tuo peso, ed egli ti sosterrà55.22 sosterrà Sal. 37.5. Mat. 6.25 ecc. 1 Piet. 5.7.;"
  },
  {
    "id": 29101,
    "book": "psalms                                  ",
    "chapter": "55",
    "verse": "23",
    "text": "Ma tu, o Dio, farai scender coloro nel pozzo della perdizione;"
  }
]