[
  {
    "id": 28995,
    "book": "psalms                                  ",
    "chapter": "49",
    "verse": "1",
    "text": "UDITE questo, popoli tutti;"
  },
  {
    "id": 28996,
    "book": "psalms                                  ",
    "chapter": "49",
    "verse": "2",
    "text": "E plebei, e nobili,"
  },
  {
    "id": 28997,
    "book": "psalms                                  ",
    "chapter": "49",
    "verse": "3",
    "text": "La mia bocca proferirà cose di gran sapienza;"
  },
  {
    "id": 28998,
    "book": "psalms                                  ",
    "chapter": "49",
    "verse": "4",
    "text": "Io inchinerò il mio orecchio alle sentenze;"
  },
  {
    "id": 28999,
    "book": "psalms                                  ",
    "chapter": "49",
    "verse": "5",
    "text": "Perchè temerò ne' gioni dell'avversità"
  },
  {
    "id": 29000,
    "book": "psalms                                  ",
    "chapter": "49",
    "verse": "6",
    "text": "Ve ne son molti che si confidano ne' lor beni,"
  },
  {
    "id": 29001,
    "book": "psalms                                  ",
    "chapter": "49",
    "verse": "7",
    "text": "Niuno però può riscuotere il suo fratello,"
  },
  {
    "id": 29002,
    "book": "psalms                                  ",
    "chapter": "49",
    "verse": "8",
    "text": "E il riscatto della lor propria anima non può trovarsi49.8 trovarsi Giob. 33.24.,"
  },
  {
    "id": 29003,
    "book": "psalms                                  ",
    "chapter": "49",
    "verse": "9",
    "text": "Per fare che continuino a vivere in perpetuo,"
  },
  {
    "id": 29004,
    "book": "psalms                                  ",
    "chapter": "49",
    "verse": "10",
    "text": "Conciossiachè veggano che i savi muoiono,"
  },
  {
    "id": 29005,
    "book": "psalms                                  ",
    "chapter": "49",
    "verse": "11",
    "text": "Il loro intimo pensiero è che le lor case dimoreranno in eterno,"
  },
  {
    "id": 29006,
    "book": "psalms                                  ",
    "chapter": "49",
    "verse": "12",
    "text": "E pur l'uomo che è in onore non vi dimora sempre49.12 sempre Sal. 39.5; 82.7.;"
  },
  {
    "id": 29007,
    "book": "psalms                                  ",
    "chapter": "49",
    "verse": "13",
    "text": "Questa lor via è loro una pazzia49.13 pazzia Luc. 12.20.;"
  },
  {
    "id": 29008,
    "book": "psalms                                  ",
    "chapter": "49",
    "verse": "14",
    "text": "Saranno posti sotterra, come pecore;"
  },
  {
    "id": 29009,
    "book": "psalms                                  ",
    "chapter": "49",
    "verse": "15",
    "text": "Ma Iddio riscuoterà l'anima mia dal sepolcro49.15 sepolcro Os. 13.14.;"
  },
  {
    "id": 29010,
    "book": "psalms                                  ",
    "chapter": "49",
    "verse": "16",
    "text": "Non temere, quando alcuno sarà arricchito,"
  },
  {
    "id": 29011,
    "book": "psalms                                  ",
    "chapter": "49",
    "verse": "17",
    "text": "Perciocchè, quando egli morrà non torrà seco nulla;"
  },
  {
    "id": 29012,
    "book": "psalms                                  ",
    "chapter": "49",
    "verse": "18",
    "text": "Benchè egli abbia benedetta l'anima sua in vita sua49.18 sua Luc. 12.19.;"
  },
  {
    "id": 29013,
    "book": "psalms                                  ",
    "chapter": "49",
    "verse": "19",
    "text": "Quella verrà là ove è la generazion de' suoi padri;"
  },
  {
    "id": 29014,
    "book": "psalms                                  ",
    "chapter": "49",
    "verse": "20",
    "text": "L'uomo che è in istato onorevole, e non ha intelletto,"
  }
]