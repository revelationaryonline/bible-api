[
  {
    "id": 30216,
    "book": "psalms                                  ",
    "chapter": "118",
    "verse": "1",
    "text": "CELEBRATE il Signore; perciocchè egli è buono,"
  },
  {
    "id": 30217,
    "book": "psalms                                  ",
    "chapter": "118",
    "verse": "2",
    "text": "Or dica Israele,"
  },
  {
    "id": 30218,
    "book": "psalms                                  ",
    "chapter": "118",
    "verse": "3",
    "text": "Or dica la casa d'Aaronne,"
  },
  {
    "id": 30219,
    "book": "psalms                                  ",
    "chapter": "118",
    "verse": "4",
    "text": "Or dicano quelli che temono il Signore,"
  },
  {
    "id": 30220,
    "book": "psalms                                  ",
    "chapter": "118",
    "verse": "5",
    "text": "Essendo in distretta, io invocai il Signore118.5 Signore Sal. 116.4; 120.1.;"
  },
  {
    "id": 30221,
    "book": "psalms                                  ",
    "chapter": "118",
    "verse": "6",
    "text": "Il Signore è per me; io non temerò"
  },
  {
    "id": 30222,
    "book": "psalms                                  ",
    "chapter": "118",
    "verse": "7",
    "text": "Il Signore è per me, fra quelli che mi soccorrono;"
  },
  {
    "id": 30223,
    "book": "psalms                                  ",
    "chapter": "118",
    "verse": "8",
    "text": "Meglio è sperar nel Signore,"
  },
  {
    "id": 30224,
    "book": "psalms                                  ",
    "chapter": "118",
    "verse": "9",
    "text": "Meglio è sperar nel Signore,"
  },
  {
    "id": 30225,
    "book": "psalms                                  ",
    "chapter": "118",
    "verse": "10",
    "text": "Nazioni d'ogni parte mi avevano intorniato;"
  },
  {
    "id": 30226,
    "book": "psalms                                  ",
    "chapter": "118",
    "verse": "11",
    "text": "Mi avevano circondato, ed anche accerchiao;"
  },
  {
    "id": 30227,
    "book": "psalms                                  ",
    "chapter": "118",
    "verse": "12",
    "text": "Mi avevano intorniato come api;"
  },
  {
    "id": 30228,
    "book": "psalms                                  ",
    "chapter": "118",
    "verse": "13",
    "text": "Tu mi avevi fieramente sospinto, o nemico, per farmi cadere;"
  },
  {
    "id": 30229,
    "book": "psalms                                  ",
    "chapter": "118",
    "verse": "14",
    "text": "Il Signore è la mia forza, ed il mio cantico118.14 cantico Esod. 15.2. Is. 12.2.;"
  },
  {
    "id": 30230,
    "book": "psalms                                  ",
    "chapter": "118",
    "verse": "15",
    "text": "Voce di giubilo e di vittoria è ne' tabernacoli de' giusti;"
  },
  {
    "id": 30231,
    "book": "psalms                                  ",
    "chapter": "118",
    "verse": "16",
    "text": "La destra del Signore è innalzata;"
  },
  {
    "id": 30232,
    "book": "psalms                                  ",
    "chapter": "118",
    "verse": "17",
    "text": "Io non morrò, anzi viverò,"
  },
  {
    "id": 30233,
    "book": "psalms                                  ",
    "chapter": "118",
    "verse": "18",
    "text": "Il Signore veramente mi ha gastigato;"
  },
  {
    "id": 30234,
    "book": "psalms                                  ",
    "chapter": "118",
    "verse": "19",
    "text": "Apritemi le porte di giustizia118.19 giustizia Is. 26.2.;"
  },
  {
    "id": 30235,
    "book": "psalms                                  ",
    "chapter": "118",
    "verse": "20",
    "text": "Questa è la porta del Signore118.20 Signore Sal. 24.7 ecc.,"
  },
  {
    "id": 30236,
    "book": "psalms                                  ",
    "chapter": "118",
    "verse": "21",
    "text": "Io ti celebrerò; perciocchè tu mi hai risposto118.21 risposto Sal. 116.1.,"
  },
  {
    "id": 30237,
    "book": "psalms                                  ",
    "chapter": "118",
    "verse": "22",
    "text": "La pietra che gli edificatori avevano rigettata,"
  },
  {
    "id": 30238,
    "book": "psalms                                  ",
    "chapter": "118",
    "verse": "23",
    "text": "Questo è proceduto dal Signore;"
  },
  {
    "id": 30239,
    "book": "psalms                                  ",
    "chapter": "118",
    "verse": "24",
    "text": "Questo è il giorno che il Signore ha operato:"
  },
  {
    "id": 30240,
    "book": "psalms                                  ",
    "chapter": "118",
    "verse": "25",
    "text": "Deh! Signore, ora salva;"
  },
  {
    "id": 30241,
    "book": "psalms                                  ",
    "chapter": "118",
    "verse": "26",
    "text": "Benedetto sia colui che viene nel Nome del Signore118.26 Signore Mat. 21.9; 23.39. Mar. 11.9. Luc. 19.38.;"
  },
  {
    "id": 30242,
    "book": "psalms                                  ",
    "chapter": "118",
    "verse": "27",
    "text": "Il Signore è Iddio, e ci ha fatta apparire una chiara luce118.27 luce Sal. 97.11 e rif. 1 Piet. 2.9.;"
  },
  {
    "id": 30243,
    "book": "psalms                                  ",
    "chapter": "118",
    "verse": "28",
    "text": "Tu sei il mio Dio, io ti celebrerò;"
  },
  {
    "id": 30244,
    "book": "psalms                                  ",
    "chapter": "118",
    "verse": "29",
    "text": "Celebrate il Signore; perciocchè egli è buono,"
  }
]