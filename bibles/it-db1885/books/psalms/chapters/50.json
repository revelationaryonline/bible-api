[
  {
    "id": 29015,
    "book": "psalms                                  ",
    "chapter": "50",
    "verse": "1",
    "text": "IL Signore, l'Iddio degl'iddii, ha parlato, ed ha gridato alla terra,"
  },
  {
    "id": 29016,
    "book": "psalms                                  ",
    "chapter": "50",
    "verse": "2",
    "text": "Iddio è apparito in gloria,"
  },
  {
    "id": 29017,
    "book": "psalms                                  ",
    "chapter": "50",
    "verse": "3",
    "text": "L'Iddio nostro verrà, e non se ne starà cheto;"
  },
  {
    "id": 29018,
    "book": "psalms                                  ",
    "chapter": "50",
    "verse": "4",
    "text": "Egli griderà da alto al cielo,"
  },
  {
    "id": 29019,
    "book": "psalms                                  ",
    "chapter": "50",
    "verse": "5",
    "text": "E dirà: Adunatemi i miei santi,"
  },
  {
    "id": 29020,
    "book": "psalms                                  ",
    "chapter": "50",
    "verse": "6",
    "text": "E i cieli racconteranno la sua giustizia;"
  },
  {
    "id": 29021,
    "book": "psalms                                  ",
    "chapter": "50",
    "verse": "7",
    "text": "Ascolta, popol mio, ed io parlerò;"
  },
  {
    "id": 29022,
    "book": "psalms                                  ",
    "chapter": "50",
    "verse": "8",
    "text": "Io non ti riprenderò per li tuoi sacrificii50.8 sacrificii 1 Sam. 15.22 e rif.,"
  },
  {
    "id": 29023,
    "book": "psalms                                  ",
    "chapter": "50",
    "verse": "9",
    "text": "Io non prenderò giovenchi dalla tua casa,"
  },
  {
    "id": 29024,
    "book": "psalms                                  ",
    "chapter": "50",
    "verse": "10",
    "text": "Perciocchè mie sono tutte le bestie delle selve;"
  },
  {
    "id": 29025,
    "book": "psalms                                  ",
    "chapter": "50",
    "verse": "11",
    "text": "Io conosco tutti gli uccelli de' monti;"
  },
  {
    "id": 29026,
    "book": "psalms                                  ",
    "chapter": "50",
    "verse": "12",
    "text": "Se io avessi fame, io non te lo direi;"
  },
  {
    "id": 29027,
    "book": "psalms                                  ",
    "chapter": "50",
    "verse": "13",
    "text": "Mangio io carne di tori,"
  },
  {
    "id": 29028,
    "book": "psalms                                  ",
    "chapter": "50",
    "verse": "14",
    "text": "Sacrifica lode a Dio50.14 Dio Os. 14.2. Rom. 12.1.,"
  },
  {
    "id": 29029,
    "book": "psalms                                  ",
    "chapter": "50",
    "verse": "15",
    "text": "E invocami nel giorno della distretta,"
  },
  {
    "id": 29030,
    "book": "psalms                                  ",
    "chapter": "50",
    "verse": "16",
    "text": "Ma all'empio Iddio ha detto:"
  },
  {
    "id": 29031,
    "book": "psalms                                  ",
    "chapter": "50",
    "verse": "17",
    "text": "Conciossiachè tu odii correzione50.17 correzione Rom. 2.21,22.,"
  },
  {
    "id": 29032,
    "book": "psalms                                  ",
    "chapter": "50",
    "verse": "18",
    "text": "Se tu vedi un ladro, tu prendi piacere d'essere in sua compagnia;"
  },
  {
    "id": 29033,
    "book": "psalms                                  ",
    "chapter": "50",
    "verse": "19",
    "text": "Tu metti la tua bocca al male,"
  },
  {
    "id": 29034,
    "book": "psalms                                  ",
    "chapter": "50",
    "verse": "20",
    "text": "Tu siedi, e parli contro al tuo fratello,"
  },
  {
    "id": 29035,
    "book": "psalms                                  ",
    "chapter": "50",
    "verse": "21",
    "text": "Tu hai fatte queste cose, ed io mi sono taciuto;"
  },
  {
    "id": 29036,
    "book": "psalms                                  ",
    "chapter": "50",
    "verse": "22",
    "text": "Deh! intendete questo, voi che dimenticate Iddio;"
  },
  {
    "id": 29037,
    "book": "psalms                                  ",
    "chapter": "50",
    "verse": "23",
    "text": "Chi sacrifica lode mi glorifica50.23 glorifica Rom. 12.1.,"
  }
]