  },
  {
    "id": 30141,
    "book": "psalms                                  ",
    "chapter": "111",
    "verse": "2",
    "text": "Grandi son le opere del Signore,"
  },
  {
    "id": 30142,
    "book": "psalms                                  ",
    "chapter": "111",
    "verse": "3",
    "text": "Le sue opere son gloria e magnificenza;"
  },
  {
    "id": 30143,
    "book": "psalms                                  ",
    "chapter": "111",
    "verse": "4",
    "text": "Egli ha rendute memorabili le sue maraviglie;"
  },
  {
