    "book": "psalms                                  ",
    "chapter": "111",
    "verse": "5",
    "text": "Egli dà da vivere a quelli che lo temono111.5 temono Mat. 6.25-34.;"
  },
  {
    "id": 30145,
    "book": "psalms                                  ",
    "chapter": "111",
    "verse": "6",
    "text": "Egli ha dichiarata al suo popolo la potenza delle sue opere,"
  },
  {
    "id": 30146,
    "book": "psalms                                  ",
    "chapter": "111",
    "verse": "7",
    "text": "Le opere delle sue mani son verità e dirittura;"
  },
  {
    "id": 30147,
    "book": "psalms                                  ",
    "chapter": "111",
    "verse": "8",
    "text": "Stabili in sempiterno111.8 sempiterno Is. 40.8. Mat. 5.18.,"
  },
  {
    "id": 30148,
    "book": "psalms                                  ",
    "chapter": "111",
    "verse": "9",
