[
  {
    "id": 28837,
    "book": "psalms                                  ",
    "chapter": "38",
    "verse": "1",
    "text": "SIGNORE, non correggermi nella tua indegnazione38.1 indegnazione Sal. 6.1 e rif.;"
  },
  {
    "id": 28838,
    "book": "psalms                                  ",
    "chapter": "38",
    "verse": "2",
    "text": "Perciocchè le tue saette son discese in me,"
  },
  {
    "id": 28839,
    "book": "psalms                                  ",
    "chapter": "38",
    "verse": "3",
    "text": "Egli non vi è nulla di sano nella mia carne38.3 carne Is. 1.6., per cagione della tua ira;"
  },
  {
    "id": 28840,
    "book": "psalms                                  ",
    "chapter": "38",
    "verse": "4",
    "text": "Perciocchè le mie iniquità trapassano il mio capo38.4 capo Esd. 9.6. Sal. 40.12.;"
  },
  {
    "id": 28841,
    "book": "psalms                                  ",
    "chapter": "38",
    "verse": "5",
    "text": "Le mie posteme putono, e colano,"
  },
  {
    "id": 28842,
    "book": "psalms                                  ",
    "chapter": "38",
    "verse": "6",
    "text": "Io son tutto travolto e piegato;"
  },
  {
    "id": 28843,
    "book": "psalms                                  ",
    "chapter": "38",
    "verse": "7",
    "text": "Perciocchè i miei fianchi son pieni d'infiammagione;"
  },
  {
    "id": 28844,
    "book": "psalms                                  ",
    "chapter": "38",
    "verse": "8",
    "text": "Io son tutto fiacco e trito;"
  },
  {
    "id": 28845,
    "book": "psalms                                  ",
    "chapter": "38",
    "verse": "9",
    "text": "Signore, ogni mio desiderio è nel tuo cospetto;"
  },
  {
    "id": 28846,
    "book": "psalms                                  ",
    "chapter": "38",
    "verse": "10",
    "text": "Il mio cuore è agitato, la mia forza mi lascia;"
  },
  {
    "id": 28847,
    "book": "psalms                                  ",
    "chapter": "38",
    "verse": "11",
    "text": "I miei amici ed i miei compagni se ne stanno di rincontro alla mia piaga38.11 piaga Luc. 10.31,32.;"
  },
  {
    "id": 28848,
    "book": "psalms                                  ",
    "chapter": "38",
    "verse": "12",
    "text": "E questi che cercano l'anima mia mi tendono delle reti;"
  },
  {
    "id": 28849,
    "book": "psalms                                  ",
    "chapter": "38",
    "verse": "13",
    "text": "Ma io, come se fossi sordo, non ascolto;"
  },
  {
    "id": 28850,
    "book": "psalms                                  ",
    "chapter": "38",
    "verse": "14",
    "text": "E son come un uomo che non ode;"
  },
  {
    "id": 28851,
    "book": "psalms                                  ",
    "chapter": "38",
    "verse": "15",
    "text": "Perciocchè, o Signore, io ti aspetto,"
  },
  {
    "id": 28852,
    "book": "psalms                                  ",
    "chapter": "38",
    "verse": "16",
    "text": "Perciocchè io ho detto: Fa' che non si rallegrino di me;"
  },
  {
    "id": 28853,
    "book": "psalms                                  ",
    "chapter": "38",
    "verse": "17",
    "text": "Mentre son tutto presto a cadere,"
  },
  {
    "id": 28854,
    "book": "psalms                                  ",
    "chapter": "38",
    "verse": "18",
    "text": "Mentre io dichiaro la mia iniquità38.18 iniquità Sal. 32.5. Prov. 28.13.,"
  },
  {
    "id": 28855,
    "book": "psalms                                  ",
    "chapter": "38",
    "verse": "19",
    "text": "I miei nemici vivono, e si fortificano;"
  },
  {
    "id": 28856,
    "book": "psalms                                  ",
    "chapter": "38",
    "verse": "20",
    "text": "Quelli, dico, che mi rendono mal per bene;"
  },
  {
    "id": 28857,
    "book": "psalms                                  ",
    "chapter": "38",
    "verse": "21",
    "text": "Signore, non abbandonarmi;"
  },
  {
    "id": 28858,
    "book": "psalms                                  ",
    "chapter": "38",
    "verse": "22",
    "text": "Affrettati al mio aiuto,"
  }
]