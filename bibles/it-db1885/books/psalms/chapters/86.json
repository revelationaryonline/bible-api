[
  {
    "id": 29631,
    "book": "psalms                                  ",
    "chapter": "86",
    "verse": "1",
    "text": "O SIGNORE, inchina l'orecchio tuo, e rispondimi;"
  },
  {
    "id": 29632,
    "book": "psalms                                  ",
    "chapter": "86",
    "verse": "2",
    "text": "Guarda l'anima mia; perciocchè io mi studio a pietà;"
  },
  {
    "id": 29633,
    "book": "psalms                                  ",
    "chapter": "86",
    "verse": "3",
    "text": "O Signore, abbi pietà di me;"
  },
  {
    "id": 29634,
    "book": "psalms                                  ",
    "chapter": "86",
    "verse": "4",
    "text": "Rallegra l'anima del tuo servitore;"
  },
  {
    "id": 29635,
    "book": "psalms                                  ",
    "chapter": "86",
    "verse": "5",
    "text": "Perciocchè tu, Signore, sei buono e perdonatore;"
  },
  {
    "id": 29636,
    "book": "psalms                                  ",
    "chapter": "86",
    "verse": "6",
    "text": "O Signore, porgi gli orecchi alla mia orazione;"
  },
  {
    "id": 29637,
    "book": "psalms                                  ",
    "chapter": "86",
    "verse": "7",
    "text": "Io t'invoco nel giorno della mia distretta86.7 distretta Sal. 50.15 e rif.;"
  },
  {
    "id": 29638,
    "book": "psalms                                  ",
    "chapter": "86",
    "verse": "8",
    "text": "Non vi è niuno pari a te fra gl'iddii, o Signore86.8 Signore Esod. 15.11 e rif.;"
  },
  {
    "id": 29639,
    "book": "psalms                                  ",
    "chapter": "86",
    "verse": "9",
    "text": "Tutte le genti le quali tu hai fatte, verranno,"
  },
  {
    "id": 29640,
    "book": "psalms                                  ",
    "chapter": "86",
    "verse": "10",
    "text": "Perciocchè tu sei grande, e facitore di maraviglie;"
  },
  {
    "id": 29641,
    "book": "psalms                                  ",
    "chapter": "86",
    "verse": "11",
    "text": "O Signore, insegnami la tua via86.11 via Sal. 25.4 e rif.,"
  },
  {
    "id": 29642,
    "book": "psalms                                  ",
    "chapter": "86",
    "verse": "12",
    "text": "Io ti celebrerò, o Signore Iddio mio, con tutto il mio cuore;"
  },
  {
    "id": 29643,
    "book": "psalms                                  ",
    "chapter": "86",
    "verse": "13",
    "text": "Perciocchè la tua benignità è grande sopra me;"
  },
  {
    "id": 29644,
    "book": "psalms                                  ",
    "chapter": "86",
    "verse": "14",
    "text": "O Dio, uomini superbi si son levati contro a me;"
  },
  {
    "id": 29645,
    "book": "psalms                                  ",
    "chapter": "86",
    "verse": "15",
    "text": "Ma tu, Signore, sei l'Iddio misericordioso e pietoso,"
  },
  {
    "id": 29646,
    "book": "psalms                                  ",
    "chapter": "86",
    "verse": "16",
    "text": "Volgi la tua faccia verso me, ed abbi pietà di me;"
  },
  {
    "id": 29647,
    "book": "psalms                                  ",
    "chapter": "86",
    "verse": "17",
    "text": "Opera inverso me qualche miracolo in bene,"
  }
]