[
  {
    "id": 29868,
    "book": "psalms                                  ",
    "chapter": "102",
    "verse": "1",
    "text": "SIGNORE, ascolta la mia orazione,"
  },
  {
    "id": 29869,
    "book": "psalms                                  ",
    "chapter": "102",
    "verse": "2",
    "text": "Non nasconder la tua faccia da me102.2 me Sal. 27.9.;"
  },
  {
    "id": 29870,
    "book": "psalms                                  ",
    "chapter": "102",
    "verse": "3",
    "text": "Perciocchè i miei giorni son venuti meno come fumo102.3 fumo Giac. 4.14.,"
  },
  {
    "id": 29871,
    "book": "psalms                                  ",
    "chapter": "102",
    "verse": "4",
    "text": "Il mio cuore è stato percosso come erba,"
  },
  {
    "id": 29872,
    "book": "psalms                                  ",
    "chapter": "102",
    "verse": "5",
    "text": "Le mie ossa sono attaccate alla mia carne,"
  },
  {
    "id": 29873,
    "book": "psalms                                  ",
    "chapter": "102",
    "verse": "6",
    "text": "Io son divenuto simile al pellicano del deserto;"
  },
  {
    "id": 29874,
    "book": "psalms                                  ",
    "chapter": "102",
    "verse": "7",
    "text": "Io vegghio, e sono"
  },
  {
    "id": 29875,
    "book": "psalms                                  ",
    "chapter": "102",
    "verse": "8",
    "text": "Quelli che sono infuriati contro a me fanno delle esecrazioni di me102.8 me Fat. 23.12.."
  },
  {
    "id": 29876,
    "book": "psalms                                  ",
    "chapter": "102",
    "verse": "9",
    "text": "Perciocchè io ho mangiata la cenere come pane,"
  },
  {
    "id": 29877,
    "book": "psalms                                  ",
    "chapter": "102",
    "verse": "10",
    "text": "Per la tua indegnazione, e per lo tuo cruccio;"
  },
  {
    "id": 29878,
    "book": "psalms                                  ",
    "chapter": "102",
    "verse": "11",
    "text": "I miei giorni son come l'ombra che dichina102.11 dichina Giob. 14.2 e rif.;"
  },
  {
    "id": 29879,
    "book": "psalms                                  ",
    "chapter": "102",
    "verse": "12",
    "text": "Ma tu, Signore, dimori in eterno102.12 eterno Sal. 9.7. Lam. 5.19."
  },
  {
    "id": 29880,
    "book": "psalms                                  ",
    "chapter": "102",
    "verse": "13",
    "text": "Tu ti leverai, tu avrai compassione di Sion;"
  },
  {
    "id": 29881,
    "book": "psalms                                  ",
    "chapter": "102",
    "verse": "14",
    "text": "Imperocchè i tuoi servitori hanno affezione alle pietre di essa,"
  },
  {
    "id": 29882,
    "book": "psalms                                  ",
    "chapter": "102",
    "verse": "15",
    "text": "E le genti temeranno il Nome del Signore,"
  },
  {
    "id": 29883,
    "book": "psalms                                  ",
    "chapter": "102",
    "verse": "16",
    "text": "Quando il Signore avrà riedificata Sion,"
  },
  {
    "id": 29884,
    "book": "psalms                                  ",
    "chapter": "102",
    "verse": "17",
    "text": "Ed avrà volto lo sguardo all'orazione de' desolati102.17 desolati Neem. 1.6,11; 2.8.,"
  },
  {
    "id": 29885,
    "book": "psalms                                  ",
    "chapter": "102",
    "verse": "18",
    "text": "Ciò sarà scritto all'età a venire102.18 venire Rom. 15.4. 1 Cor. 10.11.;"
  },
  {
    "id": 29886,
    "book": "psalms                                  ",
    "chapter": "102",
    "verse": "19",
    "text": "Perciocchè egli avrà riguardato dall'alto luogo della sua santità;"
  },
  {
    "id": 29887,
    "book": "psalms                                  ",
    "chapter": "102",
    "verse": "20",
    "text": "Per udire i gemiti de' prigioni102.20 prigioni Sal. 79.11.;"
  },
  {
    "id": 29888,
    "book": "psalms                                  ",
    "chapter": "102",
    "verse": "21",
    "text": "Acciocchè si narri in Sion il Nome del Signore,"
  },
  {
    "id": 29889,
    "book": "psalms                                  ",
    "chapter": "102",
    "verse": "22",
    "text": "Quando i popoli e i regni saranno raunati insieme,"
  },
  {
    "id": 29890,
    "book": "psalms                                  ",
    "chapter": "102",
    "verse": "23",
    "text": "Egli ha tra via abbattute le mie forze;"
  },
  {
    "id": 29891,
    "book": "psalms                                  ",
    "chapter": "102",
    "verse": "24",
    "text": "Io dirò: O Dio mio, non farmi trapassare al mezzo de' miei dì102.24 dì Is. 38.10.;"
  },
  {
    "id": 29892,
    "book": "psalms                                  ",
    "chapter": "102",
    "verse": "25",
    "text": "Tu fondasti già la terra;"
  },
  {
    "id": 29893,
    "book": "psalms                                  ",
    "chapter": "102",
    "verse": "26",
    "text": "Queste cose periranno, ma tu dimorerai;"
  },
  {
    "id": 29894,
    "book": "psalms                                  ",
    "chapter": "102",
    "verse": "27",
    "text": "Ma tu sei sempre lo stesso102.27 stesso Mal. 3.6. Ebr. 13.8. Giac. 1.17.,"
  },
  {
    "id": 29895,
    "book": "psalms                                  ",
    "chapter": "102",
    "verse": "28",
    "text": "I figliuoli de' tuoi servitori abiteranno,"
  }
]