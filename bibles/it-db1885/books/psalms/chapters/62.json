[
  {
    "id": 29174,
    "book": "psalms                                  ",
    "chapter": "62",
    "verse": "1",
    "text": "L'ANIMA mia si acqueta in Dio solo;"
  },
  {
    "id": 29175,
    "book": "psalms                                  ",
    "chapter": "62",
    "verse": "2",
    "text": "Egli solo è la mia rocca e la mia salvezza,"
  },
  {
    "id": 29176,
    "book": "psalms                                  ",
    "chapter": "62",
    "verse": "3",
    "text": "Infino a quando vi avventerete sopra un uomo?"
  },
  {
    "id": 29177,
    "book": "psalms                                  ",
    "chapter": "62",
    "verse": "4",
    "text": "Essi non consigliano d'altro che di sospinger giù quest'uomo dalla sua altezza;"
  },
  {
    "id": 29178,
    "book": "psalms                                  ",
    "chapter": "62",
    "verse": "5",
    "text": "Anima mia, acquetati in Dio solo;"
  },
  {
    "id": 29179,
    "book": "psalms                                  ",
    "chapter": "62",
    "verse": "6",
    "text": "Egli solo è la mia rocca e la mia salvezza;"
  },
  {
    "id": 29180,
    "book": "psalms                                  ",
    "chapter": "62",
    "verse": "7",
    "text": "In Dio è la mia salvezza e la mia gloria;"
  },
  {
    "id": 29181,
    "book": "psalms                                  ",
    "chapter": "62",
    "verse": "8",
    "text": "Confidatevi in lui, o popolo, in ogni tempo62.8 tempo Sal. 25.2 e rif.;"
  },
  {
    "id": 29182,
    "book": "psalms                                  ",
    "chapter": "62",
    "verse": "9",
    "text": "Gli uomini volgari non sono altro che vanità,"
  },
  {
    "id": 29183,
    "book": "psalms                                  ",
    "chapter": "62",
    "verse": "10",
    "text": "Non vi confidate in oppressione,"
  },
  {
    "id": 29184,
    "book": "psalms                                  ",
    "chapter": "62",
    "verse": "11",
    "text": "Iddio ha parlato una volta,"
  },
  {
    "id": 29185,
    "book": "psalms                                  ",
    "chapter": "62",
    "verse": "12",
    "text": "E che a te, Signore, appartiene la benignità62.12 benignità Sal. 103.8. Dan. 9.9.;"
  }
]