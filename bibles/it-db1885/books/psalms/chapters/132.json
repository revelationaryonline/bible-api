[
  {
    "id": 30498,
    "book": "psalms                                  ",
    "chapter": "132",
    "verse": "1",
    "text": "RICORDATI, Signore, di Davide,"
  },
  {
    "id": 30499,
    "book": "psalms                                  ",
    "chapter": "132",
    "verse": "2",
    "text": "Come egli giurò al Signore,"
  },
  {
    "id": 30500,
    "book": "psalms                                  ",
    "chapter": "132",
    "verse": "3",
    "text": "Se io entro nel tabernacolo della mia casa,"
  },
  {
    "id": 30501,
    "book": "psalms                                  ",
    "chapter": "132",
    "verse": "4",
    "text": "Se do alcun sonno agli occhi miei,"
  },
  {
    "id": 30502,
    "book": "psalms                                  ",
    "chapter": "132",
    "verse": "5",
    "text": "Infino a tanto che io abbia trovato un luogo al Signore,"
  },
  {
    "id": 30503,
    "book": "psalms                                  ",
    "chapter": "132",
    "verse": "6",
    "text": "Ecco, noi abbiamo udito che l'Arca era stata nella contrada Efratea;"
  },
  {
    "id": 30504,
    "book": "psalms                                  ",
    "chapter": "132",
    "verse": "7",
    "text": "Entriamo negli abitacoli del Signore;"
  },
  {
    "id": 30505,
    "book": "psalms                                  ",
    "chapter": "132",
    "verse": "8",
    "text": "Levati, Signore132.8 Signore Num. 10.35. 2 Cron. 6.41,42.;"
  },
  {
    "id": 30506,
    "book": "psalms                                  ",
    "chapter": "132",
    "verse": "9",
    "text": "I tuoi sacerdoti sieno rivestiti di giustizia,"
  },
  {
    "id": 30507,
    "book": "psalms                                  ",
    "chapter": "132",
    "verse": "10",
    "text": "Per amor di Davide, tuo servitore,"
  },
  {
    "id": 30508,
    "book": "psalms                                  ",
    "chapter": "132",
    "verse": "11",
    "text": "Il Signore giurò verità a Davide132.11 Davide Sal. 89.3,4,33 ecc.,"
  },
  {
    "id": 30509,
    "book": "psalms                                  ",
    "chapter": "132",
    "verse": "12",
    "text": "Se i tuoi figliuoli osservano il mio patto,"
  },
  {
    "id": 30510,
    "book": "psalms                                  ",
    "chapter": "132",
    "verse": "13",
    "text": "Perciocchè il Signore ha eletta Sion;"
  },
  {
    "id": 30511,
    "book": "psalms                                  ",
    "chapter": "132",
    "verse": "14",
    "text": "Questo è il mio riposo in perpetuo,"
  },
  {
    "id": 30512,
    "book": "psalms                                  ",
    "chapter": "132",
    "verse": "15",
    "text": "Io benedirò largamente la sua vittuaglia;"
  },
  {
    "id": 30513,
    "book": "psalms                                  ",
    "chapter": "132",
    "verse": "16",
    "text": "E vestirò i suoi sacerdoti di vesti di liberazione;"
  },
  {
    "id": 30514,
    "book": "psalms                                  ",
    "chapter": "132",
    "verse": "17",
    "text": "Quivi farò germogliare un corno a Davide132.17 Davide Luc. 1.69.;"
  },
  {
    "id": 30515,
    "book": "psalms                                  ",
    "chapter": "132",
    "verse": "18",
    "text": "Io vestirò i suoi nemici di vergogna;"
  }
]