[
  {
    "id": 29137,
    "book": "psalms                                  ",
    "chapter": "59",
    "verse": "1",
    "text": "DIO mio, riscuotimi da' miei nemici;"
  },
  {
    "id": 29138,
    "book": "psalms                                  ",
    "chapter": "59",
    "verse": "2",
    "text": "Riscuotimi dagli operatori d'iniquità,"
  },
  {
    "id": 29139,
    "book": "psalms                                  ",
    "chapter": "59",
    "verse": "3",
    "text": "Perciocchè, ecco, han posti agguati all'anima mia;"
  },
  {
    "id": 29140,
    "book": "psalms                                  ",
    "chapter": "59",
    "verse": "4",
    "text": "Benchè, non vi sia iniquità in me59.4 me 1 Sam. 24.11., pur corrono, e si apparecchiano;"
  },
  {
    "id": 29141,
    "book": "psalms                                  ",
    "chapter": "59",
    "verse": "5",
    "text": "Tu, dico, Signore Iddio degli eserciti, Dio d'Israele,"
  },
  {
    "id": 29142,
    "book": "psalms                                  ",
    "chapter": "59",
    "verse": "6",
    "text": "La sera vanno e vengono; romoreggiano come cani,"
  },
  {
    "id": 29143,
    "book": "psalms                                  ",
    "chapter": "59",
    "verse": "7",
    "text": "Ecco, sgorgano parole colla lor bocca;"
  },
  {
    "id": 29144,
    "book": "psalms                                  ",
    "chapter": "59",
    "verse": "8",
    "text": "Ma tu, Signore, ti riderai di loro;"
  },
  {
    "id": 29145,
    "book": "psalms                                  ",
    "chapter": "59",
    "verse": "9",
    "text": "Io mi guarderò dalla lor forza, riducendomi a te;"
  },
  {
    "id": 29146,
    "book": "psalms                                  ",
    "chapter": "59",
    "verse": "10",
    "text": "L'Iddio mio benigno mi verrà ad incontrare;"
  },
  {
    "id": 29147,
    "book": "psalms                                  ",
    "chapter": "59",
    "verse": "11",
    "text": "Non ucciderli già; che talora il mio popolo non lo dimentichi;"
  },
  {
    "id": 29148,
    "book": "psalms                                  ",
    "chapter": "59",
    "verse": "12",
    "text": "Per lo peccato della lor bocca, per le parole delle lor labbra59.12 labbra Prov. 12.13; 18.7.;"
  },
  {
    "id": 29149,
    "book": "psalms                                  ",
    "chapter": "59",
    "verse": "13",
    "text": "Distruggili nel tuo furore; distruggili sì che non sieno più;"
  },
  {
    "id": 29150,
    "book": "psalms                                  ",
    "chapter": "59",
    "verse": "14",
    "text": "Vadano pure, e vengano la sera; romoreggino come cani,"
  },
  {
    "id": 29151,
    "book": "psalms                                  ",
    "chapter": "59",
    "verse": "15",
    "text": "Andranno tapinando per trovar da mangiare;"
  },
  {
    "id": 29152,
    "book": "psalms                                  ",
    "chapter": "59",
    "verse": "16",
    "text": "Ma io canterò la tua potenza,"
  },
  {
    "id": 29153,
    "book": "psalms                                  ",
    "chapter": "59",
    "verse": "17",
    "text": "O mia forza59.17 forza Sal. 18.1 e rif., io ti salmeggerò;"
  }
]