[
  {
    "id": 29953,
    "book": "psalms                                  ",
    "chapter": "105",
    "verse": "1",
    "text": "CELEBRATE il Signore; predicate il suo Nome;"
  },
  {
    "id": 29954,
    "book": "psalms                                  ",
    "chapter": "105",
    "verse": "2",
    "text": "Cantategli, salmeggiategli,"
  },
  {
    "id": 29955,
    "book": "psalms                                  ",
    "chapter": "105",
    "verse": "3",
    "text": "Gloriatevi nel Nome della sua santità;"
  },
  {
    "id": 29956,
    "book": "psalms                                  ",
    "chapter": "105",
    "verse": "4",
    "text": "Cercate il Signore, e la sua forza;"
  },
  {
    "id": 29957,
    "book": "psalms                                  ",
    "chapter": "105",
    "verse": "5",
    "text": "Ricordate le sue maraviglie ch'egli ha fatte;"
  },
  {
    "id": 29958,
    "book": "psalms                                  ",
    "chapter": "105",
    "verse": "6",
    "text": "O voi, progenie d'Abrahamo, suo servitore;"
  },
  {
    "id": 29959,
    "book": "psalms                                  ",
    "chapter": "105",
    "verse": "7",
    "text": "Egli è il Signore Iddio nostro;"
  },
  {
    "id": 29960,
    "book": "psalms                                  ",
    "chapter": "105",
    "verse": "8",
    "text": "Egli si ricorda in eterno del suo patto105.8 patto Luc. 1.72.,"
  },
  {
    "id": 29961,
    "book": "psalms                                  ",
    "chapter": "105",
    "verse": "9",
    "text": "Del suo patto, ch'egli fece con Abrahamo105.9 Abrahamo Gen. 22.16,17. Ebr. 6.17.;"
  },
  {
    "id": 29962,
    "book": "psalms                                  ",
    "chapter": "105",
    "verse": "10",
    "text": "Il quale egli confermò a Giacobbe per istatuto,"
  },
  {
    "id": 29963,
    "book": "psalms                                  ",
    "chapter": "105",
    "verse": "11",
    "text": "Dicendo: Io ti darò il paese di Canaan105.11 Canaan Gen. 13.15 e rif.,"
  },
  {
    "id": 29964,
    "book": "psalms                                  ",
    "chapter": "105",
    "verse": "12",
    "text": "Quantunque fosser ben poca gente,"
  },
  {
    "id": 29965,
    "book": "psalms                                  ",
    "chapter": "105",
    "verse": "13",
    "text": "E mentre essi andavano da una gente ad un'altra,"
  },
  {
    "id": 29966,
    "book": "psalms                                  ",
    "chapter": "105",
    "verse": "14",
    "text": "Egli non permise che alcuno li oppressasse105.14 oppressasse Gen. 35.5.;"
  },
  {
    "id": 29967,
    "book": "psalms                                  ",
    "chapter": "105",
    "verse": "15",
    "text": "E disse: Non toccate i miei unti,"
  },
  {
    "id": 29968,
    "book": "psalms                                  ",
    "chapter": "105",
    "verse": "16",
    "text": "Poi egli chiamò la fame sopra la terra105.16 terra Gen. 41.54.;"
  },
  {
    "id": 29969,
    "book": "psalms                                  ",
    "chapter": "105",
    "verse": "17",
    "text": "Egli aveva mandato dinanzi a loro un uomo,"
  },
  {
    "id": 29970,
    "book": "psalms                                  ",
    "chapter": "105",
    "verse": "18",
    "text": "I cui piedi furono serrati ne' ceppi;"
  },
  {
    "id": 29971,
    "book": "psalms                                  ",
    "chapter": "105",
    "verse": "19",
    "text": "La parola del Signore lo tenne al cimento,"
  },
  {
    "id": 29972,
    "book": "psalms                                  ",
    "chapter": "105",
    "verse": "20",
    "text": "Allora il re mandò a farlo sciorre105.20 sciorre Gen. 41.14 ecc.;"
  },
  {
    "id": 29973,
    "book": "psalms                                  ",
    "chapter": "105",
    "verse": "21",
    "text": "Egli lo costituì padrone sopra la sua casa,"
  },
  {
    "id": 29974,
    "book": "psalms                                  ",
    "chapter": "105",
    "verse": "22",
    "text": "Per tenere a freno i suoi principi a suo senno;"
  },
  {
    "id": 29975,
    "book": "psalms                                  ",
    "chapter": "105",
    "verse": "23",
    "text": "Poi Israele entrò in Egitto105.23 Egitto Gen. 46.6.;"
  },
  {
    "id": 29976,
    "book": "psalms                                  ",
    "chapter": "105",
    "verse": "24",
    "text": "E Iddio fece grandemente moltiplicare il suo popolo;"
  },
  {
    "id": 29977,
    "book": "psalms                                  ",
    "chapter": "105",
    "verse": "25",
    "text": "Egli rivolse il cuor loro a odiare il suo popolo,"
  },
  {
    "id": 29978,
    "book": "psalms                                  ",
    "chapter": "105",
    "verse": "26",
    "text": "Egli mandò Mosè, suo servitore;"
  },
  {
    "id": 29979,
    "book": "psalms                                  ",
    "chapter": "105",
    "verse": "27",
    "text": "Essi eseguirono fra loro i miracoli ch'egli aveva loro detti,"
  },
  {
    "id": 29980,
    "book": "psalms                                  ",
    "chapter": "105",
    "verse": "28",
    "text": "Egli mandò le tenebre, e fece oscurar l'aria;"
  },
  {
    "id": 29981,
    "book": "psalms                                  ",
    "chapter": "105",
    "verse": "29",
    "text": "Egli cangiò le acque loro in sangue,"
  },
  {
    "id": 29982,
    "book": "psalms                                  ",
    "chapter": "105",
    "verse": "30",
    "text": "La terra loro produsse rane,"
  },
  {
    "id": 29983,
    "book": "psalms                                  ",
    "chapter": "105",
    "verse": "31",
    "text": "Alla sua parola venne una mischia d'insetti,"
  },
  {
    "id": 29984,
    "book": "psalms                                  ",
    "chapter": "105",
    "verse": "32",
    "text": "Egli mutò le lor pioggie in gragnuola,"
  },
  {
    "id": 29985,
    "book": "psalms                                  ",
    "chapter": "105",
    "verse": "33",
    "text": "E percosse le lor vigne, e i lor fichi;"
  },
  {
    "id": 29986,
    "book": "psalms                                  ",
    "chapter": "105",
    "verse": "34",
    "text": "Alla sua parola vennero locuste,"
  },
  {
    "id": 29987,
    "book": "psalms                                  ",
    "chapter": "105",
    "verse": "35",
    "text": "Che rosero tutta l'erba nel lor paese,"
  },
  {
    "id": 29988,
    "book": "psalms                                  ",
    "chapter": "105",
    "verse": "36",
    "text": "Poi egli percosse ogni primogenito nel lor paese105.36 paese Esod. 12.29.,"
  },
  {
    "id": 29989,
    "book": "psalms                                  ",
    "chapter": "105",
    "verse": "37",
    "text": "E condusse fuori Israele con oro e con argento105.37 argento Esod. 12.35,36.;"
  },
  {
    "id": 29990,
    "book": "psalms                                  ",
    "chapter": "105",
    "verse": "38",
    "text": "Gli Egizi si rallegrarono della lor partita;"
  },
  {
    "id": 29991,
    "book": "psalms                                  ",
    "chapter": "105",
    "verse": "39",
    "text": "Egli distese la nuvola, per coverta;"
  },
  {
    "id": 29992,
    "book": "psalms                                  ",
    "chapter": "105",
    "verse": "40",
    "text": "Alla lor richiesta egli addusse delle quaglie,"
  },
  {
    "id": 29993,
    "book": "psalms                                  ",
    "chapter": "105",
    "verse": "41",
    "text": "Egli aperse la roccia, e ne colarono acque105.41 acque Esod. 17.6 e rif.;"
  },
  {
    "id": 29994,
    "book": "psalms                                  ",
    "chapter": "105",
    "verse": "42",
    "text": "Perciocchè egli si ricordò della parola della sua santità,"
  },
  {
    "id": 29995,
    "book": "psalms                                  ",
    "chapter": "105",
    "verse": "43",
    "text": "E trasse fuori il suo popolo con allegrezza,"
  },
  {
    "id": 29996,
    "book": "psalms                                  ",
    "chapter": "105",
    "verse": "44",
    "text": "E diede loro i paesi delle genti;"
  },
  {
    "id": 29997,
    "book": "psalms                                  ",
    "chapter": "105",
    "verse": "45",
    "text": "Acciocchè osservassero i suoi statuti,"
  }
]