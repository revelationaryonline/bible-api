[
  {
    "id": 28797,
    "book": "psalms                                  ",
    "chapter": "37",
    "verse": "1",
    "text": "NON crucciarti per cagion de' maligni;"
  },
  {
    "id": 28798,
    "book": "psalms                                  ",
    "chapter": "37",
    "verse": "2",
    "text": "Perciocchè saran di subito ricisi come fieno,"
  },
  {
    "id": 28799,
    "book": "psalms                                  ",
    "chapter": "37",
    "verse": "3",
    "text": "Confidati nel Signore37.3 Signore Sal. 25.2 e rif., e fa' bene;"
  },
  {
    "id": 28800,
    "book": "psalms                                  ",
    "chapter": "37",
    "verse": "4",
    "text": "E prendi il tuo diletto nel Signore,"
  },
  {
    "id": 28801,
    "book": "psalms                                  ",
    "chapter": "37",
    "verse": "5",
    "text": "Rimetti la tua via nel Signore;"
  },
  {
    "id": 28802,
    "book": "psalms                                  ",
    "chapter": "37",
    "verse": "6",
    "text": "E produrrà fuori la tua giustizia, come la luce;"
  },
  {
    "id": 28803,
    "book": "psalms                                  ",
    "chapter": "37",
    "verse": "7",
    "text": "Attendi il Signore in silenzio37.7 silenzio Is. 30.15. Lam. 3.26.;"
  },
  {
    "id": 28804,
    "book": "psalms                                  ",
    "chapter": "37",
    "verse": "8",
    "text": "Rimanti dell'ira, e lascia il cruccio;"
  },
  {
    "id": 28805,
    "book": "psalms                                  ",
    "chapter": "37",
    "verse": "9",
    "text": "Perciocchè i maligni saranno sterminati37.9 sterminati Giob. 27.13,14.;"
  },
  {
    "id": 28806,
    "book": "psalms                                  ",
    "chapter": "37",
    "verse": "10",
    "text": "Fra breve spazio l'empio non sarà più;"
  },
  {
    "id": 28807,
    "book": "psalms                                  ",
    "chapter": "37",
    "verse": "11",
    "text": "Ma i mansueti possederanno la terra37.11 terra Mat. 5.5.,"
  },
  {
    "id": 28808,
    "book": "psalms                                  ",
    "chapter": "37",
    "verse": "12",
    "text": "L'empio fa delle macchinazioni contro al giusto,"
  },
  {
    "id": 28809,
    "book": "psalms                                  ",
    "chapter": "37",
    "verse": "13",
    "text": "Il Signore si riderà di lui;"
  },
  {
    "id": 28810,
    "book": "psalms                                  ",
    "chapter": "37",
    "verse": "14",
    "text": "Gli empi hanno tratta la spada,"
  },
  {
    "id": 28811,
    "book": "psalms                                  ",
    "chapter": "37",
    "verse": "15",
    "text": "La loro spada entrerà loro nel cuore,"
  },
  {
    "id": 28812,
    "book": "psalms                                  ",
    "chapter": "37",
    "verse": "16",
    "text": "Meglio vale il poco del giusto,"
  },
  {
    "id": 28813,
    "book": "psalms                                  ",
    "chapter": "37",
    "verse": "17",
    "text": "Perciocchè le braccia degli empi saranno rotte;"
  },
  {
    "id": 28814,
    "book": "psalms                                  ",
    "chapter": "37",
    "verse": "18",
    "text": "Il Signore conosce i giorni37.18 giorni Sal. 1.6; 31.7. degli uomini intieri;"
  },
  {
    "id": 28815,
    "book": "psalms                                  ",
    "chapter": "37",
    "verse": "19",
    "text": "Essi non saran confusi nel tempo dell'avversità;"
  },
  {
    "id": 28816,
    "book": "psalms                                  ",
    "chapter": "37",
    "verse": "20",
    "text": "Ma gli empi periranno;"
  },
  {
    "id": 28817,
    "book": "psalms                                  ",
    "chapter": "37",
    "verse": "21",
    "text": "L'empio prende in prestanza, e non rende;"
  },
  {
    "id": 28818,
    "book": "psalms                                  ",
    "chapter": "37",
    "verse": "22",
    "text": "Perciocchè i benedetti dal Signore erederanno la terra;"
  },
  {
    "id": 28819,
    "book": "psalms                                  ",
    "chapter": "37",
    "verse": "23",
    "text": "I passi dell'uomo, la cui via il Signore gradisce,"
  },
  {
    "id": 28820,
    "book": "psalms                                  ",
    "chapter": "37",
    "verse": "24",
    "text": "Se cade, non è però atterrato37.24 atterrato Sal. 91.12. Prov. 24.16. 2 Cor. 4.9.;"
  },
  {
    "id": 28821,
    "book": "psalms                                  ",
    "chapter": "37",
    "verse": "25",
    "text": "Io sono stato fanciullo, e sono eziandio divenuto vecchio,"
  },
  {
    "id": 28822,
    "book": "psalms                                  ",
    "chapter": "37",
    "verse": "26",
    "text": "Egli tuttodì dona e presta37.26 presta Deut. 15.8,10. Sal. 112.5,9. Mat. 5.42.;"
  },
  {
    "id": 28823,
    "book": "psalms                                  ",
    "chapter": "37",
    "verse": "27",
    "text": "Ritratti dal male, e fa' il bene37.27 bene Sal. 34.14. Is. 1.16,17.;"
  },
  {
    "id": 28824,
    "book": "psalms                                  ",
    "chapter": "37",
    "verse": "28",
    "text": "Perciocchè il Signore ama la dirittura,"
  },
  {
    "id": 28825,
    "book": "psalms                                  ",
    "chapter": "37",
    "verse": "29",
    "text": "I giusti erederanno la terra;"
  },
  {
    "id": 28826,
    "book": "psalms                                  ",
    "chapter": "37",
    "verse": "30",
    "text": "La bocca del giusto risuona sapienza37.30 sapienza Mat. 12.35.,"
  },
  {
    "id": 28827,
    "book": "psalms                                  ",
    "chapter": "37",
    "verse": "31",
    "text": "La Legge dell'Iddio suo è nel suo cuore37.31 cuore Deut. 6.6. Sal. 40.8; 119.11,98.;"
  },
  {
    "id": 28828,
    "book": "psalms                                  ",
    "chapter": "37",
    "verse": "32",
    "text": "L'empio spia il giusto,"
  },
  {
    "id": 28829,
    "book": "psalms                                  ",
    "chapter": "37",
    "verse": "33",
    "text": "Il Signore non glielo lascerà nelle mani37.33 mani 2 Piet. 2.9.,"
  },
  {
    "id": 28830,
    "book": "psalms                                  ",
    "chapter": "37",
    "verse": "34",
    "text": "Aspetta il Signore37.34 Signore Prov. 20.22., e guarda la sua via,"
  },
  {
    "id": 28831,
    "book": "psalms                                  ",
    "chapter": "37",
    "verse": "35",
    "text": "Io ho veduto l'empio possente37.35 possente Giob. 5.3.,"
  },
  {
    "id": 28832,
    "book": "psalms                                  ",
    "chapter": "37",
    "verse": "36",
    "text": "Ma egli è passato via37.36 via Giob. 20.5 ecc. Sal. 73.18-20.; ed ecco, egli non è più;"
  },
  {
    "id": 28833,
    "book": "psalms                                  ",
    "chapter": "37",
    "verse": "37",
    "text": "Guarda l'integrità, e riguarda alla dirittura;"
  },
  {
    "id": 28834,
    "book": "psalms                                  ",
    "chapter": "37",
    "verse": "38",
    "text": "Ma i trasgressori saranno distrutti tutti quanti;"
  },
  {
    "id": 28835,
    "book": "psalms                                  ",
    "chapter": "37",
    "verse": "39",
    "text": "Ma la salute de' giusti è dal Signore37.39 Signore Sal. 3.8.;"
  },
  {
    "id": 28836,
    "book": "psalms                                  ",
    "chapter": "37",
    "verse": "40",
    "text": "Ed il Signore li aiuta e li libera37.40 libera Is. 31.5. Fat. 12.11.;"
  }
]