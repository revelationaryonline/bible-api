[
  {
    "id": 29825,
    "book": "psalms                                  ",
    "chapter": "97",
    "verse": "1",
    "text": "IL Signore regna97.1 regna Sal. 96.10 e rif.: gioisca la terra;"
  },
  {
    "id": 29826,
    "book": "psalms                                  ",
    "chapter": "97",
    "verse": "2",
    "text": "Nuvola e caligine sono d'intorno a lui;"
  },
  {
    "id": 29827,
    "book": "psalms                                  ",
    "chapter": "97",
    "verse": "3",
    "text": "Fuoco va davanti a lui97.3 lui Dan. 7.10.,"
  },
  {
    "id": 29828,
    "book": "psalms                                  ",
    "chapter": "97",
    "verse": "4",
    "text": "I suoi folgori alluminano il mondo;"
  },
  {
    "id": 29829,
    "book": "psalms                                  ",
    "chapter": "97",
    "verse": "5",
    "text": "I monti si struggono come cera per la presenza del Signore,"
  },
  {
    "id": 29830,
    "book": "psalms                                  ",
    "chapter": "97",
    "verse": "6",
    "text": "I cieli predicano la sua giustizia97.6 giustizia Sal. 19.1; 50.6.,"
  },
  {
    "id": 29831,
    "book": "psalms                                  ",
    "chapter": "97",
    "verse": "7",
    "text": "Tutti quelli che servono alle sculture,"
  },
  {
    "id": 29832,
    "book": "psalms                                  ",
    "chapter": "97",
    "verse": "8",
    "text": "Sion l'ha udito, e se n'è rallegrata;"
  },
  {
    "id": 29833,
    "book": "psalms                                  ",
    "chapter": "97",
    "verse": "9",
    "text": "Perciocchè tu sei il Signore, l'Eccelso sopra tutta la terra;"
  },
  {
    "id": 29834,
    "book": "psalms                                  ",
    "chapter": "97",
    "verse": "10",
    "text": "Voi che amate il Signore, odiate il male97.10 male Rom. 12.9.;"
  },
  {
    "id": 29835,
    "book": "psalms                                  ",
    "chapter": "97",
    "verse": "11",
    "text": "La luce è seminata al giusto97.11 giusto Sal. 112.4. Prov. 4.18.;"
  },
  {
    "id": 29836,
    "book": "psalms                                  ",
    "chapter": "97",
    "verse": "12",
    "text": "Rallegratevi, o giusti, nel Signore;"
  }
]