[
  {
    "id": 28343,
    "book": "psalms                                  ",
    "chapter": "7",
    "verse": "1",
    "text": "SIGNORE Iddio mio, io mi confido in te;"
  },
  {
    "id": 28344,
    "book": "psalms                                  ",
    "chapter": "7",
    "verse": "2",
    "text": "Che talora il mio nemico non rapisca l'anima mia come un leone;"
  },
  {
    "id": 28345,
    "book": "psalms                                  ",
    "chapter": "7",
    "verse": "3",
    "text": "Signore Iddio mio, se ho fatto questo7.3 questo 2 Sam. 16.7,8.,"
  },
  {
    "id": 28346,
    "book": "psalms                                  ",
    "chapter": "7",
    "verse": "4",
    "text": "Se ho renduto mal per bene a chi viveva in pace meco"
  },
  {
    "id": 28347,
    "book": "psalms                                  ",
    "chapter": "7",
    "verse": "5",
    "text": "Perseguiti pure il nemico l'anima mia, e l'aggiunga,"
  },
  {
    "id": 28348,
    "book": "psalms                                  ",
    "chapter": "7",
    "verse": "6",
    "text": "Levati, Signore, nell'ira tua;"
  },
  {
    "id": 28349,
    "book": "psalms                                  ",
    "chapter": "7",
    "verse": "7",
    "text": "E circonditi la raunanza de' popoli;"
  },
  {
    "id": 28350,
    "book": "psalms                                  ",
    "chapter": "7",
    "verse": "8",
    "text": "Il Signore giudicherà i popoli;"
  },
  {
    "id": 28351,
    "book": "psalms                                  ",
    "chapter": "7",
    "verse": "9",
    "text": "Deh! venga meno la malvagità de' malvagi,"
  },
  {
    "id": 28352,
    "book": "psalms                                  ",
    "chapter": "7",
    "verse": "10",
    "text": "Il mio scudo è in Dio,"
  },
  {
    "id": 28353,
    "book": "psalms                                  ",
    "chapter": "7",
    "verse": "11",
    "text": "Iddio è giusto giudice,"
  },
  {
    "id": 28354,
    "book": "psalms                                  ",
    "chapter": "7",
    "verse": "12",
    "text": "Se il mio nemico non si converte, egli aguzzerà la sua spada;"
  },
  {
    "id": 28355,
    "book": "psalms                                  ",
    "chapter": "7",
    "verse": "13",
    "text": "Egli ha apparecchiate arme mortali;"
  },
  {
    "id": 28356,
    "book": "psalms                                  ",
    "chapter": "7",
    "verse": "14",
    "text": "Ecco, il mio nemico partorisce iniquità7.14 iniquità Giob. 15.35. Giac. 1.15.;"
  },
  {
    "id": 28357,
    "book": "psalms                                  ",
    "chapter": "7",
    "verse": "15",
    "text": "Egli ha cavata una fossa, e l'ha affondata;"
  },
  {
    "id": 28358,
    "book": "psalms                                  ",
    "chapter": "7",
    "verse": "16",
    "text": "Il travaglio ch'egli dà altrui gli ritornerà sopra la testa,"
  },
  {
    "id": 28359,
    "book": "psalms                                  ",
    "chapter": "7",
    "verse": "17",
    "text": "Io loderò il Signore, secondo la sua giustizia;"
  }
]