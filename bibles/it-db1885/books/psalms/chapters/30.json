[
  {
    "id": 28666,
    "book": "psalms                                  ",
    "chapter": "30",
    "verse": "1",
    "text": "SIGNORE, io ti esalterò; perciocchè tu mi hai tratto ad alto,"
  },
  {
    "id": 28667,
    "book": "psalms                                  ",
    "chapter": "30",
    "verse": "2",
    "text": "Signore Iddio mio,"
  },
  {
    "id": 28668,
    "book": "psalms                                  ",
    "chapter": "30",
    "verse": "3",
    "text": "Signore, tu hai fatta salir l'anima mia fuor del sepolcro;"
  },
  {
    "id": 28669,
    "book": "psalms                                  ",
    "chapter": "30",
    "verse": "4",
    "text": "Salmeggite al Signore voi suoi santi;"
  },
  {
    "id": 28670,
    "book": "psalms                                  ",
    "chapter": "30",
    "verse": "5",
    "text": "Perciocchè l'ira sua dura solo un momento30.5 momento Sal. 103.9. Is. 54.7,8.;"
  },
  {
    "id": 28671,
    "book": "psalms                                  ",
    "chapter": "30",
    "verse": "6",
    "text": "Quant'è a me, nella mia quiete, io diceva:"
  },
  {
    "id": 28672,
    "book": "psalms                                  ",
    "chapter": "30",
    "verse": "7",
    "text": "Signore, tu avevi, per lo tuo favore, stanziata la fortezza nel mio monte;"
  },
  {
    "id": 28673,
    "book": "psalms                                  ",
    "chapter": "30",
    "verse": "8",
    "text": "Io ho gridato a te, Signore,"
  },
  {
    "id": 28674,
    "book": "psalms                                  ",
    "chapter": "30",
    "verse": "9",
    "text": "Dicendo: Che utilità avrai nel mio sangue,"
  },
  {
    "id": 28675,
    "book": "psalms                                  ",
    "chapter": "30",
    "verse": "10",
    "text": "Ascolta, Signore, ed abbi pietà di me;"
  },
  {
    "id": 28676,
    "book": "psalms                                  ",
    "chapter": "30",
    "verse": "11",
    "text": "Tu hai mutato il mio duolo in festa30.11 festa 2 Sam. 6.14. Is. 61.3.;"
  },
  {
    "id": 28677,
    "book": "psalms                                  ",
    "chapter": "30",
    "verse": "12",
    "text": "Acciocchè la mia gloria ti salmeggi, e non si taccia."
  }
]