[
  {
    "id": 29057,
    "book": "psalms                                  ",
    "chapter": "52",
    "verse": "1",
    "text": "O POSSENTE uomo, perchè ti glorii del male?"
  },
  {
    "id": 29058,
    "book": "psalms                                  ",
    "chapter": "52",
    "verse": "2",
    "text": "La tua lingua divisa malizie;"
  },
  {
    "id": 29059,
    "book": "psalms                                  ",
    "chapter": "52",
    "verse": "3",
    "text": "Tu hai amato il male più che il bene;"
  },
  {
    "id": 29060,
    "book": "psalms                                  ",
    "chapter": "52",
    "verse": "4",
    "text": "Tu hai amate tutte le parole di ruina,"
  },
  {
    "id": 29061,
    "book": "psalms                                  ",
    "chapter": "52",
    "verse": "5",
    "text": "Iddio altresì ti distruggerà in eterno;"
  },
  {
    "id": 29062,
    "book": "psalms                                  ",
    "chapter": "52",
    "verse": "6",
    "text": "E i giusti lo vedranno, e temeranno;"
  },
  {
    "id": 29063,
    "book": "psalms                                  ",
    "chapter": "52",
    "verse": "7",
    "text": "Ecco l'uomo che non aveva posto Iddio per sua fortezza;"
  },
  {
    "id": 29064,
    "book": "psalms                                  ",
    "chapter": "52",
    "verse": "8",
    "text": "Ma io sarò come un ulivo verdeggiante nella Casa di Dio52.8 Dio Sal. 92.12 ecc. Os. 14.6.;"
  },
  {
    "id": 29065,
    "book": "psalms                                  ",
    "chapter": "52",
    "verse": "9",
    "text": "O Signore, io ti celebrerò in eterno; perciocchè tu avrai operato;"
  }
]