[
  {
    "id": 29545,
    "book": "psalms                                  ",
    "chapter": "80",
    "verse": "1",
    "text": "O PASTORE d'Israele, che guidi Giuseppe come una greggia,"
  },
  {
    "id": 29546,
    "book": "psalms                                  ",
    "chapter": "80",
    "verse": "2",
    "text": "Eccita la tua potenza davanti ad Efraim, ed a Beniamino, ed a Manasse80.2 Manasse Num. 2.18-23.;"
  },
  {
    "id": 29547,
    "book": "psalms                                  ",
    "chapter": "80",
    "verse": "3",
    "text": "O Dio, ristoraci;"
  },
  {
    "id": 29548,
    "book": "psalms                                  ",
    "chapter": "80",
    "verse": "4",
    "text": "O Signore Iddio degli eserciti,"
  },
  {
    "id": 29549,
    "book": "psalms                                  ",
    "chapter": "80",
    "verse": "5",
    "text": "Tu li hai cibati di pan di pianto,"
  },
  {
    "id": 29550,
    "book": "psalms                                  ",
    "chapter": "80",
    "verse": "6",
    "text": "Tu ci hai posti in contesa co' nostri vicini;"
  },
  {
    "id": 29551,
    "book": "psalms                                  ",
    "chapter": "80",
    "verse": "7",
    "text": "O Dio degli eserciti, ristoraci;"
  },
  {
    "id": 29552,
    "book": "psalms                                  ",
    "chapter": "80",
    "verse": "8",
    "text": "Tu avevi trasportata di Egitto una vigna80.8 vigna Is. 5.1-7 e rif.;"
  },
  {
    "id": 29553,
    "book": "psalms                                  ",
    "chapter": "80",
    "verse": "9",
    "text": "Tu avevi sgomberato davanti a lei il suo luogo80.9 luogo Esod. 23.28. Gios. 24.12.;"
  },
  {
    "id": 29554,
    "book": "psalms                                  ",
    "chapter": "80",
    "verse": "10",
    "text": "I monti erano coperti della sua ombra,"
  },
  {
    "id": 29555,
    "book": "psalms                                  ",
    "chapter": "80",
    "verse": "11",
    "text": "Aveva gettati i suoi rami infino al mare,"
  },
  {
    "id": 29556,
    "book": "psalms                                  ",
    "chapter": "80",
    "verse": "12",
    "text": "Perchè hai tu rotte le sue chiusure,"
  },
  {
    "id": 29557,
    "book": "psalms                                  ",
    "chapter": "80",
    "verse": "13",
    "text": "I cinghiali l'hanno guastata,"
  },
  {
    "id": 29558,
    "book": "psalms                                  ",
    "chapter": "80",
    "verse": "14",
    "text": "O Dio degli eserciti, rivolgiti, ti prego;"
  },
  {
    "id": 29559,
    "book": "psalms                                  ",
    "chapter": "80",
    "verse": "15",
    "text": "E le piante che la tua destra aveva piantate,"
  },
  {
    "id": 29560,
    "book": "psalms                                  ",
    "chapter": "80",
    "verse": "16",
    "text": "Quella è arsa col fuoco, ella è ricisa fino dal piè;"
  },
  {
    "id": 29561,
    "book": "psalms                                  ",
    "chapter": "80",
    "verse": "17",
    "text": "Sia la tua mano sopra l'uomo della tua destra,"
  },
  {
    "id": 29562,
    "book": "psalms                                  ",
    "chapter": "80",
    "verse": "18",
    "text": "E noi non ci trarremo indietro da te;"
  },
  {
    "id": 29563,
    "book": "psalms                                  ",
    "chapter": "80",
    "verse": "19",
    "text": "O Signore Iddio degli eserciti, ristoraci;"
  }
]