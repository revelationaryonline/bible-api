[
  {
    "id": 29220,
    "book": "psalms                                  ",
    "chapter": "66",
    "verse": "1",
    "text": "DATE voci di allegrezza a Dio,"
  },
  {
    "id": 29221,
    "book": "psalms                                  ",
    "chapter": "66",
    "verse": "2",
    "text": "Salmeggiate la gloria del suo Nome;"
  },
  {
    "id": 29222,
    "book": "psalms                                  ",
    "chapter": "66",
    "verse": "3",
    "text": "Dite a Dio: O quanto son tremende le tue opere66.3 opere Apoc. 15.3.!"
  },
  {
    "id": 29223,
    "book": "psalms                                  ",
    "chapter": "66",
    "verse": "4",
    "text": "Tutta la terra ti adora66.4 adora Sal. 22.27; 67.4; 86.9., e ti salmeggia;"
  },
  {
    "id": 29224,
    "book": "psalms                                  ",
    "chapter": "66",
    "verse": "5",
    "text": "Venite, e vedete i fatti di Dio;"
  },
  {
    "id": 29225,
    "book": "psalms                                  ",
    "chapter": "66",
    "verse": "6",
    "text": "Egli convertì già il mare in asciutto;"
  },
  {
    "id": 29226,
    "book": "psalms                                  ",
    "chapter": "66",
    "verse": "7",
    "text": "Egli, colla sua potenza, signoreggia in eterno;"
  },
  {
    "id": 29227,
    "book": "psalms                                  ",
    "chapter": "66",
    "verse": "8",
    "text": "Voi popoli, benedite il nostro Dio;"
  },
  {
    "id": 29228,
    "book": "psalms                                  ",
    "chapter": "66",
    "verse": "9",
    "text": "Egli è quel che ha rimessa in vita l'anima nostra;"
  },
  {
    "id": 29229,
    "book": "psalms                                  ",
    "chapter": "66",
    "verse": "10",
    "text": "Perciocchè, o Dio, tu ci hai provati;"
  },
  {
    "id": 29230,
    "book": "psalms                                  ",
    "chapter": "66",
    "verse": "11",
    "text": "Tu ci avevi fatti entrar nella rete;"
  },
  {
    "id": 29231,
    "book": "psalms                                  ",
    "chapter": "66",
    "verse": "12",
    "text": "Tu avevi fatto cavalcar gli uomini in sul nostro capo;"
  },
  {
    "id": 29232,
    "book": "psalms                                  ",
    "chapter": "66",
    "verse": "13",
    "text": "Io entrerò nella tua Casa con olocausti;"
  },
  {
    "id": 29233,
    "book": "psalms                                  ",
    "chapter": "66",
    "verse": "14",
    "text": "I quali le mie labbra han proferiti,"
  },
  {
    "id": 29234,
    "book": "psalms                                  ",
    "chapter": "66",
    "verse": "15",
    "text": "Io ti offerirò olocausti di bestie grasse,"
  },
  {
    "id": 29235,
    "book": "psalms                                  ",
    "chapter": "66",
    "verse": "16",
    "text": "Venite, voi tutti che temete Iddio, ed udite;"
  },
  {
    "id": 29236,
    "book": "psalms                                  ",
    "chapter": "66",
    "verse": "17",
    "text": "Io gridai a lui colla mia bocca,"
  },
  {
    "id": 29237,
    "book": "psalms                                  ",
    "chapter": "66",
    "verse": "18",
    "text": "Se io avessi mirato ad alcuna iniquità nel mio cuore,"
  },
  {
    "id": 29238,
    "book": "psalms                                  ",
    "chapter": "66",
    "verse": "19",
    "text": "Ma certo Iddio mi ha ascoltato,"
  },
  {
    "id": 29239,
    "book": "psalms                                  ",
    "chapter": "66",
    "verse": "20",
    "text": "Benedetto sia Iddio"
  }
]