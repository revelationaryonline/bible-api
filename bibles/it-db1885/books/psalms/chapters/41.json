[
  {
    "id": 28889,
    "book": "psalms                                  ",
    "chapter": "41",
    "verse": "1",
    "text": "BEATO colui che si porta saviamente inverso il povero e misero41.1 misero Prov. 14.21. Mat. 5.7.;"
  },
  {
    "id": 28890,
    "book": "psalms                                  ",
    "chapter": "41",
    "verse": "2",
    "text": "Il Signore lo guarderà, e lo manterrà in vita;"
  },
  {
    "id": 28891,
    "book": "psalms                                  ",
    "chapter": "41",
    "verse": "3",
    "text": "Il Signore lo sosterrà, quando sarà nel letto d'infermità;"
  },
  {
    "id": 28892,
    "book": "psalms                                  ",
    "chapter": "41",
    "verse": "4",
    "text": "Io ho detto: Signore, abbi pietà di me;"
  },
  {
    "id": 28893,
    "book": "psalms                                  ",
    "chapter": "41",
    "verse": "5",
    "text": "I miei nemici tengono malvagi ragionamenti di me, dicendo:"
  },
  {
    "id": 28894,
    "book": "psalms                                  ",
    "chapter": "41",
    "verse": "6",
    "text": "E se alcun di loro viene a vedermi, parla con menzogna41.6 menzogna Prov. 26.24-26.;"
  },
  {
    "id": 28895,
    "book": "psalms                                  ",
    "chapter": "41",
    "verse": "7",
    "text": "Tutti quelli che mi odiano bisbigliano insieme contro a me;"
  },
  {
    "id": 28896,
    "book": "psalms                                  ",
    "chapter": "41",
    "verse": "8",
    "text": "Dicendo: Alcun maligno male gli è attaccato addosso;"
  },
  {
    "id": 28897,
    "book": "psalms                                  ",
    "chapter": "41",
    "verse": "9",
    "text": "Eziandio l'uomo col quale io viveva in buona pace,"
  },
  {
    "id": 28898,
    "book": "psalms                                  ",
    "chapter": "41",
    "verse": "10",
    "text": "Ma tu, Signore, abbi pietà di me, e rilevami;"
  },
  {
    "id": 28899,
    "book": "psalms                                  ",
    "chapter": "41",
    "verse": "11",
    "text": "Da questo conosco che tu mi gradisci,"
  },
  {
    "id": 28900,
    "book": "psalms                                  ",
    "chapter": "41",
    "verse": "12",
    "text": "Anzi tu mi hai sostenuto nella mia integrità,"
  },
  {
    "id": 28901,
    "book": "psalms                                  ",
    "chapter": "41",
    "verse": "13",
    "text": "Benedetto sia il Signore, l'Iddio d'Israele,"
  }
]