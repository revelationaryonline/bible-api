[
  {
    "id": 28918,
    "book": "psalms                                  ",
    "chapter": "44",
    "verse": "1",
    "text": "O DIO, noi abbiamo udite colle nostre orecchie,"
  },
  {
    "id": 28919,
    "book": "psalms                                  ",
    "chapter": "44",
    "verse": "2",
    "text": "Tu, colla tua mano, scacciasti le genti, e piantasti i nostri padri44.2 padri Esod. 15.17. Deut. 7.1.;"
  },
  {
    "id": 28920,
    "book": "psalms                                  ",
    "chapter": "44",
    "verse": "3",
    "text": "Perciocchè essi non conquistarono il paese colla loro spada,"
  },
  {
    "id": 28921,
    "book": "psalms                                  ",
    "chapter": "44",
    "verse": "4",
    "text": "Tu, o Dio, sei lo stesso mio Re;"
  },
  {
    "id": 28922,
    "book": "psalms                                  ",
    "chapter": "44",
    "verse": "5",
    "text": "Per te noi cozzeremo i nostri nemici;"
  },
  {
    "id": 28923,
    "book": "psalms                                  ",
    "chapter": "44",
    "verse": "6",
    "text": "Perciocchè io non mi confido nel mio arco,"
  },
  {
    "id": 28924,
    "book": "psalms                                  ",
    "chapter": "44",
    "verse": "7",
    "text": "Anzi tu ci salverai da' nostri nemici,"
  },
  {
    "id": 28925,
    "book": "psalms                                  ",
    "chapter": "44",
    "verse": "8",
    "text": "Noi ci glorieremo tuttodì in Dio44.8 Dio Ger. 9.24. Rom. 2.17.,"
  },
  {
    "id": 28926,
    "book": "psalms                                  ",
    "chapter": "44",
    "verse": "9",
    "text": "E pure tu ci hai scacciati44.9 scacciati 1 Cron. 28.9. Sal. 89.38 ecc., e ci hai svergognati;"
  },
  {
    "id": 28927,
    "book": "psalms                                  ",
    "chapter": "44",
    "verse": "10",
    "text": "Tu ci hai fatto voltar le spalle dinanzi al nemico44.10 nemico Lev. 26.17. Gios. 7.8,12.;"
  },
  {
    "id": 28928,
    "book": "psalms                                  ",
    "chapter": "44",
    "verse": "11",
    "text": "Tu ci hai ridotti ad esser come pecore da mangiare44.11 mangiare Rom. 8.36.;"
  },
  {
    "id": 28929,
    "book": "psalms                                  ",
    "chapter": "44",
    "verse": "12",
    "text": "Tu hai venduto il tuo popolo senza danari44.12 danari Deut. 32.30. Ger. 15.13.,"
  },
  {
    "id": 28930,
    "book": "psalms                                  ",
    "chapter": "44",
    "verse": "13",
    "text": "Tu ci hai posti in vituperio appresso i nostri vicini,"
  },
  {
    "id": 28931,
    "book": "psalms                                  ",
    "chapter": "44",
    "verse": "14",
    "text": "Tu ci hai messi ad essere proverbiati fra le genti,"
  },
  {
    "id": 28932,
    "book": "psalms                                  ",
    "chapter": "44",
    "verse": "15",
    "text": "Il mio vituperio è tuttodì davanti a me,"
  },
  {
    "id": 28933,
    "book": "psalms                                  ",
    "chapter": "44",
    "verse": "16",
    "text": "Per la voce del vituperatore e dell'oltraggiatore;"
  },
  {
    "id": 28934,
    "book": "psalms                                  ",
    "chapter": "44",
    "verse": "17",
    "text": "Tutto questo ci è avvenuto, e non però ti abbiamo dimenticato,"
  },
  {
    "id": 28935,
    "book": "psalms                                  ",
    "chapter": "44",
    "verse": "18",
    "text": "Il cuor nostro non si è rivolto indietro,"
  },
  {
    "id": 28936,
    "book": "psalms                                  ",
    "chapter": "44",
    "verse": "19",
    "text": "Quantunque tu ci abbi tritati, e messi in luogo di sciacalli;"
  },
  {
    "id": 28937,
    "book": "psalms                                  ",
    "chapter": "44",
    "verse": "20",
    "text": "Se noi avessimo dimenticato il Nome dell'Iddio nostro,"
  },
  {
    "id": 28938,
    "book": "psalms                                  ",
    "chapter": "44",
    "verse": "21",
    "text": "Iddio non ne farebbe egli inchiesta?"
  },
  {
    "id": 28939,
    "book": "psalms                                  ",
    "chapter": "44",
    "verse": "22",
    "text": "Anzi, per cagion tua siamo uccisi tuttodì,"
  },
  {
    "id": 28940,
    "book": "psalms                                  ",
    "chapter": "44",
    "verse": "23",
    "text": "Risvegliati; perchè dormi, Signore?"
  },
  {
    "id": 28941,
    "book": "psalms                                  ",
    "chapter": "44",
    "verse": "24",
    "text": "Perchè nascondi la tua faccia?"
  },
  {
    "id": 28942,
    "book": "psalms                                  ",
    "chapter": "44",
    "verse": "25",
    "text": "Conciossiachè la nostra anima sia abbassata fin nella polvere,"
  },
  {
    "id": 28943,
    "book": "psalms                                  ",
    "chapter": "44",
    "verse": "26",
    "text": "Levati in nostro aiuto,"
  }
]