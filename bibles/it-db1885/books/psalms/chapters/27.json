[
  {
    "id": 28632,
    "book": "psalms                                  ",
    "chapter": "27",
    "verse": "1",
    "text": "IL Signore è la mia luce27.1 luce Sal. 84.11. Is. 60.19,20. e la mia salute27.1 salute Esod. 15.2.;"
  },
  {
    "id": 28633,
    "book": "psalms                                  ",
    "chapter": "27",
    "verse": "2",
    "text": "Quando i maligni mi hanno assalito per divorar la mia carne,"
  },
  {
    "id": 28634,
    "book": "psalms                                  ",
    "chapter": "27",
    "verse": "3",
    "text": "Avvegnachè tutto un campo si accampasse contro a me,"
  },
  {
    "id": 28635,
    "book": "psalms                                  ",
    "chapter": "27",
    "verse": "4",
    "text": "Io ho chiesta una cosa al Signore, quella procaccerò:"
  },
  {
    "id": 28636,
    "book": "psalms                                  ",
    "chapter": "27",
    "verse": "5",
    "text": "Perciocchè egli mi nasconderà nel suo tabernacolo,"
  },
  {
    "id": 28637,
    "book": "psalms                                  ",
    "chapter": "27",
    "verse": "6",
    "text": "Anzi pure ora il mio capo s'innalzerà sopra i miei nemici"
  },
  {
    "id": 28638,
    "book": "psalms                                  ",
    "chapter": "27",
    "verse": "7",
    "text": "Signore, ascolta la mia voce, colla quale io grido;"
  },
  {
    "id": 28639,
    "book": "psalms                                  ",
    "chapter": "27",
    "verse": "8",
    "text": "Il mio cuore mi dice da parte tua: Cercate la mia faccia."
  },
  {
    "id": 28640,
    "book": "psalms                                  ",
    "chapter": "27",
    "verse": "9",
    "text": "Non nascondere il tuo volto da me,"
  },
  {
    "id": 28641,
    "book": "psalms                                  ",
    "chapter": "27",
    "verse": "10",
    "text": "Quantunque mio padre e mia madre mi avessero abbandonato,"
  },
  {
    "id": 28642,
    "book": "psalms                                  ",
    "chapter": "27",
    "verse": "11",
    "text": "O Signore, insegnami la tua via27.11 via Sal. 25.4 e rif.,"
  },
  {
    "id": 28643,
    "book": "psalms                                  ",
    "chapter": "27",
    "verse": "12",
    "text": "Non darmi alle voglie de' miei nemici;"
  },
  {
    "id": 28644,
    "book": "psalms                                  ",
    "chapter": "27",
    "verse": "13",
    "text": "Oh! se non avessi creduto di vedere i beni del Signore,"
  },
  {
    "id": 28645,
    "book": "psalms                                  ",
    "chapter": "27",
    "verse": "14",
    "text": "Attendi il Signore27.14 Signore Is. 25.9. Abac. 2.3.,"
  }
]