[
  {
    "id": 28872,
    "book": "psalms                                  ",
    "chapter": "40",
    "verse": "1",
    "text": "IO ho lungamente e pazientemente aspettato il Signore40.1 Signore Sal. 27.14; 37.7.;"
  },
  {
    "id": 28873,
    "book": "psalms                                  ",
    "chapter": "40",
    "verse": "2",
    "text": "E mi ha tratto fuor di una fossa ruinosa,"
  },
  {
    "id": 28874,
    "book": "psalms                                  ",
    "chapter": "40",
    "verse": "3",
    "text": "Ed ha messo nella mia bocca un nuovo cantico"
  },
  {
    "id": 28875,
    "book": "psalms                                  ",
    "chapter": "40",
    "verse": "4",
    "text": "Beato l'uomo che ha posto il Signore per sua confidanza;"
  },
  {
    "id": 28876,
    "book": "psalms                                  ",
    "chapter": "40",
    "verse": "5",
    "text": "Signore Iddio mio, tu fai grandi le tue maraviglie;"
  },
  {
    "id": 28877,
    "book": "psalms                                  ",
    "chapter": "40",
    "verse": "6",
    "text": "Tu non prendi piacere in sacrificio, nè in offerta40.6 offerta 1 Sam. 15.22 e rif.;"
  },
  {
    "id": 28878,
    "book": "psalms                                  ",
    "chapter": "40",
    "verse": "7",
    "text": "Allora io ho detto: Eccomi venuto;"
  },
  {
    "id": 28879,
    "book": "psalms                                  ",
    "chapter": "40",
    "verse": "8",
    "text": "Dio mio, io prendo piacere in far la tua volontà40.8 volontà Sal. 119.16,24,47,92; 143.10. Giov. 4.34. Rom. 7.22.;"
  },
  {
    "id": 28880,
    "book": "psalms                                  ",
    "chapter": "40",
    "verse": "9",
    "text": "Io ho predicata la tua giustizia in gran raunanza;"
  },
  {
    "id": 28881,
    "book": "psalms                                  ",
    "chapter": "40",
    "verse": "10",
    "text": "Io non ho nascosta la tua giustizia dentro al mio cuore;"
  },
  {
    "id": 28882,
    "book": "psalms                                  ",
    "chapter": "40",
    "verse": "11",
    "text": "Tu, Signore, non rattenere inverso me le tue compassioni;"
  },
  {
    "id": 28883,
    "book": "psalms                                  ",
    "chapter": "40",
    "verse": "12",
    "text": "Perciocchè mali innumerabili mi hanno circondato;"
  },
  {
    "id": 28884,
    "book": "psalms                                  ",
    "chapter": "40",
    "verse": "13",
    "text": "Piacciati, Signore, liberarmi40.13 liberarmi Sal. 70.1 ecc.;"
  },
  {
    "id": 28885,
    "book": "psalms                                  ",
    "chapter": "40",
    "verse": "14",
    "text": "Quelli che cercano l'anima mia, per farla perire,"
  },
  {
    "id": 28886,
    "book": "psalms                                  ",
    "chapter": "40",
    "verse": "15",
    "text": "Quelli che mi dicono: Eia, eia!"
  },
  {
    "id": 28887,
    "book": "psalms                                  ",
    "chapter": "40",
    "verse": "16",
    "text": "Rallegrinsi, e gioiscano in te tutti quelli chi ti cercano;"
  },
  {
    "id": 28888,
    "book": "psalms                                  ",
    "chapter": "40",
    "verse": "17",
    "text": "Quanto è a me, io son povero, e bisognoso;"
  }
]