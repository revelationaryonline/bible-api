[
  {
    "id": 30652,
    "book": "psalms                                  ",
    "chapter": "144",
    "verse": "1",
    "text": "BENEDETTO sia il Signore, mia Rocca,"
  },
  {
    "id": 30653,
    "book": "psalms                                  ",
    "chapter": "144",
    "verse": "2",
    "text": "Egli è la mia benignità e la mia fortezza;"
  },
  {
    "id": 30654,
    "book": "psalms                                  ",
    "chapter": "144",
    "verse": "3",
    "text": "O Signore, che cosa è l'uomo, che tu ne abbi cura?"
  },
  {
    "id": 30655,
    "book": "psalms                                  ",
    "chapter": "144",
    "verse": "4",
    "text": "L'uomo è simile a vanità;"
  },
  {
    "id": 30656,
    "book": "psalms                                  ",
    "chapter": "144",
    "verse": "5",
    "text": "Signore, abbassa i tuoi cieli, e scendi144.5 scendi Sal. 18.8 ecc. Is. 64.1.;"
  },
  {
    "id": 30657,
    "book": "psalms                                  ",
    "chapter": "144",
    "verse": "6",
    "text": "Vibra il folgore, e dissipa quella gente;"
  },
  {
    "id": 30658,
    "book": "psalms                                  ",
    "chapter": "144",
    "verse": "7",
    "text": "Stendi le tue mani da alto,"
  },
  {
    "id": 30659,
    "book": "psalms                                  ",
    "chapter": "144",
    "verse": "8",
    "text": "La cui bocca parla menzogna;"
  },
  {
    "id": 30660,
    "book": "psalms                                  ",
    "chapter": "144",
    "verse": "9",
    "text": "O Dio, io ti canterò un nuovo cantico;"
  },
  {
    "id": 30661,
    "book": "psalms                                  ",
    "chapter": "144",
    "verse": "10",
    "text": "Tu, che dài vittoria ai re;"
  },
  {
    "id": 30662,
    "book": "psalms                                  ",
    "chapter": "144",
    "verse": "11",
    "text": "Liberami, e riscuotimi dalla mano degli stranieri."
  },
  {
    "id": 30663,
    "book": "psalms                                  ",
    "chapter": "144",
    "verse": "12",
    "text": "Acciocchè i nostri figliuoli sieno come piante novelle144.12 novelle Sal. 128.3.,"
  },
  {
    "id": 30664,
    "book": "psalms                                  ",
    "chapter": "144",
    "verse": "13",
    "text": "E le nostre celle sieno piene,"
  },
  {
    "id": 30665,
    "book": "psalms                                  ",
    "chapter": "144",
    "verse": "14",
    "text": "E i nostri buoi sieno grossi e possenti;"
  },
  {
    "id": 30666,
    "book": "psalms                                  ",
    "chapter": "144",
    "verse": "15",
    "text": "Beato il popolo che è in tale stato;"
  }
]