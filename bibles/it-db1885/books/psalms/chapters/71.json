[
  {
    "id": 29323,
    "book": "psalms                                  ",
    "chapter": "71",
    "verse": "1",
    "text": "SIGNORE, io mi son confidato in te71.1 te Sal. 25.2 e rif.; 31.1 ecc.,"
  },
  {
    "id": 29324,
    "book": "psalms                                  ",
    "chapter": "71",
    "verse": "2",
    "text": "Riscuotimi, e liberami, per la tua giustizia;"
  },
  {
    "id": 29325,
    "book": "psalms                                  ",
    "chapter": "71",
    "verse": "3",
    "text": "Siimi una rocca di dimora,"
  },
  {
    "id": 29326,
    "book": "psalms                                  ",
    "chapter": "71",
    "verse": "4",
    "text": "O Dio mio, liberami dalla man dell'empio,"
  },
  {
    "id": 29327,
    "book": "psalms                                  ",
    "chapter": "71",
    "verse": "5",
    "text": "Perciocchè tu sei la mia speranza71.5 speranza Ger. 17.7,17. 1 Tim. 1.1., o Signore Iddio;"
  },
  {
    "id": 29328,
    "book": "psalms                                  ",
    "chapter": "71",
    "verse": "6",
    "text": "Tu sei stato il mio sostegno fin dal seno di mia madre71.6 madre Sal. 22.9,10. Is. 46.3.;"
  },
  {
    "id": 29329,
    "book": "psalms                                  ",
    "chapter": "71",
    "verse": "7",
    "text": "Io sono stato a molti come un mostro71.7 mostro 1 Cor. 4.9.;"
  },
  {
    "id": 29330,
    "book": "psalms                                  ",
    "chapter": "71",
    "verse": "8",
    "text": "Sia la mia bocca ripiena della tua lode,"
  },
  {
    "id": 29331,
    "book": "psalms                                  ",
    "chapter": "71",
    "verse": "9",
    "text": "Non rigettarmi al tempo della vecchiezza;"
  },
  {
    "id": 29332,
    "book": "psalms                                  ",
    "chapter": "71",
    "verse": "10",
    "text": "Perciocchè i miei nemici tengono ragionamenti contro a me,"
  },
  {
    "id": 29333,
    "book": "psalms                                  ",
    "chapter": "71",
    "verse": "11",
    "text": "Dicendo: Iddio l'ha abbandonato;"
  },
  {
    "id": 29334,
    "book": "psalms                                  ",
    "chapter": "71",
    "verse": "12",
    "text": "O Dio, non allontanarti da me71.12 me Sal. 22.11,19; 38.21,22.;"
  },
  {
    "id": 29335,
    "book": "psalms                                  ",
    "chapter": "71",
    "verse": "13",
    "text": "Sieno confusi, e vengano meno gli avversari dell'anima mia;"
  },
  {
    "id": 29336,
    "book": "psalms                                  ",
    "chapter": "71",
    "verse": "14",
    "text": "Ma io spererò del continuo,"
  },
  {
    "id": 29337,
    "book": "psalms                                  ",
    "chapter": "71",
    "verse": "15",
    "text": "La mia bocca racconterà tuttodì la tua giustizia, e la tua salute;"
  },
  {
    "id": 29338,
    "book": "psalms                                  ",
    "chapter": "71",
    "verse": "16",
    "text": "Io entrerò nelle prodezze del Signore Iddio;"
  },
  {
    "id": 29339,
    "book": "psalms                                  ",
    "chapter": "71",
    "verse": "17",
    "text": "O Dio, tu mi hai ammaestrato dalla mia fanciullezza;"
  },
  {
    "id": 29340,
    "book": "psalms                                  ",
    "chapter": "71",
    "verse": "18",
    "text": "Non abbandonarmi ancora, o Dio, fino alla vecchiezza, anzi fino alla canutezza;"
  },
  {
    "id": 29341,
    "book": "psalms                                  ",
    "chapter": "71",
    "verse": "19",
    "text": "E la tua giustizia, o Dio, esalterò sommamente:"
  },
  {
    "id": 29342,
    "book": "psalms                                  ",
    "chapter": "71",
    "verse": "20",
    "text": "Perciocchè, avendomi fatto sentir molte tribolazioni e mali,"
  },
  {
    "id": 29343,
    "book": "psalms                                  ",
    "chapter": "71",
    "verse": "21",
    "text": "Tu hai accresciuta la mia grandezza,"
  },
  {
    "id": 29344,
    "book": "psalms                                  ",
    "chapter": "71",
    "verse": "22",
    "text": "Io altresì, collo strumento del saltero, celebrerò te,"
  },
  {
    "id": 29345,
    "book": "psalms                                  ",
    "chapter": "71",
    "verse": "23",
    "text": "Le mie labbra giubileranno, quando io ti salmeggerò;"
  },
  {
    "id": 29346,
    "book": "psalms                                  ",
    "chapter": "71",
    "verse": "24",
    "text": "La mia lingua ancora ragionerà tuttodì della tua giustizia;"
  }
]