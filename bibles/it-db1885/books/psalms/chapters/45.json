  },
  {
    "id": 28950,
    "book": "psalms                                  ",
    "chapter": "45",
    "verse": "7",
    "text": "Tu hai amata la giustizia, ed hai odiata l'empietà45.7 empietà Sal. 11.7; 33.5.;"
  },
  {
    "id": 28951,
    "book": "psalms                                  ",
    "chapter": "45",
    "verse": "8",
    "text": "Tutti i tuoi vestimenti son mirra, aloe, e cassia45.8 cassia Cant. 1.3. Giov. 19.39.,"
  },
  {
    "id": 28952,
    "book": "psalms                                  ",
    "chapter": "45",
    "verse": "9",
    "text": "Figliuole di re sono fra i tuoi onori;"
  },
  {
    "id": 28953,
    "book": "psalms                                  ",
    "chapter": "45",
    "verse": "10",
    "text": "Ascolta, fanciulla, e riguarda, e porgi l'orecchio;"
  },
  {
    "id": 28954,
    "book": "psalms                                  ",
    "chapter": "45",
    "verse": "11",
    "text": "E il Re porrà amore alla tua bellezza;"
  },
  {
    "id": 28955,
    "book": "psalms                                  ",
    "chapter": "45",
    "verse": "12",
    "text": "E la figliuola di Tiro,"
