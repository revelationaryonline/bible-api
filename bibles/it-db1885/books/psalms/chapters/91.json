[
  {
    "id": 29742,
    "book": "psalms                                  ",
    "chapter": "91",
    "verse": "1",
    "text": "CHI dimora nel nascondimento dell'Altissimo,"
  },
  {
    "id": 29743,
    "book": "psalms                                  ",
    "chapter": "91",
    "verse": "2",
    "text": "Io dirò al Signore: Tu sei il mio ricetto e la mia fortezza;"
  },
  {
    "id": 29744,
    "book": "psalms                                  ",
    "chapter": "91",
    "verse": "3",
    "text": "Certo egli ti riscoterà dal laccio dell'uccellatore91.3 uccellatore Sal. 124.7. Fat. 12.11.,"
  },
  {
    "id": 29745,
    "book": "psalms                                  ",
    "chapter": "91",
    "verse": "4",
    "text": "Egli ti farà riparo colle sue penne,"
  },
  {
    "id": 29746,
    "book": "psalms                                  ",
    "chapter": "91",
    "verse": "5",
    "text": "Tu non temerai di spavento notturno,"
  },
  {
    "id": 29747,
    "book": "psalms                                  ",
    "chapter": "91",
    "verse": "6",
    "text": "Nè di pestilenza che vada attorno nelle tenebre;"
  },
  {
    "id": 29748,
    "book": "psalms                                  ",
    "chapter": "91",
    "verse": "7",
    "text": "Mille te ne caderanno al lato manco,"
  },
  {
    "id": 29749,
    "book": "psalms                                  ",
    "chapter": "91",
    "verse": "8",
    "text": "Sol riguarderai con gli occhi,"
  },
  {
    "id": 29750,
    "book": "psalms                                  ",
    "chapter": "91",
    "verse": "9",
    "text": "Perciocchè, o Signore, tu sei il mio ricetto;"
  },
  {
    "id": 29751,
    "book": "psalms                                  ",
    "chapter": "91",
    "verse": "10",
    "text": "Male alcuno non ti avverrà91.10 avverrà Giob. 5.19. Prov. 12.21.,"
  },
  {
    "id": 29752,
    "book": "psalms                                  ",
    "chapter": "91",
    "verse": "11",
    "text": "Perciocchè egli comanderà a' suoi Angeli intorno a te,"
  },
  {
    "id": 29753,
    "book": "psalms                                  ",
    "chapter": "91",
    "verse": "12",
    "text": "Essi ti leveranno in palma di mano,"
  },
  {
    "id": 29754,
    "book": "psalms                                  ",
    "chapter": "91",
    "verse": "13",
    "text": "Tu camminerai sopra il leone, e sopra l'aspido91.13 aspido Luc. 10.19.;"
  },
  {
    "id": 29755,
    "book": "psalms                                  ",
    "chapter": "91",
    "verse": "14",
    "text": "Perciocchè egli ha posta in me tutta la sua affezione, dice il Signore, io lo libererò;"
  },
  {
    "id": 29756,
    "book": "psalms                                  ",
    "chapter": "91",
    "verse": "15",
    "text": "Egli m'invocherà, e io gli risponderò;"
  },
  {
    "id": 29757,
    "book": "psalms                                  ",
    "chapter": "91",
    "verse": "16",
    "text": "Io lo sazierò di lunga vita91.16 vita Deut. 6.2. Prov. 3.2,16.,"
  }
]