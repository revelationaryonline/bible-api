[
  {
    "id": 30610,
    "book": "psalms                                  ",
    "chapter": "140",
    "verse": "1",
    "text": "RISCUOTIMI, o Signore, dall'uomo malvagio;"
  },
  {
    "id": 30611,
    "book": "psalms                                  ",
    "chapter": "140",
    "verse": "2",
    "text": "I quali macchinano de' mali nel cuore,"
  },
  {
    "id": 30612,
    "book": "psalms                                  ",
    "chapter": "140",
    "verse": "3",
    "text": "Aguzzano la lor lingua come il serpente;"
  },
  {
    "id": 30613,
    "book": "psalms                                  ",
    "chapter": "140",
    "verse": "4",
    "text": "Preservami, o Signore, dalle mani dell'empio;"
  },
  {
    "id": 30614,
    "book": "psalms                                  ",
    "chapter": "140",
    "verse": "5",
    "text": "I superbi mi hanno nascosto un laccio, e delle funi;"
  },
  {
    "id": 30615,
    "book": "psalms                                  ",
    "chapter": "140",
    "verse": "6",
    "text": "Io ho detto al Signore: Tu sei il mio Dio;"
  },
  {
    "id": 30616,
    "book": "psalms                                  ",
    "chapter": "140",
    "verse": "7",
    "text": "O Signore Iddio, che sei la forza della mia salute140.7 salute Sal. 28.8.,"
  },
  {
    "id": 30617,
    "book": "psalms                                  ",
    "chapter": "140",
    "verse": "8",
    "text": "O Signore, non concedere agli empi ciò che desiderano;"
  },
  {
    "id": 30618,
    "book": "psalms                                  ",
    "chapter": "140",
    "verse": "9",
    "text": "Fa'che la perversità delle labbra"
  },
  {
    "id": 30619,
    "book": "psalms                                  ",
    "chapter": "140",
    "verse": "10",
    "text": "Caggiano loro addosso carboni accesi140.10 accesi Sal. 11.6.;"
  },
  {
    "id": 30620,
    "book": "psalms                                  ",
    "chapter": "140",
    "verse": "11",
    "text": "Non sia l'uomo maldicente stabilito in terra;"
  },
  {
    "id": 30621,
    "book": "psalms                                  ",
    "chapter": "140",
    "verse": "12",
    "text": "Io so che il Signore farà ragione all'afflitto,"
  },
  {
    "id": 30622,
    "book": "psalms                                  ",
    "chapter": "140",
    "verse": "13",
    "text": "Certo, i giusti celebreranno il tuo Nome;"
  }
]