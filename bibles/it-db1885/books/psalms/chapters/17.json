[
  {
    "id": 28451,
    "book": "psalms                                  ",
    "chapter": "17",
    "verse": "1",
    "text": "O SIGNORE, ascolta la giustizia, attendi al mio grido,"
  },
  {
    "id": 28452,
    "book": "psalms                                  ",
    "chapter": "17",
    "verse": "2",
    "text": "Proceda il mio giudicio dalla tua presenza;"
  },
  {
    "id": 28453,
    "book": "psalms                                  ",
    "chapter": "17",
    "verse": "3",
    "text": "Tu hai provato il mio cuore, tu l'hai visitato di notte;"
  },
  {
    "id": 28454,
    "book": "psalms                                  ",
    "chapter": "17",
    "verse": "4",
    "text": "Nelle opere degli uomini, per la parola della tue labbra,"
  },
  {
    "id": 28455,
    "book": "psalms                                  ",
    "chapter": "17",
    "verse": "5",
    "text": "Sostieni i miei passi ne' tuoi sentieri17.5 sentieri Sal. 119.133. Prov. 5.21.,"
  },
  {
    "id": 28456,
    "book": "psalms                                  ",
    "chapter": "17",
    "verse": "6",
    "text": "Io t'invoco, o Dio, perciocchè tu mi esaudisci17.6 esaudisci Sal. 116.2.;"
  },
  {
    "id": 28457,
    "book": "psalms                                  ",
    "chapter": "17",
    "verse": "7",
    "text": "Dimostra maravigliose le tue benignità,"
  },
  {
    "id": 28458,
    "book": "psalms                                  ",
    "chapter": "17",
    "verse": "8",
    "text": "Guardami come la pupilla dell'occhio17.8 occhio Deut. 32.10. Zac. 2.8.,"
  },
  {
    "id": 28459,
    "book": "psalms                                  ",
    "chapter": "17",
    "verse": "9",
    "text": "D'innanzi agli empi che mi disertano;"
  },
  {
    "id": 28460,
    "book": "psalms                                  ",
    "chapter": "17",
    "verse": "10",
    "text": "Son tutti massicci di grasso17.10 grasso Deut. 32.15. Giob. 15.27.,"
  },
  {
    "id": 28461,
    "book": "psalms                                  ",
    "chapter": "17",
    "verse": "11",
    "text": "Ora c'intorniano, seguitandoci alla traccia;"
  },
  {
    "id": 28462,
    "book": "psalms                                  ",
    "chapter": "17",
    "verse": "12",
    "text": "Somigliano un leone che brama di lacerare;"
  },
  {
    "id": 28463,
    "book": "psalms                                  ",
    "chapter": "17",
    "verse": "13",
    "text": "Levati, o Signore, va' loro incontro per affrontarli; abbattili;"
  },
  {
    "id": 28464,
    "book": "psalms                                  ",
    "chapter": "17",
    "verse": "14",
    "text": "O Signore, riscuotila colla tua mano dagli uomini, dagli uomini del mondo,"
  },
  {
    "id": 28465,
    "book": "psalms                                  ",
    "chapter": "17",
    "verse": "15",
    "text": "Quant'è a me, per giustizia vedrò la tua faccia17.15 faccia 1 Giov. 3.2.;"
  }
]