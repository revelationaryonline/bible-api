[
  {
    "id": 28466,
    "book": "psalms                                  ",
    "chapter": "18",
    "verse": "1",
    "text": "O SIGNORE, mia forza, io ti amerò affettuosamente18.1 affettuosamente Sal. 116.1.."
  },
  {
    "id": 28467,
    "book": "psalms                                  ",
    "chapter": "18",
    "verse": "2",
    "text": "Io invocai il Signore, a cui si deve ogni lode;"
  },
  {
    "id": 28468,
    "book": "psalms                                  ",
    "chapter": "18",
    "verse": "3",
    "text": "Doglie di morte mi avevano circondato18.3 circondato Sal. 116.3.,"
  },
  {
    "id": 28469,
    "book": "psalms                                  ",
    "chapter": "18",
    "verse": "4",
    "text": "Legami di sepolcro mi avevano intorniato,"
  },
  {
    "id": 28470,
    "book": "psalms                                  ",
    "chapter": "18",
    "verse": "5",
    "text": "Nella mia distretta io invocai il Signore,"
  },
  {
    "id": 28471,
    "book": "psalms                                  ",
    "chapter": "18",
    "verse": "6",
    "text": "Allora la terra fu scossa, e tremò18.6 tremò Fat. 4.31.;"
  },
  {
    "id": 28472,
    "book": "psalms                                  ",
    "chapter": "18",
    "verse": "7",
    "text": "Un fumo gli saliva per le nari,"
  },
  {
    "id": 28473,
    "book": "psalms                                  ",
    "chapter": "18",
    "verse": "8",
    "text": "Ed egli abbassò i cieli, e discese;"
  },
  {
    "id": 28474,
    "book": "psalms                                  ",
    "chapter": "18",
    "verse": "9",
    "text": "E cavalcava sopra Cherubini18.9 Cherubini Sal. 99.1., e volava;"
  },
  {
    "id": 28475,
    "book": "psalms                                  ",
    "chapter": "18",
    "verse": "10",
    "text": "Egli aveva poste delle tenebre per suo nascondimento;"
  },
  {
    "id": 28476,
    "book": "psalms                                  ",
    "chapter": "18",
    "verse": "11",
    "text": "Le sue nubi si dileguarono per lo splendore che scoppiava davanti a lui,"
  },
  {
    "id": 28477,
    "book": "psalms                                  ",
    "chapter": "18",
    "verse": "12",
    "text": "E il Signore tuonò nel cielo,"
  },
  {
    "id": 28478,
    "book": "psalms                                  ",
    "chapter": "18",
    "verse": "13",
    "text": "Ed avventò le sue saette, e disperse coloro18.13 coloro Gios. 10.10,11.;"
  },
  {
    "id": 28479,
    "book": "psalms                                  ",
    "chapter": "18",
    "verse": "14",
    "text": "E per lo tuo sgridare, o Signore,"
  },
  {
    "id": 28480,
    "book": "psalms                                  ",
    "chapter": "18",
    "verse": "15",
    "text": "Egli da alto distese la mano e mi prese,"
  },
  {
    "id": 28481,
    "book": "psalms                                  ",
    "chapter": "18",
    "verse": "16",
    "text": "Egli mi riscosse dal mio potente nemico,"
  },
  {
    "id": 28482,
    "book": "psalms                                  ",
    "chapter": "18",
    "verse": "17",
    "text": "Essi erano venuti incontro a me nel giorno della mia calamità;"
  },
  {
    "id": 28483,
    "book": "psalms                                  ",
    "chapter": "18",
    "verse": "18",
    "text": "E mi trasse fuori al largo;"
  },
  {
    "id": 28484,
    "book": "psalms                                  ",
    "chapter": "18",
    "verse": "19",
    "text": "Il Signore mi ha fatta retribuzione secondo la mia giustizia18.19 giustizia 1 Sam. 24.19; 26.23.;"
  },
  {
    "id": 28485,
    "book": "psalms                                  ",
    "chapter": "18",
    "verse": "20",
    "text": "Perciocchè io ho osservate le vie del Signore,"
  },
  {
    "id": 28486,
    "book": "psalms                                  ",
    "chapter": "18",
    "verse": "21",
    "text": "Perciocchè io ho tenute davanti a me tutte le sue leggi,"
  },
  {
    "id": 28487,
    "book": "psalms                                  ",
    "chapter": "18",
    "verse": "22",
    "text": "E sono stato intiero inverso lui,"
  },
  {
    "id": 28488,
    "book": "psalms                                  ",
    "chapter": "18",
    "verse": "23",
    "text": "E il Signore mi ha renduto secondo la mia giustizia,"
  },
  {
    "id": 28489,
    "book": "psalms                                  ",
    "chapter": "18",
    "verse": "24",
    "text": "Tu ti mostri pietoso inverso l'uomo pio18.24 pio 1 Re. 8.32.,"
  },
  {
    "id": 28490,
    "book": "psalms                                  ",
    "chapter": "18",
    "verse": "25",
    "text": "Tu ti mostri puro col puro,"
  },
  {
    "id": 28491,
    "book": "psalms                                  ",
    "chapter": "18",
    "verse": "26",
    "text": "Perciocchè tu sei quel che salvi la gente afflitta,"
  },
  {
    "id": 28492,
    "book": "psalms                                  ",
    "chapter": "18",
    "verse": "27",
    "text": "Perciocchè tu sei quel che fai risplendere la mia lampana;"
  },
  {
    "id": 28493,
    "book": "psalms                                  ",
    "chapter": "18",
    "verse": "28",
    "text": "Perciocchè per la tua virtù io rompo tutta una schiera;"
  },
  {
    "id": 28494,
    "book": "psalms                                  ",
    "chapter": "18",
    "verse": "29",
    "text": "La via di Dio è intiera18.29 intiera Deut. 32.4. Apoc. 15.3.;"
  },
  {
    "id": 28495,
    "book": "psalms                                  ",
    "chapter": "18",
    "verse": "30",
    "text": "Perciocchè chi è Dio, fuor che il Signore18.30 Signore 1 Sam. 2.2. Is. 45.5.?"
  },
  {
    "id": 28496,
    "book": "psalms                                  ",
    "chapter": "18",
    "verse": "31",
    "text": "Iddio è quel che mi cinge di prodezza,"
  },
  {
    "id": 28497,
    "book": "psalms                                  ",
    "chapter": "18",
    "verse": "32",
    "text": "Egli rende i miei piedi simili a quelli delle cerve,"
  },
  {
    "id": 28498,
    "book": "psalms                                  ",
    "chapter": "18",
    "verse": "33",
    "text": "Egli ammaestra le mie mani alla battaglia;"
  },
  {
    "id": 28499,
    "book": "psalms                                  ",
    "chapter": "18",
    "verse": "34",
    "text": "Tu mi hai ancora dato lo scudo della tua salvezza;"
  },
  {
    "id": 28500,
    "book": "psalms                                  ",
    "chapter": "18",
    "verse": "35",
    "text": "Tu hai allargati i miei passi sotto di me;"
  },
  {
    "id": 28501,
    "book": "psalms                                  ",
    "chapter": "18",
    "verse": "36",
    "text": "Io ho perseguitati i miei nemici, e li ho aggiunti;"
  },
  {
    "id": 28502,
    "book": "psalms                                  ",
    "chapter": "18",
    "verse": "37",
    "text": "Io li ho rotti, e non son potuti risorgere;"
  },
  {
    "id": 28503,
    "book": "psalms                                  ",
    "chapter": "18",
    "verse": "38",
    "text": "E tu mi hai cinto di prodezza per la guerra;"
  },
  {
    "id": 28504,
    "book": "psalms                                  ",
    "chapter": "18",
    "verse": "39",
    "text": "Ed hai fatto voltar le spalle a' miei nemici davanti a me18.39 me Esod. 23.27.;"
  },
  {
    "id": 28505,
    "book": "psalms                                  ",
    "chapter": "18",
    "verse": "40",
    "text": "Essi gridarono, ma non vi fu chi li salvasse;"
  },
  {
    "id": 28506,
    "book": "psalms                                  ",
    "chapter": "18",
    "verse": "41",
    "text": "Ed io li ho tritati, come polvere esposta al vento;"
  },
  {
    "id": 28507,
    "book": "psalms                                  ",
    "chapter": "18",
    "verse": "42",
    "text": "Tu mi hai scampato dalle brighe del popolo18.42 popolo 2 Sam. 2.8-10; 3.1.;"
  },
  {
    "id": 28508,
    "book": "psalms                                  ",
    "chapter": "18",
    "verse": "43",
    "text": "Al solo udir degli orecchi si son ridotti sotto la mia ubbidienza;"
  },
  {
    "id": 28509,
    "book": "psalms                                  ",
    "chapter": "18",
    "verse": "44",
    "text": "Gli stranieri son divenuti fiacchi,"
  },
  {
    "id": 28510,
    "book": "psalms                                  ",
    "chapter": "18",
    "verse": "45",
    "text": "Viva il Signore, e benedetta sia la mia Rocca;"
  },
  {
    "id": 28511,
    "book": "psalms                                  ",
    "chapter": "18",
    "verse": "46",
    "text": "Iddio che mi dà il modo di far le mie vendette,"
  },
  {
    "id": 28512,
    "book": "psalms                                  ",
    "chapter": "18",
    "verse": "47",
    "text": "Che mi scampa da' miei nemici,"
  },
  {
    "id": 28513,
    "book": "psalms                                  ",
    "chapter": "18",
    "verse": "48",
    "text": "Perciò, o Signore, io ti celebrerò fra le genti,"
  },
  {
    "id": 28514,
    "book": "psalms                                  ",
    "chapter": "18",
    "verse": "49",
    "text": "Il quale rende magnifiche le vittorie del suo re,"
  }
]