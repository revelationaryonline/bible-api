[
  {
    "id": 30089,
    "book": "psalms                                  ",
    "chapter": "108",
    "verse": "1",
    "text": "IL mio cuore è disposto, o Dio108.1 Dio Sal. 57.7-11.,"
  },
  {
    "id": 30090,
    "book": "psalms                                  ",
    "chapter": "108",
    "verse": "2",
    "text": "Saltero, e cetera, destati;"
  },
  {
    "id": 30091,
    "book": "psalms                                  ",
    "chapter": "108",
    "verse": "3",
    "text": "Io ti celebrerò fra i popoli, o Signore,"
  },
  {
    "id": 30092,
    "book": "psalms                                  ",
    "chapter": "108",
    "verse": "4",
    "text": "Perciocchè la tua benignità è grande, disopra il cielo;"
  },
  {
    "id": 30093,
    "book": "psalms                                  ",
    "chapter": "108",
    "verse": "5",
    "text": "Innalzati, o Dio, sopra i cieli;"
  },
  {
    "id": 30094,
    "book": "psalms                                  ",
    "chapter": "108",
    "verse": "6",
    "text": "Acciocchè i tuoi diletti sieno liberati108.6 liberati Sal. 60.5-12.;"
  },
  {
    "id": 30095,
    "book": "psalms                                  ",
    "chapter": "108",
    "verse": "7",
    "text": "Iddio ha parlato per la sua santità; io trionferò,"
  },
  {
    "id": 30096,
    "book": "psalms                                  ",
    "chapter": "108",
    "verse": "8",
    "text": "Mio è Galaad, mio è Manasse;"
  },
  {
    "id": 30097,
    "book": "psalms                                  ",
    "chapter": "108",
    "verse": "9",
    "text": "Moab è la caldaia del mio lavatoio;"
  },
  {
    "id": 30098,
    "book": "psalms                                  ",
    "chapter": "108",
    "verse": "10",
    "text": "Chi mi condurrà nella città della fortezza?"
  },
  {
    "id": 30099,
    "book": "psalms                                  ",
    "chapter": "108",
    "verse": "11",
    "text": "Non sarai desso tu, o Dio, che ci avevi scacciati,"
  },
  {
    "id": 30100,
    "book": "psalms                                  ",
    "chapter": "108",
    "verse": "12",
    "text": "Dacci aiuto, per uscir di distretta;"
  },
  {
    "id": 30101,
    "book": "psalms                                  ",
    "chapter": "108",
    "verse": "13",
    "text": "Coll'aiuto di Dio noi faremo prodezze;"
  }
]