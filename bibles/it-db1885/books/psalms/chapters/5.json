[
  {
    "id": 28321,
    "book": "psalms                                  ",
    "chapter": "5",
    "verse": "1",
    "text": "PORGI l'orecchio alle mie parole, o Signore;"
  },
  {
    "id": 28322,
    "book": "psalms                                  ",
    "chapter": "5",
    "verse": "2",
    "text": "Re mio, e Dio mio, attendi alla voce del mio grido;"
  },
  {
    "id": 28323,
    "book": "psalms                                  ",
    "chapter": "5",
    "verse": "3",
    "text": "Signore, ascolta da mattina la mia voce;"
  },
  {
    "id": 28324,
    "book": "psalms                                  ",
    "chapter": "5",
    "verse": "4",
    "text": "Perciocchè tu non sei un Dio che prenda piacere nell'empietà;"
  },
  {
    "id": 28325,
    "book": "psalms                                  ",
    "chapter": "5",
    "verse": "5",
    "text": "Gl'insensati non possono comparir davanti agli occhi tuoi;"
  },
  {
    "id": 28326,
    "book": "psalms                                  ",
    "chapter": "5",
    "verse": "6",
    "text": "Tu farai perire tutti quelli che parlano con menzogna;"
  },
  {
    "id": 28327,
    "book": "psalms                                  ",
    "chapter": "5",
    "verse": "7",
    "text": "Ma io, per la grandezza della tua benignità, entrerò nella tua Casa,"
  },
  {
    "id": 28328,
    "book": "psalms                                  ",
    "chapter": "5",
    "verse": "8",
    "text": "Signore, guidami per la tua giustizia, per cagion de' miei insidiatori;"
  },
  {
    "id": 28329,
    "book": "psalms                                  ",
    "chapter": "5",
    "verse": "9",
    "text": "Perciocchè nella bocca loro non v'è dirittura alcuna;"
  },
  {
    "id": 28330,
    "book": "psalms                                  ",
    "chapter": "5",
    "verse": "10",
    "text": "Condannali, o Dio;"
  },
  {
    "id": 28331,
    "book": "psalms                                  ",
    "chapter": "5",
    "verse": "11",
    "text": "E rallegrinsi tutti quelli che si confidano in te,"
  },
  {
    "id": 28332,
    "book": "psalms                                  ",
    "chapter": "5",
    "verse": "12",
    "text": "Perciocchè tu, Signore, benedirai il giusto;"
  }
