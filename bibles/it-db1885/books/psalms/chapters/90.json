[
  {
    "id": 29725,
    "book": "psalms                                  ",
    "chapter": "90",
    "verse": "1",
    "text": "O SIGNORE, tu ci sei stato un abitacolo"
  },
  {
    "id": 29726,
    "book": "psalms                                  ",
    "chapter": "90",
    "verse": "2",
    "text": "Avanti che i monti fosser nati90.2 nati Prov. 8.23-26.,"
  },
  {
    "id": 29727,
    "book": "psalms                                  ",
    "chapter": "90",
    "verse": "3",
    "text": "Tu fai ritornar l'uomo in polvere,"
  },
  {
    "id": 29728,
    "book": "psalms                                  ",
    "chapter": "90",
    "verse": "4",
    "text": "Perciocchè mille anni sono appo te"
  },
  {
    "id": 29729,
    "book": "psalms                                  ",
    "chapter": "90",
    "verse": "5",
    "text": "Tu porti via gli uomini, come per una piena d'acque;"
  },
  {
    "id": 29730,
    "book": "psalms                                  ",
    "chapter": "90",
    "verse": "6",
    "text": "La mattina ella fiorisce e si rinnovella;"
  },
  {
    "id": 29731,
    "book": "psalms                                  ",
    "chapter": "90",
    "verse": "7",
    "text": "Perciocchè noi veniam meno per la tua ira;"
  },
  {
    "id": 29732,
    "book": "psalms                                  ",
    "chapter": "90",
    "verse": "8",
    "text": "Tu metti davanti a te le nostre iniquità90.8 iniquità Sal. 50.21. Ger. 16.17.,"
  },
  {
    "id": 29733,
    "book": "psalms                                  ",
    "chapter": "90",
    "verse": "9",
    "text": "Conciossiachè tutti i nostri giorni dichinino per la tua ira;"
  },
  {
    "id": 29734,
    "book": "psalms                                  ",
    "chapter": "90",
    "verse": "10",
    "text": "I giorni de' nostri anni, in alcuni non sono che settant'anni;"
  },
  {
    "id": 29735,
    "book": "psalms                                  ",
    "chapter": "90",
    "verse": "11",
    "text": "Chi conosce la forza della tua ira,"
  },
  {
    "id": 29736,
    "book": "psalms                                  ",
    "chapter": "90",
    "verse": "12",
    "text": "Insegnaci adunque a contare i nostri dì90.12 dì Sal. 39.4.;"
  },
  {
    "id": 29737,
    "book": "psalms                                  ",
    "chapter": "90",
    "verse": "13",
    "text": "Rivolgiti, Signore; infino a quando?"
  },
  {
    "id": 29738,
    "book": "psalms                                  ",
    "chapter": "90",
    "verse": "14",
    "text": "Saziaci ogni mattina della tua benignità;"
  },
  {
    "id": 29739,
    "book": "psalms                                  ",
    "chapter": "90",
    "verse": "15",
    "text": "Rallegraci, al par de' giorni che tu ci hai affliti;"
  },
  {
    "id": 29740,
    "book": "psalms                                  ",
    "chapter": "90",
    "verse": "16",
    "text": "Apparisca l'opera tua verso i tuoi servitori90.16 servitori Sal. 92.4. Abac. 3.2.,"
  },
  {
    "id": 29741,
    "book": "psalms                                  ",
    "chapter": "90",
    "verse": "17",
    "text": "E sia il piacevole sguardo del Signore Iddio nostro sopra noi;"
  }
]