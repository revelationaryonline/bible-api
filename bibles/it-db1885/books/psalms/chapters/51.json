[
  {
    "id": 29038,
    "book": "psalms                                  ",
    "chapter": "51",
    "verse": "1",
    "text": "ABBI pietà di me, o Dio, secondo la tua benignità;"
  },
  {
    "id": 29039,
    "book": "psalms                                  ",
    "chapter": "51",
    "verse": "2",
    "text": "Lavami molto e molto della mia iniquità,"
  },
  {
    "id": 29040,
    "book": "psalms                                  ",
    "chapter": "51",
    "verse": "3",
    "text": "Perciocchè io conosco i miei misfatti,"
  },
  {
    "id": 29041,
    "book": "psalms                                  ",
    "chapter": "51",
    "verse": "4",
    "text": "Io ho peccato contro a te solo,"
  },
  {
    "id": 29042,
    "book": "psalms                                  ",
    "chapter": "51",
    "verse": "5",
    "text": "Ecco, io sono stato formato in iniquità51.5 iniquità Giov. 3.6. Rom. 5.12-19. Efes. 2.3.;"
  },
  {
    "id": 29043,
    "book": "psalms                                  ",
    "chapter": "51",
    "verse": "6",
    "text": "Ecco, ti è piaciuto insegnarmi verità nell'interiore,"
  },
  {
    "id": 29044,
    "book": "psalms                                  ",
    "chapter": "51",
    "verse": "7",
    "text": "Purgami con isopo51.7 isopo Esod. 12.22. Lev. 14.4,6,49. Num. 19.18. Ebr. 9.19., e sarò netto;"
  },
  {
    "id": 29045,
    "book": "psalms                                  ",
    "chapter": "51",
    "verse": "8",
    "text": "Fammi udire gioia ed allegrezza;"
  },
  {
    "id": 29046,
    "book": "psalms                                  ",
    "chapter": "51",
    "verse": "9",
    "text": "Nascondi la tua faccia da' miei peccati51.9 peccati Ger. 16.17.,"
  },
  {
    "id": 29047,
    "book": "psalms                                  ",
    "chapter": "51",
    "verse": "10",
    "text": "O Dio, crea in me un cuor puro51.10 puro Fat. 15.9. Efes. 2.10.,"
  },
  {
    "id": 29048,
    "book": "psalms                                  ",
    "chapter": "51",
    "verse": "11",
    "text": "Non rigettarmi dalla tua faccia51.11 faccia Gen. 4.14.;"
  },
  {
    "id": 29049,
    "book": "psalms                                  ",
    "chapter": "51",
    "verse": "12",
    "text": "Rendimi l'allegrezza della tua salute;"
  },
  {
    "id": 29050,
    "book": "psalms                                  ",
    "chapter": "51",
    "verse": "13",
    "text": "Io insegnerò le tue vie a' trasgressori;"
  },
  {
    "id": 29051,
    "book": "psalms                                  ",
    "chapter": "51",
    "verse": "14",
    "text": "Liberami dal sangue51.14 sangue 2 Sam. 11.17; 12.9., o Dio, Dio della mia salute;"
  },
  {
    "id": 29052,
    "book": "psalms                                  ",
    "chapter": "51",
    "verse": "15",
    "text": "Signore, aprimi le labbra;"
  },
  {
    "id": 29053,
    "book": "psalms                                  ",
    "chapter": "51",
    "verse": "16",
    "text": "Perciocchè tu non prendi piacere in sacrificio51.16 sacrificio 1 Sam. 15.22 e rif.;"
  },
  {
    "id": 29054,
    "book": "psalms                                  ",
    "chapter": "51",
    "verse": "17",
    "text": "I sacrificii di Dio sono lo spirito rotto;"
  },
  {
    "id": 29055,
    "book": "psalms                                  ",
    "chapter": "51",
    "verse": "18",
    "text": "Fa' del bene a Sion per la tua benevolenza;"
  },
  {
    "id": 29056,
    "book": "psalms                                  ",
    "chapter": "51",
    "verse": "19",
    "text": "Allora prenderai piacere in sacrificii di giustizia51.19 giustizia Sal. 4.5. Mal. 3.3.,"
  }
]