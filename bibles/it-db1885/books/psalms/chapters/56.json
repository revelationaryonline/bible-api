[
  {
    "id": 29102,
    "book": "psalms                                  ",
    "chapter": "56",
    "verse": "1",
    "text": "ABBI pietà di me, o Dio;"
  },
  {
    "id": 29103,
    "book": "psalms                                  ",
    "chapter": "56",
    "verse": "2",
    "text": "I miei nemici son dietro a me a gola aperta tuttodì;"
  },
  {
    "id": 29104,
    "book": "psalms                                  ",
    "chapter": "56",
    "verse": "3",
    "text": "Nel giorno che io temerò,"
  },
  {
    "id": 29105,
    "book": "psalms                                  ",
    "chapter": "56",
    "verse": "4",
    "text": "Coll'aiuto di Dio, io loderò la sua parola;"
  },
  {
    "id": 29106,
    "book": "psalms                                  ",
    "chapter": "56",
    "verse": "5",
    "text": "Tuttodì fanno dolorose le mie parole;"
  },
  {
    "id": 29107,
    "book": "psalms                                  ",
    "chapter": "56",
    "verse": "6",
    "text": "Si radunano insieme, stanno in agguato; spiano le mie pedate,"
  },
  {
    "id": 29108,
    "book": "psalms                                  ",
    "chapter": "56",
    "verse": "7",
    "text": "In vano sarebbe il salvar loro la vita;"
  },
  {
    "id": 29109,
    "book": "psalms                                  ",
    "chapter": "56",
    "verse": "8",
    "text": "Tu hai contate le mie fughe;"
  },
  {
    "id": 29110,
    "book": "psalms                                  ",
    "chapter": "56",
    "verse": "9",
    "text": "Allora i miei nemici volteranno le spalle, nel giorno che io griderò;"
  },
  {
    "id": 29111,
    "book": "psalms                                  ",
    "chapter": "56",
    "verse": "10",
    "text": "Con l'aiuto di Dio, io loderò la sua parola;"
  },
  {
    "id": 29112,
    "book": "psalms                                  ",
    "chapter": "56",
    "verse": "11",
    "text": "Io mi confido in Dio;"
  },
  {
    "id": 29113,
    "book": "psalms                                  ",
    "chapter": "56",
    "verse": "12",
    "text": "Io ho sopra me i voti che io ti ho fatti, o Dio;"
  },
  {
    "id": 29114,
    "book": "psalms                                  ",
    "chapter": "56",
    "verse": "13",
    "text": "Conciossiachè tu abbi riscossa l'anima mia dalla morte56.13 morte Sal. 49.15; 103.4; 116.8.;"
  }
]