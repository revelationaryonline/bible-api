[
  {
    "id": 29998,
    "book": "psalms                                  ",
    "chapter": "106",
    "verse": "1",
    "text": "ALLELUIA."
  },
  {
    "id": 29999,
    "book": "psalms                                  ",
    "chapter": "106",
    "verse": "2",
    "text": "Chi potrà raccontar le potenze del Signore106.2 Signore Sal. 40.5.?"
  },
  {
    "id": 30000,
    "book": "psalms                                  ",
    "chapter": "106",
    "verse": "3",
    "text": "Beati coloro che osservano la dirittura,"
  },
  {
    "id": 30001,
    "book": "psalms                                  ",
    "chapter": "106",
    "verse": "4",
    "text": "Ricordati di me, o Signore,"
  },
  {
    "id": 30002,
    "book": "psalms                                  ",
    "chapter": "106",
    "verse": "5",
    "text": "Acciocchè io vegga il bene de' tuoi eletti,"
  },
  {
    "id": 30003,
    "book": "psalms                                  ",
    "chapter": "106",
    "verse": "6",
    "text": "Noi, e i nostri padri, abbiam peccato,"
  },
  {
    "id": 30004,
    "book": "psalms                                  ",
    "chapter": "106",
    "verse": "7",
    "text": "I nostri padri in Egitto non considerarono le tue maraviglie,"
  },
  {
    "id": 30005,
    "book": "psalms                                  ",
    "chapter": "106",
    "verse": "8",
    "text": "Ma pure il Signore li salvò per l'amor del suo Nome106.8 Nome Ezec. 20.14.,"
  },
  {
    "id": 30006,
    "book": "psalms                                  ",
    "chapter": "106",
    "verse": "9",
    "text": "E sgridò il Mar rosso, ed esso si seccò;"
  },
  {
    "id": 30007,
    "book": "psalms                                  ",
    "chapter": "106",
    "verse": "10",
    "text": "E li salvò di man di coloro che li odiavano,"
  },
  {
    "id": 30008,
    "book": "psalms                                  ",
    "chapter": "106",
    "verse": "11",
    "text": "E le acque copersero i lor nemici;"
  },
  {
    "id": 30009,
    "book": "psalms                                  ",
    "chapter": "106",
    "verse": "12",
    "text": "Allora credettero alle sue parole;"
  },
  {
    "id": 30010,
    "book": "psalms                                  ",
    "chapter": "106",
    "verse": "13",
    "text": "Ma presto dimenticarono le sue opere106.13 opere Esod. 15.24; 16.2; 17.2.;"
  },
  {
    "id": 30011,
    "book": "psalms                                  ",
    "chapter": "106",
    "verse": "14",
    "text": "E si accessero di cupidigia nel deserto106.14 deserto Num. 11.4 ecc.;"
  },
  {
    "id": 30012,
    "book": "psalms                                  ",
    "chapter": "106",
    "verse": "15",
    "text": "Ed egli diede loro ciò che chiedevano106.15 chiedevano Num. 11.31. Sal. 78.29.;"
  },
  {
    "id": 30013,
    "book": "psalms                                  ",
    "chapter": "106",
    "verse": "16",
    "text": "Oltre a ciò furono mossi d'invidia contro a Mosè106.16 Mosè Num. 16.1 ecc., nel campo;"
  },
  {
    "id": 30014,
    "book": "psalms                                  ",
    "chapter": "106",
    "verse": "17",
    "text": "La terra si aperse, e tranghiottì Datan,"
  },
  {
    "id": 30015,
    "book": "psalms                                  ",
    "chapter": "106",
    "verse": "18",
    "text": "E il fuoco arse la lor raunanza;"
  },
  {
    "id": 30016,
    "book": "psalms                                  ",
    "chapter": "106",
    "verse": "19",
    "text": "Fecero un vitello in Horeb,"
  },
  {
    "id": 30017,
    "book": "psalms                                  ",
    "chapter": "106",
    "verse": "20",
    "text": "E mutarono la lor gloria"
  },
  {
    "id": 30018,
    "book": "psalms                                  ",
    "chapter": "106",
    "verse": "21",
    "text": "Dimenticarono Iddio, lor Salvatore,"
  },
  {
    "id": 30019,
    "book": "psalms                                  ",
    "chapter": "106",
    "verse": "22",
    "text": "Cose maravigliose nel paese di Cam,"
  },
  {
    "id": 30020,
    "book": "psalms                                  ",
    "chapter": "106",
    "verse": "23",
    "text": "Onde egli disse di sterminarli;"
  },
  {
    "id": 30021,
    "book": "psalms                                  ",
    "chapter": "106",
    "verse": "24",
    "text": "Disdegnarono ancora il paese desiderabile106.24 desiderabile Deut. 8.7.;"
  },
  {
    "id": 30022,
    "book": "psalms                                  ",
    "chapter": "106",
    "verse": "25",
    "text": "E mormorarono ne' lor tabernacoli106.25 tabernacoli Num. 14.2 ecc.;"
  },
  {
    "id": 30023,
    "book": "psalms                                  ",
    "chapter": "106",
    "verse": "26",
    "text": "Onde egli alzò loro la mano,"
  },
  {
    "id": 30024,
    "book": "psalms                                  ",
    "chapter": "106",
    "verse": "27",
    "text": "E che farebbe cader la lor progenie fra le genti,"
  },
  {
    "id": 30025,
    "book": "psalms                                  ",
    "chapter": "106",
    "verse": "28",
    "text": "Oltre a ciò si congiunsero con Baal-peor106.28 Baal-peor Num. 25.1-3; 31.16. Apoc. 2.14.,"
  },
  {
    "id": 30026,
    "book": "psalms                                  ",
    "chapter": "106",
    "verse": "29",
    "text": "E dispettarono Iddio co' lor fatti,"
  },
  {
    "id": 30027,
    "book": "psalms                                  ",
    "chapter": "106",
    "verse": "30",
    "text": "Ma Finees si feve avanti106.30 avanti Num. 25.7 ecc., e fece giudicio;"
  },
  {
    "id": 30028,
    "book": "psalms                                  ",
    "chapter": "106",
    "verse": "31",
    "text": "E ciò gli fu reputato per giustizia106.31 giustizia Num. 25.11 ecc.,"
  },
  {
    "id": 30029,
    "book": "psalms                                  ",
    "chapter": "106",
    "verse": "32",
    "text": "Provocarono ancora il Signore ad ira presso alla acque di Meriba,"
  },
  {
    "id": 30030,
    "book": "psalms                                  ",
    "chapter": "106",
    "verse": "33",
    "text": "Perciocchè inasprirono il suo spirito;"
  },
  {
    "id": 30031,
    "book": "psalms                                  ",
    "chapter": "106",
    "verse": "34",
    "text": "Essi non distrussero i popoli,"
  },
  {
    "id": 30032,
    "book": "psalms                                  ",
    "chapter": "106",
    "verse": "35",
    "text": "Anzi si mescolarono fra le genti,"
  },
  {
    "id": 30033,
    "book": "psalms                                  ",
    "chapter": "106",
    "verse": "36",
    "text": "E servirono a' loro idoli106.36 idoli Giud. 2.12,13; 3.6,7.,"
  },
  {
    "id": 30034,
    "book": "psalms                                  ",
    "chapter": "106",
    "verse": "37",
    "text": "E sacrificarono i lor figluoli106.37 figliuoli 2 Re. 16.3 e rif.."
  },
  {
    "id": 30035,
    "book": "psalms                                  ",
    "chapter": "106",
    "verse": "38",
    "text": "E sparsero il sangue innocente,"
  },
  {
    "id": 30036,
    "book": "psalms                                  ",
    "chapter": "106",
    "verse": "39",
    "text": "Ed essi si contaminarono per le loro opere,"
  },
  {
    "id": 30037,
    "book": "psalms                                  ",
    "chapter": "106",
    "verse": "40",
    "text": "Onde l'ira del Signore si accese contro al suo popolo,"
  },
  {
    "id": 30038,
    "book": "psalms                                  ",
    "chapter": "106",
    "verse": "41",
    "text": "E li diede in man delle genti106.41 genti Giud. 2.14. Neem. 9.27.;"
  },
  {
    "id": 30039,
    "book": "psalms                                  ",
    "chapter": "106",
    "verse": "42",
    "text": "E i lor nemici li oppressarono;"
  },
  {
    "id": 30040,
    "book": "psalms                                  ",
    "chapter": "106",
    "verse": "43",
    "text": "Egli li riscosse molte volte106.43 volte Giud. 2.16 ecc.;"
  },
  {
    "id": 30041,
    "book": "psalms                                  ",
    "chapter": "106",
    "verse": "44",
    "text": "E pure egli ha riguardato, quando sono stati in distretta;"
  },
  {
    "id": 30042,
    "book": "psalms                                  ",
    "chapter": "106",
    "verse": "45",
    "text": "E si è ricordato inverso loro del suo patto106.45 patto Lev. 26.41,42.,"
  },
  {
    "id": 30043,
    "book": "psalms                                  ",
    "chapter": "106",
    "verse": "46",
    "text": "Ed ha renduti loro pietosi"
  },
  {
    "id": 30044,
    "book": "psalms                                  ",
    "chapter": "106",
    "verse": "47",
    "text": "Salvaci, o Signore Iddio nostro,"
  },
  {
    "id": 30045,
    "book": "psalms                                  ",
    "chapter": "106",
    "verse": "48",
    "text": "Benedetto sia il Signore Iddio d'Israele di secolo in secolo."
  }
]