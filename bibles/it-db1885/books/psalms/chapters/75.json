[
  {
    "id": 29418,
    "book": "psalms                                  ",
    "chapter": "75",
    "verse": "1",
    "text": "NOI ti celebriamo, noi ti celebriamo, o Dio;"
  },
  {
    "id": 29419,
    "book": "psalms                                  ",
    "chapter": "75",
    "verse": "2",
    "text": "Al tempo che avrò fissato,"
  },
  {
    "id": 29420,
    "book": "psalms                                  ",
    "chapter": "75",
    "verse": "3",
    "text": "Il paese e tutti i suoi abitanti si struggevano;"
  },
  {
    "id": 29421,
    "book": "psalms                                  ",
    "chapter": "75",
    "verse": "4",
    "text": "Io ho detto agl'insensati: Non siate insensati;"
  },
  {
    "id": 29422,
    "book": "psalms                                  ",
    "chapter": "75",
    "verse": "5",
    "text": "Non levate il vostro corno ad alto;"
  },
  {
    "id": 29423,
    "book": "psalms                                  ",
    "chapter": "75",
    "verse": "6",
    "text": "Perciocchè nè di Levante, nè di Ponente,"
  },
  {
    "id": 29424,
    "book": "psalms                                  ",
    "chapter": "75",
    "verse": "7",
    "text": "Ma Iddio è quel che giudica75.7 giudica Sal. 50.6; 58.11.;"
  },
  {
    "id": 29425,
    "book": "psalms                                  ",
    "chapter": "75",
    "verse": "8",
    "text": "Perciocchè il Signore ha in mano una coppa,"
  },
  {
    "id": 29426,
    "book": "psalms                                  ",
    "chapter": "75",
    "verse": "9",
    "text": "Ora, quant'è a me, io predicherò queste cose in perpetuo,"
  },
  {
    "id": 29427,
    "book": "psalms                                  ",
    "chapter": "75",
    "verse": "10",
    "text": "E mozzerò tutte le corna degli empi;"
  }
]