[
  {
    "id": 29347,
    "book": "psalms                                  ",
    "chapter": "72",
    "verse": "1",
    "text": "O DIO, da' i tuoi giudicii al re,"
  },
  {
    "id": 29348,
    "book": "psalms                                  ",
    "chapter": "72",
    "verse": "2",
    "text": "Ed egli giudicherà il tuo popolo in giustizia,"
  },
  {
    "id": 29349,
    "book": "psalms                                  ",
    "chapter": "72",
    "verse": "3",
    "text": "I monti produrranno pace al popolo;"
  },
  {
    "id": 29350,
    "book": "psalms                                  ",
    "chapter": "72",
    "verse": "4",
    "text": "Egli farà ragione a' poveri afflitti d'infra il popolo;"
  },
  {
    "id": 29351,
    "book": "psalms                                  ",
    "chapter": "72",
    "verse": "5",
    "text": "Essi ti temeranno per ogni età,"
  },
  {
    "id": 29352,
    "book": "psalms                                  ",
    "chapter": "72",
    "verse": "6",
    "text": "Egli scenderà come pioggia sopra erba segata;"
  },
  {
    "id": 29353,
    "book": "psalms                                  ",
    "chapter": "72",
    "verse": "7",
    "text": "Il giusto fiorirà a' dì d'esso,"
  },
  {
    "id": 29354,
    "book": "psalms                                  ",
    "chapter": "72",
    "verse": "8",
    "text": "Ed egli signoreggerà da un mare all'altro,"
  },
  {
    "id": 29355,
    "book": "psalms                                  ",
    "chapter": "72",
    "verse": "9",
    "text": "Quelli che abitano ne' deserti s'inchineranno davanti a lui,"
  },
  {
    "id": 29356,
    "book": "psalms                                  ",
    "chapter": "72",
    "verse": "10",
    "text": "I re di Tarsis e delle isole gli pagheranno tributo;"
  },
  {
    "id": 29357,
    "book": "psalms                                  ",
    "chapter": "72",
    "verse": "11",
    "text": "E tutti i re l'adoreranno,"
  },
  {
    "id": 29358,
    "book": "psalms                                  ",
    "chapter": "72",
    "verse": "12",
    "text": "Perciocchè egli libererà il bisognoso che grida,"
  },
  {
    "id": 29359,
    "book": "psalms                                  ",
    "chapter": "72",
    "verse": "13",
    "text": "Egli avrà compassione del misero e del bisognoso,"
  },
  {
    "id": 29360,
    "book": "psalms                                  ",
    "chapter": "72",
    "verse": "14",
    "text": "Egli riscoterà la vita loro da frode e da violenza;"
  },
  {
    "id": 29361,
    "book": "psalms                                  ",
    "chapter": "72",
    "verse": "15",
    "text": "Così egli viverà, ed altri gli darà dell'oro di Etiopia;"
  },
  {
    "id": 29362,
    "book": "psalms                                  ",
    "chapter": "72",
    "verse": "16",
    "text": "Essendo seminata in terra, sulla sommità de' monti, pure una menata di frumento,"
  },
  {
    "id": 29363,
    "book": "psalms                                  ",
    "chapter": "72",
    "verse": "17",
    "text": "Il suo nome durerà in eterno,"
  },
  {
    "id": 29364,
    "book": "psalms                                  ",
    "chapter": "72",
    "verse": "18",
    "text": "Benedetto sia il Signore Iddio, l'Iddio d'Israele,"
  },
  {
    "id": 29365,
    "book": "psalms                                  ",
    "chapter": "72",
    "verse": "19",
    "text": "Benedetto sia ancora eternamente il Nome suo glorioso;"
  },
  {
    "id": 29366,
    "book": "psalms                                  ",
    "chapter": "72",
    "verse": "20",
    "text": "Qui finiscono le orazioni di Davide, figliuolo d'Isai."
  }
]