[
  {
    "id": 29673,
    "book": "psalms                                  ",
    "chapter": "89",
    "verse": "1",
    "text": "IO canterò in perpetuo le benignità del Signore;"
  },
  {
    "id": 29674,
    "book": "psalms                                  ",
    "chapter": "89",
    "verse": "2",
    "text": "Perciocchè io ho detto: La tua benignità sarà stabile in eterno;"
  },
  {
    "id": 29675,
    "book": "psalms                                  ",
    "chapter": "89",
    "verse": "3",
    "text": "Io ho fatto, dice il Signore, patto col mio eletto;"
  },
  {
    "id": 29676,
    "book": "psalms                                  ",
    "chapter": "89",
    "verse": "4",
    "text": "Io fonderò la tua progenie in eterno,"
  },
  {
    "id": 29677,
    "book": "psalms                                  ",
    "chapter": "89",
    "verse": "5",
    "text": "I cieli parimente celebreranno le tue maraviglie, o Signore89.5 Signore Sal. 19.2. Apoc. 7.10-12.;"
  },
  {
    "id": 29678,
    "book": "psalms                                  ",
    "chapter": "89",
    "verse": "6",
    "text": "Perciocchè, chi è nel cielo che pareggi il Signore;"
  },
  {
    "id": 29679,
    "book": "psalms                                  ",
    "chapter": "89",
    "verse": "7",
    "text": "Iddio è grandemente spaventevole nel consiglio de' santi,"
  },
  {
    "id": 29680,
    "book": "psalms                                  ",
    "chapter": "89",
    "verse": "8",
    "text": "O Signore Iddio degli eserciti, chi è potente Signore come sei tu89.8 tu Esod. 15.11 e rif.?"
  },
  {
    "id": 29681,
    "book": "psalms                                  ",
    "chapter": "89",
    "verse": "9",
    "text": "Tu signoreggi sopra l'alterezza del mare;"
  },
  {
    "id": 29682,
    "book": "psalms                                  ",
    "chapter": "89",
    "verse": "10",
    "text": "Tu hai fiaccato Rahab, a guisa d'uomo ferito a morte;"
  },
  {
    "id": 29683,
    "book": "psalms                                  ",
    "chapter": "89",
    "verse": "11",
    "text": "I cieli son tuoi, tua eziandio è la terra89.11 terra Sal. 24.1,2; 50.12.;"
  },
  {
    "id": 29684,
    "book": "psalms                                  ",
    "chapter": "89",
    "verse": "12",
    "text": "Tu hai creato il Settentrione ed il Mezzodì;"
  },
  {
    "id": 29685,
    "book": "psalms                                  ",
    "chapter": "89",
    "verse": "13",
    "text": "Tu hai un braccio forte;"
  },
  {
    "id": 29686,
    "book": "psalms                                  ",
    "chapter": "89",
    "verse": "14",
    "text": "Giustizia e giudicio son la ferma base del tuo trono;"
  },
  {
    "id": 29687,
    "book": "psalms                                  ",
    "chapter": "89",
    "verse": "15",
    "text": "Beato il popolo che sa che cosa è il giubilare;"
  },
  {
    "id": 29688,
    "book": "psalms                                  ",
    "chapter": "89",
    "verse": "16",
    "text": "Festeggeranno tuttodì nel tuo nome,"
  },
  {
    "id": 29689,
    "book": "psalms                                  ",
    "chapter": "89",
    "verse": "17",
    "text": "Perchè tu sei la gloria della lor forza;"
  },
  {
    "id": 29690,
    "book": "psalms                                  ",
    "chapter": "89",
    "verse": "18",
    "text": "Perciocchè lo scudo nostro è del Signore;"
  },
  {
    "id": 29691,
    "book": "psalms                                  ",
    "chapter": "89",
    "verse": "19",
    "text": "Tu parlasti già in visione intorno al tuo Santo,"
  },
  {
    "id": 29692,
    "book": "psalms                                  ",
    "chapter": "89",
    "verse": "20",
    "text": "Io ho trovato Davide, mio servitore;"
  },
  {
    "id": 29693,
    "book": "psalms                                  ",
    "chapter": "89",
    "verse": "21",
    "text": "Col quale la mia mano sarà ferma;"
  },
  {
    "id": 29694,
    "book": "psalms                                  ",
    "chapter": "89",
    "verse": "22",
    "text": "Il nemico non l'oppresserà89.22 oppresserà 2 Sam. 7.9 ecc.;"
  },
  {
    "id": 29695,
    "book": "psalms                                  ",
    "chapter": "89",
    "verse": "23",
    "text": "Anzi io fiaccherò i suoi nemici, cacciandoli d'innanzi a lui;"
  },
  {
    "id": 29696,
    "book": "psalms                                  ",
    "chapter": "89",
    "verse": "24",
    "text": "E la mia verità, e la mia benignità, saranno con lui89.24 lui Sal. 61.7 e rif.;"
  },
  {
    "id": 29697,
    "book": "psalms                                  ",
    "chapter": "89",
    "verse": "25",
    "text": "E metterò la sua mano sopra il mare,"
  },
  {
    "id": 29698,
    "book": "psalms                                  ",
    "chapter": "89",
    "verse": "26",
    "text": "Egli m'invocherà, dicendo: Tu sei mio Padre89.26 Padre 2 Sam. 7.14.,"
  },
  {
    "id": 29699,
    "book": "psalms                                  ",
    "chapter": "89",
    "verse": "27",
    "text": "Io altresì lo costituirò il primogenito89.27 primogenito Sal. 2.7. Col. 1.15-18.,"
  },
  {
    "id": 29700,
    "book": "psalms                                  ",
    "chapter": "89",
    "verse": "28",
    "text": "Io gli osserverò la mia benignità in perpetuo,"
  },
  {
    "id": 29701,
    "book": "psalms                                  ",
    "chapter": "89",
    "verse": "29",
    "text": "E renderò la sua progenie eterna,"
  },
  {
    "id": 29702,
    "book": "psalms                                  ",
    "chapter": "89",
    "verse": "30",
    "text": "Se i suoi figliuoli abbandonano la mia Legge,"
  },
  {
    "id": 29703,
    "book": "psalms                                  ",
    "chapter": "89",
    "verse": "31",
    "text": "Se violano i miei statuti,"
  },
  {
    "id": 29704,
    "book": "psalms                                  ",
    "chapter": "89",
    "verse": "32",
    "text": "Io visiterò il lor misfatto con verga89.32 verga 2 Sam. 7.13,14. 1 Re. 11.31 ecc.,"
  },
  {
    "id": 29705,
    "book": "psalms                                  ",
    "chapter": "89",
    "verse": "33",
    "text": "Ma non annullerò la mia benignità inverso lui,"
  },
  {
    "id": 29706,
    "book": "psalms                                  ",
    "chapter": "89",
    "verse": "34",
    "text": "Io non violerò il mio patto,"
  },
  {
    "id": 29707,
    "book": "psalms                                  ",
    "chapter": "89",
    "verse": "35",
    "text": "Io ho giurato una volta per la mia santità:"
  },
  {
    "id": 29708,
    "book": "psalms                                  ",
    "chapter": "89",
    "verse": "36",
    "text": "Che la sua progenie sarà in eterno89.36 eterno 2 Sam. 7.16. Luc. 1.33. Giov. 12.34.,"
  },
  {
    "id": 29709,
    "book": "psalms                                  ",
    "chapter": "89",
    "verse": "37",
    "text": "Che sarà stabile in perpetuo, come la luna;"
  },
  {
    "id": 29710,
    "book": "psalms                                  ",
    "chapter": "89",
    "verse": "38",
    "text": "E pur tu l'hai cacciato lungi da te, e l'hai disdegnato89.38 disdegnato 1 Cron. 28.9. Sal. 44.9 ecc.;"
  },
  {
    "id": 29711,
    "book": "psalms                                  ",
    "chapter": "89",
    "verse": "39",
    "text": "Tu hai annullato il patto fatto col tuo servitore;"
  },
  {
    "id": 29712,
    "book": "psalms                                  ",
    "chapter": "89",
    "verse": "40",
    "text": "Tu hai rotte tutte le sue chiusure;"
  },
  {
    "id": 29713,
    "book": "psalms                                  ",
    "chapter": "89",
    "verse": "41",
    "text": "Tutti i passanti l'hanno predato;"
  },
  {
    "id": 29714,
    "book": "psalms                                  ",
    "chapter": "89",
    "verse": "42",
    "text": "Tu hai alzata la destra de' suoi avversari;"
  },
  {
    "id": 29715,
    "book": "psalms                                  ",
    "chapter": "89",
    "verse": "43",
    "text": "Tu hai eziandio rintuzzato il taglio della sua spada,"
  },
  {
    "id": 29716,
    "book": "psalms                                  ",
    "chapter": "89",
    "verse": "44",
    "text": "Tu l'hai spogliato del suo splendore,"
  },
  {
    "id": 29717,
    "book": "psalms                                  ",
    "chapter": "89",
    "verse": "45",
    "text": "Tu hai scorciati i giorni della sua giovanezza;"
  },
  {
    "id": 29718,
    "book": "psalms                                  ",
    "chapter": "89",
    "verse": "46",
    "text": "Infino a quando, o Signore, ti nasconderai tu?"
  },
  {
    "id": 29719,
    "book": "psalms                                  ",
    "chapter": "89",
    "verse": "47",
    "text": "Ricordati quanto poco tempo io ho da vivere nel mondo89.47 mondo Giob. 14.1 e rif.;"
  },
  {
    "id": 29720,
    "book": "psalms                                  ",
    "chapter": "89",
    "verse": "48",
    "text": "Chi è l'uomo che viva, senza veder mai la morte89.48 morte Ebr. 11.5.?"
  },
  {
    "id": 29721,
    "book": "psalms                                  ",
    "chapter": "89",
    "verse": "49",
    "text": "Ove sono, o Signore, le tue benignità antiche,"
  },
  {
    "id": 29722,
    "book": "psalms                                  ",
    "chapter": "89",
    "verse": "50",
    "text": "Ricordati, o Signore, del vituperio fatto a' tuoi servitori,"
  },
  {
    "id": 29723,
    "book": "psalms                                  ",
    "chapter": "89",
    "verse": "51",
    "text": "Conciossiachè i tuoi nemici abbiano vituperate, o Signore,"
  },
  {
    "id": 29724,
    "book": "psalms                                  ",
    "chapter": "89",
    "verse": "52",
    "text": "Benedetto sia il Signore in eterno89.52 eterno Sal. 41.13.."
  }
]