[
  {
    "id": 28598,
    "book": "psalms                                  ",
    "chapter": "25",
    "verse": "1",
    "text": "O SIGNORE, io levo l'anima mia a te."
  },
  {
    "id": 28599,
    "book": "psalms                                  ",
    "chapter": "25",
    "verse": "2",
    "text": "Dio mio, io mi confido in te; fa' che io non sia confuso25.2 confuso Sal. 22.5; 31.1; 34.8. Is. 28.16. Rom. 10.11.,"
  },
  {
    "id": 28600,
    "book": "psalms                                  ",
    "chapter": "25",
    "verse": "3",
    "text": "Ed anche che niuno di quelli che sperano in te sia confuso;"
  },
  {
    "id": 28601,
    "book": "psalms                                  ",
    "chapter": "25",
    "verse": "4",
    "text": "Signore, fammi conoscere le tue vie;"
  },
  {
    "id": 28602,
    "book": "psalms                                  ",
    "chapter": "25",
    "verse": "5",
    "text": "Inviami nella tua verità, ed ammaestrami;"
  },
  {
    "id": 28603,
    "book": "psalms                                  ",
    "chapter": "25",
    "verse": "6",
    "text": "Ricordati, Signore, delle tue compassioni, e delle tue benignità25.6 benignità Sal. 103.17; 106.1; 107.1. Ger. 33.11.;"
  },
  {
    "id": 28604,
    "book": "psalms                                  ",
    "chapter": "25",
    "verse": "7",
    "text": "Non ridurti a memoria i peccati della mia giovanezza,"
  },
  {
    "id": 28605,
    "book": "psalms                                  ",
    "chapter": "25",
    "verse": "8",
    "text": "Il Signore è buono e diritto;"
  },
  {
    "id": 28606,
    "book": "psalms                                  ",
    "chapter": "25",
    "verse": "9",
    "text": "Egli invierà i mansueti nella dirittura,"
  },
  {
    "id": 28607,
    "book": "psalms                                  ",
    "chapter": "25",
    "verse": "10",
    "text": "Tutte le vie del Signore son benignità e verità,"
  },
  {
    "id": 28608,
    "book": "psalms                                  ",
    "chapter": "25",
    "verse": "11",
    "text": "O Signore, per amor del tuo Nome,"
  },
  {
    "id": 28609,
    "book": "psalms                                  ",
    "chapter": "25",
    "verse": "12",
    "text": "Chi è l'uomo che tema il Signore?"
  },
  {
    "id": 28610,
    "book": "psalms                                  ",
    "chapter": "25",
    "verse": "13",
    "text": "L'anima sua dimorerà per mezzo i beni25.13 beni Prov. 19.23.,"
  },
  {
    "id": 28611,
    "book": "psalms                                  ",
    "chapter": "25",
    "verse": "14",
    "text": "Il Signore dà a conoscere il suo consiglio ed il suo patto25.14 patto Giov. 7.17; 15.15."
  },
  {
    "id": 28612,
    "book": "psalms                                  ",
    "chapter": "25",
    "verse": "15",
    "text": "I miei occhi son del continuo verso il Signore;"
  },
  {
    "id": 28613,
    "book": "psalms                                  ",
    "chapter": "25",
    "verse": "16",
    "text": "Riguarda a me, ed abbi pietà di me;"
  },
  {
    "id": 28614,
    "book": "psalms                                  ",
    "chapter": "25",
    "verse": "17",
    "text": "Le angosce del mio cuore si sono aumentate;"
  },
  {
    "id": 28615,
    "book": "psalms                                  ",
    "chapter": "25",
    "verse": "18",
    "text": "Vedi la mia afflizione ed il mio affanno;"
  },
  {
    "id": 28616,
    "book": "psalms                                  ",
    "chapter": "25",
    "verse": "19",
    "text": "Vedi i miei nemici; perciocchè son molti,"
  },
  {
    "id": 28617,
    "book": "psalms                                  ",
    "chapter": "25",
    "verse": "20",
    "text": "Guarda l'anima mia, e riscuotimi;"
  },
  {
    "id": 28618,
    "book": "psalms                                  ",
    "chapter": "25",
    "verse": "21",
    "text": "L'integrità e la dirittura mi guardino;"
  },
  {
    "id": 28619,
    "book": "psalms                                  ",
    "chapter": "25",
    "verse": "22",
    "text": "O Dio, riscuoti Israele da tutte le sue tribolazioni."
  }
]