[
  {
    "id": 28389,
    "book": "psalms                                  ",
    "chapter": "10",
    "verse": "1",
    "text": "O SIGNORE, perchè te ne stai lontano?"
  },
  {
    "id": 28390,
    "book": "psalms                                  ",
    "chapter": "10",
    "verse": "2",
    "text": "L'empio colla sua superbia persegue il povero afflitto;"
  },
  {
    "id": 28391,
    "book": "psalms                                  ",
    "chapter": "10",
    "verse": "3",
    "text": "Perciocchè l'empio si gloria de' desiderii dell'anima sua;"
  },
  {
    "id": 28392,
    "book": "psalms                                  ",
    "chapter": "10",
    "verse": "4",
    "text": "L'empio, secondo l'alterezza del suo volto, non si cura di nulla;"
  },
  {
    "id": 28393,
    "book": "psalms                                  ",
    "chapter": "10",
    "verse": "5",
    "text": "Le sue vie son profane in ogni tempo;"
  },
  {
    "id": 28394,
    "book": "psalms                                  ",
    "chapter": "10",
    "verse": "6",
    "text": "Egli dice nel suo cuore: Io non sarò giammai smosso10.6 smosso Eccl. 8.11. Is. 56.12.;"
  },
  {
    "id": 28395,
    "book": "psalms                                  ",
    "chapter": "10",
    "verse": "7",
    "text": "La sua bocca è piena di esecrazione, e di frodi, e d'inganno10.7 inganno Sal. 12.2. Rom. 3.14.;"
  },
  {
    "id": 28396,
    "book": "psalms                                  ",
    "chapter": "10",
    "verse": "8",
    "text": "Egli sta negli agguati per le ville;"
  },
  {
    "id": 28397,
    "book": "psalms                                  ",
    "chapter": "10",
    "verse": "9",
    "text": "Egli insidia il povero nel suo nascondimento,"
  },
  {
    "id": 28398,
    "book": "psalms                                  ",
    "chapter": "10",
    "verse": "10",
    "text": "Egli se ne sta quatto e chino;"
  },
  {
    "id": 28399,
    "book": "psalms                                  ",
    "chapter": "10",
    "verse": "11",
    "text": "Egli dice nel cuor suo: Iddio l'ha dimenticato;"
  },
  {
    "id": 28400,
    "book": "psalms                                  ",
    "chapter": "10",
    "verse": "12",
    "text": "Levati, Signore; o Dio, alza la tua mano;"
  },
  {
    "id": 28401,
    "book": "psalms                                  ",
    "chapter": "10",
    "verse": "13",
    "text": "Perchè l'empio dispetta egli Iddio?"
  },
  {
    "id": 28402,
    "book": "psalms                                  ",
    "chapter": "10",
    "verse": "14",
    "text": "Tu l'hai pur veduto; perciocchè tu riguardi l'oltraggio e il dispetto,"
  },
  {
    "id": 28403,
    "book": "psalms                                  ",
    "chapter": "10",
    "verse": "15",
    "text": "Fiacca il braccio dell'empio;"
  },
  {
    "id": 28404,
    "book": "psalms                                  ",
    "chapter": "10",
    "verse": "16",
    "text": "Il Signore è re in sempiterno10.16 sempiterno Sal. 145.13. Ger. 10.10. Lam. 5.19. 1 Tim. 1.17.;"
  },
  {
    "id": 28405,
    "book": "psalms                                  ",
    "chapter": "10",
    "verse": "17",
    "text": "O Signore, tu esaudisci il desiderio degli umili;"
  },
  {
    "id": 28406,
    "book": "psalms                                  ",
    "chapter": "10",
    "verse": "18",
    "text": "Per far ragione all'orfano e al povero10.18 povero Sal. 82.3. Is. 11.4.;"
  }
]