[
  {
    "id": 30698,
    "book": "psalms                                  ",
    "chapter": "147",
    "verse": "1",
    "text": "LODATE il Signore;"
  },
  {
    "id": 30699,
    "book": "psalms                                  ",
    "chapter": "147",
    "verse": "2",
    "text": "Il Signore è quel ch'edifica Gerusalemme;"
  },
  {
    "id": 30700,
    "book": "psalms                                  ",
    "chapter": "147",
    "verse": "3",
    "text": "Egli è quel che guarisce quelli che hanno il cuor rotto147.3 rotto Sal. 51.17. Is. 57.15; 61.1 ecc. Luc. 4.18 ecc.,"
  },
  {
    "id": 30701,
    "book": "psalms                                  ",
    "chapter": "147",
    "verse": "4",
    "text": "Che conta il numero delle stelle147.4 stelle Gen. 15.5. Is. 40.26.;"
  },
  {
    "id": 30702,
    "book": "psalms                                  ",
    "chapter": "147",
    "verse": "5",
    "text": "Il nostro Signore è grande, e di gran forza;"
  },
  {
    "id": 30703,
    "book": "psalms                                  ",
    "chapter": "147",
    "verse": "6",
    "text": "Il Signore solleva i mansueti;"
  },
  {
    "id": 30704,
    "book": "psalms                                  ",
    "chapter": "147",
    "verse": "7",
    "text": "Cantate al Signore con lode;"
  },
  {
    "id": 30705,
    "book": "psalms                                  ",
    "chapter": "147",
    "verse": "8",
    "text": "Il qual copre il cielo di nuvole,"
  },
  {
    "id": 30706,
    "book": "psalms                                  ",
    "chapter": "147",
    "verse": "9",
    "text": "Che dà la sua pastura al bestiame."
  },
  {
    "id": 30707,
    "book": "psalms                                  ",
    "chapter": "147",
    "verse": "10",
    "text": "Egli non si compiace nella forza del cavallo147.10 cavallo Sal. 33.16,17. Os. 1.7.;"
  },
  {
    "id": 30708,
    "book": "psalms                                  ",
    "chapter": "147",
    "verse": "11",
    "text": "Il Signore gradisce quelli che lo temono,"
  },
  {
    "id": 30709,
    "book": "psalms                                  ",
    "chapter": "147",
    "verse": "12",
    "text": "Gerusalemme, celebra il Signore;"
  },
  {
    "id": 30710,
    "book": "psalms                                  ",
    "chapter": "147",
    "verse": "13",
    "text": "Perciocchè egli rinforza le sbarre delle tue porte;"
  },
  {
    "id": 30711,
    "book": "psalms                                  ",
    "chapter": "147",
    "verse": "14",
    "text": "Egli è quel che mantiene il tuo paese in pace147.14 pace Is. 60.17,18.;"
  },
  {
    "id": 30712,
    "book": "psalms                                  ",
    "chapter": "147",
    "verse": "15",
    "text": "Che manda il suo dire in terra147.15 terra Sal. 107.20 e rif.;"
  },
  {
    "id": 30713,
    "book": "psalms                                  ",
    "chapter": "147",
    "verse": "16",
    "text": "Che manda la neve a guisa di lana;"
  },
  {
    "id": 30714,
    "book": "psalms                                  ",
    "chapter": "147",
    "verse": "17",
    "text": "Che getta il suo ghiaccio come per pezzi;"
  },
  {
    "id": 30715,
    "book": "psalms                                  ",
    "chapter": "147",
    "verse": "18",
    "text": "Egli manda la sua parola, e fa struggere quelle cose;"
  },
  {
    "id": 30716,
    "book": "psalms                                  ",
    "chapter": "147",
    "verse": "19",
    "text": "Egli annunzia le sue parole a Giacobbe;"
  },
  {
    "id": 30717,
    "book": "psalms                                  ",
    "chapter": "147",
    "verse": "20",
    "text": "Egli non ha fatto così a tutte le genti147.20 genti Deut. 4.22-35. Rom. 3.1,2.;"
  }
]