[
  {
    "id": 30102,
    "book": "psalms                                  ",
    "chapter": "109",
    "verse": "1",
    "text": "O DIO della mia lode, non tacere;"
  },
  {
    "id": 30103,
    "book": "psalms                                  ",
    "chapter": "109",
    "verse": "2",
    "text": "Perciocchè la bocca dell'empio e la bocca di frode si sono aperte contro a me;"
  },
  {
    "id": 30104,
    "book": "psalms                                  ",
    "chapter": "109",
    "verse": "3",
    "text": "E mi hanno assediato con parole d'odio;"
  },
  {
    "id": 30105,
    "book": "psalms                                  ",
    "chapter": "109",
    "verse": "4",
    "text": "In vece dell'amore che ho loro portato, mi sono stati avversari109.4 avversari Sal. 38.20.;"
  },
  {
    "id": 30106,
    "book": "psalms                                  ",
    "chapter": "109",
    "verse": "5",
    "text": "Essi mi hanno renduto male per bene,"
  },
  {
    "id": 30107,
    "book": "psalms                                  ",
    "chapter": "109",
    "verse": "6",
    "text": "Costituisci il maligno sopra lui;"
  },
  {
    "id": 30108,
    "book": "psalms                                  ",
    "chapter": "109",
    "verse": "7",
    "text": "Quando sarà giudicato, esca condannato;"
  },
  {
    "id": 30109,
    "book": "psalms                                  ",
    "chapter": "109",
    "verse": "8",
    "text": "Sieno i suoi giorni pochi;"
  },
  {
    "id": 30110,
    "book": "psalms                                  ",
    "chapter": "109",
    "verse": "9",
    "text": "Sieno i suoi figliuoli orfani,"
  },
  {
    "id": 30111,
    "book": "psalms                                  ",
    "chapter": "109",
    "verse": "10",
    "text": "E vadano i suoi figliuoli del continuo vagando;"
  },
  {
    "id": 30112,
    "book": "psalms                                  ",
    "chapter": "109",
    "verse": "11",
    "text": "L'usuraio tenda la rete a tutto ciò ch'egli ha;"
  },
  {
    "id": 30113,
    "book": "psalms                                  ",
    "chapter": "109",
    "verse": "12",
    "text": "Non siavi alcuno che stenda la sua benignità inverso lui;"
  },
  {
    "id": 30114,
    "book": "psalms                                  ",
    "chapter": "109",
    "verse": "13",
    "text": "Sieno distrutti i suoi discendenti;"
  },
  {
    "id": 30115,
    "book": "psalms                                  ",
    "chapter": "109",
    "verse": "14",
    "text": "Sia ricordata l'iniquità de' suoi padri appo il Signore109.14 Signore Esod. 20.5.;"
  },
  {
    "id": 30116,
    "book": "psalms                                  ",
    "chapter": "109",
    "verse": "15",
    "text": "Sieno que' peccati del continuo nel cospetto del Signore;"
  },
  {
    "id": 30117,
    "book": "psalms                                  ",
    "chapter": "109",
    "verse": "16",
    "text": "Perciocchè egli non si è ricordato d'usar benignità,"
  },
  {
    "id": 30118,
    "book": "psalms                                  ",
    "chapter": "109",
    "verse": "17",
    "text": "Poichè egli ha amata la maledizione, vengagli;"
  },
  {
    "id": 30119,
    "book": "psalms                                  ",
    "chapter": "109",
    "verse": "18",
    "text": "E sia vestito di maledizione, come del suo manto;"
  },
  {
    "id": 30120,
    "book": "psalms                                  ",
    "chapter": "109",
    "verse": "19",
    "text": "Siagli quella a guisa di vestimento, del quale egli sia avvolto;"
  },
  {
    "id": 30121,
    "book": "psalms                                  ",
    "chapter": "109",
    "verse": "20",
    "text": "Tal sia, da parte del Signore, la ricompensa de' miei avversari,"
  },
  {
    "id": 30122,
    "book": "psalms                                  ",
    "chapter": "109",
    "verse": "21",
    "text": "Ma tu, o Signore Iddio, opera inverso me, per amor del tuo Nome;"
  },
  {
    "id": 30123,
    "book": "psalms                                  ",
    "chapter": "109",
    "verse": "22",
    "text": "Perciocchè io sono afflitto, e povero;"
  },
  {
    "id": 30124,
    "book": "psalms                                  ",
    "chapter": "109",
    "verse": "23",
    "text": "Io me ne vo, come l'ombra quando dichina109.23 dichina Giob. 14.2. Sal. 102.11; 144.4.;"
  },
  {
    "id": 30125,
    "book": "psalms                                  ",
    "chapter": "109",
    "verse": "24",
    "text": "Le mie ginocchia vacillano per li miei digiuni109.24 digiuni Ebr. 12.12.;"
  },
  {
    "id": 30126,
    "book": "psalms                                  ",
    "chapter": "109",
    "verse": "25",
    "text": "Ed anche son loro in vituperio;"
  },
  {
    "id": 30127,
    "book": "psalms                                  ",
    "chapter": "109",
    "verse": "26",
    "text": "Aiutami, Signore Iddio mio;"
  },
  {
    "id": 30128,
    "book": "psalms                                  ",
    "chapter": "109",
    "verse": "27",
    "text": "E sappiano che questo è la tua mano,"
  },
  {
    "id": 30129,
    "book": "psalms                                  ",
    "chapter": "109",
    "verse": "28",
    "text": "Essi malediranno, e tu benedirai109.28 benedirai 2 Sam. 16.11,12.;"
  },
  {
    "id": 30130,
    "book": "psalms                                  ",
    "chapter": "109",
    "verse": "29",
    "text": "Sieno i miei avversari vestiti di vituperio,"
  },
  {
    "id": 30131,
    "book": "psalms                                  ",
    "chapter": "109",
    "verse": "30",
    "text": "Io celebrerò altamente il Signore colla mia bocca;"
  },
  {
    "id": 30132,
    "book": "psalms                                  ",
    "chapter": "109",
    "verse": "31",
    "text": "Perciocchè egli sta alla destra del povero,"
  }
]