[
  {
    "id": 29564,
    "book": "psalms                                  ",
    "chapter": "81",
    "verse": "1",
    "text": "CANTATE lietamente a Dio nostra forza;"
  },
  {
    "id": 29565,
    "book": "psalms                                  ",
    "chapter": "81",
    "verse": "2",
    "text": "Prendete a salmeggiare, ed aggiugnetevi il tamburo,"
  },
  {
    "id": 29566,
    "book": "psalms                                  ",
    "chapter": "81",
    "verse": "3",
    "text": "Sonate colla tromba alle calendi,"
  },
  {
    "id": 29567,
    "book": "psalms                                  ",
    "chapter": "81",
    "verse": "4",
    "text": "Perciocchè questo è uno statuto dato ad Israele,"
  },
  {
    "id": 29568,
    "book": "psalms                                  ",
    "chapter": "81",
    "verse": "5",
    "text": "Egli lo costituì per una testimonianza in Giuseppe,"
  },
  {
    "id": 29569,
    "book": "psalms                                  ",
    "chapter": "81",
    "verse": "6",
    "text": "Io ho ritratte, dice Iddio, le sue spalle da' pesi;"
  },
  {
    "id": 29570,
    "book": "psalms                                  ",
    "chapter": "81",
    "verse": "7",
    "text": "O popol mio, tu gridasti essendo in distretta, ed io te ne trassi fuori81.7 fuori Esod. 2.23; 14.10. Sal. 50.15 e rif.;"
  },
  {
    "id": 29571,
    "book": "psalms                                  ",
    "chapter": "81",
    "verse": "8",
    "text": "Io ti dissi: Ascolta, popol mio, ed io ti farò le mie protestazioni;"
  },
  {
    "id": 29572,
    "book": "psalms                                  ",
    "chapter": "81",
    "verse": "9",
    "text": "Non siavi fra te alcun dio strano,"
  },
  {
    "id": 29573,
    "book": "psalms                                  ",
    "chapter": "81",
    "verse": "10",
    "text": "Io sono il Signore Iddio tuo, che ti ho tratto fuor del paese di Egitto81.10 Egitto Esod. 20.2.;"
  },
  {
    "id": 29574,
    "book": "psalms                                  ",
    "chapter": "81",
    "verse": "11",
    "text": "Ma il mio popolo non ha atteso alla mia voce;"
  },
  {
    "id": 29575,
    "book": "psalms                                  ",
    "chapter": "81",
    "verse": "12",
    "text": "Onde io li ho abbandonati alla durezza del cuor loro;"
  },
  {
    "id": 29576,
    "book": "psalms                                  ",
    "chapter": "81",
    "verse": "13",
    "text": "Oh! avesse pure ubbidito il mio popolo,"
  },
  {
    "id": 29577,
    "book": "psalms                                  ",
    "chapter": "81",
    "verse": "14",
    "text": "Io avrei in uno stante abbattuti i lor nemici,"
  },
  {
    "id": 29578,
    "book": "psalms                                  ",
    "chapter": "81",
    "verse": "15",
    "text": "Quelli che odiano il Signore si sarebbero infinti inverso loro;"
  },
  {
    "id": 29579,
    "book": "psalms                                  ",
    "chapter": "81",
    "verse": "16",
    "text": "E Iddio li avrebbe cibati di grascia di frumento;"
  }
]