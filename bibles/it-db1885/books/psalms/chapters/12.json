    "chapter": "12",
    "verse": "1",
    "text": "SALVA, Signore; perciocchè gli uomini pii son venuti meno,"
  },
  {
    "id": 28415,
    "book": "psalms                                  ",
    "chapter": "12",
    "verse": "2",
    "text": "Ciascuno parla con menzogna col suo prossimo12.2 prossimo Sal. 10.7 e rif.,"
  },
  {
    "id": 28416,
    "book": "psalms                                  ",
    "chapter": "12",
    "verse": "3",
    "text": "Il Signore ricida tutte le labbra lusinghiere,"
  },
  {
    "id": 28417,
    "book": "psalms                                  ",
    "chapter": "12",
    "verse": "4",
    "text": "Di coloro che dicono: Noi sarem padroni colle nostre lingue;"
  },
  {
    "id": 28418,
    "book": "psalms                                  ",
    "chapter": "12",
    "verse": "5",
    "text": "Per la desolazione de' poveri afflitti, per le strida de' bisognosi,"
  },
  {
    "id": 28419,
    "book": "psalms                                  ",
    "chapter": "12",
    "verse": "6",
    "text": "Le parole del Signore son parole pure,"
  },
  {
    "id": 28420,
    "book": "psalms                                  ",
    "chapter": "12",
    "verse": "7",
