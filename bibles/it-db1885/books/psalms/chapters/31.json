[
  {
    "id": 28678,
    "book": "psalms                                  ",
    "chapter": "31",
    "verse": "1",
    "text": "SIGNORE, io mi son confidato in te;"
  },
  {
    "id": 28679,
    "book": "psalms                                  ",
    "chapter": "31",
    "verse": "2",
    "text": "Inchina a me il tuo orecchio, affrettati a liberarmi;"
  },
  {
    "id": 28680,
    "book": "psalms                                  ",
    "chapter": "31",
    "verse": "3",
    "text": "Perciocchè tu sei la mia rocca31.3 fortezza Sal. 18.2 e rif. e la mia fortezza;"
  },
  {
    "id": 28681,
    "book": "psalms                                  ",
    "chapter": "31",
    "verse": "4",
    "text": "Trammi fuor della rete che mi è stata tesa di nascosto;"
  },
  {
    "id": 28682,
    "book": "psalms                                  ",
    "chapter": "31",
    "verse": "5",
    "text": "Io rimetto il mio spirito nelle tue mani31.5 mani Luc. 23.46. Fat. 7.59.;"
  },
  {
    "id": 28683,
    "book": "psalms                                  ",
    "chapter": "31",
    "verse": "6",
    "text": "Io odio quelli che attendono alle vanità di menzogna;"
  },
  {
    "id": 28684,
    "book": "psalms                                  ",
    "chapter": "31",
    "verse": "7",
    "text": "Io festeggerò, e mi rallegrerò della tua benignità;"
  },
  {
    "id": 28685,
    "book": "psalms                                  ",
    "chapter": "31",
    "verse": "8",
    "text": "E non mi avrai messo in mano del nemico31.8 nemico 1 Sam. 17.46 ecc.;"
  },
  {
    "id": 28686,
    "book": "psalms                                  ",
    "chapter": "31",
    "verse": "9",
    "text": "Abbi mercè di me, Signore; perciocchè io sono in distretta;"
  },
  {
    "id": 28687,
    "book": "psalms                                  ",
    "chapter": "31",
    "verse": "10",
    "text": "Perciocchè la mia vita si vien meno di noia,"
  },
  {
    "id": 28688,
    "book": "psalms                                  ",
    "chapter": "31",
    "verse": "11",
    "text": "Per cagione di tutti i miei nemici, io sono stato in gran vituperio31.11 vituperio Is. 53.3."
  },
  {
    "id": 28689,
    "book": "psalms                                  ",
    "chapter": "31",
    "verse": "12",
    "text": "Io sono stato dimenticato dal cuor loro come un morto;"
  },
  {
    "id": 28690,
    "book": "psalms                                  ",
    "chapter": "31",
    "verse": "13",
    "text": "Perciocchè io ho udito il vituperio di molti;"
  },
  {
    "id": 28691,
    "book": "psalms                                  ",
    "chapter": "31",
    "verse": "14",
    "text": "Ma io, o Signore, mi confido in te;"
  },
  {
    "id": 28692,
    "book": "psalms                                  ",
    "chapter": "31",
    "verse": "15",
    "text": "I miei tempi son nella tua mano;"
  },
  {
    "id": 28693,
    "book": "psalms                                  ",
    "chapter": "31",
    "verse": "16",
    "text": "Fa' risplendere il tuo volto31.16 volto Num. 6.25,26 e rif. sopra il tuo servitore;"
  },
  {
    "id": 28694,
    "book": "psalms                                  ",
    "chapter": "31",
    "verse": "17",
    "text": "O Signore, fa' che io non sia confuso; perciocchè io t'invoco;"
  },
  {
    "id": 28695,
    "book": "psalms                                  ",
    "chapter": "31",
    "verse": "18",
    "text": "Ammutoliscano le labbra bugiarde,"
  },
  {
    "id": 28696,
    "book": "psalms                                  ",
    "chapter": "31",
    "verse": "19",
    "text": "Quanto grandi sono i tuoi beni"
  },
  {
    "id": 28697,
    "book": "psalms                                  ",
    "chapter": "31",
    "verse": "20",
    "text": "Tu li nascondi, nel nascondimento della tua faccia,"
  },
  {
    "id": 28698,
    "book": "psalms                                  ",
    "chapter": "31",
    "verse": "21",
    "text": "Benedetto sia il Signore;"
  },
  {
    "id": 28699,
    "book": "psalms                                  ",
    "chapter": "31",
    "verse": "22",
    "text": "Ora, quant'è a me, nel mio smarrimento, dissi:"
  },
  {
    "id": 28700,
    "book": "psalms                                  ",
    "chapter": "31",
    "verse": "23",
    "text": "Amate il Signore, voi suoi santi tutti; Il Signore guarda i fedeli,"
  },
  {
    "id": 28701,
    "book": "psalms                                  ",
    "chapter": "31",
    "verse": "24",
    "text": "Confortatevi, voi tutti che sperate nel Signore;"
  }
]