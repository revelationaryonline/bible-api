[
  {
    "id": 28515,
    "book": "psalms                                  ",
    "chapter": "19",
    "verse": "1",
    "text": "I CIELI raccontano la gloria di Dio19.1 Dio Is. 40.22. Rom. 1.19,20.;"
  },
  {
    "id": 28516,
    "book": "psalms                                  ",
    "chapter": "19",
    "verse": "2",
    "text": "Un giorno dietro all'altro quelli sgorgano parole;"
  },
  {
    "id": 28517,
    "book": "psalms                                  ",
    "chapter": "19",
    "verse": "3",
    "text": "Non hanno favella, nè parole;"
  },
  {
    "id": 28518,
    "book": "psalms                                  ",
    "chapter": "19",
    "verse": "4",
    "text": "Ma la lor linea esce fuori per tutta la terra,"
  },
  {
    "id": 28519,
    "book": "psalms                                  ",
    "chapter": "19",
    "verse": "5",
    "text": "Ed egli esce fuori, come uno sposo dalla sua camera di nozze;"
  },
  {
    "id": 28520,
    "book": "psalms                                  ",
    "chapter": "19",
    "verse": "6",
    "text": "La sua uscita è da una estremità de' cieli,"
  },
  {
    "id": 28521,
    "book": "psalms                                  ",
    "chapter": "19",
    "verse": "7",
    "text": "La Legge del Signore è perfetta, ella ristora l'anima;"
  },
  {
    "id": 28522,
    "book": "psalms                                  ",
    "chapter": "19",
    "verse": "8",
    "text": "Gli statuti del Signore son diritti, e rallegrano il cuore;"
  },
  {
    "id": 28523,
    "book": "psalms                                  ",
    "chapter": "19",
    "verse": "9",
    "text": "Il timor del Signore è puro, e dimora in eterno;"
  },
  {
    "id": 28524,
    "book": "psalms                                  ",
    "chapter": "19",
    "verse": "10",
    "text": "Sono più desiderabili che oro, anzi più che gran quantità d'oro finissimo19.10 finissimo Sal. 119.72,127. Prov. 8.10,11,19.;"
  },
  {
    "id": 28525,
    "book": "psalms                                  ",
    "chapter": "19",
    "verse": "11",
    "text": "Il tuo servitore è eziandio avvisato per essi19.11 essi Esod. 18.20.;"
  },
  {
    "id": 28526,
    "book": "psalms                                  ",
    "chapter": "19",
    "verse": "12",
    "text": "Chi conosce i suoi errori19.12 errori Giob. 13.23. Sal. 40.12.?"
  },
  {
    "id": 28527,
    "book": "psalms                                  ",
    "chapter": "19",
    "verse": "13",
    "text": "Rattieni eziandio il tuo servitore dalle superbie,"
  },
  {
    "id": 28528,
    "book": "psalms                                  ",
    "chapter": "19",
    "verse": "14",
    "text": "Sieno grate nel tuo cospetto le parole della mia bocca,"
  }
]