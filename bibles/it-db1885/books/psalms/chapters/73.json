[
  {
    "id": 29367,
    "book": "psalms                                  ",
    "chapter": "73",
    "verse": "1",
    "text": "CERTAMENTE Iddio è buono ad Israele73.1 Israele Giov. 1.47. Rom. 9.6.,"
  },
  {
    "id": 29368,
    "book": "psalms                                  ",
    "chapter": "73",
    "verse": "2",
    "text": "Ora, quant'è a me, quasi che incapparono i miei piedi;"
  },
  {
    "id": 29369,
    "book": "psalms                                  ",
    "chapter": "73",
    "verse": "3",
    "text": "Perciocchè io portava invidia agl'insensati,"
  },
  {
    "id": 29370,
    "book": "psalms                                  ",
    "chapter": "73",
    "verse": "4",
    "text": "Perciocchè non vi sono alcuni legami alla lor morte;"
  },
  {
    "id": 29371,
    "book": "psalms                                  ",
    "chapter": "73",
    "verse": "5",
    "text": "Quando gli altri uomini sono in travagli, essi non vi son punto;"
  },
  {
    "id": 29372,
    "book": "psalms                                  ",
    "chapter": "73",
    "verse": "6",
    "text": "Perciò, la superbia li cinge a giusa di collana;"
  },
  {
    "id": 29373,
    "book": "psalms                                  ",
    "chapter": "73",
    "verse": "7",
    "text": "Gli occhi escono loro fuori per lo grasso;"
  },
  {
    "id": 29374,
    "book": "psalms                                  ",
    "chapter": "73",
    "verse": "8",
    "text": "Son dissoluti73.8 dissoluti Sal. 53.1 ecc., e per malizia ragionano di oppressare;"
  },
  {
    "id": 29375,
    "book": "psalms                                  ",
    "chapter": "73",
    "verse": "9",
    "text": "Mettono la lor bocca dentro al cielo,"
  },
  {
    "id": 29376,
    "book": "psalms                                  ",
    "chapter": "73",
    "verse": "10",
    "text": "Perciò, il popolo di Dio riviene a questo,"
  },
  {
    "id": 29377,
    "book": "psalms                                  ",
    "chapter": "73",
    "verse": "11",
    "text": "E dice: Come può essere che Iddio sappia ogni cosa,"
  },
  {
    "id": 29378,
    "book": "psalms                                  ",
    "chapter": "73",
    "verse": "12",
    "text": "Ecco, costoro son empi, e pur godono pace e tranquillità in perpetuo;"
  },
  {
    "id": 29379,
    "book": "psalms                                  ",
    "chapter": "73",
    "verse": "13",
    "text": "Indarno adunque in vero ho nettato il mio cuore73.13 cuore Giob. 21.15; 34.9; 35.3.,"
  },
  {
    "id": 29380,
    "book": "psalms                                  ",
    "chapter": "73",
    "verse": "14",
    "text": "Poichè son battuto tuttodì,"
  },
  {
    "id": 29381,
    "book": "psalms                                  ",
    "chapter": "73",
    "verse": "15",
    "text": "Se io dico: Io ragionerò così;"
  },
  {
    "id": 29382,
    "book": "psalms                                  ",
    "chapter": "73",
    "verse": "16",
    "text": "Io ho adunque pensato di volere intender questo;"
  },
  {
    "id": 29383,
    "book": "psalms                                  ",
    "chapter": "73",
    "verse": "17",
    "text": "Infino a tanto che sono entrato ne' santuari di Dio73.17 Dio Sal. 77.13.;"
  },
  {
    "id": 29384,
    "book": "psalms                                  ",
    "chapter": "73",
    "verse": "18",
    "text": "Certo, tu li metti in isdruccioli;"
  },
  {
    "id": 29385,
    "book": "psalms                                  ",
    "chapter": "73",
    "verse": "19",
    "text": "Come sono eglino stati distrutti in un momento!"
  },
  {
    "id": 29386,
    "book": "psalms                                  ",
    "chapter": "73",
    "verse": "20",
    "text": "Son come un sogno73.20 sogno Giob. 20.8. Sal. 90.5., dopo che l'uomo si è destato;"
  },
  {
    "id": 29387,
    "book": "psalms                                  ",
    "chapter": "73",
    "verse": "21",
    "text": "Quando il mio cuore era inacerbito,"
  },
  {
    "id": 29388,
    "book": "psalms                                  ",
    "chapter": "73",
    "verse": "22",
    "text": "Io era insensato, e non aveva conoscimento;"
  },
  {
    "id": 29389,
    "book": "psalms                                  ",
    "chapter": "73",
    "verse": "23",
    "text": "Ma pure io sono stato del continuo teco;"
  },
  {
    "id": 29390,
    "book": "psalms                                  ",
    "chapter": "73",
    "verse": "24",
    "text": "Tu mi condurrai per lo tuo consiglio73.24 consiglio Sal. 32.8. Is. 58.8.,"
  },
  {
    "id": 29391,
    "book": "psalms                                  ",
    "chapter": "73",
    "verse": "25",
    "text": "Chi è per me in cielo, fuor che te?"
  },
  {
    "id": 29392,
    "book": "psalms                                  ",
    "chapter": "73",
    "verse": "26",
    "text": "La mia carne ed il mio cuore erano venuti meno:"
  },
  {
    "id": 29393,
    "book": "psalms                                  ",
    "chapter": "73",
    "verse": "27",
    "text": "Perciocchè, ecco, quelli che si allontanano da te periranno73.27 periranno Sal. 119.155.;"
  },
  {
    "id": 29394,
    "book": "psalms                                  ",
    "chapter": "73",
    "verse": "28",
    "text": "Ma quant'è a me, egli mi è buono di accostarmi a Dio73.28 Dio Ebr. 10.22.;"
  }
]