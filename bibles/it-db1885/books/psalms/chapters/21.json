[
  {
    "id": 28538,
    "book": "psalms                                  ",
    "chapter": "21",
    "verse": "1",
    "text": "SIGNORE, il re si rallegrerà nella tua forza;"
  },
  {
    "id": 28539,
    "book": "psalms                                  ",
    "chapter": "21",
    "verse": "2",
    "text": "Tu gli hai dato il desio del suo cuore,"
  },
  {
    "id": 28540,
    "book": "psalms                                  ",
    "chapter": "21",
    "verse": "3",
    "text": "Perciocchè tu gli sei venuto incontro con benedizioni di beni;"
  },
  {
    "id": 28541,
    "book": "psalms                                  ",
    "chapter": "21",
    "verse": "4",
    "text": "Egli ti aveva chiesta vita."
  },
  {
    "id": 28542,
    "book": "psalms                                  ",
    "chapter": "21",
    "verse": "5",
    "text": "La sua gloria è grande per la tua vittoria;"
  },
  {
    "id": 28543,
    "book": "psalms                                  ",
    "chapter": "21",
    "verse": "6",
    "text": "Perciocchè tu l'hai posto in benedizioni in perpetuo;"
  },
  {
    "id": 28544,
    "book": "psalms                                  ",
    "chapter": "21",
    "verse": "7",
    "text": "Perciocchè il re si confida nel Signore,"
  },
  {
    "id": 28545,
    "book": "psalms                                  ",
    "chapter": "21",
    "verse": "8",
    "text": "La tua mano troverà tutti i tuoi nemici;"
  },
  {
    "id": 28546,
    "book": "psalms                                  ",
    "chapter": "21",
    "verse": "9",
    "text": "Tu li renderai simili ad un forno ardente,"
  },
  {
    "id": 28547,
    "book": "psalms                                  ",
    "chapter": "21",
    "verse": "10",
    "text": "Tu farai perire il frutto loro d'in sulla terra,"
  },
  {
    "id": 28548,
    "book": "psalms                                  ",
    "chapter": "21",
    "verse": "11",
    "text": "Perciocchè hanno ordito del male contro a te,"
  },
  {
    "id": 28549,
    "book": "psalms                                  ",
    "chapter": "21",
    "verse": "12",
    "text": "Perciocchè tu li metterai per tuo bersaglio;"
  },
  {
    "id": 28550,
    "book": "psalms                                  ",
    "chapter": "21",
    "verse": "13",
    "text": "Innalzati, Signore, colla tua forza;"
  }
]