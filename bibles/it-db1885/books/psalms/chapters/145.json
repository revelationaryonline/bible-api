[
  {
    "id": 30667,
    "book": "psalms                                  ",
    "chapter": "145",
    "verse": "1",
    "text": "O DIO mio, Re mio, io ti esalterò;"
  },
  {
    "id": 30668,
    "book": "psalms                                  ",
    "chapter": "145",
    "verse": "2",
    "text": "Io ti benedirò tuttodì;"
  },
  {
    "id": 30669,
    "book": "psalms                                  ",
    "chapter": "145",
    "verse": "3",
    "text": "Il Signore è grande, e degno di somma lode;"
  },
  {
    "id": 30670,
    "book": "psalms                                  ",
    "chapter": "145",
    "verse": "4",
    "text": "Un'età dopo l'altra predicherà le lodi delle tue opere;"
  },
  {
    "id": 30671,
    "book": "psalms                                  ",
    "chapter": "145",
    "verse": "5",
    "text": "Io ragionerò della magnificenza della gloria della tua maestà,"
  },
  {
    "id": 30672,
    "book": "psalms                                  ",
    "chapter": "145",
    "verse": "6",
    "text": "E gli uomini diranno la potenza delle tue opere tremende;"
  },
  {
    "id": 30673,
    "book": "psalms                                  ",
    "chapter": "145",
    "verse": "7",
    "text": "Essi sgorgheranno la ricordanza della tua gran bontà,"
  },
  {
    "id": 30674,
    "book": "psalms                                  ",
    "chapter": "145",
    "verse": "8",
    "text": "Il Signore è grazioso, e pietoso;"
  },
  {
    "id": 30675,
    "book": "psalms                                  ",
    "chapter": "145",
    "verse": "9",
    "text": "Il Signore è buono inverso tutti;"
  },
  {
    "id": 30676,
    "book": "psalms                                  ",
    "chapter": "145",
    "verse": "10",
    "text": "O Signore, tutte le tue opere ti celebreranno145.10 celebreranno Sal. 19.1.;"
  },
  {
    "id": 30677,
    "book": "psalms                                  ",
    "chapter": "145",
    "verse": "11",
    "text": "Diranno la gloria del tuo regno;"
  },
  {
    "id": 30678,
    "book": "psalms                                  ",
    "chapter": "145",
    "verse": "12",
    "text": "Per far note le tue prodezze,"
  },
  {
    "id": 30679,
    "book": "psalms                                  ",
    "chapter": "145",
    "verse": "13",
    "text": "Il tuo regno è un regno di tutti i secoli,"
  },
  {
    "id": 30680,
    "book": "psalms                                  ",
    "chapter": "145",
    "verse": "14",
    "text": "Il Signore sostiene tutti quelli che cadono,"
  },
  {
    "id": 30681,
    "book": "psalms                                  ",
    "chapter": "145",
    "verse": "15",
    "text": "Gli occhi di tutti sperano in te;"
  },
  {
    "id": 30682,
    "book": "psalms                                  ",
    "chapter": "145",
    "verse": "16",
    "text": "Tu apri la tua mano,"
  },
  {
    "id": 30683,
    "book": "psalms                                  ",
    "chapter": "145",
    "verse": "17",
    "text": "Il Signore è giusto in tutte le sue vie,"
  },
  {
    "id": 30684,
    "book": "psalms                                  ",
    "chapter": "145",
    "verse": "18",
    "text": "Il Signore è presso di tutti quelli che l'invocano145.18 invocano Deut. 4.7.,"
  },
  {
    "id": 30685,
    "book": "psalms                                  ",
    "chapter": "145",
    "verse": "19",
    "text": "Egli adempie il desiderio di quelli che lo temono,"
  },
  {
    "id": 30686,
    "book": "psalms                                  ",
    "chapter": "145",
    "verse": "20",
    "text": "Il Signore guarda tutti quelli che l'amano145.20 amano Sal. 31.23; 97.10.;"
  },
  {
    "id": 30687,
    "book": "psalms                                  ",
    "chapter": "145",
    "verse": "21",
    "text": "La mia bocca narrerà la lode del Signore;"
  }
]