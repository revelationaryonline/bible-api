    "chapter": "149",
    "verse": "1",
    "text": "ALLELUIA."
  },
  {
    "id": 30733,
    "book": "psalms                                  ",
    "chapter": "149",
    "verse": "2",
    "text": "Rallegrisi Israele nel suo Fattore149.2 Fattore Sal. 100.3 e rif. Is. 54.5.;"
  },
  {
    "id": 30734,
    "book": "psalms                                  ",
    "chapter": "149",
    "verse": "3",
    "text": "Lodino il suo Nome sul flauto;"
  },
  {
    "id": 30735,
    "book": "psalms                                  ",
    "chapter": "149",
    "verse": "4",
    "text": "Perciocchè il Signore gradisce il suo popolo;"
  },
  {
    "id": 30736,
    "book": "psalms                                  ",
    "chapter": "149",
    "verse": "5",
    "text": "I santi festeggeranno con gloria,"
  },
  {
    "id": 30737,
    "book": "psalms                                  ",
    "chapter": "149",
    "verse": "6",
    "text": "Avranno nella lor gola le esaltazioni di Dio,"
  },
  {
    "id": 30738,
    "book": "psalms                                  ",
    "chapter": "149",
    "verse": "7",
    "text": "Per far vendetta fra le genti,"
  },
  {
    "id": 30739,
    "book": "psalms                                  ",
    "chapter": "149",
    "verse": "8",
    "text": "Per legare i loro re con catene,"
  },
  {
    "id": 30740,
    "book": "psalms                                  ",
    "chapter": "149",
    "verse": "9",
    "text": "Per mandare ad esecuzione sopra loro il giudicio scritto;"
  }
]