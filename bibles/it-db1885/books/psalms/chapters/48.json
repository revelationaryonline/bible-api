[
  {
    "id": 28981,
    "book": "psalms                                  ",
    "chapter": "48",
    "verse": "1",
    "text": "IL Signore è grande, e molto glorioso"
  },
  {
    "id": 28982,
    "book": "psalms                                  ",
    "chapter": "48",
    "verse": "2",
    "text": "Il monte di Sion, il fondo verso il Settentrione,"
  },
  {
    "id": 28983,
    "book": "psalms                                  ",
    "chapter": "48",
    "verse": "3",
    "text": "Iddio è riconosciuto ne' palazzi di essa, per alta fortezza."
  },
  {
    "id": 28984,
    "book": "psalms                                  ",
    "chapter": "48",
    "verse": "4",
    "text": "Perciocchè ecco, i re si erano adunati,"
  },
  {
    "id": 28985,
    "book": "psalms                                  ",
    "chapter": "48",
    "verse": "5",
    "text": "Come prima la videro, furono attoniti,"
  },
  {
    "id": 28986,
    "book": "psalms                                  ",
    "chapter": "48",
    "verse": "6",
    "text": "Tremore li colse quivi;"
  },
  {
    "id": 28987,
    "book": "psalms                                  ",
    "chapter": "48",
    "verse": "7",
    "text": "Furono rotti come per lo vento orientale"
  },
  {
    "id": 28988,
    "book": "psalms                                  ",
    "chapter": "48",
    "verse": "8",
    "text": "Come avevamo udito, così abbiam veduto,"
  },
  {
    "id": 28989,
    "book": "psalms                                  ",
    "chapter": "48",
    "verse": "9",
    "text": "O Dio, noi abbiamo, chetamente aspettata la tua benignità"
  },
  {
    "id": 28990,
    "book": "psalms                                  ",
    "chapter": "48",
    "verse": "10",
    "text": "O Dio, quale è il tuo Nome,"
  },
  {
    "id": 28991,
    "book": "psalms                                  ",
    "chapter": "48",
    "verse": "11",
    "text": "Il monte di Sion si rallegrerà,"
  },
  {
    "id": 28992,
    "book": "psalms                                  ",
    "chapter": "48",
    "verse": "12",
    "text": "Circuite Sion, e andate attorno a lei,"
  },
  {
    "id": 28993,
    "book": "psalms                                  ",
    "chapter": "48",
    "verse": "13",
    "text": "Ponete mente alle bastie,"
  },
  {
    "id": 28994,
    "book": "psalms                                  ",
    "chapter": "48",
    "verse": "14",
    "text": "Perciocchè questo Dio è il nostro Dio in sempiterno;"
  }
]