[
  {
    "id": 28735,
    "book": "psalms                                  ",
    "chapter": "34",
    "verse": "1",
    "text": "IO benedirò il Signore in ogni tempo34.1 tempo Efes. 5.20. 1 Tess. 5.18.;"
  },
  {
    "id": 28736,
    "book": "psalms                                  ",
    "chapter": "34",
    "verse": "2",
    "text": "L'anima mia si glorierà nel Signore34.2 Signore Ger. 9.24. 1 Cor. 1.31.;"
  },
  {
    "id": 28737,
    "book": "psalms                                  ",
    "chapter": "34",
    "verse": "3",
    "text": "Magnificate meco il Signore34.3 Signore Luc. 1.46 ecc.,"
  },
  {
    "id": 28738,
    "book": "psalms                                  ",
    "chapter": "34",
    "verse": "4",
    "text": "Io ho cercato il Signore, ed egli mi ha risposto,"
  },
  {
    "id": 28739,
    "book": "psalms                                  ",
    "chapter": "34",
    "verse": "5",
    "text": "Quelli che hanno riguardato a lui sono stati illuminati,"
  },
  {
    "id": 28740,
    "book": "psalms                                  ",
    "chapter": "34",
    "verse": "6",
    "text": "Questo povero afflitto ha gridato, e il Signore l'ha esaudito,"
  },
  {
    "id": 28741,
    "book": "psalms                                  ",
    "chapter": "34",
    "verse": "7",
    "text": "Gli Angeli del Signore sono accampati intorno a quelli che lo temono34.7 temono Gen. 32.1,2. 2 Re. 6.17. Dan. 6.22. Ebr. 1.14.,"
  },
  {
    "id": 28742,
    "book": "psalms                                  ",
    "chapter": "34",
    "verse": "8",
    "text": "Gustate, e vedete quanto il Signore è buono34.8 buono 1 Piet. 2.3.;"
  },
  {
    "id": 28743,
    "book": "psalms                                  ",
    "chapter": "34",
    "verse": "9",
    "text": "Temete il Signore, voi suoi santi;"
  },
  {
    "id": 28744,
    "book": "psalms                                  ",
    "chapter": "34",
    "verse": "10",
    "text": "I leoncelli soffrono necessità e fame;"
  },
  {
    "id": 28745,
    "book": "psalms                                  ",
    "chapter": "34",
    "verse": "11",
    "text": "Venite, figliuoli, ascoltatemi;"
  },
  {
    "id": 28746,
    "book": "psalms                                  ",
    "chapter": "34",
    "verse": "12",
    "text": "Quale è l'uomo che abbia voglia di vivere,"
  },
  {
    "id": 28747,
    "book": "psalms                                  ",
    "chapter": "34",
    "verse": "13",
    "text": "Guarda la tua lingua dal male,"
  },
  {
    "id": 28748,
    "book": "psalms                                  ",
    "chapter": "34",
    "verse": "14",
    "text": "Ritratti dal male, e fa' il bene34.14 bene Giob. 28.28. Is. 1.16,17.;"
  },
  {
    "id": 28749,
    "book": "psalms                                  ",
    "chapter": "34",
    "verse": "15",
    "text": "Gli occhi del Signore son verso i giusti34.15 giusti Sal. 33.18 e rif.,"
  },
  {
    "id": 28750,
    "book": "psalms                                  ",
    "chapter": "34",
    "verse": "16",
    "text": "La faccia del Signore è contro a quelli che fanno male,"
  },
  {
    "id": 28751,
    "book": "psalms                                  ",
    "chapter": "34",
    "verse": "17",
    "text": "I giusti gridano, e il Signore li esaudisce,"
  },
  {
    "id": 28752,
    "book": "psalms                                  ",
    "chapter": "34",
    "verse": "18",
    "text": "Il Signore è presso di quelli che hanno il cuor rotto,"
  },
  {
    "id": 28753,
    "book": "psalms                                  ",
    "chapter": "34",
    "verse": "19",
    "text": "Molte son le afflizioni del giusto;"
  },
  {
    "id": 28754,
    "book": "psalms                                  ",
    "chapter": "34",
    "verse": "20",
    "text": "Egli guarda tutte le ossa di esso:"
  },
  {
    "id": 28755,
    "book": "psalms                                  ",
    "chapter": "34",
    "verse": "21",
    "text": "La malvagità farà morire il malvagio34.21 malvagio Sal. 94.23.,"
  },
  {
    "id": 28756,
    "book": "psalms                                  ",
    "chapter": "34",
    "verse": "22",
    "text": "Il Signore riscatta l'anima de' suoi servitori34.22 servitori Sal. 71.23; 103.4,5.;"
  }
]