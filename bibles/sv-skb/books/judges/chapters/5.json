[
  {
    "id": 37791,
    "book": "judges                                  ",
    "chapter": "5",
    "verse": "1",
    "text": "Då sjöng Debora och Barak, Avinoams son, denna sång:"
  },
  {
    "id": 37792,
    "book": "judges                                  ",
    "chapter": "5",
    "verse": "2",
    "text": "När ledarna (hebr. parot) låter håret växa (hebr. parot) [blir en nasir; tar sitt ledarskap på allvar] i Israel,"
  },
  {
    "id": 37793,
    "book": "judges                                  ",
    "chapter": "5",
    "verse": "3",
    "text": "Lyssna ni kungar [israel hade ingen kung ännu, så detta riktar sig till hedniska nationer, se Ps 2:2],"
  },
  {
    "id": 37794,
    "book": "judges                                  ",
    "chapter": "5",
    "verse": "4",
    "text": "Herre (Jahve) när du drar ut från Seir,"
  },
  {
    "id": 37795,
    "book": "judges                                  ",
    "chapter": "5",
    "verse": "5",
    "text": "Bergen darrar av Herrens (Jahves) närvaro,"
  },
  {
    "id": 37796,
    "book": "judges                                  ",
    "chapter": "5",
    "verse": "6",
    "text": "I Shamgars dagar, Anats son,"
  },
  {
    "id": 37797,
    "book": "judges                                  ",
    "chapter": "5",
    "verse": "7",
    "text": "Furstarna tystnar i Israel,"
  },
  {
    "id": 37798,
    "book": "judges                                  ",
    "chapter": "5",
    "verse": "8",
    "text": "De valde nya gudar,"
  },
  {
    "id": 37799,
    "book": "judges                                  ",
    "chapter": "5",
    "verse": "9",
    "text": "Mitt hjärta är vänt till Israels ledare,"
  },
  {
    "id": 37800,
    "book": "judges                                  ",
    "chapter": "5",
    "verse": "10",
    "text": "Ni som rider på vita åsnor,"
  },
  {
    "id": 37801,
    "book": "judges                                  ",
    "chapter": "5",
    "verse": "11",
    "text": "Högre än bågskyttens röst, [hörs det] mellan vattentrågen,"
  },
  {
    "id": 37802,
    "book": "judges                                  ",
    "chapter": "5",
    "verse": "12",
    "text": "Vakna upp (triumfera),"
  },
  {
    "id": 37803,
    "book": "judges                                  ",
    "chapter": "5",
    "verse": "13",
    "text": "Sedan lät han kvarlevan råda"
  },
  {
    "id": 37804,
    "book": "judges                                  ",
    "chapter": "5",
    "verse": "14",
    "text": "Ut från Efraim kom de vars rötter är i Amalek,"
  },
  {
    "id": 37805,
    "book": "judges                                  ",
    "chapter": "5",
    "verse": "15",
    "text": "Och Isaskars furstar var med Debora,"
  },
  {
    "id": 37806,
    "book": "judges                                  ",
    "chapter": "5",
    "verse": "16",
    "text": "Varför sitter du bland fårfållorna"
  },
  {
    "id": 37807,
    "book": "judges                                  ",
    "chapter": "5",
    "verse": "17",
    "text": "Gilead hade sin hemvist på andra sidan Jordan,"
  },
  {
    "id": 37808,
    "book": "judges                                  ",
    "chapter": "5",
    "verse": "18",
    "text": "Zevolun är ett folk som riskerar sina liv ända in i döden,"
  },
  {
    "id": 37809,
    "book": "judges                                  ",
    "chapter": "5",
    "verse": "19",
    "text": "Kungarna kommer, de strider,"
  },
  {
    "id": 37810,
    "book": "judges                                  ",
    "chapter": "5",
    "verse": "20",
    "text": "De strider från himlarna, stjärnorna"
  },
  {
    "id": 37811,
    "book": "judges                                  ",
    "chapter": "5",
    "verse": "21",
    "text": "Kishons bäck sveper bort dem,"
  },
  {
    "id": 37812,
    "book": "judges                                  ",
    "chapter": "5",
    "verse": "22",
    "text": "Sedan stampar hästhovarna avsiktligt i dans,"
  },
  {
    "id": 37813,
    "book": "judges                                  ",
    "chapter": "5",
    "verse": "23",
    "text": "”Förbanna Meroz,” säger Herrens (Jahves) ängel (budbärare),"
  },
  {
    "id": 37814,
    "book": "judges                                  ",
    "chapter": "5",
    "verse": "24",
    "text": "Välsignad över (mer än) kvinnor ska Jael vara,"
  },
  {
    "id": 37815,
    "book": "judges                                  ",
    "chapter": "5",
    "verse": "25",
    "text": "Han bad om vatten – hon gav honom mjölk;"
  },
  {
    "id": 37816,
    "book": "judges                                  ",
    "chapter": "5",
    "verse": "26",
    "text": "Hon satte sin hand till tältpluggen"
  },
  {
    "id": 37817,
    "book": "judges                                  ",
    "chapter": "5",
    "verse": "27",
    "text": "Mellan hennes fötter sjönk han ihop,"
  },
  {
    "id": 37818,
    "book": "judges                                  ",
    "chapter": "5",
    "verse": "28",
    "text": "Genom fönstret såg hon ut och kikade, Siseras mor,"
  },
  {
    "id": 37819,
    "book": "judges                                  ",
    "chapter": "5",
    "verse": "29",
    "text": "Hennes klokaste hovdamer svarar henne,"
  },
  {
    "id": 37820,
    "book": "judges                                  ",
    "chapter": "5",
    "verse": "30",
    "text": "”De har säkert funnit byte, och nu delar de bytet."
  },
  {
    "id": 37821,
    "book": "judges                                  ",
    "chapter": "5",
    "verse": "31",
    "text": "Så må alla dina fiender förgås Herre (Jahve),"
  }
]