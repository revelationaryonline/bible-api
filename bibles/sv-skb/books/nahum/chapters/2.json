[
  {
    "id": 45672,
    "book": "nahum                                   ",
    "chapter": "2",
    "verse": "1",
    "text": "[Murens väktare i Nineve ropar:]"
  },
  {
    "id": 45673,
    "book": "nahum                                   ",
    "chapter": "2",
    "verse": "2",
    "text": "Herren (Jahve) tar bort Jakobs stolthet"
  },
  {
    "id": 45674,
    "book": "nahum                                   ",
    "chapter": "2",
    "verse": "3",
    "text": "Stridsmännens sköldar är färgade röda [rödfärgade eller nedstänkta av blod],"
  },
  {
    "id": 45675,
    "book": "nahum                                   ",
    "chapter": "2",
    "verse": "4",
    "text": "Vagnarna far vilt fram (som galningar) på gatorna,"
  },
  {
    "id": 45676,
    "book": "nahum                                   ",
    "chapter": "2",
    "verse": "5",
    "text": "Han [syftar troligtvis på Assyriernas kung] betänker för sig själv om sina mäktiga,"
  },
  {
    "id": 45677,
    "book": "nahum                                   ",
    "chapter": "2",
    "verse": "6",
    "text": "Flodernas portar har blivit öppnade"
  },
  {
    "id": 45678,
    "book": "nahum                                   ",
    "chapter": "2",
    "verse": "7",
    "text": "Drottningen [Nineves drottning] är blottad – hon förs bort [i exil]"
  },
  {
    "id": 45679,
    "book": "nahum                                   ",
    "chapter": "2",
    "verse": "8",
    "text": "Men Nineve har sedan urminnes tider varit som en vattendamm,"
  },
  {
    "id": 45680,
    "book": "nahum                                   ",
    "chapter": "2",
    "verse": "9",
    "text": "[Hennes plundrare ropar:]"
  },
  {
    "id": 45681,
    "book": "nahum                                   ",
    "chapter": "2",
    "verse": "10",
    "text": "Hon är öde, tom och som en skräphög."
  },
  {
    "id": 45682,
    "book": "nahum                                   ",
    "chapter": "2",
    "verse": "11",
    "text": "Var är lejonens lya"
  },
  {
    "id": 45683,
    "book": "nahum                                   ",
    "chapter": "2",
    "verse": "12",
    "text": "Lejonet sliter i stycken tillräckligt för sina ungar"
  },
  {
    "id": 45684,
    "book": "nahum                                   ",
    "chapter": "2",
    "verse": "13",
    "text": "Se, jag är emot dig"
  }
]