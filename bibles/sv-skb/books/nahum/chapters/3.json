[
  {
    "id": 45685,
    "book": "nahum                                   ",
    "chapter": "3",
    "verse": "1",
    "text": "Ve över den blodiga staden [Nineve]!"
  },
  {
    "id": 45686,
    "book": "nahum                                   ",
    "chapter": "3",
    "verse": "2",
    "text": "Piskor smäller [från hästarna med stridsepikage],"
  },
  {
    "id": 45687,
    "book": "nahum                                   ",
    "chapter": "3",
    "verse": "3",
    "text": "ryttare gör sig redo,"
  },
  {
    "id": 45688,
    "book": "nahum                                   ",
    "chapter": "3",
    "verse": "4",
    "text": "[Detta är anledningen:]"
  },
  {
    "id": 45689,
    "book": "nahum                                   ",
    "chapter": "3",
    "verse": "5",
    "text": "Se, därför är jag emot dig förkunnar (säger, proklamerar) Härskarornas Herre (Jahve Sebaot)"
  },
  {
    "id": 45690,
    "book": "nahum                                   ",
    "chapter": "3",
    "verse": "6",
    "text": "Jag ska kasta vidrigheter (avskyvärda ting) över dig"
  },
  {
    "id": 45691,
    "book": "nahum                                   ",
    "chapter": "3",
    "verse": "7",
    "text": "Det skall ske att alla som ser på dig ska fly från dig och säga:"
  },
  {
    "id": 45692,
    "book": "nahum                                   ",
    "chapter": "3",
    "verse": "8",
    "text": "Är du bättre än [den egyptiska staden] No-Amon som fanns bland floderna [Nildeltat],"
  },
  {
    "id": 45693,
    "book": "nahum                                   ",
    "chapter": "3",
    "verse": "9",
    "text": "Kush (Etiopien och Sudan) och Egypten var din styrka"
  },
  {
    "id": 45694,
    "book": "nahum                                   ",
    "chapter": "3",
    "verse": "10",
    "text": "Likväl fördes hon bort,"
  },
  {
    "id": 45695,
    "book": "nahum                                   ",
    "chapter": "3",
    "verse": "11",
    "text": "Du [Nineve] ska bli drucken, du ska svimma [bild för nederlag i strid, se Jes 49:26; Jer 25:27; 51:21],"
  },
  {
    "id": 45696,
    "book": "nahum                                   ",
    "chapter": "3",
    "verse": "12",
    "text": "Alla dina fästningar ska bli som fikonträd med den första skördens fikon,"
  },
  {
    "id": 45697,
    "book": "nahum                                   ",
    "chapter": "3",
    "verse": "13",
    "text": "Se ditt folk i din mitt är som kvinnor [fysiskt svagare än starka soldater],"
  },
  {
    "id": 45698,
    "book": "nahum                                   ",
    "chapter": "3",
    "verse": "14",
    "text": "Dra upp vatten åt dig för belägringen,"
  },
  {
    "id": 45699,
    "book": "nahum                                   ",
    "chapter": "3",
    "verse": "15",
    "text": "Där ska elden sluka dig,"
  },
  {
    "id": 45700,
    "book": "nahum                                   ",
    "chapter": "3",
    "verse": "16",
    "text": "Du har förökat dina köpmän över himlens stjärnor (så att de har blivit fler än stjärnorna),"
  },
  {
    "id": 45701,
    "book": "nahum                                   ",
    "chapter": "3",
    "verse": "17",
    "text": "Dina krönta (upphöjda individer) är som gräshoppor"
  },
  {
    "id": 45702,
    "book": "nahum                                   ",
    "chapter": "3",
    "verse": "18",
    "text": "Dina herdar slumrar, O Assyriens kung,"
  },
  {
    "id": 45703,
    "book": "nahum                                   ",
    "chapter": "3",
    "verse": "19",
    "text": "Det finns ingen som lindrar din smärta,"
  }
]