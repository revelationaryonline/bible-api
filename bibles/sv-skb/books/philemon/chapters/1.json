[
  {
    "id": 48761,
    "book": "philemon                                ",
    "chapter": "1",
    "verse": "1",
    "text": "[Från:]"
  },
  {
    "id": 48762,
    "book": "philemon                                ",
    "chapter": "1",
    "verse": "2",
    "text": "Appia, vår syster"
  },
  {
    "id": 48763,
    "book": "philemon                                ",
    "chapter": "1",
    "verse": "3",
    "text": "Nåd (kraft, oförtjänt favör) vare med er och frid (harmoni, frihet från fruktan, välbehag) från Gud vår Far och Herren Jesus den Smorde (Messias, Kristus)."
  },
  {
    "id": 48764,
    "book": "philemon                                ",
    "chapter": "1",
    "verse": "4",
    "text": "Jag tackar alltid min Gud när jag nämner (tänker på) dig [Filemon] i mina böner."
  },
  {
    "id": 48765,
    "book": "philemon                                ",
    "chapter": "1",
    "verse": "5",
    "text": "Anledningen är att jag ständigt hör om"
  },
  {
    "id": 48766,
    "book": "philemon                                ",
    "chapter": "1",
    "verse": "6",
    "text": "Jag ber att din gemenskap med oss i tron"
  },
  {
    "id": 48767,
    "book": "philemon                                ",
    "chapter": "1",
    "verse": "7",
    "text": "Din kärlek [som är osjälvisk och utgivande] har varit till stor glädje och tröst (uppmuntran) för mig,"
  },
  {
    "id": 48768,
    "book": "philemon                                ",
    "chapter": "1",
    "verse": "8",
    "text": "Även om jag nu med stor frimodighet (öppenhet, ärlighet) i den Smorde (Messias, Kristus)"
  },
  {
    "id": 48769,
    "book": "philemon                                ",
    "chapter": "1",
    "verse": "9",
    "text": "vill jag hellre"
  },
  {
    "id": 48770,
    "book": "philemon                                ",
    "chapter": "1",
    "verse": "10",
    "text": "vädjar till dig för mitt barn"
  },
  {
    "id": 48771,
    "book": "philemon                                ",
    "chapter": "1",
    "verse": "11",
    "text": "Förr var han inte till nytta [ingen ”Onesimus”] för dig,"
  },
  {
    "id": 48772,
    "book": "philemon                                ",
    "chapter": "1",
    "verse": "12",
    "text": "Jag sänder nu tillbaka honom till dig,"
  },
  {
    "id": 48773,
    "book": "philemon                                ",
    "chapter": "1",
    "verse": "13",
    "text": "Egentligen ville jag ha kvar honom här hos mig,"
  },
  {
    "id": 48774,
    "book": "philemon                                ",
    "chapter": "1",
    "verse": "14",
    "text": "Men jag ville inte göra något utan ditt samtycke,"
  },
  {
    "id": 48775,
    "book": "philemon                                ",
    "chapter": "1",
    "verse": "15",
    "text": "Kanske var det just därför han blev skild från dig för en tid,"
  },
  {
    "id": 48776,
    "book": "philemon                                ",
    "chapter": "1",
    "verse": "16",
    "text": "inte längre som en slav,"
  },
  {
    "id": 48777,
    "book": "philemon                                ",
    "chapter": "1",
    "verse": "17",
    "text": "Därför, om du räknar mig som din vän,"
  },
  {
    "id": 48778,
    "book": "philemon                                ",
    "chapter": "1",
    "verse": "18",
    "text": "Om han har gjort dig något orätt eller är skyldig dig något,"
  },
  {
    "id": 48779,
    "book": "philemon                                ",
    "chapter": "1",
    "verse": "19",
    "text": "Jag, Paulus, skriver med egen hand:"
  },
  {
    "id": 48780,
    "book": "philemon                                ",
    "chapter": "1",
    "verse": "20",
    "text": "Ja, broder, låt mig ”få nytta” av dig"
  },
  {
    "id": 48781,
    "book": "philemon                                ",
    "chapter": "1",
    "verse": "21",
    "text": "Jag skriver till dig övertygad om din lydnad,"
  },
  {
    "id": 48782,
    "book": "philemon                                ",
    "chapter": "1",
    "verse": "22",
    "text": "Ordna på samma gång också en hyresbostad (ett gästrum) åt mig,"
  },
  {
    "id": 48783,
    "book": "philemon                                ",
    "chapter": "1",
    "verse": "23",
    "text": "Epafras [troligen pastor i Kolossai],"
  },
  {
    "id": 48784,
    "book": "philemon                                ",
    "chapter": "1",
    "verse": "24",
    "text": "Det gör även mina medarbetare"
  },
  {
    "id": 48785,
    "book": "philemon                                ",
    "chapter": "1",
    "verse": "25",
    "text": "Herren Jesu den Smordes (Kristi) nåd vare med er ande."
  }
]