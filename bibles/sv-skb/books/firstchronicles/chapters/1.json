[
  {
    "id": 20207,
    "book": "firstChronicles                         ",
    "chapter": "1",
    "verse": "1",
    "text": "Adam,"
  },
  {
    "id": 20208,
    "book": "firstChronicles                         ",
    "chapter": "1",
    "verse": "2",
    "text": "Kenan,"
  },
  {
    "id": 20209,
    "book": "firstChronicles                         ",
    "chapter": "1",
    "verse": "3",
    "text": "Henok (Chanoch),"
  },
  {
    "id": 20210,
    "book": "firstChronicles                         ",
    "chapter": "1",
    "verse": "4",
    "text": "Noa (Noach) [hans söner var] –"
  },
  {
    "id": 20211,
    "book": "firstChronicles                         ",
    "chapter": "1",
    "verse": "5",
    "text": "Jafets söner var"
  },
  {
    "id": 20212,
    "book": "firstChronicles                         ",
    "chapter": "1",
    "verse": "6",
    "text": "Gomers söner var"
  },
  {
    "id": 20213,
    "book": "firstChronicles                         ",
    "chapter": "1",
    "verse": "7",
    "text": "Javans söner var"
  },
  {
    "id": 20214,
    "book": "firstChronicles                         ",
    "chapter": "1",
    "verse": "8",
    "text": "Chams (Hams) söner var:"
  },
  {
    "id": 20215,
    "book": "firstChronicles                         ",
    "chapter": "1",
    "verse": "9",
    "text": "Kushs söner var"
  },
  {
    "id": 20216,
    "book": "firstChronicles                         ",
    "chapter": "1",
    "verse": "10",
    "text": "Kush blev far till Nimrod, som var den förste som fick stor makt på jorden."
  },
  {
    "id": 20217,
    "book": "firstChronicles                         ",
    "chapter": "1",
    "verse": "11",
    "text": "Misrajim [Egypten] blev far till"
  },
  {
    "id": 20218,
    "book": "firstChronicles                         ",
    "chapter": "1",
    "verse": "12",
    "text": "patroseerna och"
  },
  {
    "id": 20219,
    "book": "firstChronicles                         ",
    "chapter": "1",
    "verse": "13",
    "text": "Kanaan blev far till Sidon, som var hans förstfödde, och Chet,"
  },
  {
    "id": 20220,
    "book": "firstChronicles                         ",
    "chapter": "1",
    "verse": "14",
    "text": "dessutom jebusiterna, amoréerna och girgasheerna,"
  },
  {
    "id": 20221,
    "book": "firstChronicles                         ",
    "chapter": "1",
    "verse": "15",
    "text": "hiveerna, arkeerna, sineerna,"
  },
  {
    "id": 20222,
    "book": "firstChronicles                         ",
    "chapter": "1",
    "verse": "16",
    "text": "arvadeerna, semareerna och hamateerna."
  },
  {
    "id": 20223,
    "book": "firstChronicles                         ",
    "chapter": "1",
    "verse": "17",
    "text": "Sems söner var Elam, Assur, Arpakshad, Lud och Aram, dessutom Us, Hul, Geter och Mesek."
  },
  {
    "id": 20224,
    "book": "firstChronicles                         ",
    "chapter": "1",
    "verse": "18",
    "text": "Arpakshad blev far till Shela och Shela blev far till Eber."
  },
  {
    "id": 20225,
    "book": "firstChronicles                         ",
    "chapter": "1",
    "verse": "19",
    "text": "Åt Eber föddes två söner. Den ene hette Peleg, för under hans tid delades jorden upp. Hans bror hette Joktan."
  },
  {
    "id": 20226,
    "book": "firstChronicles                         ",
    "chapter": "1",
    "verse": "20",
    "text": "Joktan blev far till Almodad, Shelef, Hasarmavet, Jera,"
  },
  {
    "id": 20227,
    "book": "firstChronicles                         ",
    "chapter": "1",
    "verse": "21",
    "text": "Hadoram, Usal, Dikla,"
  },
  {
    "id": 20228,
    "book": "firstChronicles                         ",
    "chapter": "1",
    "verse": "22",
    "text": "Ebal, Abimael, Saba,"
  },
  {
    "id": 20229,
    "book": "firstChronicles                         ",
    "chapter": "1",
    "verse": "23",
    "text": "Ofir, Havila och Jobab. Alla dessa var Joktans söner."
  },
  {
    "id": 20230,
    "book": "firstChronicles                         ",
    "chapter": "1",
    "verse": "24",
    "text": "Sem, Arpakshad, Shela,"
  },
  {
    "id": 20231,
    "book": "firstChronicles                         ",
    "chapter": "1",
    "verse": "25",
    "text": "Eber, Peleg, Regu,"
  },
  {
    "id": 20232,
    "book": "firstChronicles                         ",
    "chapter": "1",
    "verse": "26",
    "text": "Serug, Nahor, Tera,"
  },
  {
    "id": 20233,
    "book": "firstChronicles                         ",
    "chapter": "1",
    "verse": "27",
    "text": "Abram, alltså Abraham."
  },
  {
    "id": 20234,
    "book": "firstChronicles                         ",
    "chapter": "1",
    "verse": "28",
    "text": "Abrahams söner var Isak och Ismael."
  },
  {
    "id": 20235,
    "book": "firstChronicles                         ",
    "chapter": "1",
    "verse": "29",
    "text": "Detta är deras släkttavla:"
  },
  {
    "id": 20236,
    "book": "firstChronicles                         ",
    "chapter": "1",
    "verse": "30",
    "text": "Mishma och Duma, Massa, Hadad och Tema,"
  },
  {
    "id": 20237,
    "book": "firstChronicles                         ",
    "chapter": "1",
    "verse": "31",
    "text": "Jetur, Nafish och Kedma. Dessa var Ismaels söner."
  },
  {
    "id": 20238,
    "book": "firstChronicles                         ",
    "chapter": "1",
    "verse": "32",
    "text": "De söner som Abrahams bihustru Ketura födde var Simran, Jokshan, Medan, Midjan, Jishbak och Shua."
  },
  {
    "id": 20239,
    "book": "firstChronicles                         ",
    "chapter": "1",
    "verse": "33",
    "text": "Midjans söner var Efa, Efer, Henok, Abida och Eldaa. Alla dessa var Keturas söner."
  },
  {
    "id": 20240,
    "book": "firstChronicles                         ",
    "chapter": "1",
    "verse": "34",
    "text": "Och Abraham blev far till Isak. Isaks söner var Esau och Israel."
  },
  {
    "id": 20241,
    "book": "firstChronicles                         ",
    "chapter": "1",
    "verse": "35",
    "text": "Esaus söner var Elifas, Reguel, Jeush, Jalam och Korach."
  },
  {
    "id": 20242,
    "book": "firstChronicles                         ",
    "chapter": "1",
    "verse": "36",
    "text": "Elifas söner var"
  },
  {
    "id": 20243,
    "book": "firstChronicles                         ",
    "chapter": "1",
    "verse": "37",
    "text": "Reguels söner var"
  },
  {
    "id": 20244,
    "book": "firstChronicles                         ",
    "chapter": "1",
    "verse": "38",
    "text": "Seirs söner var"
  },
  {
    "id": 20245,
    "book": "firstChronicles                         ",
    "chapter": "1",
    "verse": "39",
    "text": "Lotans söner var"
  },
  {
    "id": 20246,
    "book": "firstChronicles                         ",
    "chapter": "1",
    "verse": "40",
    "text": "Shobals söner var"
  },
  {
    "id": 20247,
    "book": "firstChronicles                         ",
    "chapter": "1",
    "verse": "41",
    "text": "Anas son var Dishon."
  },
  {
    "id": 20248,
    "book": "firstChronicles                         ",
    "chapter": "1",
    "verse": "42",
    "text": "Esers söner var"
  },
  {
    "id": 20249,
    "book": "firstChronicles                         ",
    "chapter": "1",
    "verse": "43",
    "text": "Dessa var de kungar som regerade i Edoms land innan det fanns någon kung i Israel:"
  },
  {
    "id": 20250,
    "book": "firstChronicles                         ",
    "chapter": "1",
    "verse": "44",
    "text": "När Bela dog blev Jobab, Seras son, från Bosra, kung efter honom."
  },
  {
    "id": 20251,
    "book": "firstChronicles                         ",
    "chapter": "1",
    "verse": "45",
    "text": "När Jobab dog blev Husham från temaneernas land kung efter honom."
  },
  {
    "id": 20252,
    "book": "firstChronicles                         ",
    "chapter": "1",
    "verse": "46",
    "text": "När Husham dog blev Hadad, Bedads son, kung efter honom. Han slog midjaniterna på Moavs mark. Hans stad hette Avit."
  },
  {
    "id": 20253,
    "book": "firstChronicles                         ",
    "chapter": "1",
    "verse": "47",
    "text": "När Hadad dog blev Samla från Masreka kung efter honom."
  },
  {
    "id": 20254,
    "book": "firstChronicles                         ",
    "chapter": "1",
    "verse": "48",
    "text": "När Samla dog blev Saul från Rehobot vid floden kung efter honom."
  },
  {
    "id": 20255,
    "book": "firstChronicles                         ",
    "chapter": "1",
    "verse": "49",
    "text": "När Saul dog blev Baal-Hanan, Akbors son, kung efter honom."
  },
  {
    "id": 20256,
    "book": "firstChronicles                         ",
    "chapter": "1",
    "verse": "50",
    "text": "När Baal-Hanan dog blev Hadad kung efter honom. Hans stad hette Pai och hans hustru hette Mehetabel, dotter till Matred, som var dotter till Me-Sahab."
  },
  {
    "id": 20257,
    "book": "firstChronicles                         ",
    "chapter": "1",
    "verse": "51",
    "text": "När Hadad hade dött var dessa Edoms stamfurstar: fursten Timna, fursten Alja, fursten Jetet,"
  },
  {
    "id": 20258,
    "book": "firstChronicles                         ",
    "chapter": "1",
    "verse": "52",
    "text": "fursten Oholibama, fursten Ela, fursten Pinon,"
  },
  {
    "id": 20259,
    "book": "firstChronicles                         ",
    "chapter": "1",
    "verse": "53",
    "text": "fursten Kenas, fursten Teman, fursten Mibsar,"
  },
  {
    "id": 20260,
    "book": "firstChronicles                         ",
    "chapter": "1",
    "verse": "54",
    "text": "fursten Magdiel, fursten Iram. Dessa var Edoms stamfurstar."
  }
]