    "verse": "1",
    "text": "En psalm."
  },
  {
    "id": 54159,
    "book": "psalms                                  ",
    "chapter": "98",
    "verse": "2",
    "text": "Herren visar sin kraft att frälsa (befria)."
  },
  {
    "id": 54160,
    "book": "psalms                                  ",
    "chapter": "98",
    "verse": "3",
    "text": "Han kommer ihåg sin nåd (omsorgsfulla kärlek) och trofasthet mot Israels folk,"
  },
  {
    "id": 54161,
    "book": "psalms                                  ",
    "chapter": "98",
    "verse": "4",
    "text": "Ropa högt (i segerjubel; väsnas med rop och härskri) till Herren (Jahve), alla länder (hela jorden)."
  },
  {
    "id": 54162,
    "book": "psalms                                  ",
    "chapter": "98",
    "verse": "5",
    "text": "Lovsjung Herren (Jahve) med Kinnor-harpa (kithara) [ren instrumental musik],"
  },
  {
    "id": 54163,
    "book": "psalms                                  ",
    "chapter": "98",
    "verse": "6",
    "text": "med trumpeter (trumpetstötar) och shofarer (vädurshorn, basuners ljud)."
  },
  {
    "id": 54164,
    "book": "psalms                                  ",
    "chapter": "98",
    "verse": "7",
    "text": "Låt havet och allt som är i det ropa (brusa),"
  },
  {
    "id": 54165,
    "book": "psalms                                  ",
    "chapter": "98",
    "verse": "8",
    "text": "Låt floderna klappa sina händer,"
  },
  {
    "id": 54166,
    "book": "psalms                                  ",
    "chapter": "98",
    "verse": "9",
    "text": "inför Herren,"
  }
]