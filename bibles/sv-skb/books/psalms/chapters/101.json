[
  {
    "id": 54181,
    "book": "psalms                                  ",
    "chapter": "101",
    "verse": "1",
    "text": "Av (för) David, en psalm (sång ackompanjerad på strängar)."
  },
  {
    "id": 54182,
    "book": "psalms                                  ",
    "chapter": "101",
    "verse": "2",
    "text": "Jag ska studera (akta, beskåda) redbarhetens väg."
  },
  {
    "id": 54183,
    "book": "psalms                                  ",
    "chapter": "101",
    "verse": "3",
    "text": "Jag ska inte ha några låga (dåliga) ting framför mina ögon."
  },
  {
    "id": 54184,
    "book": "psalms                                  ",
    "chapter": "101",
    "verse": "4",
    "text": "Ett falskt (förvridet, moraliskt fördärvat) hjärta ska lämna mig,"
  },
  {
    "id": 54185,
    "book": "psalms                                  ",
    "chapter": "101",
    "verse": "5",
    "text": "Den som förtalar (skvallrar på) sin granne i hemlighet,"
  },
  {
    "id": 54186,
    "book": "psalms                                  ",
    "chapter": "101",
    "verse": "6",
    "text": "Mina ögon vilar på de trofasta i landet,"
  },
  {
    "id": 54187,
    "book": "psalms                                  ",
    "chapter": "101",
    "verse": "7",
    "text": "Den som ägnar sig åt svek (förleder andra) ska inte bo i mitt hus,"
  },
  {
    "id": 54188,
    "book": "psalms                                  ",
    "chapter": "101",
    "verse": "8",
    "text": "Morgon efter morgon ska jag förgöra"
  }
]