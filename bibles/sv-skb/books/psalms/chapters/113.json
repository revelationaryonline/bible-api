    "chapter": "113",
    "verse": "1",
    "text": "Prisa Herren (lova Jah – hebr. hallelujah)!"
  },
  {
    "id": 54483,
    "book": "psalms                                  ",
    "chapter": "113",
    "verse": "2",
    "text": "Låt Herrens (Jahves) namn bli välsignat (prisat, låt oss böja oss inför honom),"
  },
  {
    "id": 54484,
    "book": "psalms                                  ",
    "chapter": "113",
    "verse": "3",
    "text": "Från solens uppgång (i öster – hebr. mizrach) till dess nedgång (”mot dess ingång”, dvs. i väster) [över hela jorden]"
  },
  {
    "id": 54485,
    "book": "psalms                                  ",
    "chapter": "113",
    "verse": "4",
    "text": "Herren (Jahve) är högt över alla hednafolk,"
  },
  {
    "id": 54486,
    "book": "psalms                                  ",
    "chapter": "113",
    "verse": "5",
    "text": "Vem kan jämföras med Herren (Jahve)"
  },
  {
    "id": 54487,
    "book": "psalms                                  ",
    "chapter": "113",
    "verse": "6",
    "text": "Han som böjer sig ner,"
  },
  {
    "id": 54488,
    "book": "psalms                                  ",
    "chapter": "113",
    "verse": "7",
    "text": "Han reser (lyfter) den fattige (ringe) ur stoftet,"
  },
  {
    "id": 54489,
    "book": "psalms                                  ",
    "chapter": "113",
    "verse": "8",
    "text": "för att sätta honom bredvid furstar,"
  },
  {
    "id": 54490,
    "book": "psalms                                  ",
    "chapter": "113",
    "verse": "9",
    "text": "Han låter den barnlösa bo i hemmet,"
  }
