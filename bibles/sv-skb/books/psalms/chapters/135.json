[
  {
    "id": 54844,
    "book": "psalms                                  ",
    "chapter": "135",
    "verse": "1",
    "text": "Prisa Herren (lova Jah – hebr. hallelujah)!"
  },
  {
    "id": 54845,
    "book": "psalms                                  ",
    "chapter": "135",
    "verse": "2",
    "text": "Ja, ni som står i Herrens (Jahves) hus,"
  },
  {
    "id": 54846,
    "book": "psalms                                  ",
    "chapter": "135",
    "verse": "3",
    "text": "Prisa Herren (Jah) för Herren (Jahve) är god,"
  },
  {
    "id": 54847,
    "book": "psalms                                  ",
    "chapter": "135",
    "verse": "4",
    "text": "Herren (Jah) har utvalt Jakob [och hans släktled] till sig själv,"
  },
  {
    "id": 54848,
    "book": "psalms                                  ",
    "chapter": "135",
    "verse": "5",
    "text": "För jag vet att Herren (Jahve) är stor,"
  },
  {
    "id": 54849,
    "book": "psalms                                  ",
    "chapter": "135",
    "verse": "6",
    "text": "Allt som Herren (Jahve) har lust med, det har han gjort,"
  },
  {
    "id": 54850,
    "book": "psalms                                  ",
    "chapter": "135",
    "verse": "7",
    "text": "Vem får dimman att stiga från jordens yttersta gräns?"
  },
  {
    "id": 54851,
    "book": "psalms                                  ",
    "chapter": "135",
    "verse": "8",
    "text": "Vem slog de förstfödda i Egypten,"
  },
  {
    "id": 54852,
    "book": "psalms                                  ",
    "chapter": "135",
    "verse": "9",
    "text": "Han sände tecken och under i din mitt, Egypten,"
  },
  {
    "id": 54853,
    "book": "psalms                                  ",
    "chapter": "135",
    "verse": "10",
    "text": "Vem slog många länder"
  },
  {
    "id": 54854,
    "book": "psalms                                  ",
    "chapter": "135",
    "verse": "11",
    "text": "Sichon, amoréernas kung"
  },
  {
    "id": 54855,
    "book": "psalms                                  ",
    "chapter": "135",
    "verse": "12",
    "text": "och gav deras land som arv,"
  },
  {
    "id": 54856,
    "book": "psalms                                  ",
    "chapter": "135",
    "verse": "13",
    "text": "O, Herre (Jahve), ditt namn varar för evigt,"
  },
  {
    "id": 54857,
    "book": "psalms                                  ",
    "chapter": "135",
    "verse": "14",
    "text": "För Herren (Jahve) ska döma sitt folk,"
  },
  {
    "id": 54858,
    "book": "psalms                                  ",
    "chapter": "135",
    "verse": "15",
    "text": "Ländernas avgudar är silver och guld,"
  },
  {
    "id": 54859,
    "book": "psalms                                  ",
    "chapter": "135",
    "verse": "16",
    "text": "De har munnar men talar inte,"
  },
  {
    "id": 54860,
    "book": "psalms                                  ",
    "chapter": "135",
    "verse": "17",
    "text": "de har öron men lyssnar inte,"
  },
  {
    "id": 54861,
    "book": "psalms                                  ",
    "chapter": "135",
    "verse": "18",
    "text": "De som har gjort dem ska bli dem lika,"
  },
  {
    "id": 54862,
    "book": "psalms                                  ",
    "chapter": "135",
    "verse": "19",
    "text": "Israels hus, välsigna Herren (Jahve),"
  },
  {
    "id": 54863,
    "book": "psalms                                  ",
    "chapter": "135",
    "verse": "20",
    "text": "Levi hus (alla präster), välsigna Herren (Jahve),"
  },
  {
    "id": 54864,
    "book": "psalms                                  ",
    "chapter": "135",
    "verse": "21",
    "text": "Välsignad vare Herren (Jahve) från Sion [tempelberget i Jerusalem], han som bor i Jerusalem."
  }
]