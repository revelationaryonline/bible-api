[
  {
    "id": 53774,
    "book": "psalms                                  ",
    "chapter": "78",
    "verse": "1",
    "text": "En sång med visdom [hebr. maskil, en musikalisk eller litterär term; kan även betyda ”en välskriven sång”]. Av (för) Asaf."
  },
  {
    "id": 53775,
    "book": "psalms                                  ",
    "chapter": "78",
    "verse": "2",
    "text": "Jag ska öppna min mun till liknelse (ett ordspråk – hebr. mashal),"
  },
  {
    "id": 53776,
    "book": "psalms                                  ",
    "chapter": "78",
    "verse": "3",
    "text": "Sådant som vi hört och känner till"
  },
  {
    "id": 53777,
    "book": "psalms                                  ",
    "chapter": "78",
    "verse": "4",
    "text": "Vi ska inte dölja det från våra söner (våra barn),"
  },
  {
    "id": 53778,
    "book": "psalms                                  ",
    "chapter": "78",
    "verse": "5",
    "text": "För han har grundat ett vittnesbörd i Jakob,"
  },
  {
    "id": 53779,
    "book": "psalms                                  ",
    "chapter": "78",
    "verse": "6",
    "text": "för att kommande generationer ska känna till dem,"
  },
  {
    "id": 53780,
    "book": "psalms                                  ",
    "chapter": "78",
    "verse": "7",
    "text": "för att de ska sätta sin förtröstan på Gud (Elohim)"
  },
  {
    "id": 53781,
    "book": "psalms                                  ",
    "chapter": "78",
    "verse": "8",
    "text": "Så ska de inte bli som sina fäder (förfäder),"
  },
  {
    "id": 53782,
    "book": "psalms                                  ",
    "chapter": "78",
    "verse": "9",
    "text": "Efraims söner [det norra riket Israel] var som bågskyttar med pilbågar"
  },
  {
    "id": 53783,
    "book": "psalms                                  ",
    "chapter": "78",
    "verse": "10",
    "text": "De höll inte Guds (Elohims) förbund"
  },
  {
    "id": 53784,
    "book": "psalms                                  ",
    "chapter": "78",
    "verse": "11",
    "text": "De glömde bort hans gärningar"
  },
  {
    "id": 53785,
    "book": "psalms                                  ",
    "chapter": "78",
    "verse": "12",
    "text": "Inför deras fäder gjorde han under (förunderliga ting, mirakler) [plågorna, se 2 Mos 7-12]"
  },
  {
    "id": 53786,
    "book": "psalms                                  ",
    "chapter": "78",
    "verse": "13",
    "text": "Han delade havet och lät dem gå rakt igenom,"
  },
  {
    "id": 53787,
    "book": "psalms                                  ",
    "chapter": "78",
    "verse": "14",
    "text": "Han ledde dem med ett moln på dagen"
  },
  {
    "id": 53788,
    "book": "psalms                                  ",
    "chapter": "78",
    "verse": "15",
    "text": "Han klöv klippor i öknen"
  },
  {
    "id": 53789,
    "book": "psalms                                  ",
    "chapter": "78",
    "verse": "16",
    "text": "Han lät strömmar komma ur klippan"
  },
  {
    "id": 53790,
    "book": "psalms                                  ",
    "chapter": "78",
    "verse": "17",
    "text": "Ändå fortsatte de (kontinuerligt) att synda mot honom"
  },
  {
    "id": 53791,
    "book": "psalms                                  ",
    "chapter": "78",
    "verse": "18",
    "text": "De fortsatte att fresta Gud (El) i sina hjärtan"
  },
  {
    "id": 53792,
    "book": "psalms                                  ",
    "chapter": "78",
    "verse": "19",
    "text": "Ja, de talade mot Gud (Elohim), de sade:"
  },
  {
    "id": 53793,
    "book": "psalms                                  ",
    "chapter": "78",
    "verse": "20",
    "text": "Se, han slog klippan så att vatten kom ut"
  },
  {
    "id": 53794,
    "book": "psalms                                  ",
    "chapter": "78",
    "verse": "21",
    "text": "När Herren (Jahve) hörde detta blev han vred"
  },
  {
    "id": 53795,
    "book": "psalms                                  ",
    "chapter": "78",
    "verse": "22",
    "text": "För de trodde inte på Gud (Elohim)"
  },
  {
    "id": 53796,
    "book": "psalms                                  ",
    "chapter": "78",
    "verse": "23",
    "text": "Han befallde skyarna från ovan"
  },
  {
    "id": 53797,
    "book": "psalms                                  ",
    "chapter": "78",
    "verse": "24",
    "text": "Han lät manna regna över dem som mat"
  },
  {
    "id": 53798,
    "book": "psalms                                  ",
    "chapter": "78",
    "verse": "25",
    "text": "Människor åt änglars bröd,"
  },
  {
    "id": 53799,
    "book": "psalms                                  ",
    "chapter": "78",
    "verse": "26",
    "text": "Han lät östanvinden blåsa i himlen"
  },
  {
    "id": 53800,
    "book": "psalms                                  ",
    "chapter": "78",
    "verse": "27",
    "text": "Han lät kött regna över dem som stoft"
  },
  {
    "id": 53801,
    "book": "psalms                                  ",
    "chapter": "78",
    "verse": "28",
    "text": "Han lät det falla mitt i deras läger,"
  },
  {
    "id": 53802,
    "book": "psalms                                  ",
    "chapter": "78",
    "verse": "29",
    "text": "De åt och blev fullständigt mättade,"
  },
  {
    "id": 53803,
    "book": "psalms                                  ",
    "chapter": "78",
    "verse": "30",
    "text": "De var inte främmande för sin åtrå"
  },
  {
    "id": 53804,
    "book": "psalms                                  ",
    "chapter": "78",
    "verse": "31",
    "text": "när Herrens (Elohims) vrede gick upp över dem"
  },
  {
    "id": 53805,
    "book": "psalms                                  ",
    "chapter": "78",
    "verse": "32",
    "text": "Trots detta fortsatte de att synda (kontinuerligt)"
  },
  {
    "id": 53806,
    "book": "psalms                                  ",
    "chapter": "78",
    "verse": "33",
    "text": "Därför avslutade han deras dagar som ett andetag (i fåfänlighet – hebr. hevel),"
  },
  {
    "id": 53807,
    "book": "psalms                                  ",
    "chapter": "78",
    "verse": "34",
    "text": "När han slog dem skulle de ha frågat efter (sökt, tagit sin tillflykt till, närmat sig) honom"
  },
  {
    "id": 53808,
    "book": "psalms                                  ",
    "chapter": "78",
    "verse": "35",
    "text": "De [Israels folk under ökenvandringen] kom ihåg"
  },
  {
    "id": 53809,
    "book": "psalms                                  ",
    "chapter": "78",
    "verse": "36",
    "text": "Men ändå bedrog de honom med sin mun (sina ord),"
  },
  {
    "id": 53810,
    "book": "psalms                                  ",
    "chapter": "78",
    "verse": "37",
    "text": "De höll inte fast (deras hjärtan var inte rätt och förankrade) vid honom,"
  },
  {
    "id": 53811,
    "book": "psalms                                  ",
    "chapter": "78",
    "verse": "38",
    "text": "Trots detta är han barmhärtig (känner han medlidande),"
  },
  {
    "id": 53812,
    "book": "psalms                                  ",
    "chapter": "78",
    "verse": "39",
    "text": "Han kom ihåg att de bara är kött (människor),"
  },
  {
    "id": 53813,
    "book": "psalms                                  ",
    "chapter": "78",
    "verse": "40",
    "text": "Hur ofta gjorde de uppror mot honom i öknen"
  },
  {
    "id": 53814,
    "book": "psalms                                  ",
    "chapter": "78",
    "verse": "41",
    "text": "De återvände (gång på gång gick de tillbaka) till att prövade Gud (El)"
  },
  {
    "id": 53815,
    "book": "psalms                                  ",
    "chapter": "78",
    "verse": "42",
    "text": "De kom inte ihåg hans hand,"
  },
  {
    "id": 53816,
    "book": "psalms                                  ",
    "chapter": "78",
    "verse": "43",
    "text": "hur han gjorde tecken i Egypten och"
  },
  {
    "id": 53817,
    "book": "psalms                                  ",
    "chapter": "78",
    "verse": "44",
    "text": "Han vände deras floder till blod"
  },
  {
    "id": 53818,
    "book": "psalms                                  ",
    "chapter": "78",
    "verse": "45",
    "text": "Han sände flugsvärmar bland dem som uppslukade dem [2 Mos 8:20-32]"
  },
  {
    "id": 53819,
    "book": "psalms                                  ",
    "chapter": "78",
    "verse": "46",
    "text": "Han gav också deras inkomst till larver (skadedjur som åt upp det som skulle bli deras skörd)"
  },
  {
    "id": 53820,
    "book": "psalms                                  ",
    "chapter": "78",
    "verse": "47",
    "text": "Han förstörde deras vindruvor med hagel"
  },
  {
    "id": 53821,
    "book": "psalms                                  ",
    "chapter": "78",
    "verse": "48",
    "text": "Han gav också deras boskap till haglet"
  },
  {
    "id": 53822,
    "book": "psalms                                  ",
    "chapter": "78",
    "verse": "49",
    "text": "Han sände sin rasande vrede över dem,"
  },
  {
    "id": 53823,
    "book": "psalms                                  ",
    "chapter": "78",
    "verse": "50",
    "text": "Han banade en väg för sin vrede."
  },
  {
    "id": 53824,
    "book": "psalms                                  ",
    "chapter": "78",
    "verse": "51",
    "text": "Han slog allt förstfött i Egypten [2 Mos 12],"
  },
  {
    "id": 53825,
    "book": "psalms                                  ",
    "chapter": "78",
    "verse": "52",
    "text": "Men sitt eget folk lät han dra ut som en fårhjord (flock av småboskap),"
  },
  {
    "id": 53826,
    "book": "psalms                                  ",
    "chapter": "78",
    "verse": "53",
    "text": "Han ledde dem tryggt och de fruktade inte"
  },
  {
    "id": 53827,
    "book": "psalms                                  ",
    "chapter": "78",
    "verse": "54",
    "text": "Han tog dem till sitt heliga område (gräns),"
  },
  {
    "id": 53828,
    "book": "psalms                                  ",
    "chapter": "78",
    "verse": "55",
    "text": "Han fördrev hednafolken framför dem"
  },
  {
    "id": 53829,
    "book": "psalms                                  ",
    "chapter": "78",
    "verse": "56",
    "text": "Ändå prövade och provocerade de Gud den Högste (Elohim Elion)"
  },
  {
    "id": 53830,
    "book": "psalms                                  ",
    "chapter": "78",
    "verse": "57",
    "text": "De vände tillbaka och handlade förrädiskt som sina fäder,"
  },
  {
    "id": 53831,
    "book": "psalms                                  ",
    "chapter": "78",
    "verse": "58",
    "text": "De provocerade honom med sina höga platser [offerplatser med ockulta avgudaoffer, se 5 Mos 12:2-3]"
  },
  {
    "id": 53832,
    "book": "psalms                                  ",
    "chapter": "78",
    "verse": "59",
    "text": "[Guds respons:]"
  },
  {
    "id": 53833,
    "book": "psalms                                  ",
    "chapter": "78",
    "verse": "60",
    "text": "Han övergav tabernaklet i Silo [i centrala Israel],"
  },
  {
    "id": 53834,
    "book": "psalms                                  ",
    "chapter": "78",
    "verse": "61",
    "text": "Han lät sin styrka fängslas"
  },
  {
    "id": 53835,
    "book": "psalms                                  ",
    "chapter": "78",
    "verse": "62",
    "text": "Han utlämnade sitt folk till svärdet"
  },
  {
    "id": 53836,
    "book": "psalms                                  ",
    "chapter": "78",
    "verse": "63",
    "text": "Eld slukade deras unga män,"
  },
  {
    "id": 53837,
    "book": "psalms                                  ",
    "chapter": "78",
    "verse": "64",
    "text": "Deras präster föll för svärdet"
  },
  {
    "id": 53838,
    "book": "psalms                                  ",
    "chapter": "78",
    "verse": "65",
    "text": "Sedan vaknade Herren (Adonaj) upp som ur en sömn,"
  },
  {
    "id": 53839,
    "book": "psalms                                  ",
    "chapter": "78",
    "verse": "66",
    "text": "Han slog tillbaka sina åklagare"
  },
  {
    "id": 53840,
    "book": "psalms                                  ",
    "chapter": "78",
    "verse": "67",
    "text": "Dessutom avskydde (förkastade) han Josefs tält"
  },
  {
    "id": 53841,
    "book": "psalms                                  ",
    "chapter": "78",
    "verse": "68",
    "text": "Men han utvalde Juda stam,"
  },
  {
    "id": 53842,
    "book": "psalms                                  ",
    "chapter": "78",
    "verse": "69",
    "text": "Han byggde sin helgedom som höjderna,"
  },
  {
    "id": 53843,
    "book": "psalms                                  ",
    "chapter": "78",
    "verse": "70",
    "text": "Han valde också David, sin tjänare"
  },
  {
    "id": 53844,
    "book": "psalms                                  ",
    "chapter": "78",
    "verse": "71",
    "text": "från de diande tackorna."
  },
  {
    "id": 53845,
    "book": "psalms                                  ",
    "chapter": "78",
    "verse": "72",
    "text": "Han var en herde för dem med hjärtats integritet"
  }
]