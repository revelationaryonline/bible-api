[
  {
    "id": 53879,
    "book": "psalms                                  ",
    "chapter": "81",
    "verse": "1",
    "text": "Till (för) ledaren. [Beskriver någon som utmärker sig – som är strålande och framstående inom sitt område. Syftar dels på föreståndaren för tempelmusiken men även på Messias ”den strålande morgonstjärnan”, se Upp 22:16 och inledningen till Psaltaren.]"
  },
  {
    "id": 53880,
    "book": "psalms                                  ",
    "chapter": "81",
    "verse": "2",
    "text": "Sjung (höj gälla triumferande jubelrop) till Gud (Elohim) vår styrka."
  },
  {
    "id": 53881,
    "book": "psalms                                  ",
    "chapter": "81",
    "verse": "3",
    "text": "Ta upp en melodi och låt tamburinen ljuda [Ps 68:26; 149:3; 150:4; 2 Mos 15:20],"
  },
  {
    "id": 53882,
    "book": "psalms                                  ",
    "chapter": "81",
    "verse": "4",
    "text": "Blås i shofar (vädurshorn) vid nymånaden,"
  },
  {
    "id": 53883,
    "book": "psalms                                  ",
    "chapter": "81",
    "verse": "5",
    "text": "För det är en stadga för Israel,"
  },
  {
    "id": 53884,
    "book": "psalms                                  ",
    "chapter": "81",
    "verse": "6",
    "text": "Han bestämde det i Josef [som här representerar de norra stammarna] som ett vittnesbörd,"
  },
  {
    "id": 53885,
    "book": "psalms                                  ",
    "chapter": "81",
    "verse": "7",
    "text": "Jag tog bort hans skuldror från bördan (oket) [slaveriet i Egypten],"
  },
  {
    "id": 53886,
    "book": "psalms                                  ",
    "chapter": "81",
    "verse": "8",
    "text": "Du ropade (höjde din röst i bön) i din nöd och jag räddade dig."
  },
  {
    "id": 53887,
    "book": "psalms                                  ",
    "chapter": "81",
    "verse": "9",
    "text": "[B]"
  },
  {
    "id": 53888,
    "book": "psalms                                  ",
    "chapter": "81",
    "verse": "10",
    "text": "[C]"
  },
  {
    "id": 53889,
    "book": "psalms                                  ",
    "chapter": "81",
    "verse": "11",
    "text": "Jag är Herren (Jahve) din Gud (Elohim),"
  },
  {
    "id": 53890,
    "book": "psalms                                  ",
    "chapter": "81",
    "verse": "12",
    "text": "[A]"
  },
  {
    "id": 53891,
    "book": "psalms                                  ",
    "chapter": "81",
    "verse": "13",
    "text": "Så jag lät dem gå efter sina egna envisa hjärtan,"
  },
  {
    "id": 53892,
    "book": "psalms                                  ",
    "chapter": "81",
    "verse": "14",
    "text": "[B]"
  },
  {
    "id": 53893,
    "book": "psalms                                  ",
    "chapter": "81",
    "verse": "15",
    "text": "[C]"
  },
  {
