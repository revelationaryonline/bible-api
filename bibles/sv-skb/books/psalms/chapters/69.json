[
  {
    "id": 53592,
    "book": "psalms                                  ",
    "chapter": "69",
    "verse": "1",
    "text": "Till (för) ledaren. [Beskriver någon som utmärker sig – som är strålande och framstående inom sitt område. Syftar dels på föreståndaren för tempelmusiken men även på Messias ”den strålande morgonstjärnan”, se Upp 22:16 och inledningen till Psaltaren.]"
  },
  {
    "id": 53593,
    "book": "psalms                                  ",
    "chapter": "69",
    "verse": "2",
    "text": "Fräls (rädda) mig Gud (Elohim)"
  },
  {
    "id": 53594,
    "book": "psalms                                  ",
    "chapter": "69",
    "verse": "3",
    "text": "Jag har sjunkit djupt i dyn,"
  },
  {
    "id": 53595,
    "book": "psalms                                  ",
    "chapter": "69",
    "verse": "4",
    "text": "Jag är utmattad av mitt ropande (i bön),"
  },
  {
    "id": 53596,
    "book": "psalms                                  ",
    "chapter": "69",
    "verse": "5",
    "text": "Fler än hårstråna på mitt huvud,"
  },
  {
    "id": 53597,
    "book": "psalms                                  ",
    "chapter": "69",
    "verse": "6",
    "text": "Gud (Elohim) du känner till, vet allt, om min dårskap."
  },
  {
    "id": 53598,
    "book": "psalms                                  ",
    "chapter": "69",
    "verse": "7",
    "text": "Må de som sätter sitt hopp till dig, inte skämmas för min skull,"
  },
  {
    "id": 53599,
    "book": "psalms                                  ",
    "chapter": "69",
    "verse": "8",
    "text": "För din skull har jag utstått hån,"
  },
  {
    "id": 53600,
    "book": "psalms                                  ",
    "chapter": "69",
    "verse": "9",
    "text": "Jag har blivit en främling för mina bröder,"
  },
  {
    "id": 53601,
    "book": "psalms                                  ",
    "chapter": "69",
    "verse": "10",
    "text": "Nitälskan (en djup passion och kärlek) för ditt hus har ätit upp (förtärt) mig,"
  },
  {
    "id": 53602,
    "book": "psalms                                  ",
    "chapter": "69",
    "verse": "11",
    "text": "När jag grät och fastade (utgöt min själ – hela min person),"
  },
  {
    "id": 53603,
    "book": "psalms                                  ",
    "chapter": "69",
    "verse": "12",
    "text": "Jag klädde mig i sorgdräkt (säckklädnad),"
  },
  {
    "id": 53604,
    "book": "psalms                                  ",
    "chapter": "69",
    "verse": "13",
    "text": "De som sitter i portarna [inflytelserika, ”fint folk”] pratar (skvallrar) om mig"
  },
  {
    "id": 53605,
    "book": "psalms                                  ",
    "chapter": "69",
    "verse": "14",
    "text": "Men jag låter mina böner gå till dig Gud (Jahve),"
  },
  {
    "id": 53606,
    "book": "psalms                                  ",
    "chapter": "69",
    "verse": "15",
    "text": "Rädda (ryck bort) mig från dyn och låt mig inte sjunka,"
  },
  {
    "id": 53607,
    "book": "psalms                                  ",
    "chapter": "69",
    "verse": "16",
    "text": "Låt inte flodvågen dränka mig;"
  },
  {
    "id": 53608,
    "book": "psalms                                  ",
    "chapter": "69",
    "verse": "17",
    "text": "Svara mig, Herre (Jahve),"
  },
  {
    "id": 53609,
    "book": "psalms                                  ",
    "chapter": "69",
    "verse": "18",
    "text": "och dölj (göm) inte ditt ansikte för din tjänare."
  },
  {
    "id": 53610,
    "book": "psalms                                  ",
    "chapter": "69",
    "verse": "19",
    "text": "Kom till (nära) min själ (mitt liv, hela min person), återlös den,"
  },
  {
    "id": 53611,
    "book": "psalms                                  ",
    "chapter": "69",
    "verse": "20",
    "text": "Du känner till (vet allt om) mina förebråelser,"
  },
  {
    "id": 53612,
    "book": "psalms                                  ",
    "chapter": "69",
    "verse": "21",
    "text": "förakt har brutit ner mitt hjärta och jag är svårt sjuk."
  },
  {
    "id": 53613,
    "book": "psalms                                  ",
    "chapter": "69",
    "verse": "22",
    "text": "De har lagt gift (galla, bitterhet) i min mat"
  },
  {
    "id": 53614,
    "book": "psalms                                  ",
    "chapter": "69",
    "verse": "23",
    "text": "Låt deras bord framför dem bli en snara,"
  },
  {
    "id": 53615,
    "book": "psalms                                  ",
    "chapter": "69",
    "verse": "24",
    "text": "Låt deras ögon förmörkas så att de inte ser,"
  },
  {
    "id": 53616,
    "book": "psalms                                  ",
    "chapter": "69",
    "verse": "25",
    "text": "Utgjut din harm över dem"
  },
  {
    "id": 53617,
    "book": "psalms                                  ",
    "chapter": "69",
    "verse": "26",
    "text": "Låt deras läger bli öde,"
  },
  {
    "id": 53618,
    "book": "psalms                                  ",
    "chapter": "69",
    "verse": "27",
    "text": "För de förföljer honom som du har slagit"
  },
  {
    "id": 53619,
    "book": "psalms                                  ",
    "chapter": "69",
    "verse": "28",
    "text": "Ge dem (addera) överträdelse till deras överträdelser"
  },
  {
    "id": 53620,
    "book": "psalms                                  ",
    "chapter": "69",
    "verse": "29",
    "text": "Låt dem raderas ur Livets bok"
  },
  {
    "id": 53621,
    "book": "psalms                                  ",
    "chapter": "69",
    "verse": "30",
    "text": "Jag är plågad och i smärta,"
  },
  {
    "id": 53622,
    "book": "psalms                                  ",
    "chapter": "69",
    "verse": "31",
    "text": "Låt mig prisa Herrens (Elohims) namn med sång (hebr. shir)"
  },
  {
    "id": 53623,
    "book": "psalms                                  ",
    "chapter": "69",
    "verse": "32",
    "text": "Det ska behaga Herren (Jahve) mer än [ett offer av] en oxe [hebr. shor, snarlikt med sång i vers 31]"
  },
  {
    "id": 53624,
    "book": "psalms                                  ",
    "chapter": "69",
    "verse": "33",
    "text": "De ödmjuka (betryckta, fattiga) ska se det och vara glada."
  },
  {
    "id": 53625,
    "book": "psalms                                  ",
    "chapter": "69",
    "verse": "34",
    "text": "För Herren (Jahve) lyssnar till de fattiga och behövande,"
  },
  {
    "id": 53626,
    "book": "psalms                                  ",
    "chapter": "69",
    "verse": "35",
    "text": "Låt himlarna och jorden prisa honom,"
  },
  {
    "id": 53627,
    "book": "psalms                                  ",
    "chapter": "69",
    "verse": "36",
    "text": "För Gud (Elohim) ska frälsa Sion [tempelberget i Jerusalem]"
  },
  {
    "id": 53628,
    "book": "psalms                                  ",
    "chapter": "69",
    "verse": "37",
    "text": "Hans tjänares barn ska ärva det"
  }
]