[
  {
    "id": 54946,
    "book": "psalms                                  ",
    "chapter": "141",
    "verse": "1",
    "text": "En psalm (sång ackompanjerad på strängar), av (för) David."
  },
  {
    "id": 54947,
    "book": "psalms                                  ",
    "chapter": "141",
    "verse": "2",
    "text": "Låt mina böner vara som rökelse inför dig [2 Mos 30:7-8; Upp 5:8],"
  },
  {
    "id": 54948,
    "book": "psalms                                  ",
    "chapter": "141",
    "verse": "3",
    "text": "Sätt en vakt Herre (Jahve) framför min mun,"
  },
  {
    "id": 54949,
    "book": "psalms                                  ",
    "chapter": "141",
    "verse": "4",
    "text": "Låt inte mitt hjärta vika av (luta, dras iväg) mot onda ting,"
  },
  {
    "id": 54950,
    "book": "psalms                                  ",
    "chapter": "141",
    "verse": "5",
    "text": "Låt den rättfärdige drabba mig, det är nåd (omsorgsfull kärlek),"
  },
  {
    "id": 54951,
    "book": "psalms                                  ",
    "chapter": "141",
    "verse": "6",
    "text": "Deras domare är nedkastade från klippan,"
  },
  {
    "id": 54952,
    "book": "psalms                                  ",
    "chapter": "141",
    "verse": "7",
    "text": "Som när man plöjer och bryter upp jorden,"
  },
  {
    "id": 54953,
    "book": "psalms                                  ",
    "chapter": "141",
    "verse": "8",
    "text": "För mina ögon är vända till dig O, Gud, min Herre (Jahve Adonaj),"
  },
  {
    "id": 54954,
    "book": "psalms                                  ",
    "chapter": "141",
    "verse": "9",
    "text": "Bevara mig från snaran som de har lagt ut för mig,"
  },
  {
    "id": 54955,
    "book": "psalms                                  ",
    "chapter": "141",
    "verse": "10",
    "text": "Låt de onda falla i sina egna nät,"
  }
]