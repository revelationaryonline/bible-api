[
  {
    "id": 54368,
    "book": "psalms                                  ",
    "chapter": "107",
    "verse": "2",
    "text": "Så ska de befriade säga,"
  },
  {
    "id": 54369,
    "book": "psalms                                  ",
    "chapter": "107",
    "verse": "3",
    "text": "och samlat från [avlägsna] länder:"
  },
  {
    "id": 54370,
    "book": "psalms                                  ",
    "chapter": "107",
    "verse": "4",
    "text": "De vandrade genom öknen på en öde väg,"
  },
  {
    "id": 54371,
    "book": "psalms                                  ",
    "chapter": "107",
    "verse": "5",
    "text": "De var hungriga och törstiga,"
  },
  {
    "id": 54372,
    "book": "psalms                                  ",
    "chapter": "107",
    "verse": "6",
    "text": "[Bön:]"
  },
  {
    "id": 54373,
    "book": "psalms                                  ",
    "chapter": "107",
    "verse": "7",
    "text": "[Befrielse:]"
  },
  {
    "id": 54374,
    "book": "psalms                                  ",
    "chapter": "107",
    "verse": "8",
    "text": "[Tacksägelse:]"
  },
  {
    "id": 54375,
    "book": "psalms                                  ",
    "chapter": "107",
    "verse": "9",
    "text": "För han har överflödande gett vatten till den själ (person; även ”strupe”) som törstat,"
  },
  {
    "id": 54376,
    "book": "psalms                                  ",
    "chapter": "107",
    "verse": "10",
    "text": "Som den som sitter i mörkret och i dödens skugga,"
  },
  {
    "id": 54377,
    "book": "psalms                                  ",
    "chapter": "107",
    "verse": "11",
    "text": "Eftersom de gjorde uppror mot Guds ord,"
  },
  {
    "id": 54378,
    "book": "psalms                                  ",
    "chapter": "107",
    "verse": "12",
    "text": "Därför har han ödmjukat deras hjärtan med födslovåndor,"
  },
  {
    "id": 54379,
    "book": "psalms                                  ",
    "chapter": "107",
    "verse": "13",
    "text": "[Bön:]"
  },
  {
    "id": 54380,
    "book": "psalms                                  ",
    "chapter": "107",
    "verse": "14",
    "text": "[Befrielse:]"
  },
  {
    "id": 54381,
    "book": "psalms                                  ",
    "chapter": "107",
    "verse": "15",
    "text": "[Tacksägelse:]"
  },
  {
    "id": 54382,
    "book": "psalms                                  ",
    "chapter": "107",
    "verse": "16",
    "text": "För han har brutit sönder portarna av brons,"
  },
  {
    "id": 54383,
    "book": "psalms                                  ",
    "chapter": "107",
    "verse": "17",
    "text": "Dårar [moraliskt fördärvade var de], eftersom de vandrar på överträdelsens väg"
  },
  {
    "id": 54384,
    "book": "psalms                                  ",
    "chapter": "107",
    "verse": "18",
    "text": "De tappade aptiten för all mat,"
  },
  {
    "id": 54385,
    "book": "psalms                                  ",
    "chapter": "107",
    "verse": "19",
    "text": "[Bön:]"
  },
  {
    "id": 54386,
    "book": "psalms                                  ",
    "chapter": "107",
    "verse": "20",
    "text": "[Befrielse:]"
  },
  {
    "id": 54387,
    "book": "psalms                                  ",
    "chapter": "107",
    "verse": "21",
    "text": "[Tacksägelse:]"
  },
  {
    "id": 54388,
    "book": "psalms                                  ",
    "chapter": "107",
    "verse": "22",
    "text": "Låt dem bära fram tackoffer"
  },
  {
    "id": 54389,
    "book": "psalms                                  ",
    "chapter": "107",
    "verse": "23",
    "text": "De som går ner till havet i skepp,"
  },
  {
    "id": 54390,
    "book": "psalms                                  ",
    "chapter": "107",
    "verse": "24",
    "text": "de såg Herrens (Jahves) verk"
  },
  {
    "id": 54391,
    "book": "psalms                                  ",
    "chapter": "107",
    "verse": "25",
    "text": "Han talade och frambringade stormvinden,"
  },
  {
    "id": 54392,
    "book": "psalms                                  ",
    "chapter": "107",
    "verse": "26",
    "text": "de reste sig mot himlen, de kom ner i djupen."
  },
  {
    "id": 54393,
    "book": "psalms                                  ",
    "chapter": "107",
    "verse": "27",
    "text": "De vinglade (rörde sig i cirklar, dansade) och raglade som en berusad (drucken man),"
  },
  {
    "id": 54394,
    "book": "psalms                                  ",
    "chapter": "107",
    "verse": "28",
    "text": "[Bön:]"
  },
  {
    "id": 54395,
    "book": "psalms                                  ",
    "chapter": "107",
    "verse": "29",
    "text": "[Befrielse:]"
  },
  {
    "id": 54396,
    "book": "psalms                                  ",
    "chapter": "107",
    "verse": "30",
    "text": "[Tacksägelse:]"
  },
  {
    "id": 54397,
    "book": "psalms                                  ",
    "chapter": "107",
    "verse": "31",
    "text": "Må de tacka [med öppna händer – prisa, hylla och erkänna] Herren (Jahve)"
  },
  {
    "id": 54398,
    "book": "psalms                                  ",
    "chapter": "107",
    "verse": "32",
    "text": "Må de upphöja honom i församlingen,"
  },
  {
    "id": 54399,
    "book": "psalms                                  ",
    "chapter": "107",
    "verse": "33",
    "text": "Han gjorde floder till öken"
  },
  {
    "id": 54400,
    "book": "psalms                                  ",
    "chapter": "107",
    "verse": "34",
    "text": "Ett fruktbärande land till saltavfall,"
  },
  {
    "id": 54401,
    "book": "psalms                                  ",
    "chapter": "107",
    "verse": "35",
    "text": "Han gjorde öknen till en vattenrik sjö"
  },
  {
    "id": 54402,
    "book": "psalms                                  ",
    "chapter": "107",
    "verse": "36",
    "text": "Där lät han de hungriga bo"
  },
  {
    "id": 54403,
    "book": "psalms                                  ",
    "chapter": "107",
    "verse": "37",
    "text": "de besådde fälten och planterade vingårdar,"
  },
  {
    "id": 54404,
    "book": "psalms                                  ",
    "chapter": "107",
    "verse": "38",
    "text": "Han välsignade dem så att de förökades rikligt"
  },
  {
    "id": 54405,
    "book": "psalms                                  ",
    "chapter": "107",
    "verse": "39",
    "text": "Åter blev de svaga och krympte ihop"
  },
  {
    "id": 54406,
    "book": "psalms                                  ",
    "chapter": "107",
    "verse": "40",
    "text": "Han utgöt förakt över furstar och lät dem vandra i meningslöshet,"
  },
  {
    "id": 54407,
    "book": "psalms                                  ",
    "chapter": "107",
    "verse": "41",
    "text": "Han sätter de behövande högt över (långt ifrån) lidande,"
  },
  {
    "id": 54408,
    "book": "psalms                                  ",
    "chapter": "107",
    "verse": "42",
    "text": "De med uppriktiga hjärtan (ärliga och rena hjärtan, de rättsinniga, ordagrant ”rakhjärtade”) ser det och är glada,"
  },
  {
    "id": 54409,
    "book": "psalms                                  ",
    "chapter": "107",
    "verse": "43",
    "text": "Den som är vis, låt honom lägga märke till (bevara, skydda) dessa ting,"
  }
]