[
  {
    "id": 53246,
    "book": "psalms                                  ",
    "chapter": "46",
    "verse": "1",
    "text": "Till (för) ledaren. [Beskriver någon som utmärker sig – som är strålande och framstående inom sitt område. Syftar dels på föreståndaren för tempelmusiken men även på Messias ”den strålande morgonstjärnan”, se Upp 22:16 och inledningen till Psaltaren.]"
  },
  {
    "id": 53247,
    "book": "psalms                                  ",
    "chapter": "46",
    "verse": "2",
    "text": "Gud (Elohim) är vår tillflykt och [vår] styrka (starkhet, makt),"
  },
  {
    "id": 53248,
    "book": "psalms                                  ",
    "chapter": "46",
    "verse": "3",
    "text": "Därför ska vi inte frukta (vara rädda) även om jorden förändras (ger vika, skälver, skakar)"
  },
  {
    "id": 53249,
    "book": "psalms                                  ",
    "chapter": "46",
    "verse": "4",
    "text": "även om vågorna är i uppror och skummar (svallar),"
  },
  {
    "id": 53250,
    "book": "psalms                                  ",
    "chapter": "46",
    "verse": "5",
    "text": "Det finns en flod vars flöden ger glädje åt Guds (Elohims) stad,"
  },
  {
    "id": 53251,
    "book": "psalms                                  ",
    "chapter": "46",
    "verse": "6",
    "text": "Gud (Elohim) bor i staden, den kan inte falla (skakas)."
  },
  {
    "id": 53252,
    "book": "psalms                                  ",
    "chapter": "46",
    "verse": "7",
    "text": "Hednafolk är i uppror, och riken skakas."
  },
  {
    "id": 53253,
    "book": "psalms                                  ",
    "chapter": "46",
    "verse": "8",
    "text": "[Refräng:]"
  },
  {
    "id": 53254,
    "book": "psalms                                  ",
    "chapter": "46",
    "verse": "9",
    "text": "Kom, se (skåda) Herrens (Jahves) gärningar (verk)"
  },
  {
    "id": 53255,
    "book": "psalms                                  ",
    "chapter": "46",
    "verse": "10",
    "text": "Han stillar strider till jordens ände (gör slut på krig över hela jorden),"
  },
  {
    "id": 53256,
    "book": "psalms                                  ",
    "chapter": "46",
    "verse": "11",
    "text": "[Nu hörs Guds röst som talar:]"
  },
  {
    "id": 53257,
    "book": "psalms                                  ",
    "chapter": "46",
    "verse": "12",
    "text": "[Refrängen från vers 8 upprepas:]"
  }
]