[
  {
    "id": 54062,
    "book": "psalms                                  ",
    "chapter": "91",
    "verse": "1",
    "text": "Den som sitter (vistas, bor) i den Högstes (Elions) gömställe"
  },
  {
    "id": 54063,
    "book": "psalms                                  ",
    "chapter": "91",
    "verse": "2",
    "text": "Jag ska (vill) säga om Herren (Jahve):"
  },
  {
    "id": 54064,
    "book": "psalms                                  ",
    "chapter": "91",
    "verse": "3",
    "text": "För han räddar (utan tvekan ska han rycka bort) dig från fågelfångarens snara (jägarens nät),"
  },
  {
    "id": 54065,
    "book": "psalms                                  ",
    "chapter": "91",
    "verse": "4",
    "text": "Han ska betäcka dig med sina fjädrar,"
  },
  {
    "id": 54066,
    "book": "psalms                                  ",
    "chapter": "91",
    "verse": "5",
    "text": "Du ska [behöver] inte vara rädd för nattens fasor,"
  },
  {
    "id": 54067,
    "book": "psalms                                  ",
    "chapter": "91",
    "verse": "6",
    "text": "inte för pesten som smyger (går fram) i mörkret"
  },
  {
    "id": 54068,
    "book": "psalms                                  ",
    "chapter": "91",
    "verse": "7",
    "text": "Tusen kan falla vid din sida,"
  },
  {
    "id": 54069,
    "book": "psalms                                  ",
    "chapter": "91",
    "verse": "8",
    "text": "Du ska bara se på (observera, skåda) med egna ögon,"
  },
  {
    "id": 54070,
    "book": "psalms                                  ",
    "chapter": "91",
    "verse": "9",
    "text": "För du har sagt: ”Herren (Jahve) är min tillflykt (mitt skydd)”,"
  },
  {
    "id": 54071,
    "book": "psalms                                  ",
    "chapter": "91",
    "verse": "10",
    "text": "Inget ont ska drabba dig,"
  },
  {
    "id": 54072,
    "book": "psalms                                  ",
    "chapter": "91",
    "verse": "11",
    "text": "för han ska ge sina änglar (budbärare) befallning om dig,"
  },
  {
    "id": 54073,
    "book": "psalms                                  ",
    "chapter": "91",
    "verse": "12",
    "text": "På sina händer ska de bära [högt upp ska de lyfta] dig,"
  },
  {
    "id": 54074,
    "book": "psalms                                  ",
    "chapter": "91",
    "verse": "13",
    "text": "Över (på) lejon och huggorm ska du gå (träda, marchera) fram,"
  },
  {
    "id": 54075,
    "book": "psalms                                  ",
    "chapter": "91",
    "verse": "14",
    "text": "[Nu kommer det efterlängtade svaret när Gud talar:]"
  },
  {
    "id": 54076,
    "book": "psalms                                  ",
    "chapter": "91",
    "verse": "15",
    "text": "Han ska ropa (höja sin röst i bön) till mig och jag ska svara honom."
  },
  {
    "id": 54077,
    "book": "psalms                                  ",
    "chapter": "91",
    "verse": "16",
    "text": "Jag ska mätta honom med långt liv (längd av dagar)"
  }
]