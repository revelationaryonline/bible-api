[
  {
    "id": 54189,
    "book": "psalms                                  ",
    "chapter": "102",
    "verse": "1",
    "text": "En bön av en betryckt (ansatt), när han är överväldigad och utgjuter sin klagan (fundering, i sitt lågmälda grubblande) inför Herren (Jahve)."
  },
  {
    "id": 54190,
    "book": "psalms                                  ",
    "chapter": "102",
    "verse": "2",
    "text": "Herre (Jahve) hör min bön,"
  },
  {
    "id": 54191,
    "book": "psalms                                  ",
    "chapter": "102",
    "verse": "3",
    "text": "Göm inte ditt ansikte för mig"
  },
  {
    "id": 54192,
    "book": "psalms                                  ",
    "chapter": "102",
    "verse": "4",
    "text": "Mina dagar försvinner som rök,"
  },
  {
    "id": 54193,
    "book": "psalms                                  ",
    "chapter": "102",
    "verse": "5",
    "text": "Mitt hjärta är slaget (attackerat, bränt) och förvissnat som gräs [Hos 9:16],"
  },
  {
    "id": 54194,
    "book": "psalms                                  ",
    "chapter": "102",
    "verse": "6",
    "text": "På grund av min suckande röst"
  },
  {
    "id": 54195,
    "book": "psalms                                  ",
    "chapter": "102",
    "verse": "7",
    "text": "Jag är som en pelikan i öknen,"
  },
  {
    "id": 54196,
    "book": "psalms                                  ",
    "chapter": "102",
    "verse": "8",
    "text": "Jag tittar och har blivit"
  },
  {
    "id": 54197,
    "book": "psalms                                  ",
    "chapter": "102",
    "verse": "9",
    "text": "Mina fiender hånar mig hela dagen,"
  },
  {
    "id": 54198,
    "book": "psalms                                  ",
    "chapter": "102",
    "verse": "10",
    "text": "Jag har ätit aska som bröd,"
  },
  {
    "id": 54199,
    "book": "psalms                                  ",
    "chapter": "102",
    "verse": "11",
    "text": "På grund av din harm och din vrede,"
  },
  {
    "id": 54200,
    "book": "psalms                                  ",
    "chapter": "102",
    "verse": "12",
    "text": "är mina dagar som en lång skugga"
  },
  {
    "id": 54201,
    "book": "psalms                                  ",
    "chapter": "102",
    "verse": "13",
    "text": "Men du Herre (Jahve) sitter på tronen för evigt,"
  },
  {
    "id": 54202,
    "book": "psalms                                  ",
    "chapter": "102",
    "verse": "14",
    "text": "Du kommer att uppstå och ha nåd och förbarmande över Sion [tempelberget i Jerusalem],"
  },
  {
    "id": 54203,
    "book": "psalms                                  ",
    "chapter": "102",
    "verse": "15",
    "text": "Dina tjänare har sitt behag i hennes stenar"
  },
  {
    "id": 54204,
    "book": "psalms                                  ",
    "chapter": "102",
    "verse": "16",
    "text": "Nationerna (länderna, hedningarna) fruktar (vördar) Herrens (Jahves) namn,"
  },
  {
    "id": 54205,
    "book": "psalms                                  ",
    "chapter": "102",
    "verse": "17",
    "text": "När Herren (Jahve) har byggt upp Sion [tempelberget i Jerusalem],"
  },
  {
    "id": 54206,
    "book": "psalms                                  ",
    "chapter": "102",
    "verse": "18",
    "text": "när han har sett de utblottades böner,"
  },
  {
    "id": 54207,
    "book": "psalms                                  ",
    "chapter": "102",
    "verse": "19",
    "text": "Detta ska skrivas för kommande generationer,"
  },
  {
    "id": 54208,
    "book": "psalms                                  ",
    "chapter": "102",
    "verse": "20",
    "text": "För han har sett ner från sin helgedom i höjden,"
  },
  {
    "id": 54209,
    "book": "psalms                                  ",
    "chapter": "102",
    "verse": "21",
    "text": "för att höra jämmern från de fångna,"
  },
  {
    "id": 54210,
    "book": "psalms                                  ",
    "chapter": "102",
    "verse": "22",
    "text": "för att människor ska berätta om Herrens (Jahves) namn i Sion [tempelberget i Jerusalem],"
  },
  {
    "id": 54211,
    "book": "psalms                                  ",
    "chapter": "102",
    "verse": "23",
    "text": "När folken samlas,"
  },
  {
    "id": 54212,
    "book": "psalms                                  ",
    "chapter": "102",
    "verse": "24",
    "text": "Han försvagar min styrka på vägen,"
  },
  {
    "id": 54213,
    "book": "psalms                                  ",
    "chapter": "102",
    "verse": "25",
    "text": "Jag säger: Min Gud (El) ta inte bort mig mitt i mina dagar (mitt i livet),"
  },
  {
    "id": 54214,
    "book": "psalms                                  ",
    "chapter": "102",
    "verse": "26",
    "text": "En gång lade du jordens grund,"
  },
  {
    "id": 54215,
    "book": "psalms                                  ",
    "chapter": "102",
    "verse": "27",
    "text": "De ska förgås,"
  },
  {
    "id": 54216,
    "book": "psalms                                  ",
    "chapter": "102",
    "verse": "28",
    "text": "Du är densamme (du förändras inte),"
  },
  {
    "id": 54217,
    "book": "psalms                                  ",
    "chapter": "102",
    "verse": "29",
    "text": "Dina tjänares barn ska bo här,"
  }
]