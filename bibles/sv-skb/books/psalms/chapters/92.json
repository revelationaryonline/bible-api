[
  {
    "id": 54078,
    "book": "psalms                                  ",
    "chapter": "92",
    "verse": "1",
    "text": "En psalm, en sång för sabbatsdagen. [2 Mos 20:8-11; 4 Mos 5:12-15]"
  },
  {
    "id": 54079,
    "book": "psalms                                  ",
    "chapter": "92",
    "verse": "2",
    "text": "Det är gott (en god sak) att tacka [med öppna händer – prisa, hylla och erkänna] Herren (Jahve),"
  },
  {
    "id": 54080,
    "book": "psalms                                  ",
    "chapter": "92",
    "verse": "3",
    "text": "Att förkunna din nåd (omsorgsfulla kärlek) på morgonen,"
  },
  {
    "id": 54081,
    "book": "psalms                                  ",
    "chapter": "92",
    "verse": "4",
    "text": "Med ett tiosträngat instrument och med Nevl-lyra (hebr. nevel) [större harpa, vanligtvis tolvsträngad]"
  },
  {
    "id": 54082,
    "book": "psalms                                  ",
    "chapter": "92",
    "verse": "5",
    "text": "För du Herre (Jahve) har gjort mig glad med dina verk."
  },
  {
    "id": 54083,
    "book": "psalms                                  ",
    "chapter": "92",
    "verse": "6",
    "text": "Hur stora är inte dina gärningar o Herre (Jahve)!"
  },
  {
    "id": 54084,
    "book": "psalms                                  ",
    "chapter": "92",
    "verse": "7",
    "text": "En djurisk (rå, oförnuftig) människa känner dem inte,"
  },
  {
    "id": 54085,
    "book": "psalms                                  ",
    "chapter": "92",
    "verse": "8",
    "text": "När de onda växer upp som gräset,"
  },
  {
    "id": 54086,
    "book": "psalms                                  ",
    "chapter": "92",
    "verse": "9",
    "text": "Men du Herre (Jahve) är hög för evigt."
  },
  {
    "id": 54087,
    "book": "psalms                                  ",
    "chapter": "92",
    "verse": "10",
    "text": "För dina fiender Herre (Jahve),"
  },
  {
    "id": 54088,
    "book": "psalms                                  ",
    "chapter": "92",
    "verse": "11",
    "text": "Men mitt horn [symbol på styrka] har du upphöjt som vildoxens horn."
  },
  {
    "id": 54089,
    "book": "psalms                                  ",
    "chapter": "92",
    "verse": "12",
    "text": "Mina ögon har sett på dem som ligger på lur efter mig,"
  },
  {
    "id": 54090,
    "book": "psalms                                  ",
    "chapter": "92",
    "verse": "13",
    "text": "Den rättfärdige ska blomstra som palmträdet [Ps 1:3; 52:10],"
  },
  {
    "id": 54091,
    "book": "psalms                                  ",
    "chapter": "92",
    "verse": "14",
    "text": "Planterade i Herrens (Jahves) hus"
  },
  {
    "id": 54092,
    "book": "psalms                                  ",
    "chapter": "92",
    "verse": "15",
    "text": "De ska fortsätta att bära frukt vid hög ålder,"
  },
  {
    "id": 54093,
    "book": "psalms                                  ",
    "chapter": "92",
    "verse": "16",
    "text": "till att förkunna att Herren (Jahve) är uppriktig,"
  }
]