[
  {
    "id": 55012,
    "book": "psalms                                  ",
    "chapter": "146",
    "verse": "1",
    "text": "Prisa Herren (lova Jah – hebr. hallelujah)!"
  },
  {
    "id": 55013,
    "book": "psalms                                  ",
    "chapter": "146",
    "verse": "2",
    "text": "Jag ska prisa Herren (Jahve) hela mitt liv,"
  },
  {
    "id": 55014,
    "book": "psalms                                  ",
    "chapter": "146",
    "verse": "3",
    "text": "Förtrösta inte på furstar [politiker och ledare i samhället, på deras generositet och rikedom],"
  },
  {
    "id": 55015,
    "book": "psalms                                  ",
    "chapter": "146",
    "verse": "4",
    "text": "I samma ögonblick de ger upp andan (när anden lämnar kroppen),"
  },
  {
    "id": 55016,
    "book": "psalms                                  ",
    "chapter": "146",
    "verse": "5",
    "text": "Rikt välsignad (salig, mycket lycklig) är den som har Jakobs Gud som sin hjälpare"
  },
  {
    "id": 55017,
    "book": "psalms                                  ",
    "chapter": "146",
    "verse": "6",
    "text": "Han som format himlar och jord, havet, och allt som finns i dem,"
  },
  {
    "id": 55018,
    "book": "psalms                                  ",
    "chapter": "146",
    "verse": "7",
    "text": "som ger de förtryckta rätt,"
  },
  {
    "id": 55019,
    "book": "psalms                                  ",
    "chapter": "146",
    "verse": "8",
    "text": "Herren ger syn till de blinda."
  },
  {
    "id": 55020,
    "book": "psalms                                  ",
    "chapter": "146",
    "verse": "9",
    "text": "Herren beskyddar främlingar,"
  },
  {
    "id": 55021,
    "book": "psalms                                  ",
    "chapter": "146",
    "verse": "10",
    "text": "Herren regerar (är kung) för evigt, din Gud, o Sion [tempelberget i Jerusalem],"
  }
]