[
  {
    "id": 54275,
    "book": "psalms                                  ",
    "chapter": "105",
    "verse": "1",
    "text": "Tacka [med öppna händer – prisa, hylla och erkänn] Herren (Jahve),"
  },
  {
    "id": 54276,
    "book": "psalms                                  ",
    "chapter": "105",
    "verse": "2",
    "text": "Sjung till honom, musicera till honom,"
  },
  {
    "id": 54277,
    "book": "psalms                                  ",
    "chapter": "105",
    "verse": "3",
    "text": "Ha er ära i hans heliga namn,"
  },
  {
    "id": 54278,
    "book": "psalms                                  ",
    "chapter": "105",
    "verse": "4",
    "text": "Fråga efter (sök, ta er tillflykt till, träd ofta fram inför) Herren (Jahve) och hans styrka (makt) [frälsning],"
  },
  {
    "id": 54279,
    "book": "psalms                                  ",
    "chapter": "105",
    "verse": "5",
    "text": "Kom ihåg hans underbara gärningar,"
  },
  {
    "id": 54280,
    "book": "psalms                                  ",
    "chapter": "105",
    "verse": "6",
    "text": "Abrahams säd, hans tjänare,"
  },
  {
    "id": 54281,
    "book": "psalms                                  ",
    "chapter": "105",
    "verse": "7",
    "text": "Han är Herren vår Gud (Jahve Elohim)."
  },
  {
    "id": 54282,
    "book": "psalms                                  ",
    "chapter": "105",
    "verse": "8",
    "text": "Han har kommit ihåg sitt förbund för evigt,"
  },
  {
    "id": 54283,
    "book": "psalms                                  ",
    "chapter": "105",
    "verse": "9",
    "text": "Förbundet som han upprättade (skar) med Abraham,"
  },
  {
    "id": 54284,
    "book": "psalms                                  ",
    "chapter": "105",
    "verse": "10",
    "text": "Han har bekräftat det till Jakob som en stadga,"
  },
  {
    "id": 54285,
    "book": "psalms                                  ",
    "chapter": "105",
    "verse": "11",
    "text": "Du säger: ”Till dig ska jag ge Kanaans land,"
  },
  {
    "id": 54286,
    "book": "psalms                                  ",
    "chapter": "105",
    "verse": "12",
    "text": "När de bara var ett fåtal, ja mycket få,"
  },
  {
    "id": 54287,
    "book": "psalms                                  ",
    "chapter": "105",
    "verse": "13",
    "text": "när de gick från land till land,"
  },
  {
    "id": 54288,
    "book": "psalms                                  ",
    "chapter": "105",
    "verse": "14",
    "text": "tillät han ingen att göra fel mot dem,"
  },
  {
    "id": 54289,
    "book": "psalms                                  ",
    "chapter": "105",
    "verse": "15",
    "text": "[Och sade:] ”Rör inte mina smorde (utvalda)"
  },
  {
    "id": 54290,
    "book": "psalms                                  ",
    "chapter": "105",
    "verse": "16",
    "text": "Han kallade på en hungersnöd över landet,"
  },
  {
    "id": 54291,
    "book": "psalms                                  ",
    "chapter": "105",
    "verse": "17",
    "text": "Han sände en man framför dem,"
  },
  {
    "id": 54292,
    "book": "psalms                                  ",
    "chapter": "105",
    "verse": "18",
    "text": "hans fötter sattes i kedjor,"
  },
  {
    "id": 54293,
    "book": "psalms                                  ",
    "chapter": "105",
    "verse": "19",
    "text": "till den tid då hans ord (tal – hebr. davar) kom,"
  },
  {
    "id": 54294,
    "book": "psalms                                  ",
    "chapter": "105",
    "verse": "20",
    "text": "Kungen sände bud och frigjorde honom,"
  },
  {
    "id": 54295,
    "book": "psalms                                  ",
    "chapter": "105",
    "verse": "21",
    "text": "Han gjorde honom till herre över sitt hus"
  },
  {
    "id": 54296,
    "book": "psalms                                  ",
    "chapter": "105",
    "verse": "22",
    "text": "till att disciplinera hans furstar efter sitt behag"
  },
  {
    "id": 54297,
    "book": "psalms                                  ",
    "chapter": "105",
    "verse": "23",
    "text": "Israel kom också till Egypten"
  },
  {
    "id": 54298,
    "book": "psalms                                  ",
    "chapter": "105",
    "verse": "24",
    "text": "Han lät sitt folk växa till storligen (i antal, vara fruktsamma) [2 Mos 1:7]"
  },
  {
    "id": 54299,
    "book": "psalms                                  ",
    "chapter": "105",
    "verse": "25",
    "text": "Han vände deras [egyptiernas] hjärtan"
  },
  {
    "id": 54300,
    "book": "psalms                                  ",
    "chapter": "105",
    "verse": "26",
    "text": "Han sände Mose,"
  },
  {
    "id": 54301,
    "book": "psalms                                  ",
    "chapter": "105",
    "verse": "27",
    "text": "De utförde ibland dem hans olika tecken,"
  },
  {
    "id": 54302,
    "book": "psalms                                  ",
    "chapter": "105",
    "verse": "28",
    "text": "Han sände mörker, och det blev mörkt,"
  },
  {
    "id": 54303,
    "book": "psalms                                  ",
    "chapter": "105",
    "verse": "29",
    "text": "Han förvandlade deras vatten till blod"
  },
  {
    "id": 54304,
    "book": "psalms                                  ",
    "chapter": "105",
    "verse": "30",
    "text": "Deras land övertäcktes av grodor,"
  },
  {
    "id": 54305,
    "book": "psalms                                  ",
    "chapter": "105",
    "verse": "31",
    "text": "Han talade och det kom flugsvärmar"
  },
  {
    "id": 54306,
    "book": "psalms                                  ",
    "chapter": "105",
    "verse": "32",
    "text": "Han gav dem hagel istället för regn"
  },
  {
    "id": 54307,
    "book": "psalms                                  ",
    "chapter": "105",
    "verse": "33",
    "text": "Han slog deras vinstockar och deras fikonträd"
  },
  {
    "id": 54308,
    "book": "psalms                                  ",
    "chapter": "105",
    "verse": "34",
    "text": "Han talade och gräshoppor kom"
  },
  {
    "id": 54309,
    "book": "psalms                                  ",
    "chapter": "105",
    "verse": "35",
    "text": "De åt upp alla örter i deras land"
  },
  {
    "id": 54310,
    "book": "psalms                                  ",
    "chapter": "105",
    "verse": "36",
    "text": "Han slog alla förstfödda i deras land,"
  },
  {
    "id": 54311,
    "book": "psalms                                  ",
    "chapter": "105",
    "verse": "37",
    "text": "Han förde ut dem med silver och guld [2 Mos 12:35-36],"
  },
  {
    "id": 54312,
    "book": "psalms                                  ",
    "chapter": "105",
    "verse": "38",
    "text": "Egypten gladdes när de lämnade,"
  },
  {
    "id": 54313,
    "book": "psalms                                  ",
    "chapter": "105",
    "verse": "39",
    "text": "Han spred ut en molnstod som ett skydd"
  },
  {
    "id": 54314,
    "book": "psalms                                  ",
    "chapter": "105",
    "verse": "40",
    "text": "De bad och han gav dem vaktlar,"
  },
  {
    "id": 54315,
    "book": "psalms                                  ",
    "chapter": "105",
    "verse": "41",
    "text": "Han öppnade klippan och vatten forsade ut,"
  },
  {
    "id": 54316,
    "book": "psalms                                  ",
    "chapter": "105",
    "verse": "42",
    "text": "För han kom ihåg sitt heliga ord"
  },
  {
    "id": 54317,
    "book": "psalms                                  ",
    "chapter": "105",
    "verse": "43",
    "text": "Han förde ut sitt folk med glädje,"
  },
  {
    "id": 54318,
    "book": "psalms                                  ",
    "chapter": "105",
    "verse": "44",
    "text": "Han gav dem ländernas områden"
  },
  {
    "id": 54319,
    "book": "psalms                                  ",
    "chapter": "105",
    "verse": "45",
    "text": "För att de skulle hålla (vakta, bevara) hans stadgar"
  }
]