[
  {
    "id": 54964,
    "book": "psalms                                  ",
    "chapter": "143",
    "verse": "1",
    "text": "En psalm (sång ackompanjerad på strängar), av (för) David. [Den grekiska översättningen Septuaginta har tillägget: ”när han flydde för sin son”, se Ps 3:1.]"
  },
  {
    "id": 54965,
    "book": "psalms                                  ",
    "chapter": "143",
    "verse": "2",
    "text": "Inled inte en rättsprocess med din tjänare,"
  },
  {
    "id": 54966,
    "book": "psalms                                  ",
    "chapter": "143",
    "verse": "3",
    "text": "För fienden har förföljt min själ (mig – hebr. nefesh)"
  },
  {
    "id": 54967,
    "book": "psalms                                  ",
    "chapter": "143",
    "verse": "4",
    "text": "Min ande förtvinar i mig [Ps 142:3],"
  },
  {
    "id": 54968,
    "book": "psalms                                  ",
    "chapter": "143",
    "verse": "5",
    "text": "Jag kommer ihåg forna dagar"
  },
  {
    "id": 54969,
    "book": "psalms                                  ",
    "chapter": "143",
    "verse": "6",
    "text": "Jag sträcker mina händer mot dig i bön,"
  },
  {
    "id": 54970,
    "book": "psalms                                  ",
    "chapter": "143",
    "verse": "7",
    "text": "Skynda att svara (se, uppmärksamma) mig Herre (Jahve),"
  },
  {
    "id": 54971,
    "book": "psalms                                  ",
    "chapter": "143",
    "verse": "8",
    "text": "Låt mig få höra om (hörsamma, förstå) [möta; uppmärksamt få erfara] din nåd (omsorgsfulla kärlek) på morgonen,"
  },
  {
    "id": 54972,
    "book": "psalms                                  ",
    "chapter": "143",
    "verse": "9",
    "text": "Rädda (ryck bort) mig från mina fiender, Herre (Jahve),"
  },
  {
    "id": 54973,
    "book": "psalms                                  ",
    "chapter": "143",
    "verse": "10",
    "text": "Lär mig (egga/sporra mig; träna mig i) att göra din vilja,"
  },
  {
    "id": 54974,
    "book": "psalms                                  ",
    "chapter": "143",
    "verse": "11",
    "text": "För ditt namns skull, Herre (Jahve),"
  },
  {
    "id": 54975,
    "book": "psalms                                  ",
    "chapter": "143",
    "verse": "12",
    "text": "och i din nåd (omsorgfulla kärlek - hebr. chesed)"
  }
]