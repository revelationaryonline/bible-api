[
  {
    "id": 54517,
    "book": "psalms                                  ",
    "chapter": "116",
    "verse": "1",
    "text": "Jag älskar –"
  },
  {
    "id": 54518,
    "book": "psalms                                  ",
    "chapter": "116",
    "verse": "2",
    "text": "Han har vänt sitt öra till mig (böjt sig ner mot mig),"
  },
  {
    "id": 54519,
    "book": "psalms                                  ",
    "chapter": "116",
    "verse": "3",
    "text": "Dödens band omslöt mig mer och mer,"
  },
  {
    "id": 54520,
    "book": "psalms                                  ",
    "chapter": "116",
    "verse": "4",
    "text": "då åkallade jag (höjde jag min röst och bad i) Herrens (Jahves) namn:"
  },
  {
    "id": 54521,
    "book": "psalms                                  ",
    "chapter": "116",
    "verse": "5",
    "text": "Herren (Jahve) är nådefull (barmhärtig, oförtjänt kärlek) och rättfärdig,"
  },
  {
    "id": 54522,
    "book": "psalms                                  ",
    "chapter": "116",
    "verse": "6",
    "text": "Herren (Jahve) bevarar ständigt de enkla (öppna, helhjärtade),"
  },
  {
    "id": 54523,
    "book": "psalms                                  ",
    "chapter": "116",
    "verse": "7",
    "text": "Återvänd till din vila, min själ,"
  },
  {
    "id": 54524,
    "book": "psalms                                  ",
    "chapter": "116",
    "verse": "8",
    "text": "Du har räddat min själ från döden,"
  },
  {
    "id": 54525,
    "book": "psalms                                  ",
    "chapter": "116",
    "verse": "9",
    "text": "Jag ska vandra inför Herren (Jahve),"
  },
  {
    "id": 54526,
    "book": "psalms                                  ",
    "chapter": "116",
    "verse": "10",
    "text": "Jag hade tillit (trodde), därför talade jag [2 Kor 4:13]:"
  },
  {
    "id": 54527,
    "book": "psalms                                  ",
    "chapter": "116",
    "verse": "11",
    "text": "Jag sade i min brådska (flykt, oro – impulsivt) [Ps 31:23]:"
  },
  {
    "id": 54528,
    "book": "psalms                                  ",
    "chapter": "116",
    "verse": "12",
    "text": "Hur kan jag återgälda Herren (Jahve)"
  },
  {
    "id": 54529,
    "book": "psalms                                  ",
    "chapter": "116",
    "verse": "13",
    "text": "Jag ska lyfta upp frälsningens bägare,"
  },
  {
    "id": 54530,
    "book": "psalms                                  ",
    "chapter": "116",
    "verse": "14",
    "text": "Jag ska infria mina löften till Herren (Jahve),"
  },
  {
    "id": 54531,
    "book": "psalms                                  ",
    "chapter": "116",
    "verse": "15",
    "text": "Dyrbart i Herrens (Jahves) ögon"
  },
  {
    "id": 54532,
    "book": "psalms                                  ",
    "chapter": "116",
    "verse": "16",
    "text": "Jag ber dig Herre (Jahve),"
  },
  {
    "id": 54533,
    "book": "psalms                                  ",
    "chapter": "116",
    "verse": "17",
    "text": "Jag ska offra tackoffer till dig,"
  },
  {
    "id": 54534,
    "book": "psalms                                  ",
    "chapter": "116",
    "verse": "18",
    "text": "jag ska infria mina löften till Herren (Jahve),"
  },
  {
    "id": 54535,
    "book": "psalms                                  ",
    "chapter": "116",
    "verse": "19",
    "text": "i gårdarna till Herrens (Jahves) hus,"
  }
]