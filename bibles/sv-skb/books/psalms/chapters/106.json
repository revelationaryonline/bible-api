[
  {
    "id": 54320,
    "book": "psalms                                  ",
    "chapter": "106",
    "verse": "1",
    "text": "Prisa Herren (lova Jah – hebr. hallelujah)!"
  },
  {
    "id": 54321,
    "book": "psalms                                  ",
    "chapter": "106",
    "verse": "2",
    "text": "Vem kan förklara Herrens (Jahves) mäktiga gärningar"
  },
  {
    "id": 54322,
    "book": "psalms                                  ",
    "chapter": "106",
    "verse": "3",
    "text": "Rikt välsignad (salig, mycket lycklig) är den som håller rätten [gör och skyddar det som är rätt],"
  },
  {
    "id": 54323,
    "book": "psalms                                  ",
    "chapter": "106",
    "verse": "4",
    "text": "Kom ihåg mig Herre (Jahve) när du belönar ditt folk,"
  },
  {
    "id": 54324,
    "book": "psalms                                  ",
    "chapter": "106",
    "verse": "5",
    "text": "så att jag får se framgången hos dina utvalda,"
  },
  {
    "id": 54325,
    "book": "psalms                                  ",
    "chapter": "106",
    "verse": "6",
    "text": "Vi har syndat med våra fäder [på samma sätt som de],"
  },
  {
    "id": 54326,
    "book": "psalms                                  ",
    "chapter": "106",
    "verse": "7",
    "text": "Våra fäder i Egypten uppmärksammade inte dina under,"
  },
  {
    "id": 54327,
    "book": "psalms                                  ",
    "chapter": "106",
    "verse": "8",
    "text": "Likväl frälste (räddade) han dem för sitt namns skull,"
  },
  {
    "id": 54328,
    "book": "psalms                                  ",
    "chapter": "106",
    "verse": "9",
    "text": "Han tillrättavisade Röda havet och det torkade upp;"
  },
  {
    "id": 54329,
    "book": "psalms                                  ",
    "chapter": "106",
    "verse": "10",
    "text": "Han frälste dem från hans hand som hatade dem;"
  },
  {
    "id": 54330,
    "book": "psalms                                  ",
    "chapter": "106",
    "verse": "11",
    "text": "Vattnet övertäckte deras åklagare [en beskrivning av farao och hans armé som utplånades fullständigt],"
  },
  {
    "id": 54331,
    "book": "psalms                                  ",
    "chapter": "106",
    "verse": "12",
    "text": "Sedan trodde de (Israels barn) hans ord,"
  },
  {
    "id": 54332,
    "book": "psalms                                  ",
    "chapter": "106",
    "verse": "13",
    "text": "Men de glömde snabbt vad han gjort,"
  },
  {
    "id": 54333,
    "book": "psalms                                  ",
    "chapter": "106",
    "verse": "14",
    "text": "utan svävade ut i ohämmad lusta i öknen"
  },
  {
    "id": 54334,
    "book": "psalms                                  ",
    "chapter": "106",
    "verse": "15",
    "text": "Han gav dem vad de begärde"
  },
  {
    "id": 54335,
    "book": "psalms                                  ",
    "chapter": "106",
    "verse": "16",
    "text": "De var avundsjuka på Mose i lägret"
  },
  {
    "id": 54336,
    "book": "psalms                                  ",
    "chapter": "106",
    "verse": "17",
    "text": "Jorden öppnade sig och slukade Datan"
  },
  {
    "id": 54337,
    "book": "psalms                                  ",
    "chapter": "106",
    "verse": "18",
    "text": "En eld tändes i deras avdelning,"
  },
  {
    "id": 54338,
    "book": "psalms                                  ",
    "chapter": "106",
    "verse": "19",
    "text": "De gjorde en kalv i Horeb"
  },
  {
    "id": 54339,
    "book": "psalms                                  ",
    "chapter": "106",
    "verse": "20",
    "text": "På det viset bytte de ut sin ära"
  },
  {
    "id": 54340,
    "book": "psalms                                  ",
    "chapter": "106",
    "verse": "21",
    "text": "De glömde bort Gud (El) deras frälsare"
  },
  {
    "id": 54341,
    "book": "psalms                                  ",
    "chapter": "106",
    "verse": "22",
    "text": "förunderliga ting i Hams land"
  },
  {
    "id": 54342,
    "book": "psalms                                  ",
    "chapter": "106",
    "verse": "23",
    "text": "Därför sa han [Gud] att han skulle förgöra dem."
  },
  {
    "id": 54343,
    "book": "psalms                                  ",
    "chapter": "106",
    "verse": "24",
    "text": "Dessutom föraktade de det åtråvärda landet [Israel],"
  },
  {
    "id": 54344,
    "book": "psalms                                  ",
    "chapter": "106",
    "verse": "25",
    "text": "De knotade i sina tält [5 Mos 1:27; 1 Kor 10:10],"
  },
  {
    "id": 54345,
    "book": "psalms                                  ",
    "chapter": "106",
    "verse": "26",
    "text": "Därför gav han dem sin ed"
  },
  {
    "id": 54346,
    "book": "psalms                                  ",
    "chapter": "106",
    "verse": "27",
    "text": "och skingra deras ättlingar bland nationerna"
  },
  {
    "id": 54347,
    "book": "psalms                                  ",
    "chapter": "106",
    "verse": "28",
    "text": "De gick i ok med Baal från Peor"
  },
  {
    "id": 54348,
    "book": "psalms                                  ",
    "chapter": "106",
    "verse": "29",
    "text": "På det sättet retade och provocerade de honom med sina gärningar"
  },
  {
    "id": 54349,
    "book": "psalms                                  ",
    "chapter": "106",
    "verse": "30",
    "text": "Men Pinchas stod upp och ingrep"
  },
  {
    "id": 54350,
    "book": "psalms                                  ",
    "chapter": "106",
    "verse": "31",
    "text": "Det tillräknades honom som rättfärdighet,"
  },
  {
    "id": 54351,
    "book": "psalms                                  ",
    "chapter": "106",
    "verse": "32",
    "text": "Vid Merivas vatten framkallade de hans vrede [Ps 81:7; 95:8]"
  },
  {
    "id": 54352,
    "book": "psalms                                  ",
    "chapter": "106",
    "verse": "33",
    "text": "De förbittrade hans ande"
  },
  {
    "id": 54353,
    "book": "psalms                                  ",
    "chapter": "106",
    "verse": "34",
    "text": "De förgjorde inte folken [olika fiender som krigade mot Israel under ökenvandringen]"
  },
  {
    "id": 54354,
    "book": "psalms                                  ",
    "chapter": "106",
    "verse": "35",
    "text": "Tvärtom beblandade de sig med de andra nationerna"
  },
  {
    "id": 54355,
    "book": "psalms                                  ",
    "chapter": "106",
    "verse": "36",
    "text": "De tjänade deras avgudar,"
  },
  {
    "id": 54356,
    "book": "psalms                                  ",
    "chapter": "106",
    "verse": "37",
    "text": "De till och med offrade sina söner"
  },
  {
    "id": 54357,
    "book": "psalms                                  ",
    "chapter": "106",
    "verse": "38",
    "text": "De utgöt oskyldigt blod,"
  },
  {
    "id": 54358,
    "book": "psalms                                  ",
    "chapter": "106",
    "verse": "39",
    "text": "Så skändade de sig själva med sina handlingar,"
  },
  {
    "id": 54359,
    "book": "psalms                                  ",
    "chapter": "106",
    "verse": "40",
    "text": "Därför upptändes Herrens (Jahves) brinnande vrede mot sitt folk"
  },
  {
    "id": 54360,
    "book": "psalms                                  ",
    "chapter": "106",
    "verse": "41",
    "text": "Han utlämnade dem till nationerna [alla länder dit de blev kringspridda]"
  },
  {
    "id": 54361,
    "book": "psalms                                  ",
    "chapter": "106",
    "verse": "42",
    "text": "Deras fiender förtryckte dem"
  },
  {
    "id": 54362,
    "book": "psalms                                  ",
    "chapter": "106",
    "verse": "43",
    "text": "Många gånger räddade han dem (ryckte han upp dem)"
  },
  {
    "id": 54363,
    "book": "psalms                                  ",
    "chapter": "106",
    "verse": "44",
    "text": "Trots det såg han till deras nöd"
  },
  {
    "id": 54364,
    "book": "psalms                                  ",
    "chapter": "106",
    "verse": "45",
    "text": "Han kom ihåg förbundet som han slutit med dem"
  },
  {
    "id": 54365,
    "book": "psalms                                  ",
    "chapter": "106",
    "verse": "46",
    "text": "Han gav dem medömkan (lät dem finna barmhärtighet och ömsint nåd)"
  },
  {
    "id": 54366,
    "book": "psalms                                  ",
    "chapter": "106",
    "verse": "47",
    "text": "Fräls oss Herre vår Gud (Jahve Elohim)"
  },
  {
    "id": 54367,
    "book": "psalms                                  ",
    "chapter": "106",
    "verse": "48",
    "text": "Välsignad är Herren (Jahve), Israels Gud (Elohim)"
  }
]