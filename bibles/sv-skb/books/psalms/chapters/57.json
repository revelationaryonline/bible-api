[
  {
    "id": 53413,
    "book": "psalms                                  ",
    "chapter": "57",
    "verse": "1",
    "text": "Till (för) ledaren. [Beskriver någon som utmärker sig – som är strålande och framstående inom sitt område. Syftar dels på föreståndaren för tempelmusiken men även på Messias ”den strålande morgonstjärnan”, se Upp 22:16 och inledningen till Psaltaren.]"
  },
  {
    "id": 53414,
    "book": "psalms                                  ",
    "chapter": "57",
    "verse": "2",
    "text": "Var mig nådig (ge mig favör; visa mig oförtjänt kärlek) Gud (Elohim), var mig nådig"
  },
  {
    "id": 53415,
    "book": "psalms                                  ",
    "chapter": "57",
    "verse": "3",
    "text": "Jag vill ropa (höja min röst i bön) till Gud den Högste (Elohim Elion),"
  },
  {
    "id": 53416,
    "book": "psalms                                  ",
    "chapter": "57",
    "verse": "4",
    "text": "Han [Gud] ska sända [hjälp] från himlen"
  },
  {
    "id": 53417,
    "book": "psalms                                  ",
    "chapter": "57",
    "verse": "5",
    "text": "Jag (min själ) är bland (omringad av) lejon,"
  },
  {
    "id": 53418,
    "book": "psalms                                  ",
    "chapter": "57",
    "verse": "6",
    "text": "[Refräng:]"
  },
  {
    "id": 53419,
    "book": "psalms                                  ",
    "chapter": "57",
    "verse": "7",
    "text": "De har förberett ett nät för mina steg,"
  },
  {
    "id": 53420,
    "book": "psalms                                  ",
    "chapter": "57",
    "verse": "8",
    "text": "Mitt hjärta är redo (jag är förvissad, förtröstansfull) Gud (Elohim),"
  },
  {
    "id": 53421,
    "book": "psalms                                  ",
    "chapter": "57",
    "verse": "9",
    "text": "vakna min ära (min tyngd)."
  },
  {
    "id": 53422,
    "book": "psalms                                  ",
    "chapter": "57",
    "verse": "10",
    "text": "Jag vill tacka [med öppna händer – prisa, hylla och erkänna] dig bland folken Herre (Adonaj),"
  },
  {
    "id": 53423,
    "book": "psalms                                  ",
    "chapter": "57",
    "verse": "11",
    "text": "För din nåd (omsorgsfulla kärlek) är stor, den når till himlarna,"
  },
  {
    "id": 53424,
    "book": "psalms                                  ",
    "chapter": "57",
    "verse": "12",
    "text": "[Refräng:]"
  }
]