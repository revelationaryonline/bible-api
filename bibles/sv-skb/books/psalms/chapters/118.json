[
  {
    "id": 54538,
    "book": "psalms                                  ",
    "chapter": "118",
    "verse": "1",
    "text": "Tacka [med öppna händer – prisa, hylla och erkänn] Herren (Jahve), för han är god,"
  },
  {
    "id": 54539,
    "book": "psalms                                  ",
    "chapter": "118",
    "verse": "2",
    "text": "Sjung, du Israels folk,"
  },
  {
    "id": 54540,
    "book": "psalms                                  ",
    "chapter": "118",
    "verse": "3",
    "text": "Sjung, du Arons släkt [alla präster],"
  },
  {
    "id": 54541,
    "book": "psalms                                  ",
    "chapter": "118",
    "verse": "4",
    "text": "Sjung, ni som fruktar (vördar) Herren (Jahve) [Mal 3:16; Ords 1:7],"
  },
  {
    "id": 54542,
    "book": "psalms                                  ",
    "chapter": "118",
    "verse": "5",
    "text": "I mitt trångmål ropade jag (höjde jag min röst i bön) till Herren (Jah),"
  },
  {
    "id": 54543,
    "book": "psalms                                  ",
    "chapter": "118",
    "verse": "6",
    "text": "Herren (Jahve) är för mig (vid min sida), jag fruktar inte. [Rom 8:31]"
  },
  {
    "id": 54544,
    "book": "psalms                                  ",
    "chapter": "118",
    "verse": "7",
    "text": "Herren (Jahve) är för mig (vid min sida), min hjälpare,"
  },
  {
    "id": 54545,
    "book": "psalms                                  ",
    "chapter": "118",
    "verse": "8",
    "text": "Bättre att ta sin tillflykt till (söka skydd hos) Herren (Jahve),"
  },
  {
    "id": 54546,
    "book": "psalms                                  ",
    "chapter": "118",
    "verse": "9",
    "text": "Bättre att ta sin tillflykt till (söka skydd hos) Herren (Jahve),"
  },
  {
    "id": 54547,
    "book": "psalms                                  ",
    "chapter": "118",
    "verse": "10",
    "text": "Alla nationer (hednafolk) omringar mig."
  },
  {
    "id": 54548,
    "book": "psalms                                  ",
    "chapter": "118",
    "verse": "11",
    "text": "De omringar mig, ja, de omringar mig"
  },
  {
    "id": 54549,
    "book": "psalms                                  ",
    "chapter": "118",
    "verse": "12",
    "text": "De omringar mig som bin, de slocknar som eld i törne"
  },
  {
    "id": 54550,
    "book": "psalms                                  ",
    "chapter": "118",
    "verse": "13",
    "text": "Ni [fientliga nationer] stöter (knuffar, tränger) mig aggressivt, för att få mig på fall,"
  },
  {
    "id": 54551,
    "book": "psalms                                  ",
    "chapter": "118",
    "verse": "14",
    "text": "Herren (Jah) är min styrka (starkhet) och min lovsång,"
  },
  {
    "id": 54552,
    "book": "psalms                                  ",
    "chapter": "118",
    "verse": "15",
    "text": "Segerjubel (glädjerop) och frälsningsglädje hörs i de rättfärdigas tält (deras boningar)."
  },
  {
    "id": 54553,
    "book": "psalms                                  ",
    "chapter": "118",
    "verse": "16",
    "text": "Herrens (Jahves) högra hand ger seger."
  },
  {
    "id": 54554,
    "book": "psalms                                  ",
    "chapter": "118",
    "verse": "17",
    "text": "Jag ska inte dö,"
  },
  {
    "id": 54555,
    "book": "psalms                                  ",
    "chapter": "118",
    "verse": "18",
    "text": "Herren (Jah) prövade mig hårt,"
  },
  {
    "id": 54556,
    "book": "psalms                                  ",
    "chapter": "118",
    "verse": "19",
    "text": "Öppna rättfärdighetens portar för mig [in till den sanna kungens tempel]."
  },
  {
    "id": 54557,
    "book": "psalms                                  ",
    "chapter": "118",
    "verse": "20",
    "text": "Detta är Herrens (Jahves) port,"
  },
  {
    "id": 54558,
    "book": "psalms                                  ",
    "chapter": "118",
    "verse": "21",
    "text": "Jag tackar (prisar med öppna händer, hyllar och erkänner) dig"
  },
  {
    "id": 54559,
    "book": "psalms                                  ",
    "chapter": "118",
    "verse": "22",
    "text": "Den sten som arbetarna förkastade (föraktade, inte ville veta av),"
  },
  {
    "id": 54560,
    "book": "psalms                                  ",
    "chapter": "118",
    "verse": "23",
    "text": "Detta är Herrens verk,"
  },
  {
    "id": 54561,
    "book": "psalms                                  ",
    "chapter": "118",
    "verse": "24",
    "text": "Detta är dagen som Herren (Jahve) har gjort (då han grep in),"
  },
  {
    "id": 54562,
    "book": "psalms                                  ",
    "chapter": "118",
    "verse": "25",
    "text": "Herre (Jahve), hosianna (fräls, befria, fortsätt att hjälpa oss),"
  },
  {
    "id": 54563,
    "book": "psalms                                  ",
    "chapter": "118",
    "verse": "26",
    "text": "Välsignad är han som kommer i Herrens (Jahves) namn (böj er inför honom)."
  },
  {
    "id": 54564,
    "book": "psalms                                  ",
    "chapter": "118",
    "verse": "27",
    "text": "Herren (Jahve) är Gud (El, den mäktige) och han har gett oss ljus"
  },
  {
    "id": 54565,
    "book": "psalms                                  ",
    "chapter": "118",
    "verse": "28",
    "text": "Du är min Gud (Elohim),"
  },
  {
    "id": 54566,
    "book": "psalms                                  ",
    "chapter": "118",
    "verse": "29",
    "text": "Tacka [med öppna händer – prisa, hylla och erkänn] Herren (Jahve) för han är god."
  }
]