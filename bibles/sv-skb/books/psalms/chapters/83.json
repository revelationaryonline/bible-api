[
  {
    "id": 53904,
    "book": "psalms                                  ",
    "chapter": "83",
    "verse": "1",
    "text": "En sång, en psalm (sång ackompanjerad på strängar). Av (för) Asaf."
  },
  {
    "id": 53905,
    "book": "psalms                                  ",
    "chapter": "83",
    "verse": "2",
    "text": "Gud (Elohim),"
  },
  {
    "id": 53906,
    "book": "psalms                                  ",
    "chapter": "83",
    "verse": "3",
    "text": "För se, dina fiender är i uppror"
  },
  {
    "id": 53907,
    "book": "psalms                                  ",
    "chapter": "83",
    "verse": "4",
    "text": "De håller listiga rådslag mot ditt folk,"
  },
  {
    "id": 53908,
    "book": "psalms                                  ",
    "chapter": "83",
    "verse": "5",
    "text": "De säger: ”Kom låt oss hugga av dem så att de inte längre är ett land,"
  },
  {
    "id": 53909,
    "book": "psalms                                  ",
    "chapter": "83",
    "verse": "6",
    "text": "De har överlagt tillsammans med allas samtycke,"
  },
  {
    "id": 53910,
    "book": "psalms                                  ",
    "chapter": "83",
    "verse": "7",
    "text": "Edoms tält [ättlingar till Jakobs halvbror Esau, fiender sydost om Döda havet]"
  },
  {
    "id": 53911,
    "book": "psalms                                  ",
    "chapter": "83",
    "verse": "8",
    "text": "Geval [troligtvis söder om Negev, nära Petra]"
  },
  {
    "id": 53912,
    "book": "psalms                                  ",
    "chapter": "83",
    "verse": "9",
    "text": "Assyrien [de mest brutala fienderna, folket i Mesopotamien] har också anslutit sig till dem,"
  },
  {
    "id": 53913,
    "book": "psalms                                  ",
    "chapter": "83",
    "verse": "10",
    "text": "Gör med dem som med Midjan [fiende, se Dom 6-7],"
  },
  {
    "id": 53914,
    "book": "psalms                                  ",
    "chapter": "83",
    "verse": "11",
    "text": "som förgjordes vid Ein-Dor [Jos 17:11; 1 Sam 28:7],"
  },
  {
    "id": 53915,
    "book": "psalms                                  ",
    "chapter": "83",
    "verse": "12",
    "text": "Gör deras ädlingar som [du gjorde mot midjanitiska furstar som Gideon stred mot]"
  },
  {
    "id": 53916,
    "book": "psalms                                  ",
    "chapter": "83",
    "verse": "13",
    "text": "De som sade: ”Låt oss ta Guds boning i besittning"
  },
  {
    "id": 53917,
    "book": "psalms                                  ",
    "chapter": "83",
    "verse": "14",
    "text": "Min Gud (Elohim), gör dem till virvlande damm,"
  },
  {
    "id": 53918,
    "book": "psalms                                  ",
    "chapter": "83",
    "verse": "15",
    "text": "Som elden bränner ner skogen,"
  },
  {
    "id": 53919,
    "book": "psalms                                  ",
    "chapter": "83",
    "verse": "16",
    "text": "jaga dem med ditt oväder,"
  },
  {
    "id": 53920,
    "book": "psalms                                  ",
    "chapter": "83",
    "verse": "17",
    "text": "Fyll deras ansikten med skam,"
  },
  {
    "id": 53921,
    "book": "psalms                                  ",
    "chapter": "83",
    "verse": "18",
    "text": "Låt dem skämmas och frukta (vara rädda) för alltid,"
  },
  {
    "id": 53922,
    "book": "psalms                                  ",
    "chapter": "83",
    "verse": "19",
    "text": "för att de ska veta att du ensam är den vars namn är Herren (Jahve),"
  }
]