[
  {
    "id": 53268,
    "book": "psalms                                  ",
    "chapter": "48",
    "verse": "1",
    "text": "En sång, en psalm (sång ackompanjerad på strängar) av (för) Korachs söner."
  },
  {
    "id": 53269,
    "book": "psalms                                  ",
    "chapter": "48",
    "verse": "2",
    "text": "Stor är Herren (Jahve) och högt är han prisad"
  },
  {
    "id": 53270,
    "book": "psalms                                  ",
    "chapter": "48",
    "verse": "3",
    "text": "är den vackraste höjden,"
  },
  {
    "id": 53271,
    "book": "psalms                                  ",
    "chapter": "48",
    "verse": "4",
    "text": "Gud (Elohim) bor i dess palats (borgar),"
  },
  {
    "id": 53272,
    "book": "psalms                                  ",
    "chapter": "48",
    "verse": "5",
    "text": "Se, när kungarna samlade sig,"
  },
  {
    "id": 53273,
    "book": "psalms                                  ",
    "chapter": "48",
    "verse": "6",
    "text": "De såg, de häpnade,"
  },
  {
    "id": 53274,
    "book": "psalms                                  ",
    "chapter": "48",
    "verse": "7",
    "text": "Bävan (fruktan) grep dem där,"
  },
  {
    "id": 53275,
    "book": "psalms                                  ",
    "chapter": "48",
    "verse": "8",
    "text": "[Ett skifte i psalmen markeras här genom att verbformen blir imperfekt, även en metafor med skepp introduceras. Psalmisten riktar sig också nu direkt till Gud i bön och tacksägelse:]"
  },
  {
    "id": 53276,
    "book": "psalms                                  ",
    "chapter": "48",
    "verse": "9",
    "text": "Det vi har hört, det fick vi se"
  },
  {
    "id": 53277,
    "book": "psalms                                  ",
    "chapter": "48",
    "verse": "10",
    "text": "Vi begrundar din nåd (omsorgsfulla kärlek), Gud (Elohim),"
  },
  {
    "id": 53278,
    "book": "psalms                                  ",
    "chapter": "48",
    "verse": "11",
    "text": "Liksom ditt namn, Gud (Elohim),"
  },
  {
    "id": 53279,
    "book": "psalms                                  ",
    "chapter": "48",
    "verse": "12",
    "text": "Låt Sions berg [tempelberget i Jerusalem] glädja sig."
  },
  {
    "id": 53280,
    "book": "psalms                                  ",
    "chapter": "48",
    "verse": "13",
    "text": "Tåga runt Sion [Jerusalem], vandra omkring det,"
  },
  {
    "id": 53281,
    "book": "psalms                                  ",
    "chapter": "48",
    "verse": "14",
    "text": "Lägg märke (sätt ditt hjärta) till dess murar (befästningar),"
  },
  {
    "id": 53282,
    "book": "psalms                                  ",
    "chapter": "48",
    "verse": "15",
    "text": "att sådan är Gud (Elohim)."
  }
]