[
  {
    "id": 54146,
    "book": "psalms                                  ",
    "chapter": "97",
    "verse": "1",
    "text": "Herren (Jahve) regerar (är kung)!"
  },
  {
    "id": 54147,
    "book": "psalms                                  ",
    "chapter": "97",
    "verse": "2",
    "text": "Moln och mörker är kring honom,"
  },
  {
    "id": 54148,
    "book": "psalms                                  ",
    "chapter": "97",
    "verse": "3",
    "text": "Eld går framför honom,"
  },
  {
    "id": 54149,
    "book": "psalms                                  ",
    "chapter": "97",
    "verse": "4",
    "text": "Hans blixtar lyser upp världen (den bebodda delen av jorden),"
  },
  {
    "id": 54150,
    "book": "psalms                                  ",
    "chapter": "97",
    "verse": "5",
    "text": "Bergen smälter som vax inför Herren (Jahve),"
  },
  {
    "id": 54151,
    "book": "psalms                                  ",
    "chapter": "97",
    "verse": "6",
    "text": "Himlarna förkunnar hans rättfärdighet,"
  },
  {
    "id": 54152,
    "book": "psalms                                  ",
    "chapter": "97",
    "verse": "7",
    "text": "Låt dem komma på skam, alla som tjänar bildstoder [statyer i trä eller sten, samma ord som i 2 Mos 20:4],"
  },
  {
    "id": 54153,
    "book": "psalms                                  ",
    "chapter": "97",
    "verse": "8",
    "text": "Sion hörde det och gladdes,"
  },
  {
    "id": 54154,
    "book": "psalms                                  ",
    "chapter": "97",
    "verse": "9",
    "text": "För du Herre (Jahve) är den Högste (Elion) över hela jorden,"
  },
  {
    "id": 54155,
    "book": "psalms                                  ",
    "chapter": "97",
    "verse": "10",
    "text": "Ni som älskar Herren (Jahve),"
  },
  {
    "id": 54156,
    "book": "psalms                                  ",
    "chapter": "97",
    "verse": "11",
    "text": "Ljus är sått för de rättfärdiga,"
  },
  {
    "id": 54157,
    "book": "psalms                                  ",
    "chapter": "97",
    "verse": "12",
    "text": "Gläd er i Herren (Jahve), ni rättfärdiga,"
  }
]