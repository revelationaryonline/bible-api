[
  {
    "id": 53528,
    "book": "psalms                                  ",
    "chapter": "66",
    "verse": "1",
    "text": "Till (för) ledaren. [Beskriver någon som utmärker sig – som är strålande och framstående inom sitt område. Syftar dels på föreståndaren för tempelmusiken men även på Messias ”den strålande morgonstjärnan”, se Upp 22:16 och inledningen till Psaltaren.]"
  },
  {
    "id": 53529,
    "book": "psalms                                  ",
    "chapter": "66",
    "verse": "2",
    "text": "lovsjung hans namns ära,"
  },
  {
    "id": 53530,
    "book": "psalms                                  ",
    "chapter": "66",
    "verse": "3",
    "text": "Säg till Gud: ”Hur underbara är inte dina gärningar,"
  },
  {
    "id": 53531,
    "book": "psalms                                  ",
    "chapter": "66",
    "verse": "4",
    "text": "Hela jorden böjer sig inför dig,"
  },
  {
    "id": 53532,
    "book": "psalms                                  ",
    "chapter": "66",
    "verse": "5",
    "text": "Kom och se vad Gud har gjort"
  },
  {
    "id": 53533,
    "book": "psalms                                  ",
    "chapter": "66",
    "verse": "6",
    "text": "Han förvandlade havet till torr mark [2 Mos 14-15],"
  },
  {
    "id": 53534,
    "book": "psalms                                  ",
    "chapter": "66",
    "verse": "7",
    "text": "han som genom sin makt härskar för evigt."
  },
  {
    "id": 53535,
    "book": "psalms                                  ",
    "chapter": "66",
    "verse": "8",
    "text": "Välsigna vår Gud, alla folk,"
  },
  {
    "id": 53536,
    "book": "psalms                                  ",
    "chapter": "66",
    "verse": "9",
    "text": "Han bevarar våra liv"
  },
  {
    "id": 53537,
    "book": "psalms                                  ",
    "chapter": "66",
    "verse": "10",
    "text": "För du prövade oss, Gud,"
  },
  {
    "id": 53538,
    "book": "psalms                                  ",
    "chapter": "66",
    "verse": "11",
    "text": "Du ledde oss in i nätet (fångenskap),"
  },
  {
    "id": 53539,
    "book": "psalms                                  ",
    "chapter": "66",
    "verse": "12",
    "text": "Du tillät människor rida fram över våra huvuden [trampa på oss, göra oss till fångar],"
  },
  {
    "id": 53540,
    "book": "psalms                                  ",
    "chapter": "66",
    "verse": "13",
    "text": "Jag kommer till ditt hus med brännoffer [3 Mos 1:1-17],"
  },
  {
    "id": 53541,
    "book": "psalms                                  ",
    "chapter": "66",
    "verse": "14",
    "text": "som mina läppar uttalade (öppnade hastigt och stort),"
  },
  {
    "id": 53542,
    "book": "psalms                                  ",
    "chapter": "66",
    "verse": "15",
    "text": "Som brännoffer vill jag offra feta får [det bästa jag har],"
  },
  {
    "id": 53543,
    "book": "psalms                                  ",
    "chapter": "66",
    "verse": "16",
    "text": "Kom och hör, och jag ska berätta, alla ni som fruktar (vördar) Gud (Elohim) [Ords 1:7],"
  },
  {
    "id": 53544,
    "book": "psalms                                  ",
    "chapter": "66",
    "verse": "17",
    "text": "Jag ropade (höjde min röst i bön) till honom med min mun,"
  },
  {
    "id": 53545,
    "book": "psalms                                  ",
    "chapter": "66",
    "verse": "18",
    "text": "Om jag hade sett någon synd i mitt hjärta,"
  },
  {
    "id": 53546,
    "book": "psalms                                  ",
    "chapter": "66",
    "verse": "19",
    "text": "Men Gud (Elohim) har hört mig,"
  },
  {
    "id": 53547,
    "book": "psalms                                  ",
    "chapter": "66",
    "verse": "20",
    "text": "Lovad (välsignad) är du Gud (Elohim),"
  }
]