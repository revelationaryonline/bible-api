[
  {
    "id": 52554,
    "book": "psalms                                  ",
    "chapter": "2",
    "verse": "1",
    "text": "Varför larmar hednafolken (planerar folkslagen/nationerna uppror)?"
  },
  {
    "id": 52555,
    "book": "psalms                                  ",
    "chapter": "2",
    "verse": "2",
    "text": "Jordens kungar reser sig"
  },
  {
    "id": 52556,
    "book": "psalms                                  ",
    "chapter": "2",
    "verse": "3",
    "text": "[De kungar som gör uppror mot Gud säger:]"
  },
  {
    "id": 52557,
    "book": "psalms                                  ",
    "chapter": "2",
    "verse": "4",
    "text": "[Guds respons:]"
  },
  {
    "id": 52558,
    "book": "psalms                                  ",
    "chapter": "2",
    "verse": "5",
    "text": "Sedan talar han till dem i sin vrede,"
  },
  {
    "id": 52559,
    "book": "psalms                                  ",
    "chapter": "2",
    "verse": "6",
    "text": "”Jag har insatt min Kung på Sion [Jerusalem],"
  },
  {
    "id": 52560,
    "book": "psalms                                  ",
    "chapter": "2",
    "verse": "7",
    "text": "[Kungen säger:]"
  },
  {
    "id": 52561,
    "book": "psalms                                  ",
    "chapter": "2",
    "verse": "8",
    "text": "Begär (fråga – hebr. shaal) av mig, och jag ska ge dig"
  },
  {
    "id": 52562,
    "book": "psalms                                  ",
    "chapter": "2",
    "verse": "9",
    "text": "Du ska krossa (valla) [regera över] dem med en järnspira (en käpp av järn) [ha all auktoritet, se Upp 2:27-28; 12:5; 19:15],"
  },
  {
    "id": 52563,
    "book": "psalms                                  ",
    "chapter": "2",
    "verse": "10",
    "text": "Så därför, ta ert förnuft till fånga nu, ni kungar,"
  },
  {
    "id": 52564,
    "book": "psalms                                  ",
    "chapter": "2",
    "verse": "11",
    "text": "Tjäna (lyd) Herren (Jahve) med fruktan (vördnadsfull tillbedjan),"
  },
  {
    "id": 52565,
    "book": "psalms                                  ",
    "chapter": "2",
    "verse": "12",
    "text": "Kyss Sonen [hylla, fall ned inför honom i vördnad och tillbedjan, låt Sonen regera],"
  }
]