[
  {
    "id": 53846,
    "book": "psalms                                  ",
    "chapter": "79",
    "verse": "1",
    "text": "En psalm (sång ackompanjerad på strängar). Av (för) Asaf."
  },
  {
    "id": 53847,
    "book": "psalms                                  ",
    "chapter": "79",
    "verse": "2",
    "text": "De gav dina tjänares slaktade kroppar till mat åt himmelens fåglar,"
  },
  {
    "id": 53848,
    "book": "psalms                                  ",
    "chapter": "79",
    "verse": "3",
    "text": "De har hällt ut deras blod som vatten"
  },
  {
    "id": 53849,
    "book": "psalms                                  ",
    "chapter": "79",
    "verse": "4",
    "text": "Vi har blivit till hån för våra grannar,"
  },
  {
    "id": 53850,
    "book": "psalms                                  ",
    "chapter": "79",
    "verse": "5",
    "text": "Hur länge, Herre (Jahve) ska du vara vred, arg på oss? För alltid?"
  },
  {
    "id": 53851,
    "book": "psalms                                  ",
    "chapter": "79",
    "verse": "6",
    "text": "Häll ut din vrede över länderna som inte känner dig;"
  },
  {
    "id": 53852,
    "book": "psalms                                  ",
    "chapter": "79",
    "verse": "7",
    "text": "För de har uppslukat Jakob"
  },
  {
    "id": 53853,
    "book": "psalms                                  ",
    "chapter": "79",
    "verse": "8",
    "text": "Håll inte våra fäders synder emot oss."
  },
  {
    "id": 53854,
    "book": "psalms                                  ",
    "chapter": "79",
    "verse": "9",
    "text": "Hjälp oss vår frälsnings Gud (Elohim)"
  },
  {
    "id": 53855,
    "book": "psalms                                  ",
    "chapter": "79",
    "verse": "10",
    "text": "Varför skulle hedningarna få säga:"
  },
  {
    "id": 53856,
    "book": "psalms                                  ",
    "chapter": "79",
    "verse": "11",
    "text": "Låt fångarnas stön komma till dig, nå dig."
  },
  {
    "id": 53857,
    "book": "psalms                                  ",
    "chapter": "79",
    "verse": "12",
    "text": "Betala tillbaka, ge igen sjufalt för deras förebråelser mitt bland våra grannar (i deras famn),"
  },
  {
    "id": 53858,
    "book": "psalms                                  ",
    "chapter": "79",
    "verse": "13",
    "text": "Vi är ditt folk och en fårhjord (flock av småboskap) på ditt bete,"
  }
]