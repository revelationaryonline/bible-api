[
  {
    "id": 52941,
    "book": "psalms                                  ",
    "chapter": "30",
    "verse": "1",
    "text": "En psalm, sång (text som ska sjungas) för (vid) husets (boningens, templets) invigning. Av (för) David."
  },
  {
    "id": 52942,
    "book": "psalms                                  ",
    "chapter": "30",
    "verse": "2",
    "text": "Jag vill upphöja dig, Herre (Jahve),"
  },
  {
    "id": 52943,
    "book": "psalms                                  ",
    "chapter": "30",
    "verse": "3",
    "text": "Herre (Jahve), min Gud (Elohim), jag skrek ut till dig (ropade efter din hjälp),"
  },
  {
    "id": 52944,
    "book": "psalms                                  ",
    "chapter": "30",
    "verse": "4",
    "text": "Herre (Jahve), du förde mig upp från Sheol (graven, underjorden – de dödas plats),"
  },
  {
    "id": 52945,
    "book": "psalms                                  ",
    "chapter": "30",
    "verse": "5",
    "text": "Lovsjung (sjung och spela till) Herren (Jahve), ni hans trogna följare,"
  },
  {
    "id": 52946,
    "book": "psalms                                  ",
    "chapter": "30",
    "verse": "6",
    "text": "Ett ögonblick varar hans vrede,"
  },
  {
    "id": 52947,
    "book": "psalms                                  ",
    "chapter": "30",
    "verse": "7",
    "text": "I min framgång (trygghet) sade jag (tänkte jag för mig själv):"
  },
  {
    "id": 52948,
    "book": "psalms                                  ",
    "chapter": "30",
    "verse": "8",
    "text": "Herre (Jahve), genom din nåd (favör, välvilja)"
  },
  {
    "id": 52949,
    "book": "psalms                                  ",
    "chapter": "30",
    "verse": "9",
    "text": "Till dig Herre (Jahve), ropade jag (höjde jag min röst i bön),"
  },
  {
    "id": 52950,
    "book": "psalms                                  ",
    "chapter": "30",
    "verse": "10",
    "text": "”Vad vinner du på mitt blod (min död),"
  },
  {
    "id": 52951,
    "book": "psalms                                  ",
    "chapter": "30",
    "verse": "11",
    "text": "Hör Herre (Jahve),"
  },
  {
    "id": 52952,
    "book": "psalms                                  ",
    "chapter": "30",
    "verse": "12",
    "text": "Du vände min klagan (ceremoniella sorgeperiod)"
  },
  {
    "id": 52953,
    "book": "psalms                                  ",
    "chapter": "30",
    "verse": "13",
    "text": "Därför ska hela min varelse (ordagrant: ”ära”; kan syfta på hjärta, människans innersta eller tungan)"
  }
]