[
  {
    "id": 53228,
    "book": "psalms                                  ",
    "chapter": "45",
    "verse": "1",
    "text": "Till (för) ledaren. [Beskriver någon som utmärker sig – som är strålande och framstående inom sitt område. Syftar dels på föreståndaren för tempelmusiken men även på Messias ”den strålande morgonstjärnan”, se Upp 22:16 och inledningen till Psaltaren.]"
  },
  {
    "id": 53229,
    "book": "psalms                                  ",
    "chapter": "45",
    "verse": "2",
    "text": "Mitt hjärta flödar (bubblar, fylls med inspiration) med ett gott ord;"
  },
  {
    "id": 53230,
    "book": "psalms                                  ",
    "chapter": "45",
    "verse": "3",
    "text": "Du är den mest stiliga bland människor (Adams barn),"
  },
  {
    "id": 53231,
    "book": "psalms                                  ",
    "chapter": "45",
    "verse": "4",
    "text": "Fäst ditt svärd vid din sida, du hjälte (mäktig krigare),"
  },
  {
    "id": 53232,
    "book": "psalms                                  ",
    "chapter": "45",
    "verse": "5",
    "text": "och träd fram i majestät!"
  },
  {
    "id": 53233,
    "book": "psalms                                  ",
    "chapter": "45",
    "verse": "6",
    "text": "Dina pilar är vassa – folken faller inför dina fötter –"
  },
  {
    "id": 53234,
    "book": "psalms                                  ",
    "chapter": "45",
    "verse": "7",
    "text": "Din tron, o Gud (Elohim), består för alltid och evigt."
  },
  {
    "id": 53235,
    "book": "psalms                                  ",
    "chapter": "45",
    "verse": "8",
    "text": "Du älskar (tillägnar dig, verkar aktivt för) rättfärdighet och hatar orättfärdighet."
  },
  {
    "id": 53236,
    "book": "psalms                                  ",
    "chapter": "45",
    "verse": "9",
    "text": "Dina kläder doftar [underbart] som myrra, aloe och kassia (kanel);"
  },
  {
    "id": 53237,
    "book": "psalms                                  ",
    "chapter": "45",
    "verse": "10",
    "text": "Kungadöttrar bland dina mest ärade kvinnor,"
  },
  {
    "id": 53238,
    "book": "psalms                                  ",
    "chapter": "45",
    "verse": "11",
    "text": "Lyssna, dotter, se och hör (böj ditt öra, lyssna uppmärksamt nu);"
  },
  {
    "id": 53239,
    "book": "psalms                                  ",
    "chapter": "45",
    "verse": "12",
    "text": "Låt kungen [den kommande Messias] längta efter din skönhet,"
  },
  {
    "id": 53240,
    "book": "psalms                                  ",
    "chapter": "45",
    "verse": "13",
    "text": "Dotter Tyros söker din favör (ditt ansikte) med en gåva,"
  },
  {
    "id": 53241,
    "book": "psalms                                  ",
    "chapter": "45",
    "verse": "14",
    "text": "dyrbara ägodelar (härlighet)."
  },
  {
    "id": 53242,
    "book": "psalms                                  ",
    "chapter": "45",
    "verse": "15",
    "text": "vackert broderad i många färger,"
  },
  {
    "id": 53243,
    "book": "psalms                                  ",
    "chapter": "45",
    "verse": "16",
    "text": "Under glädje och jubel leds de fram;"
  },
  {
    "id": 53244,
    "book": "psalms                                  ",
    "chapter": "45",
    "verse": "17",
    "text": "[Kungen tilltalas:]"
  },
  {
    "id": 53245,
    "book": "psalms                                  ",
    "chapter": "45",
    "verse": "18",
    "text": "Jag vill göra ditt namn ihågkommet i generation efter generation,"
  }
]