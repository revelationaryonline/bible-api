[
  {
    "id": 53967,
    "book": "psalms                                  ",
    "chapter": "87",
    "verse": "1",
    "text": "En psalm (sång ackompanjerad på strängar) av Korachs söner, en sång."
  },
  {
    "id": 53968,
    "book": "psalms                                  ",
    "chapter": "87",
    "verse": "2",
    "text": "Herren (Jahve) älskar Sions [Jerusalems] portar"
  },
  {
    "id": 53969,
    "book": "psalms                                  ",
    "chapter": "87",
    "verse": "3",
    "text": "Förunderliga, underbara och härliga ting är sagda (uttalade) om dig,"
  },
  {
    "id": 53970,
    "book": "psalms                                  ",
    "chapter": "87",
    "verse": "4",
    "text": "”Jag ska nämna Rahav [’den arrogante’; Egypten i väster, se Jes 30:7] och Babylon [i öster]"
  },
  {
    "id": 53971,
    "book": "psalms                                  ",
    "chapter": "87",
    "verse": "5",
    "text": "Men om Sion [tempelberget i Jerusalem] ska det bli sagt:"
  },
  {
    "id": 53972,
    "book": "psalms                                  ",
    "chapter": "87",
    "verse": "6",
    "text": "Herren (Jahve) ska räkna i folkets mantalslängder:"
  },
  {
    "id": 53973,
    "book": "psalms                                  ",
    "chapter": "87",
    "verse": "7",
    "text": "Under sång och dans"
  }
]