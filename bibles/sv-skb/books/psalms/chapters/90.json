[
  {
    "id": 54046,
    "book": "psalms                                  ",
    "chapter": "90",
    "verse": "2",
    "text": "Innan bergen föddes,"
  },
  {
    "id": 54047,
    "book": "psalms                                  ",
    "chapter": "90",
    "verse": "3",
    "text": "Du vände människan till ånger och sade:"
  },
  {
    "id": 54048,
    "book": "psalms                                  ",
    "chapter": "90",
    "verse": "4",
    "text": "För tusen år i dina ögon är som gårdagen som gick förbi,"
  },
  {
    "id": 54049,
    "book": "psalms                                  ",
    "chapter": "90",
    "verse": "5",
    "text": "Du sveper bort dem som med en flod, medan de sover."
  },
  {
    "id": 54050,
    "book": "psalms                                  ",
    "chapter": "90",
    "verse": "6",
    "text": "På morgonen blomstrar det och växer upp,"
  },
  {
    "id": 54051,
    "book": "psalms                                  ",
    "chapter": "90",
    "verse": "7",
    "text": "Vi är förtärda av din vrede,"
  },
  {
    "id": 54052,
    "book": "psalms                                  ",
    "chapter": "90",
    "verse": "8",
    "text": "Du har ställt våra överträdelser inför dig,"
  },
  {
    "id": 54053,
    "book": "psalms                                  ",
    "chapter": "90",
    "verse": "9",
    "text": "Alla våra dagar är borta i din vrede,"
  },
  {
    "id": 54054,
    "book": "psalms                                  ",
    "chapter": "90",
    "verse": "10",
    "text": "Våra år varar i 70 år,"
  },
  {
    "id": 54055,
    "book": "psalms                                  ",
    "chapter": "90",
    "verse": "11",
    "text": "Vem känner kraften i ditt raseri, och din vrede,"
  },
  {
    "id": 54056,
    "book": "psalms                                  ",
    "chapter": "90",
    "verse": "12",
    "text": "Lär oss antalet av våra dagar"
  },
  {
    "id": 54057,
    "book": "psalms                                  ",
    "chapter": "90",
    "verse": "13",
    "text": "Kom tillbaka Herre (Jahve), hur länge… [Meningen är inte fullständig, den avslutas inte. Det är en ”aposiopesis”, som förstärker att det blir en känsloladdad tystnad.]"
  },
  {
    "id": 54058,
    "book": "psalms                                  ",
    "chapter": "90",
    "verse": "14",
    "text": "Gör oss tillfredsställda (mätta oss) på morgonen med din nåd (omsorgsfulla kärlek),"
  },
  {
    "id": 54059,
    "book": "psalms                                  ",
    "chapter": "90",
    "verse": "15",
    "text": "Gör oss glada för alla de dagar som du har plågat oss,"
  },
  {
    "id": 54060,
    "book": "psalms                                  ",
    "chapter": "90",
    "verse": "16",
    "text": "Låt ditt verk (det du gör) bli synligt för dina tjänare,"
  },
  {
    "id": 54061,
    "book": "psalms                                  ",
    "chapter": "90",
    "verse": "17",
    "text": "Låt din nåd (ditt välbehag, din favör) Herre (Adonaj) vår Gud (Elohim) komma över oss."
  }
]