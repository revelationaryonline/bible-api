[
  {
    "id": 53859,
    "book": "psalms                                  ",
    "chapter": "80",
    "verse": "1",
    "text": "Till (för) ledaren. [Beskriver någon som utmärker sig – som är strålande och framstående inom sitt område. Syftar dels på föreståndaren för tempelmusiken men även på Messias ”den strålande morgonstjärnan”, se Upp 22:16 och inledningen till Psaltaren.]"
  },
  {
    "id": 53860,
    "book": "psalms                                  ",
    "chapter": "80",
    "verse": "2",
    "text": "Lyssna (vänd ditt öra – hör upp), o Israels herde,"
  },
  {
    "id": 53861,
    "book": "psalms                                  ",
    "chapter": "80",
    "verse": "3",
    "text": "Innan Efraim och Benjamin och Manasse [tre av de norra stammarna] väckte upp din makt"
  },
  {
    "id": 53862,
    "book": "psalms                                  ",
    "chapter": "80",
    "verse": "4",
    "text": "[Refräng]"
  },
  {
    "id": 53863,
    "book": "psalms                                  ",
    "chapter": "80",
    "verse": "5",
    "text": "Gud, Härskarornas Herre (Jahve Elohim Sebaot),"
  },
  {
    "id": 53864,
    "book": "psalms                                  ",
    "chapter": "80",
    "verse": "6",
    "text": "Du har mättat dem med tårarnas bröd"
  },
  {
    "id": 53865,
    "book": "psalms                                  ",
    "chapter": "80",
    "verse": "7",
    "text": "Du har gjort oss till ett stridsämne bland våra grannar"
  },
  {
    "id": 53866,
    "book": "psalms                                  ",
    "chapter": "80",
    "verse": "8",
    "text": "[Refräng:]"
  },
  {
    "id": 53867,
    "book": "psalms                                  ",
    "chapter": "80",
    "verse": "9",
    "text": "Du drog upp vinplantan, ut från Egypten."
  },
  {
    "id": 53868,
    "book": "psalms                                  ",
    "chapter": "80",
    "verse": "10",
    "text": "Du gjorde i ordning en plats för den [vinplantan, Israel]"
  },
  {
    "id": 53869,
    "book": "psalms                                  ",
    "chapter": "80",
    "verse": "11",
    "text": "Bergen täcktes av dess skugga"
  },
  {
    "id": 53870,
    "book": "psalms                                  ",
    "chapter": "80",
    "verse": "12",
    "text": "Hon skickade ut sina grenar till havet [Medelhavet]"
  },
  {
    "id": 53871,
    "book": "psalms                                  ",
    "chapter": "80",
    "verse": "13",
    "text": "Varför har du brutit ner hennes beskydd"
  },
  {
    "id": 53872,
    "book": "psalms                                  ",
    "chapter": "80",
    "verse": "14",
    "text": "Vildsvinet från skogen fördärvar den,"
  },
  {
    "id": 53873,
    "book": "psalms                                  ",
    "chapter": "80",
    "verse": "15",
    "text": "Härskarornas Herre (Elohim Sebaot), återvänd (kom hit igen) vi ber dig!"
  },
  {
    "id": 53874,
    "book": "psalms                                  ",
    "chapter": "80",
    "verse": "16",
    "text": "Och vinstocken som din högra hand planterade,"
  },
  {
    "id": 53875,
    "book": "psalms                                  ",
    "chapter": "80",
    "verse": "17",
    "text": "den är bränd i eld, den är nerhuggen,"
  },
  {
    "id": 53876,
    "book": "psalms                                  ",
    "chapter": "80",
    "verse": "18",
    "text": "Låt din hand vara över din högra hands människa,"
  },
  {
    "id": 53877,
    "book": "psalms                                  ",
    "chapter": "80",
    "verse": "19",
    "text": "Då ska vi inte vända oss bort ifrån dig."
  },
  {
    "id": 53878,
    "book": "psalms                                  ",
    "chapter": "80",
    "verse": "20",
    "text": "[Refräng]"
  }
]