[
  {
    "id": 54472,
    "book": "psalms                                  ",
    "chapter": "112",
    "verse": "1",
    "text": "Prisa Herren (lova Jah – hebr. hallelujah)!"
  },
  {
    "id": 54473,
    "book": "psalms                                  ",
    "chapter": "112",
    "verse": "2",
    "text": "Mäktiga (väldiga hjältar) ska hans barn bli på jorden,"
  },
  {
    "id": 54474,
    "book": "psalms                                  ",
    "chapter": "112",
    "verse": "3",
    "text": "Välstånd och rikedom finns i hans hus,"
  },
  {
    "id": 54475,
    "book": "psalms                                  ",
    "chapter": "112",
    "verse": "4",
    "text": "Ett ljus lyser (har gått upp) i mörkret för de med uppriktiga hjärtan (de rättsinniga; ordagrant ”rakhjärtade”),"
  },
  {
    "id": 54476,
    "book": "psalms                                  ",
    "chapter": "112",
    "verse": "5",
    "text": "Det går väl (är gott) för den som är generös och ger lån [5 Mos 15:9],"
  },
  {
    "id": 54477,
    "book": "psalms                                  ",
    "chapter": "112",
    "verse": "6",
    "text": "För han ska inte vackla,"
  },
  {
    "id": 54478,
    "book": "psalms                                  ",
    "chapter": "112",
    "verse": "7",
    "text": "Han fruktar inte ett ont budskap,"
  },
  {
    "id": 54479,
    "book": "psalms                                  ",
    "chapter": "112",
    "verse": "8",
    "text": "Lugnt (fast, stadigt) är hans hjärta, han är inte rädd,"
  },
  {
    "id": 54480,
    "book": "psalms                                  ",
    "chapter": "112",
    "verse": "9",
    "text": "Han strör ut, han ger åt de fattiga."
  },
  {
    "id": 54481,
    "book": "psalms                                  ",
    "chapter": "112",
    "verse": "10",
    "text": "Den ogudaktige ser det och är rasande,"
  }
]