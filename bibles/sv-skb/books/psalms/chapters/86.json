[
  {
    "id": 53950,
    "book": "psalms                                  ",
    "chapter": "86",
    "verse": "1",
    "text": "En bön av (för) David."
  },
  {
    "id": 53951,
    "book": "psalms                                  ",
    "chapter": "86",
    "verse": "2",
    "text": "Bevara min själ (mitt liv, hela min person),"
  },
  {
    "id": 53952,
    "book": "psalms                                  ",
    "chapter": "86",
    "verse": "3",
    "text": "Visa nåd (oförtjänt kärlek) mot mig Herre (Adonaj),"
  },
  {
    "id": 53953,
    "book": "psalms                                  ",
    "chapter": "86",
    "verse": "4",
    "text": "Din tjänares själ fröjdar sig (är glad),"
  },
  {
    "id": 53954,
    "book": "psalms                                  ",
    "chapter": "86",
    "verse": "5",
    "text": "För du Herre (Adonaj, fokus på Guds storhet och makt) är verkligen god och förlåtande,"
  },
  {
    "id": 53955,
    "book": "psalms                                  ",
    "chapter": "86",
    "verse": "6",
    "text": "Lyssna (vänd ditt öra) till min bön, Herre (Jahve),"
  },
  {
    "id": 53956,
    "book": "psalms                                  ",
    "chapter": "86",
    "verse": "7",
    "text": "På min nöds dag [då jag är trängd och möter svårigheter], ropar jag (åkallar, höjer jag min röst i bön) till dig,"
  },
  {
    "id": 53957,
    "book": "psalms                                  ",
    "chapter": "86",
    "verse": "8",
    "text": "Det finns ingen som kan jämföras med dig bland gudarna (elohim), Herre (Adonaj),"
  },
  {
    "id": 53958,
    "book": "psalms                                  ",
    "chapter": "86",
    "verse": "9",
    "text": "Alla hednafolk som du har gjort ska komma och tillbe (falla ner inför) dig, Herre (Adonaj),"
  },
  {
    "id": 53959,
    "book": "psalms                                  ",
    "chapter": "86",
    "verse": "10",
    "text": "För du är stor och gör stora under;"
  },
  {
    "id": 53960,
    "book": "psalms                                  ",
    "chapter": "86",
    "verse": "11",
    "text": "Visa mig din väg Herre (Jahve),"
  },
  {
    "id": 53961,
    "book": "psalms                                  ",
    "chapter": "86",
    "verse": "12",
    "text": "Jag vill tacka (med öppna händer prisa) dig Herre (Adonaj), min Gud (Elohim), av hela mitt hjärta,"
  },
  {
    "id": 53962,
    "book": "psalms                                  ",
    "chapter": "86",
    "verse": "13",
    "text": "För din nåd (omsorgsfulla kärlek) är stor mot mig"
  },
  {
    "id": 53963,
    "book": "psalms                                  ",
    "chapter": "86",
    "verse": "14",
    "text": "Gud (Elohim), de stolta har rest sig mot mig och skaran med onda män har letat efter min själ."
  },
  {
    "id": 53964,
    "book": "psalms                                  ",
    "chapter": "86",
    "verse": "15",
    "text": "Men du Herre (Adonaj) är en Gud (El) som är"
  },
  {
    "id": 53965,
    "book": "psalms                                  ",
    "chapter": "86",
    "verse": "16",
    "text": "Vänd dig till mig,"
  },
  {
    "id": 53966,
    "book": "psalms                                  ",
    "chapter": "86",
    "verse": "17",
    "text": "Visa mig ett tecken [Dom 6:17] på din godhet,"
  }
]