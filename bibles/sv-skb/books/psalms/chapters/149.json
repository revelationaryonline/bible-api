  {
    "id": 55061,
    "book": "psalms                                  ",
    "chapter": "149",
    "verse": "6",
    "text": "Guds fulla lovprisning ska vara i deras mun"
  },
  {
    "id": 55062,
    "book": "psalms                                  ",
    "chapter": "149",
    "verse": "7",
    "text": "För att verkställa hämnd över nationerna"
  },
  {
    "id": 55063,
    "book": "psalms                                  ",
    "chapter": "149",
    "verse": "8",
    "text": "För att binda kungar i kedjor"
  },
  {
    "id": 55064,
    "book": "psalms                                  ",
    "chapter": "149",
    "verse": "9",
    "text": "För att fullgöra domen som är skriven över dem."
  }
