    "chapter": "149",
    "verse": "1",
    "text": "Prisa Herren (lova Jah – hebr. hallelujah)!"
  },
  {
    "id": 55057,
    "book": "psalms                                  ",
    "chapter": "149",
    "verse": "2",
    "text": "Låt Israel fröjdas i sin skapare,"
  },
  {
    "id": 55058,
    "book": "psalms                                  ",
    "chapter": "149",
    "verse": "3",
    "text": "Låt dem prisa hans namn med dans,"
  },
  {
    "id": 55059,
    "book": "psalms                                  ",
    "chapter": "149",
    "verse": "4",
    "text": "För Herren (Jahve) har sin glädje i sitt folk."
  },
  {
    "id": 55060,
    "book": "psalms                                  ",
    "chapter": "149",
    "verse": "5",
    "text": "Låt de heliga jubla och triumfera i härlighet,"
