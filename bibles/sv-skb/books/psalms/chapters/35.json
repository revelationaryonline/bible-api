[
  {
    "id": 53035,
    "book": "psalms                                  ",
    "chapter": "35",
    "verse": "1",
    "text": "Av David."
  },
  {
    "id": 53036,
    "book": "psalms                                  ",
    "chapter": "35",
    "verse": "2",
    "text": "Tag upp din mindre [runda] sköld och din stora [rektangulära] stridssköld,"
  },
  {
    "id": 53037,
    "book": "psalms                                  ",
    "chapter": "35",
    "verse": "3",
    "text": "dra svärd och spjut,"
  },
  {
    "id": 53038,
    "book": "psalms                                  ",
    "chapter": "35",
    "verse": "4",
    "text": "Låt de som är ute efter mitt liv,"
  },
  {
    "id": 53039,
    "book": "psalms                                  ",
    "chapter": "35",
    "verse": "5",
    "text": "Låt dem bli som agnar för vinden,"
  },
  {
    "id": 53040,
    "book": "psalms                                  ",
    "chapter": "35",
    "verse": "6",
    "text": "Låt deras väg [när de flyr] bli mörk och hal,"
  },
  {
    "id": 53041,
    "book": "psalms                                  ",
    "chapter": "35",
    "verse": "7",
    "text": "Utan orsak har de dolt (gömt) en nät-grop (fallgrop täckt med ett nät) för mig,"
  },
  {
    "id": 53042,
    "book": "psalms                                  ",
    "chapter": "35",
    "verse": "8",
    "text": "Låt katastrofen komma över honom [som förföljer mig] plötsligt (utan att han vet om det),"
  },
  {
    "id": 53043,
    "book": "psalms                                  ",
    "chapter": "35",
    "verse": "9",
    "text": "Men jag (hela min inre varelse) ska jubla (dansa, fröjda sig) i Herren (Jahve),"
  },
  {
    "id": 53044,
    "book": "psalms                                  ",
    "chapter": "35",
    "verse": "10",
    "text": "Alla mina ben ska säga:"
  },
  {
    "id": 53045,
    "book": "psalms                                  ",
    "chapter": "35",
    "verse": "11",
    "text": "Laglösa (falska, våldsamma – hebr. chamas) vittnen träder fram,"
  },
  {
    "id": 53046,
    "book": "psalms                                  ",
    "chapter": "35",
    "verse": "12",
    "text": "De lönar gott med ont [Saul erkände att han behandlat David så, se 1 Sam 24:17],"
  },
  {
    "id": 53047,
    "book": "psalms                                  ",
    "chapter": "35",
    "verse": "13",
    "text": "När de var sjuka,"
  },
  {
    "id": 53048,
    "book": "psalms                                  ",
    "chapter": "35",
    "verse": "14",
    "text": "Jag agerade som om sorgen gällde min vän eller bror,"
  },
  {
    "id": 53049,
    "book": "psalms                                  ",
    "chapter": "35",
    "verse": "15",
    "text": "Men när jag stapplade, gladde de sig och samlades,"
  },
  {
    "id": 53050,
    "book": "psalms                                  ",
    "chapter": "35",
    "verse": "16",
    "text": "Som gudsfientliga gycklare vid fester,"
  },
  {
    "id": 53051,
    "book": "psalms                                  ",
    "chapter": "35",
    "verse": "17",
    "text": "Herre (Adonaj), hur länge ska det dröja innan du ser [och agerar]?"
  },
  {
    "id": 53052,
    "book": "psalms                                  ",
    "chapter": "35",
    "verse": "18",
    "text": "Jag ska tacka [med öppna händer – prisa, hylla och erkänna] dig i den stora församlingen [templet],"
  },
  {
    "id": 53053,
    "book": "psalms                                  ",
    "chapter": "35",
    "verse": "19",
    "text": "De ska inte glädja sig över mig, de som attackerar mig på falska grunder,"
  },
  {
    "id": 53054,
    "book": "psalms                                  ",
    "chapter": "35",
    "verse": "20",
    "text": "De talar inte frid (vänligt, fred, andras välgång – hebr. shalom),"
  },
  {
    "id": 53055,
    "book": "psalms                                  ",
    "chapter": "35",
    "verse": "21",
    "text": "De spärrar upp sina [fula] gap mot mig,"
  },
  {
    "id": 53056,
    "book": "psalms                                  ",
    "chapter": "35",
    "verse": "22",
    "text": "Du har sett allt [deras planer, allt hyckleri], Herre (Jahve) – var inte tyst;"
  },
  {
    "id": 53057,
    "book": "psalms                                  ",
    "chapter": "35",
    "verse": "23",
    "text": "Vakna, stå upp till mitt försvar,"
  },
  {
    "id": 53058,
    "book": "psalms                                  ",
    "chapter": "35",
    "verse": "24",
    "text": "Döm mig enligt din rättfärdighet, Herre (Jahve) min Gud (Elohim),"
  },
  {
    "id": 53059,
    "book": "psalms                                  ",
    "chapter": "35",
    "verse": "25",
    "text": "Låt dem inte tänka (säga i sina hjärtan):"
  },
  {
    "id": 53060,
    "book": "psalms                                  ",
    "chapter": "35",
    "verse": "26",
    "text": "Låt alla dem som gläder sig över min olycka,"
  },
  {
    "id": 53061,
    "book": "psalms                                  ",
    "chapter": "35",
    "verse": "27",
    "text": "Låt alla jubla (höja gälla triumferande jubelrop) och glädja sig,"
  },
  {
    "id": 53062,
    "book": "psalms                                  ",
    "chapter": "35",
    "verse": "28",
    "text": "Då ska min tunga berätta om (förkunna; begrunda – hebr. hagah) din rättfärdighet"
  }
]