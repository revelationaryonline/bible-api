    "chapter": "122",
    "verse": "1",
    "text": "En pilgrimssång (en vallfartsång; ”en sång från/för dem som vandrar upp”). [Oavsett varifrån man kommer så går man alltid upp till Jerusalem.]"
  },
  {
    "id": 54759,
    "book": "psalms                                  ",
    "chapter": "122",
    "verse": "2",
    "text": "Våra fötter står"
  },
  {
    "id": 54760,
    "book": "psalms                                  ",
    "chapter": "122",
    "verse": "3",
    "text": "Jerusalem, byggd som en stad"
  },
  {
    "id": 54761,
    "book": "psalms                                  ",
    "chapter": "122",
    "verse": "4",
    "text": "Dit stammarna går upp,"
  },
  {
    "id": 54762,
    "book": "psalms                                  ",
    "chapter": "122",
    "verse": "5",
    "text": "Där har troner satts fram för domarna,"
  },
  {
    "id": 54763,
    "book": "psalms                                  ",
    "chapter": "122",
    "verse": "6",
    "text": "Be för Jerusalems frid (shalom, välgång på alla områden);"
  },
  {
    "id": 54764,
    "book": "psalms                                  ",
    "chapter": "122",
    "verse": "7",
    "text": "Må frid (shalom, all slags välgång) råda inom innanför dina murar,"
  },
  {
    "id": 54765,
    "book": "psalms                                  ",
    "chapter": "122",
    "verse": "8",
    "text": "För mina bröders och vänners skull vill jag nu säga:"
  },
  {
    "id": 54766,
    "book": "psalms                                  ",
    "chapter": "122",
    "verse": "9",
    "text": "För Herrens (Jahves) hus skull, vår Gud (Elohim)"
  }
