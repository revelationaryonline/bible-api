[
  {
    "id": 53171,
    "book": "psalms                                  ",
    "chapter": "41",
    "verse": "1",
    "text": "Till (för) ledaren. [Beskriver någon som utmärker sig – som är strålande och framstående inom sitt område. Syftar dels på föreståndaren för tempelmusiken men även på Messias ”den strålande morgonstjärnan”, se Upp 22:16 och inledningen till Psaltaren.]"
  },
  {
    "id": 53172,
    "book": "psalms                                  ",
    "chapter": "41",
    "verse": "2",
    "text": "Välsignad är den som ser (reflekterar, agerar; på ett vist sätt hjälper) den fattige;"
  },
  {
    "id": 53173,
    "book": "psalms                                  ",
    "chapter": "41",
    "verse": "3",
    "text": "Herren ska bevara honom och upprätthålla (återge) hans liv,"
  },
  {
    "id": 53174,
    "book": "psalms                                  ",
    "chapter": "41",
    "verse": "4",
    "text": "Herren ska upprätthålla honom på sjukbädden;"
  },
  {
    "id": 53175,
    "book": "psalms                                  ",
    "chapter": "41",
    "verse": "5",
    "text": "[Vers 5-11 ramas in av bönen att Herren ska vara nådig.]"
  },
  {
    "id": 53176,
    "book": "psalms                                  ",
    "chapter": "41",
    "verse": "6",
    "text": "Mina fiender talar ont om mig:"
  },
  {
    "id": 53177,
    "book": "psalms                                  ",
    "chapter": "41",
    "verse": "7",
    "text": "Om han kommer på besök,"
  },
  {
    "id": 53178,
    "book": "psalms                                  ",
    "chapter": "41",
    "verse": "8",
    "text": "Tillsammans viskar (hebr. lehesh) alla mina ovänner om mig,"
  },
  {
    "id": 53179,
    "book": "psalms                                  ",
    "chapter": "41",
    "verse": "9",
    "text": "[De säger om mig:] ’Något ondskefullt (hebr. belial) har sköljts över honom,"
  },
  {
    "id": 53180,
    "book": "psalms                                  ",
    "chapter": "41",
    "verse": "10",
    "text": "Ja, min vän,"
  },
  {
    "id": 53181,
    "book": "psalms                                  ",
    "chapter": "41",
    "verse": "11",
    "text": "Men du, Herre (Jahve), visa nåd (ge mig favör; var välvillig),"
  },
  {
    "id": 53182,
    "book": "psalms                                  ",
    "chapter": "41",
    "verse": "12",
    "text": "Genom detta vet jag att du har behag till mig,"
  },
  {
    "id": 53183,
    "book": "psalms                                  ",
    "chapter": "41",
    "verse": "13",
    "text": "Du upprätthåller min integritet,"
  },
  {
    "id": 53184,
    "book": "psalms                                  ",
    "chapter": "41",
    "verse": "14",
    "text": "Prisad vare Herren (Jahve), Israels Gud,"
  }
]