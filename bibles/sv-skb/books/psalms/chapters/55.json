[
  {
    "id": 53375,
    "book": "psalms                                  ",
    "chapter": "55",
    "verse": "1",
    "text": "Till (för) ledaren. [Beskriver någon som utmärker sig – som är strålande och framstående inom sitt område. Syftar dels på föreståndaren för tempelmusiken men även på Messias ”den strålande morgonstjärnan”, se Upp 22:16 och inledningen till Psaltaren.]"
  },
  {
    "id": 53376,
    "book": "psalms                                  ",
    "chapter": "55",
    "verse": "2",
    "text": "Lyssna (vänd ditt öra), Gud (Elohim), till min bön"
  },
  {
    "id": 53377,
    "book": "psalms                                  ",
    "chapter": "55",
    "verse": "3",
    "text": "Ge akt (lyssna uppmärksamt) på mig, hör (svara) mig;"
  },
  {
    "id": 53378,
    "book": "psalms                                  ",
    "chapter": "55",
    "verse": "4",
    "text": "På grund av min fiendes röst (rop, oväsen),"
  },
  {
    "id": 53379,
    "book": "psalms                                  ",
    "chapter": "55",
    "verse": "5",
    "text": "Mitt hjärta vrider sig i mig"
  },
  {
    "id": 53380,
    "book": "psalms                                  ",
    "chapter": "55",
    "verse": "6",
    "text": "Fruktan och bävan (jordbävning, skakningar) har kommit över mig,"
  },
  {
    "id": 53381,
    "book": "psalms                                  ",
    "chapter": "55",
    "verse": "7",
    "text": "Och jag säger: O, att jag hade vingar som en duva,"
  },
  {
    "id": 53382,
    "book": "psalms                                  ",
    "chapter": "55",
    "verse": "8",
    "text": "Säkerligen skulle jag ta mig långt bort,"
  },
  {
    "id": 53383,
    "book": "psalms                                  ",
    "chapter": "55",
    "verse": "9",
    "text": "Jag skulle skynda till min tillflyktsort,"
  },
  {
    "id": 53384,
    "book": "psalms                                  ",
    "chapter": "55",
    "verse": "10",
    "text": "Herre (Adonaj) fördärva och dela deras tunga (förvirra och förbrylla deras tal) [1 Mos 11:1-9],"
  },
  {
    "id": 53385,
    "book": "psalms                                  ",
    "chapter": "55",
    "verse": "11",
    "text": "dag och natt"
  },
  {
    "id": 53386,
    "book": "psalms                                  ",
    "chapter": "55",
    "verse": "12",
    "text": "ondska och ruiner finns i hennes [stadens] mitt."
  },
  {
    "id": 53387,
    "book": "psalms                                  ",
    "chapter": "55",
    "verse": "13",
    "text": "Om en fiende hade hånat mig,"
  },
  {
    "id": 53388,
    "book": "psalms                                  ",
    "chapter": "55",
    "verse": "14",
    "text": "Men det är du, en man lik mig själv,"
  },
  {
    "id": 53389,
    "book": "psalms                                  ",
    "chapter": "55",
    "verse": "15",
    "text": "Vi hade en underbar gemenskap tillsammans,"
  },
  {
    "id": 53390,
    "book": "psalms                                  ",
    "chapter": "55",
    "verse": "16",
    "text": "Låt ödeläggelse komma över dem,"
  },
  {
    "id": 53391,
    "book": "psalms                                  ",
    "chapter": "55",
    "verse": "17",
    "text": "Jag vill ropa (höja min röst i bön) till Gud (Elohim)"
  },
  {
    "id": 53392,
    "book": "psalms                                  ",
    "chapter": "55",
    "verse": "18",
    "text": "Kväll och morgon och vid middagstid"
  },
  {
    "id": 53393,
    "book": "psalms                                  ",
    "chapter": "55",
    "verse": "19",
    "text": "Han har återlöst hela mig (min själ – hebr. nefesh) i frid (shalom, hel och väl)"
  },
  {
    "id": 53394,
    "book": "psalms                                  ",
    "chapter": "55",
    "verse": "20",
    "text": "Gud (El) ska höra och ödmjuka dem,"
  },
  {
    "id": 53395,
    "book": "psalms                                  ",
    "chapter": "55",
    "verse": "21",
    "text": "Min kompanjon sträcker fram sin hand mot dem som lever i fred med honom"
  },
  {
    "id": 53396,
    "book": "psalms                                  ",
    "chapter": "55",
    "verse": "22",
    "text": "Mjukare (halare) än smör var hans mun (tal),"
  },
  {
    "id": 53397,
    "book": "psalms                                  ",
    "chapter": "55",
    "verse": "23",
    "text": "Kasta det som är dig givet (din lott – hebr. jehav) på Herren (Jahve),"
  },
  {
    "id": 53398,
    "book": "psalms                                  ",
    "chapter": "55",
    "verse": "24",
    "text": "Men, du Gud (Elohim), ska störta (kommer att dra) ner dem"
  }
]