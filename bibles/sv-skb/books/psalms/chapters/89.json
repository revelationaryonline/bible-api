[
  {
    "id": 53993,
    "book": "psalms                                  ",
    "chapter": "89",
    "verse": "1",
    "text": "En sång med visdom [hebr. maskil, en musikalisk eller litterär term, kan även betyda ”en välskriven sång”]. Av esraiten Etan."
  },
  {
    "id": 53994,
    "book": "psalms                                  ",
    "chapter": "89",
    "verse": "2",
    "text": "Jag ska sjunga om Herrens (Jahves) nåd (omsorgsfulla kärlek) för evigt,"
  },
  {
    "id": 53995,
    "book": "psalms                                  ",
    "chapter": "89",
    "verse": "3",
    "text": "Jag har sagt: ”För evigt är nåden (den omsorgsfulla kärleken) skapad,"
  },
  {
    "id": 53996,
    "book": "psalms                                  ",
    "chapter": "89",
    "verse": "4",
    "text": "Jag har gjort (ingått) ett förbund med min utvalde,"
  },
  {
    "id": 53997,
    "book": "psalms                                  ",
    "chapter": "89",
    "verse": "5",
    "text": "För evigt ska jag låta din säd (dina avkomlingar, ättlingar) bestå,"
  },
  {
    "id": 53998,
    "book": "psalms                                  ",
    "chapter": "89",
    "verse": "6",
    "text": "Himlarna ska tacka [med öppna händer – prisa, hylla och erkänna] dina under (förunderliga gärningar, mirakler), o Herre (Jahve),"
  },
  {
    "id": 53999,
    "book": "psalms                                  ",
    "chapter": "89",
    "verse": "7",
    "text": "Vem i skyarna kan jämföras med Herren (Jahve),"
  },
  {
    "id": 54000,
    "book": "psalms                                  ",
    "chapter": "89",
    "verse": "8",
    "text": "En Gud (El) som är fruktad i de heligas stora rådsförsamling,"
  },
  {
    "id": 54001,
    "book": "psalms                                  ",
    "chapter": "89",
    "verse": "9",
    "text": "Gud, Härskarornas Herre (Jahve Elohim Sebaot),"
  },
  {
    "id": 54002,
    "book": "psalms                                  ",
    "chapter": "89",
    "verse": "10",
    "text": "Du regerar över havets stolta svall."
  },
  {
    "id": 54003,
    "book": "psalms                                  ",
    "chapter": "89",
    "verse": "11",
    "text": "Du krossade Rahav [den Stolte – Leviatan], som någon som är slaktad (dödligt sårad),"
  },
  {
    "id": 54004,
    "book": "psalms                                  ",
    "chapter": "89",
    "verse": "12",
    "text": "Dina är himlarna,"
  },
  {
    "id": 54005,
    "book": "psalms                                  ",
    "chapter": "89",
    "verse": "13",
    "text": "Du har skapat norr och söder,"
  },
  {
    "id": 54006,
    "book": "psalms                                  ",
    "chapter": "89",
    "verse": "14",
    "text": "Din arm har kraft,"
  },
  {
    "id": 54007,
    "book": "psalms                                  ",
    "chapter": "89",
    "verse": "15",
    "text": "Din tron vilar på (ditt konungsliga styre baseras på)"
  },
  {
    "id": 54008,
    "book": "psalms                                  ",
    "chapter": "89",
    "verse": "16",
    "text": "Välsignat (glatt, lyckligt) är det folk som prisar dig!"
  },
  {
    "id": 54009,
    "book": "psalms                                  ",
    "chapter": "89",
    "verse": "17",
    "text": "De gläder sig hela dagen lång i ditt namn,"
  },
  {
    "id": 54010,
    "book": "psalms                                  ",
    "chapter": "89",
    "verse": "18",
    "text": "För du ger dem ära och styrka,"
  },
  {
    "id": 54011,
    "book": "psalms                                  ",
    "chapter": "89",
    "verse": "19",
    "text": "För Herren (Jahve) är vår sköld,"
  },
  {
    "id": 54012,
    "book": "psalms                                  ",
    "chapter": "89",
    "verse": "20",
    "text": "[Vers 20-21 den första kiasmens centrum:]"
  },
  {
    "id": 54013,
    "book": "psalms                                  ",
    "chapter": "89",
    "verse": "21",
    "text": "Jag har funnit min tjänare David,"
  },
  {
    "id": 54014,
    "book": "psalms                                  ",
    "chapter": "89",
    "verse": "22",
    "text": "Min hand ska stödja (ständigt vara med) honom,"
  },
  {
    "id": 54015,
    "book": "psalms                                  ",
    "chapter": "89",
    "verse": "23",
    "text": "Ingen fiende"
  },
  {
    "id": 54016,
    "book": "psalms                                  ",
    "chapter": "89",
    "verse": "24",
    "text": "Nej, i stället ska jag krossa hans fiender framför honom"
  },
  {
    "id": 54017,
    "book": "psalms                                  ",
    "chapter": "89",
    "verse": "25",
    "text": "Min trofasthet (fasthet, stabilitet) och min nåd (kärleksfulla omsorg; trofasthet) ska vara med honom."
  },
  {
    "id": 54018,
    "book": "psalms                                  ",
    "chapter": "89",
    "verse": "26",
    "text": "Jag ska lägga havet under hans hand,"
  },
  {
    "id": 54019,
    "book": "psalms                                  ",
    "chapter": "89",
    "verse": "27",
    "text": "Han ska ropa (höja sin röst i bön) till mig:"
  },
  {
    "id": 54020,
    "book": "psalms                                  ",
    "chapter": "89",
    "verse": "28",
    "text": "Jag ska göra honom till den förstfödde [som har speciella privilegier],"
  },
  {
    "id": 54021,
    "book": "psalms                                  ",
    "chapter": "89",
    "verse": "29",
    "text": "Jag ska hålla fast min trofasta kärlek (nåd) mot honom för evigt,"
  },
  {
    "id": 54022,
    "book": "psalms                                  ",
    "chapter": "89",
    "verse": "30",
    "text": "Jag ska ge hans ätt evig dynasti (hans barn ska vara vid makten för evigt),"
  },
  {
    "id": 54023,
    "book": "psalms                                  ",
    "chapter": "89",
    "verse": "31",
    "text": "Om hans söner (barn) överger min undervisning (hebr. Torah)"
  },
  {
    "id": 54024,
    "book": "psalms                                  ",
    "chapter": "89",
    "verse": "32",
    "text": "om de vanhelgar mina påbud"
  },
  {
    "id": 54025,
    "book": "psalms                                  ",
    "chapter": "89",
    "verse": "33",
    "text": "då ska jag besöka (hämnas) deras överträdelser med min stav"
  },
  {
    "id": 54026,
    "book": "psalms                                  ",
    "chapter": "89",
    "verse": "34",
    "text": "Men min nåd (omsorgsfulla kärlek) ska jag inte ta bort (hugga av) från honom,"
  },
  {
    "id": 54027,
    "book": "psalms                                  ",
    "chapter": "89",
    "verse": "35",
    "text": "Mitt förbund ska jag inte vanhelga,"
  },
  {
    "id": 54028,
    "book": "psalms                                  ",
    "chapter": "89",
    "verse": "36",
    "text": "En gång har jag svurit (avlagt en ed) vid min helighet,"
  },
  {
    "id": 54029,
    "book": "psalms                                  ",
    "chapter": "89",
    "verse": "37",
    "text": "Hans säd (avkomma, ättlingar) ska finnas för evigt,"
  },
  {
    "id": 54030,
    "book": "psalms                                  ",
    "chapter": "89",
    "verse": "38",
    "text": "Den ska bestå för alltid precis som månen,"
  },
  {
    "id": 54031,
    "book": "psalms                                  ",
    "chapter": "89",
    "verse": "39",
    "text": "Men du har kastat bort och förskjutit,"
  },
  {
    "id": 54032,
    "book": "psalms                                  ",
    "chapter": "89",
    "verse": "40",
    "text": "Du har avskytt förbundet med din tjänare,"
  },
  {
    "id": 54033,
    "book": "psalms                                  ",
    "chapter": "89",
    "verse": "41",
    "text": "Du har brutit ner hans inhägnader,"
  },
  {
    "id": 54034,
    "book": "psalms                                  ",
    "chapter": "89",
    "verse": "42",
    "text": "Alla som går vägen förbi förstör honom,"
  },
  {
    "id": 54035,
    "book": "psalms                                  ",
    "chapter": "89",
    "verse": "43",
    "text": "Du har upphöjt hans motståndares högra hand [gjort hans motståndare starka],"
  },
  {
    "id": 54036,
    "book": "psalms                                  ",
    "chapter": "89",
    "verse": "44",
    "text": "Ja du vänder hans svärdsegg,"
  },
  {
    "id": 54037,
    "book": "psalms                                  ",
    "chapter": "89",
    "verse": "45",
    "text": "Du har låtit hans glans falna,"
  },
  {
    "id": 54038,
    "book": "psalms                                  ",
    "chapter": "89",
    "verse": "46",
    "text": "Hans ungdoms dagar har kortats (blivit färre),"
  },
  {
    "id": 54039,
    "book": "psalms                                  ",
    "chapter": "89",
    "verse": "47",
    "text": "Hur länge Herre (Jahve)?"
  },
  {
    "id": 54040,
    "book": "psalms                                  ",
    "chapter": "89",
    "verse": "48",
    "text": "Kom ihåg hur kort min tid är."
  },
  {
    "id": 54041,
    "book": "psalms                                  ",
    "chapter": "89",
    "verse": "49",
    "text": "Vilken stridsman (en man i sin bästa ålder) är han som lever och inte ska se döden,"
  },
  {
    "id": 54042,
    "book": "psalms                                  ",
    "chapter": "89",
    "verse": "50",
    "text": "Var är din tidigare nåd (omsorgsfulla kärlek) Herre (Adonaj),"
  },
  {
    "id": 54043,
    "book": "psalms                                  ",
    "chapter": "89",
    "verse": "51",
    "text": "Herre (Adonaj), kom ihåg hånet mot din tjänare,"
  },
  {
    "id": 54044,
    "book": "psalms                                  ",
    "chapter": "89",
    "verse": "52",
    "text": "Som dina fiender har hånat med Herre (Jahve),"
  },
  {
    "id": 54045,
    "book": "psalms                                  ",
    "chapter": "89",
    "verse": "53",
    "text": "Välsignad vare Herren (Jahve) för evigt!"
  }
]