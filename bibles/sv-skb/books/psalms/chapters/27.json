[
  {
    "id": 52907,
    "book": "psalms                                  ",
    "chapter": "27",
    "verse": "1",
    "text": "Av David."
  },
  {
    "id": 52908,
    "book": "psalms                                  ",
    "chapter": "27",
    "verse": "2",
    "text": "När onda människor kom mot mig,"
  },
  {
    "id": 52909,
    "book": "psalms                                  ",
    "chapter": "27",
    "verse": "3",
    "text": "Även om en armé skulle omringa (belägra) mig,"
  },
  {
    "id": 52910,
    "book": "psalms                                  ",
    "chapter": "27",
    "verse": "4",
    "text": "Ett [en sak] har jag begärt av Herren (Jahve),"
  },
  {
    "id": 52911,
    "book": "psalms                                  ",
    "chapter": "27",
    "verse": "5",
    "text": "För han skyddar (gömmer) mig i sin hydda (hebr. soch, i sitt sammanflätade och täckande skydd),"
  },
  {
    "id": 52912,
    "book": "psalms                                  ",
    "chapter": "27",
    "verse": "6",
    "text": "Och nu är mitt huvud upplyft [högt],"
  },
  {
    "id": 52913,
    "book": "psalms                                  ",
    "chapter": "27",
    "verse": "7",
    "text": "Hör min röst när jag ropar [i bön], Herre (Jahve)"
  },
  {
    "id": 52914,
    "book": "psalms                                  ",
    "chapter": "27",
    "verse": "8",
    "text": "Mitt hjärta säger om dig [hjärtat talar på Guds vägnar och uppmanar]:"
  },
  {
    "id": 52915,
    "book": "psalms                                  ",
    "chapter": "27",
    "verse": "9",
    "text": "dölj inte ditt ansikte för mig (ignorera mig inte)."
  },
  {
    "id": 52916,
    "book": "psalms                                  ",
    "chapter": "27",
    "verse": "10",
    "text": "Nej, även om min far och mor skulle överge mig,"
  },
  {
    "id": 52917,
    "book": "psalms                                  ",
    "chapter": "27",
    "verse": "11",
    "text": "Lär mig din väg, Herre (Jahve),"
  },
  {
    "id": 52918,
    "book": "psalms                                  ",
    "chapter": "27",
    "verse": "12",
    "text": "överlämna mig inte till mina fienders vilja."
  },
  {
    "id": 52919,
    "book": "psalms                                  ",
    "chapter": "27",
    "verse": "13",
    "text": "Hade jag inte trott (om jag inte varit viss om) att [jag skulle] få se Herrens (Jahves) godhet i de levandes land …"
  },
  {
    "id": 52920,
    "book": "psalms                                  ",
    "chapter": "27",
    "verse": "14",
    "text": "Vänta på (sätt ditt hopp till; bind dig samman med) Herren (Jahve)"
  }
]