[
  {
    "id": 53153,
    "book": "psalms                                  ",
    "chapter": "40",
    "verse": "1",
    "text": "Till (för) ledaren. [Beskriver någon som utmärker sig – som är strålande och framstående inom sitt område. Syftar dels på föreståndaren för tempelmusiken men även på Messias ”den strålande morgonstjärnan”, se Upp 22:16 och inledningen till Psaltaren.]"
  },
  {
    "id": 53154,
    "book": "psalms                                  ",
    "chapter": "40",
    "verse": "2",
    "text": "Jag väntade tålmodigt på (sökande sökte jag ivrigt efter) Herren (Jahve),"
  },
  {
    "id": 53155,
    "book": "psalms                                  ",
    "chapter": "40",
    "verse": "3",
    "text": "Han drog mig upp ur fördärvets (tumultets) grop (grav, cistern, brunn),"
  },
  {
    "id": 53156,
    "book": "psalms                                  ",
    "chapter": "40",
    "verse": "4",
    "text": "Han lade i min mun en ny sång,"
  },
  {
    "id": 53157,
    "book": "psalms                                  ",
    "chapter": "40",
    "verse": "5",
    "text": "Rikt välsignad (salig, mycket lycklig) är den stridsman (en man i sin bästa ålder)"
  },
  {
    "id": 53158,
    "book": "psalms                                  ",
    "chapter": "40",
    "verse": "6",
    "text": "Herre min Gud (Jahve Elohim),"
  },
  {
    "id": 53159,
    "book": "psalms                                  ",
    "chapter": "40",
    "verse": "7",
    "text": "Slaktoffer och matoffer kan inte tillfredsställa dig (det är inte vad du främst vill ha)."
  },
  {
    "id": 53160,
    "book": "psalms                                  ",
    "chapter": "40",
    "verse": "8",
    "text": "Därför säger jag:"
  },
  {
    "id": 53161,
    "book": "psalms                                  ",
    "chapter": "40",
    "verse": "9",
    "text": "Jag vill göra din vilja (behaga dig), min Gud."
  },
  {
    "id": 53162,
    "book": "psalms                                  ",
    "chapter": "40",
    "verse": "10",
    "text": "Jag har predikat de glada nyheterna om din rättfärdighet,"
  },
  {
    "id": 53163,
    "book": "psalms                                  ",
    "chapter": "40",
    "verse": "11",
    "text": "Jag har inte dolt din rättfärdighet i mitt hjärta,"
  },
  {
    "id": 53164,
    "book": "psalms                                  ",
    "chapter": "40",
    "verse": "12",
    "text": "Du, Herre (Jahve) kommer inte att hålla tillbaka"
  },
  {
    "id": 53165,
    "book": "psalms                                  ",
    "chapter": "40",
    "verse": "13",
    "text": "För ondska [plural] har omringat mig,"
  },
  {
    "id": 53166,
    "book": "psalms                                  ",
    "chapter": "40",
    "verse": "14",
    "text": "Visa välvilja (var nådig, ha välbehag i mig) [välkomna min bön]!"
  },
  {
    "id": 53167,
    "book": "psalms                                  ",
    "chapter": "40",
    "verse": "15",
    "text": "Må skam och förvirring drabba alla dem"
  },
  {
    "id": 53168,
    "book": "psalms                                  ",
    "chapter": "40",
    "verse": "16",
    "text": "Må de som ropar: ”Haha, haha” (driver med mig; hebr. heach heach – ett uttryck för skadeglädje),"
  },
  {
    "id": 53169,
    "book": "psalms                                  ",
    "chapter": "40",
    "verse": "17",
    "text": "Må alla som söker dig"
  },
  {
    "id": 53170,
    "book": "psalms                                  ",
    "chapter": "40",
    "verse": "18",
    "text": "Jag är betryckt (ansatt) och fattig [helt beroende av Gud, se Matt 5:3],"
  }
]