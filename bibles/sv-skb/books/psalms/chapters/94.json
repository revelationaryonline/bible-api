[
  {
    "id": 54099,
    "book": "psalms                                  ",
    "chapter": "94",
    "verse": "1",
    "text": "[Den grekiska översättningen Septuaginta har också med tillägget: ”En psalm av David, för veckans fjärde dag,” vilket är onsdag.]"
  },
  {
    "id": 54100,
    "book": "psalms                                  ",
    "chapter": "94",
    "verse": "2",
    "text": "Stå upp (lyft upp dig själv), du jordens domare,"
  },
  {
    "id": 54101,
    "book": "psalms                                  ",
    "chapter": "94",
    "verse": "3",
    "text": "Herre (Jahve), hur länge ska de onda..."
  },
  {
    "id": 54102,
    "book": "psalms                                  ",
    "chapter": "94",
    "verse": "4",
    "text": "De sprutar ur sig (okontrollerat, spyr ut) [en massa ord, se Ords 15:2], de talar arrogant (fräckt),"
  },
  {
    "id": 54103,
    "book": "psalms                                  ",
    "chapter": "94",
    "verse": "5",
    "text": "De krossar folket, Herre (Jahve)"
  },
  {
    "id": 54104,
    "book": "psalms                                  ",
    "chapter": "94",
    "verse": "6",
    "text": "De slår änkan och främlingen"
  },
  {
    "id": 54105,
    "book": "psalms                                  ",
    "chapter": "94",
    "verse": "7",
    "text": "De säger: ”Herren (Jah) ska inte se,"
  },
  {
    "id": 54106,
    "book": "psalms                                  ",
    "chapter": "94",
    "verse": "8",
    "text": "Tänk efter, ni brutala (råa, djuriska) bland människor."
  },
  {
    "id": 54107,
    "book": "psalms                                  ",
    "chapter": "94",
    "verse": "9",
    "text": "Han som formade örat,"
  },
  {
    "id": 54108,
    "book": "psalms                                  ",
    "chapter": "94",
    "verse": "10",
    "text": "Han som tuktar nationer,"
  },
  {
    "id": 54109,
    "book": "psalms                                  ",
    "chapter": "94",
    "verse": "11",
    "text": "Herren (Jahve) känner människans tankar,"
  },
  {
    "id": 54110,
    "book": "psalms                                  ",
    "chapter": "94",
    "verse": "12",
    "text": "Rikt välsignad (salig, mycket lycklig) är den stridsman (en man i sin bästa ålder)"
  },
  {
    "id": 54111,
    "book": "psalms                                  ",
    "chapter": "94",
    "verse": "13",
    "text": "så att du kan ge honom vila från de onda dagarna,"
  },
  {
    "id": 54112,
    "book": "psalms                                  ",
    "chapter": "94",
    "verse": "14",
    "text": "För Herren (Jahve) ska inte förkasta sitt folk,"
  },
  {
    "id": 54113,
    "book": "psalms                                  ",
    "chapter": "94",
    "verse": "15",
    "text": "Rätten ska återvända till domarna,"
  },
  {
    "id": 54114,
    "book": "psalms                                  ",
    "chapter": "94",
    "verse": "16",
    "text": "Vem ska stå upp för mig mot våldsverkarna?"
  },
  {
    "id": 54115,
    "book": "psalms                                  ",
    "chapter": "94",
    "verse": "17",
    "text": "Om inte Herren (Jahve) hade varit min hjälp,"
  },
  {
    "id": 54116,
    "book": "psalms                                  ",
    "chapter": "94",
    "verse": "18",
    "text": "Om jag säger [tänker inom mig]: ”Min fot vacklar”,"
  },
  {
    "id": 54117,
    "book": "psalms                                  ",
    "chapter": "94",
    "verse": "19",
    "text": "När mina oroliga tankar är många inom mig (när mitt inre är fullt av bekymmer),"
  },
  {
    "id": 54118,
    "book": "psalms                                  ",
    "chapter": "94",
    "verse": "20",
    "text": "Ska de ondas säten (domarstolar), som främjar ont uppsåt med sina lagar,"
  },
  {
    "id": 54119,
    "book": "psalms                                  ",
    "chapter": "94",
    "verse": "21",
    "text": "De samlar sig tillsammans mot den rättfärdige (hans själ, liv, person – hebr. nefesh)"
  },
  {
    "id": 54120,
    "book": "psalms                                  ",
    "chapter": "94",
    "verse": "22",
    "text": "Men Herren (Jahve) har varit mitt försvarstorn (värn; min fästning, säkra höjd),"
  },
  {
    "id": 54121,
    "book": "psalms                                  ",
    "chapter": "94",
    "verse": "23",
    "text": "Han har fört deras egna överträdelser över dem,"
  }
]