[
  {
    "id": 54424,
    "book": "psalms                                  ",
    "chapter": "109",
    "verse": "1",
    "text": "Till (för) ledaren. [Beskriver någon som utmärker sig – som är strålande och framstående inom sitt område. Syftar dels på föreståndaren för tempelmusiken men även på Messias ”den strålande morgonstjärnan”, se Upp 22:16 och inledningen till Psaltaren.]"
  },
  {
    "id": 54425,
    "book": "psalms                                  ",
    "chapter": "109",
    "verse": "2",
    "text": "De onda och bedrägliga har öppnat sin mun mot mig."
  },
  {
    "id": 54426,
    "book": "psalms                                  ",
    "chapter": "109",
    "verse": "3",
    "text": "De omringade mig med ord av hat"
  },
  {
    "id": 54427,
    "book": "psalms                                  ",
    "chapter": "109",
    "verse": "4",
    "text": "Som tack för min kärlek är de mina fiender,"
  },
  {
    "id": 54428,
    "book": "psalms                                  ",
    "chapter": "109",
    "verse": "5",
    "text": "De har gett mig ont för gott,"
  },
  {
    "id": 54429,
    "book": "psalms                                  ",
    "chapter": "109",
    "verse": "6",
    "text": "Må du sätta en ond man över honom"
  },
  {
    "id": 54430,
    "book": "psalms                                  ",
    "chapter": "109",
    "verse": "7",
    "text": "När han döms, låt honom gå i fördömelse"
  },
  {
    "id": 54431,
    "book": "psalms                                  ",
    "chapter": "109",
    "verse": "8",
    "text": "Låt hans dagar bli få,"
  },
  {
    "id": 54432,
    "book": "psalms                                  ",
    "chapter": "109",
    "verse": "9",
    "text": "Låt hans barn bli faderlösa,"
  },
  {
    "id": 54433,
    "book": "psalms                                  ",
    "chapter": "109",
    "verse": "10",
    "text": "Låt hans barn bli lösdrivare och tigga"
  },
  {
    "id": 54434,
    "book": "psalms                                  ",
    "chapter": "109",
    "verse": "11",
    "text": "Låt fordringsägarna ta allt som han haft"
  },
  {
    "id": 54435,
    "book": "psalms                                  ",
    "chapter": "109",
    "verse": "12",
    "text": "Låt det inte visas någon nåd (omsorgsfull kärlek) mot honom,"
  },
  {
    "id": 54436,
    "book": "psalms                                  ",
    "chapter": "109",
    "verse": "13",
    "text": "Låt hans eftermäle bli avhugget (inte finnas),"
  },
  {
    "id": 54437,
    "book": "psalms                                  ",
    "chapter": "109",
    "verse": "14",
    "text": "Låt hans fäders missgärningar bli ihågkommen inför Herren (Jahve)"
  },
  {
    "id": 54438,
    "book": "psalms                                  ",
    "chapter": "109",
    "verse": "15",
    "text": "låt dem vara inför Herren (Jahve) hela tiden (kontinuerligt)"
  },
  {
    "id": 54439,
    "book": "psalms                                  ",
    "chapter": "109",
    "verse": "16",
    "text": "Eftersom han inte kom ihåg att visa nåd (omsorgsfull kärlek)"
  },
  {
    "id": 54440,
    "book": "psalms                                  ",
    "chapter": "109",
    "verse": "17",
    "text": "Ja, han älskade förbannelse [att förbanna och kalla ner Guds straff på andra]"
  },
  {
    "id": 54441,
    "book": "psalms                                  ",
    "chapter": "109",
    "verse": "18",
    "text": "Han klädde sig själv i förbannelse som i en mantel,"
  },
  {
    "id": 54442,
    "book": "psalms                                  ",
    "chapter": "109",
    "verse": "19",
    "text": "Låt det bli för honom som manteln han tar på sig"
  },
  {
    "id": 54443,
    "book": "psalms                                  ",
    "chapter": "109",
    "verse": "20",
    "text": "Detta ska mina motståndare få erfara från Herren (Jahve),"
  },
  {
    "id": 54444,
    "book": "psalms                                  ",
    "chapter": "109",
    "verse": "21",
    "text": "Men du Herre Herre (Jahve Adonaj), handla med mig för ditt namns skull,"
  },
  {
    "id": 54445,
    "book": "psalms                                  ",
    "chapter": "109",
    "verse": "22",
    "text": "för jag är betryckt (ansatt) och fattig [helt beroende av dig Gud]"
  },
  {
    "id": 54446,
    "book": "psalms                                  ",
    "chapter": "109",
    "verse": "23",
    "text": "Jag är borta som en skugga när den förlängs,"
  },
  {
    "id": 54447,
    "book": "psalms                                  ",
    "chapter": "109",
    "verse": "24",
    "text": "Mina knän vacklar på grund av fasta,"
  },
  {
    "id": 54448,
    "book": "psalms                                  ",
    "chapter": "109",
    "verse": "25",
    "text": "Jag har blivit ett hån för dem,"
  },
  {
    "id": 54449,
    "book": "psalms                                  ",
    "chapter": "109",
    "verse": "26",
    "text": "Hjälp mig Herre min Gud (Jahve Elohim),"
  },
  {
    "id": 54450,
    "book": "psalms                                  ",
    "chapter": "109",
    "verse": "27",
    "text": "för att de ska veta att detta är din hand,"
  },
  {
    "id": 54451,
    "book": "psalms                                  ",
    "chapter": "109",
    "verse": "28",
    "text": "Låt dem förbanna (ta lätt på, lättviktigt, en mild förbannelse) men välsigna Du,"
  },
  {
    "id": 54452,
    "book": "psalms                                  ",
    "chapter": "109",
    "verse": "29",
    "text": "Mina motståndare ska bli klädda i förvirring"
  },
  {
    "id": 54453,
    "book": "psalms                                  ",
    "chapter": "109",
    "verse": "30",
    "text": "Jag ska storligen tacka [med öppna händer – prisa, hylla och erkänna] Herren (Jahve) med min mun,"
  },
  {
    "id": 54454,
    "book": "psalms                                  ",
    "chapter": "109",
    "verse": "31",
    "text": "för han står vid den behövandes högra hand (sida)"
  }
]