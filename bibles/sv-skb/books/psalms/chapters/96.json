[
  {
    "id": 54133,
    "book": "psalms                                  ",
    "chapter": "96",
    "verse": "1",
    "text": "[Stycket inleds med tre uppmaningar att sjunga.]"
  },
  {
    "id": 54134,
    "book": "psalms                                  ",
    "chapter": "96",
    "verse": "2",
    "text": "Sjung till Herren (Jahve), välsigna hans namn."
  },
  {
    "id": 54135,
    "book": "psalms                                  ",
    "chapter": "96",
    "verse": "3",
    "text": "Förkunna hans ära bland hednafolken,"
  },
  {
    "id": 54136,
    "book": "psalms                                  ",
    "chapter": "96",
    "verse": "4",
    "text": "För Herren (Jahve) är stor och högt är han prisad,"
  },
  {
    "id": 54137,
    "book": "psalms                                  ",
    "chapter": "96",
    "verse": "5",
    "text": "Folkets alla gudar (elohim) är avgudar,"
  },
  {
    "id": 54138,
    "book": "psalms                                  ",
    "chapter": "96",
    "verse": "6",
    "text": "Majestät och härlighet är inför hans ansikte,"
  },
  {
    "id": 54139,
    "book": "psalms                                  ",
    "chapter": "96",
    "verse": "7",
    "text": "[Stycket inleds med tre uppmaningar att ”ge till Herren”.]"
  },
  {
    "id": 54140,
    "book": "psalms                                  ",
    "chapter": "96",
    "verse": "8",
    "text": "Ge till Herren (Jahve), den ära som tillhör hans namn."
  },
  {
    "id": 54141,
    "book": "psalms                                  ",
    "chapter": "96",
    "verse": "9",
    "text": "Tillbe Herren (Jahve) i helig skrud,"
  },
  {
    "id": 54142,
    "book": "psalms                                  ",
    "chapter": "96",
    "verse": "10",
    "text": "Säg bland hednafolken: ”Herren (Jahve) regerar (är kung),"
  },
  {
    "id": 54143,
    "book": "psalms                                  ",
    "chapter": "96",
    "verse": "11",
    "text": "[Tre uppmaningar till himlen, havet och marken:]"
  },
  {
    "id": 54144,
    "book": "psalms                                  ",
    "chapter": "96",
    "verse": "12",
    "text": "Må marken vara glad, tillsammans med allt på den."
  },
  {
    "id": 54145,
    "book": "psalms                                  ",
    "chapter": "96",
    "verse": "13",
    "text": "inför Herren, för han kommer,"
  }
]