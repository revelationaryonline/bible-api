[
  {
    "id": 52979,
    "book": "psalms                                  ",
    "chapter": "32",
    "verse": "1",
    "text": "Av David, en sång med visdom (hebr. maskil)."
  },
  {
    "id": 52980,
    "book": "psalms                                  ",
    "chapter": "32",
    "verse": "2",
    "text": "Rikt välsignad (salig, mycket lycklig) är den människa"
  },
  {
    "id": 52981,
    "book": "psalms                                  ",
    "chapter": "32",
    "verse": "3",
    "text": "När jag var tyst [och vägrade att bekänna min rebelliskhet, inre skuld, synd och mina onda tankar]"
  },
  {
    "id": 52982,
    "book": "psalms                                  ",
    "chapter": "32",
    "verse": "4",
    "text": "För dag och natt"
  },
  {
    "id": 52983,
    "book": "psalms                                  ",
    "chapter": "32",
    "verse": "5",
    "text": "Då bekände jag (lät jag dig veta – bli intimt förtrogen med) min synd"
  },
  {
    "id": 52984,
    "book": "psalms                                  ",
    "chapter": "32",
    "verse": "6",
    "text": "Därför ska alla (varenda en av) dina trogna (fromma, lojala) följare vädja (be) till dig,"
  },
  {
    "id": 52985,
    "book": "psalms                                  ",
    "chapter": "32",
    "verse": "7",
    "text": "Du är mitt skydd (gömställe),"
  },
  {
    "id": 52986,
    "book": "psalms                                  ",
    "chapter": "32",
    "verse": "8",
    "text": "Jag vill [varsamt och medvetet] vägleda dig (lära/instruera dig; ge dig insikt) och undervisa dig"
  },
  {
    "id": 52987,
    "book": "psalms                                  ",
    "chapter": "32",
    "verse": "9",
    "text": "Var inte som en häst eller mula"
  },
  {
    "id": 52988,
    "book": "psalms                                  ",
    "chapter": "32",
    "verse": "10",
    "text": "Många är sorgerna (smärtorna; alla de själsliga bedrövelserna) som drabbar de gudlösa (ogudaktiga, ondskefulla),"
  },
  {
    "id": 52989,
    "book": "psalms                                  ",
    "chapter": "32",
    "verse": "11",
    "text": "Var glada i Herren (Jahve),"
  }
]