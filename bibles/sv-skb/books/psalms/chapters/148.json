[
  {
    "id": 55042,
    "book": "psalms                                  ",
    "chapter": "148",
    "verse": "1",
    "text": "Prisa Herren (lova Jah – hebr. hallelujah)!"
  },
  {
    "id": 55043,
    "book": "psalms                                  ",
    "chapter": "148",
    "verse": "2",
    "text": "Prisa honom alla ni änglar (budbärare),"
  },
  {
    "id": 55044,
    "book": "psalms                                  ",
    "chapter": "148",
    "verse": "3",
    "text": "Prisa honom, sol och måne,"
  },
  {
    "id": 55045,
    "book": "psalms                                  ",
    "chapter": "148",
    "verse": "4",
    "text": "Prisa honom, ni himlars himlar,"
  },
  {
    "id": 55046,
    "book": "psalms                                  ",
    "chapter": "148",
    "verse": "5",
    "text": "Låt dem [alla sju instanser i himlarna som nämnts i vers 2-4] prisa Herrens (Jahves) namn,"
  },
  {
    "id": 55047,
    "book": "psalms                                  ",
    "chapter": "148",
    "verse": "6",
    "text": "Han gav dem deras plats (ordagrant ”gjorde så de stod”) för alltid och evigt,"
  },
  {
    "id": 55048,
    "book": "psalms                                  ",
    "chapter": "148",
    "verse": "7",
    "text": "Prisa Herren (Jahve) från jorden:"
  },
  {
    "id": 55049,
    "book": "psalms                                  ",
    "chapter": "148",
    "verse": "8",
    "text": "[Atmosfären:]"
  },
  {
    "id": 55050,
    "book": "psalms                                  ",
    "chapter": "148",
    "verse": "9",
    "text": "[Landskapet:]"
  },
  {
    "id": 55051,
    "book": "psalms                                  ",
    "chapter": "148",
    "verse": "10",
    "text": "[Djuren:]"
  },
  {
    "id": 55052,
    "book": "psalms                                  ",
    "chapter": "148",
    "verse": "11",
    "text": "[Människor i ledande positioner:]"
  },
  {
    "id": 55053,
    "book": "psalms                                  ",
    "chapter": "148",
    "verse": "12",
    "text": "[Alla människor:]"
  },
  {
    "id": 55054,
    "book": "psalms                                  ",
    "chapter": "148",
    "verse": "13",
    "text": "Låt dem [alla 7 grupper, 23 instanser, på jorden som nämnts i vers 7-12] prisa Herrens (Jahves) namn,"
  },
  {
    "id": 55055,
    "book": "psalms                                  ",
    "chapter": "148",
    "verse": "14",
    "text": "Han har lyft upp ett horn för sitt folk (gett dem makt och framgång),"
  }
]