[
  {
    "id": 52720,
    "book": "psalms                                  ",
    "chapter": "17",
    "verse": "1",
    "text": "En bön (vädjan, förbön – hebr. tefillah). Av David."
  },
  {
    "id": 52721,
    "book": "psalms                                  ",
    "chapter": "17",
    "verse": "2",
    "text": "Låt domen (ditt beslut i mitt rättsfall) komma från din närhet (ditt ansikte),"
  },
  {
    "id": 52722,
    "book": "psalms                                  ",
    "chapter": "17",
    "verse": "3",
    "text": "Du har prövat mitt hjärta (mina inre motiv),"
  },
  {
    "id": 52723,
    "book": "psalms                                  ",
    "chapter": "17",
    "verse": "4",
    "text": "Vad det gäller människors handlingar [vad de onda sysselsätter sig med, hur de lever sina liv],"
  },
  {
    "id": 52724,
    "book": "psalms                                  ",
    "chapter": "17",
    "verse": "5",
    "text": "Mina steg går stadigt på dina vägar (spår, välkända leder – jag har följt dina instruktioner; levt mitt liv efter ditt Ord),"
  },
  {
    "id": 52725,
    "book": "psalms                                  ",
    "chapter": "17",
    "verse": "6",
    "text": "Jag ropar [höjer min röst i bön] till dig,"
  },
  {
    "id": 52726,
    "book": "psalms                                  ",
    "chapter": "17",
    "verse": "7",
    "text": "Visa mig en särskild (extra mycket) nåd (omsorgsfull kärlek – hebr. chesed)"
  },
  {
    "id": 52727,
    "book": "psalms                                  ",
    "chapter": "17",
    "verse": "8",
    "text": "Beskydda (försvara, bevara, vårda) mig [reflexmässigt]"
  },
  {
    "id": 52728,
    "book": "psalms                                  ",
    "chapter": "17",
    "verse": "9",
    "text": "[beskydda/göm mig] från de gudlösa (ogudaktiga, ondskefulla) som vill förgöra mig,"
  },
  {
    "id": 52729,
    "book": "psalms                                  ",
    "chapter": "17",
    "verse": "10",
    "text": "Helt omslutna i sin fetma (förhärdade, känslokalla),"
  },
  {
    "id": 52730,
    "book": "psalms                                  ",
    "chapter": "17",
    "verse": "11",
    "text": "De har följt våra steg, de omringar oss,"
  },
  {
    "id": 52731,
    "book": "psalms                                  ",
    "chapter": "17",
    "verse": "12",
    "text": "Han kan liknas vid ett lejon som längtar att riva [sitt byte],"
  },
  {
    "id": 52732,
    "book": "psalms                                  ",
    "chapter": "17",
    "verse": "13",
    "text": "Stå upp, Herre (Jahve)!"
  },
  {
    "id": 52733,
    "book": "psalms                                  ",
    "chapter": "17",
    "verse": "14",
    "text": "Rädda mig från människor genom din hand (mäktiga kraft),"
  },
  {
    "id": 52734,
    "book": "psalms                                  ",
    "chapter": "17",
    "verse": "15",
    "text": "Jag för min del, i rättfärdighet [till skillnad från de orättfärdigt rika]"
  }
]