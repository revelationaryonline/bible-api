[
  {
    "id": 54801,
    "book": "psalms                                  ",
    "chapter": "129",
    "verse": "1",
    "text": "En pilgrimssång (en vallfartsång; ”en sång från/för dem som vandrar upp”). [Oavsett varifrån man kommer så går man alltid upp till Jerusalem.]"
  },
  {
    "id": 54802,
    "book": "psalms                                  ",
    "chapter": "129",
    "verse": "2",
    "text": "Hur mycket, hur ofta (många gånger) har de varit fientliga mot mig ända från min ungdom,"
  },
  {
    "id": 54803,
    "book": "psalms                                  ",
    "chapter": "129",
    "verse": "3",
    "text": "Drängar har plöjt min rygg,"
  },
  {
    "id": 54804,
    "book": "psalms                                  ",
    "chapter": "129",
    "verse": "4",
    "text": "Herren (Jahve) är rättfärdig,"
  },
  {
    "id": 54805,
    "book": "psalms                                  ",
    "chapter": "129",
    "verse": "5",
    "text": "Må alla som hatar Sion [tempelberget i Jerusalem]"
  },
  {
    "id": 54806,
    "book": "psalms                                  ",
    "chapter": "129",
    "verse": "6",
    "text": "Låt dem bli som gräs på taken"
  },
  {
    "id": 54807,
    "book": "psalms                                  ",
    "chapter": "129",
    "verse": "7",
    "text": "en skördeman kan inte fylla sin hand med det,"
  },
  {
    "id": 54808,
    "book": "psalms                                  ",
    "chapter": "129",
    "verse": "8",
    "text": "Låt aldrig dem som råkar gå förbi kunna säga:"
  }
