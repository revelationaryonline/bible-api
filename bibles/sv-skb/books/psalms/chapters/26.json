[
  {
    "id": 52895,
    "book": "psalms                                  ",
    "chapter": "26",
    "verse": "1",
    "text": "Av David. [På samma sätt som Psalm 25, inleds även denna psalm med bara Davids namn.]"
  },
  {
    "id": 52896,
    "book": "psalms                                  ",
    "chapter": "26",
    "verse": "2",
    "text": "Granska mig, Herre (Jahve),"
  },
  {
    "id": 52897,
    "book": "psalms                                  ",
    "chapter": "26",
    "verse": "3",
    "text": "För jag har din nåd (kärleksfulla omsorg; trofasthet) inför mina ögon,"
  },
  {
    "id": 52898,
    "book": "psalms                                  ",
    "chapter": "26",
    "verse": "4",
    "text": "Jag sitter inte med (slösar inte bort min tid, associerar mig inte med) lögnens män (de som ägnar sig åt tomhet, falskhet)"
  },
  {
    "id": 52899,
    "book": "psalms                                  ",
    "chapter": "26",
    "verse": "5",
    "text": "Jag avskyr de ondas församling,"
  },
  {
    "id": 52900,
    "book": "psalms                                  ",
    "chapter": "26",
    "verse": "6",
    "text": "Jag tvättar mina händer i oskuld (för att visa att jag är oskyldig),"
  },
  {
    "id": 52901,
    "book": "psalms                                  ",
    "chapter": "26",
    "verse": "7",
    "text": "för att låta tacksägelsen ljuda,"
  },
  {
    "id": 52902,
    "book": "psalms                                  ",
    "chapter": "26",
    "verse": "8",
    "text": "Herre (Jahve), jag älskar din boning,"
  },
  {
    "id": 52903,
    "book": "psalms                                  ",
    "chapter": "26",
    "verse": "9",
    "text": "Ta inte bort mig (ryck inte bort mitt liv) med syndare,"
  },
  {
    "id": 52904,
    "book": "psalms                                  ",
    "chapter": "26",
    "verse": "10",
    "text": "människor med onda planer i sina händer,"
  },
  {
    "id": 52905,
    "book": "psalms                                  ",
    "chapter": "26",
    "verse": "11",
    "text": "Men jag, jag vandrar (lever) i min integritet,"
  },
  {
    "id": 52906,
    "book": "psalms                                  ",
    "chapter": "26",
    "verse": "12",
    "text": "Min fot står"
  }
]