[
  {
    "id": 54240,
    "book": "psalms                                  ",
    "chapter": "104",
    "verse": "1",
    "text": "Välsigna (prisa; böj dig ner inför) Herren (Jahve)"
  },
  {
    "id": 54241,
    "book": "psalms                                  ",
    "chapter": "104",
    "verse": "2",
    "text": "Du sveper dig i ljus som en klädnad,"
  },
  {
    "id": 54242,
    "book": "psalms                                  ",
    "chapter": "104",
    "verse": "3",
    "text": "och har lagt (konstruerat, timrat) balkarna till dina övre rum [tronsalar] ovan skyn (vattnen)."
  },
  {
    "id": 54243,
    "book": "psalms                                  ",
    "chapter": "104",
    "verse": "4",
    "text": "Du gör vindar till dina sändebud,"
  },
  {
    "id": 54244,
    "book": "psalms                                  ",
    "chapter": "104",
    "verse": "5",
    "text": "Du grundade jorden på dess fästen,"
  },
  {
    "id": 54245,
    "book": "psalms                                  ",
    "chapter": "104",
    "verse": "6",
    "text": "Du täckte den med djupet som en klädnad,"
  },
  {
    "id": 54246,
    "book": "psalms                                  ",
    "chapter": "104",
    "verse": "7",
    "text": "På ditt kommando flydde de,"
  },
  {
    "id": 54247,
    "book": "psalms                                  ",
    "chapter": "104",
    "verse": "8",
    "text": "De gick över bergen,"
  },
  {
    "id": 54248,
    "book": "psalms                                  ",
    "chapter": "104",
    "verse": "9",
    "text": "Du har satt en gräns som vattnen inte får gå över,"
  },
  {
    "id": 54249,
    "book": "psalms                                  ",
    "chapter": "104",
    "verse": "10",
    "text": "Du förvandlar källor till flöden,"
  },
  {
    "id": 54250,
    "book": "psalms                                  ",
    "chapter": "104",
    "verse": "11",
    "text": "De vattnar alla markens djur,"
  },
  {
    "id": 54251,
    "book": "psalms                                  ",
    "chapter": "104",
    "verse": "12",
    "text": "Vid dem har himlens fåglar sina bon,"
  },
  {
    "id": 54252,
    "book": "psalms                                  ",
    "chapter": "104",
    "verse": "13",
    "text": "Du vattnar bergen från dina salar,"
  },
  {
    "id": 54253,
    "book": "psalms                                  ",
    "chapter": "104",
    "verse": "14",
    "text": "Du låter gräs växa för boskapen,"
  },
  {
    "id": 54254,
    "book": "psalms                                  ",
    "chapter": "104",
    "verse": "15",
    "text": "och vin som gör människan glad,"
  },
  {
    "id": 54255,
    "book": "psalms                                  ",
    "chapter": "104",
    "verse": "16",
    "text": "Herrens (Jahves) träd har sin mättnad (tillfredsställelse, all näring som de behöver med råge),"
  },
  {
    "id": 54256,
    "book": "psalms                                  ",
    "chapter": "104",
    "verse": "17",
    "text": "Där bygger fåglarna sina bon,"
  },
  {
    "id": 54257,
    "book": "psalms                                  ",
    "chapter": "104",
    "verse": "18",
    "text": "De höga bergen är [ett hem] för stengetterna [Job 39:4-7],"
  },
  {
    "id": 54258,
    "book": "psalms                                  ",
    "chapter": "104",
    "verse": "19",
    "text": "Månen visar de bestämda tiderna [1 Mos 1:14-15],"
  },
  {
    "id": 54259,
    "book": "psalms                                  ",
    "chapter": "104",
    "verse": "20",
    "text": "Du har gjort mörkret och det är natt,"
  },
  {
    "id": 54260,
    "book": "psalms                                  ",
    "chapter": "104",
    "verse": "21",
    "text": "De unga lejonen ryter efter byte,"
  },
  {
    "id": 54261,
    "book": "psalms                                  ",
    "chapter": "104",
    "verse": "22",
    "text": "Solen går upp och de gömmer sig,"
  },
  {
    "id": 54262,
    "book": "psalms                                  ",
    "chapter": "104",
    "verse": "23",
    "text": "Människan kommer ut till sina sysslor"
  },
  {
    "id": 54263,
    "book": "psalms                                  ",
    "chapter": "104",
    "verse": "24",
    "text": "Hur mångfaldiga är dina verk, Herre (Jahve),"
  },
  {
    "id": 54264,
    "book": "psalms                                  ",
    "chapter": "104",
    "verse": "25",
    "text": "Där borta är havet, stort och brett (vidsträckt),"
  },
  {
    "id": 54265,
    "book": "psalms                                  ",
    "chapter": "104",
    "verse": "26",
    "text": "Där går skeppen, där är Leviatan"
  },
  {
    "id": 54266,
    "book": "psalms                                  ",
    "chapter": "104",
    "verse": "27",
    "text": "Alla dessa [allt levande som Gud har skapat] ser med förväntan på dig,"
  },
  {
    "id": 54267,
    "book": "psalms                                  ",
    "chapter": "104",
    "verse": "28",
    "text": "Du ger dem mat och de tar emot,"
  },
  {
    "id": 54268,
    "book": "psalms                                  ",
    "chapter": "104",
    "verse": "29",
    "text": "Du döljer ditt ansikte"
  },
  {
    "id": 54269,
    "book": "psalms                                  ",
    "chapter": "104",
    "verse": "30",
    "text": "När du sänder ut din livgivande ande"
  },
  {
    "id": 54270,
    "book": "psalms                                  ",
    "chapter": "104",
    "verse": "31",
    "text": "Låt Herrens ära (majestät, tyngd) bestå för evigt."
  },
  {
    "id": 54271,
    "book": "psalms                                  ",
    "chapter": "104",
    "verse": "32",
    "text": "Han som ser på jorden och den darrar [det blir jordbävningar],"
  },
  {
    "id": 54272,
    "book": "psalms                                  ",
    "chapter": "104",
    "verse": "33",
    "text": "Jag ska sjunga till Herren (Jahve) så länge jag lever,"
  },
  {
    "id": 54273,
    "book": "psalms                                  ",
    "chapter": "104",
    "verse": "34",
    "text": "Mitt tal (begrundan, fundering, mitt lågmälda grubblande) behagade honom,"
  },
  {
    "id": 54274,
    "book": "psalms                                  ",
    "chapter": "104",
    "verse": "35",
    "text": "Låt syndaren försvinna från jorden"
  }
]