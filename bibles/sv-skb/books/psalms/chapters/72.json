[
  {
    "id": 53659,
    "book": "psalms                                  ",
    "chapter": "72",
    "verse": "1",
    "text": "Av (för) Salomo."
  },
  {
    "id": 53660,
    "book": "psalms                                  ",
    "chapter": "72",
    "verse": "2",
    "text": "Han ska döma ditt folk med rättfärdighet (rättvist),"
  },
  {
    "id": 53661,
    "book": "psalms                                  ",
    "chapter": "72",
    "verse": "3",
    "text": "Bergen ska ge (bära, berätta nyheten om) frid åt folket,"
  },
  {
    "id": 53662,
    "book": "psalms                                  ",
    "chapter": "72",
    "verse": "4",
    "text": "Han ska försvara de betryckta i folket (skipa rätt),"
  },
  {
    "id": 53663,
    "book": "psalms                                  ",
    "chapter": "72",
    "verse": "5",
    "text": "Människor ska frukta dig (tillbe dig i vördnad),"
  },
  {
    "id": 53664,
    "book": "psalms                                  ",
    "chapter": "72",
    "verse": "6",
    "text": "Han ska vara som regnet som kommer ner på det nyslagna gräset"
  },
  {
    "id": 53665,
    "book": "psalms                                  ",
    "chapter": "72",
    "verse": "7",
    "text": "I hans dagar [då Jesus regerar i tusenårsriket] ska den rättfärdige blomstra"
  },
  {
    "id": 53666,
    "book": "psalms                                  ",
    "chapter": "72",
    "verse": "8",
    "text": "Han ska härska från hav till hav,"
  },
  {
    "id": 53667,
    "book": "psalms                                  ",
    "chapter": "72",
    "verse": "9",
    "text": "Öknens (ödemarkens) folk ska böja knä för honom,"
  },
  {
    "id": 53668,
    "book": "psalms                                  ",
    "chapter": "72",
    "verse": "10",
    "text": "Kungarna från Tarshish och avlägsna kuster [i väst]"
  },
  {
    "id": 53669,
    "book": "psalms                                  ",
    "chapter": "72",
    "verse": "11",
    "text": "Ja, alla kungar ska falla ner inför honom,"
  },
  {
    "id": 53670,
    "book": "psalms                                  ",
    "chapter": "72",
    "verse": "12",
    "text": "Han ska befria den nödställde som skriker (ropar efter hjälp),"
  },
  {
    "id": 53671,
    "book": "psalms                                  ",
    "chapter": "72",
    "verse": "13",
    "text": "Han ska känna medlidande med de nödställda (de som lider),"
  },
  {
    "id": 53672,
    "book": "psalms                                  ",
    "chapter": "72",
    "verse": "14",
    "text": "Han ska återköpa deras liv från förtryck och våld,"
  },
  {
    "id": 53673,
    "book": "psalms                                  ",
    "chapter": "72",
    "verse": "15",
    "text": "Må han leva [länge leve Konungen] och må man offra"
  },
  {
    "id": 53674,
    "book": "psalms                                  ",
    "chapter": "72",
    "verse": "16",
    "text": "Må säden växa rikt i landet,"
  },
  {
    "id": 53675,
    "book": "psalms                                  ",
    "chapter": "72",
    "verse": "17",
    "text": "Må hans namn [kungen] leva för evigt,"
  },
  {
    "id": 53676,
    "book": "psalms                                  ",
    "chapter": "72",
    "verse": "18",
    "text": "Välsignad är Herren Gud (Jahve Elohim),"
  },
  {
    "id": 53677,
    "book": "psalms                                  ",
    "chapter": "72",
    "verse": "19",
    "text": "Välsignat är hans härliga Namn för evigt."
  },
  {
    "id": 53678,
    "book": "psalms                                  ",
    "chapter": "72",
    "verse": "20",
    "text": "Slut på Davids, Ishais sons, böner."
  }
]