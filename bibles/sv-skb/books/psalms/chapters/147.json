[
  {
    "id": 55022,
    "book": "psalms                                  ",
    "chapter": "147",
    "verse": "1",
    "text": "Prisa Herren (lova Jah – hebr. hallelujah)!"
  },
  {
    "id": 55023,
    "book": "psalms                                  ",
    "chapter": "147",
    "verse": "2",
    "text": "Herren (Jahve) bygger upp Jerusalem igen,"
  },
  {
    "id": 55024,
    "book": "psalms                                  ",
    "chapter": "147",
    "verse": "3",
    "text": "Han helar (botar, reparerar; syr ihop) de brutnas [dem som har ett brustet och förkrossat] hjärta,"
  },
  {
    "id": 55025,
    "book": "psalms                                  ",
    "chapter": "147",
    "verse": "4",
    "text": "Han bestämmer stjärnornas antal,"
  },
  {
    "id": 55026,
    "book": "psalms                                  ",
    "chapter": "147",
    "verse": "5",
    "text": "Stor är vår Herre (Adonaj) [fokus på Guds storhet och makt],"
  },
  {
    "id": 55027,
    "book": "psalms                                  ",
    "chapter": "147",
    "verse": "6",
    "text": "Herren (Jahve) lyfter upp (hjälper, omsluter, återupprättar) de ödmjuka,"
  },
  {
    "id": 55028,
    "book": "psalms                                  ",
    "chapter": "147",
    "verse": "7",
    "text": "Sjung till Herren med tacksamhet (sjung tacksånger),"
  },
  {
    "id": 55029,
    "book": "psalms                                  ",
    "chapter": "147",
    "verse": "8",
    "text": "[lovsjung] honom som täcker himlarna med moln,"
  },
  {
    "id": 55030,
    "book": "psalms                                  ",
    "chapter": "147",
    "verse": "9",
    "text": "han som ger föda åt djuren, åt korpens ungar som ropar."
  },
  {
    "id": 55031,
    "book": "psalms                                  ",
    "chapter": "147",
    "verse": "10",
    "text": "Han har [verkligen] inte sin glädje (lust) i stridshästens styrka,"
  },
  {
    "id": 55032,
    "book": "psalms                                  ",
    "chapter": "147",
    "verse": "11",
    "text": "Herren (Jahve) har sitt behag (sin fröjd/glädje) i dem"
  },
  {
    "id": 55033,
    "book": "psalms                                  ",
    "chapter": "147",
    "verse": "12",
    "text": "Jerusalem, lova (prisa, vila i; stå i stum beundran inför – hebr. shavach) Herren,"
  },
  {
    "id": 55034,
    "book": "psalms                                  ",
    "chapter": "147",
    "verse": "13",
    "text": "För han stärker bommarna för dina portar,"
  },
  {
    "id": 55035,
    "book": "psalms                                  ",
    "chapter": "147",
    "verse": "14",
    "text": "Han ger fred [han låter frid råda] vid dina gränser,"
  },
  {
    "id": 55036,
    "book": "psalms                                  ",
    "chapter": "147",
    "verse": "15",
    "text": "Han sänder sitt löftesord (hebr. imrah) till jorden,"
  },
  {
    "id": 55037,
    "book": "psalms                                  ",
    "chapter": "147",
    "verse": "16",
    "text": "Han låter snö falla som ull,"
  },
  {
    "id": 55038,
    "book": "psalms                                  ",
    "chapter": "147",
    "verse": "17",
    "text": "Han slungar ner sitt hagel som smulor."
  },
  {
    "id": 55039,
    "book": "psalms                                  ",
    "chapter": "147",
    "verse": "18",
    "text": "Han sänder ut sitt ord och låter det frusna (ordagrant: dem) smälta (töa bort)."
  },
  {
    "id": 55040,
    "book": "psalms                                  ",
    "chapter": "147",
    "verse": "19",
    "text": "Han förkunnar [frimodigt och öppet] sitt ord för Jakob."
  },
  {
    "id": 55041,
    "book": "psalms                                  ",
    "chapter": "147",
    "verse": "20",
    "text": "Han har inte gjort så med något annat land (något hednafolk),"
  }
]