[
  {
    "id": 54976,
    "book": "psalms                                  ",
    "chapter": "144",
    "verse": "1",
    "text": "Till (av) David."
  },
  {
    "id": 54977,
    "book": "psalms                                  ",
    "chapter": "144",
    "verse": "2",
    "text": "Min nåd (omsorgsfulla kärlek),"
  },
  {
    "id": 54978,
    "book": "psalms                                  ",
    "chapter": "144",
    "verse": "3",
    "text": "Herre (Jahve), vad är en människa,"
  },
  {
    "id": 54979,
    "book": "psalms                                  ",
    "chapter": "144",
    "verse": "4",
    "text": "Människan är som ett andetag (en vindfläkt; fåfänlighet – hebr. hevel),"
  },
  {
    "id": 54980,
    "book": "psalms                                  ",
    "chapter": "144",
    "verse": "5",
    "text": "O, Herre, låt himlarna (universum) böja (kröka) sig och kom ned [här antyds relativitetsteorin, se Ps 18:10],"
  },
  {
    "id": 54981,
    "book": "psalms                                  ",
    "chapter": "144",
    "verse": "6",
    "text": "Kasta ut blixtar och skingra dem,"
  },
  {
    "id": 54982,
    "book": "psalms                                  ",
    "chapter": "144",
    "verse": "7",
    "text": "Sträck ut dina händer från höjden,"
  },
  {
    "id": 54983,
    "book": "psalms                                  ",
    "chapter": "144",
    "verse": "8",
    "text": "vars munnar talar falskhet,"
  },
  {
    "id": 54984,
    "book": "psalms                                  ",
    "chapter": "144",
    "verse": "9",
    "text": "O Gud (Elohim), Jag ska sjunga en ny sång till dig,"
  },
  {
    "id": 54985,
    "book": "psalms                                  ",
    "chapter": "144",
    "verse": "10",
    "text": "som ger frälsning till kungarna,"
  },
  {
    "id": 54986,
    "book": "psalms                                  ",
    "chapter": "144",
    "verse": "11",
    "text": "Befria mig och rädda (ryck bort) mig ut ur främlingarnas hand,"
  },
  {
    "id": 54987,
    "book": "psalms                                  ",
    "chapter": "144",
    "verse": "12",
    "text": "[Nu växlar formen från jag/mig till vi:]"
  },
  {
    "id": 54988,
    "book": "psalms                                  ",
    "chapter": "144",
    "verse": "13",
    "text": "vars förrådsbodar är fyllda, som erbjuder alla slags varor,"
  },
  {
    "id": 54989,
    "book": "psalms                                  ",
    "chapter": "144",
    "verse": "14",
    "text": "vars oxar är välgödda."
  },
  {
    "id": 54990,
    "book": "psalms                                  ",
    "chapter": "144",
    "verse": "15",
    "text": "Rikt välsignat (saligt; mycket lyckligt) är ett sådant folk!"
  }
]