[
  {
    "id": 52921,
    "book": "psalms                                  ",
    "chapter": "28",
    "verse": "1",
    "text": "Av David"
  },
  {
    "id": 52922,
    "book": "psalms                                  ",
    "chapter": "28",
    "verse": "2",
    "text": "Hör mina böners ljud [enträgna, ödmjuka vädjanden om nåd och hjälp],"
  },
  {
    "id": 52923,
    "book": "psalms                                  ",
    "chapter": "28",
    "verse": "3",
    "text": "Släpa inte bort mig med de gudlösa (ogudaktiga, ondskefulla),"
  },
  {
    "id": 52924,
    "book": "psalms                                  ",
    "chapter": "28",
    "verse": "4",
    "text": "Löna dem för vad de gjort,"
  },
  {
    "id": 52925,
    "book": "psalms                                  ",
    "chapter": "28",
    "verse": "5",
    "text": "Eftersom de inte förstår"
  },
  {
    "id": 52926,
    "book": "psalms                                  ",
    "chapter": "28",
    "verse": "6",
    "text": "Välsignad (lovad) vare Herren (Jahve),"
  },
  {
    "id": 52927,
    "book": "psalms                                  ",
    "chapter": "28",
    "verse": "7",
    "text": "Herren (Jahve) är min styrka (starkhet)"
  },
  {
    "id": 52928,
    "book": "psalms                                  ",
    "chapter": "28",
    "verse": "8",
    "text": "Herren är deras [sitt folks] styrka,"
  },
  {
    "id": 52929,
    "book": "psalms                                  ",
    "chapter": "28",
    "verse": "9",
    "text": "Ge seger åt ditt folk och välsigna ditt arv."
  }
]