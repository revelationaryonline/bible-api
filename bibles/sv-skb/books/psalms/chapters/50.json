[
  {
    "id": 53304,
    "book": "psalms                                  ",
    "chapter": "50",
    "verse": "1",
    "text": "En psalm (sång ackompanjerad på strängar) av (för) Asaf."
  },
  {
    "id": 53305,
    "book": "psalms                                  ",
    "chapter": "50",
    "verse": "2",
    "text": "Från Sion [templet i Jerusalem], skönhetens fulländning, har Gud (Elohim) strålat fram (visat sig i glans),"
  },
  {
    "id": 53306,
    "book": "psalms                                  ",
    "chapter": "50",
    "verse": "3",
    "text": "vår Gud (Elohim) kommer och han tiger inte (kan inte tiga)."
  },
  {
    "id": 53307,
    "book": "psalms                                  ",
    "chapter": "50",
    "verse": "4",
    "text": "Han kallar på himlarna däruppe"
  },
  {
    "id": 53308,
    "book": "psalms                                  ",
    "chapter": "50",
    "verse": "5",
    "text": "Samla mina heliga till mig,"
  },
  {
    "id": 53309,
    "book": "psalms                                  ",
    "chapter": "50",
    "verse": "6",
    "text": "Himlarna förkunnar hans rättfärdighet,"
  },
  {
    "id": 53310,
    "book": "psalms                                  ",
    "chapter": "50",
    "verse": "7",
    "text": "[Vers 7-15 riktar sig till folket i stort:]"
  },
  {
    "id": 53311,
    "book": "psalms                                  ",
    "chapter": "50",
    "verse": "8",
    "text": "Jag tillrättavisar dig inte för dina offer,"
  },
  {
    "id": 53312,
    "book": "psalms                                  ",
    "chapter": "50",
    "verse": "9",
    "text": "Jag har inget behov av en tjur från ditt hus,"
  },
  {
    "id": 53313,
    "book": "psalms                                  ",
    "chapter": "50",
    "verse": "10",
    "text": "Alla skogens djur är mina,"
  },
  {
    "id": 53314,
    "book": "psalms                                  ",
    "chapter": "50",
    "verse": "11",
    "text": "Jag känner alla bergets fåglar"
  },
  {
    "id": 53315,
    "book": "psalms                                  ",
    "chapter": "50",
    "verse": "12",
    "text": "Om jag blev hungrig, skulle jag berätta det för dig [Israel],"
  },
  {
    "id": 53316,
    "book": "psalms                                  ",
    "chapter": "50",
    "verse": "13",
    "text": "Äter jag tjurars kött"
  },
  {
    "id": 53317,
    "book": "psalms                                  ",
    "chapter": "50",
    "verse": "14",
    "text": "Offra tacksägelsens offer till Gud (Elohim)"
  },
  {
    "id": 53318,
    "book": "psalms                                  ",
    "chapter": "50",
    "verse": "15",
    "text": "Och kalla på mig nödens dag [då du är trängd och möter svårigheter],"
  },
  {
    "id": 53319,
    "book": "psalms                                  ",
    "chapter": "50",
    "verse": "16",
    "text": "[Vers 16-23 riktar sig personligt:]"
  },
  {
    "id": 53320,
    "book": "psalms                                  ",
    "chapter": "50",
    "verse": "17",
    "text": "Du hatar tillrättavisning"
  },
  {
    "id": 53321,
    "book": "psalms                                  ",
    "chapter": "50",
    "verse": "18",
    "text": "När du ser en tjuv är du belåten med honom,"
  },
  {
    "id": 53322,
    "book": "psalms                                  ",
    "chapter": "50",
    "verse": "19",
    "text": "Du har öppnat din mun för ondska,"
  },
  {
    "id": 53323,
    "book": "psalms                                  ",
    "chapter": "50",
    "verse": "20",
    "text": "Du sitter och talar mot din broder,"
  },
  {
    "id": 53324,
    "book": "psalms                                  ",
    "chapter": "50",
    "verse": "21",
    "text": "Dessa saker har du gjort. Skulle jag då vara tyst?"
  },
  {
    "id": 53325,
    "book": "psalms                                  ",
    "chapter": "50",
    "verse": "22",
    "text": "Betänk nu detta, du som glömmer bort Gud (Eloha) [Elohim i singular – den ende Guden],"
  },
  {
    "id": 53326,
    "book": "psalms                                  ",
    "chapter": "50",
    "verse": "23",
    "text": "Ett lovets offer ärar mig,"
  }
]