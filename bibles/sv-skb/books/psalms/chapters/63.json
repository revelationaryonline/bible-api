[
  {
    "id": 53491,
    "book": "psalms                                  ",
    "chapter": "63",
    "verse": "1",
    "text": "En psalm (sång ackompanjerad på strängar) av David, när han var i Juda öken. [Den torra ödemarken öster om Jerusalem ner mot Döda havet.]"
  },
  {
    "id": 53492,
    "book": "psalms                                  ",
    "chapter": "63",
    "verse": "2",
    "text": "Gud (Elohim), du är min Gud (El, den mäktige, starke), jag söker (längtar) ivrigt efter dig."
  },
  {
    "id": 53493,
    "book": "psalms                                  ",
    "chapter": "63",
    "verse": "3",
    "text": "Ja, jag har sett dig i helgedomen,"
  },
  {
    "id": 53494,
    "book": "psalms                                  ",
    "chapter": "63",
    "verse": "4",
    "text": "För [att få erfara] din nåd (omsorgsfulla kärlek) är bättre än livet självt,"
  },
  {
    "id": 53495,
    "book": "psalms                                  ",
    "chapter": "63",
    "verse": "5",
    "text": "Därför ska jag välsigna (prisa) dig med mitt liv (så länge jag lever),"
  },
  {
    "id": 53496,
    "book": "psalms                                  ",
    "chapter": "63",
    "verse": "6",
    "text": "Som av märg och olja (fett) [utsökt feta rätter] mättas min själ (hela min varelse)"
  },
  {
    "id": 53497,
    "book": "psalms                                  ",
    "chapter": "63",
    "verse": "7",
    "text": "När jag kommer ihåg dig"
  },
  {
    "id": 53498,
    "book": "psalms                                  ",
    "chapter": "63",
    "verse": "8",
    "text": "Du har varit min hjälp"
  },
  {
    "id": 53499,
    "book": "psalms                                  ",
    "chapter": "63",
    "verse": "9",
    "text": "Hela mitt jag (min själ) klamrar sig fast vid dig,"
  },
  {
    "id": 53500,
    "book": "psalms                                  ",
    "chapter": "63",
    "verse": "10",
    "text": "Men de som söker efter att fördärva (skada) mitt liv (min själ)"
  },
  {
    "id": 53501,
    "book": "psalms                                  ",
    "chapter": "63",
    "verse": "11",
    "text": "De ska bli plundrade av svärdet"
  },
  {
    "id": 53502,
    "book": "psalms                                  ",
    "chapter": "63",
    "verse": "12",
    "text": "Men kungen ska glädja sig i Gud (Elohim)."
  }
]