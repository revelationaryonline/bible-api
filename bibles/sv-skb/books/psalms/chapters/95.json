[
  {
    "id": 54122,
    "book": "psalms                                  ",
    "chapter": "95",
    "verse": "1",
    "text": "Kom (börja gå, vandra; sätt igång)!"
  },
  {
    "id": 54123,
    "book": "psalms                                  ",
    "chapter": "95",
    "verse": "2",
    "text": "Låt oss träda fram inför hans ansikte (inför honom; i hans närvaro)"
  },
  {
    "id": 54124,
    "book": "psalms                                  ",
    "chapter": "95",
    "verse": "3",
    "text": "För en stor [allsmäktig] Gud (El) är Herren (Jahve)"
  },
  {
    "id": 54125,
    "book": "psalms                                  ",
    "chapter": "95",
    "verse": "4",
    "text": "I hans hand är jordens djup,"
  },
  {
    "id": 54126,
    "book": "psalms                                  ",
    "chapter": "95",
    "verse": "5",
    "text": "Hans är havet, för han gjorde det,"
  },
  {
    "id": 54127,
    "book": "psalms                                  ",
    "chapter": "95",
    "verse": "6",
    "text": "Kom (kom in, gå in)!"
  },
  {
    "id": 54128,
    "book": "psalms                                  ",
    "chapter": "95",
    "verse": "7",
    "text": "För han är vår Gud (Elohim)"
  },
  {
    "id": 54129,
    "book": "psalms                                  ",
    "chapter": "95",
    "verse": "8",
    "text": "”Förhärda inte ert hjärta, som vid Meriva [hebreiska för strid, provokation, tvist och gräl, se 2 Mos 17:7],"
  },
  {
    "id": 54130,
    "book": "psalms                                  ",
    "chapter": "95",
    "verse": "9",
    "text": "där era fäder satte mig på prov, de prövade mig,"
  },
  {
    "id": 54131,
    "book": "psalms                                  ",
    "chapter": "95",
    "verse": "10",
    "text": "I fyrtio år var jag förbittrad på (avskydde, föraktade, sörjde jag) detta släkte (den generationen),"
  },
  {
    "id": 54132,
    "book": "psalms                                  ",
    "chapter": "95",
    "verse": "11",
    "text": "Därför svor jag i min vrede:"
  }
]