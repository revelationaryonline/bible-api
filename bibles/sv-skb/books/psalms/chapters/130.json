[
  {
    "id": 54809,
    "book": "psalms                                  ",
    "chapter": "130",
    "verse": "1",
    "text": "En pilgrimssång (en vallfartsång; ”en sång från/för dem som vandrar upp”). [Oavsett varifrån man kommer så går man alltid upp till Jerusalem.]"
  },
  {
    "id": 54810,
    "book": "psalms                                  ",
    "chapter": "130",
    "verse": "2",
    "text": "Herre (Adonaj), hör min röst,"
  },
  {
    "id": 54811,
    "book": "psalms                                  ",
    "chapter": "130",
    "verse": "3",
    "text": "Om du, Herre (Jah – kortformen av Jahve; betecknar att han alltid har existerat),"
  },
  {
    "id": 54812,
    "book": "psalms                                  ",
    "chapter": "130",
    "verse": "4",
    "text": "Men hos dig finns förlåtelse,"
  },
  {
    "id": 54813,
    "book": "psalms                                  ",
    "chapter": "130",
    "verse": "5",
    "text": "Jag väntar på (tittar ivrigt efter; hoppas uthålligt på) Herren (Jahve)"
  },
  {
    "id": 54814,
    "book": "psalms                                  ",
    "chapter": "130",
    "verse": "6",
    "text": "Hela min varelse (min själ) [väntar/längtar] efter min Herre (Adonaj),"
  },
  {
    "id": 54815,
    "book": "psalms                                  ",
    "chapter": "130",
    "verse": "7",
    "text": "Israel, förtrösta (vänta ivrigt) på Herren (Jahve),"
  },
  {
    "id": 54816,
    "book": "psalms                                  ",
    "chapter": "130",
    "verse": "8",
    "text": "Han ska friköpa (befria) Israel"
  }
]