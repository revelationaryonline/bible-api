[
  {
    "id": 60029,
    "book": "zechariah                               ",
    "chapter": "8",
    "verse": "1",
    "text": "Härskarornas Herre (Jahve Sebaots) ord kom till mig. [En serie korta tilltal som ger hopp.] Han sade:"
  },
  {
    "id": 60030,
    "book": "zechariah                               ",
    "chapter": "8",
    "verse": "2",
    "text": "Så säger Härskarornas Herre (Jahve Sebaot):"
  },
  {
    "id": 60031,
    "book": "zechariah                               ",
    "chapter": "8",
    "verse": "3",
    "text": "Så säger Herren (Jahve):"
  },
  {
    "id": 60032,
    "book": "zechariah                               ",
    "chapter": "8",
    "verse": "4",
    "text": "Så säger Härskarornas Herre (Jahve Sebaot):"
  },
  {
    "id": 60033,
    "book": "zechariah                               ",
    "chapter": "8",
    "verse": "5",
    "text": "Stadens torg (gator) ska vara fulla av pojkar och flickor"
  },
  {
    "id": 60034,
    "book": "zechariah                               ",
    "chapter": "8",
    "verse": "6",
    "text": "Så säger Härskarornas Herre (Jahve Sebaot):"
  },
  {
    "id": 60035,
    "book": "zechariah                               ",
    "chapter": "8",
    "verse": "7",
    "text": "Så säger Härskarornas Herre (Jahve Sebaot):"
  },
  {
    "id": 60036,
    "book": "zechariah                               ",
    "chapter": "8",
    "verse": "8",
    "text": "Jag ska föra dem hem,"
  },
  {
    "id": 60037,
    "book": "zechariah                               ",
    "chapter": "8",
    "verse": "9",
    "text": "Så säger Härskarornas Herre (Jahve Sebaot):"
  },
  {
    "id": 60038,
    "book": "zechariah                               ",
    "chapter": "8",
    "verse": "10",
    "text": "Innan dessa dagar fanns inga arbetstillfällen (något som gav lön) varken för människor eller djur, det fanns ingen ro (frid, shalom) från motståndarna (trätobröderna, de som ville ont) för dem som kom och gick, för jag hade låtit alla människor vara emot sina grannar."
  },
  {
    "id": 60039,
    "book": "zechariah                               ",
    "chapter": "8",
    "verse": "11",
    "text": "Men nu vill jag inte längre vara mot kvarlevan av detta folk såsom jag var i forna dagar, förkunnar (säger, proklamerar) Härskarornas Herre (Jahve Sebaot)."
  },
  {
    "id": 60040,
    "book": "zechariah                               ",
    "chapter": "8",
    "verse": "12",
    "text": "För som fridens säd"
  },
  {
    "id": 60041,
    "book": "zechariah                               ",
    "chapter": "8",
    "verse": "13",
    "text": "Det skall ske att på samma sätt som ni var en förbannelse (något man tog lätt på, gjorde spe av, föraktade) bland nationerna ni Juda hus och Israels hus, så ska ni bli en välsignelse (något man beundrar, ser upp till). Frukta inte, låt era händer bli starka."
  },
  {
    "id": 60042,
    "book": "zechariah                               ",
    "chapter": "8",
    "verse": "14",
    "text": "Så säger Härskarornas Herre (Jahve Sebaot):"
  },
  {
    "id": 60043,
    "book": "zechariah                               ",
    "chapter": "8",
    "verse": "15",
    "text": "så ska jag åter planera, men i dessa dagar att göra gott mot Jerusalem och mot Juda hus. Frukta inte."
  },
  {
    "id": 60044,
    "book": "zechariah                               ",
    "chapter": "8",
    "verse": "16",
    "text": "Detta är vad ni ska göra:"
  },
  {
    "id": 60045,
    "book": "zechariah                               ",
    "chapter": "8",
    "verse": "17",
    "text": "Låt ingen av er tänka ut ont i sitt hjärta mot sin nästa"
  },
  {
    "id": 60046,
    "book": "zechariah                               ",
    "chapter": "8",
    "verse": "18",
    "text": "Ordet från Härskarornas Herre (Jahve Sebaot) kom till mig, han sade:"
  },
  {
    "id": 60047,
    "book": "zechariah                               ",
    "chapter": "8",
    "verse": "19",
    "text": "Så säger Härskarornas Herre (Jahve Sebaot):"
  },
  {
    "id": 60048,
    "book": "zechariah                               ",
    "chapter": "8",
    "verse": "20",
    "text": "Så säger Härskarornas Herre (Jahve Sebaot):"
  },
  {
    "id": 60049,
    "book": "zechariah                               ",
    "chapter": "8",
    "verse": "21",
    "text": "och invånarna i en stad ska gå till en annan och säga: ”Låt oss gå med hast och bönfalla inför Herrens (Jahves) ansikte och söka Härskarornas Herre (Jahve Sebaot), jag ska också gå.”"
  },
  {
    "id": 60050,
    "book": "zechariah                               ",
    "chapter": "8",
    "verse": "22",
    "text": "Många folk och mäktiga länder ska komma och söka Härskarornas Herre (Jahve Sebaot) i Jerusalem och bönfalla inför Herrens (Jahves) ansikte."
  },
  {
    "id": 60051,
    "book": "zechariah                               ",
    "chapter": "8",
    "verse": "23",
    "text": "Så säger Härskarornas Herre (Jahve Sebaot):"
  }
]