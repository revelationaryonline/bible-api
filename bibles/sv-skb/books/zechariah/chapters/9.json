[
  {
    "id": 60052,
    "book": "zechariah                               ",
    "chapter": "9",
    "verse": "1",
    "text": "Tyngden av Herrens (Jahves) ord [samma uttryck som i Sak 12:1] angående (vilar över) Chadrachs land"
  },
  {
    "id": 60053,
    "book": "zechariah                               ",
    "chapter": "9",
    "verse": "2",
    "text": "Och även Chamat [ett syriskt rike med en huvudstad med samma namn, norr om Damaskus],"
  },
  {
    "id": 60054,
    "book": "zechariah                               ",
    "chapter": "9",
    "verse": "3",
    "text": "Tyros byggde sig själv ett starkt fäste (befästning för försvar);"
  },
  {
    "id": 60055,
    "book": "zechariah                               ",
    "chapter": "9",
    "verse": "4",
    "text": "Se, Herren (Adonaj) ska utarma henne"
  },
  {
    "id": 60056,
    "book": "zechariah                               ",
    "chapter": "9",
    "verse": "5",
    "text": "[Kuststäderna bävar för erövraren som avancerar söderut mot Egypten.]"
  },
  {
    "id": 60057,
    "book": "zechariah                               ",
    "chapter": "9",
    "verse": "6",
    "text": "En bastard [5 Mos 23:2 – en kung född utomlands; ett blandfolk] ska bo i Ashkelon"
  },
  {
    "id": 60058,
    "book": "zechariah                               ",
    "chapter": "9",
    "verse": "7",
    "text": "Jag ska ta bort hans blod, ut ur hans mun,"
  },
  {
    "id": 60059,
    "book": "zechariah                               ",
    "chapter": "9",
    "verse": "8",
    "text": "Och jag ska slå läger vid mitt hus mot armén,"
  },
  {
    "id": 60060,
    "book": "zechariah                               ",
    "chapter": "9",
    "verse": "9",
    "text": "Gläd dig av hela din kraft (hänge dig),"
  },
  {
    "id": 60061,
    "book": "zechariah                               ",
    "chapter": "9",
    "verse": "10",
    "text": "Jag ska ta bort (förgöra) alla stridsfordon från Efraim"
  },
  {
    "id": 60062,
    "book": "zechariah                               ",
    "chapter": "9",
    "verse": "11",
    "text": "För dig ska jag, genom förbundsblodet,"
  },
  {
    "id": 60063,
    "book": "zechariah                               ",
    "chapter": "9",
    "verse": "12",
    "text": "Återvänd till den starka fästningen, ni hoppets fångar;"
  },
  {
    "id": 60064,
    "book": "zechariah                               ",
    "chapter": "9",
    "verse": "13",
    "text": "Jag ska böja Juda som min båge"
  },
  {
    "id": 60065,
    "book": "zechariah                               ",
    "chapter": "9",
    "verse": "14",
    "text": "Herren (Jahve) ska bli synlig över dem"
  },
  {
    "id": 60066,
    "book": "zechariah                               ",
    "chapter": "9",
    "verse": "15",
    "text": "Härskarornas Herre (Jahve Sebaot) ska försvara dem"
  },
  {
    "id": 60067,
    "book": "zechariah                               ",
    "chapter": "9",
    "verse": "16",
    "text": "Den dagen ska Herren (Jahve) deras Gud (Jahve Elohim) frälsa dem"
  },
  {
    "id": 60068,
    "book": "zechariah                               ",
    "chapter": "9",
    "verse": "17",
    "text": "Så stor deras godhet och deras skönhet ska bli."
  }
]