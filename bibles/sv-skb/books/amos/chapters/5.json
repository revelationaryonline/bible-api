[
  {
    "id": 13045,
    "book": "amos                                    ",
    "chapter": "5",
    "verse": "1",
    "text": "Hör (hörsamma, lyd) detta ord som jag lyfter upp som en klagosång över dig, Israels hus:"
  },
  {
    "id": 13046,
    "book": "amos                                    ",
    "chapter": "5",
    "verse": "2",
    "text": "”Israels jungfru har fallit,"
  },
  {
    "id": 13047,
    "book": "amos                                    ",
    "chapter": "5",
    "verse": "3",
    "text": "Därför säger Herren Gud (Adonaj Jahve) så:"
  },
  {
    "id": 13048,
    "book": "amos                                    ",
    "chapter": "5",
    "verse": "4",
    "text": "För så säger Herren (Jahve) till Israels hus:"
  },
  {
    "id": 13049,
    "book": "amos                                    ",
    "chapter": "5",
    "verse": "5",
    "text": "Men sök inte Betel,"
  },
  {
    "id": 13050,
    "book": "amos                                    ",
    "chapter": "5",
    "verse": "6",
    "text": "Sök (träd fram inför; fråga efter) Herren (Jahve) så får ni leva,"
  },
  {
    "id": 13051,
    "book": "amos                                    ",
    "chapter": "5",
    "verse": "7",
    "text": "Ni som vänder rätten till malört"
  },
  {
    "id": 13052,
    "book": "amos                                    ",
    "chapter": "5",
    "verse": "8",
    "text": "Han som har gjort Plejaderna och Orion"
  },
  {
    "id": 13053,
    "book": "amos                                    ",
    "chapter": "5",
    "verse": "9",
    "text": "som får förödelse att blixtra över de starka"
  },
  {
    "id": 13054,
    "book": "amos                                    ",
    "chapter": "5",
    "verse": "10",
    "text": "De hatar honom som tillrättavisar i porten"
  },
  {
    "id": 13055,
    "book": "amos                                    ",
    "chapter": "5",
    "verse": "11",
    "text": "Därför, eftersom ni trampar på den fattige"
  },
  {
    "id": 13056,
    "book": "amos                                    ",
    "chapter": "5",
    "verse": "12",
    "text": "För jag vet (känner väl till, är intimt förtrogen med) dina överträdelser"
  },
  {
    "id": 13057,
    "book": "amos                                    ",
    "chapter": "5",
    "verse": "13",
    "text": "Därför är den eftertänksamme tyst i en sådan tid,"
  },
  {
    "id": 13058,
    "book": "amos                                    ",
    "chapter": "5",
    "verse": "14",
    "text": "Sök gott och inte ont"
  },
  {
    "id": 13059,
    "book": "amos                                    ",
    "chapter": "5",
    "verse": "15",
    "text": "Hata det onda och älska det goda"
  },
  {
    "id": 13060,
    "book": "amos                                    ",
    "chapter": "5",
    "verse": "16",
    "text": "Därför säger Herren Härskarornas Gud (Jahve Elohim Sebaot):"
  },
  {
    "id": 13061,
    "book": "amos                                    ",
    "chapter": "5",
    "verse": "17",
    "text": "Och i alla vingårdar ska det vara klagan”,"
  },
  {
    "id": 13062,
    "book": "amos                                    ",
    "chapter": "5",
    "verse": "18",
    "text": "Ve dem som önskar"
  },
  {
    "id": 13063,
    "book": "amos                                    ",
    "chapter": "5",
    "verse": "19",
    "text": "Som om en man flyr för ett lejon"
  },
  {
    "id": 13064,
    "book": "amos                                    ",
    "chapter": "5",
    "verse": "20",
    "text": "Ska inte Herrens (Jahves) dag vara mörker och inte ljus?"
  },
  {
    "id": 13065,
    "book": "amos                                    ",
    "chapter": "5",
    "verse": "21",
    "text": "”Jag hatar, jag avskyr era högtider [de två verben förstärker varandra och beskriver Guds avsky för skenheliga religiösa yttringar. Det som i 3 Mos 23:2 kallades ’mina högtider’ har nu blivit ’era högtider’.]"
  },
  {
    "id": 13066,
    "book": "amos                                    ",
    "chapter": "5",
    "verse": "22",
    "text": "Även om ni än offrar åt mig både brännoffer [3 Mos 1] och matoffer [3 Mos 2], finner jag ingen glädje i dem."
  },
  {
    "id": 13067,
    "book": "amos                                    ",
    "chapter": "5",
    "verse": "23",
    "text": "Ta bort dina skränande sånger från mig [de är en plåga och en börda]."
  },
  {
    "id": 13068,
    "book": "amos                                    ",
    "chapter": "5",
    "verse": "24",
    "text": "[Nu kommer en vers som bryter mönstret och står ut:]"
  },
  {
    "id": 13069,
    "book": "amos                                    ",
    "chapter": "5",
    "verse": "25",
    "text": "Bar ni fram slaktoffer och matoffer åt mig"
  },
  {
    "id": 13070,
    "book": "amos                                    ",
    "chapter": "5",
    "verse": "26",
    "text": "Så ska ni lyfta upp Sikkot er kung och Chion, er avgud,"
  },
  {
    "id": 13071,
    "book": "amos                                    ",
    "chapter": "5",
    "verse": "27",
    "text": "Därför ska jag låta dig gå i fångenskap bortom Damaskus”,"
  }
]