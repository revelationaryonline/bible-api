    "book": "amos                                    ",
    "chapter": "2",
    "verse": "11",
    "text": "Bland dina unga söner reste jag upp profeter"
  },
  {
    "id": 13012,
    "book": "amos                                    ",
    "chapter": "2",
    "verse": "12",
    "text": "”Men ni gav nasirerna vin att dricka och befallde profeterna och sade: ’Profetera inte’. [Att vara nasir innebär att man har avlagt nasirlöften, däribland att avstå från allt som kommer från vinrankan, se 4 Mos 6.]"
  },
  {
    "id": 13013,
    "book": "amos                                    ",
    "chapter": "2",
    "verse": "13",
    "text": "Se, Jag ska låta det knaka under er,"
  },
  {
    "id": 13014,
    "book": "amos                                    ",
    "chapter": "2",
    "verse": "14",
    "text": "Den snabbe ska inte kunna fly,"
  },
  {
    "id": 13015,
    "book": "amos                                    ",
    "chapter": "2",
    "verse": "15",
    "text": "Inte heller ska den som hanterar bågen kunna stå"
  },
  {
    "id": 13016,
    "book": "amos                                    ",
    "chapter": "2",
    "verse": "16",
    "text": "Den modige bland de mäktiga ska fly sin väg naken på den dagen.”"
  }
