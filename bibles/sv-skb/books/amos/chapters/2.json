    "book": "amos                                    ",
    "chapter": "2",
    "verse": "6",
    "text": "Så säger Herren (Jahve):"
  },
  {
    "id": 13007,
    "book": "amos                                    ",
    "chapter": "2",
    "verse": "7",
    "text": "De trampar ner den fattiges huvud i jordens stoft"
  },
  {
    "id": 13008,
