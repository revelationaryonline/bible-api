[
  {
    "id": 13117,
    "book": "amos                                    ",
    "chapter": "9",
    "verse": "1",
    "text": "Jag såg Herren (Adonaj) stå bredvid altaret och han sade:"
  },
  {
    "id": 13118,
    "book": "amos                                    ",
    "chapter": "9",
    "verse": "2",
    "text": "Om de så gräver sig ner till Sheol (underjorden, de dödas plats)"
  },
  {
    "id": 13119,
    "book": "amos                                    ",
    "chapter": "9",
    "verse": "3",
    "text": "Och om de gömmer sig själva på Karmels topp,"
  },
  {
    "id": 13120,
    "book": "amos                                    ",
    "chapter": "9",
    "verse": "4",
    "text": "Trots att de går i fångenskap framför sina fiender,"
  },
  {
    "id": 13121,
    "book": "amos                                    ",
    "chapter": "9",
    "verse": "5",
    "text": "För Herren Härskarornas Herre (Adonaj Jahve Sebaot)"
  },
  {
    "id": 13122,
    "book": "amos                                    ",
    "chapter": "9",
    "verse": "6",
    "text": "Det är han som bygger sin övre kammare i himlarna"
  },
  {
    "id": 13123,
    "book": "amos                                    ",
    "chapter": "9",
    "verse": "7",
    "text": "Är ni inte som Etiopiens (Kushs) söner för mig, ni Israels söner,"
  },
  {
    "id": 13124,
    "book": "amos                                    ",
    "chapter": "9",
    "verse": "8",
    "text": "Se, Herren Herrens (Adonaj Jahve) ögon"
  },
  {
    "id": 13125,
    "book": "amos                                    ",
    "chapter": "9",
    "verse": "9",
    "text": "För se, jag ska befalla"
  },
  {
    "id": 13126,
    "book": "amos                                    ",
    "chapter": "9",
    "verse": "10",
    "text": "Mitt folks alla syndare som säger:"
  },
  {
    "id": 13127,
    "book": "amos                                    ",
    "chapter": "9",
    "verse": "11",
    "text": "”På den dagen ska jag resa upp"
  },
  {
    "id": 13128,
    "book": "amos                                    ",
    "chapter": "9",
    "verse": "12",
    "text": "så att de kan ta i besittning vad som är kvar av [Israels bittra fiende] Edom"
  },
  {
    "id": 13129,
    "book": "amos                                    ",
    "chapter": "9",
    "verse": "13",
    "text": "”Se, det ska komma dagar”, förkunnar (säger, proklamerar) Herren,"
  },
  {
    "id": 13130,
    "book": "amos                                    ",
    "chapter": "9",
    "verse": "14",
    "text": "Jag ska föra tillbaka mitt folk,"
  },
  {
    "id": 13131,
    "book": "amos                                    ",
    "chapter": "9",
    "verse": "15",
    "text": "Jag ska plantera dem i deras eget land,"
  }
]