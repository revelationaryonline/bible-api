[
  {
    "id": 33914,
    "book": "job                                     ",
    "chapter": "26",
    "verse": "1",
    "text": "Då svarade Job och sade:"
  },
  {
    "id": 33915,
    "book": "job                                     ",
    "chapter": "26",
    "verse": "2",
    "text": "Vad har det hjälpt till den utan kraft (vigör – hebr. koach)?"
  },
  {
    "id": 33916,
    "book": "job                                     ",
    "chapter": "26",
    "verse": "3",
    "text": "Hur har han gett råd utan (till ingen) vishet"
  },
  {
    "id": 33917,
    "book": "job                                     ",
    "chapter": "26",
    "verse": "4",
    "text": "Vem har gett dig allt detta prat (hebr. milah)"
  },
  {
    "id": 33918,
    "book": "job                                     ",
    "chapter": "26",
    "verse": "5",
    "text": "Skuggorna (de dödas andar – hebr. rafaim) grips av ångest,"
  },
  {
    "id": 33919,
    "book": "job                                     ",
    "chapter": "26",
    "verse": "6",
    "text": "Sheol (dödsriket, de dödas plats) ligger blottat för honom,"
  },
  {
    "id": 33920,
    "book": "job                                     ",
    "chapter": "26",
    "verse": "7",
    "text": "Han expanderar (spänner ut) norr över tomrummet,"
  },
  {
    "id": 33921,
    "book": "job                                     ",
    "chapter": "26",
    "verse": "8",
    "text": "Han binder upp vattnet i sina moln (mörka regnmoln – hebr. av)"
  },
  {
    "id": 33922,
    "book": "job                                     ",
    "chapter": "26",
    "verse": "9",
    "text": "Från greppet [något som han döljer i sin hand] på hans trons ansikte"
  },
  {
    "id": 33923,
    "book": "job                                     ",
    "chapter": "26",
    "verse": "10",
    "text": "En förordnad (ordagrant ”sak inristat”) gräns (hebr. chog) över vattnets ansikte [horisonten]"
  },
  {
    "id": 33924,
    "book": "job                                     ",
    "chapter": "26",
    "verse": "11",
    "text": "Himlarnas pelare skälver (hebr. rafaf; enda gången ordet används)"
  },
  {
    "id": 33925,
    "book": "job                                     ",
    "chapter": "26",
    "verse": "12",
    "text": "I sin vigör (koach) rör han upp havet [nationer, folk]"
  },
  {
    "id": 33926,
    "book": "job                                     ",
    "chapter": "26",
    "verse": "13",
    "text": "I (genom) hans Ande (andedräkt) är himlarna klara."
  },
  {
    "id": 33927,
    "book": "job                                     ",
    "chapter": "26",
    "verse": "14",
    "text": "Se, detta är [bara] ytterkanten på hans väg [vi ser bara en glimt av hans verk]"
  }
]