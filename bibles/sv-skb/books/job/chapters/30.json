[
  {
    "id": 34004,
    "book": "job                                     ",
    "chapter": "30",
    "verse": "1",
    "text": "Och nu har de som är yngre än jag hånat mig,"
  },
  {
    "id": 34005,
    "book": "job                                     ",
    "chapter": "30",
    "verse": "2",
    "text": "Till vilken nytta är deras händers styrka för mig?"
  },
  {
    "id": 34006,
    "book": "job                                     ",
    "chapter": "30",
    "verse": "3",
    "text": "De är magra av brist och hungersnöd,"
  },
  {
    "id": 34007,
    "book": "job                                     ",
    "chapter": "30",
    "verse": "4",
    "text": "De plockar (samlar) saltörter med malört"
  },
  {
    "id": 34008,
    "book": "job                                     ",
    "chapter": "30",
    "verse": "5",
    "text": "Från mitten drivs de ut,"
  },
  {
    "id": 34009,
    "book": "job                                     ",
    "chapter": "30",
    "verse": "6",
    "text": "I dalens klyftor måste de bo,"
  },
  {
    "id": 34010,
    "book": "job                                     ",
    "chapter": "30",
    "verse": "7",
    "text": "I busksnåren skriar de,"
  },
  {
    "id": 34011,
    "book": "job                                     ",
    "chapter": "30",
    "verse": "8",
    "text": "De är dårens söner, även skammens söner,"
  },
  {
    "id": 34012,
    "book": "job                                     ",
    "chapter": "30",
    "verse": "9",
    "text": "Och nu har jag blivit deras nidvisa (hebr. negina),"
  },
  {
    "id": 34013,
    "book": "job                                     ",
    "chapter": "30",
    "verse": "10",
    "text": "De avskyr mig, de flyr långt bort från mig"
  },
  {
    "id": 34014,
    "book": "job                                     ",
    "chapter": "30",
    "verse": "11",
    "text": "Eftersom han har lossat min tältlina (hebr. jeter) [huvudlinan som höll uppe tältet, se Job 4:21]"
  },
  {
    "id": 34015,
    "book": "job                                     ",
    "chapter": "30",
    "verse": "12",
    "text": "Över min högra reser sig pöbeln,"
  },
  {
    "id": 34016,
    "book": "job                                     ",
    "chapter": "30",
    "verse": "13",
    "text": "De gräver upp min stig (upptrampad gångväg – hebr. netivah),"
  },
  {
    "id": 34017,
    "book": "job                                     ",
    "chapter": "30",
    "verse": "14",
    "text": "Som ett stort gap (genombrott, bräcka i en mur) anländer de,"
  },
  {
    "id": 34018,
    "book": "job                                     ",
    "chapter": "30",
    "verse": "15",
    "text": "Skräck har vänts mot mig,"
  },
  {
    "id": 34019,
    "book": "job                                     ",
    "chapter": "30",
    "verse": "16",
    "text": "Och nu är min själ uthälld i mig,"
  },
  {
    "id": 34020,
    "book": "job                                     ",
    "chapter": "30",
    "verse": "17",
    "text": "På natten blir mina ben genomborrade"
  },
  {
    "id": 34021,
    "book": "job                                     ",
    "chapter": "30",
    "verse": "18",
    "text": "Med stor kraft är mina kläder vanställda,"
  },
  {
    "id": 34022,
    "book": "job                                     ",
    "chapter": "30",
    "verse": "19",
    "text": "Han har kastat mig i dyn"
  },
  {
    "id": 34023,
    "book": "job                                     ",
    "chapter": "30",
    "verse": "20",
    "text": "Jag ropar till dig men du svarar mig inte."
  },
  {
    "id": 34024,
    "book": "job                                     ",
    "chapter": "30",
    "verse": "21",
    "text": "Du har vänt dig till att bli grym mot mig,"
  },
  {
    "id": 34025,
    "book": "job                                     ",
    "chapter": "30",
    "verse": "22",
    "text": "Du lyfter upp mig till vinden,"
  },
  {
    "id": 34026,
    "book": "job                                     ",
    "chapter": "30",
    "verse": "23",
    "text": "Jag vet att du vill föra mig till döden"
  },
  {
    "id": 34027,
    "book": "job                                     ",
    "chapter": "30",
    "verse": "24",
    "text": "Förvisso, skulle inte han [en bruten man – Job] sträcka ut sin hand från ruinhögen,"
  },
  {
    "id": 34028,
    "book": "job                                     ",
    "chapter": "30",
    "verse": "25",
    "text": "Har jag inte gråtit på olyckans dag?"
  },
  {
    "id": 34029,
    "book": "job                                     ",
    "chapter": "30",
    "verse": "26",
    "text": "När jag skådade efter gott,"
  },
  {
    "id": 34030,
    "book": "job                                     ",
    "chapter": "30",
    "verse": "27",
    "text": "Mitt inre kokar och vilar inte,"
  },
  {
    "id": 34031,
    "book": "job                                     ",
    "chapter": "30",
    "verse": "28",
    "text": "Jag går sörjande utan värme."
  },
  {
    "id": 34032,
    "book": "job                                     ",
    "chapter": "30",
    "verse": "29",
    "text": "Jag har blivit en bror till schakalen"
  },
  {
    "id": 34033,
    "book": "job                                     ",
    "chapter": "30",
    "verse": "30",
    "text": "Min hud är svart och faller av mig"
  },
  {
    "id": 34034,
    "book": "job                                     ",
    "chapter": "30",
    "verse": "31",
    "text": "Därför är min harpa (kinor) vänd till sorg"
  }
]