[
  {
    "id": 33773,
    "book": "job                                     ",
    "chapter": "20",
    "verse": "1",
    "text": "Sedan tog Tsofar – naamaiten [Job 2:11; 11:1], till orda och sade:"
  },
  {
    "id": 33774,
    "book": "job                                     ",
    "chapter": "20",
    "verse": "2",
    "text": "Mina stormiga tankar (orostankar – hebr. saif) för mig tillbaka (tvingar mig att bemöta detta),"
  },
  {
    "id": 33775,
    "book": "job                                     ",
    "chapter": "20",
    "verse": "3",
    "text": "Kränkande tillrättavisning måste jag höra,"
  },
  {
    "id": 33776,
    "book": "job                                     ",
    "chapter": "20",
    "verse": "4",
    "text": "Vet du inte att det alltid varit så,"
  },
  {
    "id": 33777,
    "book": "job                                     ",
    "chapter": "20",
    "verse": "5",
    "text": "att de gudlösas (hebr. rasha) jubelrop [triumferande fröjderop] är kortvarigt (nära)"
  },
  {
    "id": 33778,
    "book": "job                                     ",
    "chapter": "20",
    "verse": "6",
    "text": "[Vers 6 är en välstrukturerad kiasm i tre nivåer:]"
  },
  {
    "id": 33779,
    "book": "job                                     ",
    "chapter": "20",
    "verse": "7",
    "text": "så förgås han dock för alltid som sin egen dynga (avföring)."
  },
  {
    "id": 33780,
    "book": "job                                     ",
    "chapter": "20",
    "verse": "8",
    "text": "Som en dröm flyger han bort och ingen finner honom,"
  },
  {
    "id": 33781,
    "book": "job                                     ",
    "chapter": "20",
    "verse": "9",
    "text": "Ögat som såg honom ser honom aldrig mer,"
  },
  {
    "id": 33782,
    "book": "job                                     ",
    "chapter": "20",
    "verse": "10",
    "text": "Hans söner ger nåd till de fattiga"
  },
  {
    "id": 33783,
    "book": "job                                     ",
    "chapter": "20",
    "verse": "11",
    "text": "Hans ben var fulla av ungdom [ungdomlig spänst],"
  },
  {
    "id": 33784,
    "book": "job                                     ",
    "chapter": "20",
    "verse": "12",
    "text": "[I flera verser liknar Tsofar ondska som något sött men dödligt.]"
  },
  {
    "id": 33785,
    "book": "job                                     ",
    "chapter": "20",
    "verse": "13",
    "text": "även om han är rädd om den"
  },
  {
    "id": 33786,
    "book": "job                                     ",
    "chapter": "20",
    "verse": "14",
    "text": "så förvandlas hans föda i hans inre"
  },
  {
    "id": 33787,
    "book": "job                                     ",
    "chapter": "20",
    "verse": "15",
    "text": "Den rikedom han svalt (konsumerat)"
  },
  {
    "id": 33788,
    "book": "job                                     ",
    "chapter": "20",
    "verse": "16",
    "text": "Gift från kobran (den starka/slingrande ormen – hebr. peten) ska han suga i sig,"
  },
  {
    "id": 33789,
    "book": "job                                     ",
    "chapter": "20",
    "verse": "17",
    "text": "Han ska inte få se (glädja sig att se porlande) bäckar,"
  },
  {
    "id": 33790,
    "book": "job                                     ",
    "chapter": "20",
    "verse": "18",
    "text": "Sitt slit måste han återlämna,"
  },
  {
    "id": 33791,
    "book": "job                                     ",
    "chapter": "20",
    "verse": "19",
    "text": "eftersom han slog och övergav de ringa,"
  },
  {
    "id": 33792,
    "book": "job                                     ",
    "chapter": "20",
    "verse": "20",
    "text": "Han känner ingen ro i sin mage (hebr. beten) [känslor påverkar magen],"
  },
  {
    "id": 33793,
    "book": "job                                     ",
    "chapter": "20",
    "verse": "21",
    "text": "Inget är kvar för honom att äta (hans begär),"
  },
  {
    "id": 33794,
    "book": "job                                     ",
    "chapter": "20",
    "verse": "22",
    "text": "Mitt i höjden av sitt överflöd (”när applåderna ljuder och hyllar hans överflödande”)"
  },
  {
    "id": 33795,
    "book": "job                                     ",
    "chapter": "20",
    "verse": "23",
    "text": "När han fyller sin mage (buk)"
  },
  {
    "id": 33796,
    "book": "job                                     ",
    "chapter": "20",
    "verse": "24",
    "text": "Om han flyr undan för vapen [generell term för militär utrustning] av järn,"
  },
  {
    "id": 33797,
    "book": "job                                     ",
    "chapter": "20",
    "verse": "25",
    "text": "Han drar [ut pilen], och den kommer ut från sin rygg"
  },
  {
    "id": 33798,
    "book": "job                                     ",
    "chapter": "20",
    "verse": "26",
    "text": "djupt mörker väntar på hans ägodelar."
  },
  {
    "id": 33799,
    "book": "job                                     ",
    "chapter": "20",
    "verse": "27",
    "text": "Himlarna uppenbarar (blottar; sända i exil – hebr. galah) hans missgärning (synd – hebr. avon)"
  },
  {
    "id": 33800,
    "book": "job                                     ",
    "chapter": "20",
    "verse": "28",
    "text": "Skörden [förråd av grödor] i hans hus spolas bort,"
  },
  {
    "id": 33801,
    "book": "job                                     ",
    "chapter": "20",
    "verse": "29",
    "text": "Det är vad den gudlösa människan (hebr. adam) får av Gud (Elohim),"
  }
]