[
  {
    "id": 34344,
    "book": "job                                     ",
    "chapter": "41",
    "verse": "1",
    "text": "Ingen är så dumdristig (grym mot sig själv) att han retar upp den [Leviatan]."
  },
  {
    "id": 34345,
    "book": "job                                     ",
    "chapter": "41",
    "verse": "2",
    "text": "Vem har gett mig något som jag skulle betala tillbaka?"
  },
  {
    "id": 34346,
    "book": "job                                     ",
    "chapter": "41",
    "verse": "3",
    "text": "Jag vill inte hålla tyst om hans ben,"
  },
  {
    "id": 34347,
    "book": "job                                     ",
    "chapter": "41",
    "verse": "4",
    "text": "Vem kan klä av honom hans yttermantel (yttre eller främre pansar)?"
  },
  {
    "id": 34348,
    "book": "job                                     ",
    "chapter": "41",
    "verse": "5",
    "text": "Vem kan öppna portarna till hans gap [ordagrant ”ansiktes dörrar”]?"
  },
  {
    "id": 34349,
    "book": "job                                     ",
    "chapter": "41",
    "verse": "6",
    "text": "[Tre verser beskriver nu Leviatans tjocka hud:]"
  },
  {
    "id": 34350,
    "book": "job                                     ",
    "chapter": "41",
    "verse": "7",
    "text": "Den ena tätt mot den andra,"
  },
  {
    "id": 34351,
    "book": "job                                     ",
    "chapter": "41",
    "verse": "8",
    "text": "De håller ihop med varandra [ordagrant ”som en man med sin bror”],"
  },
  {
    "id": 34352,
    "book": "job                                     ",
    "chapter": "41",
    "verse": "9",
    "text": "[Fyra verser beskriver nu röken från Leviatans nos och gap:]"
  },
  {
    "id": 34353,
    "book": "job                                     ",
    "chapter": "41",
    "verse": "10",
    "text": "Ur hans gap kommer eldslågor,"
  },
  {
    "id": 34354,
    "book": "job                                     ",
    "chapter": "41",
    "verse": "11",
    "text": "Ur hans näsborrar stiger rök,"
  },
  {
    "id": 34355,
    "book": "job                                     ",
    "chapter": "41",
    "verse": "12",
    "text": "Hans andedräkt kan antända kol,"
  },
  {
    "id": 34356,
    "book": "job                                     ",
    "chapter": "41",
    "verse": "13",
    "text": "På hans nacke bor styrkan,"
  },
  {
    "id": 34357,
    "book": "job                                     ",
    "chapter": "41",
    "verse": "14",
    "text": "Hans hudveck (överhäng) sitter fast mot varandra,"
  },
  {
    "id": 34358,
    "book": "job                                     ",
    "chapter": "41",
    "verse": "15",
    "text": "Hans hjärta är hårt som sten [han är grym],"
  },
  {
    "id": 34359,
    "book": "job                                     ",
    "chapter": "41",
    "verse": "16",
    "text": "När han reser sig [för att attackera eller försvara sig] bävar gudarna (de mäktiga),"
  },
  {
    "id": 34360,
    "book": "job                                     ",
    "chapter": "41",
    "verse": "17",
    "text": "[Tre verser beskriver hur vanliga vapen inte biter på Leviatan:]"
  },
  {
    "id": 34361,
    "book": "job                                     ",
    "chapter": "41",
    "verse": "18",
    "text": "Han betraktar järn som halm,"
  },
  {
    "id": 34362,
    "book": "job                                     ",
    "chapter": "41",
    "verse": "19",
    "text": "Pilar skrämmer inte bort honom,"
  },
  {
    "id": 34363,
    "book": "job                                     ",
    "chapter": "41",
    "verse": "20",
    "text": "Stridsklubbor betraktar han som halmstrån,"
  },
  {
    "id": 34364,
    "book": "job                                     ",
    "chapter": "41",
    "verse": "21",
    "text": "[Följande tre verser beskriver hur Leviatan rör sig både på land och i vatten.]"
  },
  {
    "id": 34365,
    "book": "job                                     ",
    "chapter": "41",
    "verse": "22",
    "text": "Han får djupet att koka som en gryta,"
  },
  {
    "id": 34366,
    "book": "job                                     ",
    "chapter": "41",
    "verse": "23",
    "text": "Efter honom går ett lysande stråk,"
  },
  {
    "id": 34367,
    "book": "job                                     ",
    "chapter": "41",
    "verse": "24",
    "text": "[Följande två verser avslutar beskrivningen av Leviatan:]"
  },
  {
    "id": 34368,
    "book": "job                                     ",
    "chapter": "41",
    "verse": "25",
    "text": "Han ser på allt som är upphöjt,"
  }
]