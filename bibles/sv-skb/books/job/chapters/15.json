[
  {
    "id": 33650,
    "book": "job                                     ",
    "chapter": "15",
    "verse": "1",
    "text": "Sedan tog Elifaz – temaniten [Job 2:11], till orda och sade [svarade Job]:"
  },
  {
    "id": 33651,
    "book": "job                                     ",
    "chapter": "15",
    "verse": "2",
    "text": "Ska en vis [man som du Job] svara med ”blåsig” (flyktig – hebr. roach) kunskap"
  },
  {
    "id": 33652,
    "book": "job                                     ",
    "chapter": "15",
    "verse": "3",
    "text": "Ska han diskutera prat (hebr. milah) utan vinning (ord utan vara till nytta)"
  },
  {
    "id": 33653,
    "book": "job                                     ",
    "chapter": "15",
    "verse": "4",
    "text": "Ja, du gör gudsfruktan om intet"
  },
  {
    "id": 33654,
    "book": "job                                     ",
    "chapter": "15",
    "verse": "5",
    "text": "Eftersom din missgärning (hebr. avon) lär din mun"
  },
  {
    "id": 33655,
    "book": "job                                     ",
    "chapter": "15",
    "verse": "6",
    "text": "Din egen mun fördömer dig och inte jag,"
  },
  {
    "id": 33656,
    "book": "job                                     ",
    "chapter": "15",
    "verse": "7",
    "text": "Är du den första människa (hebr. adam) som föddes,"
  },
  {
    "id": 33657,
    "book": "job                                     ",
    "chapter": "15",
    "verse": "8",
    "text": "Har du lyssnat på Guds (Elohas) rådslut?"
  },
  {
    "id": 33658,
    "book": "job                                     ",
    "chapter": "15",
    "verse": "9",
    "text": "Vad vet du som vi inte vet?"
  },
  {
    "id": 33659,
    "book": "job                                     ",
    "chapter": "15",
    "verse": "10",
    "text": "Bland oss är både den gråhårige och åldringen (den skröplige – hebr. jashish),"
  },
  {
    "id": 33660,
    "book": "job                                     ",
    "chapter": "15",
    "verse": "11",
    "text": "Är Guds (Els) rådslut för små för dig"
  },
  {
    "id": 33661,
    "book": "job                                     ",
    "chapter": "15",
    "verse": "12",
    "text": "Varför bär ditt hjärta bort dig?"
  },
  {
    "id": 33662,
    "book": "job                                     ",
    "chapter": "15",
    "verse": "13",
    "text": "Eftersom du vänder din ande [stormar som en vind – i vrede] mot Gud (El)"
  },
  {
    "id": 33663,
    "book": "job                                     ",
    "chapter": "15",
    "verse": "14",
    "text": "Vad är en man,"
  },
  {
    "id": 33664,
    "book": "job                                     ",
    "chapter": "15",
    "verse": "15",
    "text": "Se, i sina heliga har han ingen tillit,"
  },
  {
    "id": 33665,
    "book": "job                                     ",
    "chapter": "15",
    "verse": "16",
    "text": "Hur mycket mindre den som är avskyvärd och oren,"
  },
  {
    "id": 33666,
    "book": "job                                     ",
    "chapter": "15",
    "verse": "17",
    "text": "Jag ska visa dig, lyssna till mig"
  },
  {
    "id": 33667,
    "book": "job                                     ",
    "chapter": "15",
    "verse": "18",
    "text": "Vilken vis man har förkunnat det"
  },
  {
    "id": 33668,
    "book": "job                                     ",
    "chapter": "15",
    "verse": "19",
    "text": "Till dem, bara (endast) till dem, är landet givet"
  },
  {
    "id": 33669,
    "book": "job                                     ",
    "chapter": "15",
    "verse": "20",
    "text": "Alla sina dagar våndas den onde med smärta"
  },
  {
    "id": 33670,
    "book": "job                                     ",
    "chapter": "15",
    "verse": "21",
    "text": "En skräckens röst är i hans öron,"
  },
  {
    "id": 33671,
    "book": "job                                     ",
    "chapter": "15",
    "verse": "22",
    "text": "Han tror inte när han återvänder från mörkret"
  },
  {
    "id": 33672,
    "book": "job                                     ",
    "chapter": "15",
    "verse": "23",
    "text": "Han vandrar hit och dit efter bröd. Var? (Var finns det?)"
  },
  {
    "id": 33673,
    "book": "job                                     ",
    "chapter": "15",
    "verse": "24",
    "text": "Fruktan och trångmål tränger honom,"
  },
  {
    "id": 33674,
    "book": "job                                     ",
    "chapter": "15",
    "verse": "25",
    "text": "eftersom han har sträckt ut sin hand mot Gud (El)"
  },
  {
    "id": 33675,
    "book": "job                                     ",
    "chapter": "15",
    "verse": "26",
    "text": "Han springer mot honom trosigt (med styv nacke)"
  },
  {
    "id": 33676,
    "book": "job                                     ",
    "chapter": "15",
    "verse": "27",
    "text": "För han har täckt sitt ansikte med fett (fetma, överflöd)"
  },
  {
    "id": 33677,
    "book": "job                                     ",
    "chapter": "15",
    "verse": "28",
    "text": "Och han bor i öde städer,"
  },
  {
    "id": 33678,
    "book": "job                                     ",
    "chapter": "15",
    "verse": "29",
    "text": "Han ska inte bli rik, hans ägodelar ska inte bestå"
  },
  {
    "id": 33679,
    "book": "job                                     ",
    "chapter": "15",
    "verse": "30",
    "text": "Han ska inte lämna mörkret, lågan ska torka ut hans grenar och hans muns andedräkt ska tas bort."
  },
  {
    "id": 33680,
    "book": "job                                     ",
    "chapter": "15",
    "verse": "31",
    "text": "Låt honom inte lita på tomhet (falskhet, fåfänga – hebr. shav)"
  },
  {
    "id": 33681,
    "book": "job                                     ",
    "chapter": "15",
    "verse": "32",
    "text": "Hans dag ska inte bli full"
  },
  {
    "id": 33682,
    "book": "job                                     ",
    "chapter": "15",
    "verse": "33",
    "text": "Han ska skaka av sig de omogna druvorna"
  },
  {
    "id": 33683,
    "book": "job                                     ",
    "chapter": "15",
    "verse": "34",
    "text": "De gudlösas församling ska bli öde"
  },
  {
    "id": 33684,
    "book": "job                                     ",
    "chapter": "15",
    "verse": "35",
    "text": "De blir gravida med missfall"
  }
]