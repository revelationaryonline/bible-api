[
  {
    "id": 33498,
    "book": "job                                     ",
    "chapter": "9",
    "verse": "1",
    "text": "Då svarade Job och sade:"
  },
  {
    "id": 33499,
    "book": "job                                     ",
    "chapter": "9",
    "verse": "2",
    "text": "I sanning vet jag att det är så,"
  },
  {
    "id": 33500,
    "book": "job                                     ",
    "chapter": "9",
    "verse": "3",
    "text": "Om någon skulle vilja tävla (mäta sig) med honom,"
  },
  {
    "id": 33501,
    "book": "job                                     ",
    "chapter": "9",
    "verse": "4",
    "text": "Hans [Guds] hjärta är vist, hans kraft är väldig,"
  },
  {
    "id": 33502,
    "book": "job                                     ",
    "chapter": "9",
    "verse": "5",
    "text": "Han [Gud] flyttar berg [jordbävning] innan de vet det [det sker plötsligt],"
  },
  {
    "id": 33503,
    "book": "job                                     ",
    "chapter": "9",
    "verse": "6",
    "text": "Han skakar jorden så den vacklar från sin plats,"
  },
  {
    "id": 33504,
    "book": "job                                     ",
    "chapter": "9",
    "verse": "7",
    "text": "Han beordrar solen, så den inte skiner (stiger upp),"
  },
  {
    "id": 33505,
    "book": "job                                     ",
    "chapter": "9",
    "verse": "8",
    "text": "Det är bara han [Gud] som kan spänna ut himlarna (expandera universum),"
  },
  {
    "id": 33506,
    "book": "job                                     ",
    "chapter": "9",
    "verse": "9",
    "text": "Vem har skapat Björnen, Orion"
  },
  {
    "id": 33507,
    "book": "job                                     ",
    "chapter": "9",
    "verse": "10",
    "text": "gör stora ting som inte kan utforskas"
  },
  {
    "id": 33508,
    "book": "job                                     ",
    "chapter": "9",
    "verse": "11",
    "text": "Se, han går med mig och jag ser honom inte;"
  },
  {
    "id": 33509,
    "book": "job                                     ",
    "chapter": "9",
    "verse": "12",
    "text": "Se, han rycker undan, vem kan hindra honom?"
  },
  {
    "id": 33510,
    "book": "job                                     ",
    "chapter": "9",
    "verse": "13",
    "text": "Gud (Eloha) ska inte dra tillbaka sin vrede,"
  },
  {
    "id": 33511,
    "book": "job                                     ",
    "chapter": "9",
    "verse": "14",
    "text": "Hur mycket mindre ska jag svara honom"
  },
  {
    "id": 33512,
    "book": "job                                     ",
    "chapter": "9",
    "verse": "15",
    "text": "Även om jag vore rättfärdig skulle jag inte svara."
  },
  {
    "id": 33513,
    "book": "job                                     ",
    "chapter": "9",
    "verse": "16",
    "text": "Om jag ropade och han svarade mig,"
  },
  {
    "id": 33514,
    "book": "job                                     ",
    "chapter": "9",
    "verse": "17",
    "text": "Han som bryter ner mig med en storm [Job 38:1]"
  },
  {
    "id": 33515,
    "book": "job                                     ",
    "chapter": "9",
    "verse": "18",
    "text": "han ger mig inte att hämta andan,"
  },
  {
    "id": 33516,
    "book": "job                                     ",
    "chapter": "9",
    "verse": "19",
    "text": "Om det handlar om styrka (koach) är han mäktig (amits)."
  },
  {
    "id": 33517,
    "book": "job                                     ",
    "chapter": "9",
    "verse": "20",
    "text": "Om jag är rättfärdig dömer mig min egen mun."
  },
  {
    "id": 33518,
    "book": "job                                     ",
    "chapter": "9",
    "verse": "21",
    "text": "Är jag ren (hebr. tam), jag vet att min själ inte är det,"
  },
  {
    "id": 33519,
    "book": "job                                     ",
    "chapter": "9",
    "verse": "22",
    "text": "Det hör ihop (ordagrant det är ett), därför säger jag:"
  },
  {
    "id": 33520,
    "book": "job                                     ",
    "chapter": "9",
    "verse": "23",
    "text": "Om gisslet slår plötsligt (oväntat),"
  },
  {
    "id": 33521,
    "book": "job                                     ",
    "chapter": "9",
    "verse": "24",
    "text": "Jorden är given i de ondas hand."
  },
  {
    "id": 33522,
    "book": "job                                     ",
    "chapter": "9",
    "verse": "25",
    "text": "Och mina dagar är lätta, de springer ifrån mig [Job 7:7],"
  },
  {
    "id": 33523,
    "book": "job                                     ",
    "chapter": "9",
    "verse": "26",
    "text": "De drar förbi som ett snabbt skepp,"
  },
  {
    "id": 33524,
    "book": "job                                     ",
    "chapter": "9",
    "verse": "27",
    "text": "Om jag säger: Jag ska glömma mina klagomål,"
  },
  {
    "id": 33525,
    "book": "job                                     ",
    "chapter": "9",
    "verse": "28",
    "text": "är jag rädd för alla mina smärtor."
  },
  {
    "id": 33526,
    "book": "job                                     ",
    "chapter": "9",
    "verse": "29",
    "text": "Jag kommer att dömas,"
  },
  {
    "id": 33527,
    "book": "job                                     ",
    "chapter": "9",
    "verse": "30",
    "text": "Om jag tvättar mig med snö"
  },
  {
    "id": 33528,
    "book": "job                                     ",
    "chapter": "9",
    "verse": "31",
    "text": "ska du kasta mig i diket"
  },
  {
    "id": 33529,
    "book": "job                                     ",
    "chapter": "9",
    "verse": "32",
    "text": "För han är inte en man som jag är, att jag kan svara honom,"
  },
  {
    "id": 33530,
    "book": "job                                     ",
    "chapter": "9",
    "verse": "33",
    "text": "Det finns ingen skiljedomare emellan oss"
  },
  {
    "id": 33531,
    "book": "job                                     ",
    "chapter": "9",
    "verse": "34",
    "text": "Låt honom ta bort sin käpp [kortare klubba för att försvara fåren] från mig [Ps 23:4; Job 21:9]"
  },
  {
    "id": 33532,
    "book": "job                                     ",
    "chapter": "9",
    "verse": "35",
    "text": "då ska jag tala och inte vara rädd för honom,"
  }
]