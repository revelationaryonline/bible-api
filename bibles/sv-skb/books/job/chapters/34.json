[
  {
    "id": 34130,
    "book": "job                                     ",
    "chapter": "34",
    "verse": "1",
    "text": "Och Eliho svarade och sade [upprepar liknande formulering som riktades direkt till Job i som i Job 32:1]:"
  },
  {
    "id": 34131,
    "book": "job                                     ",
    "chapter": "34",
    "verse": "2",
    "text": "Hör (lyssna), ni visa män, på mitt prat (mina ord – hebr. milah)"
  },
  {
    "id": 34132,
    "book": "job                                     ",
    "chapter": "34",
    "verse": "3",
    "text": "För örat prövar pratet (orden – hebr. milah),"
  },
  {
    "id": 34133,
    "book": "job                                     ",
    "chapter": "34",
    "verse": "4",
    "text": "Låt oss döma åt oss det som är rätt,"
  },
  {
    "id": 34134,
    "book": "job                                     ",
    "chapter": "34",
    "verse": "5",
    "text": "eftersom Job har sagt: ”Jag är rättfärdig"
  },
  {
    "id": 34135,
    "book": "job                                     ",
    "chapter": "34",
    "verse": "6",
    "text": "trots min rätt hålls jag för en lögnare,"
  },
  {
    "id": 34136,
    "book": "job                                     ",
    "chapter": "34",
    "verse": "7",
    "text": "Vilken man (stridsman – en man i sina bästa år – full av egen styrka och kraft) är lik Job"
  },
  {
    "id": 34137,
    "book": "job                                     ",
    "chapter": "34",
    "verse": "8",
    "text": "Vem vandrar tillsammans med den som gör synd"
  },
  {
    "id": 34138,
    "book": "job                                     ",
    "chapter": "34",
    "verse": "9",
    "text": "Eftersom han säger: ’Det gagnar en man (stridsman – en man i sina bästa år – full av egen styrka och kraft)"
  },
  {
    "id": 34139,
    "book": "job                                     ",
    "chapter": "34",
    "verse": "10",
    "text": "Därför hjärtats män, lyssna till mig:"
  },
  {
    "id": 34140,
    "book": "job                                     ",
    "chapter": "34",
    "verse": "11",
    "text": "För en människas arbete ska han löna honom,"
  },
  {
    "id": 34141,
    "book": "job                                     ",
    "chapter": "34",
    "verse": "12",
    "text": "Säkerligen ska Gud (El) inte göra något ont"
  },
  {
    "id": 34142,
    "book": "job                                     ",
    "chapter": "34",
    "verse": "13",
    "text": "Vem gav honom befallning över jorden?"
  },
  {
    "id": 34143,
    "book": "job                                     ",
    "chapter": "34",
    "verse": "14",
    "text": "Om han skulle lägga sitt hjärta på honom"
  },
  {
    "id": 34144,
    "book": "job                                     ",
    "chapter": "34",
    "verse": "15",
    "text": "Allt kött ska förgås tillsammans [Ps 104:29]"
  },
  {
    "id": 34145,
    "book": "job                                     ",
    "chapter": "34",
    "verse": "16",
    "text": "Och om du har förstått, hör detta,"
  },
  {
    "id": 34146,
    "book": "job                                     ",
    "chapter": "34",
    "verse": "17",
    "text": "Ska den som hatar rätt regera?"
  },
  {
    "id": 34147,
    "book": "job                                     ",
    "chapter": "34",
    "verse": "18",
    "text": "Är det lämpligt att säga till en kung: ”Du är usel?”"
  },
  {
    "id": 34148,
    "book": "job                                     ",
    "chapter": "34",
    "verse": "19",
    "text": "Det tillkommer inte furstar att ta hänsyn till de rika mer än de fattiga,"
  },
  {
    "id": 34149,
    "book": "job                                     ",
    "chapter": "34",
    "verse": "20",
    "text": "På ett ögonblick dör de, vid midnatt,"
  },
  {
    "id": 34150,
    "book": "job                                     ",
    "chapter": "34",
    "verse": "21",
    "text": "Eftersom hans ögon är över mannens vägar"
  },
  {
    "id": 34151,
    "book": "job                                     ",
    "chapter": "34",
    "verse": "22",
    "text": "Det finns inget mörker, ingen dödens skugga"
  },
  {
    "id": 34152,
    "book": "job                                     ",
    "chapter": "34",
    "verse": "23",
    "text": "Eftersom han har bestämt en tid över varje man,"
  },
  {
    "id": 34153,
    "book": "job                                     ",
    "chapter": "34",
    "verse": "24",
    "text": "Han bryter mäktiga (kabir) i bitar utan undersökning"
  },
  {
    "id": 34154,
    "book": "job                                     ",
    "chapter": "34",
    "verse": "25",
    "text": "Därför granskar han deras arbete"
  },
  {
    "id": 34155,
    "book": "job                                     ",
    "chapter": "34",
    "verse": "26",
    "text": "Han slår de onda (moraliskt förfallna)"
  },
  {
    "id": 34156,
    "book": "job                                     ",
    "chapter": "34",
    "verse": "27",
    "text": "Eftersom de vände bort från att följa honom"
  },
  {
    "id": 34157,
    "book": "job                                     ",
    "chapter": "34",
    "verse": "28",
    "text": "så att de fick den fattiges rop att komma upp till honom,"
  },
  {
    "id": 34158,
    "book": "job                                     ",
    "chapter": "34",
    "verse": "29",
    "text": "Och han ger vila och vem kan fördöma?"
  },
  {
    "id": 34159,
    "book": "job                                     ",
    "chapter": "34",
    "verse": "30",
    "text": "för att en gudlös människa inte ska regera"
  },
  {
    "id": 34160,
    "book": "job                                     ",
    "chapter": "34",
    "verse": "31",
    "text": "Antar till Gud (El) och säger:"
  },
  {
    "id": 34161,
    "book": "job                                     ",
    "chapter": "34",
    "verse": "32",
    "text": "utan att se att du undervisat mig,"
  },
  {
    "id": 34162,
    "book": "job                                     ",
    "chapter": "34",
    "verse": "33",
    "text": "Ska du avvisa hans belöning?"
  },
  {
    "id": 34163,
    "book": "job                                     ",
    "chapter": "34",
    "verse": "34",
    "text": "Hjärtats män ska säga till mig"
  },
  {
    "id": 34164,
    "book": "job                                     ",
    "chapter": "34",
    "verse": "35",
    "text": "Job talar utan kunskap"
  },
  {
    "id": 34165,
    "book": "job                                     ",
    "chapter": "34",
    "verse": "36",
    "text": "Är önskan att pröva Job till slutet,"
  },
  {
    "id": 34166,
    "book": "job                                     ",
    "chapter": "34",
    "verse": "37",
    "text": "för han lägger upproriskhet till sin överträdelse,"
  }
]