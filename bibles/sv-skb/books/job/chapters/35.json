[
  {
    "id": 34167,
    "book": "job                                     ",
    "chapter": "35",
    "verse": "1",
    "text": "Eliho tog till orda och sade:"
  },
  {
    "id": 34168,
    "book": "job                                     ",
    "chapter": "35",
    "verse": "2",
    "text": "Tycker du att du har rätt [när] du säger:"
  },
  {
    "id": 34169,
    "book": "job                                     ",
    "chapter": "35",
    "verse": "3",
    "text": "eftersom du säger:"
  },
  {
    "id": 34170,
    "book": "job                                     ",
    "chapter": "35",
    "verse": "4",
    "text": "Jag, jag ska bemöta ditt babbel (hebr. milah)"
  },
  {
    "id": 34171,
    "book": "job                                     ",
    "chapter": "35",
    "verse": "5",
    "text": "Blicka upp mot himlarna och se [Job],"
  },
  {
    "id": 34172,
    "book": "job                                     ",
    "chapter": "35",
    "verse": "6",
    "text": "Om du syndar (missar målet – hebr. chata), vad gör (verkar – hebr. paal) du då för honom?"
  },
  {
    "id": 34173,
    "book": "job                                     ",
    "chapter": "35",
    "verse": "7",
    "text": "Om du är rättfärdig, vad ger (hebr. natan) du honom,"
  },
  {
    "id": 34174,
    "book": "job                                     ",
    "chapter": "35",
    "verse": "8",
    "text": "Din ondska påverkar en man (hebr. ish) som du [din medmänniska, inte Gud],"
  },
  {
    "id": 34175,
    "book": "job                                     ",
    "chapter": "35",
    "verse": "9",
    "text": "I överflöd"
  },
  {
    "id": 34176,
    "book": "job                                     ",
    "chapter": "35",
    "verse": "10",
    "text": "Men ingen frågar: ”Var är Gud (Eloha) som har gjort (format; insatt – hebr. asha) mig,"
  },
  {
    "id": 34177,
    "book": "job                                     ",
    "chapter": "35",
    "verse": "11",
    "text": "lär (undervisa – hebr. alaf) oss"
  },
  {
    "id": 34178,
    "book": "job                                     ",
    "chapter": "35",
    "verse": "12",
    "text": "Då man högljutt skriar (hebr. tsaaq), men han inte svarar,"
  },
  {
    "id": 34179,
    "book": "job                                     ",
    "chapter": "35",
    "verse": "13",
    "text": "Med säkerhet – tomhet, nej det hör inte Gud (El),"
  },
  {
    "id": 34180,
    "book": "job                                     ",
    "chapter": "35",
    "verse": "14",
    "text": "Helt säkert, även om du säger att du inte ser honom, ligger din sak inför honom,"
  },
  {
    "id": 34181,
    "book": "job                                     ",
    "chapter": "35",
    "verse": "15",
    "text": "och nu [eftersom du säger], att han inte straffar i vrede"
  },
  {
    "id": 34182,
    "book": "job                                     ",
    "chapter": "35",
    "verse": "16",
    "text": "[Eliho vänder sig nu från Job, och pratar om honom till de som står runt:]"
  }
]