[
  {
    "id": 33928,
    "book": "job                                     ",
    "chapter": "27",
    "verse": "1",
    "text": "Då tog Job upp sitt talesätt (började han tala i bilder och ordspråk, ofta med många bottnar; ibland även profetiskt – hebr. mashal) och sade:"
  },
  {
    "id": 33929,
    "book": "job                                     ",
    "chapter": "27",
    "verse": "2",
    "text": "Så sant Gud (El) lever, han som undanhållit mig min rätt,"
  },
  {
    "id": 33930,
    "book": "job                                     ",
    "chapter": "27",
    "verse": "3",
    "text": "– för så länge jag har min livsande i mig [1 Mos 2:7]"
  },
  {
    "id": 33931,
    "book": "job                                     ",
    "chapter": "27",
    "verse": "4",
    "text": "aldrig att mina läppar skulle tala orätt"
  },
  {
    "id": 33932,
    "book": "job                                     ",
    "chapter": "27",
    "verse": "5",
    "text": "Låt det vara fjärran från mig att jag skulle ge er rätt!"
  },
  {
    "id": 33933,
    "book": "job                                     ",
    "chapter": "27",
    "verse": "6",
    "text": "Jag håller fast vid min rättfärdighet och släpper den inte,"
  },
  {
    "id": 33934,
    "book": "job                                     ",
    "chapter": "27",
    "verse": "7",
    "text": "Låt min fiende stå som den skyldige,"
  },
  {
    "id": 33935,
    "book": "job                                     ",
    "chapter": "27",
    "verse": "8",
    "text": "För var är den gudlöses (hycklarens) hopp när han skärs bort (hebr. batsa),"
  },
  {
    "id": 33936,
    "book": "job                                     ",
    "chapter": "27",
    "verse": "9",
    "text": "Kommer Gud (El) att höra hans rop"
  },
  {
    "id": 33937,
    "book": "job                                     ",
    "chapter": "27",
    "verse": "10",
    "text": "Kan han glädja sig över den Allsmäktige (Shaddaj)?"
  },
  {
    "id": 33938,
    "book": "job                                     ",
    "chapter": "27",
    "verse": "11",
    "text": "Jag vill lära er om Guds (Els) hand,"
  },
  {
    "id": 33939,
    "book": "job                                     ",
    "chapter": "27",
    "verse": "12",
    "text": "Se, ni har ju själva alla sett det,"
  },
  {
    "id": 33940,
    "book": "job                                     ",
    "chapter": "27",
    "verse": "13",
    "text": "Detta är den onda människans lott hos Gud (El),"
  },
  {
    "id": 33941,
    "book": "job                                     ",
    "chapter": "27",
    "verse": "14",
    "text": "Om hans barn blir många – [så är det] för svärdet,"
  },
  {
    "id": 33942,
    "book": "job                                     ",
    "chapter": "27",
    "verse": "15",
    "text": "De som överlever honom läggs i graven genom död [dödlig sjukdom]"
  },
  {
    "id": 33943,
    "book": "job                                     ",
    "chapter": "27",
    "verse": "16",
    "text": "Om han samlar silver som stoft"
  },
  {
    "id": 33944,
    "book": "job                                     ",
    "chapter": "27",
    "verse": "17",
    "text": "Fastställd (bestämd – hebr. kon) och rättfärdig blir han påklädd"
  },
  {
    "id": 33945,
    "book": "job                                     ",
    "chapter": "27",
    "verse": "18",
    "text": "Han bygger sitt hus som en mal,"
  },
  {
    "id": 33946,
    "book": "job                                     ",
    "chapter": "27",
    "verse": "19",
    "text": "Rik går han till sängs – och samlar inte [mer],"
  },
  {
    "id": 33947,
    "book": "job                                     ",
    "chapter": "27",
    "verse": "20",
    "text": "Som vatten [vågornas kraft eller störtfloden] griper fasorna honom,"
  },
  {
    "id": 33948,
    "book": "job                                     ",
    "chapter": "27",
    "verse": "21",
    "text": "Östanvinden lyfter honom och han är borta,"
  },
  {
    "id": 33949,
    "book": "job                                     ",
    "chapter": "27",
    "verse": "22",
    "text": "Den vräker sig mot honom utan förskoning,"
  },
  {
    "id": 33950,
    "book": "job                                     ",
    "chapter": "27",
    "verse": "23",
    "text": "Den klappar (hebr. safaq) sina händer mot honom"
  }
]