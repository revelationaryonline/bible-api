[
  {
    "id": 34278,
    "book": "job                                     ",
    "chapter": "39",
    "verse": "1",
    "text": "Är det du som jagar byte för lejonhonan,"
  },
  {
    "id": 34279,
    "book": "job                                     ",
    "chapter": "39",
    "verse": "2",
    "text": "när de kurar i sina boningar (hebr. meonah),"
  },
  {
    "id": 34280,
    "book": "job                                     ",
    "chapter": "39",
    "verse": "3",
    "text": "Vem är det som förser korpen med mat,"
  },
  {
    "id": 34281,
    "book": "job                                     ",
    "chapter": "39",
    "verse": "4",
    "text": "Vet du tidpunkten när stenbockarna (stengetterna) ska föda?"
  },
  {
    "id": 34282,
    "book": "job                                     ",
    "chapter": "39",
    "verse": "5",
    "text": "Räknar du månaderna de går dräktiga?"
  },
  {
    "id": 34283,
    "book": "job                                     ",
    "chapter": "39",
    "verse": "6",
    "text": "De böjer sig ner,"
  },
  {
    "id": 34284,
    "book": "job                                     ",
    "chapter": "39",
    "verse": "7",
    "text": "Deras ungar blir starka (lägger på sig),"
  },
  {
    "id": 34285,
    "book": "job                                     ",
    "chapter": "39",
    "verse": "8",
    "text": "Vem har gett vildåsnan sin frihet,"
  },
  {
    "id": 34286,
    "book": "job                                     ",
    "chapter": "39",
    "verse": "9",
    "text": "Jag gav henne öknen [den torra stäppen] som hem,"
  },
  {
    "id": 34287,
    "book": "job                                     ",
    "chapter": "39",
    "verse": "10",
    "text": "Hon ler åt stadens buller,"
  },
  {
    "id": 34288,
    "book": "job                                     ",
    "chapter": "39",
    "verse": "11",
    "text": "Hon spanar upp mot bergskullarna efter bete,"
  },
  {
    "id": 34289,
    "book": "job                                     ",
    "chapter": "39",
    "verse": "12",
    "text": "Skulle vildoxen (buffeln) vilja bli din tjänare?"
  },
  {
    "id": 34290,
    "book": "job                                     ",
    "chapter": "39",
    "verse": "13",
    "text": "Kan du tvinga vildoxen att gå i fåran med töm,"
  },
  {
    "id": 34291,
    "book": "job                                     ",
    "chapter": "39",
    "verse": "14",
    "text": "Kan du lita på honom, hans styrka är ju stor?"
  },
  {
    "id": 34292,
    "book": "job                                     ",
    "chapter": "39",
    "verse": "15",
    "text": "Vågar du anförtro honom att föra hem din säd,"
  },
  {
    "id": 34293,
    "book": "job                                     ",
    "chapter": "39",
    "verse": "16",
    "text": "Strutsarna (”gladsångarna” – hebr. renanim) flaxar glatt (stolt) med sina vingar,"
  },
  {
    "id": 34294,
    "book": "job                                     ",
    "chapter": "39",
    "verse": "17",
    "text": "Hon lämnar ju sina ägg på marken,"
  },
  {
    "id": 34295,
    "book": "job                                     ",
    "chapter": "39",
    "verse": "18",
    "text": "Hon glömmer (tänker inte på) att en fot kan krossa dem,"
  },
  {
    "id": 34296,
    "book": "job                                     ",
    "chapter": "39",
    "verse": "19",
    "text": "Hon är hård (grym) mot sina barn,"
  },
  {
    "id": 34297,
    "book": "job                                     ",
    "chapter": "39",
    "verse": "20",
    "text": "för Gud (Eloha) har gjort så hon glömmer (låtit henne vara underprivilegierad vad det gäller) vishet,"
  },
  {
    "id": 34298,
    "book": "job                                     ",
    "chapter": "39",
    "verse": "21",
    "text": "Men när hon reser på sig [för att springa],"
  },
  {
    "id": 34299,
    "book": "job                                     ",
    "chapter": "39",
    "verse": "22",
    "text": "Har du gett hästen dess styrka?"
  },
  {
    "id": 34300,
    "book": "job                                     ",
    "chapter": "39",
    "verse": "23",
    "text": "Är det du som lärt honom hoppa likt gräshoppor [när han galopperar fram som en svärm gräshoppor]?"
  },
  {
    "id": 34301,
    "book": "job                                     ",
    "chapter": "39",
    "verse": "24",
    "text": "De [stridshästarna] skrapar [rastlöst, ivrigt] med hovarna i dalen"
  },
  {
    "id": 34302,
    "book": "job                                     ",
    "chapter": "39",
    "verse": "25",
    "text": "Han ler åt fruktan och känner ingen rädsla,"
  },
  {
    "id": 34303,
    "book": "job                                     ",
    "chapter": "39",
    "verse": "26",
    "text": "Runt honom rasslar det av koger,"
  },
  {
    "id": 34304,
    "book": "job                                     ",
    "chapter": "39",
    "verse": "27",
    "text": "I upphetsning och otålighet intar han marken,"
  },
  {
    "id": 34305,
    "book": "job                                     ",
    "chapter": "39",
    "verse": "28",
    "text": "För varje shofarstöt frustar han högt [säger ”haha”; hebreiska ordet heach, som imiterar hästens frustande och gnäggande ljud],"
  },
  {
    "id": 34306,
    "book": "job                                     ",
    "chapter": "39",
    "verse": "29",
    "text": "Är det din vishet som får höken (falken – hebr. nets) att flyga"
  },
  {
    "id": 34307,
    "book": "job                                     ",
    "chapter": "39",
    "verse": "30",
    "text": "Är det på din befallning som örnen svävar högt i skyn,"
  },
  {
    "id": 34308,
    "book": "job                                     ",
    "chapter": "39",
    "verse": "31",
    "text": "På klippan har han sitt tillhåll där han spenderar natten,"
  },
  {
    "id": 34309,
    "book": "job                                     ",
    "chapter": "39",
    "verse": "32",
    "text": "Därifrån spanar han efter föda,"
  },
  {
    "id": 34310,
    "book": "job                                     ",
    "chapter": "39",
    "verse": "33",
    "text": "Hans ungar festar på blod (sliter stycken)."
  },
  {
    "id": 34311,
    "book": "job                                     ",
    "chapter": "39",
    "verse": "34",
    "text": "Herren svarade Job och sade:"
  },
  {
    "id": 34312,
    "book": "job                                     ",
    "chapter": "39",
    "verse": "35",
    "text": "Ska du, den som tvistar med den Väldige (Allsmäktige – hebr. Shaddaj), tillrättavisa honom?"
  },
  {
    "id": 34313,
    "book": "job                                     ",
    "chapter": "39",
    "verse": "36",
    "text": "Job svarade Herren och sade:"
  },
  {
    "id": 34314,
    "book": "job                                     ",
    "chapter": "39",
    "verse": "37",
    "text": "Se (så är det verkligen), jag är inte värdig (jag är liten),"
  },
  {
    "id": 34315,
    "book": "job                                     ",
    "chapter": "39",
    "verse": "38",
    "text": "En gång har jag talat, men jag säger inget mer,"
  }
]