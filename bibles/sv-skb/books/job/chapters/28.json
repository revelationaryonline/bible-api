[
  {
    "id": 33951,
    "book": "job                                     ",
    "chapter": "28",
    "verse": "1",
    "text": "Ja, det finns"
  },
  {
    "id": 33952,
    "book": "job                                     ",
    "chapter": "28",
    "verse": "2",
    "text": "Järn hämtas upp ur jorden,"
  },
  {
    "id": 33953,
    "book": "job                                     ",
    "chapter": "28",
    "verse": "3",
    "text": "Han [människan] sätter gränser för mörkret (hebr. choshech) [när facklor ger ljus i gruvgångar]"
  },
  {
    "id": 33954,
    "book": "job                                     ",
    "chapter": "28",
    "verse": "4",
    "text": "De spränger schakt långt från människors boningar,"
  },
  {
    "id": 33955,
    "book": "job                                     ",
    "chapter": "28",
    "verse": "5",
    "text": "Från jorden kommer bröd [ovan jord spirar och växer grödor],"
  },
  {
    "id": 33956,
    "book": "job                                     ",
    "chapter": "28",
    "verse": "6",
    "text": "Safiren har sin plats bland hennes stenar,"
  },
  {
    "id": 33957,
    "book": "job                                     ",
    "chapter": "28",
    "verse": "7",
    "text": "Stigen dit är inte känd av rovfågel,"
  },
  {
    "id": 33958,
    "book": "job                                     ",
    "chapter": "28",
    "verse": "8",
    "text": "Inte har söners stolthet (hebr. ben shachats) trampat på den,"
  },
  {
    "id": 33959,
    "book": "job                                     ",
    "chapter": "28",
    "verse": "9",
    "text": "På den hårda stenen lägger man sin hand"
  },
  {
    "id": 33960,
    "book": "job                                     ",
    "chapter": "28",
    "verse": "10",
    "text": "De hugger ut kanaler [för att leda ut vatten – gångar] i klipporna,"
  },
  {
    "id": 33961,
    "book": "job                                     ",
    "chapter": "28",
    "verse": "11",
    "text": "De stoppar upp vattenådrornas gråt,"
  },
  {
    "id": 33962,
    "book": "job                                     ",
    "chapter": "28",
    "verse": "12",
    "text": "Men visheten – var finns hon?"
  },
  {
    "id": 33963,
    "book": "job                                     ",
    "chapter": "28",
    "verse": "13",
    "text": "Nej, hennes värde (pris) känner inte en bräcklig människa ?"
  },
  {
    "id": 33964,
    "book": "job                                     ",
    "chapter": "28",
    "verse": "14",
    "text": "Djupet säger: ”Hon är inte i mig”,"
  },
  {
    "id": 33965,
    "book": "job                                     ",
    "chapter": "28",
    "verse": "15",
    "text": "Nej, hon kan inte fås för dyrbaraste guld (inneslutet; renat guld – hebr. segor),"
  },
  {
    "id": 33966,
    "book": "job                                     ",
    "chapter": "28",
    "verse": "16",
    "text": "Nej, hon kan inte betalas med guld från Ofir"
  },
  {
    "id": 33967,
    "book": "job                                     ",
    "chapter": "28",
    "verse": "17",
    "text": "Nej, hon kan inte jämföras med guld (hebr. zahav) och glas (kristall),"
  },
  {
    "id": 33968,
    "book": "job                                     ",
    "chapter": "28",
    "verse": "18",
    "text": "koraller [”höga saker”; röd korall, Hes 27:16] och kristall ska inte nämnas."
  },
  {
    "id": 33969,
    "book": "job                                     ",
    "chapter": "28",
    "verse": "19",
    "text": "Nej, topas från Kush [Etiopien] kan inte radas upp bredvid henne,"
  },
  {
    "id": 33970,
    "book": "job                                     ",
    "chapter": "28",
    "verse": "20",
    "text": "Men visheten – var kommer hon ifrån?"
  },
  {
    "id": 33971,
    "book": "job                                     ",
    "chapter": "28",
    "verse": "21",
    "text": "Hon är gömd för alla levandes ögon,"
  },
  {
    "id": 33972,
    "book": "job                                     ",
    "chapter": "28",
    "verse": "22",
    "text": "Abaddon (avgrunden, förgörelsens plats, se Ords 27:20; Job 26:6; Upp 9:11) och döden säger:"
  },
  {
    "id": 33973,
    "book": "job                                     ",
    "chapter": "28",
    "verse": "23",
    "text": "Gud (Elohim), han känner vägen till henne,"
  },
  {
    "id": 33974,
    "book": "job                                     ",
    "chapter": "28",
    "verse": "24",
    "text": "för han skådar till jordens ändar,"
  },
  {
    "id": 33975,
    "book": "job                                     ",
    "chapter": "28",
    "verse": "25",
    "text": "När han mätte upp vindens vikt"
  },
  {
    "id": 33976,
    "book": "job                                     ",
    "chapter": "28",
    "verse": "26",
    "text": "när han gjorde en stadga (lag – hebr. choq) [naturlag] för regnet"
  },
  {
    "id": 33977,
    "book": "job                                     ",
    "chapter": "28",
    "verse": "27",
    "text": "då såg han henne och uppenbarade henne,"
  },
  {
    "id": 33978,
    "book": "job                                     ",
    "chapter": "28",
    "verse": "28",
    "text": "Och till människan (hebr. adam) sade han:"
  }
]