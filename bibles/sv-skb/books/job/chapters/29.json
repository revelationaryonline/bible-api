[
  {
    "id": 33979,
    "book": "job                                     ",
    "chapter": "29",
    "verse": "1",
    "text": "Igen tog Job upp sitt talesätt (började han tala i bilder och ordspråk, ofta med många bottnar; ibland även profetiskt – hebr. mashal) och sade:"
  },
  {
    "id": 33980,
    "book": "job                                     ",
    "chapter": "29",
    "verse": "2",
    "text": "Om det ändå vore som i tidigare månader,"
  },
  {
    "id": 33981,
    "book": "job                                     ",
    "chapter": "29",
    "verse": "3",
    "text": "då hans lampa sken över mitt huvud [gav riktning och klarhet, se Job 22:28; 2 Mos 10:23],"
  },
  {
    "id": 33982,
    "book": "job                                     ",
    "chapter": "29",
    "verse": "4",
    "text": "Då jag var i min ”bästa årstids” dagar"
  },
  {
    "id": 33983,
    "book": "job                                     ",
    "chapter": "29",
    "verse": "5",
    "text": "då den Allsmäktige (Shaddaj) fortfarande var med mig"
  },
  {
    "id": 33984,
    "book": "job                                     ",
    "chapter": "29",
    "verse": "6",
    "text": "då mina fötter badade i gräddmjölk [bild från ett herdesamhälle; boskapen mjölkar i överflöd]"
  },
  {
    "id": 33985,
    "book": "job                                     ",
    "chapter": "29",
    "verse": "7",
    "text": "När jag gick till porten i staden"
  },
  {
    "id": 33986,
    "book": "job                                     ",
    "chapter": "29",
    "verse": "8",
    "text": "när de såg mig, drog de unga sig undan"
  },
  {
    "id": 33987,
    "book": "job                                     ",
    "chapter": "29",
    "verse": "9",
    "text": "Hövdingar (ledare – hebr. sar) höll tillbaka sitt prat (hebr. milah)"
  },
  {
    "id": 33988,
    "book": "job                                     ",
    "chapter": "29",
    "verse": "10",
    "text": "Rösten från furstar (hebr. nagid) försvann (drogs undan),"
  },
  {
    "id": 33989,
    "book": "job                                     ",
    "chapter": "29",
    "verse": "11",
    "text": "När ett öra hörde, prisade det mig lycklig,"
  },
  {
    "id": 33990,
    "book": "job                                     ",
    "chapter": "29",
    "verse": "12",
    "text": "eftersom jag räddade den fattige som ropade"
  },
  {
    "id": 33991,
    "book": "job                                     ",
    "chapter": "29",
    "verse": "13",
    "text": "Den döende välsignade mig,"
  },
  {
    "id": 33992,
    "book": "job                                     ",
    "chapter": "29",
    "verse": "14",
    "text": "Jag klädde mig i rättfärdighet och den var min klädnad,"
  },
  {
    "id": 33993,
    "book": "job                                     ",
    "chapter": "29",
    "verse": "15",
    "text": "Ögon var jag åt den blinde"
  },
  {
    "id": 33994,
    "book": "job                                     ",
    "chapter": "29",
    "verse": "16",
    "text": "Jag var en far för de i behov (fattig – hebr. evion)"
  },
  {
    "id": 33995,
    "book": "job                                     ",
    "chapter": "29",
    "verse": "17",
    "text": "Och jag krossade [med emfas] den orättfärdiges huggtänder (rovdjursgaddar – hebr. metalah)"
  },
  {
    "id": 33996,
    "book": "job                                     ",
    "chapter": "29",
    "verse": "18",
    "text": "Jag tänkte då: ”I mitt eget näste (boning – hebr. qen) ska jag dö,"
  },
  {
    "id": 33997,
    "book": "job                                     ",
    "chapter": "29",
    "verse": "19",
    "text": "Min rot [under mig]"
  },
  {
    "id": 33998,
    "book": "job                                     ",
    "chapter": "29",
    "verse": "20",
    "text": "Min ära är ständigt ny [det är Jobs önskan, se Job 19:9],"
  },
  {
    "id": 33999,
    "book": "job                                     ",
    "chapter": "29",
    "verse": "21",
    "text": "De lyssnade på mig och väntade,"
  },
  {
    "id": 34000,
    "book": "job                                     ",
    "chapter": "29",
    "verse": "22",
    "text": "Efter mitt ord sade ingen emot mig (hebr. shanah),"
  },
  {
    "id": 34001,
    "book": "job                                     ",
    "chapter": "29",
    "verse": "23",
    "text": "De väntade på mig som på regn,"
  },
  {
    "id": 34002,
    "book": "job                                     ",
    "chapter": "29",
    "verse": "24",
    "text": "Jag log mot dem – de trodde inte det,"
  },
  {
    "id": 34003,
    "book": "job                                     ",
    "chapter": "29",
    "verse": "25",
    "text": "Jag valde väg (hebr. derech) åt dem och satt som huvud (de högsta ledarna – hebr. rosh),"
  }
]