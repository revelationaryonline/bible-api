[
  {
    "id": 33883,
    "book": "job                                     ",
    "chapter": "24",
    "verse": "1",
    "text": "Varför har den Allsmäktige (Shaddaj) inga tider [för domstolsförhandlingar] i förvar?"
  },
  {
    "id": 33884,
    "book": "job                                     ",
    "chapter": "24",
    "verse": "2",
    "text": "Gränser flyttas [5 Mos 19:14; Ords 22:28; 23:10],"
  },
  {
    "id": 33885,
    "book": "job                                     ",
    "chapter": "24",
    "verse": "3",
    "text": "De för bort de faderlösas åsna,"
  },
  {
    "id": 33886,
    "book": "job                                     ",
    "chapter": "24",
    "verse": "4",
    "text": "De tränger bort de fattiga från vägen (hebr. derech),"
  },
  {
    "id": 33887,
    "book": "job                                     ",
    "chapter": "24",
    "verse": "5",
    "text": "[De fattigas liv är hårt:]"
  },
  {
    "id": 33888,
    "book": "job                                     ",
    "chapter": "24",
    "verse": "6",
    "text": "På fältet skördar de foder som inte är deras eget"
  },
  {
    "id": 33889,
    "book": "job                                     ",
    "chapter": "24",
    "verse": "7",
    "text": "Nakna övernattar (ligger de om natten – hebr. lon), utan kläder,"
  },
  {
    "id": 33890,
    "book": "job                                     ",
    "chapter": "24",
    "verse": "8",
    "text": "De dränks av storm (mot störtskur/slagregn) från bergen,"
  },
  {
    "id": 33891,
    "book": "job                                     ",
    "chapter": "24",
    "verse": "9",
    "text": "De [de ogudaktiga] sliter den faderlöse ifrån moderns bröst,"
  },
  {
    "id": 33892,
    "book": "job                                     ",
    "chapter": "24",
    "verse": "10",
    "text": "Nakna går de, utan kläder [substantiven är identiska med vers 7a],"
  },
  {
    "id": 33893,
    "book": "job                                     ",
    "chapter": "24",
    "verse": "11",
    "text": "Mellan deras murar pressar de ut olja,"
  },
  {
    "id": 33894,
    "book": "job                                     ",
    "chapter": "24",
    "verse": "12",
    "text": "En ringa grupp människor (hebr. mat) utanför staden jämrar sig,"
  },
  {
    "id": 33895,
    "book": "job                                     ",
    "chapter": "24",
    "verse": "13",
    "text": "Andra har blivit fiender till ljuset,"
  },
  {
    "id": 33896,
    "book": "job                                     ",
    "chapter": "24",
    "verse": "14",
    "text": "Vid ljuset (i gryningen) stiger mördaren upp,"
  },
  {
    "id": 33897,
    "book": "job                                     ",
    "chapter": "24",
    "verse": "15",
    "text": "Äktenskapsbrytarens [maskulin] öga spanar efter skymningen,"
  },
  {
    "id": 33898,
    "book": "job                                     ",
    "chapter": "24",
    "verse": "16",
    "text": "Vid mörkrets inbrott bryter de sig in (gräver – hebr. chatar) [via väggen] i husen,"
  },
  {
    "id": 33899,
    "book": "job                                     ",
    "chapter": "24",
    "verse": "17",
    "text": "för alla dem, morgonen är som djupt mörker (dödskuggan – hebr. tsalmavet) för dem,"
  },
  {
    "id": 33900,
    "book": "job                                     ",
    "chapter": "24",
    "verse": "18",
    "text": "De är skum (snabbt/lätt – hebr. qal) på vattenytan [de består inte, se Job 7:6; 9:25],"
  },
  {
    "id": 33901,
    "book": "job                                     ",
    "chapter": "24",
    "verse": "19",
    "text": "Som torka och hetta slukar snövatten,"
  },
  {
    "id": 33902,
    "book": "job                                     ",
    "chapter": "24",
    "verse": "20",
    "text": "Glömmer honom gör moderlivet [som är hans hem i livets start],"
  },
  {
    "id": 33903,
    "book": "job                                     ",
    "chapter": "24",
    "verse": "21",
    "text": "Han går på vall på (äter; frossar på) den ofruktsamma, som inte kan föda"
  },
  {
    "id": 33904,
    "book": "job                                     ",
    "chapter": "24",
    "verse": "22",
    "text": "Ja, ändå rycker han [Gud] bort de starka genom sin kraft;"
  },
  {
    "id": 33905,
    "book": "job                                     ",
    "chapter": "24",
    "verse": "23",
    "text": "Han ger dem trygghet och vila,"
  },
  {
    "id": 33906,
    "book": "job                                     ",
    "chapter": "24",
    "verse": "24",
    "text": "De upphöjda en kort tid,"
  },
  {
    "id": 33907,
    "book": "job                                     ",
    "chapter": "24",
    "verse": "25",
    "text": "Om det inte är så, vem kan visa att jag ljuger"
  }
]