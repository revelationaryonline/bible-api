[
  {
    "id": 33802,
    "book": "job                                     ",
    "chapter": "21",
    "verse": "1",
    "text": "Då Job svarade och sade:"
  },
  {
    "id": 33803,
    "book": "job                                     ",
    "chapter": "21",
    "verse": "2",
    "text": "Lyssna uppmärksamt till mitt prat (hebr. milah)"
  },
  {
    "id": 33804,
    "book": "job                                     ",
    "chapter": "21",
    "verse": "3",
    "text": "Acceptera att jag talar"
  },
  {
    "id": 33805,
    "book": "job                                     ",
    "chapter": "21",
    "verse": "4",
    "text": "För min del, är min klagan till en människa?"
  },
  {
    "id": 33806,
    "book": "job                                     ",
    "chapter": "21",
    "verse": "5",
    "text": "Vänd ansiktet mot mig (se på mig)"
  },
  {
    "id": 33807,
    "book": "job                                     ",
    "chapter": "21",
    "verse": "6",
    "text": "när jag kommer ihåg att jag darrar"
  },
  {
    "id": 33808,
    "book": "job                                     ",
    "chapter": "21",
    "verse": "7",
    "text": "Varför lever de onda,"
  },
  {
    "id": 33809,
    "book": "job                                     ",
    "chapter": "21",
    "verse": "8",
    "text": "Deras säd (deras barn) blir etablerad (finns kvar) inför deras ansikte"
  },
  {
    "id": 33810,
    "book": "job                                     ",
    "chapter": "21",
    "verse": "9",
    "text": "Deras hus är tryggt, utan fruktan"
  },
  {
    "id": 33811,
    "book": "job                                     ",
    "chapter": "21",
    "verse": "10",
    "text": "Deras oxar paras och misslyckas inte,"
  },
  {
    "id": 33812,
    "book": "job                                     ",
    "chapter": "21",
    "verse": "11",
    "text": "De sänder ut sina små som en flock"
  },
  {
    "id": 33813,
    "book": "job                                     ",
    "chapter": "21",
    "verse": "12",
    "text": "De sjunger med tamburin och kinnor-harpa"
  },
  {
    "id": 33814,
    "book": "job                                     ",
    "chapter": "21",
    "verse": "13",
    "text": "De fullbordar sina goda dagar"
  },
  {
    "id": 33815,
    "book": "job                                     ",
    "chapter": "21",
    "verse": "14",
    "text": "Och de säger till Gud (El):"
  },
  {
    "id": 33816,
    "book": "job                                     ",
    "chapter": "21",
    "verse": "15",
    "text": "Vad är den Allsmäktige (Shaddaj) att vi skulle tjäna honom?"
  },
  {
    "id": 33817,
    "book": "job                                     ",
    "chapter": "21",
    "verse": "16",
    "text": "Se, det goda är inte i deras hand."
  },
  {
    "id": 33818,
    "book": "job                                     ",
    "chapter": "21",
    "verse": "17",
    "text": "Hur ofta har de ondas lampa släckts,"
  },
  {
    "id": 33819,
    "book": "job                                     ",
    "chapter": "21",
    "verse": "18",
    "text": "De är som halmstrån i vinden"
  },
  {
    "id": 33820,
    "book": "job                                     ",
    "chapter": "21",
    "verse": "19",
    "text": "Gud (Eloha) gömmer (skyddar) åt sina söner deras synd."
  },
  {
    "id": 33821,
    "book": "job                                     ",
    "chapter": "21",
    "verse": "20",
    "text": "Låt hans ögon se hans fördärv"
  },
  {
    "id": 33822,
    "book": "job                                     ",
    "chapter": "21",
    "verse": "21",
    "text": "Vilken glädje har han i sitt hus efter sig (då han dör),"
  },
  {
    "id": 33823,
    "book": "job                                     ",
    "chapter": "21",
    "verse": "22",
    "text": "Ska (kan) någon undervisa kunskap till Gud (El)?"
  },
  {
    "id": 33824,
    "book": "job                                     ",
    "chapter": "21",
    "verse": "23",
    "text": "Den ene dör i sin kropps fulla styrka (vid god hälsa)"
  },
  {
    "id": 33825,
    "book": "job                                     ",
    "chapter": "21",
    "verse": "24",
    "text": "Hans ämbar är fullt av mjölk"
  },
  {
    "id": 33826,
    "book": "job                                     ",
    "chapter": "21",
    "verse": "25",
    "text": "En annan dör i själens bitterhet"
  },
  {
    "id": 33827,
    "book": "job                                     ",
    "chapter": "21",
    "verse": "26",
    "text": "De ligger ner på samma sätt i stoftet"
  },
  {
    "id": 33828,
    "book": "job                                     ",
    "chapter": "21",
    "verse": "27",
    "text": "Se, jag känner era tankar"
  },
  {
    "id": 33829,
    "book": "job                                     ",
    "chapter": "21",
    "verse": "28",
    "text": "Eftersom ni säger: ”Var är furstens hus? Och var är tälten som de onda bor i?”"
  },
  {
    "id": 33830,
    "book": "job                                     ",
    "chapter": "21",
    "verse": "29",
    "text": "Har ni inte frågat dem som går förbi längs vägen,"
  },
  {
    "id": 33831,
    "book": "job                                     ",
    "chapter": "21",
    "verse": "30",
    "text": "Eftersom en ond man är bevarad för ondskans dag"
  },
  {
    "id": 33832,
    "book": "job                                     ",
    "chapter": "21",
    "verse": "31",
    "text": "Vem ska förkunna över hans ansikte, hans vägar?"
  },
  {
    "id": 33833,
    "book": "job                                     ",
    "chapter": "21",
    "verse": "32",
    "text": "Och han är ämnad till gravarna"
  },
  {
    "id": 33834,
    "book": "job                                     ",
    "chapter": "21",
    "verse": "33",
    "text": "Dalarnas jordkokor är söta (tillfredställande) för honom,"
  },
  {
    "id": 33835,
    "book": "job                                     ",
    "chapter": "21",
    "verse": "34",
    "text": "Hur kan ni då trösta mig fåfängt?"
  }
]