[
  {
    "id": 33744,
    "book": "job                                     ",
    "chapter": "19",
    "verse": "1",
    "text": "Då svarade Job och sade:"
  },
  {
    "id": 33745,
    "book": "job                                     ",
    "chapter": "19",
    "verse": "2",
    "text": "Hur länge ska ni plåga mig (min själ)"
  },
  {
    "id": 33746,
    "book": "job                                     ",
    "chapter": "19",
    "verse": "3",
    "text": "Tio gånger [gång på gång] har ni hånat mig"
  },
  {
    "id": 33747,
    "book": "job                                     ",
    "chapter": "19",
    "verse": "4",
    "text": "Det är sant (står stadigt – hebr. omnam)"
  },
  {
    "id": 33748,
    "book": "job                                     ",
    "chapter": "19",
    "verse": "5",
    "text": "Det är sant (hebr. omnam)"
  },
  {
    "id": 33749,
    "book": "job                                     ",
    "chapter": "19",
    "verse": "6",
    "text": "så ska ni veta att Gud har gjort mig orätt"
  },
  {
    "id": 33750,
    "book": "job                                     ",
    "chapter": "19",
    "verse": "7",
    "text": "Se, jag ropar högt (högljutt skri efter hjälp – hebr. tsaaq): ”Våld (terror – chamas)”"
  },
  {
    "id": 33751,
    "book": "job                                     ",
    "chapter": "19",
    "verse": "8",
    "text": "Min stig (livsväg – hebr. orach) har han spärrat (hägnat in; murat en mur) och jag kan inte passera [Klag 3:7],"
  },
  {
    "id": 33752,
    "book": "job                                     ",
    "chapter": "19",
    "verse": "9",
    "text": "Han har avklätt av mig min ära [rykte]"
  },
  {
    "id": 33753,
    "book": "job                                     ",
    "chapter": "19",
    "verse": "10",
    "text": "Han bryter ner mig från alla sidor tills jag går under."
  },
  {
    "id": 33754,
    "book": "job                                     ",
    "chapter": "19",
    "verse": "11",
    "text": "Han [Gud] har tänt sin vredes eld mot mig"
  },
  {
    "id": 33755,
    "book": "job                                     ",
    "chapter": "19",
    "verse": "12",
    "text": "Hans skaror samlas tillsammans"
  },
  {
    "id": 33756,
    "book": "job                                     ",
    "chapter": "19",
    "verse": "13",
    "text": "Han har fört mina bröder [nära släktingar; landsmän] långt bort från mig [Job 6:15; 42:11],"
  },
  {
    "id": 33757,
    "book": "job                                     ",
    "chapter": "19",
    "verse": "14",
    "text": "Mina närmaste [släktingar] har lämnat,"
  },
  {
    "id": 33758,
    "book": "job                                     ",
    "chapter": "19",
    "verse": "15",
    "text": "De som bor tillfälligt i mitt hus [gäster på resa; manliga tjänare]"
  },
  {
    "id": 33759,
    "book": "job                                     ",
    "chapter": "19",
    "verse": "16",
    "text": "Kallar jag på min tjänare"
  },
  {
    "id": 33760,
    "book": "job                                     ",
    "chapter": "19",
    "verse": "17",
    "text": "Min andedräkt (ande; jag som person – hebr. roach)"
  },
  {
    "id": 33761,
    "book": "job                                     ",
    "chapter": "19",
    "verse": "18",
    "text": "Till och med ynglingar (pojkar) föraktar mig,"
  },
  {
    "id": 33762,
    "book": "job                                     ",
    "chapter": "19",
    "verse": "19",
    "text": "För den mindre grupp människor (hebr. mat – plural) som jag rådslår med är jag avskyvärd,"
  },
  {
    "id": 33763,
    "book": "job                                     ",
    "chapter": "19",
    "verse": "20",
    "text": "Mina ben tränger ut genom hud och kött,"
  },
  {
    "id": 33764,
    "book": "job                                     ",
    "chapter": "19",
    "verse": "21",
    "text": "Var barmhärtiga, var barmhärtiga mot mig, ni mina vänner,"
  },
  {
    "id": 33765,
    "book": "job                                     ",
    "chapter": "19",
    "verse": "22",
    "text": "Varför förföljer ni mig som Gud gör?"
  },
  {
    "id": 33766,
    "book": "job                                     ",
    "chapter": "19",
    "verse": "23",
    "text": "Vem [skulle kunna se till] att mitt prat (mina ord – hebr. milah) skrevs ner?"
  },
  {
    "id": 33767,
    "book": "job                                     ",
    "chapter": "19",
    "verse": "24",
    "text": "ja, med en penna av järn och bly"
  },
  {
    "id": 33768,
    "book": "job                                     ",
    "chapter": "19",
    "verse": "25",
    "text": "Men jag – jag vet [jag för min del är och har ändå varit intimt förtrogen med] att min Återlösare (hebr. gaal) [som försvarar och för min talan] lever,"
  },
  {
    "id": 33769,
    "book": "job                                     ",
    "chapter": "19",
    "verse": "26",
    "text": "När sedan min sargade hud är borta,"
  },
  {
    "id": 33770,
    "book": "job                                     ",
    "chapter": "19",
    "verse": "27",
    "text": "Jag själv ska få skåda (hebr. chazah) honom,"
  },
  {
    "id": 33771,
    "book": "job                                     ",
    "chapter": "19",
    "verse": "28",
    "text": "[Jobs råd till de som anklagar honom:]"
  },
  {
    "id": 33772,
    "book": "job                                     ",
    "chapter": "19",
    "verse": "29",
    "text": "Var rädda för svärdet,"
  }
]