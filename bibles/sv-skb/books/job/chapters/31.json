[
  {
    "id": 34035,
    "book": "job                                     ",
    "chapter": "31",
    "verse": "1",
    "text": "Jag skar ett förbund (slöt ett kontrakt) med mina ögon,"
  },
  {
    "id": 34036,
    "book": "job                                     ",
    "chapter": "31",
    "verse": "2",
    "text": "Och vilken är Guds (Elohims) del ifrån ovan"
  },
  {
    "id": 34037,
    "book": "job                                     ",
    "chapter": "31",
    "verse": "3",
    "text": "Är det inte olycka till förvrängaren"
  },
  {
    "id": 34038,
    "book": "job                                     ",
    "chapter": "31",
    "verse": "4",
    "text": "Har inte han sett mina vägar"
  },
  {
    "id": 34039,
    "book": "job                                     ",
    "chapter": "31",
    "verse": "5",
    "text": "Om jag har vandrat med fåfängan"
  },
  {
    "id": 34040,
    "book": "job                                     ",
    "chapter": "31",
    "verse": "6",
    "text": "låt mig bli vägd på rättvisans våg,"
  },
  {
    "id": 34041,
    "book": "job                                     ",
    "chapter": "31",
    "verse": "7",
    "text": "Om mitt steg"
  },
  {
    "id": 34042,
    "book": "job                                     ",
    "chapter": "31",
    "verse": "8",
    "text": "låt mig då så och låt någon annan äta,"
  },
  {
    "id": 34043,
    "book": "job                                     ",
    "chapter": "31",
    "verse": "9",
    "text": "Om mitt hjärta har lockats till en kvinna"
  },
  {
    "id": 34044,
    "book": "job                                     ",
    "chapter": "31",
    "verse": "10",
    "text": "låt då min hustru mala åt någon annan"
  },
  {
    "id": 34045,
    "book": "job                                     ",
    "chapter": "31",
    "verse": "11",
    "text": "Eftersom det är ett avskyvärt brott,"
  },
  {
    "id": 34046,
    "book": "job                                     ",
    "chapter": "31",
    "verse": "12",
    "text": "Eftersom det är en eld som slukar ända till Abaddon (avgrunden, förgörelsens plats, se Ords 27:20; Job 26:6; Upp 9:11)"
  },
  {
    "id": 34047,
    "book": "job                                     ",
    "chapter": "31",
    "verse": "13",
    "text": "Om jag skulle förakta min tjänares eller min tjänarinnas sak"
  },
  {
    "id": 34048,
    "book": "job                                     ",
    "chapter": "31",
    "verse": "14",
    "text": "vad skulle jag då göra när Gud (Elohim) reser sig?"
  },
  {
    "id": 34049,
    "book": "job                                     ",
    "chapter": "31",
    "verse": "15",
    "text": "Har inte han som har skapat mig i livmodern skapat honom?"
  },
  {
    "id": 34050,
    "book": "job                                     ",
    "chapter": "31",
    "verse": "16",
    "text": "[I respons på Elifaz anklagelser i Job 22:7-9 att han skulle ha förtrykt de fattiga kommer följande respons:]"
  },
  {
    "id": 34051,
    "book": "job                                     ",
    "chapter": "31",
    "verse": "17",
    "text": "eller har ätit min smula (mat, oavsett hur lite) själv (ensam)"
  },
  {
    "id": 34052,
    "book": "job                                     ",
    "chapter": "31",
    "verse": "18",
    "text": "för från min ungdom växte han upp, med mig som en far"
  },
  {
    "id": 34053,
    "book": "job                                     ",
    "chapter": "31",
    "verse": "19",
    "text": "Om jag har sett någon vandrare i behov av kläder"
  },
  {
    "id": 34054,
    "book": "job                                     ",
    "chapter": "31",
    "verse": "20",
    "text": "om hans länder inte har välsignat mig"
  },
  {
    "id": 34055,
    "book": "job                                     ",
    "chapter": "31",
    "verse": "21",
    "text": "om jag har lyft upp min hand mot den faderlöse,"
  },
  {
    "id": 34056,
    "book": "job                                     ",
    "chapter": "31",
    "verse": "22",
    "text": "låt då mina skuldror falla loss från skulderbladen"
  },
  {
    "id": 34057,
    "book": "job                                     ",
    "chapter": "31",
    "verse": "23",
    "text": "Olycka från Gud (Elohim) var en skräck för mig"
  },
  {
    "id": 34058,
    "book": "job                                     ",
    "chapter": "31",
    "verse": "24",
    "text": "Om jag har satt mitt hopp till guld"
  },
  {
    "id": 34059,
    "book": "job                                     ",
    "chapter": "31",
    "verse": "25",
    "text": "om jag gladde mig därför att min rikedom var stor"
  },
  {
    "id": 34060,
    "book": "job                                     ",
    "chapter": "31",
    "verse": "26",
    "text": "om jag såg solen när den sken"
  },
  {
    "id": 34061,
    "book": "job                                     ",
    "chapter": "31",
    "verse": "27",
    "text": "och mitt hjärta i hemlighet har blivit lockat"
  },
  {
    "id": 34062,
    "book": "job                                     ",
    "chapter": "31",
    "verse": "28",
    "text": "då är även detta en synd som ska straffas av domaren,"
  },
  {
    "id": 34063,
    "book": "job                                     ",
    "chapter": "31",
    "verse": "29",
    "text": "Om jag gläder mig åt att han som hatar mig blir fördärvad,"
  },
  {
    "id": 34064,
    "book": "job                                     ",
    "chapter": "31",
    "verse": "30",
    "text": "och inte avhåller min mun från att synda"
  },
  {
    "id": 34065,
    "book": "job                                     ",
    "chapter": "31",
    "verse": "31",
    "text": "Om inte de vuxna i mitt tält säger: Vem kan finna någon som inte har blivit mätt av hans kött?"
  },
  {
    "id": 34066,
    "book": "job                                     ",
    "chapter": "31",
    "verse": "32",
    "text": "Främlingen bor inte på gatan,"
  },
  {
    "id": 34067,
    "book": "job                                     ",
    "chapter": "31",
    "verse": "33",
    "text": "Om jag på människors sätt har dolt mina överträdelser"
  },
  {
    "id": 34068,
    "book": "job                                     ",
    "chapter": "31",
    "verse": "34",
    "text": "eftersom jag fruktade för skarorna"
  },
  {
    "id": 34069,
    "book": "job                                     ",
    "chapter": "31",
    "verse": "35",
    "text": "Vem ger till mig, lyssnar till mig, se mitt märke (avtryck, signatur, autograf)."
  },
  {
    "id": 34070,
    "book": "job                                     ",
    "chapter": "31",
    "verse": "36",
    "text": "Om jag inte kan bära det på min skuldra"
  },
  {
    "id": 34071,
    "book": "job                                     ",
    "chapter": "31",
    "verse": "37",
    "text": "Jag ska förkunna för honom antalet av mina steg,"
  },
  {
    "id": 34072,
    "book": "job                                     ",
    "chapter": "31",
    "verse": "38",
    "text": "Om mitt land ropar mot mig"
  },
  {
    "id": 34073,
    "book": "job                                     ",
    "chapter": "31",
    "verse": "39",
    "text": "om jag har ätit dessa frukt utan silver [ge betalning]"
  },
  {
    "id": 34074,
    "book": "job                                     ",
    "chapter": "31",
    "verse": "40",
    "text": "låt tistlar växa istället för vete"
  }
]