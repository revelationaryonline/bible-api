[
  {
    "id": 34183,
    "book": "job                                     ",
    "chapter": "36",
    "verse": "1",
    "text": "Och Eliho fortsatte [hans fjärde tal] och sade:"
  },
  {
    "id": 34184,
    "book": "job                                     ",
    "chapter": "36",
    "verse": "2",
    "text": "”Ha lite tålamod med mig och jag ska visa dig,"
  },
  {
    "id": 34185,
    "book": "job                                     ",
    "chapter": "36",
    "verse": "3",
    "text": "Jag ska hämta min kunskap från fjärran"
  },
  {
    "id": 34186,
    "book": "job                                     ",
    "chapter": "36",
    "verse": "4",
    "text": "I sanning är inte mitt prat (hebr. milah) lögn."
  },
  {
    "id": 34187,
    "book": "job                                     ",
    "chapter": "36",
    "verse": "5",
    "text": "Se, Gud (El) är mäktig (kabir), han föraktar ingen,"
  },
  {
    "id": 34188,
    "book": "job                                     ",
    "chapter": "36",
    "verse": "6",
    "text": "Han bevarar inte den ondes liv"
  },
  {
    "id": 34189,
    "book": "job                                     ",
    "chapter": "36",
    "verse": "7",
    "text": "Han undanhåller inte sina ögon från de rättfärdiga,"
  },
  {
    "id": 34190,
    "book": "job                                     ",
    "chapter": "36",
    "verse": "8",
    "text": "Och om de kedjas i oket,"
  },
  {
    "id": 34191,
    "book": "job                                     ",
    "chapter": "36",
    "verse": "9",
    "text": "då förklarar han för dem deras gärningar"
  },
  {
    "id": 34192,
    "book": "job                                     ",
    "chapter": "36",
    "verse": "10",
    "text": "Och han klär av (öppnar) deras öra till förmaning"
  },
  {
    "id": 34193,
    "book": "job                                     ",
    "chapter": "36",
    "verse": "11",
    "text": "Om de lyssnar och tjänar honom,"
  },
  {
    "id": 34194,
    "book": "job                                     ",
    "chapter": "36",
    "verse": "12",
    "text": "Men om de inte lyssnar"
  },
  {
    "id": 34195,
    "book": "job                                     ",
    "chapter": "36",
    "verse": "13",
    "text": "Men de som är gudlösa i hjärtat samlar vrede,"
  },
  {
    "id": 34196,
    "book": "job                                     ",
    "chapter": "36",
    "verse": "14",
    "text": "Deras själ dör ung,"
  },
  {
    "id": 34197,
    "book": "job                                     ",
    "chapter": "36",
    "verse": "15",
    "text": "Han räddar (drar ut) de bedrövade ur deras bedrövelse"
  },
  {
    "id": 34198,
    "book": "job                                     ",
    "chapter": "36",
    "verse": "16",
    "text": "Och han lockar dig från nödens mun,"
  },
  {
    "id": 34199,
    "book": "job                                     ",
    "chapter": "36",
    "verse": "17",
    "text": "Och du är full av dom (din) över de onda,"
  },
  {
    "id": 34200,
    "book": "job                                     ",
    "chapter": "36",
    "verse": "18",
    "text": "Eftersom vreden (chema) annars lockar dem till straff,"
  },
  {
    "id": 34201,
    "book": "job                                     ",
    "chapter": "36",
    "verse": "19",
    "text": "Förbered ditt nödrop (hebr. shoa), inte guld"
  },
  {
    "id": 34202,
    "book": "job                                     ",
    "chapter": "36",
    "verse": "20",
    "text": "Längta inte efter natten"
  },
  {
    "id": 34203,
    "book": "job                                     ",
    "chapter": "36",
    "verse": "21",
    "text": "Håll (vakta, skydda, bevara) dig från att vända ditt ansikte till synd,"
  },
  {
    "id": 34204,
    "book": "job                                     ",
    "chapter": "36",
    "verse": "22",
    "text": "Se, Gud (El) är upphöjd i sin styrka (koach),"
  },
  {
    "id": 34205,
    "book": "job                                     ",
    "chapter": "36",
    "verse": "23",
    "text": "Vem har tillägnat honom hans vägar?"
  },
  {
    "id": 34206,
    "book": "job                                     ",
    "chapter": "36",
    "verse": "24",
    "text": "Kom ihåg att du förökar hans gärningar (arbete – hebr. paal)"
  },
  {
    "id": 34207,
    "book": "job                                     ",
    "chapter": "36",
    "verse": "25",
    "text": "Alla människor skådar på det,"
  },
  {
    "id": 34208,
    "book": "job                                     ",
    "chapter": "36",
    "verse": "26",
    "text": "Se, Gud (El) är stor och inte möjlig att känna (bli intimt förtrogen med) antalet av hans år (hans ålder)"
  },
  {
    "id": 34209,
    "book": "job                                     ",
    "chapter": "36",
    "verse": "27",
    "text": "Han skrapar av vattendropparna,"
  },
  {
    "id": 34210,
    "book": "job                                     ",
    "chapter": "36",
    "verse": "28",
    "text": "som flödar (nazal) från skyn (shachaq)"
  },
  {
    "id": 34211,
    "book": "job                                     ",
    "chapter": "36",
    "verse": "29",
    "text": "Kan någon förstå molnens utbredning,"
  },
  {
    "id": 34212,
    "book": "job                                     ",
    "chapter": "36",
    "verse": "30",
    "text": "Se, han sprider sitt ljus över den"
  },
  {
    "id": 34213,
    "book": "job                                     ",
    "chapter": "36",
    "verse": "31",
    "text": "för i detta dömer han folken,"
  },
  {
    "id": 34214,
    "book": "job                                     ",
    "chapter": "36",
    "verse": "32",
    "text": "Han täcker över sina händer med ljus"
  },
  {
    "id": 34215,
    "book": "job                                     ",
    "chapter": "36",
    "verse": "33",
    "text": "Ljudet från det (åskan) förkunnar hans närvaro,"
  }
]