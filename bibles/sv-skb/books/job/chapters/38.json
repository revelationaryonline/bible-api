[
  {
    "id": 34240,
    "book": "job                                     ",
    "chapter": "38",
    "verse": "1",
    "text": "Herren svarade Job från stormvinden (hebr. searah) och sade:"
  },
  {
    "id": 34241,
    "book": "job                                     ",
    "chapter": "38",
    "verse": "2",
    "text": "Vem är det som skymmer (gömmer, döljer) mina planer (tankar, syften)"
  },
  {
    "id": 34242,
    "book": "job                                     ",
    "chapter": "38",
    "verse": "3",
    "text": "Var en man, gör dig nu redo [för en svår uppgift som väntar]."
  },
  {
    "id": 34243,
    "book": "job                                     ",
    "chapter": "38",
    "verse": "4",
    "text": "Var var du när jag lade jordens grund?"
  },
  {
    "id": 34244,
    "book": "job                                     ",
    "chapter": "38",
    "verse": "5",
    "text": "Vem har dimensionerat jorden (bestämt dess mått)?"
  },
  {
    "id": 34245,
    "book": "job                                     ",
    "chapter": "38",
    "verse": "6",
    "text": "Var ställdes jordens pelare (var fick de sjunka in och fastna)?"
  },
  {
    "id": 34246,
    "book": "job                                     ",
    "chapter": "38",
    "verse": "7",
    "text": "medan morgonstjärnorna [symboliskt för änglarna eller hela skapelsen] sjöng (entusiastiskt höjde gälla triumferande jubelrop) tillsammans,"
  },
  {
    "id": 34247,
    "book": "job                                     ",
    "chapter": "38",
    "verse": "8",
    "text": "Vem begränsade havet med portar,"
  },
  {
    "id": 34248,
    "book": "job                                     ",
    "chapter": "38",
    "verse": "9",
    "text": "när jag klädde det med moln,"
  },
  {
    "id": 34249,
    "book": "job                                     ",
    "chapter": "38",
    "verse": "10",
    "text": "när jag utstakade dess gräns,"
  },
  {
    "id": 34250,
    "book": "job                                     ",
    "chapter": "38",
    "verse": "11",
    "text": "när jag sade: ”Hit men inte längre får du komma,"
  },
  {
    "id": 34251,
    "book": "job                                     ",
    "chapter": "38",
    "verse": "12",
    "text": "Har du någon gång i ditt liv befallt morgonen att komma,"
  },
  {
    "id": 34252,
    "book": "job                                     ",
    "chapter": "38",
    "verse": "13",
    "text": "för att den ska gripa tag i jordens hörn [horisonten],"
  },
  {
    "id": 34253,
    "book": "job                                     ",
    "chapter": "38",
    "verse": "14",
    "text": "Vid gryningen ändras jordens skepnad som leran formas av ett sigill [jordens konturer träder fram],"
  },
  {
    "id": 34254,
    "book": "job                                     ",
    "chapter": "38",
    "verse": "15",
    "text": "De ogudaktiga berövas sitt ljus [som är mörker],"
  },
  {
    "id": 34255,
    "book": "job                                     ",
    "chapter": "38",
    "verse": "16",
    "text": "Har du stigit ner till havets källor"
  },
  {
    "id": 34256,
    "book": "job                                     ",
    "chapter": "38",
    "verse": "17",
    "text": "Har dödens (dödsrikets) portar öppnats (avslöjats) för dig,"
  },
  {
    "id": 34257,
    "book": "job                                     ",
    "chapter": "38",
    "verse": "18",
    "text": "Förstår du hur stor jorden är? [Vilket Gud gör, se Job 28:24]"
  },
  {
    "id": 34258,
    "book": "job                                     ",
    "chapter": "38",
    "verse": "19",
    "text": "Var går (vilken riktning har) vägen till"
  },
  {
    "id": 34259,
    "book": "job                                     ",
    "chapter": "38",
    "verse": "20",
    "text": "Kan du föra dem [ljuset eller mörkret] till dess gräns"
  },
  {
    "id": 34260,
    "book": "job                                     ",
    "chapter": "38",
    "verse": "21",
    "text": "Du vet det, du var ju född då, du som levt så länge (dina dagars tal är ju stort)!"
  },
  {
    "id": 34261,
    "book": "job                                     ",
    "chapter": "38",
    "verse": "22",
    "text": "Har du stigit in i snöns förråd?"
  },
  {
    "id": 34262,
    "book": "job                                     ",
    "chapter": "38",
    "verse": "23",
    "text": "som jag sparar till nödens tid,"
  },
  {
    "id": 34263,
    "book": "job                                     ",
    "chapter": "38",
    "verse": "24",
    "text": "Var (längs vilken väg) delar sig ljuset [så det sprids över hela jorden],"
  },
  {
    "id": 34264,
    "book": "job                                     ",
    "chapter": "38",
    "verse": "25",
    "text": "Vem hugger ut kanaler för regnflödet [har skapat vädermönster],"
  },
  {
    "id": 34265,
    "book": "job                                     ",
    "chapter": "38",
    "verse": "26",
    "text": "så att det regnar"
  },
  {
    "id": 34266,
    "book": "job                                     ",
    "chapter": "38",
    "verse": "27",
    "text": "för att mätta öde trakter,"
  },
  {
    "id": 34267,
    "book": "job                                     ",
    "chapter": "38",
    "verse": "28",
    "text": "Har regnet någon far?"
  },
  {
    "id": 34268,
    "book": "job                                     ",
    "chapter": "38",
    "verse": "29",
    "text": "Vem är isens moder?"
  },
  {
    "id": 34269,
    "book": "job                                     ",
    "chapter": "38",
    "verse": "30",
    "text": "när vattnen döljs [sjöar och källor fryser] och blir [hårda] som sten,"
  },
  {
    "id": 34270,
    "book": "job                                     ",
    "chapter": "38",
    "verse": "31",
    "text": "Kan du knyta samman Sjustjärnorna [stjärnhopen som också kallas Plejaderna],"
  },
  {
    "id": 34271,
    "book": "job                                     ",
    "chapter": "38",
    "verse": "32",
    "text": "Låter du stjärnkonstellationer [kanske en speciell grupp stjärnor – hebr. mazzeroth] gå upp i rätt tid,"
  },
  {
    "id": 34272,
    "book": "job                                     ",
    "chapter": "38",
    "verse": "33",
    "text": "Känner du himlens lagar,"
  },
  {
    "id": 34273,
    "book": "job                                     ",
    "chapter": "38",
    "verse": "34",
    "text": "Kan du ropa [ge en order] till molnen,"
  },
  {
    "id": 34274,
    "book": "job                                     ",
    "chapter": "38",
    "verse": "35",
    "text": "Kan du skicka efter blixtar,"
  },
  {
    "id": 34275,
    "book": "job                                     ",
    "chapter": "38",
    "verse": "36",
    "text": "Vem har lagt vishet i det stängda [inre, fördolda, kan syfta på molnen],"
  },
  {
    "id": 34276,
    "book": "job                                     ",
    "chapter": "38",
    "verse": "37",
    "text": "Vem har vishet att räkna molnen?"
  },
  {
    "id": 34277,
    "book": "job                                     ",
    "chapter": "38",
    "verse": "38",
    "text": "när jorden börjar bli hård [av solens hetta]"
  }
]