[
  {
    "id": 33455,
    "book": "job                                     ",
    "chapter": "7",
    "verse": "1",
    "text": "Är inte människans liv som ett krig (militärtjänst)"
  },
  {
    "id": 33456,
    "book": "job                                     ",
    "chapter": "7",
    "verse": "2",
    "text": "Som en tjänare längtar (flämtar) efter skugga,"
  },
  {
    "id": 33457,
    "book": "job                                     ",
    "chapter": "7",
    "verse": "3",
    "text": "Så har jag blivit satt att ärva"
  },
  {
    "id": 33458,
    "book": "job                                     ",
    "chapter": "7",
    "verse": "4",
    "text": "När jag lagt mig säger (frågar jag mig): ”När ska jag stå upp?”"
  },
  {
    "id": 33459,
    "book": "job                                     ",
    "chapter": "7",
    "verse": "5",
    "text": "Min kropp (kött) är täckt av mask (larver – hebr. rima) och smutsiga sår;"
  },
  {
    "id": 33460,
    "book": "job                                     ",
    "chapter": "7",
    "verse": "6",
    "text": "Mina dagar drar förbi, snabbare än en vävares spole [snurrar],"
  },
  {
    "id": 33461,
    "book": "job                                     ",
    "chapter": "7",
    "verse": "7",
    "text": "Kom ihåg (tänk på) att mitt liv är en vindfläkt,"
  },
  {
    "id": 33462,
    "book": "job                                     ",
    "chapter": "7",
    "verse": "8",
    "text": "Ögat av honom som ser mig, ser mig inte mer,"
  },
  {
    "id": 33463,
    "book": "job                                     ",
    "chapter": "7",
    "verse": "9",
    "text": "Som ett moln som löses upp och försvinner (går upp i rök),"
  },
  {
    "id": 33464,
    "book": "job                                     ",
    "chapter": "7",
    "verse": "10",
    "text": "Han kommer aldrig tillbaka till sitt hus igen,"
  },
  {
    "id": 33465,
    "book": "job                                     ",
    "chapter": "7",
    "verse": "11",
    "text": "Därför ska jag inte lägga band på (hålla igen) min mun,"
  },
  {
    "id": 33466,
    "book": "job                                     ",
    "chapter": "7",
    "verse": "12",
    "text": "Är jag ett hav eller en orm [Leviatan (Job 3:8) och Rahav (Job 9:13)],"
  },
  {
    "id": 33467,
    "book": "job                                     ",
    "chapter": "7",
    "verse": "13",
    "text": "Eftersom jag säger att min säng är min tröst,"
  },
  {
    "id": 33468,
    "book": "job                                     ",
    "chapter": "7",
    "verse": "14",
    "text": "men då förfärar du mig genom drömmar,"
  },
  {
    "id": 33469,
    "book": "job                                     ",
    "chapter": "7",
    "verse": "15",
    "text": "så att du väljer att kväva (hebr. machanaq) min själ"
  },
  {
    "id": 33470,
    "book": "job                                     ",
    "chapter": "7",
    "verse": "16",
    "text": "Jag avskyr det [livet]! Låt mig inte leva för alltid,"
  },
  {
    "id": 33471,
    "book": "job                                     ",
    "chapter": "7",
    "verse": "17",
    "text": "Vad är en [bräcklig] människa (hebr. enosh)"
  },
  {
    "id": 33472,
    "book": "job                                     ",
    "chapter": "7",
    "verse": "18",
    "text": "Och du besöker honom varje morgon,"
  },
  {
    "id": 33473,
    "book": "job                                     ",
    "chapter": "7",
    "verse": "19",
    "text": "Varför [slutar] du inte att betrakta mig,"
  },
  {
    "id": 33474,
    "book": "job                                     ",
    "chapter": "7",
    "verse": "20",
    "text": "Om jag har syndat – vad har jag gjort mot (till) dig, du människornas bevakare (hebr. adam natsar)?"
  },
  {
    "id": 33475,
    "book": "job                                     ",
    "chapter": "7",
    "verse": "21",
    "text": "Och varför lyfter du inte [bort] min synd (hebr. pesha)"
  }
]