[
  {
    "id": 33866,
    "book": "job                                     ",
    "chapter": "23",
    "verse": "1",
    "text": "Då svarade Job och sade:"
  },
  {
    "id": 33867,
    "book": "job                                     ",
    "chapter": "23",
    "verse": "2",
    "text": "Även idag är upproriskhet mitt bekymmer,"
  },
  {
    "id": 33868,
    "book": "job                                     ",
    "chapter": "23",
    "verse": "3",
    "text": "Om bara jag visste hur jag skulle finna honom,"
  },
  {
    "id": 33869,
    "book": "job                                     ",
    "chapter": "23",
    "verse": "4",
    "text": "Jag skulle lägga fram min sak (rättsfall – hebr. mishpat) inför honom,"
  },
  {
    "id": 33870,
    "book": "job                                     ",
    "chapter": "23",
    "verse": "5",
    "text": "Jag känner orden (pratet – hebr. milah) han skulle svara mig,"
  },
  {
    "id": 33871,
    "book": "job                                     ",
    "chapter": "23",
    "verse": "6",
    "text": "Skulle han tvista med (motsätta sig – hebr. riv) mig i stor kraft,"
  },
  {
    "id": 33872,
    "book": "job                                     ",
    "chapter": "23",
    "verse": "7",
    "text": "En rättfärdig skulle då vara hans motpart,"
  },
  {
    "id": 33873,
    "book": "job                                     ",
    "chapter": "23",
    "verse": "8",
    "text": "Se, går jag frammåt (mot öster – hebr. qedem) [möter solens uppgång] är han inte där,"
  },
  {
    "id": 33874,
    "book": "job                                     ",
    "chapter": "23",
    "verse": "9",
    "text": "Gör han något till vänster [norrut om man står mot öster] skådar jag honom inte,"
  },
  {
    "id": 33875,
    "book": "job                                     ",
    "chapter": "23",
    "verse": "10",
    "text": "Men han vet min väg (vandringsväg, mina livsval – hebr. derech),"
  },
  {
    "id": 33876,
    "book": "job                                     ",
    "chapter": "23",
    "verse": "11",
    "text": "Min fot har hållit fast nära hans steg (vid hans spår),"
  },
  {
    "id": 33877,
    "book": "job                                     ",
    "chapter": "23",
    "verse": "12",
    "text": "Jag har inte övergett hans läppars bud,"
  },
  {
    "id": 33878,
    "book": "job                                     ",
    "chapter": "23",
    "verse": "13",
    "text": "Men han är den ende [oföreänderlig, fast], vem kan stå honom emot?"
  },
  {
    "id": 33879,
    "book": "job                                     ",
    "chapter": "23",
    "verse": "14",
    "text": "Ja, han fullbordar min beskärda del,"
  },
  {
    "id": 33880,
    "book": "job                                     ",
    "chapter": "23",
    "verse": "15",
    "text": "Därför bävar jag för hans ansikte,"
  },
  {
    "id": 33881,
    "book": "job                                     ",
    "chapter": "23",
    "verse": "16",
    "text": "Gud (El) har gjort mitt hjärta försagt (jag tappar modet),"
  },
  {
    "id": 33882,
    "book": "job                                     ",
    "chapter": "23",
    "verse": "17",
    "text": "för jag fick inte förgås innan mörkret kom,"
  }
]