[
  {
    "id": 33476,
    "book": "job                                     ",
    "chapter": "8",
    "verse": "1",
    "text": "Sedan tog Bildad – shoaiten [Job 2:11], till orda och sade [svarade Job]:"
  },
  {
    "id": 33477,
    "book": "job                                     ",
    "chapter": "8",
    "verse": "2",
    "text": "Hur länge ska du tala (flöda från ditt hjärta – hebr. malal) så här?"
  },
  {
    "id": 33478,
    "book": "job                                     ",
    "chapter": "8",
    "verse": "3",
    "text": "Har Gud (El) förvrängt (perverterat, gjort krokigt) rätten (bindande juridiska beslut – hebr. mishpat)?"
  },
  {
    "id": 33479,
    "book": "job                                     ",
    "chapter": "8",
    "verse": "4",
    "text": "Om dina söner syndar (hebr. chata) mot honom"
  },
  {
    "id": 33480,
    "book": "job                                     ",
    "chapter": "8",
    "verse": "5",
    "text": "Om du tidigt söker (som högsta prioritet – hebr. shachar) dig mot Gud (El)"
  },
  {
    "id": 33481,
    "book": "job                                     ",
    "chapter": "8",
    "verse": "6",
    "text": "Om du är ren (moraliskt ren – hebr. zach) och rättsinnig [Ps 119:9]"
  },
  {
    "id": 33482,
    "book": "job                                     ",
    "chapter": "8",
    "verse": "7",
    "text": "Din början var ringa (liten, oansenlig)"
  },
  {
    "id": 33483,
    "book": "job                                     ",
    "chapter": "8",
    "verse": "8",
    "text": "Fråga, jag ber dig nu [käre Job], den tidigare generationen"
  },
  {
    "id": 33484,
    "book": "job                                     ",
    "chapter": "8",
    "verse": "9",
    "text": "Eftersom vi är från igår [nyfödda – i jämförelse med patriarkerna, se vers 8] och vet inget,"
  },
  {
    "id": 33485,
    "book": "job                                     ",
    "chapter": "8",
    "verse": "10",
    "text": "Ska då inte de [tidigare generationer] undervisa dig"
  },
  {
    "id": 33486,
    "book": "job                                     ",
    "chapter": "8",
    "verse": "11",
    "text": "[Bildad verkar känna till Egypten och uppmanar Job att ta lärdom från papyrusplantan:]"
  },
  {
    "id": 33487,
    "book": "job                                     ",
    "chapter": "8",
    "verse": "12",
    "text": "Ännu vi i en grön planta den inte plockats (skördats, skurits av)"
  },
  {
    "id": 33488,
    "book": "job                                     ",
    "chapter": "8",
    "verse": "13",
    "text": "Så stigarna (upptrampade välkända vägar) glömmer alla Gud (El)"
  },
  {
    "id": 33489,
    "book": "job                                     ",
    "chapter": "8",
    "verse": "14",
    "text": "[Lär dig att livet är skört:]"
  },
  {
    "id": 33490,
    "book": "job                                     ",
    "chapter": "8",
    "verse": "15",
    "text": "Han ska luta sig över (lita på) sitt hus men inte stå,"
  },
  {
    "id": 33491,
    "book": "job                                     ",
    "chapter": "8",
    "verse": "16",
    "text": "Han är frodig (ratov, finns bara här) framför solens ansikte"
  },
  {
    "id": 33492,
    "book": "job                                     ",
    "chapter": "8",
    "verse": "17",
    "text": "Över ett röse [är] hans rot slingrad,"
  },
  {
    "id": 33493,
    "book": "job                                     ",
    "chapter": "8",
    "verse": "18",
    "text": "Om han slukas från sin plats"
  },
  {
    "id": 33494,
    "book": "job                                     ",
    "chapter": "8",
    "verse": "19",
    "text": "Se, han har sin fröjd i sin väg"
  },
  {
    "id": 33495,
    "book": "job                                     ",
    "chapter": "8",
    "verse": "20",
    "text": "Se, Gud (El) föraktar inte oskyldig"
  },
  {
    "id": 33496,
    "book": "job                                     ",
    "chapter": "8",
    "verse": "21",
    "text": "Till att fylla (uppfylla) [med] skratt deras mun"
  },
  {
    "id": 33497,
    "book": "job                                     ",
    "chapter": "8",
    "verse": "22",
    "text": "De hatar att bli klädda i skam"
  }
]