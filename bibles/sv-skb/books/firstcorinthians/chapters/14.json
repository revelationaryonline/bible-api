[
  {
    "id": 21464,
    "book": "firstCorinthians                        ",
    "chapter": "14",
    "verse": "1",
    "text": "Sträva (ordagrant ”spring efter”, följ) efter kärleken,"
  },
  {
    "id": 21465,
    "book": "firstCorinthians                        ",
    "chapter": "14",
    "verse": "2",
    "text": "Den som talar tungomål [ett bönespråk som inte förstås om det inte finns någon som kan uttyda]"
  },
  {
    "id": 21466,
    "book": "firstCorinthians                        ",
    "chapter": "14",
    "verse": "3",
    "text": "Men den som profeterar [talar inspirerat av Gud, med eller utan referens till framtida händelser] talar till människor och ger uppbyggelse, uppmuntran och tröst."
  },
  {
    "id": 21467,
    "book": "firstCorinthians                        ",
    "chapter": "14",
    "verse": "4",
    "text": "Den som talar tungomål"
  },
  {
    "id": 21468,
    "book": "firstCorinthians                        ",
    "chapter": "14",
    "verse": "5",
    "text": "Jag vill gärna att ni alla talar tungomål,"
  },
  {
    "id": 21469,
    "book": "firstCorinthians                        ",
    "chapter": "14",
    "verse": "6",
    "text": "Syskon (bröder och systrar i tron),"
  },
  {
    "id": 21470,
    "book": "firstCorinthians                        ",
    "chapter": "14",
    "verse": "7",
    "text": "[Nu följer fyra liknelser: flöjt, harpa, trumpet och okända språk. Korint var en internationell stad med många nationaliteter och språk. En kristen som talar i tungor jämförs med en främling som talar ett okänt språk. Paulus poäng är att okända språk inte enar utan splittrar.]"
  },
  {
    "id": 21471,
    "book": "firstCorinthians                        ",
    "chapter": "14",
    "verse": "8",
    "text": "Om en militärtrumpet [med olika signaler för anfall eller reträtt]"
  },
  {
    "id": 21472,
    "book": "firstCorinthians                        ",
    "chapter": "14",
    "verse": "9",
    "text": "Så är det också med er."
  },
  {
    "id": 21473,
    "book": "firstCorinthians                        ",
    "chapter": "14",
    "verse": "10",
    "text": "Hur många språk det än finns i världen,"
  },
  {
    "id": 21474,
    "book": "firstCorinthians                        ",
    "chapter": "14",
    "verse": "11",
    "text": "Men om jag inte vet vad ljuden betyder"
  },
  {
    "id": 21475,
    "book": "firstCorinthians                        ",
    "chapter": "14",
    "verse": "12",
    "text": "Så är det också med er,"
  },
  {
    "id": 21476,
    "book": "firstCorinthians                        ",
    "chapter": "14",
    "verse": "13",
    "text": "Därför ska den som talar tungomål"
  },
  {
    "id": 21477,
    "book": "firstCorinthians                        ",
    "chapter": "14",
    "verse": "14",
    "text": "För om jag ber med tungomål så ber min ande,"
  },
  {
    "id": 21478,
    "book": "firstCorinthians                        ",
    "chapter": "14",
    "verse": "15",
    "text": "Vad innebär då detta?"
  },
  {
    "id": 21479,
    "book": "firstCorinthians                        ",
    "chapter": "14",
    "verse": "16",
    "text": "Om du tackar Gud i anden,"
  },
  {
    "id": 21480,
    "book": "firstCorinthians                        ",
    "chapter": "14",
    "verse": "17",
    "text": "Du gör rätt i att tacka Gud,"
  },
  {
    "id": 21481,
    "book": "firstCorinthians                        ",
    "chapter": "14",
    "verse": "18",
    "text": "Jag tackar Gud för att jag talar tungomål mer än någon av er."
  },
  {
    "id": 21482,
    "book": "firstCorinthians                        ",
    "chapter": "14",
    "verse": "19",
    "text": "Men i församlingen vill jag hellre tala"
  },
  {
    "id": 21483,
    "book": "firstCorinthians                        ",
    "chapter": "14",
    "verse": "20",
    "text": "Syskon (bröder och systrar i tron), var inte [som omogna] barn till förståndet (i era tankar)."
  },
  {
    "id": 21484,
    "book": "firstCorinthians                        ",
    "chapter": "14",
    "verse": "21",
    "text": "Det står skrivet i lagen:"
  },
  {
    "id": 21485,
    "book": "firstCorinthians                        ",
    "chapter": "14",
    "verse": "22",
    "text": "Alltså är tungomålen ett tecken"
  },
  {
    "id": 21486,
    "book": "firstCorinthians                        ",
    "chapter": "14",
    "verse": "23",
    "text": "Om nu hela församlingen samlas och alla talar [okända] tungomål"
  },
  {
    "id": 21487,
    "book": "firstCorinthians                        ",
    "chapter": "14",
    "verse": "24",
    "text": "Men om alla profeterar [i ordning, två eller tre i taget, se vers 29]"
  },
  {
    "id": 21488,
    "book": "firstCorinthians                        ",
    "chapter": "14",
    "verse": "25",
    "text": "Hans hjärtas hemligheter (inre liv) uppenbaras,"
  },
  {
    "id": 21489,
    "book": "firstCorinthians                        ",
    "chapter": "14",
    "verse": "26",
    "text": "Hur ska det då vara, syskon (bröder och systrar i tron)?"
  },
  {
    "id": 21490,
    "book": "firstCorinthians                        ",
    "chapter": "14",
    "verse": "27",
    "text": "Om någon [man eller kvinna i församlingen] talar tungomål"
  },
  {
    "id": 21491,
    "book": "firstCorinthians                        ",
    "chapter": "14",
    "verse": "28",
    "text": "Finns det ingen som uttyder"
  },
  {
    "id": 21492,
    "book": "firstCorinthians                        ",
    "chapter": "14",
    "verse": "29",
    "text": "Två eller tre profeter [män eller kvinnor, se 1 Kor 11:4-5] ska tala,"
  },
  {
    "id": 21493,
    "book": "firstCorinthians                        ",
    "chapter": "14",
    "verse": "30",
    "text": "Men om någon annan som sitter där får en uppenbarelse"
  },
  {
    "id": 21494,
    "book": "firstCorinthians                        ",
    "chapter": "14",
    "verse": "31",
    "text": "Ni kan alla profetera, en i sänder,"
  },
  {
    "id": 21495,
    "book": "firstCorinthians                        ",
    "chapter": "14",
    "verse": "32",
    "text": "Och profeternas andar underordnar sig profeterna."
  },
  {
    "id": 21496,
    "book": "firstCorinthians                        ",
    "chapter": "14",
    "verse": "33",
    "text": "För Gud är inte oordningens (förvirringens) Gud utan fridens. På samma sätt är det i alla andra heligas församlingar."
  },
  {
    "id": 21497,
    "book": "firstCorinthians                        ",
    "chapter": "14",
    "verse": "34",
    "text": "Kvinnorna ska vara tysta i era församlingar."
  },
  {
    "id": 21498,
    "book": "firstCorinthians                        ",
    "chapter": "14",
    "verse": "35",
    "text": "Vill de veta något ska de fråga sina män därhemma,"
  },
  {
    "id": 21499,
    "book": "firstCorinthians                        ",
    "chapter": "14",
    "verse": "36",
    "text": "Var det kanske från er som Guds ord gick ut,"
  },
  {
    "id": 21500,
    "book": "firstCorinthians                        ",
    "chapter": "14",
    "verse": "37",
    "text": "Om någon tror sig vara profet [som utvecklades i kap 11]"
  },
  {
    "id": 21501,
    "book": "firstCorinthians                        ",
    "chapter": "14",
    "verse": "38",
    "text": "Om någon inte erkänner detta,"
  },
  {
    "id": 21502,
    "book": "firstCorinthians                        ",
    "chapter": "14",
    "verse": "39",
    "text": "Alltså, mina syskon (bröder och systrar i tron),"
  },
  {
    "id": 21503,
    "book": "firstCorinthians                        ",
    "chapter": "14",
    "verse": "40",
    "text": "Men låt allt ske värdigt"
  }
]