[
  {
    "id": 21253,
    "book": "firstCorinthians                        ",
    "chapter": "6",
    "verse": "1",
    "text": "Hur kan någon av er som är i tvist med en annan [broder eller syster] gå till domstol inför de orättfärdiga och inte inför de heliga?"
  },
  {
    "id": 21254,
    "book": "firstCorinthians                        ",
    "chapter": "6",
    "verse": "2",
    "text": "Vet ni inte att de heliga ska döma världen?"
  },
  {
    "id": 21255,
    "book": "firstCorinthians                        ",
    "chapter": "6",
    "verse": "3",
    "text": "Vet ni inte att vi ska döma änglar?"
  },
  {
    "id": 21256,
    "book": "firstCorinthians                        ",
    "chapter": "6",
    "verse": "4",
    "text": "Men när ni har vardagliga tvister sätter ni folk till domare som församlingen inte har förtroende för."
  },
  {
    "id": 21257,
    "book": "firstCorinthians                        ",
    "chapter": "6",
    "verse": "5",
    "text": "Det här säger jag för att ni ska skämmas. Finns det ingen förståndig bland er, ingen som kan vara skiljedomare mellan bröder?"
  },
  {
    "id": 21258,
    "book": "firstCorinthians                        ",
    "chapter": "6",
    "verse": "6",
    "text": "I stället går broder till domstol med broder, och detta inför otroende."
  },
  {
    "id": 21259,
    "book": "firstCorinthians                        ",
    "chapter": "6",
    "verse": "7",
    "text": "Redan det att ni processar med varandra är ett nederlag för er."
  },
  {
    "id": 21260,
    "book": "firstCorinthians                        ",
    "chapter": "6",
    "verse": "8",
    "text": "I stället gör ni själva orätt och roffar åt er, och det drabbar syskon (bröder och systrar i tron)."
  },
  {
    "id": 21261,
    "book": "firstCorinthians                        ",
    "chapter": "6",
    "verse": "9",
    "text": "Vet ni inte att orättfärdiga inte ska få ärva Guds rike? Sluta att bedra er själva!"
  },
  {
    "id": 21262,
    "book": "firstCorinthians                        ",
    "chapter": "6",
    "verse": "10",
    "text": "[Fem andra synder:]"
  },
  {
    "id": 21263,
    "book": "firstCorinthians                        ",
    "chapter": "6",
    "verse": "11",
    "text": "Sådana har några av er varit."
  },
  {
    "id": 21264,
    "book": "firstCorinthians                        ",
    "chapter": "6",
    "verse": "12",
    "text": "[Ni säger:] ”Allt är tillåtet för mig”,"
  },
  {
    "id": 21265,
    "book": "firstCorinthians                        ",
    "chapter": "6",
    "verse": "13",
    "text": "[Ni säger:] ”Maten är till för magen"
  },
  {
    "id": 21266,
    "book": "firstCorinthians                        ",
    "chapter": "6",
    "verse": "14",
    "text": "Gud har uppväckt Herren,"
  },
  {
    "id": 21267,
    "book": "firstCorinthians                        ",
    "chapter": "6",
    "verse": "15",
    "text": "Vet ni inte"
