[
  {
    "id": 34406,
    "book": "joel                                    ",
    "chapter": "2",
    "verse": "1",
    "text": "Blås shofar (vädurshorn) i Sion [tempelberget i Jerusalem]!"
  },
  {
    "id": 34407,
    "book": "joel                                    ",
    "chapter": "2",
    "verse": "2",
    "text": "En dag av mörker och dysterhet,"
  },
  {
    "id": 34408,
    "book": "joel                                    ",
    "chapter": "2",
    "verse": "3",
    "text": "Framför dem slukar (äter) en eld"
  },
  {
    "id": 34409,
    "book": "joel                                    ",
    "chapter": "2",
    "verse": "4",
    "text": "De ger intrycket av att vara som hästar,"
  },
  {
    "id": 34410,
    "book": "joel                                    ",
    "chapter": "2",
    "verse": "5",
    "text": "Som ljudet av vagnar"
  },
  {
    "id": 34411,
    "book": "joel                                    ",
    "chapter": "2",
    "verse": "6",
    "text": "Inför dem har människorna ångest,"
  },
  {
    "id": 34412,
    "book": "joel                                    ",
    "chapter": "2",
    "verse": "7",
    "text": "De springer som mäktiga stridsmän;"
  },
  {
    "id": 34413,
    "book": "joel                                    ",
    "chapter": "2",
    "verse": "8",
    "text": "Den ene tränger inte den andre."
  },
  {
    "id": 34414,
    "book": "joel                                    ",
    "chapter": "2",
    "verse": "9",
    "text": "De rusar in i staden,"
  },
  {
    "id": 34415,
    "book": "joel                                    ",
    "chapter": "2",
    "verse": "10",
    "text": "Framför dem skakar (häver sig) marken [som en jordbävning],"
  },
  {
    "id": 34416,
    "book": "joel                                    ",
    "chapter": "2",
    "verse": "11",
    "text": "Herren (Jahve) ger (upphäver) sin röst"
  },
  {
    "id": 34417,
    "book": "joel                                    ",
    "chapter": "2",
    "verse": "12",
    "text": "Och även nu förkunnar (säger, proklamerar) Herren (Jahve) [som en bekräftelse på att Herrens dag är nära, se vers 1-11]:"
  },
  {
    "id": 34418,
    "book": "joel                                    ",
    "chapter": "2",
    "verse": "13",
    "text": "Riv sönder ert hjärta,"
  },
  {
    "id": 34419,
    "book": "joel                                    ",
    "chapter": "2",
    "verse": "14",
    "text": "Vem vet, kanske han ändrar sig (vänder om)"
  },
  {
    "id": 34420,
    "book": "joel                                    ",
    "chapter": "2",
    "verse": "15",
    "text": "Blås i shofar (horn) i Sion [för att samla till en helig sammankomst]!"
  },
  {
    "id": 34421,
    "book": "joel                                    ",
    "chapter": "2",
    "verse": "16",
    "text": "Samla folket,"
  },
  {
    "id": 34422,
    "book": "joel                                    ",
    "chapter": "2",
    "verse": "17",
    "text": "Må prästerna, Herrens tjänare, gråta mellan förhuset och altaret och säga:"
  },
  {
    "id": 34423,
    "book": "joel                                    ",
    "chapter": "2",
    "verse": "18",
    "text": "Då greps Herren av nitälskan (iver, hänfördhet) för sitt land,"
  },
  {
    "id": 34424,
    "book": "joel                                    ",
    "chapter": "2",
    "verse": "19",
    "text": "Herren svarade sitt folk:"
  },
  {
    "id": 34425,
    "book": "joel                                    ",
    "chapter": "2",
    "verse": "20",
    "text": "Men jag ska undanröja inkräktaren från norr långt bort från er,"
  },
  {
    "id": 34426,
    "book": "joel                                    ",
    "chapter": "2",
    "verse": "21",
    "text": "Frukta inte du land,"
  },
  {
    "id": 34427,
    "book": "joel                                    ",
    "chapter": "2",
    "verse": "22",
    "text": "Frukta inte ni markens djur,"
  },
  {
    "id": 34428,
    "book": "joel                                    ",
    "chapter": "2",
    "verse": "23",
    "text": "Var glada ni Sions [Jerusalems] barn"
  },
  {
    "id": 34429,
    "book": "joel                                    ",
    "chapter": "2",
    "verse": "24",
    "text": "Tröskplatsen ska bli full av säd"
  },
  {
    "id": 34430,
    "book": "joel                                    ",
    "chapter": "2",
    "verse": "25",
    "text": "Jag ska kompensera dig för de år som"
  },
  {
    "id": 34431,
    "book": "joel                                    ",
    "chapter": "2",
    "verse": "26",
    "text": "Ni ska äta rikligt och bli mätta"
  },
  {
    "id": 34432,
    "book": "joel                                    ",
    "chapter": "2",
    "verse": "27",
    "text": "Då ska ni veta att jag är i Israel."
  },
  {
    "id": 34433,
    "book": "joel                                    ",
    "chapter": "2",
    "verse": "28",
    "text": "Efter detta [Guds välsignelse över landet Israel och befrielsen från det norra riket, se vers 18-27] ska jag utgjuta min Ande över allt kött [över alla människor utan hänsyn till ålder, kön eller ställning]:"
  },
  {
    "id": 34434,
    "book": "joel                                    ",
    "chapter": "2",
    "verse": "29",
    "text": "Även över tjänare och tjänarinnor ska jag i de dagarna utgjuta min Ande."
  },
  {
    "id": 34435,
    "book": "joel                                    ",
    "chapter": "2",
    "verse": "30",
    "text": "Jag ska visa (producera) tecken (spektakulära förändringar) i himlen (skyn) och på jorden."
  },
  {
    "id": 34436,
    "book": "joel                                    ",
    "chapter": "2",
    "verse": "31",
    "text": "Solen ska vändas i mörker och månen i blod [bli röd som blod.]"
  },
  {
    "id": 34437,
    "book": "joel                                    ",
    "chapter": "2",
    "verse": "32",
    "text": "Och det ska ske att var och en som kallar på (åkallar) Herrens (Jahves) namn [inbjuder och ropar på honom]"
  }
]