[
  {
    "id": 25513,
    "book": "habakkuk                                ",
    "chapter": "1",
    "verse": "1",
    "text": "Budskapet (profetordet, bördan) som profeten Habackuk såg i en syn (vision)."
  },
  {
    "id": 25514,
    "book": "habakkuk                                ",
    "chapter": "1",
    "verse": "2",
    "text": "Hur länge, Herre (Jahve), ska jag ropa [om hjälp]"
  },
  {
    "id": 25515,
    "book": "habakkuk                                ",
    "chapter": "1",
    "verse": "3",
    "text": "Varför visar du mig missgärningar"
  },
  {
    "id": 25516,
    "book": "habakkuk                                ",
    "chapter": "1",
    "verse": "4",
    "text": "Därför [som en konsekvens] är undervisningen (hebr. Torah) förlamad"
  },
  {
    "id": 25517,
    "book": "habakkuk                                ",
    "chapter": "1",
    "verse": "5",
    "text": "Titta (er omkring) bland hednafolken (länderna) och se"
  },
  {
    "id": 25518,
    "book": "habakkuk                                ",
    "chapter": "1",
    "verse": "6",
    "text": "Jag ska resa upp kaldéerna [babylonierna],"
  },
  {
    "id": 25519,
    "book": "habakkuk                                ",
    "chapter": "1",
    "verse": "7",
    "text": "[Nu beskrivs babyloniernas arrogans:]"
  },
  {
    "id": 25520,
    "book": "habakkuk                                ",
    "chapter": "1",
    "verse": "8",
    "text": "Deras hästar är vigare än leoparder"
  },
  {
    "id": 25521,
    "book": "habakkuk                                ",
    "chapter": "1",
    "verse": "9",
    "text": "Alla kommer med ont uppsåt,"
  },
  {
    "id": 25522,
    "book": "habakkuk                                ",
    "chapter": "1",
    "verse": "10",
    "text": "De hånskrattar åt kungar"
  },
  {
    "id": 25523,
    "book": "habakkuk                                ",
    "chapter": "1",
    "verse": "11",
    "text": "När de sveper förbi"
  },
  {
    "id": 25524,
    "book": "habakkuk                                ",
    "chapter": "1",
    "verse": "12",
    "text": "Är inte du från urminnes tid (från öster) Herre min Gud (Jahve Elohim) min Helige?"
  },
  {
    "id": 25525,
    "book": "habakkuk                                ",
    "chapter": "1",
    "verse": "13",
    "text": "Du som har ögon allt för rena för att se ondskan"
  },
  {
    "id": 25526,
    "book": "habakkuk                                ",
    "chapter": "1",
    "verse": "14",
    "text": "Varför gör du människan som havets fiskar,"
  },
  {
    "id": 25527,
    "book": "habakkuk                                ",
    "chapter": "1",
    "verse": "15",
    "text": "De tar upp dem med sina fiskespön,"
  },
  {
    "id": 25528,
    "book": "habakkuk                                ",
    "chapter": "1",
    "verse": "16",
    "text": "Därför offrar de till sina nät och offrar till sina fisketrålar,"
  },
  {
    "id": 25529,
    "book": "habakkuk                                ",
    "chapter": "1",
    "verse": "17",
    "text": "Ska de få tömma sina nät"
  }
]