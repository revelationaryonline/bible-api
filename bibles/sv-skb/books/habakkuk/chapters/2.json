[
  {
    "id": 25530,
    "book": "habakkuk                                ",
    "chapter": "2",
    "verse": "1",
    "text": "Jag ska inställa mig på min vaktpost,"
  },
  {
    "id": 25531,
    "book": "habakkuk                                ",
    "chapter": "2",
    "verse": "2",
    "text": "Herren (Jahve) svarade mig och sade:"
  },
  {
    "id": 25532,
    "book": "habakkuk                                ",
    "chapter": "2",
    "verse": "3",
    "text": "För ännu måste synen (visionen) vänta på sin bestämda tid."
  },
  {
    "id": 25533,
    "book": "habakkuk                                ",
    "chapter": "2",
    "verse": "4",
    "text": "Se, hans själ i honom [Babylon – den onda nationen – personifierad] är uppblåst [av högmod],"
  },
  {
    "id": 25534,
    "book": "habakkuk                                ",
    "chapter": "2",
    "verse": "5",
    "text": "Dessutom är vinet en förrädisk bekantskap,"
  },
  {
    "id": 25535,
    "book": "habakkuk                                ",
    "chapter": "2",
    "verse": "6",
    "text": "Ska inte alla dessa göra ett ordspråk mot honom"
  },
  {
    "id": 25536,
    "book": "habakkuk                                ",
    "chapter": "2",
    "verse": "7",
    "text": "Ska de inte plötsligt resa sig, de som ska ta ränta av dig,"
  },
  {
    "id": 25537,
    "book": "habakkuk                                ",
    "chapter": "2",
    "verse": "8",
    "text": "Eftersom du har fördärvat många länder,"
  },
  {
    "id": 25538,
    "book": "habakkuk                                ",
    "chapter": "2",
    "verse": "9",
    "text": "Ve över honom som får ondskans vinster för sitt hus,"
  },
  {
    "id": 25539,
    "book": "habakkuk                                ",
    "chapter": "2",
    "verse": "10",
    "text": "Du har gett skamliga råd till ditt hus"
  },
  {
    "id": 25540,
    "book": "habakkuk                                ",
    "chapter": "2",
    "verse": "11",
    "text": "Stenen ska ropa ut från muren"
  },
  {
    "id": 25541,
    "book": "habakkuk                                ",
    "chapter": "2",
    "verse": "12",
    "text": "Ve över honom som bygger en stad med blod"
  },
  {
    "id": 25542,
    "book": "habakkuk                                ",
    "chapter": "2",
    "verse": "13",
    "text": "Se, är det inte från Härskarornas Herre (Jahve Sebaot)"
  },
  {
    "id": 25543,
    "book": "habakkuk                                ",
    "chapter": "2",
    "verse": "14",
    "text": "För jorden ska uppfyllas av kunskapen (insikten, förståelsen)"
  },
  {
    "id": 25544,
    "book": "habakkuk                                ",
    "chapter": "2",
    "verse": "15",
    "text": "Ve över honom som ger sin granne att dricka"
  },
  {
    "id": 25545,
    "book": "habakkuk                                ",
    "chapter": "2",
    "verse": "16",
    "text": "Du är full av skam istället för ära."
  },
  {
    "id": 25546,
    "book": "habakkuk                                ",
    "chapter": "2",
    "verse": "17",
    "text": "Våldet som utförts mot Libanon [när du skövlade cederträden, se Jes 14:8; 37:24] ska täcka dig"
  },
  {
    "id": 25547,
    "book": "habakkuk                                ",
    "chapter": "2",
    "verse": "18",
    "text": "Vilken vinning ger de skurna avgudarna, att den som gör dem har skurit ut det,"
  },
  {
    "id": 25548,
    "book": "habakkuk                                ",
    "chapter": "2",
    "verse": "19",
    "text": "Ve över honom som säger till träet: ”Vakna”,"
  },
  {
    "id": 25549,
    "book": "habakkuk                                ",
    "chapter": "2",
    "verse": "20",
    "text": "Men Herren (Jahve) är i sitt heliga tempel,"
  }
]