[
  {
    "id": 25550,
    "book": "habakkuk                                ",
    "chapter": "3",
    "verse": "1",
    "text": "En sjungen bön av profeten Habakkuk, till ”shigjonot” [en melodi – kanske med flera tvära kast]."
  },
  {
    "id": 25551,
    "book": "habakkuk                                ",
    "chapter": "3",
    "verse": "2",
    "text": "Herre (Jahve),"
  },
  {
    "id": 25552,
    "book": "habakkuk                                ",
    "chapter": "3",
    "verse": "3",
    "text": "Gud (Eloha) [singular för Elohim – den ende Guden] kommer från Teman"
  },
  {
    "id": 25553,
    "book": "habakkuk                                ",
    "chapter": "3",
    "verse": "4",
    "text": "Ett sken som ljuset blev synligt,"
  },
  {
    "id": 25554,
    "book": "habakkuk                                ",
    "chapter": "3",
    "verse": "5",
    "text": "Framför honom går pesten,"
  },
  {
    "id": 25555,
    "book": "habakkuk                                ",
    "chapter": "3",
    "verse": "6",
    "text": "Han står och jorden skakar,"
  },
  {
    "id": 25556,
    "book": "habakkuk                                ",
    "chapter": "3",
    "verse": "7",
    "text": "Jag ser Koshans tält under hemsökelse,"
  },
  {
    "id": 25557,
    "book": "habakkuk                                ",
    "chapter": "3",
    "verse": "8",
    "text": "Herre (Jahve) är din vrede (vänd) mot floder?"
  },
  {
    "id": 25558,
    "book": "habakkuk                                ",
    "chapter": "3",
    "verse": "9",
    "text": "Din båge är helt naken,"
  },
  {
    "id": 25559,
    "book": "habakkuk                                ",
    "chapter": "3",
    "verse": "10",
    "text": "Bergen har sett dig och de skälver,"
  },
  {
    "id": 25560,
    "book": "habakkuk                                ",
    "chapter": "3",
    "verse": "11",
    "text": "Solen och månen står stilla i sina boningar,"
  },
  {
    "id": 25561,
    "book": "habakkuk                                ",
    "chapter": "3",
    "verse": "12",
    "text": "Du marscherar genom världen i harm,"
  },
  {
    "id": 25562,
    "book": "habakkuk                                ",
    "chapter": "3",
    "verse": "13",
    "text": "Du har kommit för att befria ditt folk,"
  },
  {
    "id": 25563,
    "book": "habakkuk                                ",
    "chapter": "3",
    "verse": "14",
    "text": "Du har genomborrat hans hövding med hans egen stav,"
  },
  {
    "id": 25564,
    "book": "habakkuk                                ",
    "chapter": "3",
    "verse": "15",
    "text": "Du har trampat havet med dina hästar,"
  },
  {
    "id": 25565,
    "book": "habakkuk                                ",
    "chapter": "3",
    "verse": "16",
    "text": "Jag hör [Gud tala, se vers 2], och min kropp skakar (jag blir illamående),"
  },
  {
    "id": 25566,
    "book": "habakkuk                                ",
    "chapter": "3",
    "verse": "17",
    "text": "För även"
  },
  {
    "id": 25567,
    "book": "habakkuk                                ",
    "chapter": "3",
    "verse": "18",
    "text": "så vill jag ändå jubla (triumfera; hoppa av glädje) i Herren (Jahve),"
  },
  {
    "id": 25568,
    "book": "habakkuk                                ",
    "chapter": "3",
    "verse": "19",
    "text": "Herren min Gud (Jahve Adonaj) är min styrka [Ps 27:1]"
  }
]