[
  {
    "id": 45552,
    "book": "micah                                   ",
    "chapter": "1",
    "verse": "1",
    "text": "Herrens (Jahves) ord som kom till morashtiten Mika [som förmedlade dessa profetiska ord] i de dagarna [758-698 f.Kr.] då Jotam, Achaz och Hiskia var kungar i Juda [det södra riket]. Detta är vad han såg angående Samarien och Jerusalem."
  },
  {
    "id": 45553,
    "book": "micah                                   ",
    "chapter": "1",
    "verse": "2",
    "text": "Hör (lyssna) alla ni folk!"
  },
  {
    "id": 45554,
    "book": "micah                                   ",
    "chapter": "1",
    "verse": "3",
    "text": "För se, Herren (Jahve) kommer fram, ut från sin plats"
  },
  {
    "id": 45555,
    "book": "micah                                   ",
    "chapter": "1",
    "verse": "4",
    "text": "Och bergen ska smälta under honom"
  },
  {
    "id": 45556,
    "book": "micah                                   ",
    "chapter": "1",
    "verse": "5",
    "text": "Allt detta är för Jakobs överträdelser"
  },
  {
    "id": 45557,
    "book": "micah                                   ",
    "chapter": "1",
    "verse": "6",
    "text": "[Samarien:]"
  },
  {
    "id": 45558,
    "book": "micah                                   ",
    "chapter": "1",
    "verse": "7",
    "text": "Alla hennes skurna avgudabilder ska slås i bitar"
  },
  {
    "id": 45559,
    "book": "micah                                   ",
    "chapter": "1",
    "verse": "8",
    "text": "[Jerusalem:]"
  },
  {
    "id": 45560,
    "book": "micah                                   ",
    "chapter": "1",
    "verse": "9",
    "text": "För hennes skada är oläklig,"
  },
  {
    "id": 45561,
    "book": "micah                                   ",
    "chapter": "1",
    "verse": "10",
    "text": "I Gat – berätta (hebr. nagad) inte,"
  },
  {
    "id": 45562,
    "book": "micah                                   ",
    "chapter": "1",
    "verse": "11",
    "text": "I nakenhet och skam förs ni bort [till fångenskap],"
  },
  {
    "id": 45563,
    "book": "micah                                   ",
    "chapter": "1",
    "verse": "12",
    "text": "För Maroths [liknar hebr. marah – ”bitter”] invånare väntade ängsligt på det goda,"
  },
  {
    "id": 45564,
    "book": "micah                                   ",
    "chapter": "1",
    "verse": "13",
    "text": "Spänn för vagnarna (hebr. rekesh) på de snabba hästarna ni Lachis invånare [”hästekipage-staden”],"
  },
  {
    "id": 45565,
    "book": "micah                                   ",
    "chapter": "1",
    "verse": "14",
    "text": "Därför ska du ge en avskedsgåva"
  },
  {
    "id": 45566,
    "book": "micah                                   ",
    "chapter": "1",
    "verse": "15",
    "text": "Jag ska föra till er, ni invånare i Mareshah [betyder ”toppen på ett berg” – ointaglig],"
  },
  {
    "id": 45567,
    "book": "micah                                   ",
    "chapter": "1",
    "verse": "16",
    "text": "Gör [raka] dig skallig [för att visa sorg]"
  }
]