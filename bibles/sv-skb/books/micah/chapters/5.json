[
  {
    "id": 45606,
    "book": "micah                                   ",
    "chapter": "5",
    "verse": "1",
    "text": "Församla nu dig själv i skaror,"
  },
  {
    "id": 45607,
    "book": "micah                                   ",
    "chapter": "5",
    "verse": "2",
    "text": "Men du Betlehem, Efrata,"
  },
  {
    "id": 45608,
    "book": "micah                                   ",
    "chapter": "5",
    "verse": "3",
    "text": "Sedan ska Herren överge dem [överlämna Israels folk åt deras fiender]"
  },
  {
    "id": 45609,
    "book": "micah                                   ",
    "chapter": "5",
    "verse": "4",
    "text": "Han [Messias] ska träda fram och vara en herde för (leda, föda) sin hjord"
  },
  {
    "id": 45610,
    "book": "micah                                   ",
    "chapter": "5",
    "verse": "5",
    "text": "Och detta ska vara frid (shalom):"
  },
  {
    "id": 45611,
    "book": "micah                                   ",
    "chapter": "5",
    "verse": "6",
    "text": "Och de ska ödelägga Ashurs land med svärd"
  },
  {
    "id": 45612,
    "book": "micah                                   ",
    "chapter": "5",
    "verse": "7",
    "text": "Och kvarlevan av Jakob"
  },
  {
    "id": 45613,
    "book": "micah                                   ",
    "chapter": "5",
    "verse": "8",
    "text": "Och Jakobs kvarleva ska vara i mitten bland nationerna"
  },
  {
    "id": 45614,
    "book": "micah                                   ",
    "chapter": "5",
    "verse": "9",
    "text": "Låt din hand vara upplyft över dina motståndare"
  },
  {
    "id": 45615,
    "book": "micah                                   ",
    "chapter": "5",
    "verse": "10",
    "text": "Och det ska ske på den dagen,"
  },
  {
    "id": 45616,
    "book": "micah                                   ",
    "chapter": "5",
    "verse": "11",
    "text": "och jag ska hugga av städerna från ditt land"
  },
  {
    "id": 45617,
    "book": "micah                                   ",
    "chapter": "5",
    "verse": "12",
    "text": "jag ska hugga av häxkraft ut ur din hand"
  },
  {
    "id": 45618,
    "book": "micah                                   ",
    "chapter": "5",
    "verse": "13",
    "text": "och jag ska hugga av dina skurna avgudar"
  },
  {
    "id": 45619,
    "book": "micah                                   ",
    "chapter": "5",
    "verse": "14",
    "text": "Och jag ska plocka bort dina aseror [pålar för avgudadyrkan], ut ur din mitt,"
  },
  {
    "id": 45620,
    "book": "micah                                   ",
    "chapter": "5",
    "verse": "15",
    "text": "Och i vrede och raseri ska jag verkställa hämnd över nationerna,"
  }
]