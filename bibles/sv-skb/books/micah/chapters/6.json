[
  {
    "id": 45621,
    "book": "micah                                   ",
    "chapter": "6",
    "verse": "1",
    "text": "Snälla, lyssna nu på vad Herren (Jahve) säger:"
  },
  {
    "id": 45622,
    "book": "micah                                   ",
    "chapter": "6",
    "verse": "2",
    "text": "Hör ni berg, Herrens (Jahves) polemik (resonemang, sak),"
  },
  {
    "id": 45623,
    "book": "micah                                   ",
    "chapter": "6",
    "verse": "3",
    "text": "Mitt folk, vad har jag gjort mot er?"
  },
  {
    "id": 45624,
    "book": "micah                                   ",
    "chapter": "6",
    "verse": "4",
    "text": "För jag förde dig upp och ut ur Egyptens land"
  },
  {
    "id": 45625,
    "book": "micah                                   ",
    "chapter": "6",
    "verse": "5",
    "text": "Mitt folk, kom nu ihåg"
  },
  {
    "id": 45626,
    "book": "micah                                   ",
    "chapter": "6",
    "verse": "6",
    "text": "Med vad (hur) ska jag komma inför Herren (Jahve)"
  },
  {
    "id": 45627,
    "book": "micah                                   ",
    "chapter": "6",
    "verse": "7",
    "text": "Glädjer sig Herren (Jahve) åt baggar i tusental,"
  },
  {
    "id": 45628,
    "book": "micah                                   ",
    "chapter": "6",
    "verse": "8",
    "text": "Han har visat dig (förklarat; gjort känt) [speciellt sådant som varit oklart och dolt, se Heb 9:23; 10:1] du människa,"
  },
  {
    "id": 45629,
    "book": "micah                                   ",
    "chapter": "6",
    "verse": "9",
    "text": "Lyssna! Herren ropar till staden"
  },
  {
    "id": 45630,
    "book": "micah                                   ",
    "chapter": "6",
    "verse": "10",
    "text": "Är fortfarande ondskans skatter i den ondes hus"
  },
  {
    "id": 45631,
    "book": "micah                                   ",
    "chapter": "6",
    "verse": "11",
    "text": "Ska jag bli ren med en ond (manipulerad) våg"
  },
  {
    "id": 45632,
    "book": "micah                                   ",
    "chapter": "6",
    "verse": "12",
    "text": "Den rike mannen är därigenom full av våld,"
  },
  {
    "id": 45633,
    "book": "micah                                   ",
    "chapter": "6",
    "verse": "13",
    "text": "Därför slår jag dig också med djupa sår,"
  },
  {
    "id": 45634,
    "book": "micah                                   ",
    "chapter": "6",
    "verse": "14",
    "text": "Du ska äta men inte bli mätt,"
  },
  {
    "id": 45635,
    "book": "micah                                   ",
    "chapter": "6",
    "verse": "15",
    "text": "Du ska så men du ska inte skörda,"
  },
  {
    "id": 45636,
    "book": "micah                                   ",
    "chapter": "6",
    "verse": "16",
    "text": "[Den onda kungen] Omris förordningar (ordagrant ”saker inristat”) efterlevs"
  }
]