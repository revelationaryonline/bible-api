[
  {
    "id": 45593,
    "book": "micah                                   ",
    "chapter": "4",
    "verse": "1",
    "text": "I de sista (yttersta) dagarna"
  },
  {
    "id": 45594,
    "book": "micah                                   ",
    "chapter": "4",
    "verse": "2",
    "text": "Många folk ska komma och säga:"
  },
  {
    "id": 45595,
    "book": "micah                                   ",
    "chapter": "4",
    "verse": "3",
    "text": "Han ska döma mellan många folk (överbevisa om synd)"
  },
  {
    "id": 45596,
    "book": "micah                                   ",
    "chapter": "4",
    "verse": "4",
    "text": "Var och en ska sitta under sin vinstock"
  },
  {
    "id": 45597,
    "book": "micah                                   ",
    "chapter": "4",
    "verse": "5",
    "text": "Men låt alla folk vandra,"
  },
  {
    "id": 45598,
    "book": "micah                                   ",
    "chapter": "4",
    "verse": "6",
    "text": "På den dagen, förkunnar (säger, proklamerar) Herren (Jahve),"
  },
  {
    "id": 45599,
    "book": "micah                                   ",
    "chapter": "4",
    "verse": "7",
    "text": "och jag ska göra henne som haltade till en kvarleva,"
  },
  {
    "id": 45600,
    "book": "micah                                   ",
    "chapter": "4",
    "verse": "8",
    "text": "Och du herdetorn (hebr. Migdal eder; ett torn som herdarna använde när de vakade över hjorden i fållan),"
  },
  {
    "id": 45601,
    "book": "micah                                   ",
    "chapter": "4",
    "verse": "9",
    "text": "Varför ropar du nu så högt?"
  },
  {
    "id": 45602,
    "book": "micah                                   ",
    "chapter": "4",
    "verse": "10",
    "text": "Våndas och föd dotter Sion,"
  },
  {
    "id": 45603,
    "book": "micah                                   ",
    "chapter": "4",
    "verse": "11",
    "text": "Och nu är många nationer församlade"
  },
  {
    "id": 45604,
    "book": "micah                                   ",
    "chapter": "4",
    "verse": "12",
    "text": "Men de känner inte till"
  },
  {
    "id": 45605,
    "book": "micah                                   ",
    "chapter": "4",
    "verse": "13",
    "text": "Ställ dig upp och tröska, dotter Sion,"
  }
]