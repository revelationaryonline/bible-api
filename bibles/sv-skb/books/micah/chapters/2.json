[
  {
    "id": 45568,
    "book": "micah                                   ",
    "chapter": "2",
    "verse": "1",
    "text": "Ve (hebr. hoj) över dem som förordar orättfärdighet"
  },
  {
    "id": 45569,
    "book": "micah                                   ",
    "chapter": "2",
    "verse": "2",
    "text": "De åtrår fält och belägrar dem,"
  },
  {
    "id": 45570,
    "book": "micah                                   ",
    "chapter": "2",
    "verse": "3",
    "text": "Därför säger Herren (Jahve):"
  },
  {
    "id": 45571,
    "book": "micah                                   ",
    "chapter": "2",
    "verse": "4",
    "text": "På den dagen ska man ta upp ett ordspråk (liknelse) över dig"
  },
  {
    "id": 45572,
    "book": "micah                                   ",
    "chapter": "2",
    "verse": "5",
    "text": "Därför ska du inte ha någon i Herrens (Jahves) församling"
  },
  {
    "id": 45573,
    "book": "micah                                   ",
    "chapter": "2",
    "verse": "6",
    "text": "”Predika (profetera) inte”,"
  },
  {
    "id": 45574,
    "book": "micah                                   ",
    "chapter": "2",
    "verse": "7",
    "text": "Är jag föränderlig, du Jakobs hus?"
  },
  {
    "id": 45575,
    "book": "micah                                   ",
    "chapter": "2",
    "verse": "8",
    "text": "Men sedan en tid har mitt folk rest sig upp"
  },
  {
    "id": 45576,
    "book": "micah                                   ",
    "chapter": "2",
    "verse": "9",
    "text": "Mitt folks kvinnor kastar ni ut"
  },
  {
    "id": 45577,
    "book": "micah                                   ",
    "chapter": "2",
    "verse": "10",
    "text": "Stå upp och gå bort (försvinn härifrån)"
  },
  {
    "id": 45578,
    "book": "micah                                   ",
    "chapter": "2",
    "verse": "11",
    "text": "Även om en man vandrar i vinden och lögn (tomhet och lögn; lögnens ande) och ljuger:"
  },
  {
    "id": 45579,
    "book": "micah                                   ",
    "chapter": "2",
    "verse": "12",
    "text": "Jag ska verkligen församla Jakob, allesammans."
  },
  {
    "id": 45580,
    "book": "micah                                   ",
    "chapter": "2",
    "verse": "13",
    "text": "Murbräckan (ordagrant: genombrytaren – den som slår upp porten) har gått upp framför dem,"
  }
]