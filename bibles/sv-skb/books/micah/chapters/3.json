[
  {
    "id": 45581,
    "book": "micah                                   ",
    "chapter": "3",
    "verse": "1",
    "text": "Och jag sade:"
  },
  {
    "id": 45582,
    "book": "micah                                   ",
    "chapter": "3",
    "verse": "2",
    "text": "Den som hatar gott och älskar ont,"
  },
  {
    "id": 45583,
    "book": "micah                                   ",
    "chapter": "3",
    "verse": "3",
    "text": "den som äter mitt folks kött"
  },
  {
    "id": 45584,
    "book": "micah                                   ",
    "chapter": "3",
    "verse": "4",
    "text": "Sedan ropar de till Herren (Jahve)"
  },
  {
    "id": 45585,
    "book": "micah                                   ",
    "chapter": "3",
    "verse": "5",
    "text": "Detta är vad Herren säger till de [falska] profeter"
  },
  {
    "id": 45586,
    "book": "micah                                   ",
    "chapter": "3",
    "verse": "6",
    "text": "Därför ska det bli natt,"
  },
  {
    "id": 45587,
    "book": "micah                                   ",
    "chapter": "3",
    "verse": "7",
    "text": "Siarna (de som ser syner) ska stå där med skam,"
  },
  {
    "id": 45588,
    "book": "micah                                   ",
    "chapter": "3",
    "verse": "8",
    "text": "Men jag [Mika] är uppfylld"
  },
  {
    "id": 45589,
    "book": "micah                                   ",
    "chapter": "3",
    "verse": "9",
    "text": "Hör detta, jag vädjar till er, ni ledare över Jakobs hus"
  },
  {
    "id": 45590,
    "book": "micah                                   ",
    "chapter": "3",
    "verse": "10",
    "text": "som bygger upp Sion med blod"
  },
  {
    "id": 45591,
    "book": "micah                                   ",
    "chapter": "3",
    "verse": "11",
    "text": "Deras ledare dömer för (egen) vinning,"
  },
  {
    "id": 45592,
    "book": "micah                                   ",
    "chapter": "3",
    "verse": "12",
    "text": "Därför ska för din skull"
  }
]