[
  {
    "id": 45637,
    "book": "micah                                   ",
    "chapter": "7",
    "verse": "1",
    "text": "Ve mig (uttryck för intensiv förtvivlan och vemod)!"
  },
  {
    "id": 45638,
    "book": "micah                                   ",
    "chapter": "7",
    "verse": "2",
    "text": "De trofasta är borta ur landet,"
  },
  {
    "id": 45639,
    "book": "micah                                   ",
    "chapter": "7",
    "verse": "3",
    "text": "Händerna [på dem som borde veta bättre] är skickliga (ivriga, fullt engagerade i) att göra det onda:"
  },
  {
    "id": 45640,
    "book": "micah                                   ",
    "chapter": "7",
    "verse": "4",
    "text": "Den bäste är [smärtsam] som en törnbuske [som river den som kommer nära],"
  },
  {
    "id": 45641,
    "book": "micah                                   ",
    "chapter": "7",
    "verse": "5",
    "text": "Lita inte på en vän,"
  },
  {
    "id": 45642,
    "book": "micah                                   ",
    "chapter": "7",
    "verse": "6",
    "text": "För sonen föraktar (förkastar) sin far,"
  },
  {
    "id": 45643,
    "book": "micah                                   ",
    "chapter": "7",
    "verse": "7",
    "text": "Men jag, jag ska skåda (hålla utkik) efter Herren (Jahve),"
  },
  {
    "id": 45644,
    "book": "micah                                   ",
    "chapter": "7",
    "verse": "8",
    "text": "Gläd dig inte över mig,"
  },
  {
    "id": 45645,
    "book": "micah                                   ",
    "chapter": "7",
    "verse": "9",
    "text": "Jag ska bära Herrens (Jahves) harm"
  },
  {
    "id": 45646,
    "book": "micah                                   ",
    "chapter": "7",
    "verse": "10",
    "text": "Sedan ska min fiende se det"
  },
  {
    "id": 45647,
    "book": "micah                                   ",
    "chapter": "7",
    "verse": "11",
    "text": "En dag till att bygga upp dina murar,"
  },
  {
    "id": 45648,
    "book": "micah                                   ",
    "chapter": "7",
    "verse": "12",
    "text": "Det ska komma en dag när de ska komma till dig"
  },
  {
    "id": 45649,
    "book": "micah                                   ",
    "chapter": "7",
    "verse": "13",
    "text": "Landet ska bli ödelagt för dem som bor där"
  },
  {
    "id": 45650,
    "book": "micah                                   ",
    "chapter": "7",
    "verse": "14",
    "text": "Vakta ditt folk, med din stav"
  },
  {
    "id": 45651,
    "book": "micah                                   ",
    "chapter": "7",
    "verse": "15",
    "text": "Som i de dagar då du kom ut ur Egyptens land,"
  },
  {
    "id": 45652,
    "book": "micah                                   ",
    "chapter": "7",
    "verse": "16",
    "text": "Länderna ska se och komma på skam"
  },
  {
    "id": 45653,
    "book": "micah                                   ",
    "chapter": "7",
    "verse": "17",
    "text": "De ska slicka stoftet som en orm,"
  },
  {
    "id": 45654,
    "book": "micah                                   ",
    "chapter": "7",
    "verse": "18",
    "text": "Vem är en Gud som du [nej, det finns ingen],"
  },
  {
    "id": 45655,
    "book": "micah                                   ",
    "chapter": "7",
    "verse": "19",
    "text": "Han ska på nytt förbarma sig (visa nåd) över oss."
  },
  {
    "id": 45656,
    "book": "micah                                   ",
    "chapter": "7",
    "verse": "20",
    "text": "Du ska visa trofasthet (fasthet, sanning, trovärdighet, pålitlighet) mot Jakob"
  }
]