[
  {
    "id": 33123,
    "book": "isaiah                                  ",
    "chapter": "56",
    "verse": "1",
    "text": "Så säger Herren (Jahve)."
  },
  {
    "id": 33124,
    "book": "isaiah                                  ",
    "chapter": "56",
    "verse": "2",
    "text": "Lycklig (salig) är den människa som gör detta"
  },
  {
    "id": 33125,
    "book": "isaiah                                  ",
    "chapter": "56",
    "verse": "3",
    "text": "Låt inte främlingen som har anslutit sig till Herren (Jahve) tala och säga:"
  },
  {
    "id": 33126,
    "book": "isaiah                                  ",
    "chapter": "56",
    "verse": "4",
    "text": "För så säger Herren"
  },
  {
    "id": 33127,
    "book": "isaiah                                  ",
    "chapter": "56",
    "verse": "5",
    "text": "Också till dem ska jag, i mitt hus och inom mina murar,"
  },
  {
    "id": 33128,
    "book": "isaiah                                  ",
    "chapter": "56",
    "verse": "6",
    "text": "Även främlingar som sluter sig till Herren"
  },
  {
    "id": 33129,
    "book": "isaiah                                  ",
    "chapter": "56",
    "verse": "7",
    "text": "alla dem ska jag föra till mitt heliga tempel"
  },
  {
    "id": 33130,
    "book": "isaiah                                  ",
    "chapter": "56",
    "verse": "8",
    "text": "Så förkunnar (säger, proklamerar) Herren Gud (Adonaj Jahve)"
  },
  {
    "id": 33131,
    "book": "isaiah                                  ",
    "chapter": "56",
    "verse": "9",
    "text": "Alla fältets vilddjur kom och sluka,"
  },
  {
    "id": 33132,
    "book": "isaiah                                  ",
    "chapter": "56",
    "verse": "10",
    "text": "Alla hans väktare är blinda,"
  },
  {
    "id": 33133,
    "book": "isaiah                                  ",
    "chapter": "56",
    "verse": "11",
    "text": "Ja hundarna är glupska,"
  },
  {
    "id": 33134,
    "book": "isaiah                                  ",
    "chapter": "56",
    "verse": "12",
    "text": "Kom, jag ska hämta vin"
  }
]