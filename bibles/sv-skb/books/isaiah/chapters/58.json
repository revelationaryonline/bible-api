[
  {
    "id": 33156,
    "book": "isaiah                                  ",
    "chapter": "58",
    "verse": "1",
    "text": "Ropa högt (med stark röst, för full hals) håll inte tillbaka,"
  },
  {
    "id": 33157,
    "book": "isaiah                                  ",
    "chapter": "58",
    "verse": "2",
    "text": "Sök mig dagligen och ha din glädje och tillfredsställelse i att känna till (ha intim kunskap om) mina vägar,"
  },
  {
    "id": 33158,
    "book": "isaiah                                  ",
    "chapter": "58",
    "verse": "3",
    "text": "”Varför har vi fastat när du inte ser oss?"
  },
  {
    "id": 33159,
    "book": "isaiah                                  ",
    "chapter": "58",
    "verse": "4",
    "text": "Se, ni fastar samtidigt som det är strider (uppdelningar, grupperingar), bråk (stridigheter),"
  },
  {
    "id": 33160,
    "book": "isaiah                                  ",
    "chapter": "58",
    "verse": "5",
    "text": "Är det den här sortens fasta jag vill ha?"
  },
  {
    "id": 33161,
    "book": "isaiah                                  ",
    "chapter": "58",
    "verse": "6",
    "text": "Nej, detta är den fasta jag vill ha:"
  },
  {
    "id": 33162,
    "book": "isaiah                                  ",
    "chapter": "58",
    "verse": "7",
    "text": "Dela ditt bröd med den som är hungrig."
  },
  {
    "id": 33163,
    "book": "isaiah                                  ",
    "chapter": "58",
    "verse": "8",
    "text": "Då ska ditt ljus bryta fram som ljuset bryter fram på morgonen,"
  },
  {
    "id": 33164,
    "book": "isaiah                                  ",
    "chapter": "58",
    "verse": "9",
    "text": "Då ska ni be och Herren (Jahve) ska svara."
  },
  {
    "id": 33165,
    "book": "isaiah                                  ",
    "chapter": "58",
    "verse": "10",
    "text": "Om du ger ut av dig själv (din själ) till den hungrige"
  },
  {
    "id": 33166,
    "book": "isaiah                                  ",
    "chapter": "58",
    "verse": "11",
    "text": "Herren ska leda dig oavbrutet (kontinuerligt, hela tiden)"
  },
  {
    "id": 33167,
    "book": "isaiah                                  ",
    "chapter": "58",
    "verse": "12",
    "text": "Du ska åter bygga upp gamla ruiner."
  },
  {
    "id": 33168,
    "book": "isaiah                                  ",
    "chapter": "58",
    "verse": "13",
    "text": "Om du på sabbaten avhåller din fot"
  },
  {
    "id": 33169,
    "book": "isaiah                                  ",
    "chapter": "58",
    "verse": "14",
    "text": "då ska du fröjda dig själv i Herren (Jahve)"
  }
]