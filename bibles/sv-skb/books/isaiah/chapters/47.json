    "chapter": "47",
    "verse": "1",
    "text": "Kom ner och sitt i stoftet"
  },
  {
    "id": 32971,
    "book": "isaiah                                  ",
    "chapter": "47",
    "verse": "2",
    "text": "Ta kvarnstenarna och mal mjöl,"
  },
  {
    "id": 32972,
    "book": "isaiah                                  ",
    "chapter": "47",
    "verse": "3",
    "text": "Din nakenhet ska blottas,"
  },
  {
    "id": 32973,
    "book": "isaiah                                  ",
    "chapter": "47",
    "verse": "4",
    "text": "Vår återlösare Härskarornas Herre (Jahve Sebaot)"
  },
  {
    "id": 32974,
    "book": "isaiah                                  ",
    "chapter": "47",
    "verse": "5",
    "text": "Sitt tyst och gå in i mörkret,"
  },
  {
    "id": 32975,
    "book": "isaiah                                  ",
    "chapter": "47",
    "verse": "6",
    "text": "Jag var vred på mitt folk,"
  },
  {
    "id": 32976,
    "book": "isaiah                                  ",
    "chapter": "47",
    "verse": "7",
    "text": "Och du sade: ”För alltid"
  },
  {
    "id": 32977,
    "book": "isaiah                                  ",
    "chapter": "47",
    "verse": "8",
    "text": "Lyssna nu därför till detta, du som hänger dig åt njutningar,"
  },
  {
    "id": 32978,
    "book": "isaiah                                  ",
    "chapter": "47",
    "verse": "9",
    "text": "Men dessa två ting ska en dag komma över dig på ett ögonblick,"
  },
  {
    "id": 32979,
    "book": "isaiah                                  ",
    "chapter": "47",
    "verse": "10",
    "text": "Du har känt dig säker i din ondska,"
  },
  {
    "id": 32980,
    "book": "isaiah                                  ",
    "chapter": "47",
    "verse": "11",
    "text": "Men ondska ska komma över dig,"
  },
  {
    "id": 32981,
    "book": "isaiah                                  ",
    "chapter": "47",
    "verse": "12",
    "text": "Träd fram (stå) nu med din magi"
  },
  {
    "id": 32982,
    "book": "isaiah                                  ",
    "chapter": "47",
    "verse": "13",
    "text": "Du är utmattad av mängden av dina råd,"
  },
  {
    "id": 32983,
    "book": "isaiah                                  ",
    "chapter": "47",
    "verse": "14",
    "text": "Se, de ska bli som stubb (det som finns kvar efter att ett gräsfält brunnit),"
  },
  {
    "id": 32984,
    "book": "isaiah                                  ",
    "chapter": "47",
    "verse": "15",
    "text": "Så skall det gå dem som du arbetat med,"
  }
]