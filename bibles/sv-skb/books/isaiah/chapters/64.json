[
  {
    "id": 33255,
    "book": "isaiah                                  ",
    "chapter": "64",
    "verse": "1",
    "text": "Åh, att du ville riva isär himlarna, att du ville komma ner,"
  },
  {
    "id": 33256,
    "book": "isaiah                                  ",
    "chapter": "64",
    "verse": "2",
    "text": "Som när eld antänder snåret"
  },
  {
    "id": 33257,
    "book": "isaiah                                  ",
    "chapter": "64",
    "verse": "3",
    "text": "När du gör fantastiska ting, som vi inte ens sökt (tittat efter),"
  },
  {
    "id": 33258,
    "book": "isaiah                                  ",
    "chapter": "64",
    "verse": "4",
    "text": "Från evighet har ingen hört,"
  },
  {
    "id": 33259,
    "book": "isaiah                                  ",
    "chapter": "64",
    "verse": "5",
    "text": "Du mötte honom som gladdes i att utöva rättfärdighet på sina vägar,"
  },
  {
    "id": 33260,
    "book": "isaiah                                  ",
    "chapter": "64",
    "verse": "6",
    "text": "Vi är alla orena (nedsmutsade) människor,"
  },
  {
    "id": 33261,
    "book": "isaiah                                  ",
    "chapter": "64",
    "verse": "7",
    "text": "Ingen åkallar (ropar, ber i) ditt namn,"
  },
  {
    "id": 33262,
    "book": "isaiah                                  ",
    "chapter": "64",
    "verse": "8",
    "text": "Och ändå, Herre (Jahve), [trots vår synd, se vers 6-7] är du [ju] vår Fader."
  },
  {
    "id": 33263,
    "book": "isaiah                                  ",
    "chapter": "64",
    "verse": "9",
    "text": "Var inte gränslöst arg Herre,"
  },
  {
    "id": 33264,
    "book": "isaiah                                  ",
    "chapter": "64",
    "verse": "10",
    "text": "Din heliga stad har blivit en vildmark,"
  },
  {
    "id": 33265,
    "book": "isaiah                                  ",
    "chapter": "64",
    "verse": "11",
    "text": "Vårt heliga och vårt underbara hus [tempel], där våra fäder prisade dig,"
  },
  {
    "id": 33266,
    "book": "isaiah                                  ",
    "chapter": "64",
    "verse": "12",
    "text": "Ska du avstå dig själv (svika dina egna principer) för dessa ting Herre (Jahve)?"
  }
]