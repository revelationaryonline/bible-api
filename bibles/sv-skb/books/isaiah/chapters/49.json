[
  {
    "id": 33007,
    "book": "isaiah                                  ",
    "chapter": "49",
    "verse": "1",
    "text": "Hör på mig, ni kustländer,"
  },
  {
    "id": 33008,
    "book": "isaiah                                  ",
    "chapter": "49",
    "verse": "2",
    "text": "Han gjorde min mun likt ett skarpt svärd,"
  },
  {
    "id": 33009,
    "book": "isaiah                                  ",
    "chapter": "49",
    "verse": "3",
    "text": "Och han sade till mig: ”Du är min tjänare, Israel [idealbilden av Israel; hebr. jisrael – Gud triumferar],"
  },
  {
    "id": 33010,
    "book": "isaiah                                  ",
    "chapter": "49",
    "verse": "4",
    "text": "Men jag svarade: ”Jag har ansträngt mig (arbetat) förgäves,"
  },
  {
    "id": 33011,
    "book": "isaiah                                  ",
    "chapter": "49",
    "verse": "5",
    "text": "Nu säger Herren (Jahve), han som har skapat mig till sin tjänare redan i moderlivet,"
  },
  {
    "id": 33012,
    "book": "isaiah                                  ",
    "chapter": "49",
    "verse": "6",
    "text": "Han [Herren talar nu profetiskt om sin tjänare Messias och] säger:"
  },
  {
    "id": 33013,
    "book": "isaiah                                  ",
    "chapter": "49",
    "verse": "7",
    "text": "Detta säger Herren (Jahve),"
  },
  {
    "id": 33014,
    "book": "isaiah                                  ",
    "chapter": "49",
    "verse": "8",
    "text": "Detta är vad Herren säger [Gud Faderns ord till sonen Messias]:"
  },
  {
    "id": 33015,
    "book": "isaiah                                  ",
    "chapter": "49",
    "verse": "9",
    "text": "Ni ska säga till de fångna: ’Kom ut,’"
  },
  {
    "id": 33016,
    "book": "isaiah                                  ",
    "chapter": "49",
    "verse": "10",
    "text": "De ska varken hungra eller törsta,"
  },
  {
    "id": 33017,
    "book": "isaiah                                  ",
    "chapter": "49",
    "verse": "11",
    "text": "Jag ska göra alla mina berg till en väg (hebr. derech)"
  },
  {
    "id": 33018,
    "book": "isaiah                                  ",
    "chapter": "49",
    "verse": "12",
    "text": "Se, dessa ska komma från långt bort"
  },
  {
    "id": 33019,
    "book": "isaiah                                  ",
    "chapter": "49",
    "verse": "13",
    "text": "Stäm upp till glädjesång, ni himlar!"
  },
  {
    "id": 33020,
    "book": "isaiah                                  ",
    "chapter": "49",
    "verse": "14",
    "text": "Men Sion [Jerusalem, och dess invånare som blivit tillfångatagna och förda till Babylon] säger:"
  },
  {
    "id": 33021,
    "book": "isaiah                                  ",
    "chapter": "49",
    "verse": "15",
    "text": "[Herren svarade:]"
  },
  {
    "id": 33022,
    "book": "isaiah                                  ",
    "chapter": "49",
    "verse": "16",
    "text": "Se på mina händer, jag har graverat dig på mina handflator."
  },
  {
    "id": 33023,
    "book": "isaiah                                  ",
    "chapter": "49",
    "verse": "17",
    "text": "Dina söner ska skynda sig, dina fördärvare"
  },
  {
    "id": 33024,
    "book": "isaiah                                  ",
    "chapter": "49",
    "verse": "18",
    "text": "Lyft upp dina ögon och se runt omkring,"
  },
  {
    "id": 33025,
    "book": "isaiah                                  ",
    "chapter": "49",
    "verse": "19",
    "text": "För dina fördärvade och ödelagda platser"
  },
  {
    "id": 33026,
    "book": "isaiah                                  ",
    "chapter": "49",
    "verse": "20",
    "text": "Sönerna från din smärtsamma förlust"
  },
  {
    "id": 33027,
    "book": "isaiah                                  ",
    "chapter": "49",
    "verse": "21",
    "text": "Då ska du säga (tänka) i ditt hjärta:"
  },
  {
    "id": 33028,
    "book": "isaiah                                  ",
    "chapter": "49",
    "verse": "22",
    "text": "Så säger Herren Gud (Adonaj Jahve):"
  },
  {
    "id": 33029,
    "book": "isaiah                                  ",
    "chapter": "49",
    "verse": "23",
    "text": "Och kungar ska vara deras uppfostrare"
  },
  {
    "id": 33030,
    "book": "isaiah                                  ",
    "chapter": "49",
    "verse": "24",
    "text": "Ska bytet tas från den mäktige"
  },
  {
    "id": 33031,
    "book": "isaiah                                  ",
    "chapter": "49",
    "verse": "25",
    "text": "Men så säger Herren (Jahve):"
  },
  {
    "id": 33032,
    "book": "isaiah                                  ",
    "chapter": "49",
    "verse": "26",
    "text": "Och jag ska mata dem som förtryckte dig med deras eget kött,"
  }
]