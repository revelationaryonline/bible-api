[
  {
    "id": 33093,
    "book": "isaiah                                  ",
    "chapter": "54",
    "verse": "1",
    "text": "Sjung du ofruktsamma"
  },
  {
    "id": 33094,
    "book": "isaiah                                  ",
    "chapter": "54",
    "verse": "2",
    "text": "Gör platsen stor,"
  },
  {
    "id": 33095,
    "book": "isaiah                                  ",
    "chapter": "54",
    "verse": "3",
    "text": "För åt både höger och vänster ska du utbreda dig (bryta in på ny mark)"
  },
  {
    "id": 33096,
    "book": "isaiah                                  ",
    "chapter": "54",
    "verse": "4",
    "text": "Frukta inte,"
  },
  {
    "id": 33097,
    "book": "isaiah                                  ",
    "chapter": "54",
    "verse": "5",
    "text": "För din skapare är din man,"
  },
  {
    "id": 33098,
    "book": "isaiah                                  ",
    "chapter": "54",
    "verse": "6",
    "text": "För som en kvinna med en övergiven och sörjande ande,"
  },
  {
    "id": 33099,
    "book": "isaiah                                  ",
    "chapter": "54",
    "verse": "7",
    "text": "Ett kort ögonblick övergav jag dig,"
  },
  {
    "id": 33100,
    "book": "isaiah                                  ",
    "chapter": "54",
    "verse": "8",
    "text": "För ett ögonblick dolde jag mitt ansikte för dig i häftig vrede,"
  },
  {
    "id": 33101,
    "book": "isaiah                                  ",
    "chapter": "54",
    "verse": "9",
    "text": "För mig är detta som Noas vatten (flod) [1 Mos 6-9 – denna tid kan liknas vid Noas dagar],"
  },
  {
    "id": 33102,
    "book": "isaiah                                  ",
    "chapter": "54",
    "verse": "10",
    "text": "För bergen ska rubbas (rämna, försvinna; vika bort; dra sig undan)"
  },
  {
    "id": 33103,
    "book": "isaiah                                  ",
    "chapter": "54",
    "verse": "11",
    "text": "Du drabbade [stad Jerusalem], kringkastad av stormar utan tröst."
  },
  {
    "id": 33104,
    "book": "isaiah                                  ",
    "chapter": "54",
    "verse": "12",
    "text": "Jag ska göra dina krön (tinnar, överdelar) av rubiner"
  },
  {
    "id": 33105,
    "book": "isaiah                                  ",
    "chapter": "54",
    "verse": "13",
    "text": "Alla dina söner (barn) ska undervisas av Herren (Jahve),"
  },
  {
    "id": 33106,
    "book": "isaiah                                  ",
    "chapter": "54",
    "verse": "14",
    "text": "I rättfärdighet ska du vara grundad (djupt rotad),"
  },
  {
    "id": 33107,
    "book": "isaiah                                  ",
    "chapter": "54",
    "verse": "15",
    "text": "Om man sammangaddar sig mot dig [om fiender smider onda planer, se Ps 2:2], är det inte från mig,"
  },
  {
    "id": 33108,
    "book": "isaiah                                  ",
    "chapter": "54",
    "verse": "16",
    "text": "Se, jag har skapat smeden som blåser på kolelden"
  },
  {
    "id": 33109,
    "book": "isaiah                                  ",
    "chapter": "54",
    "verse": "17",
    "text": "Inget vapen som smids [ingen anklagelsepunkt som tar form] mot dig"
  }
]