[
  {
    "id": 33110,
    "book": "isaiah                                  ",
    "chapter": "55",
    "verse": "1",
    "text": "Hör upp (hallå, ve)!"
  },
  {
    "id": 33111,
    "book": "isaiah                                  ",
    "chapter": "55",
    "verse": "2",
    "text": "Varför spenderar ni pengar på (väger ni upp silver för) det som inte är bröd (mat)"
  },
  {
    "id": 33112,
    "book": "isaiah                                  ",
    "chapter": "55",
    "verse": "3",
    "text": "Böj ditt öra (lyssna noga) och kom till mig,"
  },
  {
    "id": 33113,
    "book": "isaiah                                  ",
    "chapter": "55",
    "verse": "4",
    "text": "Se, honom [David, som en representant för Messias, eller Messias] har jag gjort"
  },
  {
    "id": 33114,
    "book": "isaiah                                  ",
    "chapter": "55",
    "verse": "5",
    "text": "Se, du [Israel] ska kalla på folkslag du inte känner,"
  },
  {
    "id": 33115,
    "book": "isaiah                                  ",
    "chapter": "55",
    "verse": "6",
    "text": "Sök [upp] (träd fram, närma er; fråga efter) Herren (Jahve) medan han låter sig finnas (medan det går att nå honom),"
  },
  {
    "id": 33116,
    "book": "isaiah                                  ",
    "chapter": "55",
    "verse": "7",
    "text": "Den ogudaktige måste överge sin väg [lämna sin gamla livsstil]"
  },
  {
    "id": 33117,
    "book": "isaiah                                  ",
    "chapter": "55",
    "verse": "8",
    "text": "För mina tankar (planer, syften) är inte era tankar,"
  },
  {
    "id": 33118,
    "book": "isaiah                                  ",
    "chapter": "55",
    "verse": "9",
    "text": "För [precis] som himlarna är (svävar) högre än jorden,"
  },
  {
    "id": 33119,
    "book": "isaiah                                  ",
    "chapter": "55",
    "verse": "10",
    "text": "För liksom regnet och snön"
  },
  {
    "id": 33120,
    "book": "isaiah                                  ",
    "chapter": "55",
    "verse": "11",
    "text": "så ska det vara med mitt ord som går ut från min mun:"
  },
  {
    "id": 33121,
    "book": "isaiah                                  ",
    "chapter": "55",
    "verse": "12",
    "text": "För ni ska gå ut med fröjd"
  },
  {
    "id": 33122,
    "book": "isaiah                                  ",
    "chapter": "55",
    "verse": "13",
    "text": "Istället för törne ska cypresser växa upp"
  }
