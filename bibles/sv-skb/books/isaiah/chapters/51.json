[
  {
    "id": 33044,
    "book": "isaiah                                  ",
    "chapter": "51",
    "verse": "1",
    "text": "Lyssna på mig,"
  },
  {
    "id": 33045,
    "book": "isaiah                                  ",
    "chapter": "51",
    "verse": "2",
    "text": "Se på Abraham, er far,"
  },
  {
    "id": 33046,
    "book": "isaiah                                  ",
    "chapter": "51",
    "verse": "3",
    "text": "Ja, Herren ska trösta Sion [tempelberget i Jerusalem],"
  },
  {
    "id": 33047,
    "book": "isaiah                                  ",
    "chapter": "51",
    "verse": "4",
    "text": "Var uppmärksam på mig, mitt folk,"
  },
  {
    "id": 33048,
    "book": "isaiah                                  ",
    "chapter": "51",
    "verse": "5",
    "text": "Min rättfärdighet är nära,"
  },
  {
    "id": 33049,
    "book": "isaiah                                  ",
    "chapter": "51",
    "verse": "6",
    "text": "Lyft upp era ögon till himlarna!"
  },
  {
    "id": 33050,
    "book": "isaiah                                  ",
    "chapter": "51",
    "verse": "7",
    "text": "Lyssna till mig, ni som känner till (är intimt förtrogna med) rättfärdighet,"
  },
  {
    "id": 33051,
    "book": "isaiah                                  ",
    "chapter": "51",
    "verse": "8",
    "text": "För mal ska äta dem som en klädnad"
  },
  {
    "id": 33052,
    "book": "isaiah                                  ",
    "chapter": "51",
    "verse": "9",
    "text": "[Frasen ”Vakna upp” här i vers 9 återkommer i vers 17 och i Jes 52:1. Det betonar och ramar in.]"
  },
  {
    "id": 33053,
    "book": "isaiah                                  ",
    "chapter": "51",
    "verse": "10",
    "text": "Är du inte den som torkade upp havet,"
  },
  {
    "id": 33054,
    "book": "isaiah                                  ",
    "chapter": "51",
    "verse": "11",
    "text": "Herrens förlossade ska återvända"
  },
  {
    "id": 33055,
    "book": "isaiah                                  ",
    "chapter": "51",
    "verse": "12",
    "text": "Jag, ja jag är han som tröstar er."
  },
  {
    "id": 33056,
    "book": "isaiah                                  ",
    "chapter": "51",
    "verse": "13",
    "text": "Och har glömt Herren (Jahve) din skapare,"
  },
  {
    "id": 33057,
    "book": "isaiah                                  ",
    "chapter": "51",
    "verse": "14",
    "text": "Han som har blivit nedböjd ska med hast bli fri,"
  },
  {
    "id": 33058,
    "book": "isaiah                                  ",
    "chapter": "51",
    "verse": "15",
    "text": "För jag är Herren (Jahve) din Gud (Elohim),"
  },
  {
    "id": 33059,
    "book": "isaiah                                  ",
    "chapter": "51",
    "verse": "16",
    "text": "Jag har lagt mitt ord i din mun"
  },
  {
    "id": 33060,
    "book": "isaiah                                  ",
    "chapter": "51",
    "verse": "17",
    "text": "Vakna upp! Vakna upp!"
  },
  {
    "id": 33061,
    "book": "isaiah                                  ",
    "chapter": "51",
    "verse": "18",
    "text": "Det finns ingen som leder (guidar) henne av alla söner som hon fött,"
  },
  {
    "id": 33062,
    "book": "isaiah                                  ",
    "chapter": "51",
    "verse": "19",
    "text": "Dessa två ting drabbade dig,"
  },
  {
    "id": 33063,
    "book": "isaiah                                  ",
    "chapter": "51",
    "verse": "20",
    "text": "Dina söner är avsvimmade,"
  },
  {
    "id": 33064,
    "book": "isaiah                                  ",
    "chapter": "51",
    "verse": "21",
    "text": "Därför, lyssna nu till detta, du drabbade"
  },
  {
    "id": 33065,
    "book": "isaiah                                  ",
    "chapter": "51",
    "verse": "22",
    "text": "Så säger Herren din Herre (Adonaj Jahve)"
  },
  {
    "id": 33066,
    "book": "isaiah                                  ",
    "chapter": "51",
    "verse": "23",
    "text": "Jag ska sätta dem i din hand som plågat dig,"
  }
]