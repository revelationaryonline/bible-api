[
  {
    "id": 32081,
    "book": "isaiah                                  ",
    "chapter": "3",
    "verse": "1",
    "text": "Se, Herren Härskarornas Herre (Adonaj Jahve Sebaot)"
  },
  {
    "id": 32082,
    "book": "isaiah                                  ",
    "chapter": "3",
    "verse": "2",
    "text": "mäktiga män och stridsmän,"
  },
  {
    "id": 32083,
    "book": "isaiah                                  ",
    "chapter": "3",
    "verse": "3",
    "text": "ledaren över femtio, och män av rang,"
  },
  {
    "id": 32084,
    "book": "isaiah                                  ",
    "chapter": "3",
    "verse": "4",
    "text": "Och jag ger barn att bli deras prinsar"
  },
  {
    "id": 32085,
    "book": "isaiah                                  ",
    "chapter": "3",
    "verse": "5",
    "text": "Och folket ska förtrycka varandra,"
  },
  {
    "id": 32086,
    "book": "isaiah                                  ",
    "chapter": "3",
    "verse": "6",
    "text": "En man ska ta tag i sin bror i sin fars hus:"
  },
  {
    "id": 32087,
    "book": "isaiah                                  ",
    "chapter": "3",
    "verse": "7",
    "text": "På den dagen ska han svära och säga:"
  },
  {
    "id": 32088,
    "book": "isaiah                                  ",
    "chapter": "3",
    "verse": "8",
    "text": "För Jerusalem är i ruiner"
  },
  {
    "id": 32089,
    "book": "isaiah                                  ",
    "chapter": "3",
    "verse": "9",
    "text": "Deras ansiktsuttryck vittnar emot dem,"
  },
  {
    "id": 32090,
    "book": "isaiah                                  ",
    "chapter": "3",
    "verse": "10",
    "text": "Säg till (berätta för) den rättfärdige, att det är väl (det kommer gå bra),"
  },
  {
    "id": 32091,
    "book": "isaiah                                  ",
    "chapter": "3",
    "verse": "11",
    "text": "Ve till den onde, det ska gå illa för honom,"
  },
  {
    "id": 32092,
    "book": "isaiah                                  ",
    "chapter": "3",
    "verse": "12",
    "text": "Angående mitt folk är ett spädbarn deras mästare"
  },
  {
    "id": 32093,
    "book": "isaiah                                  ",
    "chapter": "3",
    "verse": "13",
    "text": "Herren (Jahve) står upp för att genmäla"
  },
  {
    "id": 32094,
    "book": "isaiah                                  ",
    "chapter": "3",
    "verse": "14",
    "text": "Herren (Jahve) vill gå till doms"
  },
  {
    "id": 32095,
    "book": "isaiah                                  ",
    "chapter": "3",
    "verse": "15",
    "text": "Vad menar ni med att krossa mitt folk"
  },
  {
    "id": 32096,
    "book": "isaiah                                  ",
    "chapter": "3",
    "verse": "16",
    "text": "Dessutom säger Herren (Jahve):"
  },
  {
    "id": 32097,
    "book": "isaiah                                  ",
    "chapter": "3",
    "verse": "17",
    "text": "därför ska Herren (Adonaj) slå av kronan från dottern Sions huvud,"
  },
  {
    "id": 32098,
    "book": "isaiah                                  ",
    "chapter": "3",
    "verse": "18",
    "text": "På den dagen ska Herren (Adonaj) ta bort deras anklars tapperhet och hårbanden och halsbanden,"
  },
  {
    "id": 32099,
    "book": "isaiah                                  ",
    "chapter": "3",
    "verse": "19",
    "text": "örhängena och armbanden och de långa slöjorna,"
  },
  {
    "id": 32100,
    "book": "isaiah                                  ",
    "chapter": "3",
    "verse": "20",
    "text": "tiarorna, och fotkedjorna och skärpen, och brynjorna, och amuletterna,"
  },
  {
    "id": 32101,
    "book": "isaiah                                  ",
    "chapter": "3",
    "verse": "21",
    "text": "ringarna och smyckena i näsan,"
  },
  {
    "id": 32102,
    "book": "isaiah                                  ",
    "chapter": "3",
    "verse": "22",
    "text": "förklädena, och mantlarna, och slängkapporna och gördlarna,"
  },
  {
    "id": 32103,
    "book": "isaiah                                  ",
    "chapter": "3",
    "verse": "23",
    "text": "och de skira dräkterna, och det fina linnet, och turbanerna, och floren (korta slöjor)."
  },
  {
    "id": 32104,
    "book": "isaiah                                  ",
    "chapter": "3",
    "verse": "24",
    "text": "Och det ska ske att istället för sötsaker (färsk mat) ska det vara förruttnelse,"
  },
  {
    "id": 32105,
    "book": "isaiah                                  ",
    "chapter": "3",
    "verse": "25",
    "text": "Dina män ska falla för svärdet"
  },
  {
    "id": 32106,
    "book": "isaiah                                  ",
    "chapter": "3",
    "verse": "26",
    "text": "Och hennes portar ska klaga och sörja"
  }
]