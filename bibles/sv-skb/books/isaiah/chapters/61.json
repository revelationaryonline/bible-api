[
  {
    "id": 33213,
    "book": "isaiah                                  ",
    "chapter": "61",
    "verse": "1",
    "text": "Herrarnas Herres (Adonaj Jahves) Ande är över mig,"
  },
  {
    "id": 33214,
    "book": "isaiah                                  ",
    "chapter": "61",
    "verse": "2",
    "text": "proklamera ett nådens (villkorad nåd – hebr. ratson) år från Herren (Jahve),"
  },
  {
    "id": 33215,
    "book": "isaiah                                  ",
    "chapter": "61",
    "verse": "3",
    "text": "stärka de som sörjer i Sion,"
  },
  {
    "id": 33216,
    "book": "isaiah                                  ",
    "chapter": "61",
    "verse": "4",
    "text": "De ska bygga upp de gamla ödetrakterna,"
  },
  {
    "id": 33217,
    "book": "isaiah                                  ",
    "chapter": "61",
    "verse": "5",
    "text": "Främlingar ska stå och mata dina hjordar"
  },
  {
    "id": 33218,
    "book": "isaiah                                  ",
    "chapter": "61",
    "verse": "6",
    "text": "Ni ska kallas Herrens (Jahves) präster"
  },
  {
    "id": 33219,
    "book": "isaiah                                  ",
    "chapter": "61",
    "verse": "7",
    "text": "Istället för din skam – en dubbel del [av ära, arvslott, se Sak 9:12],"
  },
  {
    "id": 33220,
    "book": "isaiah                                  ",
    "chapter": "61",
    "verse": "8",
    "text": "För jag Herren älskar rättfärdighet."
  },
  {
    "id": 33221,
    "book": "isaiah                                  ",
    "chapter": "61",
    "verse": "9",
    "text": "Deras säd (avkomma, barn) ska bli kända bland nationerna"
  },
  {
    "id": 33222,
    "book": "isaiah                                  ",
    "chapter": "61",
    "verse": "10",
    "text": "Herren uppfyller mig med stor glädje,"
  },
  {
    "id": 33223,
    "book": "isaiah                                  ",
    "chapter": "61",
    "verse": "11",
    "text": "För på samma sätt som plantor skjuter upp ur marken,"
  }
