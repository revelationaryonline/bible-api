[
  {
    "id": 32504,
    "book": "isaiah                                  ",
    "chapter": "26",
    "verse": "1",
    "text": "På den dagen ska denna sång sjungas i Juda land:"
  },
  {
    "id": 32505,
    "book": "isaiah                                  ",
    "chapter": "26",
    "verse": "2",
    "text": "Öppna portarna [Ps 24:7, 9; 118:19; Upp 21:22-27; 22:14],"
  },
  {
    "id": 32506,
    "book": "isaiah                                  ",
    "chapter": "26",
    "verse": "3",
    "text": "Den som är fast i sitt sinne [stödjer sig på Gud och låter sina tankar formas av honom]"
  },
  {
    "id": 32507,
    "book": "isaiah                                  ",
    "chapter": "26",
    "verse": "4",
    "text": "Förtrösta på (lita på; var trygg/frimodig i) Herren (Jahve) för evigt (för alltid) [ta din tillflykt till honom],"
  },
  {
    "id": 32508,
    "book": "isaiah                                  ",
    "chapter": "26",
    "verse": "5",
    "text": "Han har brutit ned (ödmjukat) de som bor i det höga [de har tvingat att böja sig],"
  },
  {
    "id": 32509,
    "book": "isaiah                                  ",
    "chapter": "26",
    "verse": "6",
    "text": "Foten ska trampa ned den,"
  },
  {
    "id": 32510,
    "book": "isaiah                                  ",
    "chapter": "26",
    "verse": "7",
    "text": "Den upptrampade vägen till rättfärdighet är rak,"
  },
  {
    "id": 32511,
    "book": "isaiah                                  ",
    "chapter": "26",
    "verse": "8",
    "text": "Även på stigen för dina påbud (bindande juridiska beslut) Herre (Jahve) har vi väntat på dig,"
  },
  {
    "id": 32512,
    "book": "isaiah                                  ",
    "chapter": "26",
    "verse": "9",
    "text": "Jag, hela min varelse (själ – hebr. nefesh) har längtat efter dig under natten [Ps 63:7; Höga V 3:1],"
  },
  {
    "id": 32513,
    "book": "isaiah                                  ",
    "chapter": "26",
    "verse": "10",
    "text": "Låt nåd (oförtjänt kärlek – hebr. chanan) visas den onde,"
  },
  {
    "id": 32514,
    "book": "isaiah                                  ",
    "chapter": "26",
    "verse": "11",
    "text": "Herre (Jahve) din hand är upplyft [redo att handla]"
  },
  {
    "id": 32515,
    "book": "isaiah                                  ",
    "chapter": "26",
    "verse": "12",
    "text": "Herre (Jahve) du ska påbjuda (stadfästa) frid (shalom) för oss,"
  },
  {
    "id": 32516,
    "book": "isaiah                                  ",
    "chapter": "26",
    "verse": "13",
    "text": "Herre (Jahve) vår Gud (Elohim),"
  },
  {
    "id": 32517,
    "book": "isaiah                                  ",
    "chapter": "26",
    "verse": "14",
    "text": "De döda lever inte,"
  },
  {
    "id": 32518,
    "book": "isaiah                                  ",
    "chapter": "26",
    "verse": "15",
    "text": "Du har samlat åt dig från folkslagen Herre (Jahve),"
  },
  {
    "id": 32519,
    "book": "isaiah                                  ",
    "chapter": "26",
    "verse": "16",
    "text": "Herre (Jahve) i trångmål har de sökt dig,"
  },
  {
    "id": 32520,
    "book": "isaiah                                  ",
    "chapter": "26",
    "verse": "17",
    "text": "Som en gravid kvinna som närmar sig tiden för sin förlossning"
  },
  {
    "id": 32521,
    "book": "isaiah                                  ",
    "chapter": "26",
    "verse": "18",
    "text": "Vi har varit gravida, vi har varit i smärta,"
  },
  {
    "id": 32522,
    "book": "isaiah                                  ",
    "chapter": "26",
    "verse": "19",
    "text": "Dina döda ska leva,"
  },
  {
    "id": 32523,
    "book": "isaiah                                  ",
    "chapter": "26",
    "verse": "20",
    "text": "Kom mitt folk, gå in i dina kamrar"
  },
  {
    "id": 32524,
    "book": "isaiah                                  ",
    "chapter": "26",
    "verse": "21",
    "text": "För se, Herren (Jahve) kommer fram från sin plats (boning)"
  }
]