[
  {
    "id": 32932,
    "book": "isaiah                                  ",
    "chapter": "45",
    "verse": "1",
    "text": "Så säger Herren (Jahve) till sin smorde,"
  },
  {
    "id": 32933,
    "book": "isaiah                                  ",
    "chapter": "45",
    "verse": "2",
    "text": "”Jag ska gå framför dig"
  },
  {
    "id": 32934,
    "book": "isaiah                                  ",
    "chapter": "45",
    "verse": "3",
    "text": "och jag ska ge dig mörkrets skatter [gömda i rum utan fönster som fanns i bl.a. Babylon och Sardis],"
  },
  {
    "id": 32935,
    "book": "isaiah                                  ",
    "chapter": "45",
    "verse": "4",
    "text": "För Jakobs skull, min tjänare,"
  },
  {
    "id": 32936,
    "book": "isaiah                                  ",
    "chapter": "45",
    "verse": "5",
    "text": "Jag är Herren (Jahve), det finns ingen annan."
  },
  {
    "id": 32937,
    "book": "isaiah                                  ",
    "chapter": "45",
    "verse": "6",
    "text": "för att man ska veta att från solens uppgång (i öster)"
  },
  {
    "id": 32938,
    "book": "isaiah                                  ",
    "chapter": "45",
    "verse": "7",
    "text": "Jag formar (som en krukmakare) ljuset"
  },
  {
    "id": 32939,
    "book": "isaiah                                  ",
    "chapter": "45",
    "verse": "8",
    "text": "Regna där ovan, du himmel"
  },
  {
    "id": 32940,
    "book": "isaiah                                  ",
    "chapter": "45",
    "verse": "9",
    "text": "Ve över honom som går till rätta (befinner sig på en trång plats) med sin skapare,"
  },
  {
    "id": 32941,
    "book": "isaiah                                  ",
    "chapter": "45",
    "verse": "10",
    "text": "Ve, över honom som säger till sin far: ”Varför avlade du”?"
  },
  {
    "id": 32942,
    "book": "isaiah                                  ",
    "chapter": "45",
    "verse": "11",
    "text": "Så säger Herren (Jahve) Israels Helige och hans Skapare:"
  },
  {
    "id": 32943,
    "book": "isaiah                                  ",
    "chapter": "45",
    "verse": "12",
    "text": "Jag har gjort jorden"
  },
  {
    "id": 32944,
    "book": "isaiah                                  ",
    "chapter": "45",
    "verse": "13",
    "text": "Jag har rest upp honom i rättfärdighet"
  },
  {
    "id": 32945,
    "book": "isaiah                                  ",
    "chapter": "45",
    "verse": "14",
    "text": "Så säger Herren (Jahve):"
  },
  {
    "id": 32946,
    "book": "isaiah                                  ",
    "chapter": "45",
    "verse": "15",
    "text": "I sanning är du en Gud (El) som gömmer dig själv,"
  },
  {
    "id": 32947,
    "book": "isaiah                                  ",
    "chapter": "45",
    "verse": "16",
    "text": "De ska komma på skam, ja, bli förvirrade varenda en av dem,"
  },
  {
    "id": 32948,
    "book": "isaiah                                  ",
    "chapter": "45",
    "verse": "17",
    "text": "Israel, som är frälst (räddad) av Herren (Jahve) med en evig frälsning,"
  },
  {
    "id": 32949,
    "book": "isaiah                                  ",
    "chapter": "45",
    "verse": "18",
    "text": "För så säger Herren (Jahve)"
  },
  {
    "id": 32950,
    "book": "isaiah                                  ",
    "chapter": "45",
    "verse": "19",
    "text": "Jag har inte talat i hemlighet,"
  },
  {
    "id": 32951,
    "book": "isaiah                                  ",
    "chapter": "45",
    "verse": "20",
    "text": "Samla ihop er själva och kom,"
  },
  {
    "id": 32952,
    "book": "isaiah                                  ",
    "chapter": "45",
    "verse": "21",
    "text": "Förkunna och för dem nära,"
  },
  {
    "id": 32953,
    "book": "isaiah                                  ",
    "chapter": "45",
    "verse": "22",
    "text": "[Herren talar vidare, se vers 14:]"
  },
  {
    "id": 32954,
    "book": "isaiah                                  ",
    "chapter": "45",
    "verse": "23",
    "text": "Jag har svurit vid mig själv,"
  },
  {
    "id": 32955,
    "book": "isaiah                                  ",
    "chapter": "45",
    "verse": "24",
    "text": "De ska säga om mig:"
  },
  {
    "id": 32956,
    "book": "isaiah                                  ",
    "chapter": "45",
    "verse": "25",
    "text": "I Herren ska hela Israels säd bli rättfärdiggjord och förhärligas."
  }
]