[
  {
    "id": 32028,
    "book": "isaiah                                  ",
    "chapter": "1",
    "verse": "1",
    "text": "Synen av Jesaja, son till Amots, som han såg angående Juda och Jerusalem (i de tider, under de dagar) då"
  },
  {
    "id": 32029,
    "book": "isaiah                                  ",
    "chapter": "1",
    "verse": "2",
    "text": "Lyssna himlar"
  },
  {
    "id": 32030,
    "book": "isaiah                                  ",
    "chapter": "1",
    "verse": "3",
    "text": "Oxen känner sin ägare"
  },
  {
    "id": 32031,
    "book": "isaiah                                  ",
    "chapter": "1",
    "verse": "4",
    "text": "Ve, ett syndfullt land,"
  },
  {
    "id": 32032,
    "book": "isaiah                                  ",
    "chapter": "1",
    "verse": "5",
    "text": "Var ska du slås igen"
  },
  {
    "id": 32033,
    "book": "isaiah                                  ",
    "chapter": "1",
    "verse": "6",
    "text": "Från foten till huvudet"
  },
  {
    "id": 32034,
    "book": "isaiah                                  ",
    "chapter": "1",
    "verse": "7",
    "text": "Ditt land är öde,"
  },
  {
    "id": 32035,
    "book": "isaiah                                  ",
    "chapter": "1",
    "verse": "8",
    "text": "Dottern Sion [Jerusalem] är lämnad som en hydda i en vingård,"
  },
  {
    "id": 32036,
    "book": "isaiah                                  ",
    "chapter": "1",
    "verse": "9",
    "text": "Om inte Härskarornas Herre (Jahve Sebaot) hade lämnat en liten kvarleva,"
  },
  {
    "id": 32037,
    "book": "isaiah                                  ",
    "chapter": "1",
    "verse": "10",
    "text": "Hör (lyd) Herrens ord,"
  },
  {
    "id": 32038,
    "book": "isaiah                                  ",
    "chapter": "1",
    "verse": "11",
    "text": "”Vad är syftet med alla era många offer [om de inte kommer från hjärtat]?” säger Herren (Jahve)."
  },
  {
    "id": 32039,
    "book": "isaiah                                  ",
    "chapter": "1",
    "verse": "12",
    "text": "När ni kommer inför mitt ansikte,"
  },
  {
    "id": 32040,
    "book": "isaiah                                  ",
    "chapter": "1",
    "verse": "13",
    "text": "För inte fram några fler tomma (falska) offer,"
  },
  {
    "id": 32041,
    "book": "isaiah                                  ",
    "chapter": "1",
    "verse": "14",
    "text": "Era nymånader och era [skenheliga] högtider"
  },
  {
    "id": 32042,
    "book": "isaiah                                  ",
    "chapter": "1",
    "verse": "15",
    "text": "När ni sträcker era händer [i bön om hjälp],"
  },
  {
    "id": 32043,
    "book": "isaiah                                  ",
    "chapter": "1",
    "verse": "16",
    "text": "tvätta er, gör er rena."
  },
  {
    "id": 32044,
    "book": "isaiah                                  ",
    "chapter": "1",
    "verse": "17",
    "text": "lär er i stället att göra det som är gott (behagligt, rätt)."
  },
  {
    "id": 32045,
    "book": "isaiah                                  ",
    "chapter": "1",
    "verse": "18",
    "text": "Kom nu och låt oss tala med varandra,"
  },
  {
    "id": 32046,
    "book": "isaiah                                  ",
    "chapter": "1",
    "verse": "19",
    "text": "Om ni är villiga och lyder (min undervisning),"
  },
  {
    "id": 32047,
    "book": "isaiah                                  ",
    "chapter": "1",
    "verse": "20",
    "text": "Men om ni vägrar och är upproriska,"
  },
  {
    "id": 32048,
    "book": "isaiah                                  ",
    "chapter": "1",
    "verse": "21",
    "text": "Hur har inte den trofasta staden blivit en sköka!"
  },
  {
    "id": 32049,
    "book": "isaiah                                  ",
    "chapter": "1",
    "verse": "22",
    "text": "Ditt silver har blivit slagg,"
  },
  {
    "id": 32050,
    "book": "isaiah                                  ",
    "chapter": "1",
    "verse": "23",
    "text": "Dina furstar är upproriska"
  },
  {
    "id": 32051,
    "book": "isaiah                                  ",
    "chapter": "1",
    "verse": "24",
    "text": "Därför förkunnar (säger, proklamerar) Herren Härskarornas Herre (Adonaj Jahve Sebaot),"
  },
  {
    "id": 32052,
    "book": "isaiah                                  ",
    "chapter": "1",
    "verse": "25",
    "text": "Sedan ska jag vända min hand mot dig,"
  },
  {
    "id": 32053,
    "book": "isaiah                                  ",
    "chapter": "1",
    "verse": "26",
    "text": "Jag ska upprätta dina domare,"
  },
  {
    "id": 32054,
    "book": "isaiah                                  ",
    "chapter": "1",
    "verse": "27",
    "text": "Sion [tempelberget i Jerusalem] ska återlösas med rätt"
  },
  {
    "id": 32055,
    "book": "isaiah                                  ",
    "chapter": "1",
    "verse": "28",
    "text": "Men där ska vara ett fördärv av överträdare och syndare tillsammans,"
  },
  {
    "id": 32056,
    "book": "isaiah                                  ",
    "chapter": "1",
    "verse": "29",
    "text": "De ska skämmas över de heliga ekarna som ni önskade,"
  },
  {
    "id": 32057,
    "book": "isaiah                                  ",
    "chapter": "1",
    "verse": "30",
    "text": "Du ska bli lik en ek med vissnande löv,"
  },
  {
    "id": 32058,
    "book": "isaiah                                  ",
    "chapter": "1",
    "verse": "31",
    "text": "Den starke ska bli som fnöske"
  }
]