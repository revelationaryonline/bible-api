[
  {
    "id": 32876,
    "book": "isaiah                                  ",
    "chapter": "43",
    "verse": "1",
    "text": "Nu säger Herren (Jahve),"
  },
  {
    "id": 32877,
    "book": "isaiah                                  ",
    "chapter": "43",
    "verse": "2",
    "text": "När du korsar (går) genom (ordagrant: igenom i) vattnen är jag med dig,"
  },
  {
    "id": 32878,
    "book": "isaiah                                  ",
    "chapter": "43",
    "verse": "3",
    "text": "För jag är Herren, din Gud,"
  },
  {
    "id": 32879,
    "book": "isaiah                                  ",
    "chapter": "43",
    "verse": "4",
    "text": "Eftersom du är dyrbar i mina ögon,"
  },
  {
    "id": 32880,
    "book": "isaiah                                  ",
    "chapter": "43",
    "verse": "5",
    "text": "Frukta inte (var inte rädd) för jag är med dig,"
  },
  {
    "id": 32881,
    "book": "isaiah                                  ",
    "chapter": "43",
    "verse": "6",
    "text": "Jag ska säga till norr: ”Ge hit!”"
  },
  {
    "id": 32882,
    "book": "isaiah                                  ",
    "chapter": "43",
    "verse": "7",
    "text": "var och en som är uppkallad efter mitt namn"
  },
  {
    "id": 32883,
    "book": "isaiah                                  ",
    "chapter": "43",
    "verse": "8",
    "text": "De blinda som har ögon ska föras fram,"
  },
  {
    "id": 32884,
    "book": "isaiah                                  ",
    "chapter": "43",
    "verse": "9",
    "text": "Alla länder samlas tillsammans"
  },
  {
    "id": 32885,
    "book": "isaiah                                  ",
    "chapter": "43",
    "verse": "10",
    "text": "”Ni är mina vittnen”, förkunnar (säger, proklamerar) Herren (Jahve),"
  },
  {
    "id": 32886,
    "book": "isaiah                                  ",
    "chapter": "43",
    "verse": "11",
    "text": "Jag, jag är Herren (Jahve),"
  },
  {
    "id": 32887,
    "book": "isaiah                                  ",
    "chapter": "43",
    "verse": "12",
    "text": "Jag har förutsagt [framtiden], räddat (befriat) er, och visat mig för er [att jag var er Gud, ni har hört och sett mig]."
  },
  {
    "id": 32888,
    "book": "isaiah                                  ",
    "chapter": "43",
    "verse": "13",
    "text": "Ja, redan innan ens dagen fanns [innan ljuset skapades, dvs. från tidernas begynnelse],"
  },
  {
    "id": 32889,
    "book": "isaiah                                  ",
    "chapter": "43",
    "verse": "14",
    "text": "Så säger Herren (Jahve),"
  },
  {
    "id": 32890,
    "book": "isaiah                                  ",
    "chapter": "43",
    "verse": "15",
    "text": "Jag är Herren (Jahve), er Helige."
  },
  {
    "id": 32891,
    "book": "isaiah                                  ",
    "chapter": "43",
    "verse": "16",
    "text": "Så säger Herren (Jahve)"
  },
  {
    "id": 32892,
    "book": "isaiah                                  ",
    "chapter": "43",
    "verse": "17",
    "text": "som ledde ut vagnar och hästar,"
  },
  {
    "id": 32893,
    "book": "isaiah                                  ",
    "chapter": "43",
    "verse": "18",
    "text": "Tänk inte på det som har varit [påminn er inte om dessa tidigare händelser]"
  },
  {
    "id": 32894,
    "book": "isaiah                                  ",
    "chapter": "43",
    "verse": "19",
    "text": "Se, jag gör [håller på att göra] något nytt [Upp 21:5]!"
  },
  {
    "id": 32895,
    "book": "isaiah                                  ",
    "chapter": "43",
    "verse": "20",
    "text": "Markens djur ska ära mig,"
  },
  {
    "id": 32896,
    "book": "isaiah                                  ",
    "chapter": "43",
    "verse": "21",
    "text": "Det folk som jag har skapat (format, designat) åt mig,"
  },
  {
    "id": 32897,
    "book": "isaiah                                  ",
    "chapter": "43",
    "verse": "22",
    "text": "Likväl har du inte åkallat mig, du Jakob,"
  },
  {
    "id": 32898,
    "book": "isaiah                                  ",
    "chapter": "43",
    "verse": "23",
    "text": "Du har inte burit fram brännofferfår till mig,"
  },
  {
    "id": 32899,
    "book": "isaiah                                  ",
    "chapter": "43",
    "verse": "24",
    "text": "Du har inte köpt någon söt krydda åt mig,"
  },
  {
    "id": 32900,
    "book": "isaiah                                  ",
    "chapter": "43",
    "verse": "25",
    "text": "Jag, ja jag, är den som utplånar dina överträdelser för min egen skull,"
  },
  {
    "id": 32901,
    "book": "isaiah                                  ",
    "chapter": "43",
    "verse": "26",
    "text": "Lägg mig på minnet (påminn mig), låt oss resonera (diskutera) tillsammans,"
  },
  {
    "id": 32902,
    "book": "isaiah                                  ",
    "chapter": "43",
    "verse": "27",
    "text": "Din första far syndade [kan syfta på Jakob, se 1 Mos 27:34-36; Jes 58:14]"
  },
  {
    "id": 32903,
    "book": "isaiah                                  ",
    "chapter": "43",
    "verse": "28",
    "text": "Därför har jag ohelgat furstarna i helgedomen"
  }
]