[
  {
    "id": 32792,
    "book": "isaiah                                  ",
    "chapter": "40",
    "verse": "2",
    "text": "”Tala mjukt till hjärtat av Jerusalem,"
  },
  {
    "id": 32793,
    "book": "isaiah                                  ",
    "chapter": "40",
    "verse": "3",
    "text": "En röst ropar:"
  },
  {
    "id": 32794,
    "book": "isaiah                                  ",
    "chapter": "40",
    "verse": "4",
    "text": "Varje dal (ravin) ska höjas"
  },
  {
    "id": 32795,
    "book": "isaiah                                  ",
    "chapter": "40",
    "verse": "5",
    "text": "Ja, Herrens (Jahves) härlighet (ära, tyngd, dignitet, prakt) [fullständigt mättade närvaro] ska uppenbaras,"
  },
  {
    "id": 32796,
    "book": "isaiah                                  ",
    "chapter": "40",
    "verse": "6",
    "text": "En röst säger: ”Ropa (proklamera, predika)”,"
  },
  {
    "id": 32797,
    "book": "isaiah                                  ",
    "chapter": "40",
    "verse": "7",
    "text": "Gräset torkar bort, blomman vissnar,"
  },
  {
    "id": 32798,
    "book": "isaiah                                  ",
    "chapter": "40",
    "verse": "8",
    "text": "Gräset torkar bort, blomman vissnar,"
  },
  {
    "id": 32799,
    "book": "isaiah                                  ",
    "chapter": "40",
    "verse": "9",
    "text": "Gå upp på ett högt berg, du Sion"
  },
  {
    "id": 32800,
    "book": "isaiah                                  ",
    "chapter": "40",
    "verse": "10",
    "text": "Se, Herren (Adonaj, fokus på Guds storhet och makt),"
  },
  {
    "id": 32801,
    "book": "isaiah                                  ",
    "chapter": "40",
    "verse": "11",
    "text": "Han föder sin fårhjord som en herde:"
  },
  {
    "id": 32802,
    "book": "isaiah                                  ",
    "chapter": "40",
    "verse": "12",
    "text": "Vem har mätt upp (hebr. madad) vattnet i hans kupade hand"
  },
  {
    "id": 32803,
    "book": "isaiah                                  ",
    "chapter": "40",
    "verse": "13",
    "text": "Vem har mätt ut Herrens (Jahve) Ande"
  },
  {
    "id": 32804,
    "book": "isaiah                                  ",
    "chapter": "40",
    "verse": "14",
    "text": "Av vem tog han råd, och vem instruerade honom"
  },
  {
    "id": 32805,
    "book": "isaiah                                  ",
    "chapter": "40",
    "verse": "15",
    "text": "Se, länderna är som en droppe i en hink"
  },
  {
    "id": 32806,
    "book": "isaiah                                  ",
    "chapter": "40",
    "verse": "16",
    "text": "Libanon är inte tillräckligt bränsle (dess skogar är oduglig ved),"
  },
  {
    "id": 32807,
    "book": "isaiah                                  ",
    "chapter": "40",
    "verse": "17",
    "text": "Alla länder är intet inför honom,"
  },
  {
    "id": 32808,
    "book": "isaiah                                  ",
    "chapter": "40",
    "verse": "18",
    "text": "Med vem vill ni då likna Gud (El)?"
  },
  {
    "id": 32809,
    "book": "isaiah                                  ",
    "chapter": "40",
    "verse": "19",
    "text": "Avbilden [en liten avgud, ofta 10-25 cm hög] – som hantverkaren har gjutit"
  },
  {
    "id": 32810,
    "book": "isaiah                                  ",
    "chapter": "40",
    "verse": "20",
    "text": "En stenek är avskild,"
  },
  {
    "id": 32811,
    "book": "isaiah                                  ",
    "chapter": "40",
    "verse": "21",
    "text": "Vet du inte?"
  },
  {
    "id": 32812,
    "book": "isaiah                                  ",
    "chapter": "40",
    "verse": "22",
    "text": "[Bibeln lär ut vetenskapliga fakta som att jorden är rund, långt innan detta var accepterat inom vetenskapen.]"
  },
  {
    "id": 32813,
    "book": "isaiah                                  ",
    "chapter": "40",
    "verse": "23",
    "text": "Som gör furstar till intet,"
  },
  {
    "id": 32814,
    "book": "isaiah                                  ",
    "chapter": "40",
    "verse": "24",
    "text": "Otillräckligt har de planterat,"
  },
  {
    "id": 32815,
    "book": "isaiah                                  ",
    "chapter": "40",
    "verse": "25",
    "text": "”Vem kan ni jämföra mig med,"
  },
  {
    "id": 32816,
    "book": "isaiah                                  ",
    "chapter": "40",
    "verse": "26",
    "text": "Lyft upp era ögon mot höjden [himlen]:"
  },
  {
    "id": 32817,
    "book": "isaiah                                  ",
    "chapter": "40",
    "verse": "27",
    "text": "Hur kan du säga, du Jakob,"
  },
  {
    "id": 32818,
    "book": "isaiah                                  ",
    "chapter": "40",
    "verse": "28",
    "text": "Vet du inte (är du inte väl införstådd med)?"
  },
  {
    "id": 32819,
    "book": "isaiah                                  ",
    "chapter": "40",
    "verse": "29",
    "text": "Han [blir inte trött, se vers 28, istället är det han som] ger den trötte (fysiskt utmattade; utslitne) kraft"
  },
  {
    "id": 32820,
    "book": "isaiah                                  ",
    "chapter": "40",
    "verse": "30",
    "text": "Även unga pojkar kan bli trötta och behöva vila,"
  },
  {
    "id": 32821,
    "book": "isaiah                                  ",
    "chapter": "40",
    "verse": "31",
    "text": "Men de som [uthålligt] väntar (hoppas) på Herren (Jahve)"
  }
]