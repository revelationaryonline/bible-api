[
  {
    "id": 32851,
    "book": "isaiah                                  ",
    "chapter": "42",
    "verse": "1",
    "text": "Här är min tjänare (trogne representant) som jag uppehåller (ger kraft, stöder),"
  },
  {
    "id": 32852,
    "book": "isaiah                                  ",
    "chapter": "42",
    "verse": "2",
    "text": "Han ska inte ropa eller höja sin röst (han är tyst trots stor smärta),"
  },
  {
    "id": 32853,
    "book": "isaiah                                  ",
    "chapter": "42",
    "verse": "3",
    "text": "Ett strå som har vikt sig (ligger nerböjt) bryter han inte av,"
  },
  {
    "id": 32854,
    "book": "isaiah                                  ",
    "chapter": "42",
    "verse": "4",
    "text": "Han ska inte släckas eller brytas ner,"
  },
  {
    "id": 32855,
    "book": "isaiah                                  ",
    "chapter": "42",
    "verse": "5",
    "text": "Så säger den ende Guden (El), Herren (Jahve),"
  },
  {
    "id": 32856,
    "book": "isaiah                                  ",
    "chapter": "42",
    "verse": "6",
    "text": "[Herren talar nu till Messias:]"
  },
  {
    "id": 32857,
    "book": "isaiah                                  ",
    "chapter": "42",
    "verse": "7",
    "text": "Du ska öppna de blindas ögon"
  },
  {
    "id": 32858,
    "book": "isaiah                                  ",
    "chapter": "42",
    "verse": "8",
    "text": "[Herren vänder sig nu till folket:]"
  },
  {
    "id": 32859,
    "book": "isaiah                                  ",
    "chapter": "42",
    "verse": "9",
    "text": "Det som har sagts tidigare har skett [profetiska ord har slagit in],"
  },
  {
    "id": 32860,
    "book": "isaiah                                  ",
    "chapter": "42",
    "verse": "10",
    "text": "Sjung till Herren (Jahve) – en ny sång [Jes 2:2; 26:1; Upp 5:9; 14:3],"
  },
  {
    "id": 32861,
    "book": "isaiah                                  ",
    "chapter": "42",
    "verse": "11",
    "text": "Låt öknen och dess städer lyfta upp sina röster,"
  },
  {
    "id": 32862,
    "book": "isaiah                                  ",
    "chapter": "42",
    "verse": "12",
    "text": "Låt dem ge ära (härlighet, tyngd – hebr. kavod) till Herren (Jahve)"
  },
  {
    "id": 32863,
    "book": "isaiah                                  ",
    "chapter": "42",
    "verse": "13",
    "text": "Herren (Jahve) ska dra fram som en mäktig man (hjälte),"
  },
  {
    "id": 32864,
    "book": "isaiah                                  ",
    "chapter": "42",
    "verse": "14",
    "text": "Under lång tid har jag varit tyst,"
  },
  {
    "id": 32865,
    "book": "isaiah                                  ",
    "chapter": "42",
    "verse": "15",
    "text": "Jag ska omintetgöra bergen och kullarna"
  },
  {
    "id": 32866,
    "book": "isaiah                                  ",
    "chapter": "42",
    "verse": "16",
    "text": "Och jag ska föra de blinda på en väg som de inte känner,"
  },
  {
    "id": 32867,
    "book": "isaiah                                  ",
    "chapter": "42",
    "verse": "17",
    "text": "De ska omvända sig (bli vända tillbaka),"
  },
  {
    "id": 32868,
    "book": "isaiah                                  ",
    "chapter": "42",
    "verse": "18",
    "text": "[Detta är den centrala delen i kapitel 40-48. En uppmaning till omvändelse.]"
  },
  {
    "id": 32869,
    "book": "isaiah                                  ",
    "chapter": "42",
    "verse": "19",
    "text": "Vem är blind, om inte min tjänare?"
  },
  {
    "id": 32870,
    "book": "isaiah                                  ",
    "chapter": "42",
    "verse": "20",
    "text": "Ser mycket [alla bevis på Guds godhet, se 4 Mos 4:32-38; 29:2-4; Ps 78; 105],"
  },
  {
    "id": 32871,
    "book": "isaiah                                  ",
    "chapter": "42",
    "verse": "21",
    "text": "Herren (Jahve) var tillfreds (nöjd),"
  },
  {
    "id": 32872,
    "book": "isaiah                                  ",
    "chapter": "42",
    "verse": "22",
    "text": "Men detta är ett rövat och plundrat folk,"
  },
  {
    "id": 32873,
    "book": "isaiah                                  ",
    "chapter": "42",
    "verse": "23",
    "text": "Vem ibland er vill ge sitt öra (lyssna) till detta?"
  },
  {
    "id": 32874,
    "book": "isaiah                                  ",
    "chapter": "42",
    "verse": "24",
    "text": "Vem gav Jakob som rov och Israel till plundring?"
  },
  {
    "id": 32875,
    "book": "isaiah                                  ",
    "chapter": "42",
    "verse": "25",
    "text": "Därför har han öst ut (hällt) ilskan från sin vrede över honom,"
  }
]