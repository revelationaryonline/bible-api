[
  {
    "id": 32280,
    "book": "isaiah                                  ",
    "chapter": "13",
    "verse": "1",
    "text": "Budskap (profetord, denna börda) över Babylon, som uppenbarades för Jesaja, Amots son."
  },
  {
    "id": 32281,
    "book": "isaiah                                  ",
    "chapter": "13",
    "verse": "2",
    "text": "Res upp ett tecken (flagga, signal) på det trädlösa (bara) berget [ge en signal till strid],"
  },
  {
    "id": 32282,
    "book": "isaiah                                  ",
    "chapter": "13",
    "verse": "3",
    "text": "Jag har befallt mina helgade (avskilda),"
  },
  {
    "id": 32283,
    "book": "isaiah                                  ",
    "chapter": "13",
    "verse": "4",
    "text": "Lyssna! Muller på bergen som av ett stort folk!"
  },
  {
    "id": 32284,
    "book": "isaiah                                  ",
    "chapter": "13",
    "verse": "5",
    "text": "De kommer från fjärran länder,"
  },
  {
    "id": 32285,
    "book": "isaiah                                  ",
    "chapter": "13",
    "verse": "6",
    "text": "Yla (vråla, ropa), för Herrens (Jahves) dag är nära (på plats) [för att döma Babylon, se Jes 2:12; Upp 6:17],"
  },
  {
    "id": 32286,
    "book": "isaiah                                  ",
    "chapter": "13",
    "verse": "7",
    "text": "Därför ska alla händer bli kraftlösa"
  },
  {
    "id": 32287,
    "book": "isaiah                                  ",
    "chapter": "13",
    "verse": "8",
    "text": "De ska bli förskräckta (livrädda),"
  },
  {
    "id": 32288,
    "book": "isaiah                                  ",
    "chapter": "13",
    "verse": "9",
    "text": "Se, Herrens (Jahves) dag kommer,"
  },
  {
    "id": 32289,
    "book": "isaiah                                  ",
    "chapter": "13",
    "verse": "10",
    "text": "För himlarnas stjärnor och deras konstellationer [galaxer]"
  },
  {
    "id": 32290,
    "book": "isaiah                                  ",
    "chapter": "13",
    "verse": "11",
    "text": "Och jag ska besöka världen för dess ondska"
  },
  {
    "id": 32291,
    "book": "isaiah                                  ",
    "chapter": "13",
    "verse": "12",
    "text": "Jag ska göra en man sällsyntare än fint guld,"
  },
  {
    "id": 32292,
    "book": "isaiah                                  ",
    "chapter": "13",
    "verse": "13",
    "text": "Därför ska jag låta himlarna darra"
  },
  {
    "id": 32293,
    "book": "isaiah                                  ",
    "chapter": "13",
    "verse": "14",
    "text": "Och det ska ske att som den jagade gasellen,"
  },
  {
    "id": 32294,
    "book": "isaiah                                  ",
    "chapter": "13",
    "verse": "15",
    "text": "Alla som hittas ska bli genomborrade,"
  },
  {
    "id": 32295,
    "book": "isaiah                                  ",
    "chapter": "13",
    "verse": "16",
    "text": "Deras spädbarn ska krossas i bitar inför deras ögon,"
  },
  {
    "id": 32296,
    "book": "isaiah                                  ",
    "chapter": "13",
    "verse": "17",
    "text": "Se, jag ska uppegga mederna mot dem,"
  },
  {
    "id": 32297,
    "book": "isaiah                                  ",
    "chapter": "13",
    "verse": "18",
    "text": "Deras bågar ska slå de unga männen i bitar,"
  },
  {
    "id": 32298,
    "book": "isaiah                                  ",
    "chapter": "13",
    "verse": "19",
    "text": "Och Babel, kungarikenas ära,"
  },
  {
    "id": 32299,
    "book": "isaiah                                  ",
    "chapter": "13",
    "verse": "20",
    "text": "Det ska aldrig bebos,"
  },
  {
    "id": 32300,
    "book": "isaiah                                  ",
    "chapter": "13",
    "verse": "21",
    "text": "Men vilda djur (hebr. tsi; ökendjur, kanske vildkatter) ska ligga där,"
  },
  {
    "id": 32301,
    "book": "isaiah                                  ",
    "chapter": "13",
    "verse": "22",
    "text": "Och schakaler (vargar) ska yla (ropa) i deras fästningar,"
  }
]