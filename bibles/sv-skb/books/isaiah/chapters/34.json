[
  {
    "id": 32677,
    "book": "isaiah                                  ",
    "chapter": "34",
    "verse": "1",
    "text": "Kom nära, ni länder, för att lyssna"
  },
  {
    "id": 32678,
    "book": "isaiah                                  ",
    "chapter": "34",
    "verse": "2",
    "text": "För Herren (Jahve) är vred (som en kvist som bryts; relationen är bruten – hebr. qetsef) över alla länder,"
  },
  {
    "id": 32679,
    "book": "isaiah                                  ",
    "chapter": "34",
    "verse": "3",
    "text": "Deras slagna (slaktade) ska kastas ut"
  },
  {
    "id": 32680,
    "book": "isaiah                                  ",
    "chapter": "34",
    "verse": "4",
    "text": "Och alla himlarnas härskaror ska förmultna,"
  },
  {
    "id": 32681,
    "book": "isaiah                                  ",
    "chapter": "34",
    "verse": "5",
    "text": "För mitt svärd har druckit sig mätt i himlarna,"
  },
  {
    "id": 32682,
    "book": "isaiah                                  ",
    "chapter": "34",
    "verse": "6",
    "text": "Herrens (Jahves) svärd är fyllt med blod,"
  },
  {
    "id": 32683,
    "book": "isaiah                                  ",
    "chapter": "34",
    "verse": "7",
    "text": "Och vildoxen ska komma ner med dem"
  },
  {
    "id": 32684,
    "book": "isaiah                                  ",
    "chapter": "34",
    "verse": "8",
    "text": "För Herren (Jahve) har en hämndens dag,"
  },
  {
    "id": 32685,
    "book": "isaiah                                  ",
    "chapter": "34",
    "verse": "9",
    "text": "Och dess strömmar ska vändas till beck (tjock, svart trögflytande vätska),"
  },
  {
    "id": 32686,
    "book": "isaiah                                  ",
    "chapter": "34",
    "verse": "10",
    "text": "Varken natt eller dag ska den kvävas,"
  },
  {
    "id": 32687,
    "book": "isaiah                                  ",
    "chapter": "34",
    "verse": "11",
    "text": "Men pelikanen och rördrommen ska besitta det,"
  },
  {
    "id": 32688,
    "book": "isaiah                                  ",
    "chapter": "34",
    "verse": "12",
    "text": "För hennes ädlingar ska ingen där kallas till kungariket,"
  },
  {
    "id": 32689,
    "book": "isaiah                                  ",
    "chapter": "34",
    "verse": "13",
    "text": "Törne ska växa upp i hennes palats,"
  },
  {
    "id": 32690,
    "book": "isaiah                                  ",
    "chapter": "34",
    "verse": "14",
    "text": "Och vildkatterna ska umgås med schakalerna,"
  },
  {
    "id": 32691,
    "book": "isaiah                                  ",
    "chapter": "34",
    "verse": "15",
    "text": "Där ska pilormen (hebr. qipoz; maskulin form) bygga hennes bo"
  },
  {
    "id": 32692,
    "book": "isaiah                                  ",
    "chapter": "34",
    "verse": "16",
    "text": "Utforska Herrens (Jahves) bokrulle och läs:"
  },
  {
    "id": 32693,
    "book": "isaiah                                  ",
    "chapter": "34",
    "verse": "17",
    "text": "Och han har kastat lott för dem,"
  }
]