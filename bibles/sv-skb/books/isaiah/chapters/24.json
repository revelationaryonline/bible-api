[
  {
    "id": 32469,
    "book": "isaiah                                  ",
    "chapter": "24",
    "verse": "1",
    "text": "Se (hebr. hinneh – syftar på en framtida händelse),"
  },
  {
    "id": 32470,
    "book": "isaiah                                  ",
    "chapter": "24",
    "verse": "2",
    "text": "Och det ska ske,"
  },
  {
    "id": 32471,
    "book": "isaiah                                  ",
    "chapter": "24",
    "verse": "3",
    "text": "Tom ska jorden tömmas (jorden ska bli helt tom),"
  },
  {
    "id": 32472,
    "book": "isaiah                                  ",
    "chapter": "24",
    "verse": "4",
    "text": "Jorden svimmar och tynar bort,"
  },
  {
    "id": 32473,
    "book": "isaiah                                  ",
    "chapter": "24",
    "verse": "5",
    "text": "Jorden är orenad av sina invånare,"
  },
  {
    "id": 32474,
    "book": "isaiah                                  ",
    "chapter": "24",
    "verse": "6",
    "text": "Därför har en förbannelse slukat jorden,"
  },
  {
    "id": 32475,
    "book": "isaiah                                  ",
    "chapter": "24",
    "verse": "7",
    "text": "Det nya vinet slår fel, vinstocken torkar,"
  },
  {
    "id": 32476,
    "book": "isaiah                                  ",
    "chapter": "24",
    "verse": "8",
    "text": "Munterheten från tamburinerna vilar (får en sabbatsro – hebr. shavat),"
  },
  {
    "id": 32477,
    "book": "isaiah                                  ",
    "chapter": "24",
    "verse": "9",
    "text": "De dricker inte vin med en sång,"
  },
  {
    "id": 32478,
    "book": "isaiah                                  ",
    "chapter": "24",
    "verse": "10",
    "text": "Nedbruten är tomhetens ort (samlingsplatsen har blivit öde),"
  },
  {
    "id": 32479,
    "book": "isaiah                                  ",
    "chapter": "24",
    "verse": "11",
    "text": "Det är ett rop på gatorna mitt i vinet,"
  },
  {
    "id": 32480,
    "book": "isaiah                                  ",
    "chapter": "24",
    "verse": "12",
    "text": "I staden är ödsligheten kvar,"
  },
  {
    "id": 32481,
    "book": "isaiah                                  ",
    "chapter": "24",
    "verse": "13",
    "text": "För så ska det vara mitt på jorden"
  },
  {
    "id": 32482,
    "book": "isaiah                                  ",
    "chapter": "24",
    "verse": "14",
    "text": "Mumlarna (de som mumlar) lyfter upp sina röster, de sjunger,"
  },
  {
    "id": 32483,
    "book": "isaiah                                  ",
    "chapter": "24",
    "verse": "15",
    "text": "Ära därför Herren (Jahve) i ljusen (länderna i öster), på öarna i havet [i väster],"
  },
  {
    "id": 32484,
    "book": "isaiah                                  ",
    "chapter": "24",
    "verse": "16",
    "text": "Från jordens yttersta gräns hör vi sånger: ”Ära till den rättfärdige”."
  },
  {
    "id": 32485,
    "book": "isaiah                                  ",
    "chapter": "24",
    "verse": "17",
    "text": "Terror, avgrundsdjup och fällor är över (drabbar) er"
  },
  {
    "id": 32486,
    "book": "isaiah                                  ",
    "chapter": "24",
    "verse": "18",
    "text": "Och det ska ske att den som flyr från ljudet av terror"
  },
  {
    "id": 32487,
    "book": "isaiah                                  ",
    "chapter": "24",
    "verse": "19",
    "text": "Jorden är sönderbruten,"
  },
  {
    "id": 32488,
    "book": "isaiah                                  ",
    "chapter": "24",
    "verse": "20",
    "text": "Jorden rullar fram och tillbaka som en drucken"
  },
  {
    "id": 32489,
    "book": "isaiah                                  ",
    "chapter": "24",
    "verse": "21",
    "text": "Och det ska ske den dagen att Herren (Jahve) ska straffa"
  },
  {
    "id": 32490,
    "book": "isaiah                                  ",
    "chapter": "24",
    "verse": "22",
    "text": "Och de ska samlas tillsammans"
  },
  {
    "id": 32491,
    "book": "isaiah                                  ",
    "chapter": "24",
    "verse": "23",
    "text": "Sedan ska månen blygas och solen skämmas,"
  }
]