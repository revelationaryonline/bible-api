[
  {
    "id": 32653,
    "book": "isaiah                                  ",
    "chapter": "33",
    "verse": "1",
    "text": "Ve dig, som tillspilloger [de fientliga nationerna, se vers 3-4]"
  },
  {
    "id": 32654,
    "book": "isaiah                                  ",
    "chapter": "33",
    "verse": "2",
    "text": "Herre var nådig (visa oförtjänt kärlek – hebr. chanan) mot oss,"
  },
  {
    "id": 32655,
    "book": "isaiah                                  ",
    "chapter": "33",
    "verse": "3",
    "text": "Vid ljudet av stridslarm flyr folket,"
  },
  {
    "id": 32656,
    "book": "isaiah                                  ",
    "chapter": "33",
    "verse": "4",
    "text": "Det du tillspillogivit samlas in som larver samlas,"
  },
  {
    "id": 32657,
    "book": "isaiah                                  ",
    "chapter": "33",
    "verse": "5",
    "text": "Herren (Jahve) är upphöjd, för han bor i höjden,"
  },
  {
    "id": 32658,
    "book": "isaiah                                  ",
    "chapter": "33",
    "verse": "6",
    "text": "Stabiliteten (sanningen) för dina tider (avgörande tillfällen som helt förändrar situationen) ska vara"
  },
  {
    "id": 32659,
    "book": "isaiah                                  ",
    "chapter": "33",
    "verse": "7",
    "text": "Se, deras tappra ropar därute [gatorna; de öppna ytorna],"
  },
  {
    "id": 32660,
    "book": "isaiah                                  ",
    "chapter": "33",
    "verse": "8",
    "text": "Huvudvägarna ligger öde,"
  },
  {
    "id": 32661,
    "book": "isaiah                                  ",
    "chapter": "33",
    "verse": "9",
    "text": "Landet sörjer och försmäktar,"
  },
  {
    "id": 32662,
    "book": "isaiah                                  ",
    "chapter": "33",
    "verse": "10",
    "text": "Nu ska jag resa mig, säger Herren (Jahve),"
  },
  {
    "id": 32663,
    "book": "isaiah                                  ",
    "chapter": "33",
    "verse": "11",
    "text": "Ni föder agnar,"
  },
  {
    "id": 32664,
    "book": "isaiah                                  ",
    "chapter": "33",
    "verse": "12",
    "text": "Folket ska vara som brinnande kalk,"
  },
  {
    "id": 32665,
    "book": "isaiah                                  ",
    "chapter": "33",
    "verse": "13",
    "text": "Lyssna!"
  },
  {
    "id": 32666,
    "book": "isaiah                                  ",
    "chapter": "33",
    "verse": "14",
    "text": "Syndarna i Sion är rädda,"
  },
  {
    "id": 32667,
    "book": "isaiah                                  ",
    "chapter": "33",
    "verse": "15",
    "text": "Den [däremot] som vandrar (lever) rättfärdigt [Ps 15; 24:4]"
  },
  {
    "id": 32668,
    "book": "isaiah                                  ",
    "chapter": "33",
    "verse": "16",
    "text": "han ska bo i höjden,"
  },
  {
    "id": 32669,
    "book": "isaiah                                  ",
    "chapter": "33",
    "verse": "17",
    "text": "Dina ögon ska se kungen i hans härlighet,"
  },
  {
    "id": 32670,
    "book": "isaiah                                  ",
    "chapter": "33",
    "verse": "18",
    "text": "Ditt hjärta ska tänka tillbaka på skräcken (det fruktansvärda ska vara ett minne blott) [du ska fråga dig själv:]"
  },
  {
    "id": 32671,
    "book": "isaiah                                  ",
    "chapter": "33",
    "verse": "19",
    "text": "Du ska inte se det våldsamma folket,"
  },
  {
    "id": 32672,
    "book": "isaiah                                  ",
    "chapter": "33",
    "verse": "20",
    "text": "Se, på Sion [tempelberget] staden för våra högtidliga samlingar,"
  },
  {
    "id": 32673,
    "book": "isaiah                                  ",
    "chapter": "33",
    "verse": "21",
    "text": "Där ska Herren (Jahve) vara med oss i majestät,"
  },
  {
    "id": 32674,
    "book": "isaiah                                  ",
    "chapter": "33",
    "verse": "22",
    "text": "Herren (Jahve) är vår domare,"
  },
  {
    "id": 32675,
    "book": "isaiah                                  ",
    "chapter": "33",
    "verse": "23",
    "text": "Dina rep (tåg, tackel) är lösa,"
  },
  {
    "id": 32676,
    "book": "isaiah                                  ",
    "chapter": "33",
    "verse": "24",
    "text": "Invånarna [i Sion] ska inte säga: ”Jag är sjuk (svag)”,"
  }
]