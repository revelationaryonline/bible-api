[
  {
    "id": 32904,
    "book": "isaiah                                  ",
    "chapter": "44",
    "verse": "1",
    "text": "Men lyssna nu [trots att du har syndat, se kap 43] du Jakob min tjänare,"
  },
  {
    "id": 32905,
    "book": "isaiah                                  ",
    "chapter": "44",
    "verse": "2",
    "text": "Så säger Herren (Jahve),"
  },
  {
    "id": 32906,
    "book": "isaiah                                  ",
    "chapter": "44",
    "verse": "3",
    "text": "[Som en varsam trädgårdsmästare som sköter om sin trädgård:]"
  },
  {
    "id": 32907,
    "book": "isaiah                                  ",
    "chapter": "44",
    "verse": "4",
    "text": "De ska växa upp mitt ibland det gröna gräset,"
  },
  {
    "id": 32908,
    "book": "isaiah                                  ",
    "chapter": "44",
    "verse": "5",
    "text": "Då ska en [av dessa återvändande judar] säga: ”Jag tillhör Herren”,"
  },
  {
    "id": 32909,
    "book": "isaiah                                  ",
    "chapter": "44",
    "verse": "6",
    "text": "Så säger Herren (Jahve), Israels Konung,"
  },
  {
    "id": 32910,
    "book": "isaiah                                  ",
    "chapter": "44",
    "verse": "7",
    "text": "Vem är som jag?"
  },
  {
    "id": 32911,
    "book": "isaiah                                  ",
    "chapter": "44",
    "verse": "8",
    "text": "Frukta inte och var inte förskräckta (var inte paralyserad av skräck)."
  },
  {
    "id": 32912,
    "book": "isaiah                                  ",
    "chapter": "44",
    "verse": "9",
    "text": "De som formar (hebr. jatsar) en skuren avbild är alla fåfänga,"
  },
  {
    "id": 32913,
    "book": "isaiah                                  ",
    "chapter": "44",
    "verse": "10",
    "text": "Vem har formgett en gud,"
  },
  {
    "id": 32914,
    "book": "isaiah                                  ",
    "chapter": "44",
    "verse": "11",
    "text": "Se, alla som följer dem ska skämmas,"
  },
  {
    "id": 32915,
    "book": "isaiah                                  ",
    "chapter": "44",
    "verse": "12",
    "text": "Smeden tar [använder, vässar] sitt verktyg (någon form av yxa – hebr. maatzad)"
  },
  {
    "id": 32916,
    "book": "isaiah                                  ",
    "chapter": "44",
    "verse": "13",
    "text": "Snickaren sträcker ut linan [mäter längden]"
  },
  {
    "id": 32917,
    "book": "isaiah                                  ",
    "chapter": "44",
    "verse": "14",
    "text": "Han hugger ner cedrar åt sig"
  },
  {
    "id": 32918,
    "book": "isaiah                                  ",
    "chapter": "44",
    "verse": "15",
    "text": "Sedan använder en människa det som bränsle"
  },
  {
    "id": 32919,
    "book": "isaiah                                  ",
    "chapter": "44",
    "verse": "16",
    "text": "Han bränner hälften av det i eld,"
  },
  {
    "id": 32920,
    "book": "isaiah                                  ",
    "chapter": "44",
    "verse": "17",
    "text": "Av det som blir över gör han en gud, ja en utskuren avgud."
  },
  {
    "id": 32921,
    "book": "isaiah                                  ",
    "chapter": "44",
    "verse": "18",
    "text": "De vet inte, inte heller förstår de,"
  },
  {
    "id": 32922,
    "book": "isaiah                                  ",
    "chapter": "44",
    "verse": "19",
    "text": "Och ingen betänker i sitt hjärta,"
  },
  {
    "id": 32923,
    "book": "isaiah                                  ",
    "chapter": "44",
    "verse": "20",
    "text": "Han strävar efter aska, ett bedraget hjärta har vänt honom till sidan,"
  },
  {
    "id": 32924,
    "book": "isaiah                                  ",
    "chapter": "44",
    "verse": "21",
    "text": "Kom ihåg dessa ting du Jakob"
  },
  {
    "id": 32925,
    "book": "isaiah                                  ",
    "chapter": "44",
    "verse": "22",
    "text": "Jag har utplånat, som ett tjockt moln, dina överträdelser,"
  },
  {
    "id": 32926,
    "book": "isaiah                                  ",
    "chapter": "44",
    "verse": "23",
    "text": "Sjung ni himlar, för Herren (Jahve) har gjort det,"
  },
  {
    "id": 32927,
    "book": "isaiah                                  ",
    "chapter": "44",
    "verse": "24",
    "text": "Så säger Herren (Jahve)"
  },
  {
    "id": 32928,
    "book": "isaiah                                  ",
    "chapter": "44",
    "verse": "25",
    "text": "Det frustrerar (stör, irriterar) bedragarnas teckentyderi"
  },
  {
    "id": 32929,
    "book": "isaiah                                  ",
    "chapter": "44",
    "verse": "26",
    "text": "Det bekräftar hans tjänares ord"
  },
  {
    "id": 32930,
    "book": "isaiah                                  ",
    "chapter": "44",
    "verse": "27",
    "text": "Som säger till djupen: ”Torka upp och jag ska torka upp dina floder.”"
  },
  {
    "id": 32931,
    "book": "isaiah                                  ",
    "chapter": "44",
    "verse": "28",
    "text": "Som säger om Kyros: ”Han är min herde och ska utföra alla mina önskningar”"
  }
]