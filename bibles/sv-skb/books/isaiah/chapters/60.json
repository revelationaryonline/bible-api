[
  {
    "id": 33191,
    "book": "isaiah                                  ",
    "chapter": "60",
    "verse": "1",
    "text": "Stå upp [från depression och apati som omständigheter har hållit dig i]!"
  },
  {
    "id": 33192,
    "book": "isaiah                                  ",
    "chapter": "60",
    "verse": "2",
    "text": "För se, mörkret ska täcka jorden,"
  },
  {
    "id": 33193,
    "book": "isaiah                                  ",
    "chapter": "60",
    "verse": "3",
    "text": "Och hednafolk ska komma (har vandrat) till ditt ljus,"
  },
  {
    "id": 33194,
    "book": "isaiah                                  ",
    "chapter": "60",
    "verse": "4",
    "text": "Lyft upp dina ögon (blicken) och se dig omkring!"
  },
  {
    "id": 33195,
    "book": "isaiah                                  ",
    "chapter": "60",
    "verse": "5",
    "text": "Då ska du se och stråla,"
  },
  {
    "id": 33196,
    "book": "isaiah                                  ",
    "chapter": "60",
    "verse": "6",
    "text": "Mängder av kameler ska övertäcka dig [vandra på dina vägar, Jerusalem],"
  },
  {
    "id": 33197,
    "book": "isaiah                                  ",
    "chapter": "60",
    "verse": "7",
    "text": "Alla Kedars fårhjordar [i den arabiska öknen, öster om Syrien] ska samlas till dig,"
  },
  {
    "id": 33198,
    "book": "isaiah                                  ",
    "chapter": "60",
    "verse": "8",
    "text": "Vilka är dessa som flyger som ett moln,"
  },
  {
    "id": 33199,
    "book": "isaiah                                  ",
    "chapter": "60",
    "verse": "9",
    "text": "Sannerligen, öarna ska vänta på mig"
  },
  {
    "id": 33200,
    "book": "isaiah                                  ",
    "chapter": "60",
    "verse": "10",
    "text": "[Detta stycke är den centrala delen i kiasmen i kapitel 60.]"
  },
  {
    "id": 33201,
    "book": "isaiah                                  ",
    "chapter": "60",
    "verse": "11",
    "text": "Dina portar ska oavbrutet vara öppna,"
  },
  {
    "id": 33202,
    "book": "isaiah                                  ",
    "chapter": "60",
    "verse": "12",
    "text": "Det land och det kungarike som inte vill tjäna dig ska förgås,"
  },
  {
    "id": 33203,
    "book": "isaiah                                  ",
    "chapter": "60",
    "verse": "13",
    "text": "Libanons härlighet (tyngd) ska komma till dig,"
  },
  {
    "id": 33204,
    "book": "isaiah                                  ",
    "chapter": "60",
    "verse": "14",
    "text": "[Vers 14-16 hör tematiskt ihop med vers 8-9]"
  },
  {
    "id": 33205,
    "book": "isaiah                                  ",
    "chapter": "60",
    "verse": "15",
    "text": "Eftersom du har varit övergiven och hatad"
  },
  {
    "id": 33206,
    "book": "isaiah                                  ",
    "chapter": "60",
    "verse": "16",
    "text": "Du ska dia nationernas mjölk,"
  },
  {
    "id": 33207,
    "book": "isaiah                                  ",
    "chapter": "60",
    "verse": "17",
    "text": "[Vers 17-18 hör tematiskt ihop med vers 4-7.]"
  },
  {
    "id": 33208,
    "book": "isaiah                                  ",
    "chapter": "60",
    "verse": "18",
    "text": "Man ska inte längre höra [ljudet av, höra talas om] våld (terror) i ditt land,"
  },
  {
    "id": 33209,
    "book": "isaiah                                  ",
    "chapter": "60",
    "verse": "19",
    "text": "[Vers 19-22 hör tematiskt ihop med vers 1-3.]"
  },
  {
    "id": 33210,
    "book": "isaiah                                  ",
    "chapter": "60",
    "verse": "20",
    "text": "Din sol ska aldrig gå ner,"
  },
  {
    "id": 33211,
    "book": "isaiah                                  ",
    "chapter": "60",
    "verse": "21",
    "text": "Då ska alla i ditt folk vara rättfärdiga,"
  },
  {
    "id": 33212,
    "book": "isaiah                                  ",
    "chapter": "60",
    "verse": "22",
    "text": "Av den minste ska det bli tusen [en egen stam],"
  }
]