[
  {
    "id": 32113,
    "book": "isaiah                                  ",
    "chapter": "5",
    "verse": "1",
    "text": "Låt mig sjunga till min vän (älskade),"
  },
  {
    "id": 32114,
    "book": "isaiah                                  ",
    "chapter": "5",
    "verse": "2",
    "text": "Han har grävt den"
  },
  {
    "id": 32115,
    "book": "isaiah                                  ",
    "chapter": "5",
    "verse": "3",
    "text": "Och nu ni Jerusalems invånare och Juda män,"
  },
  {
    "id": 32116,
    "book": "isaiah                                  ",
    "chapter": "5",
    "verse": "4",
    "text": "Vad mer hade kunnat göras för min vingård,"
  },
  {
    "id": 32117,
    "book": "isaiah                                  ",
    "chapter": "5",
    "verse": "5",
    "text": "Jag ska berätta för dig"
  },
  {
    "id": 32118,
    "book": "isaiah                                  ",
    "chapter": "5",
    "verse": "6",
    "text": "Och jag ska lägga den öde,"
  },
  {
    "id": 32119,
    "book": "isaiah                                  ",
    "chapter": "5",
    "verse": "7",
    "text": "För Härskarornas Herres (Jahve Sebaots) vingård"
  },
  {
    "id": 32120,
    "book": "isaiah                                  ",
    "chapter": "5",
    "verse": "8",
    "text": "[Det första av sex verop:]"
  },
  {
    "id": 32121,
    "book": "isaiah                                  ",
    "chapter": "5",
    "verse": "9",
    "text": "I mitt öra... [hör jag] Härskarornas Herre (Jahve Sebaot):"
  },
  {
    "id": 32122,
    "book": "isaiah                                  ",
    "chapter": "5",
    "verse": "10",
    "text": "För en vingård på tio plogland [ca 10 tunnland] ska ge en bat [ca 30 liter]"
  },
  {
    "id": 32123,
    "book": "isaiah                                  ",
    "chapter": "5",
    "verse": "11",
    "text": "[Det andra veropet:]"
  },
  {
    "id": 32124,
    "book": "isaiah                                  ",
    "chapter": "5",
    "verse": "12",
    "text": "Och Kinnor-harpa (kithara – hebr. kinnor) [mindre harpa] och Nevel-lyra (hebr. nevel), tamburin och flöjt"
  },
  {
    "id": 32125,
    "book": "isaiah                                  ",
    "chapter": "5",
    "verse": "13",
    "text": "Därför har mitt folk gått i fångenskap,"
  },
  {
    "id": 32126,
    "book": "isaiah                                  ",
    "chapter": "5",
    "verse": "14",
    "text": "Därför har Sheol (underjorden – de dödas plats) spärrat upp sin hals (ökat sin aptit)"
  },
  {
    "id": 32127,
    "book": "isaiah                                  ",
    "chapter": "5",
    "verse": "15",
    "text": "Och människan är nedböjd"
  },
  {
    "id": 32128,
    "book": "isaiah                                  ",
    "chapter": "5",
    "verse": "16",
    "text": "Men Härskarornas Herre (Jahve Sebaot) är upphöjd i rätt,"
  },
  {
    "id": 32129,
    "book": "isaiah                                  ",
    "chapter": "5",
    "verse": "17",
    "text": "Då ska lamm beta som om de var på sina betesmarker,"
  },
  {
    "id": 32130,
    "book": "isaiah                                  ",
    "chapter": "5",
    "verse": "18",
    "text": "[Det tredje veropet:]"
  },
  {
    "id": 32131,
    "book": "isaiah                                  ",
    "chapter": "5",
    "verse": "19",
    "text": "De säger: ”Låt honom skynda sig,"
  },
  {
    "id": 32132,
    "book": "isaiah                                  ",
    "chapter": "5",
    "verse": "20",
    "text": "[Det fjärde veropet:]"
  },
  {
    "id": 32133,
    "book": "isaiah                                  ",
    "chapter": "5",
    "verse": "21",
    "text": "[Det femte veropet:]"
  },
  {
    "id": 32134,
    "book": "isaiah                                  ",
    "chapter": "5",
    "verse": "22",
    "text": "[Det sjätte och sista veropet:]"
  },
  {
    "id": 32135,
    "book": "isaiah                                  ",
    "chapter": "5",
    "verse": "23",
    "text": "som rättfärdigar den onde för en muta"
  },
  {
    "id": 32136,
    "book": "isaiah                                  ",
    "chapter": "5",
    "verse": "24",
    "text": "Därför, som eldens tunga slukar stubben (det torra gräset)"
  },
  {
    "id": 32137,
    "book": "isaiah                                  ",
    "chapter": "5",
    "verse": "25",
    "text": "Därför är Herrens (Jahves) vrede upptänd mot hans folk"
  },
  {
    "id": 32138,
    "book": "isaiah                                  ",
    "chapter": "5",
    "verse": "26",
    "text": "Han ska lyfta upp ett baner för folken i fjärran,"
  },
  {
    "id": 32139,
    "book": "isaiah                                  ",
    "chapter": "5",
    "verse": "27",
    "text": "Ingen av dem ska bli trött, inte snubbla bland dem,"
  },
  {
    "id": 32140,
    "book": "isaiah                                  ",
    "chapter": "5",
    "verse": "28",
    "text": "(på dem) vars pilar är skarpa"
  },
  {
    "id": 32141,
    "book": "isaiah                                  ",
    "chapter": "5",
    "verse": "29",
    "text": "Deras rytande ska vara som ett lejons,"
  },
  {
    "id": 32142,
    "book": "isaiah                                  ",
    "chapter": "5",
    "verse": "30",
    "text": "Och de ska ryta mot dem på den dagen"
  }
]