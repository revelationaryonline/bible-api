[
  {
    "id": 32822,
    "book": "isaiah                                  ",
    "chapter": "41",
    "verse": "1",
    "text": "Var tysta (lämna ifred, var som döva, säg inte ett ord, håll tand för tunga) nära (intill, med) mig, ni öar (kustländer)"
  },
  {
    "id": 32823,
    "book": "isaiah                                  ",
    "chapter": "41",
    "verse": "2",
    "text": "Vem har rest upp någon från soluppgången,"
  },
  {
    "id": 32824,
    "book": "isaiah                                  ",
    "chapter": "41",
    "verse": "3",
    "text": "Han jagar dem och går vidare (korsar över) i frid (trygghet, säkerhet – shalom)."
  },
  {
    "id": 32825,
    "book": "isaiah                                  ",
    "chapter": "41",
    "verse": "4",
    "text": "Vem har format och gjort det?"
  },
  {
    "id": 32826,
    "book": "isaiah                                  ",
    "chapter": "41",
    "verse": "5",
    "text": "Öarna (kustländerna) såg det och bävade,"
  },
  {
    "id": 32827,
    "book": "isaiah                                  ",
    "chapter": "41",
    "verse": "6",
    "text": "var och en hjälpte sin granne"
  },
  {
    "id": 32828,
    "book": "isaiah                                  ",
    "chapter": "41",
    "verse": "7",
    "text": "Snickaren stärker (ingjuter mod i) guldsmeden"
  },
  {
    "id": 32829,
    "book": "isaiah                                  ",
    "chapter": "41",
    "verse": "8",
    "text": "Israel, du min tjänare,"
  },
  {
    "id": 32830,
    "book": "isaiah                                  ",
    "chapter": "41",
    "verse": "9",
    "text": "dig som jag hämtade [tog tag i min hand för att leda tillbaka] från jordens ände,"
  },
  {
    "id": 32831,
    "book": "isaiah                                  ",
    "chapter": "41",
    "verse": "10",
    "text": "Var inte rädd (frukta inte),"
  },
  {
    "id": 32832,
    "book": "isaiah                                  ",
    "chapter": "41",
    "verse": "11",
    "text": "Se, alla som var arga på dig"
  },
  {
    "id": 32833,
    "book": "isaiah                                  ",
    "chapter": "41",
    "verse": "12",
    "text": "Du ska leta efter dem men inte finna dem,"
  },
  {
    "id": 32834,
    "book": "isaiah                                  ",
    "chapter": "41",
    "verse": "13",
    "text": "För jag, Herren (Jahve) din Gud (Elohim),"
  },
  {
    "id": 32835,
    "book": "isaiah                                  ",
    "chapter": "41",
    "verse": "14",
    "text": "Frukta inte (var aldrig någonsin rädd) du mask Jakob,"
  },
  {
    "id": 32836,
    "book": "isaiah                                  ",
    "chapter": "41",
    "verse": "15",
    "text": "Se, jag gör dig till en ny tröskvagn"
  },
  {
    "id": 32837,
    "book": "isaiah                                  ",
    "chapter": "41",
    "verse": "16",
    "text": "Du ska blåsa på dem och vinden ska bära bort dem"
  },
  {
    "id": 32838,
    "book": "isaiah                                  ",
    "chapter": "41",
    "verse": "17",
    "text": "De fattiga och behövande söker efter vatten"
  },
  {
    "id": 32839,
    "book": "isaiah                                  ",
    "chapter": "41",
    "verse": "18",
    "text": "Jag ska öppna floder på de kala höjderna"
  },
  {
    "id": 32840,
    "book": "isaiah                                  ",
    "chapter": "41",
    "verse": "19",
    "text": "I öknen ska jag plantera"
  },
  {
    "id": 32841,
    "book": "isaiah                                  ",
    "chapter": "41",
    "verse": "20",
    "text": "För att de ska se och veta (djup, intim kunskap)"
  },
  {
    "id": 32842,
    "book": "isaiah                                  ",
    "chapter": "41",
    "verse": "21",
    "text": "Presentera (konstruera) ditt ärende, säger Herren (Jahve),"
  },
  {
    "id": 32843,
    "book": "isaiah                                  ",
    "chapter": "41",
    "verse": "22",
    "text": "Låt dem föra fram dem [avgudarna]"
  },
  {
    "id": 32844,
    "book": "isaiah                                  ",
    "chapter": "41",
    "verse": "23",
    "text": "Förkunna de ting som ska ske härefter,"
  },
  {
    "id": 32845,
    "book": "isaiah                                  ",
    "chapter": "41",
    "verse": "24",
    "text": "Se, ni är ingenting"
  },
  {
    "id": 32846,
    "book": "isaiah                                  ",
    "chapter": "41",
    "verse": "25",
    "text": "Jag har rest upp en från norr och han kommer,"
  },
  {
    "id": 32847,
    "book": "isaiah                                  ",
    "chapter": "41",
    "verse": "26",
    "text": "Vem har förkunnat från början för att vi ska veta (djup, intim kunskap),"
  },
  {
    "id": 32848,
    "book": "isaiah                                  ",
    "chapter": "41",
    "verse": "27",
    "text": "Jag ska ge ett förebud till Sion [tempelberget i Jerusalem]: ”Se (hebr. hineh), se (hebr. hen) dem”,"
  },
  {
    "id": 32849,
    "book": "isaiah                                  ",
    "chapter": "41",
    "verse": "28",
    "text": "Jag ser mig omkring, men där fanns ingen människa,"
  },
  {
    "id": 32850,
    "book": "isaiah                                  ",
    "chapter": "41",
    "verse": "29",
    "text": "Se, allesammans, deras arbete är förgängligt (tomhet, ingenting),"
  }
]