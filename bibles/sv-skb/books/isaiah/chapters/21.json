[
  {
    "id": 32409,
    "book": "isaiah                                  ",
    "chapter": "21",
    "verse": "1",
    "text": "Budskap om (profetord, börda över) öknen vid havet [troligtvis Babylon och området kring Eufrat floden]."
  },
  {
    "id": 32410,
    "book": "isaiah                                  ",
    "chapter": "21",
    "verse": "2",
    "text": "En hemsk syn förkunnas för mig:"
  },
  {
    "id": 32411,
    "book": "isaiah                                  ",
    "chapter": "21",
    "verse": "3",
    "text": "Därför är mina länder fyllda med krampryckningar,"
  },
  {
    "id": 32412,
    "book": "isaiah                                  ",
    "chapter": "21",
    "verse": "4",
    "text": "Mitt hjärta är förvillat,"
  },
  {
    "id": 32413,
    "book": "isaiah                                  ",
    "chapter": "21",
    "verse": "5",
    "text": "De förbereder bordet,"
  },
  {
    "id": 32414,
    "book": "isaiah                                  ",
    "chapter": "21",
    "verse": "6",
    "text": "För så har Herren (Adonaj) sagt till mig:"
  },
  {
    "id": 32415,
    "book": "isaiah                                  ",
    "chapter": "21",
    "verse": "7",
    "text": "Och när han ser en armé,"
  },
  {
    "id": 32416,
    "book": "isaiah                                  ",
    "chapter": "21",
    "verse": "8",
    "text": "Och han ska ropa (ryta) som ett lejon:"
  },
  {
    "id": 32417,
    "book": "isaiah                                  ",
    "chapter": "21",
    "verse": "9",
    "text": "Och se, där kommer en armé med män,"
  },
  {
    "id": 32418,
    "book": "isaiah                                  ",
    "chapter": "21",
    "verse": "10",
    "text": "Du min tröskning och sållning av mitt mjöl,"
  },
  {
    "id": 32419,
    "book": "isaiah                                  ",
    "chapter": "21",
    "verse": "11",
    "text": "Budskap om (profetord, börda över) Duma [betyder ”tystnad” och refererar till Edom]."
  },
  {
    "id": 32420,
    "book": "isaiah                                  ",
    "chapter": "21",
    "verse": "12",
    "text": "Väktaren svarar:"
  },
  {
    "id": 32421,
    "book": "isaiah                                  ",
    "chapter": "21",
    "verse": "13",
    "text": "Budskap om (profetord, börda över) Arabien."
  },
  {
    "id": 32422,
    "book": "isaiah                                  ",
    "chapter": "21",
    "verse": "14",
    "text": "Ge vatten till honom som är törstig."
  },
  {
    "id": 32423,
    "book": "isaiah                                  ",
    "chapter": "21",
    "verse": "15",
    "text": "För de flyr från svärdet,"
  },
  {
    "id": 32424,
    "book": "isaiah                                  ",
    "chapter": "21",
    "verse": "16",
    "text": "För så har Herren (Adonaj) sagt till mig: ”Inom ett år, enligt den fales (mutkolvens) (sätt att räkna) år, ska Kedars härlighet [område i norra Arabien] falla,"
  },
  {
    "id": 32425,
    "book": "isaiah                                  ",
    "chapter": "21",
    "verse": "17",
    "text": "och återstoden av antalet bågskyttar, de mäktiga männen av Kedars söner, ska förminskas, för Herren (Jahve) Israels Gud (Elohim) har talat.”"
  }
]