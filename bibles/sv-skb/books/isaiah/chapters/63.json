[
  {
    "id": 33236,
    "book": "isaiah                                  ",
    "chapter": "63",
    "verse": "1",
    "text": "Vem är det som kommer från Edom [söder om Döda havet]"
  },
  {
    "id": 33237,
    "book": "isaiah                                  ",
    "chapter": "63",
    "verse": "2",
    "text": "”Varför är din dräkt röd"
  },
  {
    "id": 33238,
    "book": "isaiah                                  ",
    "chapter": "63",
    "verse": "3",
    "text": "”Jag ensam har trampat min vinpress"
  },
  {
    "id": 33239,
    "book": "isaiah                                  ",
    "chapter": "63",
    "verse": "4",
    "text": "Hämndens dag som var i mitt hjärta"
  },
  {
    "id": 33240,
    "book": "isaiah                                  ",
    "chapter": "63",
    "verse": "5",
    "text": "Jag tittade (sökte, letade) men där fanns ingen till hjälp"
  },
  {
    "id": 33241,
    "book": "isaiah                                  ",
    "chapter": "63",
    "verse": "6",
    "text": "Jag trampade ner folken i min vrede"
  },
  {
    "id": 33242,
    "book": "isaiah                                  ",
    "chapter": "63",
    "verse": "7",
    "text": "Jag ska komma ihåg (hålla i minnet, som ett minnesmärke) Herrens (Jahves) nåd (omsorgsfulla kärlek),"
  },
  {
    "id": 33243,
    "book": "isaiah                                  ",
    "chapter": "63",
    "verse": "8",
    "text": "För han säger: ”Sannerligen, de är mitt folk,"
  },
  {
    "id": 33244,
    "book": "isaiah                                  ",
    "chapter": "63",
    "verse": "9",
    "text": "I all deras plåga, var han plågad"
  },
  {
    "id": 33245,
    "book": "isaiah                                  ",
    "chapter": "63",
    "verse": "10",
    "text": "Men de gjorde uppror"
  },
  {
    "id": 33246,
    "book": "isaiah                                  ",
    "chapter": "63",
    "verse": "11",
    "text": "Då kom hans folk ihåg de gamla dagarna,"
  },
  {
    "id": 33247,
    "book": "isaiah                                  ",
    "chapter": "63",
    "verse": "12",
    "text": "Vad fick hans härliga arm"
  },
  {
    "id": 33248,
    "book": "isaiah                                  ",
    "chapter": "63",
    "verse": "13",
    "text": "Som ledde dem genom djupen,"
  },
  {
    "id": 33249,
    "book": "isaiah                                  ",
    "chapter": "63",
    "verse": "14",
    "text": "Som boskapen som går ner till dalen,"
  },
  {
    "id": 33250,
    "book": "isaiah                                  ",
    "chapter": "63",
    "verse": "15",
    "text": "Se ner från himlarna och skåda"
  },
  {
    "id": 33251,
    "book": "isaiah                                  ",
    "chapter": "63",
    "verse": "16",
    "text": "För du är vår far,"
  },
  {
    "id": 33252,
    "book": "isaiah                                  ",
    "chapter": "63",
    "verse": "17",
    "text": "Herre (Jahve), varför får du oss att ta fel på dina vägar"
  },
  {
    "id": 33253,
    "book": "isaiah                                  ",
    "chapter": "63",
    "verse": "18",
    "text": "För en kort tid fördrevs ditt heliga folk"
  },
  {
    "id": 33254,
    "book": "isaiah                                  ",
    "chapter": "63",
    "verse": "19",
    "text": "Vi har blivit som dem över vilka du aldrig regerat,"
  }
]