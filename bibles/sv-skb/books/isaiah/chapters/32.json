[
  {
    "id": 32633,
    "book": "isaiah                                  ",
    "chapter": "32",
    "verse": "1",
    "text": "Se, en kung ska regera i rättfärdighet,"
  },
  {
    "id": 32634,
    "book": "isaiah                                  ",
    "chapter": "32",
    "verse": "2",
    "text": "Och en man ska vara som i ett gömställe från vinden,"
  },
  {
    "id": 32635,
    "book": "isaiah                                  ",
    "chapter": "32",
    "verse": "3",
    "text": "Och ögonen på dem som ser ska inte stängas,"
  },
  {
    "id": 32636,
    "book": "isaiah                                  ",
    "chapter": "32",
    "verse": "4",
    "text": "Även hjärtat hos de rastlösa (snabba; obetänksamma; de som ofta tar förhastade beslut) ska förstå kunskap,"
  },
  {
    "id": 32637,
    "book": "isaiah                                  ",
    "chapter": "32",
    "verse": "5",
    "text": "En usel människa ska inte mer kallas frikostig,"
  },
  {
    "id": 32638,
    "book": "isaiah                                  ",
    "chapter": "32",
    "verse": "6",
    "text": "För den ondskefulle dåren (hebr. naval) ska tala dåraktigt (ondskefullt – hebr. nevalah)"
  },
  {
    "id": 32639,
    "book": "isaiah                                  ",
    "chapter": "32",
    "verse": "7",
    "text": "Bedragarens redskap är onda,"
  },
  {
    "id": 32640,
    "book": "isaiah                                  ",
    "chapter": "32",
    "verse": "8",
    "text": "Men den frikostige ger frikostigt"
  },
  {
    "id": 32641,
    "book": "isaiah                                  ",
    "chapter": "32",
    "verse": "9",
    "text": "Stå upp ni kvinnor som är modiga"
  },
  {
    "id": 32642,
    "book": "isaiah                                  ",
    "chapter": "32",
    "verse": "10",
    "text": "Efter ett år och dagar [om drygt ett år] ska ni bli oroliga,"
  },
  {
    "id": 32643,
    "book": "isaiah                                  ",
    "chapter": "32",
    "verse": "11",
    "text": "Bäva ni kvinnor som är modiga,"
  },
  {
    "id": 32644,
    "book": "isaiah                                  ",
    "chapter": "32",
    "verse": "12",
    "text": "Slå er för bröstet för de ljuvliga fälten,"
  },
  {
    "id": 32645,
    "book": "isaiah                                  ",
    "chapter": "32",
    "verse": "13",
    "text": "för mitt folks land"
  },
  {
    "id": 32646,
    "book": "isaiah                                  ",
    "chapter": "32",
    "verse": "14",
    "text": "För palatsen ska bli övergivna,"
  },
  {
    "id": 32647,
    "book": "isaiah                                  ",
    "chapter": "32",
    "verse": "15",
    "text": "Till dess anden utgjuts över oss från höjden"
  },
  {
    "id": 32648,
    "book": "isaiah                                  ",
    "chapter": "32",
    "verse": "16",
    "text": "Då ska rätten bo i öknen"
  },
  {
    "id": 32649,
    "book": "isaiah                                  ",
    "chapter": "32",
    "verse": "17",
    "text": "Rättfärdighetens arbete ska vara frid (shalom)"
  },
  {
    "id": 32650,
    "book": "isaiah                                  ",
    "chapter": "32",
    "verse": "18",
