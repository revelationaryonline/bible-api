[
  {
    "id": 32538,
    "book": "isaiah                                  ",
    "chapter": "28",
    "verse": "1",
    "text": "Ve över den stolta kronan på Efraims druckna,"
  },
  {
    "id": 32539,
    "book": "isaiah                                  ",
    "chapter": "28",
    "verse": "2",
    "text": "Se, Herren (Adonaj) är stark och mäktig,"
  },
  {
    "id": 32540,
    "book": "isaiah                                  ",
    "chapter": "28",
    "verse": "3",
    "text": "Under fötterna ska den stolta kronan"
  },
  {
    "id": 32541,
    "book": "isaiah                                  ",
    "chapter": "28",
    "verse": "4",
    "text": "och den vissnande blomman av hans ärbara skönhet"
  },
  {
    "id": 32542,
    "book": "isaiah                                  ",
    "chapter": "28",
    "verse": "5",
    "text": "På den dagen ska Härskarornas Herre (Jahve Sebaot)"
  },
  {
    "id": 32543,
    "book": "isaiah                                  ",
    "chapter": "28",
    "verse": "6",
    "text": "och en domens ande"
  },
  {
    "id": 32544,
    "book": "isaiah                                  ",
    "chapter": "28",
    "verse": "7",
    "text": "Men dessa rullar i vin"
  },
  {
    "id": 32545,
    "book": "isaiah                                  ",
    "chapter": "28",
    "verse": "8",
    "text": "Alla bord är fyllda av snuskiga spyor"
  },
  {
    "id": 32546,
    "book": "isaiah                                  ",
    "chapter": "28",
    "verse": "9",
    "text": "Vem ska man undervisa kunskap (lära ut något till)?"
  },
  {
    "id": 32547,
    "book": "isaiah                                  ",
    "chapter": "28",
    "verse": "10",
    "text": "För det är"
  },
  {
    "id": 32548,
    "book": "isaiah                                  ",
    "chapter": "28",
    "verse": "11",
    "text": "För med stammande läppar"
  },
  {
    "id": 32549,
    "book": "isaiah                                  ",
    "chapter": "28",
    "verse": "12",
    "text": "till vilka det sades:"
  },
  {
    "id": 32550,
    "book": "isaiah                                  ",
    "chapter": "28",
    "verse": "13",
    "text": "Så blir Herrens (Jahves) ord för dem"
  },
  {
    "id": 32551,
    "book": "isaiah                                  ",
    "chapter": "28",
    "verse": "14",
    "text": "Hör därför Herrens (Jahves) ord, ni bespottare"
  },
  {
    "id": 32552,
    "book": "isaiah                                  ",
    "chapter": "28",
    "verse": "15",
    "text": "För ni har sagt: ”Vi har skurit förbund med döden,"
  },
  {
    "id": 32553,
    "book": "isaiah                                  ",
    "chapter": "28",
    "verse": "16",
    "text": "Därför säger Herren Herren (Adonaj Jahve) så:"
  },
  {
    "id": 32554,
    "book": "isaiah                                  ",
    "chapter": "28",
    "verse": "17",
    "text": "Jag ska göra rätten till mätsnöre"
  },
  {
    "id": 32555,
    "book": "isaiah                                  ",
    "chapter": "28",
    "verse": "18",
    "text": "Och ditt förbund med döden ska göras om intet,"
  },
  {
    "id": 32556,
    "book": "isaiah                                  ",
    "chapter": "28",
    "verse": "19",
    "text": "Så ofta som det drar förbi ska det fånga dig,"
  },
  {
    "id": 32557,
    "book": "isaiah                                  ",
    "chapter": "28",
    "verse": "20",
    "text": "Sängen är för kort för en man att sträcka ut sig själv i,"
  },
  {
    "id": 32558,
    "book": "isaiah                                  ",
    "chapter": "28",
    "verse": "21",
    "text": "För Herren (Jahve) ska resa sig som på berget Peratsim [2 Sam 5:20],"
  },
  {
    "id": 32559,
    "book": "isaiah                                  ",
    "chapter": "28",
    "verse": "22",
    "text": "Sluta därför bespotta,"
  },
  {
    "id": 32560,
    "book": "isaiah                                  ",
    "chapter": "28",
    "verse": "23",
    "text": "Ge ditt öra och lyssna till min röst,"
  },
  {
    "id": 32561,
    "book": "isaiah                                  ",
    "chapter": "28",
    "verse": "24",
    "text": "Den som plöjer, plöjer han hela dagen för att så?"
  },
  {
    "id": 32562,
    "book": "isaiah                                  ",
    "chapter": "28",
    "verse": "25",
    "text": "Nej, när han har gjort marken slät,"
  },
  {
    "id": 32563,
    "book": "isaiah                                  ",
    "chapter": "28",
    "verse": "26",
    "text": "för han har instruerat sina påbud (bindande juridiska beslut),"
  },
  {
    "id": 32564,
    "book": "isaiah                                  ",
    "chapter": "28",
    "verse": "27",
    "text": "För dill tröskas inte med trösksläden,"
  },
  {
    "id": 32565,
    "book": "isaiah                                  ",
    "chapter": "28",
    "verse": "28",
    "text": "Brödsäden krossas"
  },
  {
    "id": 32566,
    "book": "isaiah                                  ",
    "chapter": "28",
    "verse": "29",
    "text": "Också detta kommer från Härskarornas Herre (Jahve Sebaot)."
  }
]