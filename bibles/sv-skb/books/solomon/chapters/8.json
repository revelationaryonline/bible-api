[
  {
    "id": 59405,
    "book": "solomon                                 ",
    "chapter": "8",
    "verse": "1",
    "text": "Tänk om du var som min bror,"
  },
  {
    "id": 59406,
    "book": "solomon                                 ",
    "chapter": "8",
    "verse": "2",
    "text": "Jag skulle leda dig"
  },
  {
    "id": 59407,
    "book": "solomon                                 ",
    "chapter": "8",
    "verse": "3",
    "text": "Åh, om hans vänstra arm var under mitt huvud [dvs. att de ligger ned],"
  },
  {
    "id": 59408,
    "book": "solomon                                 ",
    "chapter": "8",
    "verse": "4",
    "text": "Jag ber er Jerusalems kvinnor, lova mig detta:"
  },
  {
    "id": 59409,
    "book": "solomon                                 ",
    "chapter": "8",
    "verse": "5",
    "text": "[Kören:] Vem är hon som kommer ur öknen,"
  },
  {
    "id": 59410,
    "book": "solomon                                 ",
    "chapter": "8",
    "verse": "6",
    "text": "[Bruden till sin älskade:]"
  },
  {
    "id": 59411,
    "book": "solomon                                 ",
    "chapter": "8",
    "verse": "7",
    "text": "Mäktiga vatten kan inte släcka kärleken,"
  },
  {
    "id": 59412,
    "book": "solomon                                 ",
    "chapter": "8",
    "verse": "8",
    "text": "”Vi har en liten syster"
  },
  {
    "id": 59413,
    "book": "solomon                                 ",
    "chapter": "8",
    "verse": "9",
    "text": "Är hon en mur"
  },
  {
    "id": 59414,
    "book": "solomon                                 ",
    "chapter": "8",
    "verse": "10",
    "text": "Jag är en mur"
  },
  {
    "id": 59415,
    "book": "solomon                                 ",
    "chapter": "8",
    "verse": "11",
    "text": "Salomo har en vingård i Baal-Hamon."
  },
  {
    "id": 59416,
    "book": "solomon                                 ",
    "chapter": "8",
    "verse": "12",
    "text": "Min vingård, som är min, fanns före mig."
  },
  {
    "id": 59417,
    "book": "solomon                                 ",
    "chapter": "8",
    "verse": "13",
    "text": "Du som bor i gårdarna,"
  },
  {
    "id": 59418,
    "book": "solomon                                 ",
    "chapter": "8",
    "verse": "14",
    "text": "Skynda dig min älskade (raring), var som en gasell eller en ung hjort, på de kryddiga bergen (bergen som doftar av alla slags kryddor)."
  }
