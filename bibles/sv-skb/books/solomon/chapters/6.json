[
  {
    "id": 59379,
    "book": "solomon                                 ",
    "chapter": "6",
    "verse": "1",
    "text": "Vart har din vän gått,"
  },
  {
    "id": 59380,
    "book": "solomon                                 ",
    "chapter": "6",
    "verse": "2",
    "text": "Min älskade (raring) har gått ner till sin trädgård,"
  },
  {
    "id": 59381,
    "book": "solomon                                 ",
    "chapter": "6",
    "verse": "3",
    "text": "Jag är min älskades (raring) och min älskade (raring) är min,"
  },
  {
    "id": 59382,
    "book": "solomon                                 ",
    "chapter": "6",
    "verse": "4",
    "text": "Du är skön min älskade, som Tirsa,"
  },
  {
    "id": 59383,
    "book": "solomon                                 ",
    "chapter": "6",
    "verse": "5",
    "text": "Vänd bort dina ögon från mig"
  },
  {
    "id": 59384,
    "book": "solomon                                 ",
    "chapter": "6",
    "verse": "6",
    "text": "Dina tänder är som en flock tackor som har kommit upp ur badet,"
  },
  {
    "id": 59385,
    "book": "solomon                                 ",
    "chapter": "6",
    "verse": "7",
    "text": "Dina tinningar bakom din slöja är som brustna (delade) granatäpplen."
  },
  {
    "id": 59386,
    "book": "solomon                                 ",
    "chapter": "6",
    "verse": "8",
    "text": "Det finns 60 drottningar"
  },
  {
    "id": 59387,
    "book": "solomon                                 ",
    "chapter": "6",
    "verse": "9",
    "text": "Min duva, min obefläckade är unik,"
  },
  {
    "id": 59388,
    "book": "solomon                                 ",
    "chapter": "6",
    "verse": "10",
    "text": "Vem är hon som kommer fram (visar sig) som gryningen [som blir mer och mer tydlig],"
  },
  {
    "id": 59389,
    "book": "solomon                                 ",
    "chapter": "6",
    "verse": "11",
    "text": "Jag gick ner till min trädgård med valnötsträd [ordagrant ”nötter”, men valnötsträd var vanliga på denna tid och har genom alla tider ansetts vara den finaste nötsorten]"
  },
  {
    "id": 59390,
    "book": "solomon                                 ",
    "chapter": "6",
    "verse": "12",
    "text": "Innan jag var medveten om det,"
  },
  {
    "id": 59391,
    "book": "solomon                                 ",
    "chapter": "6",
    "verse": "13",
    "text": "Kom tillbaka, kom tillbaka, Shulamit [”den perfekta/fridfulla”],"
  }
