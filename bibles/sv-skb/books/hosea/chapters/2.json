[
  {
    "id": 27495,
    "book": "hosea                                   ",
    "chapter": "2",
    "verse": "1",
    "text": "Säg till (kalla) era bröder Ammi (mitt folk) [Hos 1:9] och era systrar Ruhama (du har fått nåd) [Hos 1:6-8]."
  },
  {
    "id": 27496,
    "book": "hosea                                   ",
    "chapter": "2",
    "verse": "2",
    "text": "Förebrå er mor [Gomer – syftar på nationen Israel],"
  },
  {
    "id": 27497,
    "book": "hosea                                   ",
    "chapter": "2",
    "verse": "3",
    "text": "Annars klär jag av henne naken"
  },
  {
    "id": 27498,
    "book": "hosea                                   ",
    "chapter": "2",
    "verse": "4",
    "text": "Och jag ska inte ha förbarmande över hennes söner,"
  },
  {
    "id": 27499,
    "book": "hosea                                   ",
    "chapter": "2",
    "verse": "5",
    "text": "För deras mor har agerat prostituerad,"
  },
  {
    "id": 27500,
    "book": "hosea                                   ",
    "chapter": "2",
    "verse": "6",
    "text": "Se, därför ska jag inhägna dina vägar med törne"
  },
  {
    "id": 27501,
    "book": "hosea                                   ",
    "chapter": "2",
    "verse": "7",
    "text": "Och hon ska springa efter sin älskare"
  },
  {
    "id": 27502,
    "book": "hosea                                   ",
    "chapter": "2",
    "verse": "8",
    "text": "För hon vet inte att det var jag"
  },
  {
    "id": 27503,
    "book": "hosea                                   ",
    "chapter": "2",
    "verse": "9",
    "text": "Därför ska jag ta tillbaka min säd i dess tid"
  },
  {
    "id": 27504,
    "book": "hosea                                   ",
    "chapter": "2",
    "verse": "10",
    "text": "Och nu ska jag blotta hennes skam inför ögonen på hennes älskare"
  },
  {
    "id": 27505,
    "book": "hosea                                   ",
    "chapter": "2",
    "verse": "11",
    "text": "Jag ska göra slut på all hennes glädje (munterhet),"
  },
  {
    "id": 27506,
    "book": "hosea                                   ",
    "chapter": "2",
    "verse": "12",
    "text": "Och jag ska ödelägga hennes vin och hennes fikonträd,"
  },
  {
    "id": 27507,
    "book": "hosea                                   ",
    "chapter": "2",
    "verse": "13",
    "text": "Och jag ska hemsöka henne på baalernas dagar,"
  },
  {
    "id": 27508,
    "book": "hosea                                   ",
    "chapter": "2",
    "verse": "14",
    "text": "Se, därför ska jag locka på henne"
  },
  {
    "id": 27509,
    "book": "hosea                                   ",
    "chapter": "2",
    "verse": "15",
    "text": "Och jag ska ge henne hennes vingårdar därifrån"
  },
  {
    "id": 27510,
    "book": "hosea                                   ",
    "chapter": "2",
    "verse": "16",
    "text": "Och det ska ske den dagen,"
  },
  {
    "id": 27511,
    "book": "hosea                                   ",
    "chapter": "2",
    "verse": "17",
    "text": "Och jag ska ta bort baalernas namn ut från hennes mun"
  },
  {
    "id": 27512,
    "book": "hosea                                   ",
    "chapter": "2",
    "verse": "18",
    "text": "Och på den dagen ska jag skära ett förbund med dem,"
  },
  {
    "id": 27513,
    "book": "hosea                                   ",
    "chapter": "2",
    "verse": "19",
    "text": "Och jag ska trolova dig med mig för evigt,"
  },
  {
    "id": 27514,
    "book": "hosea                                   ",
    "chapter": "2",
    "verse": "20",
    "text": "Och jag ska trolova dig med mig i trofasthet (sanning)"
  },
  {
    "id": 27515,
    "book": "hosea                                   ",
    "chapter": "2",
    "verse": "21",
    "text": "Och det ska ske den dagen att jag ska svara,"
  },
  {
    "id": 27516,
    "book": "hosea                                   ",
    "chapter": "2",
    "verse": "22",
    "text": "och jorden ska svara till säden"
  },
  {
    "id": 27517,
    "book": "hosea                                   ",
    "chapter": "2",
    "verse": "23",
    "text": "Och jag ska plantera henne till mig i landet"
  }
]