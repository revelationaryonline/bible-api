[
  {
    "id": 27656,
    "book": "hosea                                   ",
    "chapter": "13",
    "verse": "1",
    "text": "När Efraim talade darrade man,"
  },
  {
    "id": 27657,
    "book": "hosea                                   ",
    "chapter": "13",
    "verse": "2",
    "text": "Nu syndar de mer och mer (fortsätter de i synd; adderar, ökar sin synd)"
  },
  {
    "id": 27658,
    "book": "hosea                                   ",
    "chapter": "13",
    "verse": "3",
    "text": "Därför ska de bli som morgonens moln [som försvinner snabbt]"
  },
  {
    "id": 27659,
    "book": "hosea                                   ",
    "chapter": "13",
    "verse": "4",
    "text": "Likväl är jag Herren din Gud (Jahve Elohim)"
  },
  {
    "id": 27660,
    "book": "hosea                                   ",
    "chapter": "13",
    "verse": "5",
    "text": "Jag kände (var intimt förtrogen med) dig i öknen,"
  },
  {
    "id": 27661,
    "book": "hosea                                   ",
    "chapter": "13",
    "verse": "6",
    "text": "När de åt blev de mätta,"
  },
  {
    "id": 27662,
    "book": "hosea                                   ",
    "chapter": "13",
    "verse": "7",
    "text": "Därför har jag blivit för dem som ett lejon,"
  },
  {
    "id": 27663,
    "book": "hosea                                   ",
    "chapter": "13",
    "verse": "8",
    "text": "Jag ska möta dem som en björninna som har förlorat sina ungar,"
  },
  {
    "id": 27664,
    "book": "hosea                                   ",
    "chapter": "13",
    "verse": "9",
    "text": "Det är ditt fördärv Israel"
  },
  {
    "id": 27665,
    "book": "hosea                                   ",
    "chapter": "13",
    "verse": "10",
    "text": "Var är nu din kung som skulle kunna rädda dig i alla dina städer?"
  },
  {
    "id": 27666,
    "book": "hosea                                   ",
    "chapter": "13",
    "verse": "11",
    "text": "Jag gav er en kung i min vrede"
  },
  {
    "id": 27667,
    "book": "hosea                                   ",
    "chapter": "13",
    "verse": "12",
    "text": "Efraims missgärning är uppsamlad,"
  },
  {
    "id": 27668,
    "book": "hosea                                   ",
    "chapter": "13",
    "verse": "13",
    "text": "Kvalen från en födande kvinna ska komma över honom,"
  },
  {
    "id": 27669,
    "book": "hosea                                   ",
    "chapter": "13",
    "verse": "14",
    "text": "Från Sheols (underjordens, gravens) hand ska jag frige dem mot lösen,"
  },
  {
    "id": 27670,
    "book": "hosea                                   ",
    "chapter": "13",
    "verse": "15",
    "text": "För du har varit fruktsam bland vassrören,"
  }
]