[
  {
    "id": 59282,
    "book": "zephaniah                               ",
    "chapter": "3",
    "verse": "1",
    "text": "Ve över den förtryckta staden [Jerusalem],"
  },
  {
    "id": 59283,
    "book": "zephaniah                               ",
    "chapter": "3",
    "verse": "2",
    "text": "Hon lyssnade inte på rösten (som förmanade, var inte lydig),"
  },
  {
    "id": 59284,
    "book": "zephaniah                               ",
    "chapter": "3",
    "verse": "3",
    "text": "Hennes furstar (prinsar) därinne är rytande lejon,"
  },
  {
    "id": 59285,
    "book": "zephaniah                               ",
    "chapter": "3",
    "verse": "4",
    "text": "Hennes profeter är hänsynslösa,"
  },
  {
    "id": 59286,
    "book": "zephaniah                               ",
    "chapter": "3",
    "verse": "5",
    "text": "Herren (Jahve) är rättfärdig i hennes mitt;"
  },
  {
    "id": 59287,
    "book": "zephaniah                               ",
    "chapter": "3",
    "verse": "6",
    "text": "Jag har huggit av länder,"
  },
  {
    "id": 59288,
    "book": "zephaniah                               ",
    "chapter": "3",
    "verse": "7",
    "text": "Jag sade:"
  },
  {
    "id": 59289,
    "book": "zephaniah                               ",
    "chapter": "3",
    "verse": "8",
    "text": "”Därför måste du tålmodigt vänta på mig,” förkunnar (säger, proklamerar) Herren (Jahve)."
  },
  {
    "id": 59290,
    "book": "zephaniah                               ",
    "chapter": "3",
    "verse": "9",
    "text": "Då ska jag förvandla folken så att de talar ett rent språk från rena läppar,"
  },
  {
    "id": 59291,
    "book": "zephaniah                               ",
    "chapter": "3",
    "verse": "10",
    "text": "Ända från andra sidan floderna i Kush [nuvarande Etiopien och Sudan],"
  },
  {
    "id": 59292,
    "book": "zephaniah                               ",
    "chapter": "3",
    "verse": "11",
    "text": "På den dagen ska du inte längre skämmas"
  },
  {
    "id": 59293,
    "book": "zephaniah                               ",
    "chapter": "3",
    "verse": "12",
    "text": "Jag ska lämna kvar mitt ibland dig ett ödmjukt folk,"
  },
  {
    "id": 59294,
    "book": "zephaniah                               ",
    "chapter": "3",
    "verse": "13",
    "text": "De som då är kvar i Israel ska inte synda mer."
  },
  {
    "id": 59295,
    "book": "zephaniah                               ",
    "chapter": "3",
    "verse": "14",
    "text": "Jubla (sjung), dotter Sion [en kärleksfull titel på staden Jerusalem]!"
  },
  {
    "id": 59296,
    "book": "zephaniah                               ",
    "chapter": "3",
    "verse": "15",
    "text": "Herren (Jahve) har tagit bort domarna mot dig,"
  },
  {
    "id": 59297,
    "book": "zephaniah                               ",
    "chapter": "3",
    "verse": "16",
    "text": "På den dagen [då Jesus kommer tillbaka för att regera] ska det sägas till Jerusalem:"
  },
  {
    "id": 59298,
    "book": "zephaniah                               ",
    "chapter": "3",
    "verse": "17",
    "text": "Herren (Jahve), din Gud (Elohim) är mitt ibland (nära intill) dig,"
  },
  {
    "id": 59299,
    "book": "zephaniah                               ",
    "chapter": "3",
    "verse": "18",
    "text": "Jag ska samla dem bland er som sörjer över högtiderna [Herrens avtalade möten med sitt folk på bestämda tider – att de inte kan hållas],"
  },
  {
    "id": 59300,
    "book": "zephaniah                               ",
    "chapter": "3",
    "verse": "19",
    "text": "Se, på den tiden ska jag ta hand om (oskadliggöra, döma)"
  },
  {
    "id": 59301,
    "book": "zephaniah                               ",
    "chapter": "3",
    "verse": "20",
    "text": "På den tiden ska jag samla in er;"
  }
]