    "text": "Jag ska komma med sådan ångest över mänskligheten"
  },
  {
    "id": 59266,
    "book": "zephaniah                               ",
    "chapter": "1",
    "verse": "18",
    "text": "Varken deras silver eller deras guld"
  }
