[
  {
    "id": 59249,
    "book": "zephaniah                               ",
    "chapter": "1",
    "verse": "1",
    "text": "Herrens (Jahves) ord som kom till Sefanja [som betyder: ”Jahve gömmer och skyddar”],"
  },
  {
    "id": 59250,
    "book": "zephaniah                               ",
    "chapter": "1",
    "verse": "2",
    "text": "Jag ska svepa bort, svepa bort allt (sopa bort, skörda allt)"
  },
  {
    "id": 59251,
    "book": "zephaniah                               ",
    "chapter": "1",
    "verse": "3",
    "text": "Jag ska svepa bort människor och djur,"
  },
  {
    "id": 59252,
    "book": "zephaniah                               ",
    "chapter": "1",
    "verse": "4",
    "text": "Jag ska sträcka ut min hand över Juda"
  },
  {
    "id": 59253,
    "book": "zephaniah                               ",
    "chapter": "1",
    "verse": "5",
    "text": "dessa som böjer sig ner på taken"
  },
  {
    "id": 59254,
    "book": "zephaniah                               ",
    "chapter": "1",
    "verse": "6",
    "text": "dessa som vänder sig bort från att följa Herren (Jahve),"
  },
  {
    "id": 59255,
    "book": "zephaniah                               ",
    "chapter": "1",
    "verse": "7",
    "text": "Bli stilla (tyst) inför Herrens Guds (Adonaj Jahves) ansikte (närvaro),"
  },
  {
    "id": 59256,
    "book": "zephaniah                               ",
    "chapter": "1",
    "verse": "8",
    "text": "På dagen för Herrens (Jahves) offer"
  },
  {
    "id": 59257,
    "book": "zephaniah                               ",
    "chapter": "1",
    "verse": "9",
    "text": "På den dagen ska jag straffa alla som hoppar över tröskeln [tillber Dagon, se 1 Sam 5:5]"
  },
  {
    "id": 59258,
    "book": "zephaniah                               ",
    "chapter": "1",
    "verse": "10",
    "text": "På den dagen, förkunnar (säger, proklamerar) Herren (Jahve),"
  },
  {
    "id": 59259,
    "book": "zephaniah                               ",
    "chapter": "1",
    "verse": "11",
    "text": "Klaga ni invånare i Maktesh [troligtvis namnet på marknadsplatsen i Jerusalem],"
  },
  {
    "id": 59260,
    "book": "zephaniah                               ",
    "chapter": "1",
    "verse": "12",
    "text": "Och det ska ske på den tiden att jag ska genomsöka Jerusalem med lampor"
  },
  {
    "id": 59261,
    "book": "zephaniah                               ",
    "chapter": "1",
    "verse": "13",
    "text": "Deras tillgångar ska lämnas för plundring"
  },
  {
    "id": 59262,
    "book": "zephaniah                               ",
    "chapter": "1",
    "verse": "14",
    "text": "Nära, är Herrens (Jahves) dag – den stora,"
  },
  {
    "id": 59263,
    "book": "zephaniah                               ",
    "chapter": "1",
    "verse": "15",
    "text": "Den dagen är en dag av vrede,"
  },
  {
    "id": 59264,
    "book": "zephaniah                               ",
    "chapter": "1",
    "verse": "16",
    "text": "en shofarens och larmets (härskriets) dag [basunen varnade för fara, se Jer 4:5]"
  },
  {
    "id": 59265,
    "book": "zephaniah                               ",
    "chapter": "1",
