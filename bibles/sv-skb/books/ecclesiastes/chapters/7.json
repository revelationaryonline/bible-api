[
  {
    "id": 49004,
    "book": "ecclesiastes                            ",
    "chapter": "7",
    "verse": "1",
    "text": "Ett gott namn är bättre än god (dyrbar) olja,"
  },
  {
    "id": 49005,
    "book": "ecclesiastes                            ",
    "chapter": "7",
    "verse": "2",
    "text": "Det är bättre att gå till sorgehuset"
  },
  {
    "id": 49006,
    "book": "ecclesiastes                            ",
    "chapter": "7",
    "verse": "3",
    "text": "Förargelse (sorg, ilska, indignation) är bättre än skratt,"
  },
  {
    "id": 49007,
    "book": "ecclesiastes                            ",
    "chapter": "7",
    "verse": "4",
    "text": "Den vises hjärta är i sorgens hus,"
  },
  {
    "id": 49008,
    "book": "ecclesiastes                            ",
    "chapter": "7",
    "verse": "5",
    "text": "Det är bättre att höra den vises tillrättavisning"
  },
  {
    "id": 49009,
    "book": "ecclesiastes                            ",
    "chapter": "7",
    "verse": "6",
    "text": "För som sprakandet av törnen under en gryta,"
  },
  {
    "id": 49010,
    "book": "ecclesiastes                            ",
    "chapter": "7",
    "verse": "7",
    "text": "Förtryck vänder (gör) en vis man till en dåre"
  },
  {
    "id": 49011,
    "book": "ecclesiastes                            ",
    "chapter": "7",
    "verse": "8",
    "text": "Bättre slutet på något (en sak; ett ord) än början,"
  },
  {
    "id": 49012,
    "book": "ecclesiastes                            ",
    "chapter": "7",
    "verse": "9",
    "text": "Låt inte din ande förhasta sig i att bli arg,"
  },
  {
    "id": 49013,
    "book": "ecclesiastes                            ",
    "chapter": "7",
    "verse": "10",
    "text": "Säg inte: ”Hur kommer det sig att forna dagar var bättre än dessa?”,"
  },
  {
    "id": 49014,
    "book": "ecclesiastes                            ",
    "chapter": "7",
    "verse": "11",
    "text": "Vishet är lika gott som ett arv,"
  },
  {
    "id": 49015,
    "book": "ecclesiastes                            ",
    "chapter": "7",
    "verse": "12",
    "text": "Vishet är ett försvar (en försäkring, ett skydd),"
  },
  {
    "id": 49016,
    "book": "ecclesiastes                            ",
    "chapter": "7",
    "verse": "13",
    "text": "Betrakta Guds (Elohims) gärningar,"
  },
  {
    "id": 49017,
    "book": "ecclesiastes                            ",
    "chapter": "7",
    "verse": "14",
    "text": "Gläd dig de framgångsrika dagarna,"
  },
  {
    "id": 49018,
    "book": "ecclesiastes                            ",
    "chapter": "7",
    "verse": "15",
    "text": "Alla ting har jag sett under mina fåfänga dagar,"
  },
  {
    "id": 49019,
    "book": "ecclesiastes                            ",
    "chapter": "7",
    "verse": "16",
    "text": "Var inte överambitiös i det rätta"
  },
  {
    "id": 49020,
    "book": "ecclesiastes                            ",
    "chapter": "7",
    "verse": "17",
    "text": "Var inte överambitiös i ondska"
  },
  {
    "id": 49021,
    "book": "ecclesiastes                            ",
    "chapter": "7",
    "verse": "18",
    "text": "Det är gott att du tar hand om det ena,"
  },
  {
    "id": 49022,
    "book": "ecclesiastes                            ",
    "chapter": "7",
    "verse": "19",
    "text": "Vishet är ett fäste för en vis man,"
  },
  {
    "id": 49023,
    "book": "ecclesiastes                            ",
    "chapter": "7",
    "verse": "20",
    "text": "Det finns inte en rättfärdig människa på jorden,"
  },
  {
    "id": 49024,
    "book": "ecclesiastes                            ",
    "chapter": "7",
    "verse": "21",
    "text": "Ge inte akt på alla ord som talas,"
  },
  {
    "id": 49025,
    "book": "ecclesiastes                            ",
    "chapter": "7",
    "verse": "22",
    "text": "för många gånger vet också ditt eget hjärta"
  },
  {
    "id": 49026,
    "book": "ecclesiastes                            ",
    "chapter": "7",
    "verse": "23",
    "text": "Allt detta har jag prövat genom vishet, jag sade:"
  },
  {
    "id": 49027,
    "book": "ecclesiastes                            ",
    "chapter": "7",
    "verse": "24",
    "text": "Det som är långt borta och omåttligt djupt,"
  },
  {
    "id": 49028,
    "book": "ecclesiastes                            ",
    "chapter": "7",
    "verse": "25",
    "text": "Jag vände om och ägnade mitt hjärta åt att veta"
  },
  {
    "id": 49029,
    "book": "ecclesiastes                            ",
    "chapter": "7",
    "verse": "26",
    "text": "Och jag fann kvinnan bittrare än döden,"
  },
  {
    "id": 49030,
    "book": "ecclesiastes                            ",
    "chapter": "7",
    "verse": "27",
    "text": "Se, detta har jag funnit säger Predikaren (Kohelet),"
  },
  {
    "id": 49031,
    "book": "ecclesiastes                            ",
    "chapter": "7",
    "verse": "28",
    "text": "som min själ sökt (letat efter),"
  },
  {
    "id": 49032,
    "book": "ecclesiastes                            ",
    "chapter": "7",
    "verse": "29",
    "text": "Se, endast detta har jag funnit,"
  }
]