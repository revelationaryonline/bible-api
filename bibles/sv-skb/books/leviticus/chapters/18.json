  {
    "id": 39226,
    "book": "leviticus                               ",
    "chapter": "18",
    "verse": "24",
    "text": "Orena er inte med något av detta, för med allt sådant har de folkslag orenat sig, som jag fördriver (kastar ut) för er."
  },
  {
    "id": 39227,
    "book": "leviticus                               ",
    "chapter": "18",
    "verse": "25",
    "text": "Och landet är därför orenat, och jag ska hemsöka deras missgärning på dem, så att landet själv utspyr sina invånare. [3 Mos 20:23-24]"
  },
  {
    "id": 39228,
    "book": "leviticus                               ",
    "chapter": "18",
    "verse": "26",
    "text": "[Vers 26-30 formar en kiasm där ordet avskyvärt återkommer fyra ggr.]"
  },
  {
    "id": 39229,
    "book": "leviticus                               ",
    "chapter": "18",
    "verse": "27",
    "text": "För allt detta avskyvärda gjorde landets invånare före er,"
  },
  {
    "id": 39230,
    "book": "leviticus                               ",
    "chapter": "18",
    "verse": "28",
    "text": "Gör inte så att landet spyr ut er,"
  },
  {
    "id": 39231,
    "book": "leviticus                               ",
    "chapter": "18",
    "verse": "29",
    "text": "För var och en som gör något av detta avskyvärda,"
  },
  {
    "id": 39232,
    "book": "leviticus                               ",
    "chapter": "18",
    "verse": "30",
    "text": "Lyd min befallning (mishmar – något som ska vaktas och skyddas),"
  }
