[
  {
    "id": 49825,
    "book": "proverbs                                ",
    "chapter": "25",
    "verse": "1",
    "text": "Dessa ordspråk är också av Salomo,"
  },
  {
    "id": 49826,
    "book": "proverbs                                ",
    "chapter": "25",
    "verse": "2",
    "text": "Gud får ära genom att dölja en sak,"
  },
  {
    "id": 49827,
    "book": "proverbs                                ",
    "chapter": "25",
    "verse": "3",
    "text": "Som himmelen är [ofattbart] hög och jorden [enormt] djup,"
  },
  {
    "id": 49828,
    "book": "proverbs                                ",
    "chapter": "25",
    "verse": "4",
    "text": "Ta bort slagget (orenheten) från silvret,"
  },
  {
    "id": 49829,
    "book": "proverbs                                ",
    "chapter": "25",
    "verse": "5",
    "text": "Ta [på samma sätt] bort de ogudaktiga från kungens närvaro,"
  },
  {
    "id": 49830,
    "book": "proverbs                                ",
    "chapter": "25",
    "verse": "6",
    "text": "Var inte framfusig (påflugen, skrytsam) i kungens närvaro,"
  },
  {
    "id": 49831,
    "book": "proverbs                                ",
    "chapter": "25",
    "verse": "7",
    "text": "Det är bättre att bli ombedd: ”Kom upp här,”"
  },
  {
    "id": 49832,
    "book": "proverbs                                ",
    "chapter": "25",
    "verse": "8",
    "text": "Rusa inte in i en dispyt (diskussion, ordstrid, rättslig prövning),"
  },
  {
    "id": 49833,
    "book": "proverbs                                ",
    "chapter": "25",
    "verse": "9",
    "text": "Diskutera i stället [uppmanade] och lägg fram din åsikt (problem, oenighet),"
  },
  {
    "id": 49834,
    "book": "proverbs                                ",
    "chapter": "25",
    "verse": "10",
    "text": "För om den personen [som talat i förtroende till dig] hör det,"
  },
  {
    "id": 49835,
    "book": "proverbs                                ",
    "chapter": "25",
    "verse": "11",
    "text": "Ett ord talat i rätt tid (situation, omständighet) är [lika vackert och tilltalande]"
  },
  {
    "id": 49836,
    "book": "proverbs                                ",
    "chapter": "25",
    "verse": "12",
    "text": "Som ett örhänge av guld eller ett halsband av rent guld,"
  },
  {
    "id": 49837,
    "book": "proverbs                                ",
    "chapter": "25",
    "verse": "13",
    "text": "Som kylan från snö [från en nordlig vind från bergen] under skördetidens hetta,"
  },
  {
    "id": 49838,
    "book": "proverbs                                ",
    "chapter": "25",
    "verse": "14",
    "text": "Som moln och vind utan regn,"
  },
  {
    "id": 49839,
    "book": "proverbs                                ",
    "chapter": "25",
    "verse": "15",
    "text": "Genom tålamod kan en furste (ledare) vinnas över,"
  },
  {
    "id": 49840,
    "book": "proverbs                                ",
    "chapter": "25",
    "verse": "16",
    "text": "Om du hittar honung, ät bara det du behöver,"
  },
  {
    "id": 49841,
    "book": "proverbs                                ",
    "chapter": "25",
    "verse": "17",
    "text": "[På samma sätt är det med grannar.]"
  },
  {
    "id": 49842,
    "book": "proverbs                                ",
    "chapter": "25",
    "verse": "18",
    "text": "En klubba, ett svärd och en vass pil [dvs. ett dödligt vapen]"
  },
  {
    "id": 49843,
    "book": "proverbs                                ",
    "chapter": "25",
    "verse": "19",
    "text": "Att sätta sitt hopp till en otrogen (falsk, svekfull) människa i tider av problem (motgångar, prövningar),"
  },
  {
    "id": 49844,
    "book": "proverbs                                ",
    "chapter": "25",
    "verse": "20",
    "text": "Som att ta av sig kläder en kylig dag [vilket gör att man fryser ännu mer]"
  },
  {
    "id": 49845,
    "book": "proverbs                                ",
    "chapter": "25",
    "verse": "21",
    "text": "Om din fiende är hungrig, ge honom mat att äta,"
  },
  {
    "id": 49846,
    "book": "proverbs                                ",
    "chapter": "25",
    "verse": "22",
    "text": "Genom att göra det samlar du glödande kol [av skam] på hans huvud,"
  },
  {
    "id": 49847,
    "book": "proverbs                                ",
    "chapter": "25",
    "verse": "23",
    "text": "På samma sätt som en nordlig vind ger regn,"
  },
  {
    "id": 49848,
    "book": "proverbs                                ",
    "chapter": "25",
    "verse": "24",
    "text": "Det är bättre att bo i ett hörn på [det platta] hustaket"
  },
  {
    "id": 49849,
    "book": "proverbs                                ",
    "chapter": "25",
    "verse": "25",
    "text": "Som kallt vatten för en törstig själ,"
  },
  {
    "id": 49850,
    "book": "proverbs                                ",
    "chapter": "25",
    "verse": "26",
    "text": "Som en grumlad vattenkälla och en förgiftad brunn,"
  },
  {
    "id": 49851,
    "book": "proverbs                                ",
    "chapter": "25",
    "verse": "27",
    "text": "Det är inte bra att äta för mycket honung,"
  },
  {
    "id": 49852,
    "book": "proverbs                                ",
    "chapter": "25",
    "verse": "28",
    "text": "Den människa som inte kan styra över (behärska) sitt sinne (hjärta)"
  }
]