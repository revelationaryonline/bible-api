[
  {
    "id": 49314,
    "book": "proverbs                                ",
    "chapter": "8",
    "verse": "1",
    "text": "Är det inte så att fru vishet ropar,"
  },
  {
    "id": 49315,
    "book": "proverbs                                ",
    "chapter": "8",
    "verse": "2",
    "text": "Uppe på höjderna står hon,"
  },
  {
    "id": 49316,
    "book": "proverbs                                ",
    "chapter": "8",
    "verse": "3",
    "text": "Intill portarna,"
  },
  {
    "id": 49317,
    "book": "proverbs                                ",
    "chapter": "8",
    "verse": "4",
    "text": "”Till er människor (män – hebr. ish), jag ropar på er,"
  },
  {
    "id": 49318,
    "book": "proverbs                                ",
    "chapter": "8",
    "verse": "5",
    "text": "Ni oförståndiga, lär er klokhet (lär er urskilja vishet),"
  },
  {
    "id": 49319,
    "book": "proverbs                                ",
    "chapter": "8",
    "verse": "6",
    "text": "Lyssna, för jag vill berätta om fantastiska (förträffliga, överlägsna) saker,"
  },
  {
    "id": 49320,
    "book": "proverbs                                ",
    "chapter": "8",
    "verse": "7",
    "text": "Min mun talar (mumlar lågmält) vad som är sant (fast, bestående),"
  },
  {
    "id": 49321,
    "book": "proverbs                                ",
    "chapter": "8",
    "verse": "8",
    "text": "Alla ord från min mun är rättfärdiga,"
  },
  {
    "id": 49322,
    "book": "proverbs                                ",
    "chapter": "8",
    "verse": "9",
    "text": "De är uppenbara (självklara, lättillgängliga) för den som förstår,"
  },
  {
    "id": 49323,
    "book": "proverbs                                ",
    "chapter": "8",
    "verse": "10",
    "text": "Ta hellre emot min undervisning (förmaning) än [strävan efter] silver,"
  },
  {
    "id": 49324,
    "book": "proverbs                                ",
    "chapter": "8",
    "verse": "11",
    "text": "Vishet är bättre än rubiner och pärlor,"
  },
  {
    "id": 49325,
    "book": "proverbs                                ",
    "chapter": "8",
    "verse": "12",
    "text": "Jag, visheten bor tillsammans med förstånd,"
  },
  {
    "id": 49326,
    "book": "proverbs                                ",
    "chapter": "8",
    "verse": "13",
    "text": "Att frukta (vörda, respektera) Herren (Jahve)"
  },
  {
    "id": 49327,
    "book": "proverbs                                ",
    "chapter": "8",
    "verse": "14",
    "text": "”Jag [visheten personifierad] har alla råd (anvisningar, rekommendationer),"
  },
  {
    "id": 49328,
    "book": "proverbs                                ",
    "chapter": "8",
    "verse": "15",
    "text": "Genom mig regerar kungar (ledare)"
  },
  {
    "id": 49329,
    "book": "proverbs                                ",
    "chapter": "8",
    "verse": "16",
    "text": "Genom mig regerar härskare (ledare),"
  },
  {
    "id": 49330,
    "book": "proverbs                                ",
    "chapter": "8",
    "verse": "17",
    "text": "Jag älskar dem som älskar mig,"
  },
  {
    "id": 49331,
    "book": "proverbs                                ",
    "chapter": "8",
    "verse": "18",
    "text": "Rikedom och ära finns hos mig,"
  },
  {
    "id": 49332,
    "book": "proverbs                                ",
    "chapter": "8",
    "verse": "19",
    "text": "Min frukt är bättre än guld, ja bättre än finaste guld,"
  },
  {
    "id": 49333,
    "book": "proverbs                                ",
    "chapter": "8",
    "verse": "20",
    "text": "Jag går på rättfärdighetens väg,"
  },
  {
    "id": 49334,
    "book": "proverbs                                ",
    "chapter": "8",
    "verse": "21",
    "text": "för att förse de som älskar mig (har som livsstil att älska mig) med tillgångar (rikedomar, arv),"
  },
  {
    "id": 49335,
    "book": "proverbs                                ",
    "chapter": "8",
    "verse": "22",
    "text": "”Herren (Jahve) förvärvade (födde, skapade) mig [visheten personifierad] först av allt,"
  },
  {
    "id": 49336,
    "book": "proverbs                                ",
    "chapter": "8",
    "verse": "23",
    "text": "Jag blev tillsatt [fick min position] från evighet,"
  },
  {
    "id": 49337,
    "book": "proverbs                                ",
    "chapter": "8",
    "verse": "24",
    "text": "När det ännu inte fanns oceaners djup, föddes jag,"
  },
  {
    "id": 49338,
    "book": "proverbs                                ",
    "chapter": "8",
    "verse": "25",
    "text": "Innan bergen fick sin form (grund),"
  },
  {
    "id": 49339,
    "book": "proverbs                                ",
    "chapter": "8",
    "verse": "26",
    "text": "Innan han hade skapat öppet land"
  },
  {
    "id": 49340,
    "book": "proverbs                                ",
    "chapter": "8",
    "verse": "27",
    "text": "När han beredde (fastställde) himlarna, fanns jag [visheten personifierad] där,"
  },
  {
    "id": 49341,
    "book": "proverbs                                ",
    "chapter": "8",
    "verse": "28",
    "text": "När han skapade molnen i ovan,"
  },
  {
    "id": 49342,
    "book": "proverbs                                ",
    "chapter": "8",
    "verse": "29",
    "text": "När han satte upp havets kustlinjer så att de inte skulle överträda hans befallning,"
  },
  {
    "id": 49343,
    "book": "proverbs                                ",
    "chapter": "8",
    "verse": "30",
    "text": "Då var jag [visheten personifierad] bredvid honom som en mästare (koordinator av arbetet),"
  },
  {
    "id": 49344,
    "book": "proverbs                                ",
    "chapter": "8",
    "verse": "31",
    "text": "Jag gladde mig (njöt, var förtjust) på den bebodda delen av jorden,"
  },
  {
    "id": 49345,
    "book": "proverbs                                ",
    "chapter": "8",
    "verse": "32",
    "text": "”Lyssna nu därför på mig [visheten personifierad], mina vänner (barn):"
  },
  {
    "id": 49346,
    "book": "proverbs                                ",
    "chapter": "8",
    "verse": "33",
    "text": "Ta till er min tillrättavisning (förmaning) och bli visa,"
  },
  {
    "id": 49347,
    "book": "proverbs                                ",
    "chapter": "8",
    "verse": "34",
    "text": "Välsignad (salig, lycklig, avundsvärd) är den som lyssnar på mig,"
  },
  {
    "id": 49348,
    "book": "proverbs                                ",
    "chapter": "8",
    "verse": "35",
    "text": "För den som ständigt finner mig [visheten personifierad],"
  },
  {
    "id": 49349,
    "book": "proverbs                                ",
    "chapter": "8",
    "verse": "36",
    "text": "Men den som undviker (syndar mot) mig skadar sin egen själ,"
  }
]