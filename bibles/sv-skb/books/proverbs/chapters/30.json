[
  {
    "id": 49963,
    "book": "proverbs                                ",
    "chapter": "30",
    "verse": "1",
    "text": "Gudomligt inspirerade ord (profetiska ord) från Agur, Jakes son."
  },
  {
    "id": 49964,
    "book": "proverbs                                ",
    "chapter": "30",
    "verse": "2",
    "text": "Jag [Agur] är för oförnuftig för att kallas människa (jag är urskillningslös som ett vilt djur)"
  },
  {
    "id": 49965,
    "book": "proverbs                                ",
    "chapter": "30",
    "verse": "3",
    "text": "Jag har inte lärt mig Guds vishet"
  },
  {
    "id": 49966,
    "book": "proverbs                                ",
    "chapter": "30",
    "verse": "4",
    "text": "Vem har stigit upp till himmelen och kommit ner igen?"
  },
  {
    "id": 49967,
    "book": "proverbs                                ",
    "chapter": "30",
    "verse": "5",
    "text": "Varje löftesord från Gud (Eloha) [Elohim i singular – den ende Guden] är prövat och renat;"
  },
  {
    "id": 49968,
    "book": "proverbs                                ",
    "chapter": "30",
    "verse": "6",
    "text": "Lägg inte till något till hans ord, då tillrättavisar (dömer) han dig,"
  },
  {
    "id": 49969,
    "book": "proverbs                                ",
    "chapter": "30",
    "verse": "7",
    "text": "Två saker frågar (önskar, ber) jag [dig Gud],"
  },
  {
    "id": 49970,
    "book": "proverbs                                ",
    "chapter": "30",
    "verse": "8",
    "text": "Låt fåfänglighet (tomhet, tomt prat, lögn) vara långt borta från mig."
  },
  {
    "id": 49971,
    "book": "proverbs                                ",
    "chapter": "30",
    "verse": "9",
    "text": "Om jag har överflöd kanske jag skulle förneka dig och säga ”Vem är Herren (Jahve)?”,"
  },
  {
    "id": 49972,
    "book": "proverbs                                ",
    "chapter": "30",
    "verse": "10",
    "text": "Förtala inte en tjänare inför hans herre,"
  },
  {
    "id": 49973,
    "book": "proverbs                                ",
    "chapter": "30",
    "verse": "11",
    "text": "Det finns en typ av människor (en generation, ett släkte)"
  },
  {
    "id": 49974,
    "book": "proverbs                                ",
    "chapter": "30",
    "verse": "12",
    "text": "Det finns en generation (ett släkte) som är rena i sina egna ögon,"
  },
  {
    "id": 49975,
    "book": "proverbs                                ",
    "chapter": "30",
    "verse": "13",
    "text": "Det finns en generation (ett släkte)"
  },
  {
    "id": 49976,
    "book": "proverbs                                ",
    "chapter": "30",
    "verse": "14",
    "text": "Det finns en generation (ett släkte) vars tänder är som svärd,"
  },
  {
    "id": 49977,
    "book": "proverbs                                ",
    "chapter": "30",
    "verse": "15",
    "text": "Blodigeln har två döttrar som ropar:"
  },
  {
    "id": 49978,
    "book": "proverbs                                ",
    "chapter": "30",
    "verse": "16",
    "text": "Sheol (graven, underjorden – de dödas plats)."
  },
  {
    "id": 49979,
    "book": "proverbs                                ",
    "chapter": "30",
    "verse": "17",
    "text": "Ögat som hånar sin far"
  },
  {
    "id": 49980,
    "book": "proverbs                                ",
    "chapter": "30",
    "verse": "18",
    "text": "Det finns tre saker som går mig över huvudet,"
  },
  {
    "id": 49981,
    "book": "proverbs                                ",
    "chapter": "30",
    "verse": "19",
    "text": "Örnens väg (bana) i luften."
  },
  {
    "id": 49982,
    "book": "proverbs                                ",
    "chapter": "30",
    "verse": "20",
    "text": "På samma sätt är det med äktenskapsbrytaren,"
  },
  {
    "id": 49983,
    "book": "proverbs                                ",
    "chapter": "30",
    "verse": "21",
    "text": "Tre saker får jorden att darra,"
  },
  {
    "id": 49984,
    "book": "proverbs                                ",
    "chapter": "30",
    "verse": "22",
    "text": "En tjänare som regerar."
  },
  {
    "id": 49985,
    "book": "proverbs                                ",
    "chapter": "30",
    "verse": "23",
    "text": "En hatad (oälskad och frånstötande) kvinna som blir gift."
  },
  {
    "id": 49986,
    "book": "proverbs                                ",
    "chapter": "30",
    "verse": "24",
    "text": "Det finns fyra små varelser på jorden,"
  },
  {
    "id": 49987,
    "book": "proverbs                                ",
    "chapter": "30",
    "verse": "25",
    "text": "Myrorna är inte ett starkt folk, trots det samlar de in mat under sommaren."
  },
  {
    "id": 49988,
    "book": "proverbs                                ",
    "chapter": "30",
    "verse": "26",
    "text": "Klippdassarna [klipphyraxen – typ av grävling] är ett klent folk, ändå bygger de sina hus i berget."
  },
  {
    "id": 49989,
    "book": "proverbs                                ",
    "chapter": "30",
    "verse": "27",
    "text": "Gräshopporna har ingen kung [över sig], ändå går de ut avdelade (formaterade) som en vältränad armé."
  },
  {
    "id": 49990,
    "book": "proverbs                                ",
    "chapter": "30",
    "verse": "28",
    "text": "Spindeln kan du fånga med händerna, ändå finns den i kungliga palats."
  },
  {
    "id": 49991,
    "book": "proverbs                                ",
    "chapter": "30",
    "verse": "29",
    "text": "Tre ting rör sig fram ståtligt,"
  },
  {
    "id": 49992,
    "book": "proverbs                                ",
    "chapter": "30",
    "verse": "30",
    "text": "Lejonet, som är det mäktigaste bland djuren, som inte väjer för något."
  },
  {
    "id": 49993,
    "book": "proverbs                                ",
    "chapter": "30",
    "verse": "31",
    "text": "Stridshästen."
  },
  {
    "id": 49994,
    "book": "proverbs                                ",
    "chapter": "30",
    "verse": "32",
    "text": "Om du har agerat dåraktigt (agerat utan att tänka) och upphöjt dig själv,"
  },
  {
    "id": 49995,
    "book": "proverbs                                ",
    "chapter": "30",
    "verse": "33",
    "text": "På samma sätt som mjölk (grädde) blir till smör (ost) när man stöter det,"
  }
]