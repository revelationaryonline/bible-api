[
  {
    "id": 49756,
    "book": "proverbs                                ",
    "chapter": "23",
    "verse": "1",
    "text": "När du blir bjuden på middag hos en inflytelserik person,"
  },
  {
    "id": 49757,
    "book": "proverbs                                ",
    "chapter": "23",
    "verse": "2",
    "text": "Sätt en kniv på din strupe"
  },
  {
    "id": 49758,
    "book": "proverbs                                ",
    "chapter": "23",
    "verse": "3",
    "text": "Åtrå inte hans delikatesser,"
  },
  {
    "id": 49759,
    "book": "proverbs                                ",
    "chapter": "23",
    "verse": "4",
    "text": "Trötta inte ut dig för att bli rik,"
  },
  {
    "id": 49760,
    "book": "proverbs                                ",
    "chapter": "23",
    "verse": "5",
    "text": "Om du bara fäster din blick på (fokuserar på) materiell rikedom,"
  },
  {
    "id": 49761,
    "book": "proverbs                                ",
    "chapter": "23",
    "verse": "6",
    "text": "Ät inte den missunnsammes (hårdes, avundsjukes) mat,"
  },
  {
    "id": 49762,
    "book": "proverbs                                ",
    "chapter": "23",
    "verse": "7",
    "text": "För som han tänker i hjärtat, sådan är han."
  },
  {
    "id": 49763,
    "book": "proverbs                                ",
    "chapter": "23",
    "verse": "8",
    "text": "Det lilla du ätit får du spy upp,"
  },
  {
    "id": 49764,
    "book": "proverbs                                ",
    "chapter": "23",
    "verse": "9",
    "text": "Bemöda dig inte att tala en dåre tillrätta"
  },
  {
    "id": 49765,
    "book": "proverbs                                ",
    "chapter": "23",
    "verse": "10",
    "text": "Flytta inte på gamla (forntida) tomtmarkeringar (gränslinjer)"
  },
  {
    "id": 49766,
    "book": "proverbs                                ",
    "chapter": "23",
    "verse": "11",
    "text": "Deras försvarare (återlösare) är mäktig;"
  },
  {
    "id": 49767,
    "book": "proverbs                                ",
    "chapter": "23",
    "verse": "12",
    "text": "Öppna ditt hjärta (sinne) för fostran,"
  },
  {
    "id": 49768,
    "book": "proverbs                                ",
    "chapter": "23",
    "verse": "13",
    "text": "Undanhåll inte tillrättavisning (korrigering, disciplinering) från ett barn;"
  },
  {
    "id": 49769,
    "book": "proverbs                                ",
    "chapter": "23",
    "verse": "14",
    "text": "Det är du som ska använda riset [låta olydnad få konsekvenser]"
  },
  {
    "id": 49770,
    "book": "proverbs                                ",
    "chapter": "23",
    "verse": "15",
    "text": "Mitt barn, om ditt hjärta (själ, sinne) fylls med vishet,"
  },
  {
    "id": 49771,
    "book": "proverbs                                ",
    "chapter": "23",
    "verse": "16",
    "text": "Mitt innersta kommer att spritta av glädje"
  },
  {
    "id": 49772,
    "book": "proverbs                                ",
    "chapter": "23",
    "verse": "17",
    "text": "Låt inte ditt hjärta avundas syndare,"
  },
  {
    "id": 49773,
    "book": "proverbs                                ",
    "chapter": "23",
    "verse": "18",
    "text": "Det finns en framtid [för dig],"
  },
  {
    "id": 49774,
    "book": "proverbs                                ",
    "chapter": "23",
    "verse": "19",
    "text": "Lyssna på mig kära barn, bli vis"
  },
  {
    "id": 49775,
    "book": "proverbs                                ",
    "chapter": "23",
    "verse": "20",
    "text": "Umgås inte (associera dig inte) med alkoholmissbrukare"
  },
  {
    "id": 49776,
    "book": "proverbs                                ",
    "chapter": "23",
    "verse": "21",
    "text": "Alkoholister och frossare blir fattiga,"
  },
  {
    "id": 49777,
    "book": "proverbs                                ",
    "chapter": "23",
    "verse": "22",
    "text": "Lyssna på din far, som fött dig (gett dig livet),"
  },
  {
    "id": 49778,
    "book": "proverbs                                ",
    "chapter": "23",
    "verse": "23",
    "text": "Införskaffa sanning och sälj den inte,"
  },
  {
    "id": 49779,
    "book": "proverbs                                ",
    "chapter": "23",
    "verse": "24",
    "text": "Den rättfärdiges far får fröjda sig [under dans och jubel]."
  },
  {
    "id": 49780,
    "book": "proverbs                                ",
    "chapter": "23",
    "verse": "25",
    "text": "Låt din far och mor få glädjas,"
  },
  {
    "id": 49781,
    "book": "proverbs                                ",
    "chapter": "23",
    "verse": "26",
    "text": "Mitt barn ge mig din fulla uppmärksamhet,"
  },
  {
    "id": 49782,
    "book": "proverbs                                ",
    "chapter": "23",
    "verse": "27",
    "text": "En prostituerad är som en djup grop,"
  },
  {
    "id": 49783,
    "book": "proverbs                                ",
    "chapter": "23",
    "verse": "28",
    "text": "Hon ligger på lur för att fånga sitt byte,"
  },
  {
    "id": 49784,
    "book": "proverbs                                ",
    "chapter": "23",
    "verse": "29",
    "text": "Vem har jämmer (olycka, elände)?"
  },
  {
    "id": 49785,
    "book": "proverbs                                ",
    "chapter": "23",
    "verse": "30",
    "text": "Jo, det är de som sitter länge vid vinet,"
  },
  {
    "id": 49786,
    "book": "proverbs                                ",
    "chapter": "23",
    "verse": "31",
    "text": "Titta inte på vinet när det är rött,"
  },
  {
    "id": 49787,
    "book": "proverbs                                ",
    "chapter": "23",
    "verse": "32",
    "text": "Till sist biter det som en orm,"
  },
  {
    "id": 49788,
    "book": "proverbs                                ",
    "chapter": "23",
    "verse": "33",
    "text": "Du börjar se konstiga saker [under alkoholens inverkan]"
  },
  {
    "id": 49789,
    "book": "proverbs                                ",
    "chapter": "23",
    "verse": "34",
    "text": "Ja, du blir [lika ostadig] som en som flyter på havet"
  },
  {
    "id": 49790,
    "book": "proverbs                                ",
    "chapter": "23",
    "verse": "35",
    "text": "Du säger: ”De slog mig, men jag blev inte skadad,"
  }
]