[
  {
    "id": 49145,
    "book": "proverbs                                ",
    "chapter": "2",
    "verse": "1",
    "text": "Min son (barn, vän):"
  },
  {
    "id": 49146,
    "book": "proverbs                                ",
    "chapter": "2",
    "verse": "2",
    "text": "genom att aktivt (uppmärksamt) lyssna till visheten"
  },
  {
    "id": 49147,
    "book": "proverbs                                ",
    "chapter": "2",
    "verse": "3",
    "text": "om du ropar efter förståelse (urskillningsförmåga)"
  },
  {
    "id": 49148,
    "book": "proverbs                                ",
    "chapter": "2",
    "verse": "4",
    "text": "om du söker efter den som efter silver"
  },
  {
    "id": 49149,
    "book": "proverbs                                ",
    "chapter": "2",
    "verse": "5",
    "text": "då kommer du att förstå vad det är att frukta (vörda, respektera) Herren (Jahve),"
  },
  {
    "id": 49150,
    "book": "proverbs                                ",
    "chapter": "2",
    "verse": "6",
    "text": "För Herren (Jahve) ger vishet,"
  },
  {
    "id": 49151,
    "book": "proverbs                                ",
    "chapter": "2",
    "verse": "7",
    "text": "Han bygger upp ett förråd av sund visdom (till framgång) för de rättfärdiga,"
  },
  {
    "id": 49152,
    "book": "proverbs                                ",
    "chapter": "2",
    "verse": "8",
    "text": "för han beskyddar de rättfärdigas stigar,"
  },
  {
    "id": 49153,
    "book": "proverbs                                ",
    "chapter": "2",
    "verse": "9",
    "text": "Då ska du förstå rättfärdighet (hur man kan följa Guds standard),"
  },
  {
    "id": 49154,
    "book": "proverbs                                ",
    "chapter": "2",
    "verse": "10",
    "text": "För visheten ska komma in i (fylla) ditt hjärta,"
  },
  {
    "id": 49155,
    "book": "proverbs                                ",
    "chapter": "2",
    "verse": "11",
    "text": "Omdöme (eftertänksamhet) ska vaka över dig,"
  },
  {
    "id": 49156,
    "book": "proverbs                                ",
    "chapter": "2",
    "verse": "12",
    "text": "[Visheten räddar från två stora frestelser för en ung man, lättförtjänta oärliga pengar och lösaktiga förhållanden med kvinnor.]"
  },
  {
    "id": 49157,
    "book": "proverbs                                ",
    "chapter": "2",
    "verse": "13",
    "text": "som överger de rätta stigarna (välkända, upptrampade gångvägarna)"
  },
  {
    "id": 49158,
    "book": "proverbs                                ",
    "chapter": "2",
    "verse": "14",
    "text": "som finner nöje i att vara onda,"
  },
  {
    "id": 49159,
    "book": "proverbs                                ",
    "chapter": "2",
    "verse": "15",
    "text": "vars stigar (välkända upptrampade gångvägar) är krokiga"
  },
  {
    "id": 49160,
    "book": "proverbs                                ",
    "chapter": "2",
    "verse": "16",
    "text": "De [vishet, kunskap och omdöme] ska rädda (rycka bort) dig [från onda kvinnor]"
  },
  {
    "id": 49161,
    "book": "proverbs                                ",
    "chapter": "2",
    "verse": "17",
    "text": "hon har lämnat sin man som varit med henne sedan ungdomen,"
  },
  {
    "id": 49162,
    "book": "proverbs                                ",
    "chapter": "2",
    "verse": "18",
    "text": "Hennes hus (familj) sjunker ner till döden,"
  },
  {
    "id": 49163,
    "book": "proverbs                                ",
    "chapter": "2",
    "verse": "19",
    "text": "Ingen som går in till henne kommer tillbaka (hittar tillbaka),"
  },
  {
    "id": 49164,
    "book": "proverbs                                ",
    "chapter": "2",
    "verse": "20",
    "text": "Därför ska du vandra på de moraliskt goda människornas väg,"
  },
  {
    "id": 49165,
    "book": "proverbs                                ",
    "chapter": "2",
    "verse": "21",
    "text": "För de rättfärdiga ska bo i landet"
  },
  {
    "id": 49166,
    "book": "proverbs                                ",
    "chapter": "2",
    "verse": "22",
    "text": "Däremot ska de ogudaktiga (moraliskt fördärvade) tas bort ifrån landet,"
  }
]