    "book": "proverbs                                ",
    "chapter": "26",
    "verse": "3",
    "text": "Piskan för hästen, betslet för åsnan"
  },
  {
    "id": 49856,
    "book": "proverbs                                ",
    "chapter": "26",
    "verse": "4",
    "text": "Svara inte en [självgod, arrogant] dåre på hans dåraktiga sätt,"
  },
  {
    "id": 49857,
    "book": "proverbs                                ",
    "chapter": "26",
    "verse": "5",
    "text": "Svara en [självgod, arrogant] dåre på hans dåraktiga sätt,"
  },
  {
    "id": 49858,
    "book": "proverbs                                ",
    "chapter": "26",
    "verse": "6",
    "text": "Att sända ett bud med en dåre"
  },
  {
    "id": 49859,
    "book": "proverbs                                ",
    "chapter": "26",
    "verse": "7",
    "text": "Som benen på den lame hänger kraftlösa,"
  },
  {
    "id": 49860,
    "book": "proverbs                                ",
    "chapter": "26",
    "verse": "8",
    "text": "Som att binda fast en sten i en slunga [lika fel och oanvändbart],"
  },
  {
    "id": 49861,
    "book": "proverbs                                ",
    "chapter": "26",
    "verse": "9",
    "text": "Som en törntagg går in i en drucken mans hand,"
  },
  {
    "id": 49862,
    "book": "proverbs                                ",
    "chapter": "26",
    "verse": "10",
    "text": "Som en bågskytt snurrar runt [skjuter vilt omkring sig] och skadar alla,"
  },
  {
    "id": 49863,
    "book": "proverbs                                ",
    "chapter": "26",
    "verse": "11",
    "text": "Som hunden vänder tillbaka till sin spya,"
  },
  {
    "id": 49864,
    "book": "proverbs                                ",
    "chapter": "26",
    "verse": "12",
    "text": "Ser du en man som tror att han är vis"
  },
  {
    "id": 49865,
    "book": "proverbs                                ",
    "chapter": "26",
    "verse": "13",
    "text": "Den late säger: ”Det är ett lejon på vägen!"
  },
  {
    "id": 49866,
    "book": "proverbs                                ",
    "chapter": "26",
    "verse": "14",
    "text": "Som dörren svänger på gångjärnen,"
  },
  {
    "id": 49867,
    "book": "proverbs                                ",
    "chapter": "26",
    "verse": "15",
    "text": "Den late sätter handen i maten,"
  },
  {
    "id": 49868,
    "book": "proverbs                                ",
    "chapter": "26",
    "verse": "16",
    "text": "En lat man anser sig vara visare i sina egna ögon"
  },
  {
    "id": 49869,
    "book": "proverbs                                ",
    "chapter": "26",
    "verse": "17",
    "text": "Den som stannar upp för att lägga sig i andras angelägenheter"
  },
  {
    "id": 49870,
    "book": "proverbs                                ",
    "chapter": "26",
    "verse": "18",
    "text": "Som en galning (vettvilling) som skjuter (slänger, kastar)"
  },
  {
    "id": 49871,
    "book": "proverbs                                ",
    "chapter": "26",
    "verse": "19",
    "text": "så är en man som lurar sin granne"
  },
  {
    "id": 49872,
    "book": "proverbs                                ",
    "chapter": "26",
    "verse": "20",
    "text": "Utan ved slocknar elden,"
  },
  {
    "id": 49873,
    "book": "proverbs                                ",
    "chapter": "26",
    "verse": "21",
    "text": "Som [mer] kol på glödande kol, och [mer] trä till en brinnande eld,"
  },
  {
    "id": 49874,
    "book": "proverbs                                ",
    "chapter": "26",
    "verse": "22",
    "text": "Orden från en skvallrare (ryktesspridare) är som läckerbitar som slukas glupskt (med hast),"
  },
  {
    "id": 49875,
    "book": "proverbs                                ",
    "chapter": "26",
    "verse": "23",
    "text": "Som glasyr över ett lerkärl är brinnande läppar [som uttalar varma kärleksfulla ord]"
  },
  {
    "id": 49876,
    "book": "proverbs                                ",
    "chapter": "26",
    "verse": "24",
    "text": "Den som hatar förställer sitt tal [för att smickra],"
  },
  {
    "id": 49877,
    "book": "proverbs                                ",
    "chapter": "26",
    "verse": "25",
    "text": "När han talar älskvärt (ljuvligt, inställsamt),"
  },
  {
    "id": 49878,
    "book": "proverbs                                ",
    "chapter": "26",
    "verse": "26",
    "text": "Hans hat kanske kan döljas genom list,"
  },
  {
    "id": 49879,
    "book": "proverbs                                ",
    "chapter": "26",
    "verse": "27",
    "text": "Den som gräver en grop [för en annan människa] faller själv i den,"
  },
  {
    "id": 49880,
    "book": "proverbs                                ",
    "chapter": "26",
    "verse": "28",
    "text": "En ljugande (falsk) tunga hatar sina offer,"
  }
]