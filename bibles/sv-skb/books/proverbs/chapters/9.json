[
  {
    "id": 49350,
    "book": "proverbs                                ",
    "chapter": "9",
    "verse": "1",
    "text": "Visheten har byggt sig ett hus,"
  },
  {
    "id": 49351,
    "book": "proverbs                                ",
    "chapter": "9",
    "verse": "2",
    "text": "Hon har förberett maten (slaktat boskap),"
  },
  {
    "id": 49352,
    "book": "proverbs                                ",
    "chapter": "9",
    "verse": "3",
    "text": "Hon har skickat ut sina unga tjänsteflickor [för att bjuda in till fest],"
  },
  {
    "id": 49353,
    "book": "proverbs                                ",
    "chapter": "9",
    "verse": "4",
    "text": "”Den som är okunnig (osäker), kom hit!”"
  },
  {
    "id": 49354,
    "book": "proverbs                                ",
    "chapter": "9",
    "verse": "5",
    "text": "”Kom och ät av mitt bröd!"
  },
  {
    "id": 49355,
    "book": "proverbs                                ",
    "chapter": "9",
    "verse": "6",
    "text": "Lämna oförståndet och lev! [Kan översättas ”lämna dåligt sällskap” eller ”var inte naiv, och låt dig inte bli förledd”.]"
  },
  {
    "id": 49356,
    "book": "proverbs                                ",
    "chapter": "9",
    "verse": "7",
    "text": "Den som korrigerar en hädare (bespottare, en människa full av förakt) blir bara förolämpad (kränkt),"
  },
  {
    "id": 49357,
    "book": "proverbs                                ",
    "chapter": "9",
    "verse": "8",
    "text": "Om du tillrättavisar en hädare, kommer han att hata dig."
  },
  {
    "id": 49358,
    "book": "proverbs                                ",
    "chapter": "9",
    "verse": "9",
    "text": "Ge [undervisning] till en vis man och han växer i vishet."
  },
  {
    "id": 49359,
    "book": "proverbs                                ",
    "chapter": "9",
    "verse": "10",
    "text": "Början till (startpunkten; en grundförutsättning för) vishet är fruktan (vördnadsfull respekt) för Herren (Jahve)"
  },
  {
    "id": 49360,
    "book": "proverbs                                ",
    "chapter": "9",
    "verse": "11",
    "text": "För genom mig [visheten från Gud] förökas (multipliceras) dina dagar,"
  },
  {
    "id": 49361,
    "book": "proverbs                                ",
    "chapter": "9",
    "verse": "12",
    "text": "Om du är vis, hjälper visheten dig,"
  },
  {
    "id": 49362,
    "book": "proverbs                                ",
    "chapter": "9",
    "verse": "13",
    "text": "Det finns en annan kvinna som kallas dårskapen, hon är rastlös (bullrig, stökig),"
  },
  {
    "id": 49363,
    "book": "proverbs                                ",
    "chapter": "9",
    "verse": "14",
    "text": "Hon sitter vid ingången till sitt hus,"
  },
  {
    "id": 49364,
    "book": "proverbs                                ",
    "chapter": "9",
    "verse": "15",
    "text": "och ropar till dem som passerar,"
  },
  {
    "id": 49365,
    "book": "proverbs                                ",
    "chapter": "9",
    "verse": "16",
    "text": "”Den som är okunnig (lättledd, osäker), kom hit!”"
  },
  {
    "id": 49366,
    "book": "proverbs                                ",
    "chapter": "9",
    "verse": "17",
    "text": "”Stulet vatten [sex utanför äktenskapet] är sött (ger tillfredsställelse)"
  },
  {
    "id": 49367,
    "book": "proverbs                                ",
    "chapter": "9",
    "verse": "18",
    "text": "Han [som följer hennes råd] inser inte att de döda är där,"
  }
