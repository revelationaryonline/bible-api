[
  {
    "id": 49791,
    "book": "proverbs                                ",
    "chapter": "24",
    "verse": "1",
    "text": "Var inte avundsjuk på onda människor,"
  },
  {
    "id": 49792,
    "book": "proverbs                                ",
    "chapter": "24",
    "verse": "2",
    "text": "Deras hjärtan överväger [hebr. hagah – talar i låg ton; dvs. planerar] ont (våldshandlingar),"
  },
  {
    "id": 49793,
    "book": "proverbs                                ",
    "chapter": "24",
    "verse": "3",
    "text": "Det krävs skicklighet och vishet för att bygga ett hus (hem, en familj),"
  },
  {
    "id": 49794,
    "book": "proverbs                                ",
    "chapter": "24",
    "verse": "4",
    "text": "Genom kunskap (vishet, urskillningsförmåga) möbleras varje rum"
  },
  {
    "id": 49795,
    "book": "proverbs                                ",
    "chapter": "24",
    "verse": "5",
    "text": "En vis man (stridsman) [en man i sin bästa ålder] är stark,"
  },
  {
    "id": 49796,
    "book": "proverbs                                ",
    "chapter": "24",
    "verse": "6",
    "text": "Utan visa råd (utan en plan och en strategi) kan du inte föra krig,"
  },
  {
    "id": 49797,
    "book": "proverbs                                ",
    "chapter": "24",
    "verse": "7",
    "text": "Vishet är ouppnåelig för en dåre,"
  },
  {
    "id": 49798,
    "book": "proverbs                                ",
    "chapter": "24",
    "verse": "8",
    "text": "En som tänker ut onda planer"
  },
  {
    "id": 49799,
    "book": "proverbs                                ",
    "chapter": "24",
    "verse": "9",
    "text": "Att smida onda planer (planera dårskap) är synd,"
  },
  {
    "id": 49800,
    "book": "proverbs                                ",
    "chapter": "24",
    "verse": "10",
    "text": "Om du förlorar modet (blir tyst, drar dig tillbaka) på nödens dag [då du blir trängd och möter svårigheter]"
  },
  {
    "id": 49801,
    "book": "proverbs                                ",
    "chapter": "24",
    "verse": "11",
    "text": "Rädda (ryck bort) dem som släpas i väg mot döden,"
  },
  {
    "id": 49802,
    "book": "proverbs                                ",
    "chapter": "24",
    "verse": "12",
    "text": "Säg inte: ”Se, vi visste ingenting.”"
  },
  {
    "id": 49803,
    "book": "proverbs                                ",
    "chapter": "24",
    "verse": "13",
    "text": "Min son, ät honung, för det är gott,"
  },
  {
    "id": 49804,
    "book": "proverbs                                ",
    "chapter": "24",
    "verse": "14",
    "text": "På samma sätt ska du veta att vishet är ljuvligt för din själ (ditt liv),"
  },
  {
    "id": 49805,
    "book": "proverbs                                ",
    "chapter": "24",
    "verse": "15",
    "text": "Ligg inte på lur vid den rättfärdiges hem, som den ogudaktige gör."
  },
  {
    "id": 49806,
    "book": "proverbs                                ",
    "chapter": "24",
    "verse": "16",
    "text": "För även om en rättfärdig man skulle falla sju gånger (skulle stöta på många problem och motgångar),"
  },
  {
    "id": 49807,
    "book": "proverbs                                ",
    "chapter": "24",
    "verse": "17",
    "text": "Gläd dig inte när din fiende faller,"
  },
  {
    "id": 49808,
    "book": "proverbs                                ",
    "chapter": "24",
    "verse": "18",
    "text": "Herren (Jahve) ser vad du gör och det är ont i hans ögon (det orsakar sorg och smärta hos honom),"
  },
  {
    "id": 49809,
    "book": "proverbs                                ",
    "chapter": "24",
    "verse": "19",
    "text": "Irritera (reta, gräm) dig inte på ondskefulla människor,"
  },
  {
    "id": 49810,
    "book": "proverbs                                ",
    "chapter": "24",
    "verse": "20",
    "text": "För de som är onda har ingen framtid,"
  },
  {
    "id": 49811,
    "book": "proverbs                                ",
    "chapter": "24",
    "verse": "21",
    "text": "Min son (barn), frukta Herren (Jahve) och kungen,"
  },
  {
    "id": 49812,
    "book": "proverbs                                ",
    "chapter": "24",
    "verse": "22",
    "text": "För deras undergång kommer plötsligt,"
  },
  {
    "id": 49813,
    "book": "proverbs                                ",
    "chapter": "24",
    "verse": "23",
    "text": "Detta är också de visas ord:"
  },
  {
    "id": 49814,
    "book": "proverbs                                ",
    "chapter": "24",
    "verse": "24",
    "text": "Den som säger till den skyldige: ”Du är oskyldig,”"
  },
  {
    "id": 49815,
    "book": "proverbs                                ",
    "chapter": "24",
    "verse": "25",
    "text": "Men för de [rättfärdiga domare] som går tillrätta med de ogudaktiga går det väl,"
  },
  {
    "id": 49816,
    "book": "proverbs                                ",
    "chapter": "24",
    "verse": "26",
    "text": "Som en kyss på läpparna [lika önskvärd],"
  },
  {
    "id": 49817,
    "book": "proverbs                                ",
    "chapter": "24",
    "verse": "27",
    "text": "Ordna först allt där ute, förbered marken [plöj och så],"
  },
  {
    "id": 49818,
    "book": "proverbs                                ",
    "chapter": "24",
    "verse": "28",
    "text": "Vittna inte mot din nästa (granne) utan orsak,"
  },
  {
    "id": 49819,
    "book": "proverbs                                ",
    "chapter": "24",
    "verse": "29",
    "text": "Säg inte: ”Jag ska ge igen för vad han gjort mot mig,"
  },
  {
    "id": 49820,
    "book": "proverbs                                ",
    "chapter": "24",
    "verse": "30",
    "text": "Jag gick förbi en lat mans åker,"
  },
  {
    "id": 49821,
    "book": "proverbs                                ",
    "chapter": "24",
    "verse": "31",
    "text": "Den var överväxt med tistlar, och markytan var täckt av nässlor (ogräs),"
  },
  {
    "id": 49822,
    "book": "proverbs                                ",
    "chapter": "24",
    "verse": "32",
    "text": "Jag betraktade och tänkte noga på vad jag såg,"
  },
  {
    "id": 49823,
    "book": "proverbs                                ",
    "chapter": "24",
    "verse": "33",
    "text": "”Lite mer sömn, en liten tupplur,"
  },
  {
    "id": 49824,
    "book": "proverbs                                ",
    "chapter": "24",
    "verse": "34",
    "text": "och fattigdomen kommer marscherande till dig,"
  }
]