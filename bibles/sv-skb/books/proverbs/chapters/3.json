[
  {
    "id": 49167,
    "book": "proverbs                                ",
    "chapter": "3",
    "verse": "1",
    "text": "Min son (mitt barn, min vän),"
  },
  {
    "id": 49168,
    "book": "proverbs                                ",
    "chapter": "3",
    "verse": "2",
    "text": "för hög ålder (dagars längd)"
  },
  {
    "id": 49169,
    "book": "proverbs                                ",
    "chapter": "3",
    "verse": "3",
    "text": "Låt aldrig nåd (kärleksfull omsorg) och sanning (stabilitet, fasthet, trofasthet) lämna dig –"
  },
  {
    "id": 49170,
    "book": "proverbs                                ",
    "chapter": "3",
    "verse": "4",
    "text": "så får (finner, förvärvar, uppnår) du nåd (favör) och gott förstånd (anseende)"
  },
  {
    "id": 49171,
    "book": "proverbs                                ",
    "chapter": "3",
    "verse": "5",
    "text": "Förtrösta på (luta dig mot; lita på) Herren (Jahve) av hela ditt hjärta,"
  },
  {
    "id": 49172,
    "book": "proverbs                                ",
    "chapter": "3",
    "verse": "6",
    "text": "På alla dina vägar [på din färd genom livet]"
  },
  {
    "id": 49173,
    "book": "proverbs                                ",
    "chapter": "3",
    "verse": "7",
    "text": "Var inte vis i dina egna ögon;"
  },
  {
    "id": 49174,
    "book": "proverbs                                ",
    "chapter": "3",
    "verse": "8",
    "text": "Det kommer att ge hälsa åt din kropp"
  },
  {
    "id": 49175,
    "book": "proverbs                                ",
    "chapter": "3",
    "verse": "9",
    "text": "Ära Herren (Jahve) med allt du äger,"
  },
  {
    "id": 49176,
    "book": "proverbs                                ",
    "chapter": "3",
    "verse": "10",
    "text": "Då kommer dina lador att fyllas i överflöd (till brädden)"
  },
  {
    "id": 49177,
    "book": "proverbs                                ",
    "chapter": "3",
    "verse": "11",
    "text": "Min son (mitt barn, min vän),"
  },
  {
    "id": 49178,
    "book": "proverbs                                ",
    "chapter": "3",
    "verse": "12",
    "text": "För den Herren (Jahve) älskar (hyser ömhet för; visar tillgivenhet; håller av)"
  },
  {
    "id": 49179,
    "book": "proverbs                                ",
    "chapter": "3",
    "verse": "13",
    "text": "Lycklig (välsignad, glad, avundsvärd) är den människa som hittar visheten,"
  },
  {
    "id": 49180,
    "book": "proverbs                                ",
    "chapter": "3",
    "verse": "14",
    "text": "För värdet av att känna henne är högre än värdet av silver,"
  },
  {
    "id": 49181,
    "book": "proverbs                                ",
    "chapter": "3",
    "verse": "15",
    "text": "Hon är mer värdefull än rubiner,"
  },
  {
    "id": 49182,
    "book": "proverbs                                ",
    "chapter": "3",
    "verse": "16",
    "text": "I högra handen har hon långt liv (längd av dagar)"
  },
  {
    "id": 49183,
    "book": "proverbs                                ",
    "chapter": "3",
    "verse": "17",
    "text": "Hennes vägar är ljuvliga (nåderika, behagliga, angenäma),"
  },
  {
    "id": 49184,
    "book": "proverbs                                ",
    "chapter": "3",
    "verse": "18",
    "text": "Hon är ett livets träd [ger livskraft och ett rikt liv] för dem som får tag i (greppar, tar ett stadigt tag om) henne,"
  },
  {
    "id": 49185,
    "book": "proverbs                                ",
    "chapter": "3",
    "verse": "19",
    "text": "Genom vishet har Herren (Jahve) lagt jordens grund,"
  },
  {
    "id": 49186,
    "book": "proverbs                                ",
    "chapter": "3",
    "verse": "20",
    "text": "Hans kunskap fick djupen (vattenkällorna) att öppna sig"
  },
  {
    "id": 49187,
    "book": "proverbs                                ",
    "chapter": "3",
    "verse": "21",
    "text": "Min son (mitt barn, min vän), skydda (vakta) sunt förnuft och ett gott omdöme (urskillningsförmåga),"
  },
  {
    "id": 49188,
    "book": "proverbs                                ",
    "chapter": "3",
    "verse": "22",
    "text": "De ska ge liv till din inre människa,"
  },
  {
    "id": 49189,
    "book": "proverbs                                ",
    "chapter": "3",
    "verse": "23",
    "text": "Då ska du vandra säkert på din väg"
  },
  {
    "id": 49190,
    "book": "proverbs                                ",
    "chapter": "3",
    "verse": "24",
    "text": "När du lägger dig ska du inte vara rädd,"
  },
  {
    "id": 49191,
    "book": "proverbs                                ",
    "chapter": "3",
    "verse": "25",
    "text": "Var inte rädd för plötslig (oväntad) terror (panik, skräck, alarmerande rapporter),"
  },
  {
    "id": 49192,
    "book": "proverbs                                ",
    "chapter": "3",
    "verse": "26",
    "text": "För Herren (Jahve) är din förtröstan (tillit, säkra hopp),"
  },
  {
    "id": 49193,
    "book": "proverbs                                ",
    "chapter": "3",
    "verse": "27",
    "text": "Undanhåll inte gott (glädje, välgång, framgång)"
  },
  {
    "id": 49194,
    "book": "proverbs                                ",
    "chapter": "3",
    "verse": "28",
    "text": "Säg inte till din granne:"
  },
  {
    "id": 49195,
    "book": "proverbs                                ",
    "chapter": "3",
    "verse": "29",
    "text": "Planera inte (hitta inte på, gräv inte efter) ondska mot din granne,"
  },
  {
    "id": 49196,
    "book": "proverbs                                ",
    "chapter": "3",
    "verse": "30",
    "text": "Bråka (tvista) inte med någon utan orsak,"
  },
  {
    "id": 49197,
    "book": "proverbs                                ",
    "chapter": "3",
    "verse": "31",
    "text": "Avundas inte en våldsam man (en grym förtryckare)"
  },
  {
    "id": 49198,
    "book": "proverbs                                ",
    "chapter": "3",
    "verse": "32",
    "text": "För den som avvikit från den rätta vägen (handlar mot Guds moral)"
  },
  {
    "id": 49199,
    "book": "proverbs                                ",
    "chapter": "3",
    "verse": "33",
    "text": "Herrens (Jahves) förbannelse är över den gudlöses (kriminelle, syndarens) hus (familj),"
  },
  {
    "id": 49200,
    "book": "proverbs                                ",
    "chapter": "3",
    "verse": "34",
    "text": "Han hånar (föraktar) de som ständigt är hånfulla"
  },
  {
    "id": 49201,
    "book": "proverbs                                ",
    "chapter": "3",
    "verse": "35",
    "text": "De visa får ta emot ära som arv"
  }
]