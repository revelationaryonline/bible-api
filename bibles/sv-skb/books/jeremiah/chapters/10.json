[
  {
    "id": 30920,
    "book": "jeremiah                                ",
    "chapter": "10",
    "verse": "1",
    "text": "Hör ordet som Herren (Jahve) talar till er Israels hus."
  },
  {
    "id": 30921,
    "book": "jeremiah                                ",
    "chapter": "10",
    "verse": "2",
    "text": "Så säger Herren (Jahve):"
  },
  {
    "id": 30922,
    "book": "jeremiah                                ",
    "chapter": "10",
    "verse": "3",
    "text": "För folkslagens sedvänjor är fåfänglighet,"
  },
  {
    "id": 30923,
    "book": "jeremiah                                ",
    "chapter": "10",
    "verse": "4",
    "text": "De täcker det med silver och med guld"
  },
  {
    "id": 30924,
    "book": "jeremiah                                ",
    "chapter": "10",
    "verse": "5",
    "text": "De är som pelare i gurklandet (grönsakslandet)"
  },
  {
    "id": 30925,
    "book": "jeremiah                                ",
    "chapter": "10",
    "verse": "6",
    "text": "Det finns ingen, nej ingen enda som (bortom allt annat är) du Herre (Jahve),"
  },
  {
    "id": 30926,
    "book": "jeremiah                                ",
    "chapter": "10",
    "verse": "7",
    "text": "Vem skulle inte frukta dig,"
  },
  {
    "id": 30927,
    "book": "jeremiah                                ",
    "chapter": "10",
    "verse": "8",
    "text": "Men den är rå (brutal) och dåraktig,"
  },
  {
    "id": 30928,
    "book": "jeremiah                                ",
    "chapter": "10",
    "verse": "9",
    "text": "Silver uthamrat till fat som hämtats från Tarshish"
  },
  {
    "id": 30929,
    "book": "jeremiah                                ",
    "chapter": "10",
    "verse": "10",
    "text": "Men Herren Gud (Jahve Elohim) är sann,"
  },
  {
    "id": 30930,
    "book": "jeremiah                                ",
    "chapter": "10",
    "verse": "11",
    "text": "[Här skiftar språket till arameiska.] Så ska ni säga dem:"
  },
  {
    "id": 30931,
    "book": "jeremiah                                ",
    "chapter": "10",
    "verse": "12",
    "text": "Han som har gjort jorden med sin styrka och makt,"
  },
  {
    "id": 30932,
    "book": "jeremiah                                ",
    "chapter": "10",
    "verse": "13",
    "text": "Till rösten av hans utgivande, ljudet (bruset av mäktiga) vatten i himlarna,"
  },
  {
    "id": 30933,
    "book": "jeremiah                                ",
    "chapter": "10",
    "verse": "14",
    "text": "Alla människor är bevisats brutala för sin kunskap (kännedom),"
  },
  {
    "id": 30934,
    "book": "jeremiah                                ",
    "chapter": "10",
    "verse": "15",
    "text": "De är fåfänglighet, ett inbillat arbete,"
  },
  {
    "id": 30935,
    "book": "jeremiah                                ",
    "chapter": "10",
    "verse": "16",
    "text": "Jakobs del är inte som dessa,"
  },
  {
    "id": 30936,
    "book": "jeremiah                                ",
    "chapter": "10",
    "verse": "17",
    "text": "Samla upp ditt gods från marken"
  },
  {
    "id": 30937,
    "book": "jeremiah                                ",
    "chapter": "10",
    "verse": "18",
    "text": "Eftersom Herren (Jahve) säger så:"
  },
  {
    "id": 30938,
    "book": "jeremiah                                ",
    "chapter": "10",
    "verse": "19",
    "text": "Ve till mig över min smärta!"
  },
  {
    "id": 30939,
    "book": "jeremiah                                ",
    "chapter": "10",
    "verse": "20",
    "text": "Mitt tält är fördärvat"
  },
  {
    "id": 30940,
    "book": "jeremiah                                ",
    "chapter": "10",
    "verse": "21",
    "text": "Eftersom herdarna har blivit råa (brutala)"
  },
  {
    "id": 30941,
    "book": "jeremiah                                ",
    "chapter": "10",
    "verse": "22",
    "text": "En röst, lyssna! Se, det kommer"
  },
  {
    "id": 30942,
    "book": "jeremiah                                ",
    "chapter": "10",
    "verse": "23",
    "text": "Herre (Jahve) jag vet (känner väl till) att människans vägar inte är hans egna,"
  },
  {
    "id": 30943,
    "book": "jeremiah                                ",
    "chapter": "10",
    "verse": "24",
    "text": "Herre (Jahve) tillrättavisa mig, i rättvisa –"
  },
  {
    "id": 30944,
    "book": "jeremiah                                ",
    "chapter": "10",
    "verse": "25",
    "text": "Häll ut din vrede över folkslagen"
  }
]