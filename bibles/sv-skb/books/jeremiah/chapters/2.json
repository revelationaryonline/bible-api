[
  {
    "id": 30684,
    "book": "jeremiah                                ",
    "chapter": "2",
    "verse": "1",
    "text": "Herrens (Jahves) ord kom till mig. Han sade:"
  },
  {
    "id": 30685,
    "book": "jeremiah                                ",
    "chapter": "2",
    "verse": "2",
    "text": "Gå och ropa i öronen på Jerusalem [dualformen för öra används, dvs ”ropa i båda öronen”; uttrycket förstärker att Jeremia ska tala så Jerusalems invånare verkligen hör och förstår allvaret i budskapet; men har även en underton att tala för döva öron] och säg:"
  },
  {
    "id": 30686,
    "book": "jeremiah                                ",
    "chapter": "2",
    "verse": "3",
    "text": "Israel är Herrens (Jahves) helgade (avskilda) del,"
  },
  {
    "id": 30687,
    "book": "jeremiah                                ",
    "chapter": "2",
    "verse": "4",
    "text": "Hör Herrens (Jahves) ord Jakobs hus"
  },
  {
    "id": 30688,
    "book": "jeremiah                                ",
    "chapter": "2",
    "verse": "5",
    "text": "Så säger Herren (Jahve):"
  },
  {
    "id": 30689,
    "book": "jeremiah                                ",
    "chapter": "2",
    "verse": "6",
    "text": "De frågar inte: ”Var är Herren (Jahve)"
  },
  {
    "id": 30690,
    "book": "jeremiah                                ",
    "chapter": "2",
    "verse": "7",
    "text": "Och jag förde er till ett land med fruktsamma fält"
  },
  {
    "id": 30691,
    "book": "jeremiah                                ",
    "chapter": "2",
    "verse": "8",
    "text": "Prästerna frågade inte:"
  },
  {
    "id": 30692,
    "book": "jeremiah                                ",
    "chapter": "2",
    "verse": "9",
    "text": "Varför ska jag fortfarande försvara er"
  },
  {
    "id": 30693,
    "book": "jeremiah                                ",
    "chapter": "2",
    "verse": "10",
    "text": "Gå [väst] över till ketiternas öar [Cypern] och se [fråga om detta har hänt],"
  },
  {
    "id": 30694,
    "book": "jeremiah                                ",
    "chapter": "2",
    "verse": "11",
    "text": "Har ett land [någonsin] bytt ut sina gudar?"
  },
  {
    "id": 30695,
    "book": "jeremiah                                ",
    "chapter": "2",
    "verse": "12",
    "text": "Förundras ni himlar vid detta,"
  },
  {
    "id": 30696,
    "book": "jeremiah                                ",
    "chapter": "2",
    "verse": "13",
    "text": "För mitt folk har begått en dubbel synd (två ondheter),"
  },
  {
    "id": 30697,
    "book": "jeremiah                                ",
    "chapter": "2",
    "verse": "14",
    "text": "Är Israel en tjänare?"
  },
  {
    "id": 30698,
    "book": "jeremiah                                ",
    "chapter": "2",
    "verse": "15",
    "text": "De unga lejonen har rutit över honom"
  },
  {
    "id": 30699,
    "book": "jeremiah                                ",
    "chapter": "2",
    "verse": "16",
    "text": "Även Nofs söner [folket i Memfis i Egypten] och Tachpanches"
  },
  {
    "id": 30700,
    "book": "jeremiah                                ",
    "chapter": "2",
    "verse": "17",
    "text": "Är det inte detta som har orsakat dig detta,"
  },
  {
    "id": 30701,
    "book": "jeremiah                                ",
    "chapter": "2",
    "verse": "18",
    "text": "Och vad har du nu att göra på vägen till Egypten,"
  },
  {
    "id": 30702,
    "book": "jeremiah                                ",
    "chapter": "2",
    "verse": "19",
    "text": "Din egen ondska ska tillrättavisa (straffa) dig,"
  },
  {
    "id": 30703,
    "book": "jeremiah                                ",
    "chapter": "2",
    "verse": "20",
    "text": "För sedan evig tid har jag brutit ditt ok"
  },
  {
    "id": 30704,
    "book": "jeremiah                                ",
    "chapter": "2",
    "verse": "21",
    "text": "Jag har planterat dig som ett ädelt vin,"
  },
  {
    "id": 30705,
    "book": "jeremiah                                ",
    "chapter": "2",
    "verse": "22",
    "text": "För fastän du tvättar dig med lut"
  },
  {
    "id": 30706,
    "book": "jeremiah                                ",
    "chapter": "2",
    "verse": "23",
    "text": "Hur kan du säga: ”Jag är inte orenad,"
  },
  {
    "id": 30707,
    "book": "jeremiah                                ",
    "chapter": "2",
    "verse": "24",
    "text": "en vild åsna van vid öknen,"
  },
  {
    "id": 30708,
    "book": "jeremiah                                ",
    "chapter": "2",
    "verse": "25",
    "text": "Håll din fot borta från att bli skadad"
  },
  {
    "id": 30709,
    "book": "jeremiah                                ",
    "chapter": "2",
    "verse": "26",
    "text": "Som tjuven skäms när han hittas (blir tagen på bar gärning)"
  },
  {
    "id": 30710,
    "book": "jeremiah                                ",
    "chapter": "2",
    "verse": "27",
    "text": "Vem säger till stocken: ”Du är min far,”"
  },
  {
    "id": 30711,
    "book": "jeremiah                                ",
    "chapter": "2",
    "verse": "28",
    "text": "Men var är dina gudar som du har gjort åt dig?"
  },
  {
    "id": 30712,
    "book": "jeremiah                                ",
    "chapter": "2",
    "verse": "29",
    "text": "Varför ska ni tävla (strida) med mig?"
  },
  {
    "id": 30713,
    "book": "jeremiah                                ",
    "chapter": "2",
    "verse": "30",
    "text": "Fåfängt har jag slagit era söner,"
  },
  {
    "id": 30714,
    "book": "jeremiah                                ",
    "chapter": "2",
    "verse": "31",
    "text": "Generation (detta släkte), se Herrens (Jahves) ord."
  },
  {
    "id": 30715,
    "book": "jeremiah                                ",
    "chapter": "2",
    "verse": "32",
    "text": "Kan en jungfru glömma sina smycken [sin utsmyckning, se Hes 16:11-12],"
  },
  {
    "id": 30716,
    "book": "jeremiah                                ",
    "chapter": "2",
    "verse": "33",
    "text": "Hur skicklig är du att hitta vägen (hur väl ordnar du din väg) för att söka kärlek!"
  },
  {
    "id": 30717,
    "book": "jeremiah                                ",
    "chapter": "2",
    "verse": "34",
    "text": "Även i dina kläder finner man blodet av oskyldiga fattiga själar,"
  },
  {
    "id": 30718,
    "book": "jeremiah                                ",
    "chapter": "2",
    "verse": "35",
    "text": "och du säger [ändå]:"
  },
  {
    "id": 30719,
    "book": "jeremiah                                ",
    "chapter": "2",
    "verse": "36",
    "text": "Hur mycket gör du dig billig [samma bildspråk som i vers 23]"
  },
  {
    "id": 30720,
    "book": "jeremiah                                ",
    "chapter": "2",
    "verse": "37",
    "text": "Från honom ska du gå fram"
  }
]