[
  {
    "id": 38588,
    "book": "lamentations                            ",
    "chapter": "3",
    "verse": "1",
    "text": "Jag är mannen som har sett lidande"
  },
  {
    "id": 38589,
    "book": "lamentations                            ",
    "chapter": "3",
    "verse": "2",
    "text": "Han har lett mig och fått mig att vandra"
  },
  {
    "id": 38590,
    "book": "lamentations                            ",
    "chapter": "3",
    "verse": "3",
    "text": "Ja (sannerligen) han vänder gång på gång"
  },
  {
    "id": 38591,
    "book": "lamentations                            ",
    "chapter": "3",
    "verse": "4",
    "text": "Mina muskler och min hud är utslitna,"
  },
  {
    "id": 38592,
    "book": "lamentations                            ",
    "chapter": "3",
    "verse": "5",
    "text": "Han har byggt mot mig (som belägringsvallar) och omringat mig"
  },
  {
    "id": 38593,
    "book": "lamentations                            ",
    "chapter": "3",
    "verse": "6",
    "text": "I mörkret har han låtit mig bo,"
  },
  {
    "id": 38594,
    "book": "lamentations                            ",
    "chapter": "3",
    "verse": "7",
    "text": "Han har vallat in (byggt en mur omkring) mig, så att jag inte kan gå någonstans,"
  },
  {
    "id": 38595,
    "book": "lamentations                            ",
    "chapter": "3",
    "verse": "8",
    "text": "Även när jag ropar på hjälp,"
  },
  {
    "id": 38596,
    "book": "lamentations                            ",
    "chapter": "3",
    "verse": "9",
    "text": "Han har stängt min väg med huggna stenar,"
  },
  {
    "id": 38597,
    "book": "lamentations                            ",
    "chapter": "3",
    "verse": "10",
    "text": "Han är för mig som en björn som ligger och väntar (på byte),"
  },
  {
    "id": 38598,
    "book": "lamentations                            ",
    "chapter": "3",
    "verse": "11",
    "text": "Han har böjt undan (vänt bort) mina vägar (tvingat mig av vägen) [Ps 146:9] och slitit mig i stycken;"
  },
  {
    "id": 38599,
    "book": "lamentations                            ",
    "chapter": "3",
    "verse": "12",
    "text": "Han har spänt sin båge"
  },
  {
    "id": 38600,
    "book": "lamentations                            ",
    "chapter": "3",
    "verse": "13",
    "text": "Han har låtit pilarna från sitt koger komma in"
  },
  {
    "id": 38601,
    "book": "lamentations                            ",
    "chapter": "3",
    "verse": "14",
    "text": "Jag har blivit till åtlöje för allt mitt folk,"
  },
  {
    "id": 38602,
    "book": "lamentations                            ",
    "chapter": "3",
    "verse": "15",
    "text": "Han har fyllt mig med bitterhet [bokstavligt ”han har tillfredsställt mig med bitterhet”],"
  },
  {
    "id": 38603,
    "book": "lamentations                            ",
    "chapter": "3",
    "verse": "16",
    "text": "Han har förstört (krossat) mina tänder med grus,"
  },
  {
    "id": 38604,
    "book": "lamentations                            ",
    "chapter": "3",
    "verse": "17",
    "text": "Min själ är avskuren från all frid"
  },
  {
    "id": 38605,
    "book": "lamentations                            ",
    "chapter": "3",
    "verse": "18",
    "text": "Och jag säger: Min styrka är förlorad"
  },
  {
    "id": 38606,
    "book": "lamentations                            ",
    "chapter": "3",
    "verse": "19",
    "text": "Kom ihåg mitt lidande, min ångest,"
  },
  {
    "id": 38607,
    "book": "lamentations                            ",
    "chapter": "3",
    "verse": "20",
    "text": "Jag (hela min varelse, min själ) har fortfarande detta i minnet"
  },
  {
    "id": 38608,
    "book": "lamentations                            ",
    "chapter": "3",
    "verse": "21",
    "text": "Detta påminner jag mitt hjärta om,"
  },
  {
    "id": 38609,
    "book": "lamentations                            ",
    "chapter": "3",
    "verse": "22",
    "text": "Herrens (Jahves) nåd (omsorgsfulla kärlek – hebr. chesed) är det"
  },
  {
    "id": 38610,
    "book": "lamentations                            ",
    "chapter": "3",
    "verse": "23",
    "text": "Nya är de [plural – nåden/kärleken och barmhärtigheten] varje morgon,"
  },
  {
    "id": 38611,
    "book": "lamentations                            ",
    "chapter": "3",
    "verse": "24",
    "text": "Herren (Jahve) är min del (portion), säger min själ (mitt inre – hebr. nefesh),"
  },
  {
    "id": 38612,
    "book": "lamentations                            ",
    "chapter": "3",
    "verse": "25",
    "text": "Herren är god mot dem som väntar (aktivt väntar, förväntar sig ett svar, binder sig samman med) honom,"
  },
  {
    "id": 38613,
    "book": "lamentations                            ",
    "chapter": "3",
    "verse": "26",
    "text": "Det är gott att tålmodigt vänta (vänta i stillhet)"
  },
  {
    "id": 38614,
    "book": "lamentations                            ",
    "chapter": "3",
    "verse": "27",
    "text": "Det är gott för en man (stridsman) [en man i sin bästa ålder]"
  },
  {
    "id": 38615,
    "book": "lamentations                            ",
    "chapter": "3",
    "verse": "28",
    "text": "Låt honom sitta för sig själv i tystnad,"
  },
  {
    "id": 38616,
    "book": "lamentations                            ",
    "chapter": "3",
    "verse": "29",
    "text": "Låt honom ge (sänka) sin mun i stoftet (mot marken) [Mika 7:17; Ps 72:9; Matt 27:14],"
  },
  {
    "id": 38617,
    "book": "lamentations                            ",
    "chapter": "3",
    "verse": "30",
    "text": "Låt honom ge (vända) kinden till den som slår honom [Job 16:10; Jes 50:6; Mika 5:1; Matt 5:39; 26:67],"
  },
  {
    "id": 38618,
    "book": "lamentations                            ",
    "chapter": "3",
    "verse": "31",
    "text": "Eftersom Herren (Adonaj)"
  },
  {
    "id": 38619,
    "book": "lamentations                            ",
    "chapter": "3",
    "verse": "32",
    "text": "Även om han förorsakar sorg,"
  },
  {
    "id": 38620,
    "book": "lamentations                            ",
    "chapter": "3",
    "verse": "33",
    "text": "För Han plågar inte villigt"
  },
  {
    "id": 38621,
    "book": "lamentations                            ",
    "chapter": "3",
    "verse": "34",
    "text": "Att krossa under sina fötter"
  },
  {
    "id": 38622,
    "book": "lamentations                            ",
    "chapter": "3",
    "verse": "35",
    "text": "att undanhålla mannens rätt"
  },
  {
    "id": 38623,
    "book": "lamentations                            ",
    "chapter": "3",
    "verse": "36",
    "text": "att förvränga rätten för någon i hans sak,"
  },
  {
    "id": 38624,
    "book": "lamentations                            ",
    "chapter": "3",
    "verse": "37",
    "text": "Vem är han som säger att det ska ske,"
  },
  {
    "id": 38625,
    "book": "lamentations                            ",
    "chapter": "3",
    "verse": "38",
    "text": "Utgår inte allt från den allra Högstes (Elions) mun,"
  },
  {
    "id": 38626,
    "book": "lamentations                            ",
    "chapter": "3",
    "verse": "39",
    "text": "Varför skulle en levande människa (hebr. adam) klaga"
  },
  {
    "id": 38627,
    "book": "lamentations                            ",
    "chapter": "3",
    "verse": "40",
    "text": "Låt oss granska (utvärdera, rannsaka) våra vägar och pröva (utforska) dem"
  },
  {
    "id": 38628,
    "book": "lamentations                            ",
    "chapter": "3",
    "verse": "41",
    "text": "Låt oss lyfta upp våra hjärtan och händer"
  },
  {
    "id": 38629,
    "book": "lamentations                            ",
    "chapter": "3",
    "verse": "42",
    "text": "Vi har syndat och varit upproriska;"
  },
  {
    "id": 38630,
    "book": "lamentations                            ",
    "chapter": "3",
    "verse": "43",
    "text": "Du har täckt dig själv i vrede och förföljt oss,"
  },
  {
    "id": 38631,
    "book": "lamentations                            ",
    "chapter": "3",
    "verse": "44",
    "text": "Du har täckt dig själv i ett moln"
  },
  {
    "id": 38632,
    "book": "lamentations                            ",
    "chapter": "3",
    "verse": "45",
    "text": "Till avskum (avskräde, som sopas bort) och förakt (skräp) har du gjort oss"
  },
  {
    "id": 38633,
    "book": "lamentations                            ",
    "chapter": "3",
    "verse": "46",
    "text": "Alla våra fiender har öppnat sina munnar"
  },
  {
    "id": 38634,
    "book": "lamentations                            ",
    "chapter": "3",
    "verse": "47",
    "text": "Skräck (terror) och en avgrund har kommit över oss,"
  },
  {
    "id": 38635,
    "book": "lamentations                            ",
    "chapter": "3",
    "verse": "48",
    "text": "Floder av vatten rinner ner från mina ögon,"
  },
  {
    "id": 38636,
    "book": "lamentations                            ",
    "chapter": "3",
    "verse": "49",
    "text": "Mina ögon flödar (tårarna hälls ut, forsar) och upphör inte,"
  },
  {
    "id": 38637,
    "book": "lamentations                            ",
    "chapter": "3",
    "verse": "50",
    "text": "Till dess att Herren (Jahve) ser ner"
  },
  {
    "id": 38638,
    "book": "lamentations                            ",
    "chapter": "3",
    "verse": "51",
    "text": "Mina ögon misshandlar min själ (det jag ser fyller mig med smärtsam sorg)"
  },
  {
    "id": 38639,
    "book": "lamentations                            ",
    "chapter": "3",
    "verse": "52",
    "text": "De har jagat mig frenetiskt som en fågel,"
  },
  {
    "id": 38640,
    "book": "lamentations                            ",
    "chapter": "3",
    "verse": "53",
    "text": "I fängelsehålan har de gjort slut på mitt liv,"
  },
  {
    "id": 38641,
    "book": "lamentations                            ",
    "chapter": "3",
    "verse": "54",
    "text": "Vatten forsar över mitt huvud,"
  },
  {
    "id": 38642,
    "book": "lamentations                            ",
    "chapter": "3",
    "verse": "55",
    "text": "Jag ropade ditt namn Herre (Jahve)"
  },
  {
    "id": 38643,
    "book": "lamentations                            ",
    "chapter": "3",
    "verse": "56",
    "text": "Du hörde min röst:"
  },
  {
    "id": 38644,
    "book": "lamentations                            ",
    "chapter": "3",
    "verse": "57",
    "text": "Du kom nära den dagen som jag ropade på dig,"
  },
  {
    "id": 38645,
    "book": "lamentations                            ",
    "chapter": "3",
    "verse": "58",
    "text": "Herre (Adonaj) du har försvarat mitt liv (min själ – hebr. nefesh),"
  },
  {
    "id": 38646,
    "book": "lamentations                            ",
    "chapter": "3",
    "verse": "59",
    "text": "Herre (Jahve) du har sett mina felsteg (det som är krokigt),"
  },
  {
    "id": 38647,
    "book": "lamentations                            ",
    "chapter": "3",
    "verse": "60",
    "text": "Du har sett all deras hämndlystnad"
  },
  {
    "id": 38648,
    "book": "lamentations                            ",
    "chapter": "3",
    "verse": "61",
    "text": "Herre (Jahve), du har hört deras hån,"
  },
  {
    "id": 38649,
    "book": "lamentations                            ",
    "chapter": "3",
    "verse": "62",
    "text": "Deras läppar (som talar) mot mig"
  },
  {
    "id": 38650,
    "book": "lamentations                            ",
    "chapter": "3",
    "verse": "63",
    "text": "Om de sitter eller står,"
  },
  {
    "id": 38651,
    "book": "lamentations                            ",
    "chapter": "3",
    "verse": "64",
    "text": "Du ska vedergälla dem Herre (Jahve)"
  },
  {
    "id": 38652,
    "book": "lamentations                            ",
    "chapter": "3",
    "verse": "65",
    "text": "Du ska ge dem förhärdade hjärtan,"
  },
  {
    "id": 38653,
    "book": "lamentations                            ",
    "chapter": "3",
    "verse": "66",
    "text": "Du ska jaga dem i brinnande vrede och förgöra dem,"
  }
]