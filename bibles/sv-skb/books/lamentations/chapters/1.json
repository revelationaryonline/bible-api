[
  {
    "id": 38544,
    "book": "lamentations                            ",
    "chapter": "1",
    "verse": "1",
    "text": "Ack (ve, hur, varför), hon [Jerusalem] sitter ensam (som en solitär) i"
  },
  {
    "id": 38545,
    "book": "lamentations                            ",
    "chapter": "1",
    "verse": "2",
    "text": "Hon [Jerusalem, som liknas vid en änka] gråter bittert i natten"
  },
  {
    "id": 38546,
    "book": "lamentations                            ",
    "chapter": "1",
    "verse": "3",
    "text": "Juda [folket i Judéen] har förts bort i exil [till Babylon]"
  },
  {
    "id": 38547,
    "book": "lamentations                            ",
    "chapter": "1",
    "verse": "4",
    "text": "Vägarna till Sion [tempelberget i Jerusalem] sörjer"
  },
  {
    "id": 38548,
    "book": "lamentations                            ",
    "chapter": "1",
    "verse": "5",
    "text": "Hennes motståndare har blivit huvud (den som leder)"
  },
  {
    "id": 38549,
    "book": "lamentations                            ",
    "chapter": "1",
    "verse": "6",
    "text": "Och borta från (har lämnat) dottern Sion [tempelberget i Jerusalem]"
  },
  {
    "id": 38550,
    "book": "lamentations                            ",
    "chapter": "1",
    "verse": "7",
    "text": "Jerusalem kommer ihåg"
  },
  {
    "id": 38551,
    "book": "lamentations                            ",
    "chapter": "1",
    "verse": "8",
    "text": "Jerusalem har syndat svårt [ordagrant ”synd syndar”; begått upprepade överträdelser, syndat mer och mer],"
  },
  {
    "id": 38552,
    "book": "lamentations                            ",
    "chapter": "1",
    "verse": "9",
    "text": "Hennes rituella orenhet fanns i hennes kläder [3 Mos 15:19-30],"
  },
  {
    "id": 38553,
    "book": "lamentations                            ",
    "chapter": "1",
    "verse": "10",
    "text": "Motståndaren har sträckt ut sin hand"
  },
  {
    "id": 38554,
    "book": "lamentations                            ",
    "chapter": "1",
    "verse": "11",
    "text": "Alla hennes invånare suckar,"
  },
  {
    "id": 38555,
    "book": "lamentations                            ",
    "chapter": "1",
    "verse": "12",
    "text": "Låt det inte drabba er, alla ni som passerar längs vägen."
  },
  {
    "id": 38556,
    "book": "lamentations                            ",
    "chapter": "1",
    "verse": "13",
    "text": "Från höjden sände han eld"
  },
  {
    "id": 38557,
    "book": "lamentations                            ",
    "chapter": "1",
    "verse": "14",
    "text": "Mina missgärningar är sammanbundna som i ett ok,"
  },
  {
    "id": 38558,
    "book": "lamentations                            ",
    "chapter": "1",
    "verse": "15",
    "text": "Herren (Adonaj) har förskjutit"
  },
  {
    "id": 38559,
    "book": "lamentations                            ",
    "chapter": "1",
    "verse": "16",
    "text": "Över allt detta gråter jag."
  },
  {
    "id": 38560,
    "book": "lamentations                            ",
    "chapter": "1",
    "verse": "17",
    "text": "Sion [tempelberget i Jerusalem] breder ut sina händer (i en gest av uppgivenhet)"
  },
  {
    "id": 38561,
    "book": "lamentations                            ",
    "chapter": "1",
    "verse": "18",
    "text": "Herren är rättfärdig,"
  },
  {
    "id": 38562,
    "book": "lamentations                            ",
    "chapter": "1",
    "verse": "19",
    "text": "Jag ropade efter mina älskare [Klag 1:2]"
  },
  {
    "id": 38563,
    "book": "lamentations                            ",
    "chapter": "1",
    "verse": "20",
    "text": "Se, Herre (Jahve), för jag är i ångest,"
  },
  {
    "id": 38564,
    "book": "lamentations                            ",
    "chapter": "1",
    "verse": "21",
    "text": "De [mina fiender] har hört min jämmer och suckan,"
  },
  {
    "id": 38565,
    "book": "lamentations                            ",
    "chapter": "1",
    "verse": "22",
    "text": "Låt all deras ondska komma inför ditt ansikte"
