[
  {
    "id": 38676,
    "book": "lamentations                            ",
    "chapter": "5",
    "verse": "1",
    "text": "Kom ihåg Herre (Jahve) vad som har drabbat oss,"
  },
  {
    "id": 38677,
    "book": "lamentations                            ",
    "chapter": "5",
    "verse": "2",
    "text": "Vårt arv har getts till främlingar,"
  },
  {
    "id": 38678,
    "book": "lamentations                            ",
    "chapter": "5",
    "verse": "3",
    "text": "Vi har blivit föräldralösa, utan fäder,"
  },
  {
    "id": 38679,
    "book": "lamentations                            ",
    "chapter": "5",
    "verse": "4",
    "text": "Vi har druckit vårt vatten för pengar (vi har betalat för vårt dricksvatten),"
  },
  {
    "id": 38680,
    "book": "lamentations                            ",
    "chapter": "5",
    "verse": "5",
    "text": "Våra förföljare flåsar oss i nacken,"
  },
  {
    "id": 38681,
    "book": "lamentations                            ",
    "chapter": "5",
    "verse": "6",
    "text": "Vi har räckt ut våra händer till Egypten"
  },
  {
    "id": 38682,
    "book": "lamentations                            ",
    "chapter": "5",
    "verse": "7",
    "text": "Våra fäder har syndat och finns inte mer"
  },
  {
    "id": 38683,
    "book": "lamentations                            ",
    "chapter": "5",
    "verse": "8",
    "text": "Slavar regerar över oss,"
  },
  {
    "id": 38684,
    "book": "lamentations                            ",
    "chapter": "5",
    "verse": "9",
    "text": "Vi får vårt bröd med fara för vårt liv,"
  },
  {
    "id": 38685,
    "book": "lamentations                            ",
    "chapter": "5",
    "verse": "10",
    "text": "Vår hud är varm som en ugn,"
  },
  {
    "id": 38686,
    "book": "lamentations                            ",
    "chapter": "5",
    "verse": "11",
    "text": "Kvinnorna i Sion [tempelberget i Jerusalem] har blivit våldtagna,"
  },
  {
    "id": 38687,
    "book": "lamentations                            ",
    "chapter": "5",
    "verse": "12",
    "text": "Furstarna har blivit upphängda i sina händer,"
  },
  {
    "id": 38688,
    "book": "lamentations                            ",
    "chapter": "5",
    "verse": "13",
    "text": "De unga männen sliter med kvarnstenen."
  },
  {
    "id": 38689,
    "book": "lamentations                            ",
    "chapter": "5",
    "verse": "14",
    "text": "De gamla har slutat att sitta i porten [platsen där de äldste satt när viktiga beslut för staden skulle fattas],"
  },
  {
    "id": 38690,
    "book": "lamentations                            ",
    "chapter": "5",
    "verse": "15",
    "text": "Glädjen har lämnat våra hjärtan,"
  },
  {
    "id": 38691,
    "book": "lamentations                            ",
    "chapter": "5",
    "verse": "16",
    "text": "Kronan har fallit av våra huvuden."
  },
  {
    "id": 38692,
    "book": "lamentations                            ",
    "chapter": "5",
    "verse": "17",
    "text": "Därför är våra hjärtan svaga,"
  },
  {
    "id": 38693,
    "book": "lamentations                            ",
    "chapter": "5",
    "verse": "18",
    "text": "På Sions berg [tempelberget i Jerusalem] som är öde,"
  },
  {
    "id": 38694,
    "book": "lamentations                            ",
    "chapter": "5",
    "verse": "19",
    "text": "Du Herre (Jahve) tronar för evigt,"
  },
  {
    "id": 38695,
    "book": "lamentations                            ",
    "chapter": "5",
    "verse": "20",
    "text": "Varför tycks du glömma oss för evigt?"
  },
  {
    "id": 38696,
    "book": "lamentations                            ",
    "chapter": "5",
    "verse": "21",
    "text": "Vänd oss Herre (Jahve) till dig och vi ska bli omvända,"
  },
  {
    "id": 38697,
    "book": "lamentations                            ",
    "chapter": "5",
    "verse": "22",
    "text": "Du kan inte helt avvisa oss"
  }
]