[
  {
    "id": 4341,
    "book": "job                                     ",
    "chapter": "12",
    "verse": "1",
    "text": "Potem Hiob odpowiedział:"
  },
  {
    "id": 4342,
    "book": "job                                     ",
    "chapter": "12",
    "verse": "2",
    "text": "Doprawdy jesteście ludem i wraz z wami zginie mądrość."
  },
  {
    "id": 4343,
    "book": "job                                     ",
    "chapter": "12",
    "verse": "3",
    "text": "Ale ja również mam rozum, jak"
  },
  {
    "id": 4344,
    "book": "job                                     ",
    "chapter": "12",
    "verse": "4",
    "text": "Jestem pośmiewiskiem dla swojego przyjaciela; ja, który wołam do Boga, a on odpowiada; sprawiedliwy"
  },
  {
    "id": 4345,
    "book": "job                                     ",
    "chapter": "12",
    "verse": "5",
    "text": "Ten, który jest bliski upadku, to pochodnia wzgardzona w umyśle"
  },
  {
    "id": 4346,
    "book": "job                                     ",
    "chapter": "12",
    "verse": "6",
    "text": "Namioty łupieżców są spokojne i bezpieczni są ci, którzy drażnią Boga, a którym Bóg"
  },
  {
    "id": 4347,
    "book": "job                                     ",
    "chapter": "12",
    "verse": "7",
    "text": "Ale zapytaj zwierząt, a one cię pouczą, i ptaków nieba, a powiedzą tobie."
  },
  {
    "id": 4348,
    "book": "job                                     ",
    "chapter": "12",
    "verse": "8",
    "text": "Albo rozmawiaj z ziemią, a ona cię nauczy, i opowiedzą ci ryby morskie."
  },
  {
    "id": 4349,
    "book": "job                                     ",
    "chapter": "12",
    "verse": "9",
    "text": "Któż spośród nich wszystkich nie wie, że ręka PANA to wykonała?"
  },
  {
    "id": 4350,
    "book": "job                                     ",
    "chapter": "12",
    "verse": "10",
    "text": "W jego ręku jest dusza wszelkiej istoty żywej i duch wszelkiego człowieka."
  },
  {
    "id": 4351,
    "book": "job                                     ",
    "chapter": "12",
    "verse": "11",
    "text": "Czy ucho nie bada mowy, a podniebienie nie smakuje pokarmu?"
  },
  {
    "id": 4352,
    "book": "job                                     ",
    "chapter": "12",
    "verse": "12",
    "text": "U starców jest mądrość, a w długości dni roztropność."
  },
  {
    "id": 4353,
    "book": "job                                     ",
    "chapter": "12",
    "verse": "13",
    "text": ""
  },
  {
    "id": 4354,
    "book": "job                                     ",
    "chapter": "12",
    "verse": "14",
    "text": "Oto on burzy,"
  },
  {
    "id": 4355,
    "book": "job                                     ",
    "chapter": "12",
    "verse": "15",
    "text": "Oto gdy zatrzyma wody, wysychają, gdy je wypuści, wywracają ziemię."
  },
  {
    "id": 4356,
    "book": "job                                     ",
    "chapter": "12",
    "verse": "16",
    "text": "U niego jest moc i mądrość. Do niego należy zwiedziony i zwodziciel."
  },
  {
    "id": 4357,
    "book": "job                                     ",
    "chapter": "12",
    "verse": "17",
    "text": "Pozbawia radców"
  },
  {
    "id": 4358,
    "book": "job                                     ",
    "chapter": "12",
    "verse": "18",
    "text": "Rozwiązuje więzy królów i przepasuje ich biodra pasem."
  },
  {
    "id": 4359,
    "book": "job                                     ",
    "chapter": "12",
    "verse": "19",
    "text": "Odprowadza złupionych książąt i wywraca mocarzy."
  },
  {
    "id": 4360,
    "book": "job                                     ",
    "chapter": "12",
    "verse": "20",
    "text": "Odbiera mowę prawdomównym i zabiera starcom rozsądek."
  },
  {
    "id": 4361,
    "book": "job                                     ",
    "chapter": "12",
    "verse": "21",
    "text": "Wylewa pogardę na książąt i osłabia siły mocarzy."
  },
  {
    "id": 4362,
    "book": "job                                     ",
    "chapter": "12",
    "verse": "22",
    "text": ""
  },
  {
    "id": 4363,
    "book": "job                                     ",
    "chapter": "12",
    "verse": "23",
    "text": "Rozmnaża narody i wytraca je, rozszerza narody i pomniejsza je."
  },
  {
    "id": 4364,
    "book": "job                                     ",
    "chapter": "12",
    "verse": "24",
    "text": "On zabiera serca przełożonym ludu ziemi i sprawia, że błądzą po pustyni bezdrożnej;"
  },
  {
    "id": 4365,
    "book": "job                                     ",
    "chapter": "12",
    "verse": "25",
    "text": "I chodzą po omacku w ciemności bez światła, i sprawia, że zataczają się jak pijani."
  }
]