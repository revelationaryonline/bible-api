[
  {
    "id": 4191,
    "book": "job                                     ",
    "chapter": "6",
    "verse": "1",
    "text": "Hiob zaś odpowiedział tymi słowami:"
  },
  {
    "id": 4192,
    "book": "job                                     ",
    "chapter": "6",
    "verse": "2",
    "text": "O gdyby dokładnie zważono moją udrękę i włożono na szalę całe moje nieszczęście!"
  },
  {
    "id": 4193,
    "book": "job                                     ",
    "chapter": "6",
    "verse": "3",
    "text": "Byłoby to cięższe niż piasek morski. Dlatego moje słowa plączą się."
  },
  {
    "id": 4194,
    "book": "job                                     ",
    "chapter": "6",
    "verse": "4",
    "text": ""
  },
  {
    "id": 4195,
    "book": "job                                     ",
    "chapter": "6",
    "verse": "5",
    "text": "Czy dziki osioł ryczy, gdy ma trawę? Czy wół ryczy nad swoją paszą?"
  },
  {
    "id": 4196,
    "book": "job                                     ",
    "chapter": "6",
    "verse": "6",
    "text": "Czy można zjeść niesmaczną rzecz bez soli? Czy ma jakiś smak białko jajka?"
  },
  {
    "id": 4197,
    "book": "job                                     ",
    "chapter": "6",
    "verse": "7",
    "text": ""
  },
  {
    "id": 4198,
    "book": "job                                     ",
    "chapter": "6",
    "verse": "8",
    "text": "Oby się spełniła moja prośba i Bóg dał mi to, czego pragnę!"
  },
  {
    "id": 4199,
    "book": "job                                     ",
    "chapter": "6",
    "verse": "9",
    "text": "Oby się Bogu spodobało to, aby mnie zniszczyć, aby opuścić rękę i mnie odciąć!"
  },
  {
    "id": 4200,
    "book": "job                                     ",
    "chapter": "6",
    "verse": "10",
    "text": "Wtedy miałbym jeszcze pociechę – chociaż pałam boleścią, niech"
  },
  {
    "id": 4201,
    "book": "job                                     ",
    "chapter": "6",
    "verse": "11",
    "text": "Jaka"
  },
  {
    "id": 4202,
    "book": "job                                     ",
    "chapter": "6",
    "verse": "12",
    "text": "Czy moja siła jest siłą kamieni? Czy moje ciało jest ze spiżu?"
  },
  {
    "id": 4203,
    "book": "job                                     ",
    "chapter": "6",
    "verse": "13",
    "text": "Czy moja obrona nie jest we mnie? Czy mój rozsądek odszedł ode mnie?"
  },
  {
    "id": 4204,
    "book": "job                                     ",
    "chapter": "6",
    "verse": "14",
    "text": "Strapionemu należy się litość od przyjaciela, ale on opuścił bojaźń Wszechmogącego."
  },
  {
    "id": 4205,
    "book": "job                                     ",
    "chapter": "6",
    "verse": "15",
    "text": "Moi bracia zawiedli jak potok, odpływają jak gwałtowne potoki;"
  },
  {
    "id": 4206,
    "book": "job                                     ",
    "chapter": "6",
    "verse": "16",
    "text": "Które są mętne od lodu, w których śnieg się ukrywa;"
  },
  {
    "id": 4207,
    "book": "job                                     ",
    "chapter": "6",
    "verse": "17",
    "text": "W czasie roztopów znikają;"
  },
  {
    "id": 4208,
    "book": "job                                     ",
    "chapter": "6",
    "verse": "18",
    "text": "Wiją się ścieżki ich dróg; rozpływają się w nicość i giną."
  },
  {
    "id": 4209,
    "book": "job                                     ",
    "chapter": "6",
    "verse": "19",
    "text": "Podróżni z Temy wypatrywali ich; wędrowcy z Seby pokładali w nich nadzieję."
  },
  {
    "id": 4210,
    "book": "job                                     ",
    "chapter": "6",
    "verse": "20",
    "text": "Ale zawiedli się w oczekiwaniu, przyszli tam i zawstydzili się."
  },
  {
    "id": 4211,
    "book": "job                                     ",
    "chapter": "6",
    "verse": "21",
    "text": "Staliście się niczym; widzicie moją niedolę i lękacie się."
  },
  {
    "id": 4212,
    "book": "job                                     ",
    "chapter": "6",
    "verse": "22",
    "text": "Czy powiedziałem: Przynieście mi"
  },
  {
    "id": 4213,
    "book": "job                                     ",
    "chapter": "6",
    "verse": "23",
    "text": "Lub: Wybawcie mnie z rąk wroga? lub: Wykupcie mnie z rąk okrutników?"
  },
  {
    "id": 4214,
    "book": "job                                     ",
    "chapter": "6",
    "verse": "24",
    "text": "Pouczcie mnie, a zamilknę; pokażcie mi, w czym zbłądziłem."
  },
  {
    "id": 4215,
    "book": "job                                     ",
    "chapter": "6",
    "verse": "25",
    "text": "O jak mocne są słowa prawdziwe! Ale cóż sprawi wasze obwinianie?"
  },
  {
    "id": 4216,
    "book": "job                                     ",
    "chapter": "6",
    "verse": "26",
    "text": "Czy zamierzacie ganić"
  },
  {
    "id": 4217,
    "book": "job                                     ",
    "chapter": "6",
    "verse": "27",
    "text": "Nawet sierotę przytłaczacie i kopiecie"
  },
  {
    "id": 4218,
    "book": "job                                     ",
    "chapter": "6",
    "verse": "28",
    "text": "Teraz więc zechciejcie spojrzeć na mnie, a"
  },
  {
    "id": 4219,
    "book": "job                                     ",
    "chapter": "6",
    "verse": "29",
    "text": "Zawróćcie, proszę, a niech nie będzie"
  },
  {
    "id": 4220,
    "book": "job                                     ",
    "chapter": "6",
    "verse": "30",
    "text": "Czy w moim języku jest nieprawość? Czy moje podniebienie nie rozeznaje przewrotności?"
  }
]