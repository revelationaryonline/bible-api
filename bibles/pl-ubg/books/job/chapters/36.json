[
  {
    "id": 4949,
    "book": "job                                     ",
    "chapter": "36",
    "verse": "1",
    "text": "Elihu mówił jeszcze:"
  },
  {
    "id": 4950,
    "book": "job                                     ",
    "chapter": "36",
    "verse": "2",
    "text": "Poczekaj trochę, a pouczę cię, bo jeszcze przemówię za Boga."
  },
  {
    "id": 4951,
    "book": "job                                     ",
    "chapter": "36",
    "verse": "3",
    "text": "Z daleka przyniosę swą wiedzę i uznam sprawiedliwość mego Stwórcy."
  },
  {
    "id": 4952,
    "book": "job                                     ",
    "chapter": "36",
    "verse": "4",
    "text": "Bo naprawdę moje słowa nie"
  },
  {
    "id": 4953,
    "book": "job                                     ",
    "chapter": "36",
    "verse": "5",
    "text": "Oto Bóg"
  },
  {
    "id": 4954,
    "book": "job                                     ",
    "chapter": "36",
    "verse": "6",
    "text": "Nie pozostawia niegodziwych przy życiu, a ubogim przyznaje prawa."
  },
  {
    "id": 4955,
    "book": "job                                     ",
    "chapter": "36",
    "verse": "7",
    "text": "Nie odwraca swoich oczu od sprawiedliwego, ale sadza ich na wieki z królami na tronie – i są wywyższeni."
  },
  {
    "id": 4956,
    "book": "job                                     ",
    "chapter": "36",
    "verse": "8",
    "text": "A jeśli są związani okowami albo spętani powrozami utrapienia;"
  },
  {
    "id": 4957,
    "book": "job                                     ",
    "chapter": "36",
    "verse": "9",
    "text": "Wtedy oznajmia im ich czyny i przestępstwa – to, że się wzmogły."
  },
  {
    "id": 4958,
    "book": "job                                     ",
    "chapter": "36",
    "verse": "10",
    "text": "Otwiera im ucho, aby"
  },
  {
    "id": 4959,
    "book": "job                                     ",
    "chapter": "36",
    "verse": "11",
    "text": "Jeśli będą posłuszni i będą"
  },
  {
    "id": 4960,
    "book": "job                                     ",
    "chapter": "36",
    "verse": "12",
    "text": "Ale jeśli nie usłuchają, zginą od miecza, umrą bez poznania."
  },
  {
    "id": 4961,
    "book": "job                                     ",
    "chapter": "36",
    "verse": "13",
    "text": "Lecz"
  },
  {
    "id": 4962,
    "book": "job                                     ",
    "chapter": "36",
    "verse": "14",
    "text": "Umierają w młodości, swoje życie spędzają wśród rozpustników."
  },
  {
    "id": 4963,
    "book": "job                                     ",
    "chapter": "36",
    "verse": "15",
    "text": "Wyrywa ubogiego z utrapienia i otwiera ich uszy w ucisku."
  },
  {
    "id": 4964,
    "book": "job                                     ",
    "chapter": "36",
    "verse": "16",
    "text": "Również ciebie wyrwałby z ciasnego miejsca na"
  },
  {
    "id": 4965,
    "book": "job                                     ",
    "chapter": "36",
    "verse": "17",
    "text": "Ale ty zasłużyłeś na sąd niegodziwego,"
  },
  {
    "id": 4966,
    "book": "job                                     ",
    "chapter": "36",
    "verse": "18",
    "text": "Gniew"
  },
  {
    "id": 4967,
    "book": "job                                     ",
    "chapter": "36",
    "verse": "19",
    "text": "Czy będzie zważał na twoje bogactwa?"
  },
  {
    "id": 4968,
    "book": "job                                     ",
    "chapter": "36",
    "verse": "20",
    "text": "Nie tęsknij za nocą, kiedy ludzie są porwani ze swojego miejsca."
  },
  {
    "id": 4969,
    "book": "job                                     ",
    "chapter": "36",
    "verse": "21",
    "text": "Strzeż się, abyś nie zważał na nieprawość; gdyż wybrałeś to sobie zamiast utrapienia."
  },
  {
    "id": 4970,
    "book": "job                                     ",
    "chapter": "36",
    "verse": "22",
    "text": "Oto Bóg jest najwyższy w swojej potędze, któż może tak nauczyć jak on?"
  },
  {
    "id": 4971,
    "book": "job                                     ",
    "chapter": "36",
    "verse": "23",
    "text": "Kto mu wytyczył jego drogę? Albo kto mu powie: Popełniłeś nieprawość?"
  },
  {
    "id": 4972,
    "book": "job                                     ",
    "chapter": "36",
    "verse": "24",
    "text": "Pamiętaj, abyś wysławiał jego dzieło, któremu przypatrują się ludzie."
  },
  {
    "id": 4973,
    "book": "job                                     ",
    "chapter": "36",
    "verse": "25",
    "text": "Wszyscy ludzie je widzą, człowiek przypatruje się nim z daleka."
  },
  {
    "id": 4974,
    "book": "job                                     ",
    "chapter": "36",
    "verse": "26",
    "text": "Oto Bóg"
  },
  {
    "id": 4975,
    "book": "job                                     ",
    "chapter": "36",
    "verse": "27",
    "text": "On wyciąga bowiem krople wód, które padają z pary"
  },
  {
    "id": 4976,
    "book": "job                                     ",
    "chapter": "36",
    "verse": "28",
    "text": "Który spuszczają chmury i"
  },
  {
    "id": 4977,
    "book": "job                                     ",
    "chapter": "36",
    "verse": "29",
    "text": "(A kto zrozumie rozmieszczenie chmur i grzmot jego namiotu?"
  },
  {
    "id": 4978,
    "book": "job                                     ",
    "chapter": "36",
    "verse": "30",
    "text": "Oto rozciąga nad nim swoją światłość i okrywa głębiny morskie."
  },
  {
    "id": 4979,
    "book": "job                                     ",
    "chapter": "36",
    "verse": "31",
    "text": "Przez te rzeczy bowiem sądzi narody i daje pokarm w obfitości."
  },
  {
    "id": 4980,
    "book": "job                                     ",
    "chapter": "36",
    "verse": "32",
    "text": "Chmurami okrywa światłość i rozkazuje"
  },
  {
    "id": 4981,
    "book": "job                                     ",
    "chapter": "36",
    "verse": "33",
    "text": "Grzmot daje o nim znać, a także bydło – o parze unoszącej się w górę."
  }
]