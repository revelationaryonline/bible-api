[
  {
    "id": 4933,
    "book": "job                                     ",
    "chapter": "35",
    "verse": "1",
    "text": "Elihu mówił dalej:"
  },
  {
    "id": 4934,
    "book": "job                                     ",
    "chapter": "35",
    "verse": "2",
    "text": "Czy uważasz to za słuszne, że powiedziałeś: Mam więcej sprawiedliwości niż Bóg?"
  },
  {
    "id": 4935,
    "book": "job                                     ",
    "chapter": "35",
    "verse": "3",
    "text": "Powiedziałeś bowiem: Cóż mi pomoże? Jaki będę miał pożytek"
  },
  {
    "id": 4936,
    "book": "job                                     ",
    "chapter": "35",
    "verse": "4",
    "text": "Odpowiem dowodnie tobie i twoim towarzyszom wraz z tobą."
  },
  {
    "id": 4937,
    "book": "job                                     ",
    "chapter": "35",
    "verse": "5",
    "text": "Spójrz w niebo i zobacz, przypatrz się obłokom, które są wyżej od ciebie."
  },
  {
    "id": 4938,
    "book": "job                                     ",
    "chapter": "35",
    "verse": "6",
    "text": "Jeśli zgrzeszysz, co zrobisz przeciwko niemu? A jeśli pomnożą się twoje nieprawości, co mu uczynisz?"
  },
  {
    "id": 4939,
    "book": "job                                     ",
    "chapter": "35",
    "verse": "7",
    "text": "Jeśli jesteś sprawiedliwy, co mu dajesz? Albo co otrzymuje z twojej ręki?"
  },
  {
    "id": 4940,
    "book": "job                                     ",
    "chapter": "35",
    "verse": "8",
    "text": "Twoja niegodziwość"
  },
  {
    "id": 4941,
    "book": "job                                     ",
    "chapter": "35",
    "verse": "9",
    "text": ""
  },
  {
    "id": 4942,
    "book": "job                                     ",
    "chapter": "35",
    "verse": "10",
    "text": ""
  },
  {
    "id": 4943,
    "book": "job                                     ",
    "chapter": "35",
    "verse": "11",
    "text": "Ten, który uczy nas więcej niż zwierzęta ziemskie i czyni nas mądrzejszymi od ptactwa niebieskiego?"
  },
  {
    "id": 4944,
    "book": "job                                     ",
    "chapter": "35",
    "verse": "12",
    "text": "Tak więc wołają, ale nikt nie wysłuchuje z powodu pychy złych ludzi."
  },
  {
    "id": 4945,
    "book": "job                                     ",
    "chapter": "35",
    "verse": "13",
    "text": "Doprawdy, Bóg nie wysłucha"
  },
  {
    "id": 4946,
    "book": "job                                     ",
    "chapter": "35",
    "verse": "14",
    "text": "Chociaż mówisz, że go nie widzisz, sąd jest przed nim, więc mu zaufaj."
  },
  {
    "id": 4947,
    "book": "job                                     ",
    "chapter": "35",
    "verse": "15",
    "text": "Teraz jednak jego gniew spadł na ciebie w niewielkim stopniu, jakby nie znał wielkości twoich"
  },
  {
    "id": 4948,
    "book": "job                                     ",
    "chapter": "35",
    "verse": "16",
    "text": "Dlatego Hiob na próżno otwiera swe usta; mnoży słowa bez poznania."
  }
]