[
  {
    "id": 4117,
    "book": "job                                     ",
    "chapter": "3",
    "verse": "1",
    "text": "Potem Hiob otworzył swoje usta i przeklinał swój dzień."
  },
  {
    "id": 4118,
    "book": "job                                     ",
    "chapter": "3",
    "verse": "2",
    "text": "Hiob odezwał się i zawołał:"
  },
  {
    "id": 4119,
    "book": "job                                     ",
    "chapter": "3",
    "verse": "3",
    "text": "Niech zginie dzień, w którym się urodziłem, i noc,"
  },
  {
    "id": 4120,
    "book": "job                                     ",
    "chapter": "3",
    "verse": "4",
    "text": "Niech ten dzień stanie się ciemnością, niech o niego nie troszczy się Bóg z wysokości i nie oświetla go światłość."
  },
  {
    "id": 4121,
    "book": "job                                     ",
    "chapter": "3",
    "verse": "5",
    "text": "Niech go pokryje ciemność i cień śmierci, niech go ogarnie obłok i przerazi mrok dnia."
  },
  {
    "id": 4122,
    "book": "job                                     ",
    "chapter": "3",
    "verse": "6",
    "text": "Niech tą nocą zawładnie ciemność, niech nie będzie liczona wśród dni roku"
  },
  {
    "id": 4123,
    "book": "job                                     ",
    "chapter": "3",
    "verse": "7",
    "text": "Niech ta noc będzie samotna, niech nie będzie w niej radosnego śpiewu."
  },
  {
    "id": 4124,
    "book": "job                                     ",
    "chapter": "3",
    "verse": "8",
    "text": "Niech przeklną ją ci, którzy przeklinają dzień, którzy są gotowi podnieść swój lament."
  },
  {
    "id": 4125,
    "book": "job                                     ",
    "chapter": "3",
    "verse": "9",
    "text": "Niech gwiazdy zaćmią się"
  },
  {
    "id": 4126,
    "book": "job                                     ",
    "chapter": "3",
    "verse": "10",
    "text": "Bo nie zamknęła drzwi łona mej"
  },
  {
    "id": 4127,
    "book": "job                                     ",
    "chapter": "3",
    "verse": "11",
    "text": "Czemu nie umarłem w łonie?"
  },
  {
    "id": 4128,
    "book": "job                                     ",
    "chapter": "3",
    "verse": "12",
    "text": "Czemu przyjęły mnie kolana? Czemu"
  },
  {
    "id": 4129,
    "book": "job                                     ",
    "chapter": "3",
    "verse": "13",
    "text": "Teraz bowiem leżałbym i trwał w spokoju, spałbym i odpoczywał;"
  },
  {
    "id": 4130,
    "book": "job                                     ",
    "chapter": "3",
    "verse": "14",
    "text": "Z królami i z doradcami ziemi, którzy sobie budowali opustoszałe miejsca;"
  },
  {
    "id": 4131,
    "book": "job                                     ",
    "chapter": "3",
    "verse": "15",
    "text": "Albo z książętami, którzy mieli złoto i napełnili swe domy srebrem;"
  },
  {
    "id": 4132,
    "book": "job                                     ",
    "chapter": "3",
    "verse": "16",
    "text": "Albo"
  },
  {
    "id": 4133,
    "book": "job                                     ",
    "chapter": "3",
    "verse": "17",
    "text": "Tam bezbożni przestają straszyć, tam pozbawieni siły odpoczywają."
  },
  {
    "id": 4134,
    "book": "job                                     ",
    "chapter": "3",
    "verse": "18",
    "text": "Tam więźniowie razem wypoczywają i nie słyszą głosu ciemięzcy."
  },
  {
    "id": 4135,
    "book": "job                                     ",
    "chapter": "3",
    "verse": "19",
    "text": "Mały i wielki"
  },
  {
    "id": 4136,
    "book": "job                                     ",
    "chapter": "3",
    "verse": "20",
    "text": "Czemu nędznemu dane jest światło, a życie"
  },
  {
    "id": 4137,
    "book": "job                                     ",
    "chapter": "3",
    "verse": "21",
    "text": "Którzy z tęsknotą wypatrują śmierci, a"
  },
  {
    "id": 4138,
    "book": "job                                     ",
    "chapter": "3",
    "verse": "22",
    "text": "Którzy wielce się radują i cieszą, kiedy grób znajdują?"
  },
  {
    "id": 4139,
    "book": "job                                     ",
    "chapter": "3",
    "verse": "23",
    "text": ""
  },
  {
    "id": 4140,
    "book": "job                                     ",
    "chapter": "3",
    "verse": "24",
    "text": "Kiedy bowiem mam jeść, przychodzi moje wzdychanie, a moje jęki rozchodzą się jak woda;"
  },
  {
    "id": 4141,
    "book": "job                                     ",
    "chapter": "3",
    "verse": "25",
    "text": "Bo to, czego się bałem, spotkało mnie, a to, czego się obawiałem, spadło na mnie."
  },
  {
    "id": 4142,
    "book": "job                                     ",
    "chapter": "3",
    "verse": "26",
    "text": "Nie byłem bezpieczny, nie miałem spokoju ani odpoczynku, a jednak nadeszła trwoga."
  }
]