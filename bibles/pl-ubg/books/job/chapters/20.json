[
  {
    "id": 4539,
    "book": "job                                     ",
    "chapter": "20",
    "verse": "1",
    "text": "Wtedy Sofar z Naama odpowiedział:"
  },
  {
    "id": 4540,
    "book": "job                                     ",
    "chapter": "20",
    "verse": "2",
    "text": "Dlatego moje myśli skłaniają mnie do odpowiedzi i z tego powodu"
  },
  {
    "id": 4541,
    "book": "job                                     ",
    "chapter": "20",
    "verse": "3",
    "text": "Słuchałem obraźliwego upomnienia i duch mojego zrozumienia podsuwa mi odpowiedź:"
  },
  {
    "id": 4542,
    "book": "job                                     ",
    "chapter": "20",
    "verse": "4",
    "text": "Czy nie wiesz, że od wieków, odkąd człowieka postawiono na ziemi;"
  },
  {
    "id": 4543,
    "book": "job                                     ",
    "chapter": "20",
    "verse": "5",
    "text": "Radość niegodziwych"
  },
  {
    "id": 4544,
    "book": "job                                     ",
    "chapter": "20",
    "verse": "6",
    "text": "Choćby jego wyniosłość sięgała aż do niebios, a jego głowa – do obłoków;"
  },
  {
    "id": 4545,
    "book": "job                                     ",
    "chapter": "20",
    "verse": "7",
    "text": ""
  },
  {
    "id": 4546,
    "book": "job                                     ",
    "chapter": "20",
    "verse": "8",
    "text": "Uleci jak sen i nie znajdą go; ucieknie jak nocne widzenie."
  },
  {
    "id": 4547,
    "book": "job                                     ",
    "chapter": "20",
    "verse": "9",
    "text": "Oko, które go widziało, nie zobaczy go więcej, i już nie ujrzy go jego miejsce."
  },
  {
    "id": 4548,
    "book": "job                                     ",
    "chapter": "20",
    "verse": "10",
    "text": "Jego synowie będą się korzyć przed ubogim, jego ręce zwrócą swe bogactwo."
  },
  {
    "id": 4549,
    "book": "job                                     ",
    "chapter": "20",
    "verse": "11",
    "text": "Jego kości są pełne"
  },
  {
    "id": 4550,
    "book": "job                                     ",
    "chapter": "20",
    "verse": "12",
    "text": "A choć zło jest słodkie w jego ustach i zataja je pod swoim językiem;"
  },
  {
    "id": 4551,
    "book": "job                                     ",
    "chapter": "20",
    "verse": "13",
    "text": "Chociaż rozkoszuje się nim i nie opuszcza go, zatrzymując je na swoim podniebieniu;"
  },
  {
    "id": 4552,
    "book": "job                                     ",
    "chapter": "20",
    "verse": "14",
    "text": ""
  },
  {
    "id": 4553,
    "book": "job                                     ",
    "chapter": "20",
    "verse": "15",
    "text": "Połknął bogactwa i zwróci je; Bóg je wyrzuci z jego brzucha."
  },
  {
    "id": 4554,
    "book": "job                                     ",
    "chapter": "20",
    "verse": "16",
    "text": "Będzie ssał jad żmii, zabije go język węża."
  },
  {
    "id": 4555,
    "book": "job                                     ",
    "chapter": "20",
    "verse": "17",
    "text": "Nie zobaczy rzek, potoków, strumieni miodu ani masła."
  },
  {
    "id": 4556,
    "book": "job                                     ",
    "chapter": "20",
    "verse": "18",
    "text": "Zwróci swój zysk i nie połknie go; i choć znowu zdobędzie wielki majątek, nie ucieszy się"
  },
  {
    "id": 4557,
    "book": "job                                     ",
    "chapter": "20",
    "verse": "19",
    "text": "Bo uciskał"
  },
  {
    "id": 4558,
    "book": "job                                     ",
    "chapter": "20",
    "verse": "20",
    "text": "Dlatego nie zazna pokoju w swoim wnętrzu, nie zatrzyma tego, czego pragnął."
  },
  {
    "id": 4559,
    "book": "job                                     ",
    "chapter": "20",
    "verse": "21",
    "text": "Z jego pokarmów nic nie zostanie, nie rozmnożą się jego dobra."
  },
  {
    "id": 4560,
    "book": "job                                     ",
    "chapter": "20",
    "verse": "22",
    "text": "Mimo obfitości jego dostatku dosięgnie go bieda. Wszelka ręka nikczemnych uderzy na niego."
  },
  {
    "id": 4561,
    "book": "job                                     ",
    "chapter": "20",
    "verse": "23",
    "text": "Gdy będzie miał czym napełnić swój brzuch,"
  },
  {
    "id": 4562,
    "book": "job                                     ",
    "chapter": "20",
    "verse": "24",
    "text": ""
  },
  {
    "id": 4563,
    "book": "job                                     ",
    "chapter": "20",
    "verse": "25",
    "text": "Wyjęta będzie"
  },
  {
    "id": 4564,
    "book": "job                                     ",
    "chapter": "20",
    "verse": "26",
    "text": "Wszelka ciemność zaczai się w jego kryjówkach. Pożre go ogień niewzniecony, a ten, kto pozostał w jego przybytku, będzie udręczony."
  },
  {
    "id": 4565,
    "book": "job                                     ",
    "chapter": "20",
    "verse": "27",
    "text": "Niebo odkryje jego nieprawość, a ziemia powstanie przeciwko niemu."
  },
  {
    "id": 4566,
    "book": "job                                     ",
    "chapter": "20",
    "verse": "28",
    "text": "Dobytek jego domu przepadnie,"
  },
  {
    "id": 4567,
    "book": "job                                     ",
    "chapter": "20",
    "verse": "29",
    "text": "Taki"
  }
]