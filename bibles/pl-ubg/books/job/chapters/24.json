[
  {
    "id": 4649,
    "book": "job                                     ",
    "chapter": "24",
    "verse": "1",
    "text": "Czemu,"
  },
  {
    "id": 4650,
    "book": "job                                     ",
    "chapter": "24",
    "verse": "2",
    "text": ""
  },
  {
    "id": 4651,
    "book": "job                                     ",
    "chapter": "24",
    "verse": "3",
    "text": "Osła sierot pędzą i wołu wdowy biorą w zastaw."
  },
  {
    "id": 4652,
    "book": "job                                     ",
    "chapter": "24",
    "verse": "4",
    "text": "Spychają z drogi ubogich, biedni ziemi"
  },
  {
    "id": 4653,
    "book": "job                                     ",
    "chapter": "24",
    "verse": "5",
    "text": "Oto jak dzikie osły na pustyni wychodzą oni do swojej pracy, wstając rano na łup. Pustynia"
  },
  {
    "id": 4654,
    "book": "job                                     ",
    "chapter": "24",
    "verse": "6",
    "text": "Na polu żną zboże i zbierają"
  },
  {
    "id": 4655,
    "book": "job                                     ",
    "chapter": "24",
    "verse": "7",
    "text": "Nagich zmuszają nocować bez ubrania, tak że nie mają czym się nakryć w czasie chłodów;"
  },
  {
    "id": 4656,
    "book": "job                                     ",
    "chapter": "24",
    "verse": "8",
    "text": "Przemoczeni ulewą górską, bez schronienia przytulają się do skały."
  },
  {
    "id": 4657,
    "book": "job                                     ",
    "chapter": "24",
    "verse": "9",
    "text": "Odrywają od piersi sieroty, od ubogiego biorą zastaw."
  },
  {
    "id": 4658,
    "book": "job                                     ",
    "chapter": "24",
    "verse": "10",
    "text": "Nagiego zmuszają do chodzenia bez ubrania, a głodnym zabierają snopy."
  },
  {
    "id": 4659,
    "book": "job                                     ",
    "chapter": "24",
    "verse": "11",
    "text": ""
  },
  {
    "id": 4660,
    "book": "job                                     ",
    "chapter": "24",
    "verse": "12",
    "text": "Ludzie w mieście wzdychają, dusze śmiertelnie rannych wołają, a Bóg im w tym nie przeszkadza."
  },
  {
    "id": 4661,
    "book": "job                                     ",
    "chapter": "24",
    "verse": "13",
    "text": "To są ci, którzy się sprzeciwiają światłości, nie znają jej dróg ani nie trwają na jej ścieżkach."
  },
  {
    "id": 4662,
    "book": "job                                     ",
    "chapter": "24",
    "verse": "14",
    "text": "Morderca wstaje przed świtem i zabija ubogiego i potrzebującego, a w nocy jest jak złodziej."
  },
  {
    "id": 4663,
    "book": "job                                     ",
    "chapter": "24",
    "verse": "15",
    "text": "Oko cudzołożnika czeka na zmierzch, mówiąc: Nikt mnie nie zobaczy, i zakrywa on"
  },
  {
    "id": 4664,
    "book": "job                                     ",
    "chapter": "24",
    "verse": "16",
    "text": "W ciemności podkopują domy, które sobie za dnia oznaczyli, nie znają światła."
  },
  {
    "id": 4665,
    "book": "job                                     ",
    "chapter": "24",
    "verse": "17",
    "text": "Dla nich bowiem poranek jest jak cień śmierci. Jeśli ktoś ich rozpozna, ogarnia ich strach cienia śmierci."
  },
  {
    "id": 4666,
    "book": "job                                     ",
    "chapter": "24",
    "verse": "18",
    "text": "Lekko unoszą się na wodach, przeklęty jest ich dział na ziemi, nie patrzą na drogę"
  },
  {
    "id": 4667,
    "book": "job                                     ",
    "chapter": "24",
    "verse": "19",
    "text": ""
  },
  {
    "id": 4668,
    "book": "job                                     ",
    "chapter": "24",
    "verse": "20",
    "text": "Zapomni o nim łono"
  },
  {
    "id": 4669,
    "book": "job                                     ",
    "chapter": "24",
    "verse": "21",
    "text": "Dręczy niepłodną, która nie rodziła, a wdowie nie czyni dobra."
  },
  {
    "id": 4670,
    "book": "job                                     ",
    "chapter": "24",
    "verse": "22",
    "text": "Pociąga też mocarzy swoją siłą;"
  },
  {
    "id": 4671,
    "book": "job                                     ",
    "chapter": "24",
    "verse": "23",
    "text": "Dano mu, że może oprzeć się bezpiecznie; jego oczy jednak"
  },
  {
    "id": 4672,
    "book": "job                                     ",
    "chapter": "24",
    "verse": "24",
    "text": "Na chwilę zostali wywyższeni, ale już"
  },
  {
    "id": 4673,
    "book": "job                                     ",
    "chapter": "24",
    "verse": "25",
    "text": "A jeśli tak nie jest, kto mi udowodni kłamstwo i obróci wniwecz moje słowa?"
  }
]