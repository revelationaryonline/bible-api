[
  {
    "id": 5047,
    "book": "job                                     ",
    "chapter": "39",
    "verse": "1",
    "text": "Czy znasz porę, kiedy rodzą górskie kozice? Czy wiesz, kiedy rodzą łanie?"
  },
  {
    "id": 5048,
    "book": "job                                     ",
    "chapter": "39",
    "verse": "2",
    "text": "Czy możesz zliczyć miesiące, w których noszą"
  },
  {
    "id": 5049,
    "book": "job                                     ",
    "chapter": "39",
    "verse": "3",
    "text": "Przykucają, rodzą swoje młode, pozbywają się ich z bólem;"
  },
  {
    "id": 5050,
    "book": "job                                     ",
    "chapter": "39",
    "verse": "4",
    "text": "Ich młode wzmacniają się, rosną wśród zboża, odchodzą i już do nich nie wracają."
  },
  {
    "id": 5051,
    "book": "job                                     ",
    "chapter": "39",
    "verse": "5",
    "text": "Kto wypuścił dzikiego osła na wolność i kto rozwiązał jego pęta?"
  },
  {
    "id": 5052,
    "book": "job                                     ",
    "chapter": "39",
    "verse": "6",
    "text": ""
  },
  {
    "id": 5053,
    "book": "job                                     ",
    "chapter": "39",
    "verse": "7",
    "text": "On naśmiewa się ze zgiełku miejskiego i nie słucha głosu poganiacza."
  },
  {
    "id": 5054,
    "book": "job                                     ",
    "chapter": "39",
    "verse": "8",
    "text": "Wypatruje w górach paszy i szuka wszelkiej zielonej trawy."
  },
  {
    "id": 5055,
    "book": "job                                     ",
    "chapter": "39",
    "verse": "9",
    "text": "Czy jednorożec zechce ci służyć albo nocować przy twoim żłobie?"
  },
  {
    "id": 5056,
    "book": "job                                     ",
    "chapter": "39",
    "verse": "10",
    "text": "Czy możesz powrozem zaprzęgać jednorożca do bruzdy? Czy będzie bronował doliny za tobą?"
  },
  {
    "id": 5057,
    "book": "job                                     ",
    "chapter": "39",
    "verse": "11",
    "text": "Czy zaufasz mu, ponieważ jego siła jest wielka? Czy powierzysz mu swoją pracę?"
  },
  {
    "id": 5058,
    "book": "job                                     ",
    "chapter": "39",
    "verse": "12",
    "text": "Czy zawierzysz mu, że zwiezie twoje ziarno i zgromadzi je w twoim spichlerzu?"
  },
  {
    "id": 5059,
    "book": "job                                     ",
    "chapter": "39",
    "verse": "13",
    "text": "Czy"
  },
  {
    "id": 5060,
    "book": "job                                     ",
    "chapter": "39",
    "verse": "14",
    "text": "Składa swoje jaja na ziemię i ogrzewa je w prochu;"
  },
  {
    "id": 5061,
    "book": "job                                     ",
    "chapter": "39",
    "verse": "15",
    "text": "I zapomina, że noga może je rozgnieść lub dzikie zwierzę może zdeptać."
  },
  {
    "id": 5062,
    "book": "job                                     ",
    "chapter": "39",
    "verse": "16",
    "text": "Jest twardy"
  },
  {
    "id": 5063,
    "book": "job                                     ",
    "chapter": "39",
    "verse": "17",
    "text": "Bo Bóg pozbawił go mądrości i nie udzielił mu rozumu."
  },
  {
    "id": 5064,
    "book": "job                                     ",
    "chapter": "39",
    "verse": "18",
    "text": "Kiedy jednak podnosi się wysoko, naśmiewa się z konia i z jego jeźdźca."
  },
  {
    "id": 5065,
    "book": "job                                     ",
    "chapter": "39",
    "verse": "19",
    "text": "Czy możesz dać koniowi moc? Czy rżeniem ozdobiłeś jego szyję?"
  },
  {
    "id": 5066,
    "book": "job                                     ",
    "chapter": "39",
    "verse": "20",
    "text": "Czy przestraszysz go jak szarańczę? Parskanie jego nozdrzy"
  },
  {
    "id": 5067,
    "book": "job                                     ",
    "chapter": "39",
    "verse": "21",
    "text": "Grzebie"
  },
  {
    "id": 5068,
    "book": "job                                     ",
    "chapter": "39",
    "verse": "22",
    "text": "Drwi sobie z lęku i nie boi się, i nie ustępuje przed ostrzem miecza."
  },
  {
    "id": 5069,
    "book": "job                                     ",
    "chapter": "39",
    "verse": "23",
    "text": "Kołczan na nim chrzęści, błyszczy oszczep i dzida."
  },
  {
    "id": 5070,
    "book": "job                                     ",
    "chapter": "39",
    "verse": "24",
    "text": "Z grzmotem i z gniewem pochłania ziemię i nie staje spokojnie na głos trąby."
  },
  {
    "id": 5071,
    "book": "job                                     ",
    "chapter": "39",
    "verse": "25",
    "text": "Na głos trąby mówi: Ha, ha; z daleka czuje bitwę, grom dowódców i okrzyk."
  },
  {
    "id": 5072,
    "book": "job                                     ",
    "chapter": "39",
    "verse": "26",
    "text": "Czy dzięki twojemu rozumowi lata jastrząb"
  },
  {
    "id": 5073,
    "book": "job                                     ",
    "chapter": "39",
    "verse": "27",
    "text": "Czy na twój rozkaz orzeł wzbija się i zakłada swoje gniazdo wysoko?"
  },
  {
    "id": 5074,
    "book": "job                                     ",
    "chapter": "39",
    "verse": "28",
    "text": "Mieszka na skale, przebywa na iglicach jak na zamku."
  },
  {
    "id": 5075,
    "book": "job                                     ",
    "chapter": "39",
    "verse": "29",
    "text": "Stamtąd wypatruje"
  },
  {
    "id": 5076,
    "book": "job                                     ",
    "chapter": "39",
    "verse": "30",
    "text": "Jego młode też piją krew, a gdzie są zabici, tam jest on."
  }
]