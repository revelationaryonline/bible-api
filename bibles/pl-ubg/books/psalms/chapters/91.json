[
  {
    "id": 25373,
    "book": "psalms                                  ",
    "chapter": "91",
    "verse": "1",
    "text": "Kto mieszka pod osłoną Najwyższego, w cieniu Wszechmocnego przebywać będzie."
  },
  {
    "id": 25374,
    "book": "psalms                                  ",
    "chapter": "91",
    "verse": "2",
    "text": "Będę mówił o PANU: Moja ucieczka i twierdza, mój Bóg, jemu będę ufał."
  },
  {
    "id": 25375,
    "book": "psalms                                  ",
    "chapter": "91",
    "verse": "3",
    "text": "Zaprawdę, on wybawi cię z sideł łowcy"
  },
  {
    "id": 25376,
    "book": "psalms                                  ",
    "chapter": "91",
    "verse": "4",
    "text": "Okryje cię swymi piórami i pod jego skrzydłami będziesz bezpieczny; jego prawda"
  },
  {
    "id": 25377,
    "book": "psalms                                  ",
    "chapter": "91",
    "verse": "5",
    "text": "Nie ulękniesz się strachu nocnego ani strzały lecącej za dnia;"
  },
  {
    "id": 25378,
    "book": "psalms                                  ",
    "chapter": "91",
    "verse": "6",
    "text": "Ani zarazy,"
  },
  {
    "id": 25379,
    "book": "psalms                                  ",
    "chapter": "91",
    "verse": "7",
    "text": "Tysiąc padnie u twego boku, a dziesięć tysięcy po twojej prawicy,"
  },
  {
    "id": 25380,
    "book": "psalms                                  ",
    "chapter": "91",
    "verse": "8",
    "text": "Tylko zobaczysz na własne oczy i ujrzysz zapłatę daną niegodziwym."
  },
  {
    "id": 25381,
    "book": "psalms                                  ",
    "chapter": "91",
    "verse": "9",
    "text": "Ponieważ PANA, moją ucieczkę"
  },
  {
    "id": 25382,
    "book": "psalms                                  ",
    "chapter": "91",
    "verse": "10",
    "text": "Nie spotka cię nic złego ani"
  },
  {
    "id": 25383,
    "book": "psalms                                  ",
    "chapter": "91",
    "verse": "11",
    "text": "Rozkaże bowiem o tobie swoim aniołom, aby cię strzegli na wszystkich twoich drogach."
  },
  {
    "id": 25384,
    "book": "psalms                                  ",
    "chapter": "91",
    "verse": "12",
    "text": "Na rękach będą cię nosić, byś przypadkiem nie uderzył swojej nogi o kamień."
  },
  {
    "id": 25385,
    "book": "psalms                                  ",
    "chapter": "91",
    "verse": "13",
    "text": "Będziesz stąpał po lwie i po żmii, lwiątko i smoka podepczesz."
  },
  {
    "id": 25386,
    "book": "psalms                                  ",
    "chapter": "91",
    "verse": "14",
    "text": "Wybawię go, bo mnie umiłował; wywyższę go, bo poznał moje imię."
  },
  {
    "id": 25387,
    "book": "psalms                                  ",
    "chapter": "91",
    "verse": "15",
    "text": "Będzie mnie wzywał, a ja go wysłucham; będę z nim w utrapieniu, wyrwę go i otoczę chwałą."
  },
  {
    "id": 25388,
    "book": "psalms                                  ",
    "chapter": "91",
    "verse": "16",
    "text": "Długimi dniami go nasycę i ukażę mu moje zbawienie."
  }
]