[
  {
    "id": 26254,
    "book": "psalms                                  ",
    "chapter": "141",
    "verse": "1",
    "text": "PANIE, wołam do ciebie, pospiesz ku mnie; wysłuchaj mego głosu, gdy wołam do ciebie."
  },
  {
    "id": 26255,
    "book": "psalms                                  ",
    "chapter": "141",
    "verse": "2",
    "text": "Niech moja modlitwa będzie przed tobą"
  },
  {
    "id": 26256,
    "book": "psalms                                  ",
    "chapter": "141",
    "verse": "3",
    "text": "PANIE, postaw straż przy moich ustach; strzeż drzwi moich warg."
  },
  {
    "id": 26257,
    "book": "psalms                                  ",
    "chapter": "141",
    "verse": "4",
    "text": "Nie skłaniaj mego serca ku złemu, abym nie popełniał czynów niegodziwych z ludźmi, którzy czynią nieprawość, i żebym się nie karmił ich rozkoszami."
  },
  {
    "id": 26258,
    "book": "psalms                                  ",
    "chapter": "141",
    "verse": "5",
    "text": "Niech mnie bije sprawiedliwy, a"
  },
  {
    "id": 26259,
    "book": "psalms                                  ",
    "chapter": "141",
    "verse": "6",
    "text": "Gdy ich sędziowie będą zrzuceni do miejsc skalistych, usłyszą moje słowa, bo są wdzięczne."
  },
  {
    "id": 26260,
    "book": "psalms                                  ",
    "chapter": "141",
    "verse": "7",
    "text": "Jak"
  },
  {
    "id": 26261,
    "book": "psalms                                  ",
    "chapter": "141",
    "verse": "8",
    "text": "Ale"
  },
  {
    "id": 26262,
    "book": "psalms                                  ",
    "chapter": "141",
    "verse": "9",
    "text": "Strzeż mnie od sidła,"
  },
  {
    "id": 26263,
    "book": "psalms                                  ",
    "chapter": "141",
    "verse": "10",
    "text": "Niech niegodziwi wpadną w swoje sieci, podczas gdy ja ujdę cało."
  }
]