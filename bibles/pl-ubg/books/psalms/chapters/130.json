[
  {
    "id": 26118,
    "book": "psalms                                  ",
    "chapter": "130",
    "verse": "1",
    "text": "Z głębokości wołam do ciebie, PANIE."
  },
  {
    "id": 26119,
    "book": "psalms                                  ",
    "chapter": "130",
    "verse": "2",
    "text": "Panie, wysłuchaj mego głosu. Nakłoń swych uszu na głos mojego błagania."
  },
  {
    "id": 26120,
    "book": "psalms                                  ",
    "chapter": "130",
    "verse": "3",
    "text": "PANIE, jeśli będziesz zważał na nieprawości, o Panie, któż się ostoi?"
  },
  {
    "id": 26121,
    "book": "psalms                                  ",
    "chapter": "130",
    "verse": "4",
    "text": "Ale u ciebie jest przebaczenie, aby się ciebie bano."
  },
  {
    "id": 26122,
    "book": "psalms                                  ",
    "chapter": "130",
    "verse": "5",
    "text": "Oczekuję PANA, moja dusza oczekuje; i w jego słowie pokładam nadzieję."
  },
  {
    "id": 26123,
    "book": "psalms                                  ",
    "chapter": "130",
    "verse": "6",
    "text": "Moja dusza"
  },
  {
    "id": 26124,
    "book": "psalms                                  ",
    "chapter": "130",
    "verse": "7",
    "text": "Niech Izrael oczekuje PANA; u PANA bowiem jest miłosierdzie i u niego obfite odkupienie."
  },
  {
    "id": 26125,
    "book": "psalms                                  ",
    "chapter": "130",
    "verse": "8",
    "text": "On sam odkupi Izraela ze wszystkich jego nieprawości."
  }
]