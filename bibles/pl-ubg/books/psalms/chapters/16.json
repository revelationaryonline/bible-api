[
  {
    "id": 24070,
    "book": "psalms                                  ",
    "chapter": "16",
    "verse": "1",
    "text": "Strzeż mnie, o Boże, bo tobie ufam."
  },
  {
    "id": 24071,
    "book": "psalms                                  ",
    "chapter": "16",
    "verse": "2",
    "text": ""
  },
  {
    "id": 24072,
    "book": "psalms                                  ",
    "chapter": "16",
    "verse": "3",
    "text": "Lecz świętym, którzy są na ziemi, i szlachetnym, w których całe moje upodobanie."
  },
  {
    "id": 24073,
    "book": "psalms                                  ",
    "chapter": "16",
    "verse": "4",
    "text": "Rozmnożą się boleści tych, którzy chodzą za obcymi"
  },
  {
    "id": 24074,
    "book": "psalms                                  ",
    "chapter": "16",
    "verse": "5",
    "text": "PAN"
  },
  {
    "id": 24075,
    "book": "psalms                                  ",
    "chapter": "16",
    "verse": "6",
    "text": "Sznury"
  },
  {
    "id": 24076,
    "book": "psalms                                  ",
    "chapter": "16",
    "verse": "7",
    "text": "Będę błogosławił PANA, który udzielił mi rady,"
  },
  {
    "id": 24077,
    "book": "psalms                                  ",
    "chapter": "16",
    "verse": "8",
    "text": "Stawiam PANA zawsze przed oczami; skoro on jest po mojej prawicy, nie zachwieję się."
  },
  {
    "id": 24078,
    "book": "psalms                                  ",
    "chapter": "16",
    "verse": "9",
    "text": "Dlatego cieszy się moje serce i raduje się moja chwała, a moje ciało będzie spoczywać bezpiecznie."
  },
  {
    "id": 24079,
    "book": "psalms                                  ",
    "chapter": "16",
    "verse": "10",
    "text": "Nie zostawisz bowiem mojej duszy w piekle ani nie dopuścisz swemu Świętemu doznać zniszczenia."
  },
  {
    "id": 24080,
    "book": "psalms                                  ",
    "chapter": "16",
    "verse": "11",
    "text": "Dasz mi poznać drogę życia, pełnię radości przed twoim obliczem, rozkosze po twojej prawicy na wieki."
  }
]