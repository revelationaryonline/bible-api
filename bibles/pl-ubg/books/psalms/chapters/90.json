[
  {
    "id": 25356,
    "book": "psalms                                  ",
    "chapter": "90",
    "verse": "1",
    "text": "Panie, ty byłeś naszą ucieczką z pokolenia na pokolenie."
  },
  {
    "id": 25357,
    "book": "psalms                                  ",
    "chapter": "90",
    "verse": "2",
    "text": "Zanim zrodziły się góry, zanim ukształtowałeś ziemię i świat, od wieków na wieki ty"
  },
  {
    "id": 25358,
    "book": "psalms                                  ",
    "chapter": "90",
    "verse": "3",
    "text": "Obracasz człowieka w proch i mówisz: Wracajcie, synowie ludzcy."
  },
  {
    "id": 25359,
    "book": "psalms                                  ",
    "chapter": "90",
    "verse": "4",
    "text": "Tysiąc lat bowiem w twoich oczach"
  },
  {
    "id": 25360,
    "book": "psalms                                  ",
    "chapter": "90",
    "verse": "5",
    "text": "Porywasz ich jakby powodzią, są"
  },
  {
    "id": 25361,
    "book": "psalms                                  ",
    "chapter": "90",
    "verse": "6",
    "text": "Rano kwitnie i rośnie,"
  },
  {
    "id": 25362,
    "book": "psalms                                  ",
    "chapter": "90",
    "verse": "7",
    "text": "Giniemy bowiem od twego gniewu i jesteśmy przerażeni twoją zapalczywością."
  },
  {
    "id": 25363,
    "book": "psalms                                  ",
    "chapter": "90",
    "verse": "8",
    "text": "Położyłeś przed sobą nasze nieprawości, nasze skryte"
  },
  {
    "id": 25364,
    "book": "psalms                                  ",
    "chapter": "90",
    "verse": "9",
    "text": "Wszystkie nasze dni przemijają z powodu twego gniewu, nasze lata nikną jak westchnienie."
  },
  {
    "id": 25365,
    "book": "psalms                                  ",
    "chapter": "90",
    "verse": "10",
    "text": "Liczbą naszych dni jest lat siedemdziesiąt, a jeśli sił starczy, lat osiemdziesiąt, a to, co w nich najlepsze, to"
  },
  {
    "id": 25366,
    "book": "psalms                                  ",
    "chapter": "90",
    "verse": "11",
    "text": "Któż zna srogość twego gniewu? Albo"
  },
  {
    "id": 25367,
    "book": "psalms                                  ",
    "chapter": "90",
    "verse": "12",
    "text": "Naucz"
  },
  {
    "id": 25368,
    "book": "psalms                                  ",
    "chapter": "90",
    "verse": "13",
    "text": "Powróć, PANIE. Jak długo"
  },
  {
    "id": 25369,
    "book": "psalms                                  ",
    "chapter": "90",
    "verse": "14",
    "text": "Nasyć nas z rana twoim miłosierdziem, abyśmy mogli się cieszyć i radować przez wszystkie nasze dni."
  },
  {
    "id": 25370,
    "book": "psalms                                  ",
    "chapter": "90",
    "verse": "15",
    "text": "Spraw nam radość według dni, w których nas trapiłeś; według lat, w których zaznaliśmy zła."
  },
  {
    "id": 25371,
    "book": "psalms                                  ",
    "chapter": "90",
    "verse": "16",
    "text": "Niech się ukaże twoim sługom twoje dzieło, a twoja chwała ich synom."
  },
  {
    "id": 25372,
    "book": "psalms                                  ",
    "chapter": "90",
    "verse": "17",
    "text": "Niech dobroć PANA, naszego Boga, będzie z nami; i utwierdź wśród nas dzieło naszych rąk; utwierdź dzieło naszych rąk!"
  }
]