[
  {
    "id": 25677,
    "book": "psalms                                  ",
    "chapter": "107",
    "verse": "1",
    "text": "Wysławiajcie PANA, bo"
  },
  {
    "id": 25678,
    "book": "psalms                                  ",
    "chapter": "107",
    "verse": "2",
    "text": "Niech"
  },
  {
    "id": 25679,
    "book": "psalms                                  ",
    "chapter": "107",
    "verse": "3",
    "text": "I zgromadził z ziem, ze wschodu i zachodu, z północy i południa."
  },
  {
    "id": 25680,
    "book": "psalms                                  ",
    "chapter": "107",
    "verse": "4",
    "text": "Błądzili po pustyni, po bezdrożnym pustkowiu, nie znajdując miasta, gdzie mogliby zamieszkać."
  },
  {
    "id": 25681,
    "book": "psalms                                  ",
    "chapter": "107",
    "verse": "5",
    "text": ""
  },
  {
    "id": 25682,
    "book": "psalms                                  ",
    "chapter": "107",
    "verse": "6",
    "text": "A gdy zawołali do PANA w swoim utrapieniu, uwolnił ich z ucisku;"
  },
  {
    "id": 25683,
    "book": "psalms                                  ",
    "chapter": "107",
    "verse": "7",
    "text": "I prowadził ich prostą drogą, aby doszli do miasta, w którym mogliby zamieszkać."
  },
  {
    "id": 25684,
    "book": "psalms                                  ",
    "chapter": "107",
    "verse": "8",
    "text": "Niech wysławiają PANA"
  },
  {
    "id": 25685,
    "book": "psalms                                  ",
    "chapter": "107",
    "verse": "9",
    "text": "Bo napoił spragnioną duszę, a głodną duszę napełnił dobrami."
  },
  {
    "id": 25686,
    "book": "psalms                                  ",
    "chapter": "107",
    "verse": "10",
    "text": "Siedzieli w ciemności i w cieniu śmierci, spętani nędzą i żelazem;"
  },
  {
    "id": 25687,
    "book": "psalms                                  ",
    "chapter": "107",
    "verse": "11",
    "text": "Bo buntowali się przeciw słowom Boga i pogardzili radą Najwyższego."
  },
  {
    "id": 25688,
    "book": "psalms                                  ",
    "chapter": "107",
    "verse": "12",
    "text": "Dlatego upokorzył ich serce trudem, upadli, a nie było nikogo, kto by im pomógł."
  },
  {
    "id": 25689,
    "book": "psalms                                  ",
    "chapter": "107",
    "verse": "13",
    "text": "A"
  },
  {
    "id": 25690,
    "book": "psalms                                  ",
    "chapter": "107",
    "verse": "14",
    "text": "Wyprowadził ich z ciemności i z cienia śmierci, a ich pęta rozerwał."
  },
  {
    "id": 25691,
    "book": "psalms                                  ",
    "chapter": "107",
    "verse": "15",
    "text": "Niech wysławiają PANA"
  },
  {
    "id": 25692,
    "book": "psalms                                  ",
    "chapter": "107",
    "verse": "16",
    "text": "Bo skruszył bramy spiżowe i połamał żelazne rygle."
  },
  {
    "id": 25693,
    "book": "psalms                                  ",
    "chapter": "107",
    "verse": "17",
    "text": "Głupcy z powodu swej występnej drogi i nieprawości doznają utrapień."
  },
  {
    "id": 25694,
    "book": "psalms                                  ",
    "chapter": "107",
    "verse": "18",
    "text": "Ich dusza brzydzi się wszelkim pokarmem i zbliżają się do bram śmierci."
  },
  {
    "id": 25695,
    "book": "psalms                                  ",
    "chapter": "107",
    "verse": "19",
    "text": "A gdy wołają do PANA w swoim utrapieniu, wybawia ich z udręczeń."
  },
  {
    "id": 25696,
    "book": "psalms                                  ",
    "chapter": "107",
    "verse": "20",
    "text": "Posłał swoje słowo i uzdrowił ich, i wybawił ich z grobu."
  },
  {
    "id": 25697,
    "book": "psalms                                  ",
    "chapter": "107",
    "verse": "21",
    "text": "Niech wysławiają PANA"
  },
  {
    "id": 25698,
    "book": "psalms                                  ",
    "chapter": "107",
    "verse": "22",
    "text": "I niech składają ofiary dziękczynienia, i głoszą z radością jego dzieła."
  },
  {
    "id": 25699,
    "book": "psalms                                  ",
    "chapter": "107",
    "verse": "23",
    "text": "Ci, którzy na statkach wyruszają w morze, handlujący na wielkich wodach;"
  },
  {
    "id": 25700,
    "book": "psalms                                  ",
    "chapter": "107",
    "verse": "24",
    "text": "Widzą dzieła PANA i jego cuda w głębinach."
  },
  {
    "id": 25701,
    "book": "psalms                                  ",
    "chapter": "107",
    "verse": "25",
    "text": "Gdy daje rozkaz, powstaje wicher i podnoszą się fale morskie."
  },
  {
    "id": 25702,
    "book": "psalms                                  ",
    "chapter": "107",
    "verse": "26",
    "text": "Oni wstępują aż"
  },
  {
    "id": 25703,
    "book": "psalms                                  ",
    "chapter": "107",
    "verse": "27",
    "text": "Chwieją się i zataczają jak pijany, a cała ich mądrość zanika."
  },
  {
    "id": 25704,
    "book": "psalms                                  ",
    "chapter": "107",
    "verse": "28",
    "text": "Gdy wołają do PANA w swoim utrapieniu, wybawia ich z udręczeń."
  },
  {
    "id": 25705,
    "book": "psalms                                  ",
    "chapter": "107",
    "verse": "29",
    "text": "Zamienia burzę w ciszę, tak że uspokajają się jej fale."
  },
  {
    "id": 25706,
    "book": "psalms                                  ",
    "chapter": "107",
    "verse": "30",
    "text": "Wtedy oni weselą się, że ucichły; i tak przyprowadza ich do upragnionego portu."
  },
  {
    "id": 25707,
    "book": "psalms                                  ",
    "chapter": "107",
    "verse": "31",
    "text": "Niech wysławiają PANA"
  },
  {
    "id": 25708,
    "book": "psalms                                  ",
    "chapter": "107",
    "verse": "32",
    "text": "Niech go wywyższają w zgromadzeniu ludu i w radzie starszych niech go chwalą."
  },
  {
    "id": 25709,
    "book": "psalms                                  ",
    "chapter": "107",
    "verse": "33",
    "text": "Zamienia rzeki w pustynię, a źródła wód w suchą ziemię;"
  },
  {
    "id": 25710,
    "book": "psalms                                  ",
    "chapter": "107",
    "verse": "34",
    "text": "Ziemię urodzajną"
  },
  {
    "id": 25711,
    "book": "psalms                                  ",
    "chapter": "107",
    "verse": "35",
    "text": "Pustynię zamienia w jezioro, a suchą ziemię w źródła wód."
  },
  {
    "id": 25712,
    "book": "psalms                                  ",
    "chapter": "107",
    "verse": "36",
    "text": "I osadza tam głodnych, aby zakładali miasta do zamieszkania;"
  },
  {
    "id": 25713,
    "book": "psalms                                  ",
    "chapter": "107",
    "verse": "37",
    "text": "I obsiewali pole, sadzili winnice i zbierali obfity plon."
  },
  {
    "id": 25714,
    "book": "psalms                                  ",
    "chapter": "107",
    "verse": "38",
    "text": "Błogosławi im tak, że bardzo się rozmnażają, i nie zmniejsza"
  },
  {
    "id": 25715,
    "book": "psalms                                  ",
    "chapter": "107",
    "verse": "39",
    "text": "Ale potem maleje ich liczba i upokorzeni są uciskiem, nędzą i utrapieniem;"
  },
  {
    "id": 25716,
    "book": "psalms                                  ",
    "chapter": "107",
    "verse": "40",
    "text": "On wylewa wzgardę na władców i sprawia, że błądzą po bezdrożach pustkowia."
  },
  {
    "id": 25717,
    "book": "psalms                                  ",
    "chapter": "107",
    "verse": "41",
    "text": "Lecz podnosi nędznego z utrapienia i rozmnaża"
  },
  {
    "id": 25718,
    "book": "psalms                                  ",
    "chapter": "107",
    "verse": "42",
    "text": "Widząc to, prawi rozweselą się, a wszelka nieprawość zamknie swe usta."
  },
  {
    "id": 25719,
    "book": "psalms                                  ",
    "chapter": "107",
    "verse": "43",
    "text": "Kto jest tak mądry, aby tego upatrywał i rozumiał litość PANA?"
  }
]