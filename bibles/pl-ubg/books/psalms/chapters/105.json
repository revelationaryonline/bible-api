[
  {
    "id": 25584,
    "book": "psalms                                  ",
    "chapter": "105",
    "verse": "1",
    "text": "Wysławiajcie PANA, wzywajcie jego imienia, opowiadajcie jego dzieła wśród narodów."
  },
  {
    "id": 25585,
    "book": "psalms                                  ",
    "chapter": "105",
    "verse": "2",
    "text": "Śpiewajcie mu, śpiewajcie mu psalmy, rozmawiajcie o wszystkich jego cudach."
  },
  {
    "id": 25586,
    "book": "psalms                                  ",
    "chapter": "105",
    "verse": "3",
    "text": "Chlubcie się jego świętym imieniem, niech się weseli serce szukających PANA."
  },
  {
    "id": 25587,
    "book": "psalms                                  ",
    "chapter": "105",
    "verse": "4",
    "text": "Szukajcie PANA i jego mocy, szukajcie zawsze jego oblicza."
  },
  {
    "id": 25588,
    "book": "psalms                                  ",
    "chapter": "105",
    "verse": "5",
    "text": "Przypominajcie sobie dzieła, które czynił; jego cuda i wyroki jego ust."
  },
  {
    "id": 25589,
    "book": "psalms                                  ",
    "chapter": "105",
    "verse": "6",
    "text": ""
  },
  {
    "id": 25590,
    "book": "psalms                                  ",
    "chapter": "105",
    "verse": "7",
    "text": "On jest PANEM, naszym Bogiem, jego sądy po całej ziemi."
  },
  {
    "id": 25591,
    "book": "psalms                                  ",
    "chapter": "105",
    "verse": "8",
    "text": "Pamięta wiecznie o swoim przymierzu; o słowie, które nakazał po tysiąc pokoleń;"
  },
  {
    "id": 25592,
    "book": "psalms                                  ",
    "chapter": "105",
    "verse": "9",
    "text": ""
  },
  {
    "id": 25593,
    "book": "psalms                                  ",
    "chapter": "105",
    "verse": "10",
    "text": "Ustanowił je jako prawo dla Jakuba, dla Izraela jako wieczne przymierze;"
  },
  {
    "id": 25594,
    "book": "psalms                                  ",
    "chapter": "105",
    "verse": "11",
    "text": "Mówiąc: Tobie dam ziemię Kanaan jako dział waszego dziedzictwa;"
  },
  {
    "id": 25595,
    "book": "psalms                                  ",
    "chapter": "105",
    "verse": "12",
    "text": "Kiedy ich było niewielu, nieliczni i obcy w niej."
  },
  {
    "id": 25596,
    "book": "psalms                                  ",
    "chapter": "105",
    "verse": "13",
    "text": "I wędrowali od narodu do narodu, z"
  },
  {
    "id": 25597,
    "book": "psalms                                  ",
    "chapter": "105",
    "verse": "14",
    "text": "Nikomu nie pozwolił ich krzywdzić, nawet karcił królów z ich powodu,"
  },
  {
    "id": 25598,
    "book": "psalms                                  ",
    "chapter": "105",
    "verse": "15",
    "text": "Nie dotykajcie moich pomazańców, a moim prorokom nie czyńcie"
  },
  {
    "id": 25599,
    "book": "psalms                                  ",
    "chapter": "105",
    "verse": "16",
    "text": "Potem przywołał głód na ziemię i zniszczył cały zapas chleba."
  },
  {
    "id": 25600,
    "book": "psalms                                  ",
    "chapter": "105",
    "verse": "17",
    "text": "Posłał przed nimi męża, Józefa, który został sprzedany jako niewolnik;"
  },
  {
    "id": 25601,
    "book": "psalms                                  ",
    "chapter": "105",
    "verse": "18",
    "text": "Którego nogi ranili pętami, a w żelazo zakuto jego ciało;"
  },
  {
    "id": 25602,
    "book": "psalms                                  ",
    "chapter": "105",
    "verse": "19",
    "text": "Aż do"
  },
  {
    "id": 25603,
    "book": "psalms                                  ",
    "chapter": "105",
    "verse": "20",
    "text": "Posłał król i kazał go uwolnić, władca narodu wypuścił go na wolność."
  },
  {
    "id": 25604,
    "book": "psalms                                  ",
    "chapter": "105",
    "verse": "21",
    "text": "Ustanowił go panem swego domu i władcą wszystkich swoich posiadłości;"
  },
  {
    "id": 25605,
    "book": "psalms                                  ",
    "chapter": "105",
    "verse": "22",
    "text": "Aby rządził jego dostojnikami według swego uznania i jego starszych nauczał mądrości."
  },
  {
    "id": 25606,
    "book": "psalms                                  ",
    "chapter": "105",
    "verse": "23",
    "text": "Potem Izrael wszedł do Egiptu, a Jakub był gościem w ziemi Chama;"
  },
  {
    "id": 25607,
    "book": "psalms                                  ",
    "chapter": "105",
    "verse": "24",
    "text": "Gdzie"
  },
  {
    "id": 25608,
    "book": "psalms                                  ",
    "chapter": "105",
    "verse": "25",
    "text": "Odmienił ich serca, żeby znienawidzili jego lud i postępowali przebiegle wobec jego sług."
  },
  {
    "id": 25609,
    "book": "psalms                                  ",
    "chapter": "105",
    "verse": "26",
    "text": "Posłał Mojżesza, swego sługę, i Aarona, którego wybrał;"
  },
  {
    "id": 25610,
    "book": "psalms                                  ",
    "chapter": "105",
    "verse": "27",
    "text": "Pokazali im jego znaki i cuda w ziemi Chama."
  },
  {
    "id": 25611,
    "book": "psalms                                  ",
    "chapter": "105",
    "verse": "28",
    "text": "Zesłał ciemności i nastał mrok, i nie buntowali się przeciw jego słowu."
  },
  {
    "id": 25612,
    "book": "psalms                                  ",
    "chapter": "105",
    "verse": "29",
    "text": "Zamienił ich wody w krew i pozabijał ich ryby."
  },
  {
    "id": 25613,
    "book": "psalms                                  ",
    "chapter": "105",
    "verse": "30",
    "text": "Ich ziemia wydała mnóstwo żab,"
  },
  {
    "id": 25614,
    "book": "psalms                                  ",
    "chapter": "105",
    "verse": "31",
    "text": "Rozkazał i zjawiły się rozmaite muchy i wszy w całym ich kraju."
  },
  {
    "id": 25615,
    "book": "psalms                                  ",
    "chapter": "105",
    "verse": "32",
    "text": "Zesłał grad zamiast deszczu, ogień płonący na ich ziemię."
  },
  {
    "id": 25616,
    "book": "psalms                                  ",
    "chapter": "105",
    "verse": "33",
    "text": "Zniszczył ich winnice i figowce i połamał drzewa w ich kraju."
  },
  {
    "id": 25617,
    "book": "psalms                                  ",
    "chapter": "105",
    "verse": "34",
    "text": "Rozkazał i zjawiła się szarańcza, niezliczone mnóstwo larw;"
  },
  {
    "id": 25618,
    "book": "psalms                                  ",
    "chapter": "105",
    "verse": "35",
    "text": "I pożarły całą zieleń w ich kraju, i zjadły płody ich ziemi."
  },
  {
    "id": 25619,
    "book": "psalms                                  ",
    "chapter": "105",
    "verse": "36",
    "text": "Zabił też wszystko, co pierworodne w ich ziemi, pierwociny wszelkiej ich siły."
  },
  {
    "id": 25620,
    "book": "psalms                                  ",
    "chapter": "105",
    "verse": "37",
    "text": "Wyprowadził ich ze srebrem i złotem i nie było słabego wśród ich plemion."
  },
  {
    "id": 25621,
    "book": "psalms                                  ",
    "chapter": "105",
    "verse": "38",
    "text": "Egipt się radował, gdy wychodzili, bo ogarnął go strach przed nimi."
  },
  {
    "id": 25622,
    "book": "psalms                                  ",
    "chapter": "105",
    "verse": "39",
    "text": "Rozpostarł obłok jak osłonę, a ogień, by świecił w nocy."
  },
  {
    "id": 25623,
    "book": "psalms                                  ",
    "chapter": "105",
    "verse": "40",
    "text": "Na"
  },
  {
    "id": 25624,
    "book": "psalms                                  ",
    "chapter": "105",
    "verse": "41",
    "text": "Otworzył skałę i trysnęły wody, popłynęły po suchych miejscach"
  },
  {
    "id": 25625,
    "book": "psalms                                  ",
    "chapter": "105",
    "verse": "42",
    "text": "Pamiętał bowiem o swoim świętym słowie i o Abrahamie, swym słudze."
  },
  {
    "id": 25626,
    "book": "psalms                                  ",
    "chapter": "105",
    "verse": "43",
    "text": "Wyprowadził swój lud wśród wesela, swoich wybranych wśród radości."
  },
  {
    "id": 25627,
    "book": "psalms                                  ",
    "chapter": "105",
    "verse": "44",
    "text": "I dał im ziemię pogan, i zawładnęli dorobkiem narodów;"
  },
  {
    "id": 25628,
    "book": "psalms                                  ",
    "chapter": "105",
    "verse": "45",
    "text": "Aby zachowywali jego nakazy i przestrzegali jego praw. Alleluja."
  }
]