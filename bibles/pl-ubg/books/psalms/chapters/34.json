[
  {
    "id": 24366,
    "book": "psalms                                  ",
    "chapter": "34",
    "verse": "1",
    "text": "Będę błogosławił PANA w każdym czasie, jego chwała zawsze"
  },
  {
    "id": 24367,
    "book": "psalms                                  ",
    "chapter": "34",
    "verse": "2",
    "text": "Moja dusza będzie się chlubić PANEM; pokorni"
  },
  {
    "id": 24368,
    "book": "psalms                                  ",
    "chapter": "34",
    "verse": "3",
    "text": "Uwielbiajcie PANA ze mną i wspólnie wywyższajmy jego imię."
  },
  {
    "id": 24369,
    "book": "psalms                                  ",
    "chapter": "34",
    "verse": "4",
    "text": "Szukałem PANA, a on mnie wysłuchał i uwolnił od wszystkich mych trwóg."
  },
  {
    "id": 24370,
    "book": "psalms                                  ",
    "chapter": "34",
    "verse": "5",
    "text": "Spojrzeli na niego i rozpromienili się, a ich oblicza nie doznały wstydu."
  },
  {
    "id": 24371,
    "book": "psalms                                  ",
    "chapter": "34",
    "verse": "6",
    "text": "Ten oto biedak wołał, a PAN wysłuchał i wybawił go ze wszystkich jego utrapień."
  },
  {
    "id": 24372,
    "book": "psalms                                  ",
    "chapter": "34",
    "verse": "7",
    "text": "Anioł PANA rozbija obóz dokoła tych, którzy się go boją, i wybawia ich."
  },
  {
    "id": 24373,
    "book": "psalms                                  ",
    "chapter": "34",
    "verse": "8",
    "text": "Skosztujcie i zobaczcie, jak dobry jest PAN: Błogosławiony człowiek, który mu ufa."
  },
  {
    "id": 24374,
    "book": "psalms                                  ",
    "chapter": "34",
    "verse": "9",
    "text": "Bójcie się PANA, jego święci, bo niczego nie braknie tym, którzy się go boją."
  },
  {
    "id": 24375,
    "book": "psalms                                  ",
    "chapter": "34",
    "verse": "10",
    "text": "Lwięta cierpią niedostatek i głód, lecz szukającym PANA nie zabraknie żadnego dobra."
  },
  {
    "id": 24376,
    "book": "psalms                                  ",
    "chapter": "34",
    "verse": "11",
    "text": "Chodźcie, synowie, słuchajcie mnie; nauczę was bojaźni PANA."
  },
  {
    "id": 24377,
    "book": "psalms                                  ",
    "chapter": "34",
    "verse": "12",
    "text": "Który człowiek chce"
  },
  {
    "id": 24378,
    "book": "psalms                                  ",
    "chapter": "34",
    "verse": "13",
    "text": "Strzeż swego języka od zła, a swoich warg od podstępnej mowy."
  },
  {
    "id": 24379,
    "book": "psalms                                  ",
    "chapter": "34",
    "verse": "14",
    "text": "Odwróć się od zła i czyń dobrze, szukaj pokoju i dąż do niego."
  },
  {
    "id": 24380,
    "book": "psalms                                  ",
    "chapter": "34",
    "verse": "15",
    "text": "Oczy PANA"
  },
  {
    "id": 24381,
    "book": "psalms                                  ",
    "chapter": "34",
    "verse": "16",
    "text": ""
  },
  {
    "id": 24382,
    "book": "psalms                                  ",
    "chapter": "34",
    "verse": "17",
    "text": "Wołają"
  },
  {
    "id": 24383,
    "book": "psalms                                  ",
    "chapter": "34",
    "verse": "18",
    "text": "Bliski"
  },
  {
    "id": 24384,
    "book": "psalms                                  ",
    "chapter": "34",
    "verse": "19",
    "text": "Liczne"
  },
  {
    "id": 24385,
    "book": "psalms                                  ",
    "chapter": "34",
    "verse": "20",
    "text": "On strzeże wszystkich jego kości; ani jedna z nich nie będzie złamana."
  },
  {
    "id": 24386,
    "book": "psalms                                  ",
    "chapter": "34",
    "verse": "21",
    "text": "Zło zabija niegodziwego i ci, którzy nienawidzą sprawiedliwego, będą zniszczeni;"
  },
  {
    "id": 24387,
    "book": "psalms                                  ",
    "chapter": "34",
    "verse": "22",
    "text": "PAN odkupi dusze swoich sług i nie będą zniszczeni ci, którzy mu ufają."
  }
]