[
  {
    "id": 23943,
    "book": "psalms                                  ",
    "chapter": "4",
    "verse": "1",
    "text": "Wysłuchaj mnie, gdy"
  },
  {
    "id": 23944,
    "book": "psalms                                  ",
    "chapter": "4",
    "verse": "2",
    "text": "Synowie ludzcy, jak długo"
  },
  {
    "id": 23945,
    "book": "psalms                                  ",
    "chapter": "4",
    "verse": "3",
    "text": "Wiedzcie, że PAN oddzielił dla siebie pobożnego. PAN wysłucha, gdy zawołam do niego."
  },
  {
    "id": 23946,
    "book": "psalms                                  ",
    "chapter": "4",
    "verse": "4",
    "text": "Zadrżyjcie i nie grzeszcie. Rozmyślajcie w swym sercu na łożu i zamilczcie. Sela."
  },
  {
    "id": 23947,
    "book": "psalms                                  ",
    "chapter": "4",
    "verse": "5",
    "text": "Składajcie ofiary sprawiedliwości i ufajcie PANU."
  },
  {
    "id": 23948,
    "book": "psalms                                  ",
    "chapter": "4",
    "verse": "6",
    "text": "Wielu mówi: Któż pokaże nam dobro? PANIE, wznieś nad nami światło twego oblicza."
  },
  {
    "id": 23949,
    "book": "psalms                                  ",
    "chapter": "4",
    "verse": "7",
    "text": "Wlałeś w moje serce więcej radości niż w czasie, gdy obfitowały ich zboże i wino."
  },
  {
    "id": 23950,
    "book": "psalms                                  ",
    "chapter": "4",
    "verse": "8",
    "text": "W spokoju się położę i zasnę, bo ty sam, PANIE, sprawiasz, że mieszkam bezpiecznie."
  }
]