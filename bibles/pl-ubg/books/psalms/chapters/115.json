[
  {
    "id": 25808,
    "book": "psalms                                  ",
    "chapter": "115",
    "verse": "1",
    "text": "Nie nam, PANIE, nie nam, ale twemu imieniu daj chwałę za twoje miłosierdzie"
  },
  {
    "id": 25809,
    "book": "psalms                                  ",
    "chapter": "115",
    "verse": "2",
    "text": "Czemu mają mówić poganie: Gdzież teraz"
  },
  {
    "id": 25810,
    "book": "psalms                                  ",
    "chapter": "115",
    "verse": "3",
    "text": "A nasz Bóg"
  },
  {
    "id": 25811,
    "book": "psalms                                  ",
    "chapter": "115",
    "verse": "4",
    "text": "Ich bożki"
  },
  {
    "id": 25812,
    "book": "psalms                                  ",
    "chapter": "115",
    "verse": "5",
    "text": "Usta mają, ale nie mówią; mają oczy, ale nie widzą."
  },
  {
    "id": 25813,
    "book": "psalms                                  ",
    "chapter": "115",
    "verse": "6",
    "text": "Uszy mają, ale nie słyszą; mają nozdrza, ale nie czują."
  },
  {
    "id": 25814,
    "book": "psalms                                  ",
    "chapter": "115",
    "verse": "7",
    "text": "Ręce mają, ale nie dotykają; mają nogi, ale nie chodzą; ani gardłem swoim nie wydają głosu."
  },
  {
    "id": 25815,
    "book": "psalms                                  ",
    "chapter": "115",
    "verse": "8",
    "text": "Niech będą do nich podobni ci, którzy je robią,"
  },
  {
    "id": 25816,
    "book": "psalms                                  ",
    "chapter": "115",
    "verse": "9",
    "text": "Izraelu, ufaj PANU; on jest ich pomocą i tarczą."
  },
  {
    "id": 25817,
    "book": "psalms                                  ",
    "chapter": "115",
    "verse": "10",
    "text": "Domu Aarona, ufaj PANU; on jest ich pomocą i tarczą."
  },
  {
    "id": 25818,
    "book": "psalms                                  ",
    "chapter": "115",
    "verse": "11",
    "text": "Wy, którzy się boicie PANA, ufajcie PANU; on jest ich pomocą i tarczą."
  },
  {
    "id": 25819,
    "book": "psalms                                  ",
    "chapter": "115",
    "verse": "12",
    "text": "PAN pamięta o nas, będzie błogosławił; będzie błogosławił domowi Izraela, będzie błogosławił domowi Aarona."
  },
  {
    "id": 25820,
    "book": "psalms                                  ",
    "chapter": "115",
    "verse": "13",
    "text": "Będzie błogosławił tym, którzy boją się PANA, i małym, i wielkim."
  },
  {
    "id": 25821,
    "book": "psalms                                  ",
    "chapter": "115",
    "verse": "14",
    "text": "Rozmnoży was PAN, was i waszych synów."
  },
  {
    "id": 25822,
    "book": "psalms                                  ",
    "chapter": "115",
    "verse": "15",
    "text": "Błogosławieni jesteście przez PANA, który stworzył niebo i ziemię."
  },
  {
    "id": 25823,
    "book": "psalms                                  ",
    "chapter": "115",
    "verse": "16",
    "text": "Niebiosa są niebiosami PANA, ale ziemię dał synom ludzkim."
  },
  {
    "id": 25824,
    "book": "psalms                                  ",
    "chapter": "115",
    "verse": "17",
    "text": "Umarli nie będą chwalili PANA ani nikt z tych, którzy zstępują do"
  },
  {
    "id": 25825,
    "book": "psalms                                  ",
    "chapter": "115",
    "verse": "18",
    "text": "Ale my będziemy błogosławili PANA, odtąd aż na wieki. Alleluja."
  }
]