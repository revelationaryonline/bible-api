    "chapter": "29",
    "verse": "1",
    "text": "Oddajcie PANU, synowie mocarzy, oddajcie PANU chwałę i moc."
  },
  {
    "id": 24287,
    "book": "psalms                                  ",
    "chapter": "29",
    "verse": "2",
    "text": "Oddajcie PANU chwałę"
  },
  {
    "id": 24288,
    "book": "psalms                                  ",
    "chapter": "29",
    "verse": "3",
    "text": "Głos PANA nad wodami; zagrzmiał Bóg chwały, PAN nad wielkimi wodami."
  },
  {
    "id": 24289,
    "book": "psalms                                  ",
    "chapter": "29",
    "verse": "4",
    "text": "Głos PANA potężny, głos PANA pełen majestatu."
  },
  {
    "id": 24290,
    "book": "psalms                                  ",
    "chapter": "29",
    "verse": "5",
    "text": "Głos PANA łamie cedry, PAN łamie cedry Libanu;"
  },
  {
    "id": 24291,
    "book": "psalms                                  ",
    "chapter": "29",
    "verse": "6",
    "text": "I sprawia, że skaczą jak cielę, Liban i Sirion jak młody jednorożec."
  },
  {
    "id": 24292,
    "book": "psalms                                  ",
    "chapter": "29",
    "verse": "7",
    "text": "Głos PANA krzesze płomienie ognia."
  },
  {
    "id": 24293,
    "book": "psalms                                  ",
    "chapter": "29",
    "verse": "8",
    "text": "Głos PANA wstrząsa pustynią, PAN wstrząsa pustynią Kadesz."
  },
  {
    "id": 24294,
    "book": "psalms                                  ",
    "chapter": "29",
    "verse": "9",
    "text": "Głos PANA sprawia, że z bólem rodzą łanie i ogołacają się lasy, a w jego świątyni każdy opowiada o"
  },
  {
    "id": 24295,
    "book": "psalms                                  ",
    "chapter": "29",
    "verse": "10",
    "text": "PAN zasiada nad potopem, PAN zasiada"
  },
  {
    "id": 24296,
    "book": "psalms                                  ",
    "chapter": "29",
    "verse": "11",
    "text": "PAN doda mocy swojemu ludowi, PAN pobłogosławi swój lud pokojem."
  }
]