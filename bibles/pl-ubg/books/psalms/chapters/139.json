[
  {
    "id": 26217,
    "book": "psalms                                  ",
    "chapter": "139",
    "verse": "1",
    "text": "PANIE, przeniknąłeś"
  },
  {
    "id": 26218,
    "book": "psalms                                  ",
    "chapter": "139",
    "verse": "2",
    "text": "Wiesz, kiedy siedzę i wstaję, z daleka znasz moje myśli."
  },
  {
    "id": 26219,
    "book": "psalms                                  ",
    "chapter": "139",
    "verse": "3",
    "text": "Otaczasz moją ścieżkę i spoczynek, wszystkie moje drogi są ci znane."
  },
  {
    "id": 26220,
    "book": "psalms                                  ",
    "chapter": "139",
    "verse": "4",
    "text": "Zanim na"
  },
  {
    "id": 26221,
    "book": "psalms                                  ",
    "chapter": "139",
    "verse": "5",
    "text": "Otaczasz mnie z tyłu i z przodu i położyłeś na mnie twoją rękę."
  },
  {
    "id": 26222,
    "book": "psalms                                  ",
    "chapter": "139",
    "verse": "6",
    "text": "Zbyt cudowna jest dla mnie"
  },
  {
    "id": 26223,
    "book": "psalms                                  ",
    "chapter": "139",
    "verse": "7",
    "text": "Dokąd ujdę przed twoim duchem? Dokąd ucieknę przed twoim obliczem?"
  },
  {
    "id": 26224,
    "book": "psalms                                  ",
    "chapter": "139",
    "verse": "8",
    "text": "Jeśli wstąpię do nieba,"
  },
  {
    "id": 26225,
    "book": "psalms                                  ",
    "chapter": "139",
    "verse": "9",
    "text": "Gdybym wziął skrzydła zorzy porannej, aby zamieszkać na krańcu morza;"
  },
  {
    "id": 26226,
    "book": "psalms                                  ",
    "chapter": "139",
    "verse": "10",
    "text": "I tam twoja ręka prowadziłaby mnie i twoja prawica by mnie podtrzymała."
  },
  {
    "id": 26227,
    "book": "psalms                                  ",
    "chapter": "139",
    "verse": "11",
    "text": "Jeśli powiem: Na pewno zakryją mnie ciemności, to i noc"
  },
  {
    "id": 26228,
    "book": "psalms                                  ",
    "chapter": "139",
    "verse": "12",
    "text": "Nawet ciemność"
  },
  {
    "id": 26229,
    "book": "psalms                                  ",
    "chapter": "139",
    "verse": "13",
    "text": "Ty bowiem panujesz nad moimi nerkami; okryłeś mnie w łonie mojej matki."
  },
  {
    "id": 26230,
    "book": "psalms                                  ",
    "chapter": "139",
    "verse": "14",
    "text": "Wysławiam cię, bo zostałem stworzony w sposób zadziwiający i cudowny; przedziwne są twoje dzieła, a moja dusza zna"
  },
  {
    "id": 26231,
    "book": "psalms                                  ",
    "chapter": "139",
    "verse": "15",
    "text": "Żadna moja kość nie była zakryta przed tobą, gdy zostałem stworzony w skrytości i misternie złożony w głębiach ziemi."
  },
  {
    "id": 26232,
    "book": "psalms                                  ",
    "chapter": "139",
    "verse": "16",
    "text": "Twoje oczy widziały niedoskonały płód mego"
  },
  {
    "id": 26233,
    "book": "psalms                                  ",
    "chapter": "139",
    "verse": "17",
    "text": "Jak drogie są dla mnie twoje myśli, Boże! Jak wielka jest ich liczba!"
  },
  {
    "id": 26234,
    "book": "psalms                                  ",
    "chapter": "139",
    "verse": "18",
    "text": "Gdybym chciał je zliczyć, byłoby ich więcej niż piasku; gdy się budzę, jeszcze jestem z tobą."
  },
  {
    "id": 26235,
    "book": "psalms                                  ",
    "chapter": "139",
    "verse": "19",
    "text": "Zgładzisz, Boże, niegodziwego; niech odstąpią ode mnie ludzie krwawi;"
  },
  {
    "id": 26236,
    "book": "psalms                                  ",
    "chapter": "139",
    "verse": "20",
    "text": ""
  },
  {
    "id": 26237,
    "book": "psalms                                  ",
    "chapter": "139",
    "verse": "21",
    "text": "Czy nie nienawidzę tych, PANIE, którzy nienawidzą ciebie? I nie brzydzę się tymi, którzy przeciwko tobie powstają?"
  },
  {
    "id": 26238,
    "book": "psalms                                  ",
    "chapter": "139",
    "verse": "22",
    "text": "Nienawidzę ich pełnią nienawiści i mam"
  },
  {
    "id": 26239,
    "book": "psalms                                  ",
    "chapter": "139",
    "verse": "23",
    "text": "Przeniknij mnie, Boże, i poznaj moje serce; wypróbuj mnie i poznaj moje myśli;"
  },
  {
    "id": 26240,
    "book": "psalms                                  ",
    "chapter": "139",
    "verse": "24",
    "text": "I zobacz, czy"
  }
]