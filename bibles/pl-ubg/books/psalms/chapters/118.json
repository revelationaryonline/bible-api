[
  {
    "id": 25847,
    "book": "psalms                                  ",
    "chapter": "118",
    "verse": "1",
    "text": "Wysławiajcie PANA, bo jest dobry, bo jego miłosierdzie"
  },
  {
    "id": 25848,
    "book": "psalms                                  ",
    "chapter": "118",
    "verse": "2",
    "text": "Niech powie teraz Izrael, że jego miłosierdzie"
  },
  {
    "id": 25849,
    "book": "psalms                                  ",
    "chapter": "118",
    "verse": "3",
    "text": "Niech powie teraz dom Aarona, że jego miłosierdzie"
  },
  {
    "id": 25850,
    "book": "psalms                                  ",
    "chapter": "118",
    "verse": "4",
    "text": "Niech powiedzą teraz ci, którzy się boją PANA, że jego miłosierdzie"
  },
  {
    "id": 25851,
    "book": "psalms                                  ",
    "chapter": "118",
    "verse": "5",
    "text": "Wzywałem PANA w ucisku; PAN mnie wysłuchał i postawił mnie na miejscu przestronnym."
  },
  {
    "id": 25852,
    "book": "psalms                                  ",
    "chapter": "118",
    "verse": "6",
    "text": "PAN jest ze mną, nie będę się bał; cóż może mi uczynić człowiek?"
  },
  {
    "id": 25853,
    "book": "psalms                                  ",
    "chapter": "118",
    "verse": "7",
    "text": "PAN jest ze mną wśród tych, którzy mi pomagają, więc zobaczę"
  },
  {
    "id": 25854,
    "book": "psalms                                  ",
    "chapter": "118",
    "verse": "8",
    "text": "Lepiej ufać PANU, niż polegać na człowieku."
  },
  {
    "id": 25855,
    "book": "psalms                                  ",
    "chapter": "118",
    "verse": "9",
    "text": "Lepiej ufać PANU, niż polegać na władcach."
  },
  {
    "id": 25856,
    "book": "psalms                                  ",
    "chapter": "118",
    "verse": "10",
    "text": "Wszystkie narody mnie otoczyły, ale w imię PANA wytępiłem je."
  },
  {
    "id": 25857,
    "book": "psalms                                  ",
    "chapter": "118",
    "verse": "11",
    "text": "Otoczyły mnie, tak, otoczyły mnie, ale w imię PANA wytępiłem je."
  },
  {
    "id": 25858,
    "book": "psalms                                  ",
    "chapter": "118",
    "verse": "12",
    "text": "Otoczyły mnie jak pszczoły, ale zgasły"
  },
  {
    "id": 25859,
    "book": "psalms                                  ",
    "chapter": "118",
    "verse": "13",
    "text": "Pchnąłeś mnie silnie, abym upadł, ale PAN mi pomógł."
  },
  {
    "id": 25860,
    "book": "psalms                                  ",
    "chapter": "118",
    "verse": "14",
    "text": "PAN"
  },
  {
    "id": 25861,
    "book": "psalms                                  ",
    "chapter": "118",
    "verse": "15",
    "text": "Głos radości i zbawienia w namiotach sprawiedliwych: Prawica PANA działa potężnie;"
  },
  {
    "id": 25862,
    "book": "psalms                                  ",
    "chapter": "118",
    "verse": "16",
    "text": "Prawica PANA jest wywyższona, prawica PANA działa potężnie."
  },
  {
    "id": 25863,
    "book": "psalms                                  ",
    "chapter": "118",
    "verse": "17",
    "text": "Nie umrę, lecz będę żył i opowiadał dzieła PANA."
  },
  {
    "id": 25864,
    "book": "psalms                                  ",
    "chapter": "118",
    "verse": "18",
    "text": "PAN ukarał mnie surowo, ale nie wydał mnie na śmierć."
  },
  {
    "id": 25865,
    "book": "psalms                                  ",
    "chapter": "118",
    "verse": "19",
    "text": "Otwórzcie mi bramy sprawiedliwości, a wejdę w nie i będę wysławiał PANA."
  },
  {
    "id": 25866,
    "book": "psalms                                  ",
    "chapter": "118",
    "verse": "20",
    "text": "To jest brama PANA, którą wchodzą sprawiedliwi."
  },
  {
    "id": 25867,
    "book": "psalms                                  ",
    "chapter": "118",
    "verse": "21",
    "text": "Będę cię wysławiać, bo mnie wysłuchałeś i stałeś się moim zbawieniem."
  },
  {
    "id": 25868,
    "book": "psalms                                  ",
    "chapter": "118",
    "verse": "22",
    "text": "Kamień,"
  },
  {
    "id": 25869,
    "book": "psalms                                  ",
    "chapter": "118",
    "verse": "23",
    "text": "PAN to sprawił i jest to cudowne w naszych oczach."
  },
  {
    "id": 25870,
    "book": "psalms                                  ",
    "chapter": "118",
    "verse": "24",
    "text": "Oto dzień, który PAN uczynił, weselmy się i radujmy się w nim."
  },
  {
    "id": 25871,
    "book": "psalms                                  ",
    "chapter": "118",
    "verse": "25",
    "text": "Proszę, PANIE, wybaw teraz; proszę, PANIE, daj pomyślność."
  },
  {
    "id": 25872,
    "book": "psalms                                  ",
    "chapter": "118",
    "verse": "26",
    "text": "Błogosławiony, który przychodzi w imię PANA; błogosławimy wam z domu PANA."
  },
  {
    "id": 25873,
    "book": "psalms                                  ",
    "chapter": "118",
    "verse": "27",
    "text": "Bóg jest PANEM, on nas oświecił; przywiążcie baranki powrozami aż do rogów ołtarza."
  },
  {
    "id": 25874,
    "book": "psalms                                  ",
    "chapter": "118",
    "verse": "28",
    "text": "Ty jesteś moim Bogiem, będę cię wysławiać; mój Boże, będę cię wywyższać."
  },
  {
    "id": 25875,
    "book": "psalms                                  ",
    "chapter": "118",
    "verse": "29",
    "text": "Wysławiajcie PANA, bo"
  }
]