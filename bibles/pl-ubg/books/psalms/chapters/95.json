[
  {
    "id": 25432,
    "book": "psalms                                  ",
    "chapter": "95",
    "verse": "1",
    "text": "Chodźcie, śpiewajmy PANU, wykrzykujmy"
  },
  {
    "id": 25433,
    "book": "psalms                                  ",
    "chapter": "95",
    "verse": "2",
    "text": "Przyjdźmy przed jego oblicze z chwałą,"
  },
  {
    "id": 25434,
    "book": "psalms                                  ",
    "chapter": "95",
    "verse": "3",
    "text": "PAN bowiem"
  },
  {
    "id": 25435,
    "book": "psalms                                  ",
    "chapter": "95",
    "verse": "4",
    "text": "W jego rękach"
  },
  {
    "id": 25436,
    "book": "psalms                                  ",
    "chapter": "95",
    "verse": "5",
    "text": "Jego jest morze, bo on je uczynił, i jego ręce ukształtowały suchy ląd."
  },
  {
    "id": 25437,
    "book": "psalms                                  ",
    "chapter": "95",
    "verse": "6",
    "text": "Chodźcie, oddajmy pokłon i padajmy przed nim; klęknijmy przed PANEM, naszym Stwórcą."
  },
  {
    "id": 25438,
    "book": "psalms                                  ",
    "chapter": "95",
    "verse": "7",
    "text": "On bowiem jest naszym Bogiem, a my ludem jego pastwiska i owcami jego rąk. Dzisiaj, jeśli jego głos usłyszycie;"
  },
  {
    "id": 25439,
    "book": "psalms                                  ",
    "chapter": "95",
    "verse": "8",
    "text": "Nie zatwardzajcie waszych serc jak w Meriba, jak w czasie kuszenia na pustyni;"
  },
  {
    "id": 25440,
    "book": "psalms                                  ",
    "chapter": "95",
    "verse": "9",
    "text": "Kiedy mnie wystawiali na próbę wasi ojcowie, doświadczali mnie i widzieli moje dzieła."
  },
  {
    "id": 25441,
    "book": "psalms                                  ",
    "chapter": "95",
    "verse": "10",
    "text": "Przez czterdzieści lat czułem odrazę do"
  },
  {
    "id": 25442,
    "book": "psalms                                  ",
    "chapter": "95",
    "verse": "11",
    "text": "Przysiągłem im w gniewie, że nie wejdą do mego odpoczynku."
  }
]