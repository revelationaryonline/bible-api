[
  {
    "id": 25720,
    "book": "psalms                                  ",
    "chapter": "108",
    "verse": "1",
    "text": "Boże, moje serce jest gotowe; będę ci śpiewać i wysławiać cię, także i moja chwała."
  },
  {
    "id": 25721,
    "book": "psalms                                  ",
    "chapter": "108",
    "verse": "2",
    "text": "Obudź się, cytro i harfo, gdy o świcie powstanę."
  },
  {
    "id": 25722,
    "book": "psalms                                  ",
    "chapter": "108",
    "verse": "3",
    "text": "Będę cię wysławiać wśród ludu, PANIE, będę ci śpiewał wśród narodów."
  },
  {
    "id": 25723,
    "book": "psalms                                  ",
    "chapter": "108",
    "verse": "4",
    "text": "Twoje miłosierdzie bowiem jest wielkie,"
  },
  {
    "id": 25724,
    "book": "psalms                                  ",
    "chapter": "108",
    "verse": "5",
    "text": "Bądź wywyższony ponad niebiosa, Boże, a twoja chwała ponad całą ziemię;"
  },
  {
    "id": 25725,
    "book": "psalms                                  ",
    "chapter": "108",
    "verse": "6",
    "text": "Aby twoi umiłowani byli ocaleni, wybaw ich swoją prawicą i wysłuchaj mnie."
  },
  {
    "id": 25726,
    "book": "psalms                                  ",
    "chapter": "108",
    "verse": "7",
    "text": "Bóg przemówił w swej świętości: Będę się weselić, rozdzielę Sychem, a dolinę Sukkot wymierzę."
  },
  {
    "id": 25727,
    "book": "psalms                                  ",
    "chapter": "108",
    "verse": "8",
    "text": "Mój"
  },
  {
    "id": 25728,
    "book": "psalms                                  ",
    "chapter": "108",
    "verse": "9",
    "text": "Moab jest moją miednicą do mycia, na Edom rzucę moje obuwie, nad Filisteą zatriumfuję."
  },
  {
    "id": 25729,
    "book": "psalms                                  ",
    "chapter": "108",
    "verse": "10",
    "text": "Kto mnie wprowadzi do miasta warownego? Kto mnie doprowadzi aż do Edomu?"
  },
  {
    "id": 25730,
    "book": "psalms                                  ",
    "chapter": "108",
    "verse": "11",
    "text": "Czy nie"
  },
  {
    "id": 25731,
    "book": "psalms                                  ",
    "chapter": "108",
    "verse": "12",
    "text": "Udziel nam pomocy w ucisku, bo próżna jest pomoc ludzka."
  },
  {
    "id": 25732,
    "book": "psalms                                  ",
    "chapter": "108",
    "verse": "13",
    "text": "W Bogu będziemy mężni, on podepcze naszych wrogów."
  }
]