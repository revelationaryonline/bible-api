[
  {
    "id": 24592,
    "book": "psalms                                  ",
    "chapter": "46",
    "verse": "1",
    "text": "Bóg"
  },
  {
    "id": 24593,
    "book": "psalms                                  ",
    "chapter": "46",
    "verse": "2",
    "text": "Dlatego nie będziemy się bać, choćby się poruszyła ziemia, choćby się przeniosły góry w sam środek morza;"
  },
  {
    "id": 24594,
    "book": "psalms                                  ",
    "chapter": "46",
    "verse": "3",
    "text": "Choćby huczały i burzyły się jego wody i zatrzęsły się góry od jego nawałnicy. Sela."
  },
  {
    "id": 24595,
    "book": "psalms                                  ",
    "chapter": "46",
    "verse": "4",
    "text": ""
  },
  {
    "id": 24596,
    "book": "psalms                                  ",
    "chapter": "46",
    "verse": "5",
    "text": "Bóg"
  },
  {
    "id": 24597,
    "book": "psalms                                  ",
    "chapter": "46",
    "verse": "6",
    "text": "Wzburzyły się narody, zachwiały się królestwa, on wydał swój głos i rozpłynęła się ziemia."
  },
  {
    "id": 24598,
    "book": "psalms                                  ",
    "chapter": "46",
    "verse": "7",
    "text": "PAN zastępów"
  },
  {
    "id": 24599,
    "book": "psalms                                  ",
    "chapter": "46",
    "verse": "8",
    "text": "Chodźcie, zobaczcie dzieła PANA, jakie spustoszenia uczynił na ziemi."
  },
  {
    "id": 24600,
    "book": "psalms                                  ",
    "chapter": "46",
    "verse": "9",
    "text": "On kładzie kres wojnom aż po krańce ziemi, kruszy łuki i łamie włócznie, a rydwany pali ogniem."
  },
  {
    "id": 24601,
    "book": "psalms                                  ",
    "chapter": "46",
    "verse": "10",
    "text": "Uspokójcie się i uznajcie, że ja jestem Bogiem; będę wywyższony wśród narodów, będę wywyższony na ziemi."
  },
  {
    "id": 24602,
    "book": "psalms                                  ",
    "chapter": "46",
    "verse": "11",
    "text": "PAN zastępów"
  }
