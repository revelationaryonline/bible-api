[
  {
    "id": 25049,
    "book": "psalms                                  ",
    "chapter": "75",
    "verse": "1",
    "text": "Wysławiamy cię, Boże, wysławiamy, bo bliskie twoje imię; opowiadają"
  },
  {
    "id": 25050,
    "book": "psalms                                  ",
    "chapter": "75",
    "verse": "2",
    "text": "Gdy wyznaczę czas, będę sądzić sprawiedliwie."
  },
  {
    "id": 25051,
    "book": "psalms                                  ",
    "chapter": "75",
    "verse": "3",
    "text": "Roztopiła się ziemia i wszyscy jej mieszkańcy,"
  },
  {
    "id": 25052,
    "book": "psalms                                  ",
    "chapter": "75",
    "verse": "4",
    "text": "Powiedziałem głupcom: Nie szalejcie, a niegodziwym: Nie podnoście rogu."
  },
  {
    "id": 25053,
    "book": "psalms                                  ",
    "chapter": "75",
    "verse": "5",
    "text": "Nie podnoście wysoko swego rogu"
  },
  {
    "id": 25054,
    "book": "psalms                                  ",
    "chapter": "75",
    "verse": "6",
    "text": "Bo nie ze wschodu ani z zachodu, ani z południa"
  },
  {
    "id": 25055,
    "book": "psalms                                  ",
    "chapter": "75",
    "verse": "7",
    "text": "Lecz Bóg"
  },
  {
    "id": 25056,
    "book": "psalms                                  ",
    "chapter": "75",
    "verse": "8",
    "text": "W ręku PANA bowiem"
  },
  {
    "id": 25057,
    "book": "psalms                                  ",
    "chapter": "75",
    "verse": "9",
    "text": "Ja zaś będę zawsze opowiadał, będę śpiewał Bogu Jakuba."
  },
  {
    "id": 25058,
    "book": "psalms                                  ",
    "chapter": "75",
    "verse": "10",
    "text": "I połamię wszystkie rogi niegodziwych, a rogi sprawiedliwego będą wzniesione."
  }
]