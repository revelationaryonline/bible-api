[
  {
    "id": 26319,
    "book": "psalms                                  ",
    "chapter": "146",
    "verse": "1",
    "text": "Alleluja. Chwal, duszo moja, PANA."
  },
  {
    "id": 26320,
    "book": "psalms                                  ",
    "chapter": "146",
    "verse": "2",
    "text": "Będę chwalić PANA, póki żyję; będę śpiewał memu Bogu, póki będę istniał."
  },
  {
    "id": 26321,
    "book": "psalms                                  ",
    "chapter": "146",
    "verse": "3",
    "text": "Nie pokładajcie ufności we władcach"
  },
  {
    "id": 26322,
    "book": "psalms                                  ",
    "chapter": "146",
    "verse": "4",
    "text": "Opuszcza go duch i wraca do swojej ziemi; w tymże dniu zginą"
  },
  {
    "id": 26323,
    "book": "psalms                                  ",
    "chapter": "146",
    "verse": "5",
    "text": "Błogosławiony ten, kogo pomocą jest Bóg Jakuba, kto nadzieję pokłada w PANU, jego Bogu;"
  },
  {
    "id": 26324,
    "book": "psalms                                  ",
    "chapter": "146",
    "verse": "6",
    "text": "Który uczynił niebo i ziemię, morze i wszystko, co w nich"
  },
  {
    "id": 26325,
    "book": "psalms                                  ",
    "chapter": "146",
    "verse": "7",
    "text": "Który oddaje sprawiedliwość pokrzywdzonym"
  },
  {
    "id": 26326,
    "book": "psalms                                  ",
    "chapter": "146",
    "verse": "8",
    "text": "PAN otwiera"
  },
  {
    "id": 26327,
    "book": "psalms                                  ",
    "chapter": "146",
    "verse": "9",
    "text": "PAN strzeże przychodniów, wspomaga sierotę i wdowę, ale krzyżuje drogę niegodziwych."
  },
  {
    "id": 26328,
    "book": "psalms                                  ",
    "chapter": "146",
    "verse": "10",
    "text": "PAN będzie królował na wieki, twój Bóg, o Syjonie, z pokolenia na pokolenie. Alleluja."
  }
]