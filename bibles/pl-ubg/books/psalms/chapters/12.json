[
  {
    "id": 24044,
    "book": "psalms                                  ",
    "chapter": "12",
    "verse": "1",
    "text": "Ratuj, PANIE, bo"
  },
  {
    "id": 24045,
    "book": "psalms                                  ",
    "chapter": "12",
    "verse": "2",
    "text": "Wszyscy mówią kłamliwie do bliźniego, mówią schlebiającymi wargami i z obłudnym sercem."
  },
  {
    "id": 24046,
    "book": "psalms                                  ",
    "chapter": "12",
    "verse": "3",
    "text": "Niech PAN wytępi wszystkie wargi schlebiające"
  },
  {
    "id": 24047,
    "book": "psalms                                  ",
    "chapter": "12",
    "verse": "4",
    "text": "Oni mówią: Swoim językiem zwyciężymy, nasze wargi należą do nas, któż jest naszym panem?"
  },
  {
    "id": 24048,
    "book": "psalms                                  ",
    "chapter": "12",
    "verse": "5",
    "text": "Ze względu na ucisk ubogich"
  },
  {
    "id": 24049,
    "book": "psalms                                  ",
    "chapter": "12",
    "verse": "6",
    "text": "Słowa PANA to słowa czyste jak srebro wypróbowane w ziemnym tyglu, siedmiokrotnie oczyszczone."
  },
  {
    "id": 24050,
    "book": "psalms                                  ",
    "chapter": "12",
    "verse": "7",
    "text": "Ty, PANIE, zachowasz ich, będziesz ich strzegł od tego pokolenia aż na wieki."
  },
  {
    "id": 24051,
    "book": "psalms                                  ",
    "chapter": "12",
    "verse": "8",
    "text": "Niegodziwi krążą wokoło, gdy najpodlejsi z ludzi zostają wywyższeni."
  }
]