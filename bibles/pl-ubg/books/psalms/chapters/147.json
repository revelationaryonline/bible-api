[
  {
    "id": 26329,
    "book": "psalms                                  ",
    "chapter": "147",
    "verse": "1",
    "text": "Chwalcie PANA, bo dobrze"
  },
  {
    "id": 26330,
    "book": "psalms                                  ",
    "chapter": "147",
    "verse": "2",
    "text": "PAN buduje Jeruzalem"
  },
  {
    "id": 26331,
    "book": "psalms                                  ",
    "chapter": "147",
    "verse": "3",
    "text": "On uzdrawia skruszonych w sercu i opatruje ich rany."
  },
  {
    "id": 26332,
    "book": "psalms                                  ",
    "chapter": "147",
    "verse": "4",
    "text": "On liczy gwiazdy, nazywa każdą z nich po imieniu."
  },
  {
    "id": 26333,
    "book": "psalms                                  ",
    "chapter": "147",
    "verse": "5",
    "text": "Wielki"
  },
  {
    "id": 26334,
    "book": "psalms                                  ",
    "chapter": "147",
    "verse": "6",
    "text": "PAN podnosi pokornych,"
  },
  {
    "id": 26335,
    "book": "psalms                                  ",
    "chapter": "147",
    "verse": "7",
    "text": "Śpiewajcie PANU z dziękczynieniem; śpiewajcie naszemu Bogu przy dźwiękach harfy;"
  },
  {
    "id": 26336,
    "book": "psalms                                  ",
    "chapter": "147",
    "verse": "8",
    "text": "Który okrywa niebiosa obłokami"
  },
  {
    "id": 26337,
    "book": "psalms                                  ",
    "chapter": "147",
    "verse": "9",
    "text": "Który daje pokarm bydłu i młodym krukom wołającym"
  },
  {
    "id": 26338,
    "book": "psalms                                  ",
    "chapter": "147",
    "verse": "10",
    "text": "Nie lubuje się w mocy konia ani nie ma upodobania w goleniach mężczyzny."
  },
  {
    "id": 26339,
    "book": "psalms                                  ",
    "chapter": "147",
    "verse": "11",
    "text": "PAN ma upodobanie w tych, którzy się go boją, którzy ufają jego miłosierdziu."
  },
  {
    "id": 26340,
    "book": "psalms                                  ",
    "chapter": "147",
    "verse": "12",
    "text": "Chwal PANA, Jeruzalem; chwal swego Boga, Syjonie."
  },
  {
    "id": 26341,
    "book": "psalms                                  ",
    "chapter": "147",
    "verse": "13",
    "text": "On bowiem umacnia zasuwy twoich bram i błogosławi synów twoich pośród ciebie."
  },
  {
    "id": 26342,
    "book": "psalms                                  ",
    "chapter": "147",
    "verse": "14",
    "text": "Zapewnia pokój w twoich granicach i syci cię najwyborniejszą pszenicą."
  },
  {
    "id": 26343,
    "book": "psalms                                  ",
    "chapter": "147",
    "verse": "15",
    "text": "On wysyła swój rozkaz na ziemię; szybko biegnie jego słowo."
  },
  {
    "id": 26344,
    "book": "psalms                                  ",
    "chapter": "147",
    "verse": "16",
    "text": "On daje śnieg jak wełnę, rozsypuje szron jak popiół."
  },
  {
    "id": 26345,
    "book": "psalms                                  ",
    "chapter": "147",
    "verse": "17",
    "text": "Rzuca swój lód jak okruchy; któż ostoi się przed jego zimnem?"
  },
  {
    "id": 26346,
    "book": "psalms                                  ",
    "chapter": "147",
    "verse": "18",
    "text": "Posyła swoje słowo i"
  },
  {
    "id": 26347,
    "book": "psalms                                  ",
    "chapter": "147",
    "verse": "19",
    "text": "Oznajmia swe słowo Jakubowi, swe prawa i sądy Izraelowi."
  },
  {
    "id": 26348,
    "book": "psalms                                  ",
    "chapter": "147",
    "verse": "20",
    "text": "Nie uczynił tak żadnemu narodowi, nie poznali jego sądów. Alleluja."
  }
]