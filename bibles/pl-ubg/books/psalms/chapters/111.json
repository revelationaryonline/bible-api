[
  {
    "id": 25771,
    "book": "psalms                                  ",
    "chapter": "111",
    "verse": "1",
    "text": "Alleluja. Będę wysławiał PANA całym sercem w radzie prawych i w zgromadzeniu."
  },
  {
    "id": 25772,
    "book": "psalms                                  ",
    "chapter": "111",
    "verse": "2",
    "text": "Wielkie"
  },
  {
    "id": 25773,
    "book": "psalms                                  ",
    "chapter": "111",
    "verse": "3",
    "text": "Jego dzieło jest chwalebne i wspaniałe, a jego sprawiedliwość trwa na wieki."
  },
  {
    "id": 25774,
    "book": "psalms                                  ",
    "chapter": "111",
    "verse": "4",
    "text": "Pamiętnymi uczynił swe cuda; miłosierny i litościwy"
  },
  {
    "id": 25775,
    "book": "psalms                                  ",
    "chapter": "111",
    "verse": "5",
    "text": "Dał pokarm tym, którzy się go boją, pamięta wiecznie o swoim przymierzu."
  },
  {
    "id": 25776,
    "book": "psalms                                  ",
    "chapter": "111",
    "verse": "6",
    "text": "Okazał swemu ludowi potęgę swoich dzieł, dając mu dziedzictwo pogan."
  },
  {
    "id": 25777,
    "book": "psalms                                  ",
    "chapter": "111",
    "verse": "7",
    "text": "Dzieła rąk jego to prawda i sąd, niezmienne"
  },
  {
    "id": 25778,
    "book": "psalms                                  ",
    "chapter": "111",
    "verse": "8",
    "text": "Ustalone na wieki wieków, ustanowione w prawdzie i prawości."
  },
  {
    "id": 25779,
    "book": "psalms                                  ",
    "chapter": "111",
    "verse": "9",
    "text": "Zesłał swemu ludowi odkupienie, ustanowił na wieki swoje przymierze; jego imię"
  },
  {
    "id": 25780,
    "book": "psalms                                  ",
    "chapter": "111",
    "verse": "10",
    "text": "Bojaźń PANA"
  }
]