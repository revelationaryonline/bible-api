[
  {
    "id": 26080,
    "book": "psalms                                  ",
    "chapter": "124",
    "verse": "1",
    "text": "Gdyby PAN nie był z nami, niech powie teraz Izrael;"
  },
  {
    "id": 26081,
    "book": "psalms                                  ",
    "chapter": "124",
    "verse": "2",
    "text": "Gdyby PAN nie był z nami, gdy ludzie powstawali przeciwko nam;"
  },
  {
    "id": 26082,
    "book": "psalms                                  ",
    "chapter": "124",
    "verse": "3",
    "text": "Wtedy połknęliby nas żywcem, gdy płonęli gniewem przeciwko nam;"
  },
  {
    "id": 26083,
    "book": "psalms                                  ",
    "chapter": "124",
    "verse": "4",
    "text": "Wtedy wody zalałyby nas,"
  },
  {
    "id": 26084,
    "book": "psalms                                  ",
    "chapter": "124",
    "verse": "5",
    "text": "Wtedy gwałtowne wody porwałyby nasze dusze."
  },
  {
    "id": 26085,
    "book": "psalms                                  ",
    "chapter": "124",
    "verse": "6",
    "text": "Błogosławiony PAN, który nas nie wydał na pastwę ich zębom."
  },
  {
    "id": 26086,
    "book": "psalms                                  ",
    "chapter": "124",
    "verse": "7",
    "text": "Nasza dusza umknęła jak ptak z sideł ptaszników; sidła się podarły, a my uciekliśmy."
  },
  {
    "id": 26087,
    "book": "psalms                                  ",
    "chapter": "124",
    "verse": "8",
    "text": "Nasza pomoc jest w imieniu PANA, który stworzył niebo i ziemię."
  }
]