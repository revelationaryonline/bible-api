[
  {
    "id": 24160,
    "book": "psalms                                  ",
    "chapter": "20",
    "verse": "1",
    "text": "Niech cię wysłucha PAN w dniu utrapienia, niech cię chroni imię Boga Jakuba."
  },
  {
    "id": 24161,
    "book": "psalms                                  ",
    "chapter": "20",
    "verse": "2",
    "text": "Niech ci ześle pomoc ze świątyni i niech cię wesprze z Syjonu."
  },
  {
    "id": 24162,
    "book": "psalms                                  ",
    "chapter": "20",
    "verse": "3",
    "text": "Niech pamięta wszystkie twoje ofiary i niech przyjmie twoje całopalenia. Sela."
  },
  {
    "id": 24163,
    "book": "psalms                                  ",
    "chapter": "20",
    "verse": "4",
    "text": "Niech da ci"
  },
  {
    "id": 24164,
    "book": "psalms                                  ",
    "chapter": "20",
    "verse": "5",
    "text": "Będziemy się radować z twojego zbawienia i w imię naszego Boga sztandary podniesiemy. Niech PAN spełni wszystkie twoje prośby."
  },
  {
    "id": 24165,
    "book": "psalms                                  ",
    "chapter": "20",
    "verse": "6",
    "text": "Teraz wiem, że PAN wybawia swego pomazańca, wysłucha go ze swego świętego nieba zbawczą mocą swojej prawicy."
  },
  {
    "id": 24166,
    "book": "psalms                                  ",
    "chapter": "20",
    "verse": "7",
    "text": "Jedni"
  },
  {
    "id": 24167,
    "book": "psalms                                  ",
    "chapter": "20",
    "verse": "8",
    "text": "Tamci zachwiali się i upadli, a my powstaliśmy i ostoimy się."
  },
  {
    "id": 24168,
    "book": "psalms                                  ",
    "chapter": "20",
    "verse": "9",
    "text": "PANIE, wybaw"
