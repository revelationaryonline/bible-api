[
  {
    "id": 25211,
    "book": "psalms                                  ",
    "chapter": "82",
    "verse": "1",
    "text": "Bóg stoi w zgromadzeniu Bożym, pośród bogów sprawuje sąd:"
  },
  {
    "id": 25212,
    "book": "psalms                                  ",
    "chapter": "82",
    "verse": "2",
    "text": "Jak długo będziecie sądzić niesprawiedliwie i trzymać stronę niegodziwych? Sela."
  },
  {
    "id": 25213,
    "book": "psalms                                  ",
    "chapter": "82",
    "verse": "3",
    "text": "Bierzcie w obronę ubogiego i sierotę, oddajcie sprawiedliwość strapionemu i potrzebującemu."
  },
  {
    "id": 25214,
    "book": "psalms                                  ",
    "chapter": "82",
    "verse": "4",
    "text": "Wyzwólcie biedaka i nędzarza, ocalcie go z ręki niegodziwych."
  },
  {
    "id": 25215,
    "book": "psalms                                  ",
    "chapter": "82",
    "verse": "5",
    "text": ""
  },
  {
    "id": 25216,
    "book": "psalms                                  ",
    "chapter": "82",
    "verse": "6",
    "text": "Powiedziałem: Jesteście bogami i wszyscy wy jesteście synami Najwyższego."
  },
  {
    "id": 25217,
    "book": "psalms                                  ",
    "chapter": "82",
    "verse": "7",
    "text": "Lecz pomrzecie jak"
  },
  {
    "id": 25218,
    "book": "psalms                                  ",
    "chapter": "82",
    "verse": "8",
    "text": "Powstań, Boże, osądź ziemię, bo ty otrzymasz w dziedzictwo wszystkie narody."
  }
]