[
  {
    "id": 24612,
    "book": "psalms                                  ",
    "chapter": "48",
    "verse": "1",
    "text": "Wielki jest PAN i godzien wielkiej chwały w mieście naszego Boga, na swej świętej górze."
  },
  {
    "id": 24613,
    "book": "psalms                                  ",
    "chapter": "48",
    "verse": "2",
    "text": "Pięknie wzniesiona, radością całej ziemi"
  },
  {
    "id": 24614,
    "book": "psalms                                  ",
    "chapter": "48",
    "verse": "3",
    "text": "Bóg w pałacach jego jest uznany za twierdzę."
  },
  {
    "id": 24615,
    "book": "psalms                                  ",
    "chapter": "48",
    "verse": "4",
    "text": "Bo oto zgromadzili się królowie i razem ruszyli."
  },
  {
    "id": 24616,
    "book": "psalms                                  ",
    "chapter": "48",
    "verse": "5",
    "text": "Gdy zobaczyli, zdumieli się, przerazili się i uciekli."
  },
  {
    "id": 24617,
    "book": "psalms                                  ",
    "chapter": "48",
    "verse": "6",
    "text": "Strach ich tam ogarnął i ból, jak rodzącą kobietę."
  },
  {
    "id": 24618,
    "book": "psalms                                  ",
    "chapter": "48",
    "verse": "7",
    "text": "Wiatrem wschodnim rozbijasz okręty Tarszisz."
  },
  {
    "id": 24619,
    "book": "psalms                                  ",
    "chapter": "48",
    "verse": "8",
    "text": "To, co słyszeliśmy,"
  },
  {
    "id": 24620,
    "book": "psalms                                  ",
    "chapter": "48",
    "verse": "9",
    "text": "Rozważamy, o Boże, twoje miłosierdzie we wnętrzu twej świątyni."
  },
  {
    "id": 24621,
    "book": "psalms                                  ",
    "chapter": "48",
    "verse": "10",
    "text": "Jak twoje imię, Boże, tak i chwała twoja"
  },
  {
    "id": 24622,
    "book": "psalms                                  ",
    "chapter": "48",
    "verse": "11",
    "text": "Niech się weseli góra Syjon, niech się radują córki Judy z powodu twoich sądów."
  },
  {
    "id": 24623,
    "book": "psalms                                  ",
    "chapter": "48",
    "verse": "12",
    "text": "Okrążcie Syjon i obejdźcie go, policzcie jego wieże."
  },
  {
    "id": 24624,
    "book": "psalms                                  ",
    "chapter": "48",
    "verse": "13",
    "text": "Przyjrzyjcie się jego wałom obronnym, oglądajcie jego pałace, abyście mogli opowiadać przyszłemu pokoleniu."
  },
  {
    "id": 24625,
    "book": "psalms                                  ",
    "chapter": "48",
    "verse": "14",
    "text": "Bo ten Bóg jest naszym Bogiem na wieki wieków, on będzie nas prowadził aż do śmierci."
  }
]