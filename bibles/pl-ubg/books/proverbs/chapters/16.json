[
  {
    "id": 23442,
    "book": "proverbs                                ",
    "chapter": "16",
    "verse": "1",
    "text": "W człowieku są zamysły serca, ale odpowiedź języka jest od PANA."
  },
  {
    "id": 23443,
    "book": "proverbs                                ",
    "chapter": "16",
    "verse": "2",
    "text": "Wszystkie drogi człowieka są czyste w jego oczach, ale PAN waży duchy."
  },
  {
    "id": 23444,
    "book": "proverbs                                ",
    "chapter": "16",
    "verse": "3",
    "text": "Powierz PANU swe dzieła, a twoje zamysły będą utwierdzone."
  },
  {
    "id": 23445,
    "book": "proverbs                                ",
    "chapter": "16",
    "verse": "4",
    "text": "PAN uczynił wszystko dla samego siebie, nawet niegodziwego na dzień zła."
  },
  {
    "id": 23446,
    "book": "proverbs                                ",
    "chapter": "16",
    "verse": "5",
    "text": "Każdy, który jest wyniosłego serca, budzi odrazę w PANU; choć weźmie innych do pomocy, nie uniknie kary."
  },
  {
    "id": 23447,
    "book": "proverbs                                ",
    "chapter": "16",
    "verse": "6",
    "text": "Dzięki miłosierdziu i prawdzie oczyszcza się nieprawość, a w bojaźni PANA oddalamy się od zła."
  },
  {
    "id": 23448,
    "book": "proverbs                                ",
    "chapter": "16",
    "verse": "7",
    "text": "Gdy drogi człowieka podobają się PANU, to godzi z nim nawet jego nieprzyjaciół."
  },
  {
    "id": 23449,
    "book": "proverbs                                ",
    "chapter": "16",
    "verse": "8",
    "text": "Lepiej mieć mało ze sprawiedliwością niż wiele dochodów nieprawnych."
  },
  {
    "id": 23450,
    "book": "proverbs                                ",
    "chapter": "16",
    "verse": "9",
    "text": "Serce człowieka obmyśla swe drogi, ale PAN kieruje jego krokami."
  },
  {
    "id": 23451,
    "book": "proverbs                                ",
    "chapter": "16",
    "verse": "10",
    "text": "Wyrok Boży"
  },
  {
    "id": 23452,
    "book": "proverbs                                ",
    "chapter": "16",
    "verse": "11",
    "text": "Sprawiedliwa waga i szale"
  },
  {
    "id": 23453,
    "book": "proverbs                                ",
    "chapter": "16",
    "verse": "12",
    "text": "Popełnienie niegodziwości budzi odrazę w królach, bo sprawiedliwością tron jest umocniony."
  },
  {
    "id": 23454,
    "book": "proverbs                                ",
    "chapter": "16",
    "verse": "13",
    "text": "Wargi sprawiedliwe są rozkoszą królów, kochają oni tego, który mówi to, co słuszne."
  },
  {
    "id": 23455,
    "book": "proverbs                                ",
    "chapter": "16",
    "verse": "14",
    "text": "Gniew króla jest posłańcem śmierci, ale mądry człowiek przebłaga go."
  },
  {
    "id": 23456,
    "book": "proverbs                                ",
    "chapter": "16",
    "verse": "15",
    "text": "W jasności twarzy króla"
  },
  {
    "id": 23457,
    "book": "proverbs                                ",
    "chapter": "16",
    "verse": "16",
    "text": "O wiele lepiej jest nabyć mądrość niż złoto; a nabyć rozum lepiej niż srebro."
  },
  {
    "id": 23458,
    "book": "proverbs                                ",
    "chapter": "16",
    "verse": "17",
    "text": "Droga prawych"
  },
  {
    "id": 23459,
    "book": "proverbs                                ",
    "chapter": "16",
    "verse": "18",
    "text": "Pycha poprzedza zgubę, a wyniosły duch – upadek."
  },
  {
    "id": 23460,
    "book": "proverbs                                ",
    "chapter": "16",
    "verse": "19",
    "text": "Lepiej być uniżonego ducha z pokornymi, niż dzielić łup z pysznymi."
  },
  {
    "id": 23461,
    "book": "proverbs                                ",
    "chapter": "16",
    "verse": "20",
    "text": "Kto zważa na słowo, znajdzie dobro, a kto ufa PANU,"
  },
  {
    "id": 23462,
    "book": "proverbs                                ",
    "chapter": "16",
    "verse": "21",
    "text": "Kto"
  },
  {
    "id": 23463,
    "book": "proverbs                                ",
    "chapter": "16",
    "verse": "22",
    "text": "Rozum"
  },
  {
    "id": 23464,
    "book": "proverbs                                ",
    "chapter": "16",
    "verse": "23",
    "text": "Serce mądrego czyni jego usta roztropnymi i dodaje nauki jego wargom."
  },
  {
    "id": 23465,
    "book": "proverbs                                ",
    "chapter": "16",
    "verse": "24",
    "text": "Miłe słowa są"
  },
  {
    "id": 23466,
    "book": "proverbs                                ",
    "chapter": "16",
    "verse": "25",
    "text": "Jest droga, która"
  },
  {
    "id": 23467,
    "book": "proverbs                                ",
    "chapter": "16",
    "verse": "26",
    "text": "Robotnik pracuje dla siebie, bo usta pobudzają go"
  },
  {
    "id": 23468,
    "book": "proverbs                                ",
    "chapter": "16",
    "verse": "27",
    "text": "Człowiek nikczemny wykopuje zło, a na jego wargach jakby ogień płonący."
  },
  {
    "id": 23469,
    "book": "proverbs                                ",
    "chapter": "16",
    "verse": "28",
    "text": "Człowiek przewrotny rozsiewa spory, a plotkarz rozdziela przyjaciół."
  },
  {
    "id": 23470,
    "book": "proverbs                                ",
    "chapter": "16",
    "verse": "29",
    "text": "Człowiek gwałtowny zwabia swego bliźniego i wprowadza go na drogę niedobrą."
  },
  {
    "id": 23471,
    "book": "proverbs                                ",
    "chapter": "16",
    "verse": "30",
    "text": "Mruga swymi oczami, by knuć podstępy; rusza wargami i popełnia zło."
  },
  {
    "id": 23472,
    "book": "proverbs                                ",
    "chapter": "16",
    "verse": "31",
    "text": "Siwa głowa"
  },
  {
    "id": 23473,
    "book": "proverbs                                ",
    "chapter": "16",
    "verse": "32",
    "text": "Lepszy jest nieskory do gniewu niż mocarz, a kto panuje nad swym duchem,"
  },
  {
    "id": 23474,
    "book": "proverbs                                ",
    "chapter": "16",
    "verse": "33",
    "text": "Losy wrzuca się w zanadrze, ale całe rozstrzygnięcie ich zależy od PANA."
  }
]