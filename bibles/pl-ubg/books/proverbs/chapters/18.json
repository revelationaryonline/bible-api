[
  {
    "id": 23503,
    "book": "proverbs                                ",
    "chapter": "18",
    "verse": "1",
    "text": "Samolub szuka tego, co mu się podoba, i wtrąca się w każdą sprawę."
  },
  {
    "id": 23504,
    "book": "proverbs                                ",
    "chapter": "18",
    "verse": "2",
    "text": "Głupi nie ma upodobania w rozumie, lecz w tym, co serce mu objawia."
  },
  {
    "id": 23505,
    "book": "proverbs                                ",
    "chapter": "18",
    "verse": "3",
    "text": "Gdy przychodzi niegodziwy, przychodzi też pogarda, a z hańbą urąganie."
  },
  {
    "id": 23506,
    "book": "proverbs                                ",
    "chapter": "18",
    "verse": "4",
    "text": "Słowa ust człowieka są jak głębokie wody, a źródło mądrości jak płynący potok."
  },
  {
    "id": 23507,
    "book": "proverbs                                ",
    "chapter": "18",
    "verse": "5",
    "text": "Niedobrze przez wzgląd na osobę niegodziwą krzywdzić sprawiedliwego w sądzie."
  },
  {
    "id": 23508,
    "book": "proverbs                                ",
    "chapter": "18",
    "verse": "6",
    "text": "Wargi głupiego wchodzą w spór, a jego usta wołają o razy."
  },
  {
    "id": 23509,
    "book": "proverbs                                ",
    "chapter": "18",
    "verse": "7",
    "text": "Usta głupiego"
  },
  {
    "id": 23510,
    "book": "proverbs                                ",
    "chapter": "18",
    "verse": "8",
    "text": "Słowa plotkarza są jak rany i przenikają do głębi wnętrzności."
  },
  {
    "id": 23511,
    "book": "proverbs                                ",
    "chapter": "18",
    "verse": "9",
    "text": "Kto jest niedbały w pracy, jest bratem marnotrawcy."
  },
  {
    "id": 23512,
    "book": "proverbs                                ",
    "chapter": "18",
    "verse": "10",
    "text": "Imię PANA"
  },
  {
    "id": 23513,
    "book": "proverbs                                ",
    "chapter": "18",
    "verse": "11",
    "text": "Zamożność bogacza"
  },
  {
    "id": 23514,
    "book": "proverbs                                ",
    "chapter": "18",
    "verse": "12",
    "text": "Przed upadkiem serce człowieka jest wyniosłe, a chwałę poprzedza pokora."
  },
  {
    "id": 23515,
    "book": "proverbs                                ",
    "chapter": "18",
    "verse": "13",
    "text": "Kto odpowiada, zanim wysłucha,"
  },
  {
    "id": 23516,
    "book": "proverbs                                ",
    "chapter": "18",
    "verse": "14",
    "text": "Duch człowieka zniesie jego chorobę, ale któż zniesie strapionego ducha?"
  },
  {
    "id": 23517,
    "book": "proverbs                                ",
    "chapter": "18",
    "verse": "15",
    "text": "Serce rozumnego zdobywa wiedzę, a ucho mądrych szuka wiedzy."
  },
  {
    "id": 23518,
    "book": "proverbs                                ",
    "chapter": "18",
    "verse": "16",
    "text": "Dar człowieka toruje mu drogę i prowadzi go przed wielkich."
  },
  {
    "id": 23519,
    "book": "proverbs                                ",
    "chapter": "18",
    "verse": "17",
    "text": "Ten, który jest pierwszy w swojej sprawie,"
  },
  {
    "id": 23520,
    "book": "proverbs                                ",
    "chapter": "18",
    "verse": "18",
    "text": "Los kładzie kres sporom i rozstrzyga między możnymi."
  },
  {
    "id": 23521,
    "book": "proverbs                                ",
    "chapter": "18",
    "verse": "19",
    "text": "Brat obrażony"
  },
  {
    "id": 23522,
    "book": "proverbs                                ",
    "chapter": "18",
    "verse": "20",
    "text": "Owocem swoich ust nasyci człowiek swoje wnętrze, nasyci się plonem swych warg."
  },
  {
    "id": 23523,
    "book": "proverbs                                ",
    "chapter": "18",
    "verse": "21",
    "text": "Śmierć i życie są w mocy języka, a kto go miłuje, spożyje jego owoc."
  },
  {
    "id": 23524,
    "book": "proverbs                                ",
    "chapter": "18",
    "verse": "22",
    "text": "Kto znalazł żonę, znalazł coś dobrego i dostąpił łaski od PANA."
  },
  {
    "id": 23525,
    "book": "proverbs                                ",
    "chapter": "18",
    "verse": "23",
    "text": "Ubogi prosi pokornie, ale bogaty odpowiada surowo."
  },
  {
    "id": 23526,
    "book": "proverbs                                ",
    "chapter": "18",
    "verse": "24",
    "text": "Człowiek, który ma przyjaciół, musi obchodzić się z nimi po przyjacielsku, a jest przyjaciel, który przylgnie bardziej niż brat."
  }
]