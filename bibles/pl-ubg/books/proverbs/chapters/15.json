[
  {
    "id": 23409,
    "book": "proverbs                                ",
    "chapter": "15",
    "verse": "1",
    "text": "Łagodna odpowiedź uśmierza zapalczywość, a przykre słowa wzniecają gniew."
  },
  {
    "id": 23410,
    "book": "proverbs                                ",
    "chapter": "15",
    "verse": "2",
    "text": "Język mądrych zdobi wiedzę, ale usta głupich tryskają głupotą."
  },
  {
    "id": 23411,
    "book": "proverbs                                ",
    "chapter": "15",
    "verse": "3",
    "text": "Oczy PANA są na każdym miejscu, upatrują złych i dobrych."
  },
  {
    "id": 23412,
    "book": "proverbs                                ",
    "chapter": "15",
    "verse": "4",
    "text": "Zdrowy język"
  },
  {
    "id": 23413,
    "book": "proverbs                                ",
    "chapter": "15",
    "verse": "5",
    "text": "Głupi gardzi pouczeniem swego ojca, a kto przyjmuje upomnienia, jest roztropny."
  },
  {
    "id": 23414,
    "book": "proverbs                                ",
    "chapter": "15",
    "verse": "6",
    "text": "W domu sprawiedliwego"
  },
  {
    "id": 23415,
    "book": "proverbs                                ",
    "chapter": "15",
    "verse": "7",
    "text": "Wargi mądrych szerzą wiedzę, a serce głupich nie."
  },
  {
    "id": 23416,
    "book": "proverbs                                ",
    "chapter": "15",
    "verse": "8",
    "text": "Ofiara niegodziwych budzi odrazę w PANU,"
  },
  {
    "id": 23417,
    "book": "proverbs                                ",
    "chapter": "15",
    "verse": "9",
    "text": "Droga niegodziwego wzbudza odrazę w PANU, a miłuje on tego, kto podąża za sprawiedliwością."
  },
  {
    "id": 23418,
    "book": "proverbs                                ",
    "chapter": "15",
    "verse": "10",
    "text": "Sroga kara"
  },
  {
    "id": 23419,
    "book": "proverbs                                ",
    "chapter": "15",
    "verse": "11",
    "text": "Piekło i zatracenie"
  },
  {
    "id": 23420,
    "book": "proverbs                                ",
    "chapter": "15",
    "verse": "12",
    "text": "Szyderca nie miłuje tego, który go strofuje, ani nie pójdzie do mądrych."
  },
  {
    "id": 23421,
    "book": "proverbs                                ",
    "chapter": "15",
    "verse": "13",
    "text": "Radosne serce rozwesela twarz,"
  },
  {
    "id": 23422,
    "book": "proverbs                                ",
    "chapter": "15",
    "verse": "14",
    "text": "Serce rozumne szuka wiedzy, a usta głupich karmią się głupotą."
  },
  {
    "id": 23423,
    "book": "proverbs                                ",
    "chapter": "15",
    "verse": "15",
    "text": "Wszystkie dni strapionego"
  },
  {
    "id": 23424,
    "book": "proverbs                                ",
    "chapter": "15",
    "verse": "16",
    "text": "Lepiej"
  },
  {
    "id": 23425,
    "book": "proverbs                                ",
    "chapter": "15",
    "verse": "17",
    "text": "Lepsza jest potrawa z jarzyn, gdzie miłość, niż tuczny wół, gdzie panuje nienawiść."
  },
  {
    "id": 23426,
    "book": "proverbs                                ",
    "chapter": "15",
    "verse": "18",
    "text": "Człowiek gniewny wszczyna kłótnie, a nieskory do gniewu łagodzi spory."
  },
  {
    "id": 23427,
    "book": "proverbs                                ",
    "chapter": "15",
    "verse": "19",
    "text": "Droga leniwego jest jak płot cierniowy, a ścieżka prawych jest wyrównana."
  },
  {
    "id": 23428,
    "book": "proverbs                                ",
    "chapter": "15",
    "verse": "20",
    "text": "Mądry syn jest radością ojca, a człowiek głupi gardzi własną matką."
  },
  {
    "id": 23429,
    "book": "proverbs                                ",
    "chapter": "15",
    "verse": "21",
    "text": "Głupota"
  },
  {
    "id": 23430,
    "book": "proverbs                                ",
    "chapter": "15",
    "verse": "22",
    "text": "Gdzie nie ma rady, nie udają się zamysły; powiodą się zaś przy mnóstwie doradców."
  },
  {
    "id": 23431,
    "book": "proverbs                                ",
    "chapter": "15",
    "verse": "23",
    "text": "Człowiek cieszy się z odpowiedzi swoich ust, a słowo powiedziane we właściwym czasie jakże jest dobre!"
  },
  {
    "id": 23432,
    "book": "proverbs                                ",
    "chapter": "15",
    "verse": "24",
    "text": "Droga życia dla mądrego"
  },
  {
    "id": 23433,
    "book": "proverbs                                ",
    "chapter": "15",
    "verse": "25",
    "text": "PAN zniszczy dom pysznych, a utwierdzi granicę wdowy."
  },
  {
    "id": 23434,
    "book": "proverbs                                ",
    "chapter": "15",
    "verse": "26",
    "text": "Myśli złego budzą odrazę w PANU, a słowa czystych"
  },
  {
    "id": 23435,
    "book": "proverbs                                ",
    "chapter": "15",
    "verse": "27",
    "text": "Kto jest chciwy zysku, ściąga kłopoty na własny dom, a kto nienawidzi darów, będzie żył."
  },
  {
    "id": 23436,
    "book": "proverbs                                ",
    "chapter": "15",
    "verse": "28",
    "text": "Serce sprawiedliwego rozmyśla nad odpowiedzią, a usta niegodziwych tryskają złymi rzeczami."
  },
  {
    "id": 23437,
    "book": "proverbs                                ",
    "chapter": "15",
    "verse": "29",
    "text": "PAN jest daleko od niegodziwych, ale wysłuchuje modlitwy sprawiedliwych."
  },
  {
    "id": 23438,
    "book": "proverbs                                ",
    "chapter": "15",
    "verse": "30",
    "text": "Światło oczu rozwesela serce, a dobra wieść tuczy kości."
  },
  {
    "id": 23439,
    "book": "proverbs                                ",
    "chapter": "15",
    "verse": "31",
    "text": "Ucho, które słucha upomnienia życia, będzie mieszkać pośród mądrych."
  },
  {
    "id": 23440,
    "book": "proverbs                                ",
    "chapter": "15",
    "verse": "32",
    "text": "Kto odrzuca karność, gardzi własną duszą, a kto przyjmuje upomnienie, nabiera rozumu."
  },
  {
    "id": 23441,
    "book": "proverbs                                ",
    "chapter": "15",
    "verse": "33",
    "text": "Bojaźń PANA"
  }
]