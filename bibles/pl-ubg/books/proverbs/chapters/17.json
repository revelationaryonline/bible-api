  },
  {
    "id": 23478,
    "book": "proverbs                                ",
    "chapter": "17",
    "verse": "4",
    "text": "Zły zważa na wargi fałszywe, a kłamca słucha przewrotnego języka."
  },
  {
    "id": 23479,
    "book": "proverbs                                ",
    "chapter": "17",
    "verse": "5",
    "text": "Kto naśmiewa się z ubogiego, uwłacza jego Stwórcy, a kto się cieszy z nieszczęścia, nie uniknie kary."
  },
  {
    "id": 23480,
    "book": "proverbs                                ",
    "chapter": "17",
    "verse": "6",
    "text": "Koroną starców są synowie synów, a chlubą synów są ich ojcowie."
  },
  {
    "id": 23481,
    "book": "proverbs                                ",
    "chapter": "17",
    "verse": "7",
    "text": "Poważna mowa nie przystoi głupiemu, tym mniej kłamliwe usta dostojnikowi."
  },
  {
    "id": 23482,
    "book": "proverbs                                ",
    "chapter": "17",
    "verse": "8",
    "text": "Dar jest"
  },
  {
