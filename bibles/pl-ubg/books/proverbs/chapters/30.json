[
  {
    "id": 23853,
    "book": "proverbs                                ",
    "chapter": "30",
    "verse": "1",
    "text": "Słowa Agura, syna Jake, proroctwo tego człowieka do Itiela, do Itiela i Ukala."
  },
  {
    "id": 23854,
    "book": "proverbs                                ",
    "chapter": "30",
    "verse": "2",
    "text": "Zaprawdę jestem najgłupszym z ludzi i nie mam ludzkiego rozumu."
  },
  {
    "id": 23855,
    "book": "proverbs                                ",
    "chapter": "30",
    "verse": "3",
    "text": "Ani nie nauczyłem się mądrości, ani nie mam wiedzy o tym, co święty."
  },
  {
    "id": 23856,
    "book": "proverbs                                ",
    "chapter": "30",
    "verse": "4",
    "text": "Któż wstąpił do nieba i zstąpił? Któż zebrał wiatr w swoje garście? Któż zgarnął wody do"
  },
  {
    "id": 23857,
    "book": "proverbs                                ",
    "chapter": "30",
    "verse": "5",
    "text": "Każde słowo Boga jest czyste; on"
  },
  {
    "id": 23858,
    "book": "proverbs                                ",
    "chapter": "30",
    "verse": "6",
    "text": "Nie dodawaj nic do jego słów, aby cię nie strofował i abyś nie okazał się kłamcą."
  },
  {
    "id": 23859,
    "book": "proverbs                                ",
    "chapter": "30",
    "verse": "7",
    "text": "Proszę cię o dwie rzeczy; nie odmawiaj mi"
  },
  {
    "id": 23860,
    "book": "proverbs                                ",
    "chapter": "30",
    "verse": "8",
    "text": "Oddal ode mnie marność i słowo kłamliwe; nie dawaj mi ani ubóstwa, ani bogactwa; żyw mnie odpowiednim dla mnie pokarmem;"
  },
  {
    "id": 23861,
    "book": "proverbs                                ",
    "chapter": "30",
    "verse": "9",
    "text": "Abym będąc syty, nie zaparł się"
  },
  {
    "id": 23862,
    "book": "proverbs                                ",
    "chapter": "30",
    "verse": "10",
    "text": "Nie oczerniaj sługi przed jego panem, aby ci nie złorzeczył i byś nie okazał się winny."
  },
  {
    "id": 23863,
    "book": "proverbs                                ",
    "chapter": "30",
    "verse": "11",
    "text": ""
  },
  {
    "id": 23864,
    "book": "proverbs                                ",
    "chapter": "30",
    "verse": "12",
    "text": ""
  },
  {
    "id": 23865,
    "book": "proverbs                                ",
    "chapter": "30",
    "verse": "13",
    "text": ""
  },
  {
    "id": 23866,
    "book": "proverbs                                ",
    "chapter": "30",
    "verse": "14",
    "text": ""
  },
  {
    "id": 23867,
    "book": "proverbs                                ",
    "chapter": "30",
    "verse": "15",
    "text": "Pijawka ma dwie córki,"
  },
  {
    "id": 23868,
    "book": "proverbs                                ",
    "chapter": "30",
    "verse": "16",
    "text": "Grób, niepłodne łono, ziemia niesyta wody i ogień,"
  },
  {
    "id": 23869,
    "book": "proverbs                                ",
    "chapter": "30",
    "verse": "17",
    "text": "Oko,"
  },
  {
    "id": 23870,
    "book": "proverbs                                ",
    "chapter": "30",
    "verse": "18",
    "text": "Trzy"
  },
  {
    "id": 23871,
    "book": "proverbs                                ",
    "chapter": "30",
    "verse": "19",
    "text": "Drogi orła w powietrzu, drogi węża na skale, drogi okrętu na środku morza i drogi mężczyzny z młodą kobietą."
  },
  {
    "id": 23872,
    "book": "proverbs                                ",
    "chapter": "30",
    "verse": "20",
    "text": "Taka"
  },
  {
    "id": 23873,
    "book": "proverbs                                ",
    "chapter": "30",
    "verse": "21",
    "text": "Pod trzema rzeczami drży ziemia, czterech nie może znieść:"
  },
  {
    "id": 23874,
    "book": "proverbs                                ",
    "chapter": "30",
    "verse": "22",
    "text": "Sługi, kiedy panuje, głupca, kiedy syci się chlebem;"
  },
  {
    "id": 23875,
    "book": "proverbs                                ",
    "chapter": "30",
    "verse": "23",
    "text": "Obmierzłej"
  },
  {
    "id": 23876,
    "book": "proverbs                                ",
    "chapter": "30",
    "verse": "24",
    "text": "Cztery są rzeczy najmniejsze na ziemi, jednak mędrsze nad mędrców:"
  },
  {
    "id": 23877,
    "book": "proverbs                                ",
    "chapter": "30",
    "verse": "25",
    "text": "Mrówki, lud słaby, a jednak w lecie przygotowują pokarm;"
  },
  {
    "id": 23878,
    "book": "proverbs                                ",
    "chapter": "30",
    "verse": "26",
    "text": "Króliki, lud słaby, a jednak budują swój dom w skale;"
  },
  {
    "id": 23879,
    "book": "proverbs                                ",
    "chapter": "30",
    "verse": "27",
    "text": "Szarańcze nie mają króla, a jednak wszystkie wyruszają chmarą;"
  },
  {
    "id": 23880,
    "book": "proverbs                                ",
    "chapter": "30",
    "verse": "28",
    "text": "Pająk pracuje rękoma, a bywa w pałacach królewskich."
  },
  {
    "id": 23881,
    "book": "proverbs                                ",
    "chapter": "30",
    "verse": "29",
    "text": "Trzy są rzeczy, które poruszają się wspaniale, cztery kroczą dostojnie:"
  },
  {
    "id": 23882,
    "book": "proverbs                                ",
    "chapter": "30",
    "verse": "30",
    "text": "Lew, najsilniejszy wśród zwierząt, który przed nikim nie ustępuje;"
  },
  {
    "id": 23883,
    "book": "proverbs                                ",
    "chapter": "30",
    "verse": "31",
    "text": "Chart i kozioł, i król, przeciw któremu nikt nie powstaje."
  },
  {
    "id": 23884,
    "book": "proverbs                                ",
    "chapter": "30",
    "verse": "32",
    "text": "Jeśli głupio postąpiłeś, wynosząc się, albo jeśli pomyślałeś źle,"
  },
  {
    "id": 23885,
    "book": "proverbs                                ",
    "chapter": "30",
    "verse": "33",
    "text": "Jak ubijanie mleka daje masło i wycieranie nosa wywołuje krew, tak kto wzbudza gniew, wszczyna kłótnię."
  }
]