[
  {
    "id": 23743,
    "book": "proverbs                                ",
    "chapter": "26",
    "verse": "1",
    "text": "Jak śnieg w lecie i jak deszcz we żniwa, tak głupiemu nie przystoi chwała."
  },
  {
    "id": 23744,
    "book": "proverbs                                ",
    "chapter": "26",
    "verse": "2",
    "text": "Jak ptak się tuła"
  },
  {
    "id": 23745,
    "book": "proverbs                                ",
    "chapter": "26",
    "verse": "3",
    "text": "Bicz na konia, wędzidło na osła, a kij na grzbiet głupiego."
  },
  {
    "id": 23746,
    "book": "proverbs                                ",
    "chapter": "26",
    "verse": "4",
    "text": "Nie odpowiadaj głupiemu według jego głupoty, abyś i ty nie był do niego podobny."
  },
  {
    "id": 23747,
    "book": "proverbs                                ",
    "chapter": "26",
    "verse": "5",
    "text": "Odpowiedz głupiemu według jego głupoty, aby nie był mądry we własnych oczach."
  },
  {
    "id": 23748,
    "book": "proverbs                                ",
    "chapter": "26",
    "verse": "6",
    "text": "Kto powierza głupiemu posłannictwo, odcina sobie nogi i pije na własną szkodę."
  },
  {
    "id": 23749,
    "book": "proverbs                                ",
    "chapter": "26",
    "verse": "7",
    "text": ""
  },
  {
    "id": 23750,
    "book": "proverbs                                ",
    "chapter": "26",
    "verse": "8",
    "text": "Jaki jest ten, kto przywiązuje kamień do procy, taki ten, kto oddaje cześć głupiemu."
  },
  {
    "id": 23751,
    "book": "proverbs                                ",
    "chapter": "26",
    "verse": "9",
    "text": "Jak cierń wbija się w rękę pijaka, tak przysłowie w ustach głupców."
  },
  {
    "id": 23752,
    "book": "proverbs                                ",
    "chapter": "26",
    "verse": "10",
    "text": "Wielki"
  },
  {
    "id": 23753,
    "book": "proverbs                                ",
    "chapter": "26",
    "verse": "11",
    "text": ""
  },
  {
    "id": 23754,
    "book": "proverbs                                ",
    "chapter": "26",
    "verse": "12",
    "text": "Widzisz człowieka, co mądry w swoich oczach? Więcej nadziei dla głupca niż dla niego."
  },
  {
    "id": 23755,
    "book": "proverbs                                ",
    "chapter": "26",
    "verse": "13",
    "text": "Leniwy mówi: Lew na drodze, lew na ulicach."
  },
  {
    "id": 23756,
    "book": "proverbs                                ",
    "chapter": "26",
    "verse": "14",
    "text": "Jak drzwi się obracają na swoich zawiasach, tak leniwy na swoim łóżku."
  },
  {
    "id": 23757,
    "book": "proverbs                                ",
    "chapter": "26",
    "verse": "15",
    "text": "Leniwy kryje rękę pod pachę, a ciężko mu ją podnosić do ust."
  },
  {
    "id": 23758,
    "book": "proverbs                                ",
    "chapter": "26",
    "verse": "16",
    "text": "Leniwy uważa się za mądrzejszego niż siedmiu odpowiadających rozsądnie."
  },
  {
    "id": 23759,
    "book": "proverbs                                ",
    "chapter": "26",
    "verse": "17",
    "text": "Kto przechodzi i wtrąca się w cudzy spór, jest jak ten, który łapie psa za uszy."
  },
  {
    "id": 23760,
    "book": "proverbs                                ",
    "chapter": "26",
    "verse": "18",
    "text": "Jak szalony wypuszcza iskry, strzały i śmierć;"
  },
  {
    "id": 23761,
    "book": "proverbs                                ",
    "chapter": "26",
    "verse": "19",
    "text": "Taki jest każdy, kto zwodzi swego bliźniego i mówi: Czy nie żartowałem?"
  },
  {
    "id": 23762,
    "book": "proverbs                                ",
    "chapter": "26",
    "verse": "20",
    "text": "Gdy nie ma drew, ogień gaśnie; tak gdy nie ma plotkarza, ustaje spór."
  },
  {
    "id": 23763,
    "book": "proverbs                                ",
    "chapter": "26",
    "verse": "21",
    "text": "Jak węgiel dla żaru i drwa do ognia, tak kłótliwy człowiek do wzniecenia sporu."
  },
  {
    "id": 23764,
    "book": "proverbs                                ",
    "chapter": "26",
    "verse": "22",
    "text": "Słowa plotkarzy są"
  },
  {
    "id": 23765,
    "book": "proverbs                                ",
    "chapter": "26",
    "verse": "23",
    "text": "Palące wargi i złe serce"
  },
  {
    "id": 23766,
    "book": "proverbs                                ",
    "chapter": "26",
    "verse": "24",
    "text": "Ten, kto nienawidzi, udaje wargami, lecz w sercu knuje podstęp."
  },
  {
    "id": 23767,
    "book": "proverbs                                ",
    "chapter": "26",
    "verse": "25",
    "text": "Gdy mówi miłym głosem, nie wierz mu, bo siedem obrzydliwości ma w swoim sercu."
  },
  {
    "id": 23768,
    "book": "proverbs                                ",
    "chapter": "26",
    "verse": "26",
    "text": "Nienawiść"
  },
  {
    "id": 23769,
    "book": "proverbs                                ",
    "chapter": "26",
    "verse": "27",
    "text": "Kto kopie dół, wpadnie w niego; kto kamień toczy, na niego się on obróci."
  },
  {
    "id": 23770,
    "book": "proverbs                                ",
    "chapter": "26",
    "verse": "28",
    "text": "Kłamliwy język nienawidzi"
  }
]