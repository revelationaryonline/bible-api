    "book": "proverbs                                ",
    "chapter": "4",
    "verse": "17",
    "text": "Jedzą bowiem chleb nieprawości i piją wino przemocy."
  },
  {
    "id": 23109,
    "book": "proverbs                                ",
    "chapter": "4",
    "verse": "18",
    "text": "Ale ścieżka sprawiedliwych"
  },
  {
    "id": 23110,
    "book": "proverbs                                ",
    "chapter": "4",
    "verse": "19",
    "text": "Droga niegodziwych"
  },
  {
    "id": 23111,
    "book": "proverbs                                ",
    "chapter": "4",
    "verse": "20",
    "text": "Synu mój, zważaj na moje słowa; ku moim naukom nakłoń swe ucho."
