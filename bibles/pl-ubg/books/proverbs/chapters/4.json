[
  {
    "id": 23092,
    "book": "proverbs                                ",
    "chapter": "4",
    "verse": "1",
    "text": "Słuchajcie, synowie, pouczenia ojca i zważajcie na to, abyście poznali roztropność;"
  },
  {
    "id": 23093,
    "book": "proverbs                                ",
    "chapter": "4",
    "verse": "2",
    "text": "Bo daję wam dobrą naukę, nie porzucajcie mego prawa."
  },
  {
    "id": 23094,
    "book": "proverbs                                ",
    "chapter": "4",
    "verse": "3",
    "text": "Byłem bowiem synem mego ojca i"
  },
  {
    "id": 23095,
    "book": "proverbs                                ",
    "chapter": "4",
    "verse": "4",
    "text": "On mnie uczył, mówiąc mi: Niech twoje serce zachowa moje słowa; strzeż moich przykazań, a będziesz żył."
  },
  {
    "id": 23096,
    "book": "proverbs                                ",
    "chapter": "4",
    "verse": "5",
    "text": "Zdobywaj mądrość, zdobywaj roztropność; nie zapominaj i nie odstępuj od słów moich ust."
  },
  {
    "id": 23097,
    "book": "proverbs                                ",
    "chapter": "4",
    "verse": "6",
    "text": "Nie opuszczaj jej, a będzie cię strzegła; ukochaj ją, a zachowa cię."
  },
  {
    "id": 23098,
    "book": "proverbs                                ",
    "chapter": "4",
    "verse": "7",
    "text": "Podstawą"
  },
  {
    "id": 23099,
    "book": "proverbs                                ",
    "chapter": "4",
    "verse": "8",
    "text": "Wywyższaj ją, a ona wywyższy ciebie, rozsławi cię, gdy ją przyjmiesz."
  },
  {
    "id": 23100,
    "book": "proverbs                                ",
    "chapter": "4",
    "verse": "9",
    "text": "Wdzięczną ozdobę włoży ci na głowę, obdarzy cię koroną chwały."
  },
  {
    "id": 23101,
    "book": "proverbs                                ",
    "chapter": "4",
    "verse": "10",
    "text": "Słuchaj, synu mój, i przyjmij moje słowa, a pomnożą się lata twojego życia."
  },
  {
    "id": 23102,
    "book": "proverbs                                ",
    "chapter": "4",
    "verse": "11",
    "text": "Nauczyłem cię drogi mądrości, po ścieżkach prawości cię wiodłem;"
  },
  {
    "id": 23103,
    "book": "proverbs                                ",
    "chapter": "4",
    "verse": "12",
    "text": "Gdy"
  },
  {
    "id": 23104,
    "book": "proverbs                                ",
    "chapter": "4",
    "verse": "13",
    "text": "Trzymaj się karności, nie opuszczaj"
  },
  {
    "id": 23105,
    "book": "proverbs                                ",
    "chapter": "4",
    "verse": "14",
    "text": "Nie chodź ścieżką niegodziwych i nie wchodź na drogę złych ludzi."
  },
  {
    "id": 23106,
    "book": "proverbs                                ",
    "chapter": "4",
    "verse": "15",
    "text": "Unikaj jej, nie chodź po niej; odwróć się od niej i omiń"
  },
  {
    "id": 23107,
    "book": "proverbs                                ",
    "chapter": "4",
    "verse": "16",
    "text": "Bo"
  },
  {
