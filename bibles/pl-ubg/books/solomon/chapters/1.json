[
  {
    "id": 21926,
    "book": "solomon                                 ",
    "chapter": "1",
    "verse": "1",
    "text": "Pieśń nad pieśniami Salomona."
  },
  {
    "id": 21927,
    "book": "solomon                                 ",
    "chapter": "1",
    "verse": "2",
    "text": "Niech mnie pocałuje pocałunkami swoich ust. Twoja miłość bowiem jest lepsza od wina."
  },
  {
    "id": 21928,
    "book": "solomon                                 ",
    "chapter": "1",
    "verse": "3",
    "text": "Z powodu wonności twoich olejków twoje imię"
  },
  {
    "id": 21929,
    "book": "solomon                                 ",
    "chapter": "1",
    "verse": "4",
    "text": "Pociągnij mnie,"
  },
  {
    "id": 21930,
    "book": "solomon                                 ",
    "chapter": "1",
    "verse": "5",
    "text": "Czarna jestem, ale piękna, o córki Jerozolimy, jak namioty Kedaru, jak zasłony Salomona."
  },
  {
    "id": 21931,
    "book": "solomon                                 ",
    "chapter": "1",
    "verse": "6",
    "text": "Nie patrzcie na mnie, że jestem czarna, gdyż słońce mnie opaliło. Synowie mojej matki rozgniewali się na mnie, postawili mnie na straży winnic; a mojej własnej winnicy nie ustrzegłam."
  },
  {
    "id": 21932,
    "book": "solomon                                 ",
    "chapter": "1",
    "verse": "7",
    "text": "Powiedz mi"
  },
  {
    "id": 21933,
    "book": "solomon                                 ",
    "chapter": "1",
    "verse": "8",
    "text": "Jeśli nie wiesz, najpiękniejsza wśród kobiet, to idź śladem trzody i paś swoje koźlątka przy szałasach pasterzy."
  },
  {
    "id": 21934,
    "book": "solomon                                 ",
    "chapter": "1",
    "verse": "9",
    "text": "Przyrównam cię, moja umiłowana, do zaprzęgu rydwanów faraona."
  },
  {
    "id": 21935,
    "book": "solomon                                 ",
    "chapter": "1",
    "verse": "10",
    "text": "Twoje lica są piękne, ozdobione klejnotami,"
  },
  {
    "id": 21936,
    "book": "solomon                                 ",
    "chapter": "1",
    "verse": "11",
    "text": "Uczynimy ci złote klejnoty nakrapiane srebrem."
  },
  {
    "id": 21937,
    "book": "solomon                                 ",
    "chapter": "1",
    "verse": "12",
    "text": "Dopóki król jest przy"
  },
  {
    "id": 21938,
    "book": "solomon                                 ",
    "chapter": "1",
    "verse": "13",
    "text": ""
  },
  {
    "id": 21939,
    "book": "solomon                                 ",
    "chapter": "1",
    "verse": "14",
    "text": "Mój miły jest dla mnie"
  },
  {
    "id": 21940,
    "book": "solomon                                 ",
    "chapter": "1",
    "verse": "15",
    "text": "O jaka ty jesteś piękna, moja umiłowana! O jaka ty jesteś piękna! Twoje oczy są"
  },
  {
    "id": 21941,
    "book": "solomon                                 ",
    "chapter": "1",
    "verse": "16",
    "text": "O jaki ty jesteś piękny, mój umiłowany, i jak miły! Łoże nasze się zieleni."
  },
  {
    "id": 21942,
    "book": "solomon                                 ",
    "chapter": "1",
    "verse": "17",
    "text": "Belki naszego domu są cedrowe, a nasze stropy – cyprysowe."
  }
]