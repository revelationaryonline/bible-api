[
  {
    "id": 17565,
    "book": "lamentations                            ",
    "chapter": "3",
    "verse": "1",
    "text": "Ja"
  },
  {
    "id": 17566,
    "book": "lamentations                            ",
    "chapter": "3",
    "verse": "2",
    "text": "Prowadził mnie i zawiódł do ciemności, a nie do światła."
  },
  {
    "id": 17567,
    "book": "lamentations                            ",
    "chapter": "3",
    "verse": "3",
    "text": "Oburzył się na mnie, zwraca swoją rękę"
  },
  {
    "id": 17568,
    "book": "lamentations                            ",
    "chapter": "3",
    "verse": "4",
    "text": "Sprawił, że zestarzały się moje ciało i moja skóra, połamał moje kości."
  },
  {
    "id": 17569,
    "book": "lamentations                            ",
    "chapter": "3",
    "verse": "5",
    "text": "Obudował mnie i otoczył żółcią i trudem;"
  },
  {
    "id": 17570,
    "book": "lamentations                            ",
    "chapter": "3",
    "verse": "6",
    "text": "Posadził mnie w ciemnych miejscach jak dawno umarłych."
  },
  {
    "id": 17571,
    "book": "lamentations                            ",
    "chapter": "3",
    "verse": "7",
    "text": "Ogrodził mnie, abym nie mógł wyjść, obciążył moje kajdany."
  },
  {
    "id": 17572,
    "book": "lamentations                            ",
    "chapter": "3",
    "verse": "8",
    "text": "A choć wołam i krzyczę, zatyka"
  },
  {
    "id": 17573,
    "book": "lamentations                            ",
    "chapter": "3",
    "verse": "9",
    "text": "Zagrodził moją drogę kamieniem ciosanym, poplątał moje ścieżki."
  },
  {
    "id": 17574,
    "book": "lamentations                            ",
    "chapter": "3",
    "verse": "10",
    "text": "Stał się dla mnie"
  },
  {
    "id": 17575,
    "book": "lamentations                            ",
    "chapter": "3",
    "verse": "11",
    "text": "Zmylił moje drogi, rozszarpał mnie i uczynił mnie spustoszonym."
  },
  {
    "id": 17576,
    "book": "lamentations                            ",
    "chapter": "3",
    "verse": "12",
    "text": "Napiął swój łuk i uczynił ze mnie cel dla swej strzały."
  },
  {
    "id": 17577,
    "book": "lamentations                            ",
    "chapter": "3",
    "verse": "13",
    "text": "Przebił moje nerki strzałami swego kołczana."
  },
  {
    "id": 17578,
    "book": "lamentations                            ",
    "chapter": "3",
    "verse": "14",
    "text": "Stałem się pośmiewiskiem dla całego mojego ludu,"
  },
  {
    "id": 17579,
    "book": "lamentations                            ",
    "chapter": "3",
    "verse": "15",
    "text": "Napełnił mnie goryczą, upoił mnie piołunem."
  },
  {
    "id": 17580,
    "book": "lamentations                            ",
    "chapter": "3",
    "verse": "16",
    "text": "Ponadto wykruszył żwirem moje zęby i pogrążył mnie w popiele."
  },
  {
    "id": 17581,
    "book": "lamentations                            ",
    "chapter": "3",
    "verse": "17",
    "text": "Oddaliłeś moją duszę od pokoju. Zapomniałem, co to pomyślność."
  },
  {
    "id": 17582,
    "book": "lamentations                            ",
    "chapter": "3",
    "verse": "18",
    "text": "I powiedziałem: Zginęła moja siła i moja nadzieja, jaką pokładałem w PANU."
  },
  {
    "id": 17583,
    "book": "lamentations                            ",
    "chapter": "3",
    "verse": "19",
    "text": "Wspominam swoje utrapienie i"
  },
  {
    "id": 17584,
    "book": "lamentations                            ",
    "chapter": "3",
    "verse": "20",
    "text": "Moja dusza nieustannie"
  },
  {
    "id": 17585,
    "book": "lamentations                            ",
    "chapter": "3",
    "verse": "21",
    "text": "Biorę to sobie do serca,"
  },
  {
    "id": 17586,
    "book": "lamentations                            ",
    "chapter": "3",
    "verse": "22",
    "text": "To wielkie miłosierdzie PANA, że nie zginęliśmy, gdyż nie ustaje jego litość."
  },
  {
    "id": 17587,
    "book": "lamentations                            ",
    "chapter": "3",
    "verse": "23",
    "text": "Każdego poranka się odnawia, wielka jest twoja wierność."
  },
  {
    "id": 17588,
    "book": "lamentations                            ",
    "chapter": "3",
    "verse": "24",
    "text": "PAN jest moim działem – mówi moja dusza – dlatego mam w nim nadzieję."
  },
  {
    "id": 17589,
    "book": "lamentations                            ",
    "chapter": "3",
    "verse": "25",
    "text": "Dobry"
  },
  {
    "id": 17590,
    "book": "lamentations                            ",
    "chapter": "3",
    "verse": "26",
    "text": "Dobrze jest cierpliwie oczekiwać na zbawienie PANA."
  },
  {
    "id": 17591,
    "book": "lamentations                            ",
    "chapter": "3",
    "verse": "27",
    "text": "Dobrze jest człowiekowi nosić jarzmo od swej młodości."
  },
  {
    "id": 17592,
    "book": "lamentations                            ",
    "chapter": "3",
    "verse": "28",
    "text": "Siedzi samotnie w milczeniu, gdyż na niego"
  },
  {
    "id": 17593,
    "book": "lamentations                            ",
    "chapter": "3",
    "verse": "29",
    "text": "Kładzie swe usta w prochu, może jest jeszcze nadzieja."
  },
  {
    "id": 17594,
    "book": "lamentations                            ",
    "chapter": "3",
    "verse": "30",
    "text": "Nadstawia bijącemu policzek, jest nasycony zniewagą."
  },
  {
    "id": 17595,
    "book": "lamentations                            ",
    "chapter": "3",
    "verse": "31",
    "text": "Pan bowiem nie odrzuca na wieki;"
  },
  {
    "id": 17596,
    "book": "lamentations                            ",
    "chapter": "3",
    "verse": "32",
    "text": "A jeśli zasmuca, znów się lituje według obfitości swego miłosierdzia;"
  },
  {
    "id": 17597,
    "book": "lamentations                            ",
    "chapter": "3",
    "verse": "33",
    "text": "Gdyż nie trapi chętnie ani nie zasmuca synów ludzkich."
  },
  {
    "id": 17598,
    "book": "lamentations                            ",
    "chapter": "3",
    "verse": "34",
    "text": "Miażdżenie pod nogami wszystkich więźniów ziemi;"
  },
  {
    "id": 17599,
    "book": "lamentations                            ",
    "chapter": "3",
    "verse": "35",
    "text": "Naginanie prawa człowieka przed obliczem Najwyższego;"
  },
  {
    "id": 17600,
    "book": "lamentations                            ",
    "chapter": "3",
    "verse": "36",
    "text": "Krzywdzenie człowieka w jego sprawie – Pan nie ma"
  },
  {
    "id": 17601,
    "book": "lamentations                            ",
    "chapter": "3",
    "verse": "37",
    "text": "Któż może powiedzieć, że coś się stanie, gdy Pan tego nie rozkazał?"
  },
  {
    "id": 17602,
    "book": "lamentations                            ",
    "chapter": "3",
    "verse": "38",
    "text": "Czyż z ust Najwyższego nie pochodzi zło i dobro?"
  },
  {
    "id": 17603,
    "book": "lamentations                            ",
    "chapter": "3",
    "verse": "39",
    "text": "Czemu więc żali się człowiek żyjący, człowiek – z powodu kary za swoje grzechy?"
  },
  {
    "id": 17604,
    "book": "lamentations                            ",
    "chapter": "3",
    "verse": "40",
    "text": "Doświadczajmy i badajmy nasze drogi, nawróćmy się do PANA."
  },
  {
    "id": 17605,
    "book": "lamentations                            ",
    "chapter": "3",
    "verse": "41",
    "text": "Wznieśmy swoje serca i ręce do Boga w niebiosach."
  },
  {
    "id": 17606,
    "book": "lamentations                            ",
    "chapter": "3",
    "verse": "42",
    "text": "Zgrzeszyliśmy i zbuntowaliśmy się,"
  },
  {
    "id": 17607,
    "book": "lamentations                            ",
    "chapter": "3",
    "verse": "43",
    "text": "Okryłeś się gniewem i prześladowałeś nas, zabiłeś bez litości."
  },
  {
    "id": 17608,
    "book": "lamentations                            ",
    "chapter": "3",
    "verse": "44",
    "text": "Okryłeś się obłokiem, aby nie dotarła do ciebie modlitwa."
  },
  {
    "id": 17609,
    "book": "lamentations                            ",
    "chapter": "3",
    "verse": "45",
    "text": "Uczyniłeś nas śmieciem i pogardą pośród tych narodów."
  },
  {
    "id": 17610,
    "book": "lamentations                            ",
    "chapter": "3",
    "verse": "46",
    "text": "Otworzyli na nas swoje usta wszyscy nasi wrogowie."
  },
  {
    "id": 17611,
    "book": "lamentations                            ",
    "chapter": "3",
    "verse": "47",
    "text": "Spadły na nas strach i pułapka, spustoszenie i zniszczenie."
  },
  {
    "id": 17612,
    "book": "lamentations                            ",
    "chapter": "3",
    "verse": "48",
    "text": "Strumienie wód płyną z moich oczu z powodu zniszczenia córki mojego ludu."
  },
  {
    "id": 17613,
    "book": "lamentations                            ",
    "chapter": "3",
    "verse": "49",
    "text": "Z moich oczu bez przerwy spływają"
  },
  {
    "id": 17614,
    "book": "lamentations                            ",
    "chapter": "3",
    "verse": "50",
    "text": "Póki nie spojrzy i nie zobaczy PAN z nieba."
  },
  {
    "id": 17615,
    "book": "lamentations                            ",
    "chapter": "3",
    "verse": "51",
    "text": "Moje oczy trapią moją duszę z powodu wszystkich córek mojego miasta."
  },
  {
    "id": 17616,
    "book": "lamentations                            ",
    "chapter": "3",
    "verse": "52",
    "text": "Moi wrogowie polowali na mnie nieustannie jak na ptaka, bez powodu."
  },
  {
    "id": 17617,
    "book": "lamentations                            ",
    "chapter": "3",
    "verse": "53",
    "text": "Wyniszczyli moje życie w lochu i przywalili mnie kamieniem."
  },
  {
    "id": 17618,
    "book": "lamentations                            ",
    "chapter": "3",
    "verse": "54",
    "text": "Wezbrały wody nad moją głową i powiedziałem: Już po mnie!"
  },
  {
    "id": 17619,
    "book": "lamentations                            ",
    "chapter": "3",
    "verse": "55",
    "text": "Wzywałem twego imienia, PANIE, z głębokiego lochu."
  },
  {
    "id": 17620,
    "book": "lamentations                            ",
    "chapter": "3",
    "verse": "56",
    "text": "Usłyszałeś mój głos, nie zakrywaj swego ucha przed moim wzdychaniem i przed moim wołaniem."
  },
  {
    "id": 17621,
    "book": "lamentations                            ",
    "chapter": "3",
    "verse": "57",
    "text": "Zbliżyłeś się"
  },
  {
    "id": 17622,
    "book": "lamentations                            ",
    "chapter": "3",
    "verse": "58",
    "text": "Broniłeś, Panie, sprawy mojej duszy, wybawiłeś moje życie."
  },
  {
    "id": 17623,
    "book": "lamentations                            ",
    "chapter": "3",
    "verse": "59",
    "text": "PANIE, widzisz moją krzywdę, osądź moją sprawę."
  },
  {
    "id": 17624,
    "book": "lamentations                            ",
    "chapter": "3",
    "verse": "60",
    "text": "Widzisz całą ich zemstę i wszystkie ich zamysły przeciwko mnie."
  },
  {
    "id": 17625,
    "book": "lamentations                            ",
    "chapter": "3",
    "verse": "61",
    "text": "Słyszysz ich urąganie, PANIE,"
  },
  {
    "id": 17626,
    "book": "lamentations                            ",
    "chapter": "3",
    "verse": "62",
    "text": ""
  },
  {
    "id": 17627,
    "book": "lamentations                            ",
    "chapter": "3",
    "verse": "63",
    "text": "Zobacz – gdy siedzą i gdy wstają, jestem"
  },
  {
    "id": 17628,
    "book": "lamentations                            ",
    "chapter": "3",
    "verse": "64",
    "text": "Oddaj im zapłatę, PANIE, według dzieła ich rąk."
  },
  {
    "id": 17629,
    "book": "lamentations                            ",
    "chapter": "3",
    "verse": "65",
    "text": "Daj im zatwardziałe serce i"
  },
  {
    "id": 17630,
    "book": "lamentations                            ",
    "chapter": "3",
    "verse": "66",
    "text": "Ścigaj ich w gniewie"
  }
]