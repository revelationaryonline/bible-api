[
  {
    "id": 27419,
    "book": "genesis                                 ",
    "chapter": "36",
    "verse": "1",
    "text": "To są dzieje rodu Ezawa, czyli Edomu."
  },
  {
    "id": 27420,
    "book": "genesis                                 ",
    "chapter": "36",
    "verse": "2",
    "text": "Ezaw pojął swoje żony z córek Kanaanu: Adę, córkę Elona Chetyty, Oholibamę, córkę Any, córki Sibeona Chiwwity;"
  },
  {
    "id": 27421,
    "book": "genesis                                 ",
    "chapter": "36",
    "verse": "3",
    "text": "I Basmat, córkę Izmaela, siostrę Nebajota."
  },
  {
    "id": 27422,
    "book": "genesis                                 ",
    "chapter": "36",
    "verse": "4",
    "text": "I Ada urodziła Ezawowi Elifaza, a Basmat urodziła Rehuela."
  },
  {
    "id": 27423,
    "book": "genesis                                 ",
    "chapter": "36",
    "verse": "5",
    "text": "Oholibama urodziła Jeusza, Jalama i Koracha. To"
  },
  {
    "id": 27424,
    "book": "genesis                                 ",
    "chapter": "36",
    "verse": "6",
    "text": "I Ezaw wziął swoje żony, synów, córki i wszystkich domowników, swoje stada, wszystkie bydła i całe swoje mienie, które zdobył w ziemi Kanaan, i odszedł od swego brata Jakuba do"
  },
  {
    "id": 27425,
    "book": "genesis                                 ",
    "chapter": "36",
    "verse": "7",
    "text": "Bo ich majątek był tak wielki, że nie mogli mieszkać razem, i ziemia, na której przebywali, nie mogła ich utrzymać z powodu"
  },
  {
    "id": 27426,
    "book": "genesis                                 ",
    "chapter": "36",
    "verse": "8",
    "text": "I Ezaw zamieszkał na górze Seir. Ezaw to Edom."
  },
  {
    "id": 27427,
    "book": "genesis                                 ",
    "chapter": "36",
    "verse": "9",
    "text": "A to są dzieje rodu Ezawa, ojca Edomitów, na górze Seir."
  },
  {
    "id": 27428,
    "book": "genesis                                 ",
    "chapter": "36",
    "verse": "10",
    "text": "I to są imiona synów Ezawa: Elifaz, syn Ady, żony Ezawa, Rehuel, syn Basmat, żony Ezawa."
  },
  {
    "id": 27429,
    "book": "genesis                                 ",
    "chapter": "36",
    "verse": "11",
    "text": "Synami zaś Elifaza byli: Teman, Omar, Sefo, Gatam i Kenaz."
  },
  {
    "id": 27430,
    "book": "genesis                                 ",
    "chapter": "36",
    "verse": "12",
    "text": "A Timna była nałożnicą Elifaza, syna Ezawa, i urodziła Elifazowi Amaleka. To"
  },
  {
    "id": 27431,
    "book": "genesis                                 ",
    "chapter": "36",
    "verse": "13",
    "text": "To"
  },
  {
    "id": 27432,
    "book": "genesis                                 ",
    "chapter": "36",
    "verse": "14",
    "text": "A ci byli synami żony Ezawa Oholibamy, córki Any, córki Sibeona. Urodziła ona Ezawowi Jeusza, Jalama i Koracha."
  },
  {
    "id": 27433,
    "book": "genesis                                 ",
    "chapter": "36",
    "verse": "15",
    "text": "To"
  },
  {
    "id": 27434,
    "book": "genesis                                 ",
    "chapter": "36",
    "verse": "16",
    "text": "Książę Korach, książę Gatam, książę Amalek. Ci książęta"
  },
  {
    "id": 27435,
    "book": "genesis                                 ",
    "chapter": "36",
    "verse": "17",
    "text": "To"
  },
  {
    "id": 27436,
    "book": "genesis                                 ",
    "chapter": "36",
    "verse": "18",
    "text": "A to"
  },
  {
    "id": 27437,
    "book": "genesis                                 ",
    "chapter": "36",
    "verse": "19",
    "text": "To"
  },
  {
    "id": 27438,
    "book": "genesis                                 ",
    "chapter": "36",
    "verse": "20",
    "text": "A to"
  },
  {
    "id": 27439,
    "book": "genesis                                 ",
    "chapter": "36",
    "verse": "21",
    "text": "Diszon, Eser i Diszan. To"
  },
  {
    "id": 27440,
    "book": "genesis                                 ",
    "chapter": "36",
    "verse": "22",
    "text": "Synami Lotana byli: Chori i Hemam; a siostrą Lotana była Tamna."
  },
  {
    "id": 27441,
    "book": "genesis                                 ",
    "chapter": "36",
    "verse": "23",
    "text": "Synowie zaś Szobala: Alwan, Manachat, Ebal, Szefo i Onam."
  },
  {
    "id": 27442,
    "book": "genesis                                 ",
    "chapter": "36",
    "verse": "24",
    "text": "Synami Sibeona"
  },
  {
    "id": 27443,
    "book": "genesis                                 ",
    "chapter": "36",
    "verse": "25",
    "text": "A to"
  },
  {
    "id": 27444,
    "book": "genesis                                 ",
    "chapter": "36",
    "verse": "26",
    "text": "I synowie Diszona: Chemdan, Eszban, Jitran i Keran."
  },
  {
    "id": 27445,
    "book": "genesis                                 ",
    "chapter": "36",
    "verse": "27",
    "text": "To są synowie Esera: Bilhan, Zaawan i Akan."
  },
  {
    "id": 27446,
    "book": "genesis                                 ",
    "chapter": "36",
    "verse": "28",
    "text": "I synowie Diszana: Us i Aran."
  },
  {
    "id": 27447,
    "book": "genesis                                 ",
    "chapter": "36",
    "verse": "29",
    "text": "To są książęta Chorytów: książę Lotan, książę Szobal, książę Sibeon, książę Ana."
  },
  {
    "id": 27448,
    "book": "genesis                                 ",
    "chapter": "36",
    "verse": "30",
    "text": "Książę Diszon, książę Eser, książę Diszan."
  },
  {
    "id": 27449,
    "book": "genesis                                 ",
    "chapter": "36",
    "verse": "31",
    "text": "To"
  },
  {
    "id": 27450,
    "book": "genesis                                 ",
    "chapter": "36",
    "verse": "32",
    "text": "W Edomie panował Bela, syn Beora, a nazwa jego miasta – Dinhaba."
  },
  {
    "id": 27451,
    "book": "genesis                                 ",
    "chapter": "36",
    "verse": "33",
    "text": "I Bela umarł, a w jego miejsce panował Jobab, syn Zeracha z Bosry."
  },
  {
    "id": 27452,
    "book": "genesis                                 ",
    "chapter": "36",
    "verse": "34",
    "text": "Jobab umarł, a w jego miejsce panował Chuszam z ziemi Temanitów."
  },
  {
    "id": 27453,
    "book": "genesis                                 ",
    "chapter": "36",
    "verse": "35",
    "text": "Chuszam umarł, a w jego miejsce panował Hadad, syn Bedada, który pokonał Midianitów na polu Moab, a nazwa jego miasta – Awit."
  },
  {
    "id": 27454,
    "book": "genesis                                 ",
    "chapter": "36",
    "verse": "36",
    "text": "Hadad umarł, a w jego miejsce panował Samla z Masreki."
  },
  {
    "id": 27455,
    "book": "genesis                                 ",
    "chapter": "36",
    "verse": "37",
    "text": "Samla umarł, a w jego miejsce panował Saul z Rechobot nad Rzeką."
  },
  {
    "id": 27456,
    "book": "genesis                                 ",
    "chapter": "36",
    "verse": "38",
    "text": "Saul umarł, a w jego miejsce panował Baalchanan, syn Akbora."
  },
  {
    "id": 27457,
    "book": "genesis                                 ",
    "chapter": "36",
    "verse": "39",
    "text": "Baalchanan, syn Akbora, umarł, a w jego miejsce panował Hadar, a nazwa jego miasta – Pahu, a imię jego żony"
  },
  {
    "id": 27458,
    "book": "genesis                                 ",
    "chapter": "36",
    "verse": "40",
    "text": "To"
  },
  {
    "id": 27459,
    "book": "genesis                                 ",
    "chapter": "36",
    "verse": "41",
    "text": "Książę Oholibama, książę Ela, książę Pinon."
  },
  {
    "id": 27460,
    "book": "genesis                                 ",
    "chapter": "36",
    "verse": "42",
    "text": "Książę Kenaz, książę Teman, książę Mibsar."
  },
  {
    "id": 27461,
    "book": "genesis                                 ",
    "chapter": "36",
    "verse": "43",
    "text": "Książę Magdiel, książę Iram. To"
  }
]