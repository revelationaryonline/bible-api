  {
    "id": 8440,
    "book": "firstChronicles                         ",
    "chapter": "1",
    "verse": "36",
    "text": "Synowie Elifaza: Teman, Omar, Sefo, Gatam, Kenaz, Timna i Amalek."
  },
  {
    "id": 8441,
    "book": "firstChronicles                         ",
