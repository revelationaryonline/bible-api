    "book": "firstChronicles                         ",
    "chapter": "1",
    "verse": "10",
    "text": "Kusz spłodził Nimroda, który zaczął być mocarzem na ziemi."
  },
  {
    "id": 8415,
    "book": "firstChronicles                         ",
    "chapter": "1",
