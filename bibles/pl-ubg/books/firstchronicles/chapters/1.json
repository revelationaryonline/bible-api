    "book": "firstChronicles                         ",
    "chapter": "1",
    "verse": "20",
    "text": "Joktan spłodził Almodada, Szelefa, Chasarmaweta i Jeracha;"
  },
  {
    "id": 8425,
    "book": "firstChronicles                         ",
