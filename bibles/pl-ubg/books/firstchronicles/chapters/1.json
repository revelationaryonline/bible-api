  },
  {
    "id": 8416,
    "book": "firstChronicles                         ",
    "chapter": "1",
    "verse": "12",
    "text": "Oraz Patrusyma, Kasluchima, od których wywodzą się Filistyni, i Kaftoryma."
  },
  {
    "id": 8417,
    "book": "firstChronicles                         ",
    "chapter": "1",
    "verse": "13",
    "text": "Kanaan zaś spłodził Sidona, swego pierworodnego, i Cheta;"
