[
  {
    "id": 3385,
    "book": "proverbs                                ",
    "chapter": "24",
    "verse": "1",
    "text": "Jangan iri terhadap orang-orang jahat24:1 Ams. 3:31; 23:17; 24:19"
  },
  {
    "id": 3386,
    "book": "proverbs                                ",
    "chapter": "24",
    "verse": "2",
    "text": "Karena mereka suka berbicara tentang kelakuan kejam"
  },
  {
    "id": 3387,
    "book": "proverbs                                ",
    "chapter": "24",
    "verse": "3",
    "text": "Dengan menjadi bijaksana, engkau dapat membangun rumah tangga."
  },
  {
    "id": 3388,
    "book": "proverbs                                ",
    "chapter": "24",
    "verse": "4",
    "text": "Dan dengan pengetahuan, engkau dapat mengumpulkan harta indah bagi rumah tanggamu."
  },
  {
    "id": 3389,
    "book": "proverbs                                ",
    "chapter": "24",
    "verse": "5",
    "text": "Semakin besar kebijaksanaan dan pengetahuan seseorang,"
  },
  {
    "id": 3390,
    "book": "proverbs                                ",
    "chapter": "24",
    "verse": "6",
    "text": "Itulah sebabnya, untuk meraih kemenangan,"
  },
  {
    "id": 3391,
    "book": "proverbs                                ",
    "chapter": "24",
    "verse": "7",
    "text": "Kebijaksanaan terlalu sulit untuk dimengerti orang bodoh."
  },
  {
    "id": 3392,
    "book": "proverbs                                ",
    "chapter": "24",
    "verse": "8",
    "text": "Orang yang selalu merencanakan kejahatan,"
  },
  {
    "id": 3393,
    "book": "proverbs                                ",
    "chapter": "24",
    "verse": "9",
    "text": "Rencana orang bebal selalu menimbulkan dosa."
  },
  {
    "id": 3394,
    "book": "proverbs                                ",
    "chapter": "24",
    "verse": "10",
    "text": "Bila engkau menyerah saat menghadapi kesusahan,"
  },
  {
    "id": 3395,
    "book": "proverbs                                ",
    "chapter": "24",
    "verse": "11",
    "text": "Saat engkau melihat orang yang tak bersalah berada dalam bahaya kematian,"
  },
  {
    "id": 3396,
    "book": "proverbs                                ",
    "chapter": "24",
    "verse": "12",
    "text": "Janganlah membuat alasan, “Oh, saya tidak tahu bahwa dia tak bersalah!”"
  },
  {
    "id": 3397,
    "book": "proverbs                                ",
    "chapter": "24",
    "verse": "13",
    "text": "Anakku, makanlah madu karena itu baik,"
  },
  {
    "id": 3398,
    "book": "proverbs                                ",
    "chapter": "24",
    "verse": "14",
    "text": "Kebijaksanaan itu seperti madu bagi hidupmu."
  },
  {
    "id": 3399,
    "book": "proverbs                                ",
    "chapter": "24",
    "verse": "15",
    "text": "Jangan seperti orang jahat,"
  },
  {
    "id": 3400,
    "book": "proverbs                                ",
    "chapter": "24",
    "verse": "16",
    "text": "Meskipun orang benar jatuh berkali-kali, dia akan selalu bangkit kembali,"
  },
  {
    "id": 3401,
    "book": "proverbs                                ",
    "chapter": "24",
    "verse": "17",
    "text": "Jangan bergembira ketika musuhmu jatuh,"
  },
  {
    "id": 3402,
    "book": "proverbs                                ",
    "chapter": "24",
    "verse": "18",
    "text": "Sebab TUHAN tidak berkenan kepada sikap seperti itu"
  },
  {
    "id": 3403,
    "book": "proverbs                                ",
    "chapter": "24",
    "verse": "19",
    "text": "Jangan kesal ataupun iri terhadap orang jahat"
  },
  {
    "id": 3404,
    "book": "proverbs                                ",
    "chapter": "24",
    "verse": "20",
    "text": "Karena orang jahat tidak memiliki masa depan,"
  },
  {
    "id": 3405,
    "book": "proverbs                                ",
    "chapter": "24",
    "verse": "21",
    "text": "Anakku, takutlah akan TUHAN dan hormatlah terhadap raja."
  },
  {
    "id": 3406,
    "book": "proverbs                                ",
    "chapter": "24",
    "verse": "22",
    "text": "Karena orang-orang yang memberontak akan hancur dalam sekejap."
  },
  {
    "id": 3407,
    "book": "proverbs                                ",
    "chapter": "24",
    "verse": "23",
    "text": "Berikut ini juga perkataan dari orang-orang bijak:"
  },
  {
    "id": 3408,
    "book": "proverbs                                ",
    "chapter": "24",
    "verse": "24",
    "text": "Bila kepada pihak yang bersalah hakim memutuskan, “Engkau tidak bersalah,”"
  },
  {
    "id": 3409,
    "book": "proverbs                                ",
    "chapter": "24",
    "verse": "25",
    "text": "Sebaliknya, hakim yang menjatuhkan hukuman dengan jujur kepada orang yang bersalah akan berbahagia"
  },
  {
    "id": 3410,
    "book": "proverbs                                ",
    "chapter": "24",
    "verse": "26",
    "text": "Persahabatan yang paling manis terasa ketika teman dekat memberi nasihat yang jujur."
  },
  {
    "id": 3411,
    "book": "proverbs                                ",
    "chapter": "24",
    "verse": "27",
    "text": "Anakku, sesudah menikah,"
  },
  {
    "id": 3412,
    "book": "proverbs                                ",
    "chapter": "24",
    "verse": "28",
    "text": "Jangan menjadi saksi dusta"
  },
  {
    "id": 3413,
    "book": "proverbs                                ",
    "chapter": "24",
    "verse": "29",
    "text": "Janganlah berpikir, “Aku akan membalas perbuatannya kepadaku."
  },
  {
    "id": 3414,
    "book": "proverbs                                ",
    "chapter": "24",
    "verse": "30",
    "text": "Suatu hari aku melewati kebun anggur seorang pemalas."
  },
  {
    "id": 3415,
    "book": "proverbs                                ",
    "chapter": "24",
    "verse": "31",
    "text": "Semuanya penuh ditumbuhi rumput liar dan semak berduri,"
  },
  {
    "id": 3416,
    "book": "proverbs                                ",
    "chapter": "24",
    "verse": "32",
    "text": "Lalu aku merenungkan hal itu dan inilah pelajaran yang aku dapatkan:"
  },
  {
    "id": 3417,
    "book": "proverbs                                ",
    "chapter": "24",
    "verse": "33",
    "text": "Pemalas berpikir,"
  },
  {
    "id": 3418,
    "book": "proverbs                                ",
    "chapter": "24",
    "verse": "34",
    "text": "Maka seperti perampok yang datang tak terduga, demikianlah si pemalas mendadak miskin."
  }
]