[
  {
    "id": 2913,
    "book": "proverbs                                ",
    "chapter": "8",
    "verse": "1",
    "text": "Dengarkanlah! Sang Hikmat berseru-seru menawarkan kesempatan untuk mendapat pengertian."
  },
  {
    "id": 2914,
    "book": "proverbs                                ",
    "chapter": "8",
    "verse": "2-3",
    "text": "Dia mengumumkan kesempatan itu seluas-luasnya,"
  },
  {
    "id": 2915,
    "book": "proverbs                                ",
    "chapter": "8",
    "verse": "4",
    "text": "“Aku memanggil kalian semua! Dengarkanlah aku!"
  },
  {
    "id": 2916,
    "book": "proverbs                                ",
    "chapter": "8",
    "verse": "5",
    "text": "Siapa yang tidak berpengalaman,8:5 Ams. 1:4 belajarlah menjadi bijak."
  },
  {
    "id": 2917,
    "book": "proverbs                                ",
    "chapter": "8",
    "verse": "6",
    "text": "Dengarkanlah, karena aku akan memberitahukan hal-hal yang sangat berharga."
  },
  {
    "id": 2918,
    "book": "proverbs                                ",
    "chapter": "8",
    "verse": "7",
    "text": "Ajaranku layak dipercaya,"
  },
  {
    "id": 2919,
    "book": "proverbs                                ",
    "chapter": "8",
    "verse": "8",
    "text": "Semua nasihatku jujur."
  },
  {
    "id": 2920,
    "book": "proverbs                                ",
    "chapter": "8",
    "verse": "9",
    "text": "Bila engkau berpengertian, tentu engkau akan menyukai nasihatku."
  },
  {
    "id": 2921,
    "book": "proverbs                                ",
    "chapter": "8",
    "verse": "10-11",
    "text": "Terimalah ajaran penuh hikmat dariku, karena itu lebih berharga daripada perak maupun emas murni,"
  },
  {
    "id": 2922,
    "book": "proverbs                                ",
    "chapter": "8",
    "verse": "12",
    "text": "“Akulah Hikmat. Bila engkau menerima aku, engkau juga akan bertambah kecerdikan, pengetahuan, dan kematangan berpikir."
  },
  {
    "id": 2923,
    "book": "proverbs                                ",
    "chapter": "8",
    "verse": "13",
    "text": "Apabila mengenal aku, tentu engkau akan hormat dan takut kepada TUHAN dan membenci kejahatan,"
  },
  {
    "id": 2924,
    "book": "proverbs                                ",
    "chapter": "8",
    "verse": "14",
    "text": "Dengan mengenal aku, engkau juga akan mendapat nasihat terbaik"
  },
  {
    "id": 2925,
    "book": "proverbs                                ",
    "chapter": "8",
    "verse": "15",
    "text": "Para raja mampu memerintah"
  },
  {
    "id": 2926,
    "book": "proverbs                                ",
    "chapter": "8",
    "verse": "16",
    "text": "Setiap pemimpin dan pejabat,"
  },
  {
    "id": 2927,
    "book": "proverbs                                ",
    "chapter": "8",
    "verse": "17",
    "text": "“Aku mengasihi orang yang mengasihi aku,"
  },
  {
    "id": 2928,
    "book": "proverbs                                ",
    "chapter": "8",
    "verse": "18",
    "text": "Padaku tersedia kekayaan, kehormatan, keberhasilan, dan kemakmuran yang mapan."
  },
  {
    "id": 2929,
    "book": "proverbs                                ",
    "chapter": "8",
    "verse": "19",
    "text": "Manfaat yang aku berikan lebih berharga daripada perak, bahkan emas murni."
  },
  {
    "id": 2930,
    "book": "proverbs                                ",
    "chapter": "8",
    "verse": "20",
    "text": "Jalan hidup yang aku ajarkan adalah benar dan adil."
  },
  {
    "id": 2931,
    "book": "proverbs                                ",
    "chapter": "8",
    "verse": "21",
    "text": "Aku memberikan harta pusaka bagi orang yang mengasihiku"
  },
  {
    "id": 2932,
    "book": "proverbs                                ",
    "chapter": "8",
    "verse": "22",
    "text": "“Sejak semula, aku— Hikmat— ada pada diri TUHAN."
  },
  {
    "id": 2933,
    "book": "proverbs                                ",
    "chapter": "8",
    "verse": "23",
    "text": "Pada permulaan segala sesuatu, sebelum bumi ini ada,"
  },
  {
    "id": 2934,
    "book": "proverbs                                ",
    "chapter": "8",
    "verse": "24",
    "text": "Sebelum ada segala samudera,"
  },
  {
    "id": 2935,
    "book": "proverbs                                ",
    "chapter": "8",
    "verse": "25",
    "text": "juga sebelum gunung dan bukit didirikan-Nya,"
  },
  {
    "id": 2936,
    "book": "proverbs                                ",
    "chapter": "8",
    "verse": "26",
    "text": "sebelum Dia menjadikan bumi serta daratannya yang luas,"
  },
  {
    "id": 2937,
    "book": "proverbs                                ",
    "chapter": "8",
    "verse": "27",
    "text": "Melalui akulah, Sang Hikmat, TUHAN menciptakan langit,"
  },
  {
    "id": 2938,
    "book": "proverbs                                ",
    "chapter": "8",
    "verse": "28",
    "text": "menghiasi langit dengan awan gemawan,"
  },
  {
    "id": 2939,
    "book": "proverbs                                ",
    "chapter": "8",
    "verse": "29",
    "text": "Oleh Hikmatlah TUHAN menata dasar-dasar bumi"
  },
  {
    "id": 2940,
    "book": "proverbs                                ",
    "chapter": "8",
    "verse": "30-31",
    "text": "Melalui akulah TUHAN berkarya."
  },
  {
    "id": 2941,
    "book": "proverbs                                ",
    "chapter": "8",
    "verse": "32",
    "text": "“Karena itu, hai semua manusia, dengarkanlah aku, Sang Hikmat!"
  },
  {
    "id": 2942,
    "book": "proverbs                                ",
    "chapter": "8",
    "verse": "33",
    "text": "Dengarkan didikanku agar engkau menjadi bijak."
  },
  {
    "id": 2943,
    "book": "proverbs                                ",
    "chapter": "8",
    "verse": "34",
    "text": "Sungguh diberkati orang yang senang mendengarkan ajaranku,"
  },
  {
    "id": 2944,
    "book": "proverbs                                ",
    "chapter": "8",
    "verse": "35",
    "text": "Sebab orang yang menerima aku akan hidup sejahtera"
  },
  {
    "id": 2945,
    "book": "proverbs                                ",
    "chapter": "8",
    "verse": "36",
    "text": "tetapi orang yang tidak mau menerima aku mencelakakan dirinya sendiri."
  }
]