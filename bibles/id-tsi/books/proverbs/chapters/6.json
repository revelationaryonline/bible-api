  {
    "id": 2867,
    "book": "proverbs                                ",
    "chapter": "6",
    "verse": "14",
    "text": "Hati pembohong tak henti memikirkan tipu daya dan rencana licik."
  },
  {
    "id": 2868,
    "book": "proverbs                                ",
    "chapter": "6",
    "verse": "15",
    "text": "Karena itu bencana akan menimpa mereka dengan tiba-tiba."
  },
  {
    "id": 2869,
    "book": "proverbs                                ",
    "chapter": "6",
    "verse": "16",
    "text": "Ada beberapa kejahatan yang sangat dibenci TUHAN:"
  },
  {
    "id": 2870,
    "book": "proverbs                                ",
    "chapter": "6",
    "verse": "17",
    "text": "Mata yang memandang rendah orang lain,"
