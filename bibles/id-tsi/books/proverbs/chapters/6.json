  },
  {
    "id": 2862,
    "book": "proverbs                                ",
    "chapter": "6",
    "verse": "9",
    "text": "Tetapi pemalas hanya berbaring-baring sepanjang hari!"
  },
  {
    "id": 2863,
    "book": "proverbs                                ",
    "chapter": "6",
    "verse": "10",
    "text": "“Ah, aku masih mengantuk."
  },
  {
    "id": 2864,
    "book": "proverbs                                ",
    "chapter": "6",
    "verse": "11",
    "text": "Maka seperti perampok yang datang tak terduga, demikianlah kamu mendadak miskin."
