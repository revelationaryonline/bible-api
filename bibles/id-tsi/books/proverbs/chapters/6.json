  {
    "id": 2865,
    "book": "proverbs                                ",
    "chapter": "6",
    "verse": "12",
    "text": "Pembohong itu sampah!"
  },
  {
    "id": 2866,
    "book": "proverbs                                ",
    "chapter": "6",
    "verse": "13",
    "text": "Mereka mengedipkan mata atau membuat isyarat kecil dengan tangan atau kaki"
