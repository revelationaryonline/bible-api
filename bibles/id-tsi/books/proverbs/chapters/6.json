  {
    "id": 2871,
    "book": "proverbs                                ",
    "chapter": "6",
    "verse": "18",
    "text": "hati yang merencanakan kejahatan,"
  },
  {
    "id": 2872,
    "book": "proverbs                                ",
    "chapter": "6",
    "verse": "19",
    "text": "orang yang memberi saksi dusta,"
  },
  {
    "id": 2873,
    "book": "proverbs                                ",
    "chapter": "6",
    "verse": "20",
    "text": "Anakku, ikutilah ajaran ayahmu"
  },
  {
    "id": 2874,
    "book": "proverbs                                ",
    "chapter": "6",
    "verse": "21",
    "text": "Simpanlah semuanya baik-baik di dalam hatimu."
  },
  {
    "id": 2875,
    "book": "proverbs                                ",
    "chapter": "6",
    "verse": "22",
    "text": "Bila engkau terus mengingatnya, ajaran itu akan memandu langkah hidupmu."
  },
  {
    "id": 2876,
    "book": "proverbs                                ",
    "chapter": "6",
    "verse": "23",
    "text": "Karena nasihat, bimbingan, dan teguran itu ibarat cahaya terang"
  },
  {
    "id": 2877,
    "book": "proverbs                                ",
    "chapter": "6",
    "verse": "24",
    "text": "Dengan mengikutinya, engkau akan luput dari bujukan perempuan sundal"
  },
  {
    "id": 2878,
    "book": "proverbs                                ",
    "chapter": "6",
    "verse": "25",
    "text": "Jangan tergoda oleh kecantikannya,"
  },
  {
    "id": 2879,
    "book": "proverbs                                ",
    "chapter": "6",
    "verse": "26",
    "text": "Bila engkau tidur dengan pelacur, engkau bisa membayar hanya seharga roti,"
  },
  {
    "id": 2880,
    "book": "proverbs                                ",
    "chapter": "6",
    "verse": "27-28",
    "text": "Bermain api, hangus,"
  },
  {
    "id": 2881,
    "book": "proverbs                                ",
    "chapter": "6",
    "verse": "29",
    "text": "Begitu juga bila engkau berzina dengan istri orang,"
  },
  {
    "id": 2882,
    "book": "proverbs                                ",
    "chapter": "6",
    "verse": "30",
    "text": "Bila orang mencuri karena lapar, orang lain bisa maklum"
  },
  {
    "id": 2883,
    "book": "proverbs                                ",
    "chapter": "6",
    "verse": "31",
    "text": "Meski demikian, bila pencuri itu tertangkap, dia tetap akan dihukum"
  },
  {
    "id": 2884,
    "book": "proverbs                                ",
    "chapter": "6",
    "verse": "32",
    "text": "Jauh lebih celaka orang yang berzina!"
  },
  {
    "id": 2885,
    "book": "proverbs                                ",
    "chapter": "6",
    "verse": "33",
    "text": "Orang seperti itu pasti dipukul dan dihina."
  },
  {
    "id": 2886,
    "book": "proverbs                                ",
    "chapter": "6",
    "verse": "34",
    "text": "Rasa cemburu seorang suami membuat hatinya dibakar amarah."
  },
  {
    "id": 2887,
    "book": "proverbs                                ",
    "chapter": "6",
    "verse": "35",
    "text": "Dia tidak akan mau menerima ganti rugi."
