    "book": "proverbs                                ",
    "chapter": "30",
    "verse": "2",
    "text": "Sungguh aku ini manusia yang paling bodoh"
  },
  {
    "id": 3558,
    "book": "proverbs                                ",
    "chapter": "30",
    "verse": "3",
    "text": "Kebijaksanaan tidak aku kuasai,"
  },
  {
    "id": 3559,
    "book": "proverbs                                ",
    "chapter": "30",
    "verse": "4",
    "text": "Tetapi tidak seorang pun lebih berpengalaman daripadaku,"
  },
  {
    "id": 3560,
    "book": "proverbs                                ",
    "chapter": "30",
    "verse": "5",
    "text": "Semua firman Allah terbukti benar."
  },
  {
    "id": 3561,
    "book": "proverbs                                ",
    "chapter": "30",
    "verse": "6",
    "text": "Jangan menambahi apa pun kepada firman-Nya,"
  },
  {
    "id": 3562,
    "book": "proverbs                                ",
    "chapter": "30",
    "verse": "7",
    "text": "Ya TUHAN, kabulkanlah dua permintaanku ini sebelum aku mati:"
  },
  {
    "id": 3563,
    "book": "proverbs                                ",
    "chapter": "30",
    "verse": "8",
    "text": "Pertama, tolonglah aku untuk hidup dengan jujur."
  },
  {
    "id": 3564,
    "book": "proverbs                                ",
    "chapter": "30",
    "verse": "9",
    "text": "Karena bila aku kaya, mungkin aku menjadi sombong dan berkata “Aku tidak perlu TUHAN.”"
  },
  {
    "id": 3565,
    "book": "proverbs                                ",
    "chapter": "30",
    "verse": "10",
    "text": "Jangan menjelekkan seorang budak kepada tuannya."
  },
  {
    "id": 3566,
    "book": "proverbs                                ",
    "chapter": "30",
    "verse": "11",
    "text": "Ada jenis orang yang mengutuk ayah mereka"
  },
  {
    "id": 3567,
    "book": "proverbs                                ",
    "chapter": "30",
    "verse": "12",
    "text": "Ada jenis orang yang merasa diri mereka suci,"
  },
  {
    "id": 3568,
    "book": "proverbs                                ",
    "chapter": "30",
    "verse": "13",
    "text": "Ada jenis orang yang menunjukkan kesombongan"
  },
  {
    "id": 3569,
    "book": "proverbs                                ",
    "chapter": "30",
    "verse": "14",
    "text": "Ada jenis orang yang rakus dan kejam bagai hewan buas bergigi tajam."
  },
  {
    "id": 3570,
    "book": "proverbs                                ",
    "chapter": "30",
    "verse": "15",
    "text": "Manusia serakah bagaikan lintah yang tak pernah puas mengisap darah."
  },
  {
    "id": 3571,
    "book": "proverbs                                ",
    "chapter": "30",
    "verse": "16",
    "text": "Syeol,"
  },
  {
    "id": 3572,
    "book": "proverbs                                ",
    "chapter": "30",
    "verse": "17",
    "text": "Bila engkau memandang rendah ayahmu dan menolak taat kepada ibumu,"
  },
  {
    "id": 3573,
    "book": "proverbs                                ",
    "chapter": "30",
    "verse": "18",
    "text": "Ada beberapa hal yang masih menjadi rahasia—"
  },
  {
    "id": 3574,
    "book": "proverbs                                ",
    "chapter": "30",
    "verse": "19",
    "text": "Bagaimana caranya elang terbang di udara,"
  },
  {
    "id": 3575,
    "book": "proverbs                                ",
    "chapter": "30",
    "verse": "20",
    "text": "Hal yang juga mengherankan adalah seorang pezina yang tidak merasa bersalah setelah berbuat dosa."
  },
  {
    "id": 3576,
    "book": "proverbs                                ",
    "chapter": "30",
    "verse": "21",
    "text": "Ada beberapa hal yang membuat bumi bergoncang dan gempar:"
  },
  {
    "id": 3577,
    "book": "proverbs                                ",
    "chapter": "30",
    "verse": "22",
    "text": "Seorang budak yang tiba-tiba menjadi raja,"
  },
  {
    "id": 3578,
    "book": "proverbs                                ",
    "chapter": "30",
    "verse": "23",
    "text": "wanita yang menyebalkan tetapi mendapat suami,"
  },
  {
    "id": 3579,
    "book": "proverbs                                ",
    "chapter": "30",
    "verse": "24",
    "text": "Di bumi ini, ada empat binatang yang kecil tetapi sangat bijaksana:"
  },
  {
    "id": 3580,
    "book": "proverbs                                ",
    "chapter": "30",
    "verse": "25",
    "text": "Semut: Bukan hewan yang kuat,"
  },
  {
    "id": 3581,
    "book": "proverbs                                ",
    "chapter": "30",
    "verse": "26",
    "text": "Tikus gunung: Binatang yang lemah,"
  },
  {
    "id": 3582,
    "book": "proverbs                                ",
    "chapter": "30",
    "verse": "27",
    "text": "Belalang: Tidak memiliki pemimpin"
  },
  {
    "id": 3583,
    "book": "proverbs                                ",
    "chapter": "30",
    "verse": "28",
    "text": "Cicak: Bisa ditangkap dengan tangan,"
  },
  {
    "id": 3584,
    "book": "proverbs                                ",
    "chapter": "30",
    "verse": "29",
    "text": "Ada beberapa makhluk hidup"
  },
  {
    "id": 3585,
    "book": "proverbs                                ",
    "chapter": "30",
    "verse": "30",
    "text": "Singa, yang paling kuat di antara hewan lain"
  },
  {
    "id": 3586,
    "book": "proverbs                                ",
    "chapter": "30",
    "verse": "31",
    "text": "Ayam jantan dan kambing jantan berjalan dengan gagah,"
  },
  {
    "id": 3587,
    "book": "proverbs                                ",
    "chapter": "30",
    "verse": "32",
    "text": "Bila engkau sudah bertindak bodoh dengan menyombongkan diri atau merencanakan hal jahat,"
  },
  {
