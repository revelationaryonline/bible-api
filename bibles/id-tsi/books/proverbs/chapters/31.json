[
  {
    "id": 3589,
    "book": "proverbs                                ",
    "chapter": "31",
    "verse": "1",
    "text": "Berikut ini adalah nasihat yang diajarkan kepada Raja Lemuel oleh ibunya:"
  },
  {
    "id": 3590,
    "book": "proverbs                                ",
    "chapter": "31",
    "verse": "2",
    "text": "Oh anakku, anak kandungku, anak yang aku janjikan kepada TUHAN untuk menjadi pelayan-Nya."
  },
  {
    "id": 3591,
    "book": "proverbs                                ",
    "chapter": "31",
    "verse": "3",
    "text": "Jangan menghabis-habiskan kekayaan dan segala perhatianmu untuk menambah selir-selirmu,"
  },
  {
    "id": 3592,
    "book": "proverbs                                ",
    "chapter": "31",
    "verse": "4",
    "text": "Hai Lemuel, sebagai raja, tidak pantas bagimu bermabuk-mabukan dengan minum anggur atau minuman keras yang lain,"
  },
  {
    "id": 3593,
    "book": "proverbs                                ",
    "chapter": "31",
    "verse": "5",
    "text": "Karena bila engkau mabuk, engkau akan melupakan undang-undang negara"
  },
  {
    "id": 3594,
    "book": "proverbs                                ",
    "chapter": "31",
    "verse": "6",
    "text": "Minuman keras hanya cocok bagi mereka yang sedang sekarat"
  },
  {
    "id": 3595,
    "book": "proverbs                                ",
    "chapter": "31",
    "verse": "7",
    "text": "Biarlah mereka minum untuk melupakan kemiskinannya"
  },
  {
    "id": 3596,
    "book": "proverbs                                ",
    "chapter": "31",
    "verse": "8",
    "text": "Sedangkan engkau, engkau harus bersuara nyaring"
  },
  {
    "id": 3597,
    "book": "proverbs                                ",
    "chapter": "31",
    "verse": "9",
    "text": "Gunakanlah posisimu untuk membuat keputusan yang adil"
  },
  {
    "id": 3598,
    "book": "proverbs                                ",
    "chapter": "31",
    "verse": "10",
    "text": "Sungguh beruntung apabila seorang lelaki mendapat istri yang cakap."
  },
  {
    "id": 3599,
    "book": "proverbs                                ",
    "chapter": "31",
    "verse": "11",
    "text": "Dia bisa dipercaya oleh suaminya,"
  },
  {
    "id": 3600,
    "book": "proverbs                                ",
    "chapter": "31",
    "verse": "12",
    "text": "Sepanjang hidup, dia mengusahakan yang baik bagi suaminya"
  },
  {
    "id": 3601,
    "book": "proverbs                                ",
    "chapter": "31",
    "verse": "13",
    "text": "Dengan rajin dia mencari wol dan rami"
  },
  {
    "id": 3602,
    "book": "proverbs                                ",
    "chapter": "31",
    "verse": "14",
    "text": "Istri yang cakap bagaikan kapal-kapal pedagang"
  },
  {
    "id": 3603,
    "book": "proverbs                                ",
    "chapter": "31",
    "verse": "15",
    "text": "Dia bangun sebelum matahari terbit untuk menyiapkan makanan bagi keluarganya,"
  },
  {
    "id": 3604,
    "book": "proverbs                                ",
    "chapter": "31",
    "verse": "16",
    "text": "Dia mengatur rencana yang matang,"
  },
  {
    "id": 3605,
    "book": "proverbs                                ",
    "chapter": "31",
    "verse": "17",
    "text": "Dia bekerja dengan cekatan, gesit, dan tangkas."
  },
  {
    "id": 3606,
    "book": "proverbs                                ",
    "chapter": "31",
    "verse": "18",
    "text": "Istri yang cakap tahu bagaimana menghasilkan keuntungan dari pekerjaannya."
  },
  {
    "id": 3607,
    "book": "proverbs                                ",
    "chapter": "31",
    "verse": "19",
    "text": "Dia mampu menggunakan alat pemintal benang,"
  },
  {
    "id": 3608,
    "book": "proverbs                                ",
    "chapter": "31",
    "verse": "20",
    "text": "Dia mau merangkul orang miskin"
  },
  {
    "id": 3609,
    "book": "proverbs                                ",
    "chapter": "31",
    "verse": "21",
    "text": "Dia sudah menyiapkan baju hangat yang indah untuk seluruh keluarganya,"
  },
  {
    "id": 3610,
    "book": "proverbs                                ",
    "chapter": "31",
    "verse": "22",
    "text": "Dia mempercantik rumahnya dengan tirai dan berbagai hiasan kain yang dia buat sendiri."
  },
  {
    "id": 3611,
    "book": "proverbs                                ",
    "chapter": "31",
    "verse": "23",
    "text": "Suaminya dihormati masyarakat,"
  },
  {
    "id": 3612,
    "book": "proverbs                                ",
    "chapter": "31",
    "verse": "24",
    "text": "Sang istri membuat pakaian dan ikat pinggang dari linen"
  },
  {
    "id": 3613,
    "book": "proverbs                                ",
    "chapter": "31",
    "verse": "25",
    "text": "Dia perempuan yang kuat dan dihormati semua orang."
  },
  {
    "id": 3614,
    "book": "proverbs                                ",
    "chapter": "31",
    "verse": "26",
    "text": "Ucapannya selalu bijaksana,"
  },
  {
    "id": 3615,
    "book": "proverbs                                ",
    "chapter": "31",
    "verse": "27",
    "text": "Dia memperhatikan keadaan rumah tangganya dengan cermat"
  },
  {
    "id": 3616,
    "book": "proverbs                                ",
    "chapter": "31",
    "verse": "28",
    "text": "Anak-anaknya menghormati serta memujinya."
  },
  {
    "id": 3617,
    "book": "proverbs                                ",
    "chapter": "31",
    "verse": "29",
    "text": "“Wanita yang cakap ada banyak,"
  },
  {
    "id": 3618,
    "book": "proverbs                                ",
    "chapter": "31",
    "verse": "30",
    "text": "Penampilan dapat menipu,"
  },
  {
    "id": 3619,
    "book": "proverbs                                ",
    "chapter": "31",
    "verse": "31",
    "text": "Balaslah segala hal baik yang sudah dilakukannya."
  }
]