[
  {
    "id": 16690,
    "book": "proverbs                                ",
    "chapter": "11",
    "verse": "1",
    "text": "छल के तराजू से यहोवा को घृणा आती है,"
  },
  {
    "id": 16691,
    "book": "proverbs                                ",
    "chapter": "11",
    "verse": "2",
    "text": "जब अभिमान होता, तब अपमान भी होता है,"
  },
  {
    "id": 16692,
    "book": "proverbs                                ",
    "chapter": "11",
    "verse": "3",
    "text": "सीधे लोग अपनी खराई से अगुआई पाते हैं,"
  },
  {
    "id": 16693,
    "book": "proverbs                                ",
    "chapter": "11",
    "verse": "4",
    "text": "कोप के दिन धन से तो कुछ लाभ नहीं होता,"
  },
  {
    "id": 16694,
    "book": "proverbs                                ",
    "chapter": "11",
    "verse": "5",
    "text": "खरे मनुष्य का मार्ग धर्म के कारण सीधा होता है,"
  },
  {
    "id": 16695,
    "book": "proverbs                                ",
    "chapter": "11",
    "verse": "6",
    "text": "सीधे लोगों का बचाव उनके धर्म के कारण होता है,"
  },
  {
    "id": 16696,
    "book": "proverbs                                ",
    "chapter": "11",
    "verse": "7",
    "text": "जब दुष्ट मरता, तब उसकी आशा टूट जाती है,"
  },
  {
    "id": 16697,
    "book": "proverbs                                ",
    "chapter": "11",
    "verse": "8",
    "text": "धर्मी विपत्ति से छूट जाता है,"
  },
  {
    "id": 16698,
    "book": "proverbs                                ",
    "chapter": "11",
    "verse": "9",
    "text": "भक्तिहीन जन अपने पड़ोसी को अपने मुँह की बात से बिगाड़ता है,"
  },
  {
    "id": 16699,
    "book": "proverbs                                ",
    "chapter": "11",
    "verse": "10",
    "text": "जब धर्मियों का कल्याण होता है, तब नगर के लोग प्रसन्न होते हैं,"
  },
  {
    "id": 16700,
    "book": "proverbs                                ",
    "chapter": "11",
    "verse": "11",
    "text": "सीधे लोगों के आशीर्वाद से नगर11:11 सीधे लोगों के आशीर्वाद से नगर: शायद, वह जो अपने नगर की भलाई के लिये प्रार्थना करता है जिसके द्वारा वह विनाश से सुरक्षित रहता है। की बढ़ती होती है,"
  },
  {
    "id": 16701,
    "book": "proverbs                                ",
    "chapter": "11",
    "verse": "12",
    "text": "जो अपने पड़ोसी को तुच्छ जानता है, वह निर्बुद्धि है,"
  },
  {
    "id": 16702,
    "book": "proverbs                                ",
    "chapter": "11",
    "verse": "13",
    "text": "जो चुगली करता फिरता वह भेद प्रगट करता है,"
  },
  {
    "id": 16703,
    "book": "proverbs                                ",
    "chapter": "11",
    "verse": "14",
    "text": "जहाँ बुद्धि की युक्ति नहीं, वहाँ प्रजा विपत्ति में पड़ती है;"
  },
  {
    "id": 16704,
    "book": "proverbs                                ",
    "chapter": "11",
    "verse": "15",
    "text": "जो परदेशी का उत्तरदायी होता है, वह बड़ा दुःख उठाता है,"
  },
  {
    "id": 16705,
    "book": "proverbs                                ",
    "chapter": "11",
    "verse": "16",
    "text": "अनुग्रह करनेवाली स्त्री प्रतिष्ठा नहीं खोती है,"
  },
  {
    "id": 16706,
    "book": "proverbs                                ",
    "chapter": "11",
    "verse": "17",
    "text": "कृपालु मनुष्य अपना ही भला करता है, परन्तु जो क्रूर है,"
  },
  {
    "id": 16707,
    "book": "proverbs                                ",
    "chapter": "11",
    "verse": "18",
    "text": "दुष्ट मिथ्या कमाई कमाता है,"
  },
  {
    "id": 16708,
    "book": "proverbs                                ",
    "chapter": "11",
    "verse": "19",
    "text": "जो धर्म में दृढ़ रहता, वह जीवन पाता है,"
  },
  {
    "id": 16709,
    "book": "proverbs                                ",
    "chapter": "11",
    "verse": "20",
    "text": "जो मन के टेढ़े हैं, उनसे यहोवा को घृणा आती है,"
  },
  {
    "id": 16710,
    "book": "proverbs                                ",
    "chapter": "11",
    "verse": "21",
    "text": "निश्‍चय जानो, बुरा मनुष्य निर्दोष न ठहरेगा,"
  },
  {
    "id": 16711,
    "book": "proverbs                                ",
    "chapter": "11",
    "verse": "22",
    "text": "जो सुन्दर स्त्री विवेक नहीं रखती,"
  },
  {
    "id": 16712,
    "book": "proverbs                                ",
    "chapter": "11",
    "verse": "23",
    "text": "धर्मियों की लालसा तो केवल भलाई की होती है;"
  },
  {
    "id": 16713,
    "book": "proverbs                                ",
    "chapter": "11",
    "verse": "24",
    "text": "ऐसे हैं, जो छितरा देते हैं, फिर भी उनकी बढ़ती ही होती है;"
  },
  {
    "id": 16714,
    "book": "proverbs                                ",
    "chapter": "11",
    "verse": "25",
    "text": "उदार प्राणी हष्ट-पुष्ट हो जाता है,"
  },
  {
    "id": 16715,
    "book": "proverbs                                ",
    "chapter": "11",
    "verse": "26",
    "text": "जो अपना अनाज जमाखोरी करता है, उसको लोग श्राप देते हैं,"
  },
  {
    "id": 16716,
    "book": "proverbs                                ",
    "chapter": "11",
    "verse": "27",
    "text": "जो यत्न से भलाई करता है वह दूसरों की प्रसन्नता खोजता है,"
  },
  {
    "id": 16717,
    "book": "proverbs                                ",
    "chapter": "11",
    "verse": "28",
    "text": "जो अपने धन पर भरोसा रखता है वह सूखे पत्ते के समान गिर जाता है,"
  },
  {
    "id": 16718,
    "book": "proverbs                                ",
    "chapter": "11",
    "verse": "29",
    "text": "जो अपने घराने को दुःख देता, उसका भाग वायु ही होगा,"
  },
  {
    "id": 16719,
    "book": "proverbs                                ",
    "chapter": "11",
    "verse": "30",
    "text": "धर्मी का प्रतिफल जीवन का वृक्ष होता है,"
  },
  {
    "id": 16720,
    "book": "proverbs                                ",
    "chapter": "11",
    "verse": "31",
    "text": "देख, धर्मी को पृथ्वी पर फल मिलेगा11:31 धर्मी को पृथ्वी पर फल मिलेगा: धर्मी को फल मिलता है अर्थात् अपने छोटे-मोटे पापों का दण्ड मिलता है या अनुशासित किया जाता है तो दुष्टों को कितना अधिक दण्ड मिलेगा। ,"
  }
]
