[
  {
    "id": 16542,
    "book": "proverbs                                ",
    "chapter": "6",
    "verse": "1",
    "text": "हे मेरे पुत्र, यदि तू अपने पड़ोसी के जमानत का उत्तरदायी हुआ हो,"
  },
  {
    "id": 16543,
    "book": "proverbs                                ",
    "chapter": "6",
    "verse": "2",
    "text": "तो तू अपने ही शपथ के वचनों में फँस जाएगा,"
  },
  {
    "id": 16544,
    "book": "proverbs                                ",
    "chapter": "6",
    "verse": "3",
    "text": "इस स्थिति में, हे मेरे पुत्र एक काम कर"
  },
  {
    "id": 16545,
    "book": "proverbs                                ",
    "chapter": "6",
    "verse": "4",
    "text": "तू न तो अपनी आँखों में नींद,"
  },
  {
    "id": 16546,
    "book": "proverbs                                ",
    "chapter": "6",
    "verse": "5",
    "text": "और अपने आपको हिरनी के समान शिकारी के हाथ से,"
  },
  {
    "id": 16547,
    "book": "proverbs                                ",
    "chapter": "6",
    "verse": "6",
    "text": "हे आलसी, चींटियों के पास जा;"
  },
  {
    "id": 16548,
    "book": "proverbs                                ",
    "chapter": "6",
    "verse": "7",
    "text": "उनके न तो कोई न्यायी होता है,"
  },
  {
    "id": 16549,
    "book": "proverbs                                ",
    "chapter": "6",
    "verse": "8",
    "text": "फिर भी वे अपना आहार धूपकाल में संचय करती हैं,"
  },
  {
    "id": 16550,
    "book": "proverbs                                ",
    "chapter": "6",
    "verse": "9",
    "text": "हे आलसी, तू कब तक सोता रहेगा?"
  },
  {
    "id": 16551,
    "book": "proverbs                                ",
    "chapter": "6",
    "verse": "10",
    "text": "थोड़ी सी नींद, एक और झपकी,"
  },
  {
    "id": 16552,
    "book": "proverbs                                ",
    "chapter": "6",
    "verse": "11",
    "text": "तब तेरा कंगालपन राह के लुटेरे के समान"
  },
  {
    "id": 16553,
    "book": "proverbs                                ",
    "chapter": "6",
    "verse": "12",
    "text": "ओछे और अनर्थकारी6:12 ओछे और अनर्थकारी: यह एक ऐसे मनुष्य का चित्रण है जिस पर विश्वास नहीं किया जा सकता, जिसकी छवि और भाव भंगिमा सब देखनेवालों को उसके विरुद्ध चेतावनी देती है। उसकी भाषा दु:ख दायी और चतुराई भरी होती है। को देखो,"
  },
  {
    "id": 16554,
    "book": "proverbs                                ",
    "chapter": "6",
    "verse": "13",
    "text": "वह नैन से सैन और पाँव से इशारा,"
  },
  {
    "id": 16555,
    "book": "proverbs                                ",
    "chapter": "6",
    "verse": "14",
    "text": "उसके मन में उलट-फेर की बातें रहतीं, वह लगातार बुराई गढ़ता है"
  },
  {
    "id": 16556,
    "book": "proverbs                                ",
    "chapter": "6",
    "verse": "15",
    "text": "इस कारण उस पर विपत्ति अचानक आ पड़ेगी,"
  },
  {
    "id": 16557,
    "book": "proverbs                                ",
    "chapter": "6",
    "verse": "16",
    "text": "छः वस्तुओं से यहोवा बैर रखता है,"
  },
  {
    "id": 16558,
    "book": "proverbs                                ",
    "chapter": "6",
    "verse": "17",
    "text": "अर्थात् घमण्ड से चढ़ी हुई आँखें, झूठ बोलनेवाली जीभ,"
  },
  {
    "id": 16559,
    "book": "proverbs                                ",
    "chapter": "6",
    "verse": "18",
    "text": "अनर्थ कल्पना गढ़नेवाला मन,"
  },
  {
    "id": 16560,
    "book": "proverbs                                ",
    "chapter": "6",
    "verse": "19",
    "text": "झूठ बोलनेवाला साक्षी"
  },
  {
    "id": 16561,
    "book": "proverbs                                ",
    "chapter": "6",
    "verse": "20",
    "text": "हे मेरे पुत्र, अपने पिता की आज्ञा को मान,"
  },
  {
    "id": 16562,
    "book": "proverbs                                ",
    "chapter": "6",
    "verse": "21",
    "text": "उनको अपने हृदय में सदा गाँठ बाँधे रख;"
  },
  {
    "id": 16563,
    "book": "proverbs                                ",
    "chapter": "6",
    "verse": "22",
    "text": "वह तेरे चलने में तेरी अगुआई,"
  },
  {
    "id": 16564,
    "book": "proverbs                                ",
    "chapter": "6",
    "verse": "23",
    "text": "आज्ञा तो दीपक है और शिक्षा ज्योति,"
  },
  {
    "id": 16565,
    "book": "proverbs                                ",
    "chapter": "6",
    "verse": "24",
    "text": "वे तुझको अनैतिक स्त्री6:24 अनैतिक स्त्री: यहाँ स्मरण रखना है कि चेतावनी व्यभिचारिणी के पाप के खतरे के विरुद्ध है।  से"
  },
  {
    "id": 16566,
    "book": "proverbs                                ",
    "chapter": "6",
    "verse": "25",
    "text": "उसकी सुन्दरता देखकर अपने मन में उसकी अभिलाषा न कर;"
  },
  {
    "id": 16567,
    "book": "proverbs                                ",
    "chapter": "6",
    "verse": "26",
    "text": "क्योंकि वेश्‍यागमन के कारण मनुष्य रोटी के टुकड़ों का भिखारी हो जाता है,"
  },
  {
    "id": 16568,
    "book": "proverbs                                ",
    "chapter": "6",
    "verse": "27",
    "text": "क्या हो सकता है कि कोई अपनी छाती पर आग रख ले;"
  },
  {
    "id": 16569,
    "book": "proverbs                                ",
    "chapter": "6",
    "verse": "28",
    "text": "क्या हो सकता है कि कोई अंगारे पर चले,"
  },
  {
    "id": 16570,
    "book": "proverbs                                ",
    "chapter": "6",
    "verse": "29",
    "text": "जो पराई स्त्री के पास जाता है, उसकी दशा ऐसी है;"
  },
  {
    "id": 16571,
    "book": "proverbs                                ",
    "chapter": "6",
    "verse": "30",
    "text": "जो चोर भूख के मारे अपना पेट भरने के लिये चोरी करे,"
  },
  {
    "id": 16572,
    "book": "proverbs                                ",
    "chapter": "6",
    "verse": "31",
    "text": "फिर भी यदि वह पकड़ा जाए, तो उसको सात गुणा भर देना पड़ेगा;"
  },
  {
    "id": 16573,
    "book": "proverbs                                ",
    "chapter": "6",
    "verse": "32",
    "text": "जो परस्त्रीगमन करता है वह निरा निर्बुद्ध है;"
  },
  {
    "id": 16574,
    "book": "proverbs                                ",
    "chapter": "6",
    "verse": "33",
    "text": "उसको घायल और अपमानित होना पड़ेगा,"
  },
  {
    "id": 16575,
    "book": "proverbs                                ",
    "chapter": "6",
    "verse": "34",
    "text": "क्योंकि जलन से पुरुष बहुत ही क्रोधित हो जाता है,"
  },
  {
    "id": 16576,
    "book": "proverbs                                ",
    "chapter": "6",
    "verse": "35",
    "text": "वह मुआवजे में कुछ न लेगा,"
  }
]
