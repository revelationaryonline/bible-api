[
  {
    "id": 16927,
    "book": "proverbs                                ",
    "chapter": "19",
    "verse": "1",
    "text": "जो निर्धन खराई से चलता है,"
  },
  {
    "id": 16928,
    "book": "proverbs                                ",
    "chapter": "19",
    "verse": "2",
    "text": "मनुष्य का ज्ञानरहित रहना अच्छा नहीं,"
  },
  {
    "id": 16929,
    "book": "proverbs                                ",
    "chapter": "19",
    "verse": "3",
    "text": "मूर्खता के कारण मनुष्य का मार्ग टेढ़ा होता है,"
  },
  {
    "id": 16930,
    "book": "proverbs                                ",
    "chapter": "19",
    "verse": "4",
    "text": "धनी के तो बहुत मित्र हो जाते हैं,"
  },
  {
    "id": 16931,
    "book": "proverbs                                ",
    "chapter": "19",
    "verse": "5",
    "text": "झूठा साक्षी निर्दोष नहीं ठहरता,"
  },
  {
    "id": 16932,
    "book": "proverbs                                ",
    "chapter": "19",
    "verse": "6",
    "text": "उदार मनुष्य को बहुत से लोग मना लेते हैं,"
  },
  {
    "id": 16933,
    "book": "proverbs                                ",
    "chapter": "19",
    "verse": "7",
    "text": "जब निर्धन के सब भाई उससे बैर रखते हैं,"
  },
  {
    "id": 16934,
    "book": "proverbs                                ",
    "chapter": "19",
    "verse": "8",
    "text": "जो बुद्धि प्राप्त करता, वह अपने प्राण को प्रेमी ठहराता है;"
  },
  {
    "id": 16935,
    "book": "proverbs                                ",
    "chapter": "19",
    "verse": "9",
    "text": "झूठा साक्षी निर्दोष नहीं ठहरता,"
  },
  {
    "id": 16936,
    "book": "proverbs                                ",
    "chapter": "19",
    "verse": "10",
    "text": "जब सुख में रहना मूर्ख को नहीं फबता,"
  },
  {
    "id": 16937,
    "book": "proverbs                                ",
    "chapter": "19",
    "verse": "11",
    "text": "जो मनुष्य बुद्धि से चलता है वह विलम्ब से क्रोध करता है,"
  },
  {
    "id": 16938,
    "book": "proverbs                                ",
    "chapter": "19",
    "verse": "12",
    "text": "राजा का क्रोध सिंह की गर्जन के समान है,"
  },
  {
    "id": 16939,
    "book": "proverbs                                ",
    "chapter": "19",
    "verse": "13",
    "text": "मूर्ख पुत्र पिता के लिये विपत्ति है,"
  },
  {
    "id": 16940,
    "book": "proverbs                                ",
    "chapter": "19",
    "verse": "14",
    "text": "घर और धन पुरखाओं के भाग से,"
  },
  {
    "id": 16941,
    "book": "proverbs                                ",
    "chapter": "19",
    "verse": "15",
    "text": "आलस से भारी नींद आ जाती है,"
  },
  {
    "id": 16942,
    "book": "proverbs                                ",
    "chapter": "19",
    "verse": "16",
    "text": "जो आज्ञा को मानता, वह अपने प्राण की रक्षा करता है,"
  },
  {
    "id": 16943,
    "book": "proverbs                                ",
    "chapter": "19",
    "verse": "17",
    "text": "जो कंगाल पर अनुग्रह करता है, वह यहोवा को उधार देता है,"
  },
  {
    "id": 16944,
    "book": "proverbs                                ",
    "chapter": "19",
    "verse": "18",
    "text": "जब तक आशा है तब तक अपने पुत्र की ताड़ना कर,"
  },
  {
    "id": 16945,
    "book": "proverbs                                ",
    "chapter": "19",
    "verse": "19",
    "text": "जो बड़ा क्रोधी है, उसे दण्ड उठाने दे;"
  },
  {
    "id": 16946,
    "book": "proverbs                                ",
    "chapter": "19",
    "verse": "20",
    "text": "सम्मति को सुन ले, और शिक्षा को ग्रहण कर,"
  },
  {
    "id": 16947,
    "book": "proverbs                                ",
    "chapter": "19",
    "verse": "21",
    "text": "मनुष्य के मन में बहुत सी कल्पनाएँ होती हैं,"
  },
  {
    "id": 16948,
    "book": "proverbs                                ",
    "chapter": "19",
    "verse": "22",
    "text": "मनुष्य में निष्ठा सर्वोत्तम गुण है,"
  },
  {
    "id": 16949,
    "book": "proverbs                                ",
    "chapter": "19",
    "verse": "23",
    "text": "यहोवा का भय मानने से जीवन बढ़ता है;"
  },
  {
    "id": 16950,
    "book": "proverbs                                ",
    "chapter": "19",
    "verse": "24",
    "text": "आलसी अपना हाथ थाली में डालता है,"
  },
  {
    "id": 16951,
    "book": "proverbs                                ",
    "chapter": "19",
    "verse": "25",
    "text": "ठट्ठा करनेवाले को मार, इससे भोला मनुष्य समझदार हो जाएगा;"
  },
  {
    "id": 16952,
    "book": "proverbs                                ",
    "chapter": "19",
    "verse": "26",
    "text": "जो पुत्र अपने बाप को उजाड़ता, और अपनी माँ को भगा देता है,"
  },
  {
    "id": 16953,
    "book": "proverbs                                ",
    "chapter": "19",
    "verse": "27",
    "text": "हे मेरे पुत्र, यदि तू शिक्षा को सुनना छोड़ दे,"
  },
  {
    "id": 16954,
    "book": "proverbs                                ",
    "chapter": "19",
    "verse": "28",
    "text": "अधर्मी साक्षी न्याय को उपहास में उड़ाता है,"
  },
  {
    "id": 16955,
    "book": "proverbs                                ",
    "chapter": "19",
    "verse": "29",
    "text": "ठट्ठा करनेवालों के लिये दण्ड ठहराया जाता है,"
  }
]
