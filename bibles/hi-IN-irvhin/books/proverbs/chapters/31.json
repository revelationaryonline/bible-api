[
  {
    "id": 17286,
    "book": "proverbs                                ",
    "chapter": "31",
    "verse": "1",
    "text": "लमूएल राजा के प्रभावशाली वचन, जो उसकी माता ने उसे सिखाए।"
  },
  {
    "id": 17287,
    "book": "proverbs                                ",
    "chapter": "31",
    "verse": "2",
    "text": "हे मेरे पुत्र, हे मेरे निज पुत्र!"
  },
  {
    "id": 17288,
    "book": "proverbs                                ",
    "chapter": "31",
    "verse": "3",
    "text": "अपना बल स्त्रियों को न देना,"
  },
  {
    "id": 17289,
    "book": "proverbs                                ",
    "chapter": "31",
    "verse": "4",
    "text": "हे लमूएल, राजाओं को दाखमधु पीना शोभा नहीं देता,"
  },
  {
    "id": 17290,
    "book": "proverbs                                ",
    "chapter": "31",
    "verse": "5",
    "text": "ऐसा न हो कि वे पीकर व्यवस्था को भूल जाएँ"
  },
  {
    "id": 17291,
    "book": "proverbs                                ",
    "chapter": "31",
    "verse": "6",
    "text": "मदिरा उसको पिलाओ जो मरने पर है,"
  },
  {
    "id": 17292,
    "book": "proverbs                                ",
    "chapter": "31",
    "verse": "7",
    "text": "जिससे वे पीकर अपनी दरिद्रता को भूल जाएँ"
  },
  {
    "id": 17293,
    "book": "proverbs                                ",
    "chapter": "31",
    "verse": "8",
    "text": "गूँगे के लिये अपना मुँह खोल,"
  },
  {
    "id": 17294,
    "book": "proverbs                                ",
    "chapter": "31",
    "verse": "9",
    "text": "अपना मुँह खोल और धर्म से न्याय कर,"
  },
  {
    "id": 17295,
    "book": "proverbs                                ",
    "chapter": "31",
    "verse": "10",
    "text": "भली पत्नी कौन पा सकता है?"
  },
  {
    "id": 17296,
    "book": "proverbs                                ",
    "chapter": "31",
    "verse": "11",
    "text": "उसके पति के मन में उसके प्रति विश्वास है,"
  },
  {
    "id": 17297,
    "book": "proverbs                                ",
    "chapter": "31",
    "verse": "12",
    "text": "वह अपने जीवन के सारे दिनों में उससे बुरा नहीं,"
  },
  {
    "id": 17298,
    "book": "proverbs                                ",
    "chapter": "31",
    "verse": "13",
    "text": "वह ऊन और सन ढूँढ़ ढूँढ़कर,"
  },
  {
    "id": 17299,
    "book": "proverbs                                ",
    "chapter": "31",
    "verse": "14",
    "text": "वह व्यापार के जहाजों के समान अपनी भोजनवस्तुएँ दूर से मँगवाती है।"
  },
  {
    "id": 17300,
    "book": "proverbs                                ",
    "chapter": "31",
    "verse": "15",
    "text": "वह रात ही को उठ बैठती है,"
  },
  {
    "id": 17301,
    "book": "proverbs                                ",
    "chapter": "31",
    "verse": "16",
    "text": "वह किसी खेत के विषय में सोच विचार करती है"
  },
  {
    "id": 17302,
    "book": "proverbs                                ",
    "chapter": "31",
    "verse": "17",
    "text": "वह अपनी कमर को बल के फेंटे से कसती है,"
  },
  {
    "id": 17303,
    "book": "proverbs                                ",
    "chapter": "31",
    "verse": "18",
    "text": "वह परख लेती है कि मेरा व्यापार लाभदायक है।"
  },
  {
    "id": 17304,
    "book": "proverbs                                ",
    "chapter": "31",
    "verse": "19",
    "text": "वह अटेरन में हाथ लगाती है,"
  },
  {
    "id": 17305,
    "book": "proverbs                                ",
    "chapter": "31",
    "verse": "20",
    "text": "वह दीन के लिये मुट्ठी खोलती है,"
  },
  {
    "id": 17306,
    "book": "proverbs                                ",
    "chapter": "31",
    "verse": "21",
    "text": "वह अपने घराने के लिये हिम से नहीं डरती,"
  },
  {
    "id": 17307,
    "book": "proverbs                                ",
    "chapter": "31",
    "verse": "22",
    "text": "वह तकिये बना लेती है;"
  },
  {
    "id": 17308,
    "book": "proverbs                                ",
    "chapter": "31",
    "verse": "23",
    "text": "जब उसका पति सभा में देश के पुरनियों के संग बैठता है,"
  },
  {
    "id": 17309,
    "book": "proverbs                                ",
    "chapter": "31",
    "verse": "24",
    "text": "वह सन के वस्त्र बनाकर बेचती है;"
  },
  {
    "id": 17310,
    "book": "proverbs                                ",
    "chapter": "31",
    "verse": "25",
    "text": "वह बल और प्रताप का पहरावा पहने रहती है,"
  },
  {
    "id": 17311,
    "book": "proverbs                                ",
    "chapter": "31",
    "verse": "26",
    "text": "वह बुद्धि की बात बोलती है31:26 वह बुद्धि की बात बोलती है: एक सच्ची पत्नी के मुख से निकलने वाले वचन श्रोताओं के लिए नियम निर्धारक मार्गदर्शन एवं निर्देशन स्वरूप होते हैं।,"
  },
  {
    "id": 17312,
    "book": "proverbs                                ",
    "chapter": "31",
    "verse": "27",
    "text": "वह अपने घराने के चाल चलन को ध्यान से देखती है,"
  },
  {
    "id": 17313,
    "book": "proverbs                                ",
    "chapter": "31",
    "verse": "28",
    "text": "उसके पुत्र उठ उठकर उसको धन्य कहते हैं,"
  },
  {
    "id": 17314,
    "book": "proverbs                                ",
    "chapter": "31",
    "verse": "29",
    "text": "“बहुत सी स्त्रियों ने अच्छे-अच्छे काम तो किए हैं परन्तु तू उन सभी में श्रेष्ठ है।”"
  },
  {
    "id": 17315,
    "book": "proverbs                                ",
    "chapter": "31",
    "verse": "30",
    "text": "शोभा तो झूठी और सुन्दरता व्यर्थ है,"
  },
  {
    "id": 17316,
    "book": "proverbs                                ",
    "chapter": "31",
    "verse": "31",
    "text": "उसके हाथों के परिश्रम का फल उसे दो,"
  }
]
