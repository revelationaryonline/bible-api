[
  {
    "id": 17253,
    "book": "proverbs                                ",
    "chapter": "30",
    "verse": "1",
    "text": "याके के पुत्र आगूर के प्रभावशाली वचन।"
  },
  {
    "id": 17254,
    "book": "proverbs                                ",
    "chapter": "30",
    "verse": "2",
    "text": "निश्चय मैं पशु सरीखा हूँ, वरन् मनुष्य कहलाने के योग्य भी नहीं;"
  },
  {
    "id": 17255,
    "book": "proverbs                                ",
    "chapter": "30",
    "verse": "3",
    "text": "न मैंने बुद्धि प्राप्त की है,"
  },
  {
    "id": 17256,
    "book": "proverbs                                ",
    "chapter": "30",
    "verse": "4",
    "text": "कौन स्वर्ग में चढ़कर फिर उतर आया?"
  },
  {
    "id": 17257,
    "book": "proverbs                                ",
    "chapter": "30",
    "verse": "5",
    "text": "परमेश्वर का एक-एक वचन ताया हुआ है;"
  },
  {
    "id": 17258,
    "book": "proverbs                                ",
    "chapter": "30",
    "verse": "6",
    "text": "उसके वचनों में कुछ मत बढ़ा,"
  },
  {
    "id": 17259,
    "book": "proverbs                                ",
    "chapter": "30",
    "verse": "7",
    "text": "मैंने तुझ से दो वर माँगे हैं,"
  },
  {
    "id": 17260,
    "book": "proverbs                                ",
    "chapter": "30",
    "verse": "8",
    "text": "अर्थात् व्यर्थ और झूठी बात मुझसे दूर रख; मुझे न तो निर्धन कर और न धनी बना;"
  },
  {
    "id": 17261,
    "book": "proverbs                                ",
    "chapter": "30",
    "verse": "9",
    "text": "ऐसा न हो कि जब मेरा पेट भर जाए, तब मैं इन्कार करके कहूँ कि यहोवा कौन है?"
  },
  {
    "id": 17262,
    "book": "proverbs                                ",
    "chapter": "30",
    "verse": "10",
    "text": "किसी दास की, उसके स्वामी से चुगली न करना30:10 किसी दास की, उसके स्वामी से चुगली न करना: नम्र स्थिति में काम करनेवालों के साथ सहानुभूति रखें। एक दास को भी निराशाजनक या अनावश्यक आरोप के खिलाफ सुरक्षा का अधिकार है।,"
  },
  {
    "id": 17263,
    "book": "proverbs                                ",
    "chapter": "30",
    "verse": "11",
    "text": "ऐसे लोग हैं, जो अपने पिता को श्राप देते"
  },
  {
    "id": 17264,
    "book": "proverbs                                ",
    "chapter": "30",
    "verse": "12",
    "text": "वे ऐसे लोग हैं जो अपनी दृष्टि में शुद्ध हैं,"
  },
  {
    "id": 17265,
    "book": "proverbs                                ",
    "chapter": "30",
    "verse": "13",
    "text": "एक पीढ़ी के लोग ऐसे हैं उनकी दृष्टि क्या ही घमण्ड से भरी रहती है,"
  },
  {
    "id": 17266,
    "book": "proverbs                                ",
    "chapter": "30",
    "verse": "14",
    "text": "एक पीढ़ी के लोग ऐसे हैं, जिनके दाँत तलवार और उनकी दाढ़ें छुरियाँ हैं,"
  },
  {
    "id": 17267,
    "book": "proverbs                                ",
    "chapter": "30",
    "verse": "15",
    "text": "जैसे जोंक की दो बेटियाँ होती हैं, जो कहती हैं, “दे, दे,”"
  },
  {
    "id": 17268,
    "book": "proverbs                                ",
    "chapter": "30",
    "verse": "16",
    "text": "अधोलोक और बाँझ की कोख,"
  },
  {
    "id": 17269,
    "book": "proverbs                                ",
    "chapter": "30",
    "verse": "17",
    "text": "जिस आँख से कोई अपने पिता पर अनादर की दृष्टि करे,"
  },
  {
    "id": 17270,
    "book": "proverbs                                ",
    "chapter": "30",
    "verse": "18",
    "text": "तीन बातें मेरे लिये अधिक कठिन है,"
  },
  {
    "id": 17271,
    "book": "proverbs                                ",
    "chapter": "30",
    "verse": "19",
    "text": "आकाश में उकाब पक्षी का मार्ग,"
  },
  {
    "id": 17272,
    "book": "proverbs                                ",
    "chapter": "30",
    "verse": "20",
    "text": "व्यभिचारिणी की चाल भी वैसी ही है;"
  },
  {
    "id": 17273,
    "book": "proverbs                                ",
    "chapter": "30",
    "verse": "21",
    "text": "तीन बातों के कारण पृथ्वी काँपती है; वरन् चार हैं,"
  },
  {
    "id": 17274,
    "book": "proverbs                                ",
    "chapter": "30",
    "verse": "22",
    "text": "दास का राजा हो जाना,"
  },
  {
    "id": 17275,
    "book": "proverbs                                ",
    "chapter": "30",
    "verse": "23",
    "text": "घिनौनी स्त्री का ब्याहा जाना,"
  },
  {
    "id": 17276,
    "book": "proverbs                                ",
    "chapter": "30",
    "verse": "24",
    "text": "पृथ्वी पर चार छोटे जन्तु हैं,"
  },
  {
    "id": 17277,
    "book": "proverbs                                ",
    "chapter": "30",
    "verse": "25",
    "text": "चींटियाँ निर्बल जाति तो हैं,"
  },
  {
    "id": 17278,
    "book": "proverbs                                ",
    "chapter": "30",
    "verse": "26",
    "text": "चट्टानी बिज्जू बलवन्त जाति नहीं,"
  },
  {
    "id": 17279,
    "book": "proverbs                                ",
    "chapter": "30",
    "verse": "27",
    "text": "टिड्डियों के राजा तो नहीं होता,"
  },
  {
    "id": 17280,
    "book": "proverbs                                ",
    "chapter": "30",
    "verse": "28",
    "text": "और छिपकली हाथ से पकड़ी तो जाती है,"
  },
  {
    "id": 17281,
    "book": "proverbs                                ",
    "chapter": "30",
    "verse": "29",
    "text": "तीन सुन्दर चलनेवाले प्राणी हैं;"
  },
  {
    "id": 17282,
    "book": "proverbs                                ",
    "chapter": "30",
    "verse": "30",
    "text": "सिंह जो सब पशुओं में पराक्रमी है,"
  },
  {
    "id": 17283,
    "book": "proverbs                                ",
    "chapter": "30",
    "verse": "31",
    "text": "शिकारी कुत्ता और बकरा,"
  },
  {
    "id": 17284,
    "book": "proverbs                                ",
    "chapter": "30",
    "verse": "32",
    "text": "यदि तूने अपनी बढ़ाई करने की मूर्खता की,"
  },
  {
    "id": 17285,
    "book": "proverbs                                ",
    "chapter": "30",
    "verse": "33",
    "text": "क्योंकि जैसे दूध के मथने से मक्खन"
  }
]
