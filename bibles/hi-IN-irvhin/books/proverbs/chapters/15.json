[
  {
    "id": 16809,
    "book": "proverbs                                ",
    "chapter": "15",
    "verse": "1",
    "text": "कोमल उत्तर सुनने से जलजलाहट ठण्डी होती है,"
  },
  {
    "id": 16810,
    "book": "proverbs                                ",
    "chapter": "15",
    "verse": "2",
    "text": "बुद्धिमान ज्ञान का ठीक बखान करते हैं,"
  },
  {
    "id": 16811,
    "book": "proverbs                                ",
    "chapter": "15",
    "verse": "3",
    "text": "यहोवा की आँखें सब स्थानों में लगी रहती हैं15:3 यहोवा की आँखें सब स्थानों में लगी रहती हैं: परमेश्वर का भय मानने से जो शिक्षा आरम्भ हुई है वह उसकी सर्व व्यापकता के बिना अपूर्ण रहेगी।,"
  },
  {
    "id": 16812,
    "book": "proverbs                                ",
    "chapter": "15",
    "verse": "4",
    "text": "शान्ति देनेवाली बात जीवन-वृक्ष है,"
  },
  {
    "id": 16813,
    "book": "proverbs                                ",
    "chapter": "15",
    "verse": "5",
    "text": "मूर्ख अपने पिता की शिक्षा का तिरस्कार करता है,"
  },
  {
    "id": 16814,
    "book": "proverbs                                ",
    "chapter": "15",
    "verse": "6",
    "text": "धर्मी के घर में बहुत धन रहता है,"
  },
  {
    "id": 16815,
    "book": "proverbs                                ",
    "chapter": "15",
    "verse": "7",
    "text": "बुद्धिमान लोग बातें करने से ज्ञान को फैलाते हैं,"
  },
  {
    "id": 16816,
    "book": "proverbs                                ",
    "chapter": "15",
    "verse": "8",
    "text": "दुष्ट लोगों के बलिदान से यहोवा घृणा करता है,"
  },
  {
    "id": 16817,
    "book": "proverbs                                ",
    "chapter": "15",
    "verse": "9",
    "text": "दुष्ट के चाल चलन से यहोवा को घृणा आती है,"
  },
  {
    "id": 16818,
    "book": "proverbs                                ",
    "chapter": "15",
    "verse": "10",
    "text": "जो मार्ग को छोड़ देता, उसको बड़ी ताड़ना मिलती है,"
  },
  {
    "id": 16819,
    "book": "proverbs                                ",
    "chapter": "15",
    "verse": "11",
    "text": "जबकि अधोलोक और विनाशलोक यहोवा के सामने खुले रहते हैं,"
  },
  {
    "id": 16820,
    "book": "proverbs                                ",
    "chapter": "15",
    "verse": "12",
    "text": "ठट्ठा करनेवाला डाँटे जाने से प्रसन्न नहीं होता,"
  },
  {
    "id": 16821,
    "book": "proverbs                                ",
    "chapter": "15",
    "verse": "13",
    "text": "मन आनन्दित होने से मुख पर भी प्रसन्नता छा जाती है,"
