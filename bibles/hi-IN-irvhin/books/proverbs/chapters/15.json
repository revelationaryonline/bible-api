  {
    "id": 16836,
    "book": "proverbs                                ",
    "chapter": "15",
    "verse": "28",
    "text": "धर्मी मन में सोचता है कि क्या उत्तर दूँ,"
  },
  {
    "id": 16837,
    "book": "proverbs                                ",
    "chapter": "15",
    "verse": "29",
    "text": "यहोवा दुष्टों से दूर रहता है,"
  },
  {
    "id": 16838,
    "book": "proverbs                                ",
    "chapter": "15",
    "verse": "30",
    "text": "आँखों की चमक15:30 आँखों की चमक: जिस मनुष्य का मन और चेहरा दोनों आनन्द से पूर्ण हो उसकी आँखों में चमक होती है। ऐसी छवि रोगहरण और जीवनदायक सामर्थ्य से काम करती है।  से मन को आनन्द होता है,"
  },
  {
    "id": 16839,
    "book": "proverbs                                ",
    "chapter": "15",
    "verse": "31",
    "text": "जो जीवनदायी डाँट कान लगाकर सुनता है,"
  },
  {
    "id": 16840,
    "book": "proverbs                                ",
    "chapter": "15",
    "verse": "32",
    "text": "जो शिक्षा को अनसुनी करता, वह अपने प्राण को तुच्छ जानता है,"
  },
  {
    "id": 16841,
    "book": "proverbs                                ",
    "chapter": "15",
    "verse": "33",
    "text": "यहोवा के भय मानने से बुद्धि की शिक्षा प्राप्त होती है,"
  }
]
