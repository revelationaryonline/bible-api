[
  {
    "id": 16577,
    "book": "proverbs                                ",
    "chapter": "7",
    "verse": "1",
    "text": "हे मेरे पुत्र, मेरी बातों को माना कर,"
  },
  {
    "id": 16578,
    "book": "proverbs                                ",
    "chapter": "7",
    "verse": "2",
    "text": "मेरी आज्ञाओं को मान, इससे तू जीवित रहेगा,"
  },
  {
    "id": 16579,
    "book": "proverbs                                ",
    "chapter": "7",
    "verse": "3",
    "text": "उनको अपनी उँगलियों में बाँध,"
  },
  {
    "id": 16580,
    "book": "proverbs                                ",
    "chapter": "7",
    "verse": "4",
    "text": "बुद्धि से कह, “तू मेरी बहन है,”"
  },
  {
    "id": 16581,
    "book": "proverbs                                ",
    "chapter": "7",
    "verse": "5",
    "text": "तब तू पराई स्त्री से बचेगा,"
  },
  {
    "id": 16582,
    "book": "proverbs                                ",
    "chapter": "7",
    "verse": "6",
    "text": "मैंने एक दिन अपने घर की खिड़की से,"
  },
  {
    "id": 16583,
    "book": "proverbs                                ",
    "chapter": "7",
    "verse": "7",
    "text": "तब मैंने भोले7:7 भोले: निर्बुधि, निरुत्साही और सब प्रकार की बुराइयों को करनेवाला मनुष्य। लोगों में से"
  },
  {
    "id": 16584,
    "book": "proverbs                                ",
    "chapter": "7",
    "verse": "8",
    "text": "वह उस स्त्री के घर के कोने के पास की सड़क से गुजर रहा था,"
  },
  {
    "id": 16585,
    "book": "proverbs                                ",
    "chapter": "7",
    "verse": "9",
    "text": "उस समय दिन ढल गया, और संध्याकाल आ गया था,"
  },
  {
    "id": 16586,
    "book": "proverbs                                ",
    "chapter": "7",
    "verse": "10",
    "text": "और उससे एक स्त्री मिली,"
  },
  {
    "id": 16587,
    "book": "proverbs                                ",
    "chapter": "7",
    "verse": "11",
    "text": "वह शान्ति रहित और चंचल थी,"
  },
  {
    "id": 16588,
    "book": "proverbs                                ",
    "chapter": "7",
    "verse": "12",
    "text": "कभी वह सड़क में, कभी चौक में पाई जाती थी,"
  },
  {
    "id": 16589,
    "book": "proverbs                                ",
    "chapter": "7",
    "verse": "13",
    "text": "तब उसने उस जवान को पकड़कर चूमा,"
  },
  {
    "id": 16590,
    "book": "proverbs                                ",
    "chapter": "7",
    "verse": "14",
    "text": "“मैंने आज ही मेलबलि चढ़ाया7:14 मेलबलि चढ़ाया: वह स्त्री पारिभाषिक शब्द ‘मेलबलि’ का उपयोग करती है और अपने पाप के लिये आरम्भिक चरण बनाती है।"
  },
  {
    "id": 16591,
    "book": "proverbs                                ",
    "chapter": "7",
    "verse": "15",
    "text": "इसी कारण मैं तुझ से भेंट करने को निकली,"
  },
  {
    "id": 16592,
    "book": "proverbs                                ",
    "chapter": "7",
    "verse": "16",
    "text": "मैंने अपने पलंग के बिछौने पर"
  },
  {
    "id": 16593,
    "book": "proverbs                                ",
    "chapter": "7",
    "verse": "17",
    "text": "मैंने अपने बिछौने पर गन्धरस,"
  },
  {
    "id": 16594,
    "book": "proverbs                                ",
    "chapter": "7",
    "verse": "18",
    "text": "इसलिए अब चल हम प्रेम से भोर तक जी बहलाते रहें;"
  },
  {
    "id": 16595,
    "book": "proverbs                                ",
    "chapter": "7",
    "verse": "19",
    "text": "क्योंकि मेरा पति घर में नहीं है;"
  },
  {
    "id": 16596,
    "book": "proverbs                                ",
    "chapter": "7",
    "verse": "20",
    "text": "वह चाँदी की थैली ले गया है;"
  },
  {
    "id": 16597,
    "book": "proverbs                                ",
    "chapter": "7",
    "verse": "21",
    "text": "ऐसी ही लुभानेवाली बातें कह कहकर, उसने उसको फँसा लिया;"
  },
  {
    "id": 16598,
    "book": "proverbs                                ",
    "chapter": "7",
    "verse": "22",
    "text": "वह तुरन्त उसके पीछे हो लिया,"
  },
  {
    "id": 16599,
    "book": "proverbs                                ",
    "chapter": "7",
    "verse": "23",
    "text": "अन्त में उस जवान का कलेजा तीर से बेधा जाएगा;"
  },
  {
    "id": 16600,
    "book": "proverbs                                ",
    "chapter": "7",
    "verse": "24",
    "text": "अब हे मेरे पुत्रों, मेरी सुनो,"
  },
  {
    "id": 16601,
    "book": "proverbs                                ",
    "chapter": "7",
    "verse": "25",
    "text": "तेरा मन ऐसी स्त्री के मार्ग की ओर न फिरे,"
  },
  {
    "id": 16602,
    "book": "proverbs                                ",
    "chapter": "7",
    "verse": "26",
    "text": "क्योंकि बहुत से लोग उसके द्वारा मारे गए है7:26 बहुत से लोग उसके द्वारा मारे गए है: उस स्त्री के घर की तुलना युद्ध क्षेत्र से की गई है जहाँ अनेक घात किए हुए शव बिखरे पड़े रहते है।;"
  },
  {
    "id": 16603,
    "book": "proverbs                                ",
    "chapter": "7",
    "verse": "27",
    "text": "उसका घर अधोलोक का मार्ग है,"
  }
]
