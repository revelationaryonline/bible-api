[
  {
    "id": 16658,
    "book": "proverbs                                ",
    "chapter": "10",
    "verse": "1",
    "text": "सुलैमान के नीतिवचन।"
  },
  {
    "id": 16659,
    "book": "proverbs                                ",
    "chapter": "10",
    "verse": "2",
    "text": "दुष्टों के रखे हुए धन से लाभ नहीं होता,"
  },
  {
    "id": 16660,
    "book": "proverbs                                ",
    "chapter": "10",
    "verse": "3",
    "text": "धर्मी को यहोवा भूखा मरने नहीं देता,"
  },
  {
    "id": 16661,
    "book": "proverbs                                ",
    "chapter": "10",
    "verse": "4",
    "text": "जो काम में ढिलाई करता है, वह निर्धन हो जाता है,"
  },
  {
    "id": 16662,
    "book": "proverbs                                ",
    "chapter": "10",
    "verse": "5",
    "text": "बुद्धिमान सन्तान धूपकाल में फसल बटोरता है,"
  },
  {
    "id": 16663,
    "book": "proverbs                                ",
    "chapter": "10",
    "verse": "6",
    "text": "धर्मी पर बहुत से आशीर्वाद होते हैं,"
  },
  {
    "id": 16664,
    "book": "proverbs                                ",
    "chapter": "10",
    "verse": "7",
    "text": "धर्मी को स्मरण करके लोग आशीर्वाद देते हैं,"
  },
  {
    "id": 16665,
    "book": "proverbs                                ",
    "chapter": "10",
    "verse": "8",
    "text": "जो बुद्धिमान है, वह आज्ञाओं को स्वीकार करता है,"
  },
  {
    "id": 16666,
    "book": "proverbs                                ",
    "chapter": "10",
    "verse": "9",
    "text": "जो खराई से चलता है वह निडर चलता है,"
