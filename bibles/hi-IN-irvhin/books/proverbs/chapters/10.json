  {
    "id": 16667,
    "book": "proverbs                                ",
    "chapter": "10",
    "verse": "10",
    "text": "जो नैन से सैन करके बुरे काम के लिए इशारा करता है उससे औरों को दुःख होता है,"
  },
  {
    "id": 16668,
    "book": "proverbs                                ",
    "chapter": "10",
    "verse": "11",
    "text": "धर्मी का मुँह तो जीवन का सोता है,"
