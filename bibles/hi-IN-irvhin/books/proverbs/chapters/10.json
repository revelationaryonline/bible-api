  {
    "id": 16671,
    "book": "proverbs                                ",
    "chapter": "10",
    "verse": "14",
    "text": "बुद्धिमान लोग ज्ञान का संग्रह करते है,"
  },
  {
    "id": 16672,
    "book": "proverbs                                ",
    "chapter": "10",
    "verse": "15",
    "text": "धनी का धन उसका दृढ़ नगर है,"
  },
  {
    "id": 16673,
    "book": "proverbs                                ",
    "chapter": "10",
    "verse": "16",
    "text": "धर्मी का परिश्रम जीवन की ओर ले जाता है;"
