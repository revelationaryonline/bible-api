[
  {
    "id": 16402,
    "book": "proverbs                                ",
    "chapter": "1",
    "verse": "1",
    "text": "दाऊद के पुत्र इस्राएल के राजा सुलैमान के नीतिवचन:"
  },
  {
    "id": 16403,
    "book": "proverbs                                ",
    "chapter": "1",
    "verse": "2",
    "text": "इनके द्वारा पढ़नेवाला बुद्धि और शिक्षा प्राप्त करे,"
  },
  {
    "id": 16404,
    "book": "proverbs                                ",
    "chapter": "1",
    "verse": "3",
    "text": "और विवेकपूर्ण जीवन निर्वाह करने में प्रवीणता,"
  },
  {
    "id": 16405,
    "book": "proverbs                                ",
    "chapter": "1",
    "verse": "4",
    "text": "कि भोलों को चतुराई,"
  },
  {
    "id": 16406,
    "book": "proverbs                                ",
    "chapter": "1",
    "verse": "5",
    "text": "कि बुद्धिमान सुनकर अपनी विद्या बढ़ाए,"
  },
  {
    "id": 16407,
    "book": "proverbs                                ",
    "chapter": "1",
    "verse": "6",
    "text": "जिससे वे नीतिवचन और दृष्टान्त को,"
  },
  {
    "id": 16408,
    "book": "proverbs                                ",
    "chapter": "1",
    "verse": "7",
    "text": "यहोवा का भय मानना बुद्धि का मूल है1:7 यहोवा का भय मानना बुद्धि का मूल है: बुद्धि का आरम्भ श्रद्धा एवं आदर के स्वभाव में पाया जाता है। अनन्त व्यक्तित्व की उपस्थिति में सीमित मनुष्य के मन में उत्पन्न भय। ;"
  },
  {
    "id": 16409,
    "book": "proverbs                                ",
    "chapter": "1",
    "verse": "8",
    "text": "हे मेरे पुत्र, अपने पिता की शिक्षा पर कान लगा,"
  },
  {
    "id": 16410,
    "book": "proverbs                                ",
    "chapter": "1",
    "verse": "9",
    "text": "क्योंकि वे मानो तेरे सिर के लिये शोभायमान मुकुट,"
  },
  {
    "id": 16411,
    "book": "proverbs                                ",
    "chapter": "1",
    "verse": "10",
    "text": "हे मेरे पुत्र, यदि पापी लोग तुझे फुसलाएँ,"
  },
  {
    "id": 16412,
    "book": "proverbs                                ",
    "chapter": "1",
    "verse": "11",
    "text": "यदि वे कहें, “हमारे संग चल,"
  },
  {
    "id": 16413,
    "book": "proverbs                                ",
    "chapter": "1",
    "verse": "12",
    "text": "हम उन्हें जीवित निगल जाए, जैसे अधोलोक स्वस्थ लोगों को निगल जाता है,"
  },
  {
    "id": 16414,
    "book": "proverbs                                ",
    "chapter": "1",
    "verse": "13",
    "text": "हमको सब प्रकार के अनमोल पदार्थ मिलेंगे,"
  },
  {
    "id": 16415,
    "book": "proverbs                                ",
    "chapter": "1",
    "verse": "14",
    "text": "तू हमारा सहभागी हो जा,"
  },
  {
    "id": 16416,
    "book": "proverbs                                ",
    "chapter": "1",
    "verse": "15",
    "text": "तो, हे मेरे पुत्र तू उनके संग मार्ग में न चलना,"
  },
  {
    "id": 16417,
    "book": "proverbs                                ",
    "chapter": "1",
    "verse": "16",
    "text": "क्योंकि वे बुराई ही करने को दौड़ते हैं,"
  },
  {
    "id": 16418,
    "book": "proverbs                                ",
    "chapter": "1",
    "verse": "17",
    "text": "क्योंकि पक्षी के देखते हुए जाल फैलाना व्यर्थ होता है;"
  },
  {
    "id": 16419,
    "book": "proverbs                                ",
    "chapter": "1",
    "verse": "18",
    "text": "और ये लोग तो अपनी ही हत्या करने के लिये घात लगाते हैं,"
  },
  {
    "id": 16420,
    "book": "proverbs                                ",
    "chapter": "1",
    "verse": "19",
    "text": "सब लालचियों की चाल ऐसी ही होती है;"
  },
  {
    "id": 16421,
    "book": "proverbs                                ",
    "chapter": "1",
    "verse": "20",
    "text": "बुद्धि सड़क में ऊँचे स्वर से बोलती है;"
  },
  {
    "id": 16422,
    "book": "proverbs                                ",
    "chapter": "1",
    "verse": "21",
    "text": "वह बाजारों की भीड़ में पुकारती है;"
  },
  {
    "id": 16423,
    "book": "proverbs                                ",
    "chapter": "1",
    "verse": "22",
    "text": "“हे अज्ञानियों, तुम कब तक अज्ञानता से प्रीति रखोगे?"
  },
  {
    "id": 16424,
    "book": "proverbs                                ",
    "chapter": "1",
    "verse": "23",
    "text": "तुम मेरी डाँट सुनकर मन फिराओ;"
  },
  {
    "id": 16425,
    "book": "proverbs                                ",
    "chapter": "1",
    "verse": "24",
    "text": "मैंने तो पुकारा परन्तु तुम ने इन्कार किया,"
  },
  {
    "id": 16426,
    "book": "proverbs                                ",
    "chapter": "1",
    "verse": "25",
    "text": "वरन् तुम ने मेरी सारी सम्मति को अनसुना किया,"
  },
  {
    "id": 16427,
    "book": "proverbs                                ",
    "chapter": "1",
    "verse": "26",
    "text": "इसलिए मैं भी तुम्हारी विपत्ति के समय हँसूँगी;"
  },
  {
    "id": 16428,
    "book": "proverbs                                ",
    "chapter": "1",
    "verse": "27",
    "text": "वरन् आँधी के समान तुम पर भय आ पड़ेगा,"
  },
  {
    "id": 16429,
    "book": "proverbs                                ",
    "chapter": "1",
    "verse": "28",
    "text": "उस समय वे मुझे पुकारेंगे, और मैं न सुनूँगी;"
  },
  {
    "id": 16430,
    "book": "proverbs                                ",
    "chapter": "1",
    "verse": "29",
    "text": "क्योंकि उन्होंने ज्ञान से बैर किया,"
  },
  {
    "id": 16431,
    "book": "proverbs                                ",
    "chapter": "1",
    "verse": "30",
    "text": "उन्होंने मेरी सम्मति न चाही"
  },
  {
    "id": 16432,
    "book": "proverbs                                ",
    "chapter": "1",
    "verse": "31",
    "text": "इसलिए वे अपनी करनी का फल आप भोगेंगे,"
  },
  {
    "id": 16433,
    "book": "proverbs                                ",
    "chapter": "1",
    "verse": "32",
    "text": "क्योंकि अज्ञानियों का भटक जाना, उनके घात किए जाने का कारण होगा,"
  },
  {
    "id": 16434,
    "book": "proverbs                                ",
    "chapter": "1",
    "verse": "33",
    "text": "परन्तु जो मेरी सुनेगा, वह निडर बसा रहेगा,"
  }
]
