[
  {
    "id": 16956,
    "book": "proverbs                                ",
    "chapter": "20",
    "verse": "1",
    "text": "दाखमधु ठट्ठा करनेवाला और मदिरा हल्ला मचानेवाली है;"
  },
  {
    "id": 16957,
    "book": "proverbs                                ",
    "chapter": "20",
    "verse": "2",
    "text": "राजा का क्रोध, जवान सिंह के गर्जन समान है;"
  },
  {
    "id": 16958,
    "book": "proverbs                                ",
    "chapter": "20",
    "verse": "3",
    "text": "मुकद्दमे से हाथ उठाना, पुरुष की महिमा ठहरती है;"
  },
  {
    "id": 16959,
    "book": "proverbs                                ",
    "chapter": "20",
    "verse": "4",
    "text": "आलसी मनुष्य शीत के कारण हल नहीं जोतता;"
  },
  {
    "id": 16960,
    "book": "proverbs                                ",
    "chapter": "20",
    "verse": "5",
    "text": "मनुष्य के मन की युक्ति अथाह तो है,"
  },
  {
    "id": 16961,
    "book": "proverbs                                ",
    "chapter": "20",
    "verse": "6",
    "text": "बहुत से मनुष्य अपनी निष्ठा का प्रचार करते हैं;"
  },
  {
    "id": 16962,
    "book": "proverbs                                ",
    "chapter": "20",
    "verse": "7",
    "text": "वह व्यक्ति जो अपनी सत्यनिष्ठा पर चलता है,"
  },
  {
    "id": 16963,
    "book": "proverbs                                ",
    "chapter": "20",
    "verse": "8",
    "text": "राजा जो न्याय के सिंहासन पर बैठा करता है,"
  },
  {
    "id": 16964,
    "book": "proverbs                                ",
    "chapter": "20",
    "verse": "9",
    "text": "कौन कह सकता है कि मैंने अपने हृदय को पवित्र किया;"
  },
  {
    "id": 16965,
    "book": "proverbs                                ",
    "chapter": "20",
    "verse": "10",
    "text": "घटते-बढ़ते बटखरे और घटते-बढ़ते नपुए इन दोनों से यहोवा घृणा करता है।"
  },
  {
    "id": 16966,
    "book": "proverbs                                ",
    "chapter": "20",
    "verse": "11",
    "text": "लड़का भी अपने कामों से पहचाना जाता है,"
  },
  {
    "id": 16967,
    "book": "proverbs                                ",
    "chapter": "20",
    "verse": "12",
    "text": "सुनने के लिये कान और देखने के लिये जो आँखें हैं,"
  },
  {
    "id": 16968,
    "book": "proverbs                                ",
    "chapter": "20",
    "verse": "13",
    "text": "नींद से प्रीति न रख, नहीं तो दरिद्र हो जाएगा;"
  },
  {
    "id": 16969,
    "book": "proverbs                                ",
    "chapter": "20",
    "verse": "14",
    "text": "मोल लेने के समय ग्राहक, “अच्छी नहीं, अच्छी नहीं,” कहता है;"
  },
  {
    "id": 16970,
    "book": "proverbs                                ",
    "chapter": "20",
    "verse": "15",
    "text": "सोना और बहुत से बहुमूल्य रत्न तो हैं;"
  },
  {
    "id": 16971,
    "book": "proverbs                                ",
    "chapter": "20",
    "verse": "16",
    "text": "किसी अनजान के लिए जमानत देनेवाले के वस्त्र ले और पराए के प्रति जो उत्तरदायी हुआ है उससे बँधक की वस्तु ले रख।"
  },
  {
    "id": 16972,
    "book": "proverbs                                ",
    "chapter": "20",
    "verse": "17",
    "text": "छल-कपट से प्राप्त रोटी मनुष्य को मीठी तो लगती है,"
  },
  {
    "id": 16973,
    "book": "proverbs                                ",
    "chapter": "20",
    "verse": "18",
    "text": "सब कल्पनाएँ सम्मति ही से स्थिर होती हैं;"
  },
  {
    "id": 16974,
    "book": "proverbs                                ",
    "chapter": "20",
    "verse": "19",
    "text": "जो लुतराई करता फिरता है वह भेद प्रगट करता है;"
  },
  {
    "id": 16975,
    "book": "proverbs                                ",
    "chapter": "20",
    "verse": "20",
    "text": "जो अपने माता-पिता को कोसता,"
  },
  {
    "id": 16976,
    "book": "proverbs                                ",
    "chapter": "20",
    "verse": "21",
    "text": "जो भाग पहले उतावली से मिलता है,"
  },
  {
    "id": 16977,
    "book": "proverbs                                ",
    "chapter": "20",
    "verse": "22",
    "text": "मत कह, “मैं बुराई का बदला लूँगा;”"
  },
  {
    "id": 16978,
    "book": "proverbs                                ",
    "chapter": "20",
    "verse": "23",
    "text": "घटते-बढ़ते बटखरों से यहोवा घृणा करता है,"
  },
  {
    "id": 16979,
    "book": "proverbs                                ",
    "chapter": "20",
    "verse": "24",
    "text": "मनुष्य का मार्ग यहोवा की ओर से ठहराया जाता है;"
  },
  {
    "id": 16980,
    "book": "proverbs                                ",
    "chapter": "20",
    "verse": "25",
    "text": "जो मनुष्य बिना विचारे किसी वस्तु को पवित्र ठहराए,"
  },
  {
    "id": 16981,
    "book": "proverbs                                ",
    "chapter": "20",
    "verse": "26",
    "text": "बुद्धिमान राजा दुष्टों को फटकता है,"
  },
  {
    "id": 16982,
    "book": "proverbs                                ",
    "chapter": "20",
    "verse": "27",
    "text": "मनुष्य की आत्मा यहोवा का दीपक है;"
  },
  {
    "id": 16983,
    "book": "proverbs                                ",
    "chapter": "20",
    "verse": "28",
    "text": "राजा की रक्षा कृपा और सच्चाई के कारण होती है,"
  },
  {
    "id": 16984,
    "book": "proverbs                                ",
    "chapter": "20",
    "verse": "29",
    "text": "जवानों का गौरव उनका बल है,"
  },
  {
    "id": 16985,
    "book": "proverbs                                ",
    "chapter": "20",
    "verse": "30",
    "text": "चोट लगने से जो घाव होते हैं, वे बुराई दूर करते हैं;"
  }
]
