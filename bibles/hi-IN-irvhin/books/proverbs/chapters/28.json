[
  {
    "id": 17198,
    "book": "proverbs                                ",
    "chapter": "28",
    "verse": "1",
    "text": "दुष्ट लोग जब कोई पीछा नहीं करता तब भी भागते हैं,"
  },
  {
    "id": 17199,
    "book": "proverbs                                ",
    "chapter": "28",
    "verse": "2",
    "text": "देश में पाप होने के कारण उसके हाकिम बदलते जाते हैं;"
  },
  {
    "id": 17200,
    "book": "proverbs                                ",
    "chapter": "28",
    "verse": "3",
    "text": "जो निर्धन पुरुष कंगालों पर अंधेर करता है,"
  },
  {
    "id": 17201,
    "book": "proverbs                                ",
    "chapter": "28",
    "verse": "4",
    "text": "जो लोग व्यवस्था को छोड़ देते हैं, वे दुष्ट की प्रशंसा करते हैं,"
  },
  {
    "id": 17202,
    "book": "proverbs                                ",
    "chapter": "28",
    "verse": "5",
    "text": "बुरे लोग न्याय को नहीं समझ सकते,"
  },
  {
    "id": 17203,
    "book": "proverbs                                ",
    "chapter": "28",
    "verse": "6",
    "text": "टेढ़ी चाल चलनेवाले धनी मनुष्य से खराई से चलनेवाला निर्धन पुरुष ही उत्तम है।"
  },
  {
    "id": 17204,
    "book": "proverbs                                ",
    "chapter": "28",
    "verse": "7",
    "text": "जो व्यवस्था का पालन करता वह समझदार सुपूत होता है,"
  },
  {
    "id": 17205,
    "book": "proverbs                                ",
    "chapter": "28",
    "verse": "8",
    "text": "जो अपना धन ब्याज से बढ़ाता है28:8 ब्याज से बढ़ाता है: धन का अनुचित अर्जन समृद्धि नहीं लाता है। कुछ समय बाद वह उन लोगों के हाथों में चला जाता है जो उसका उचित उपयोग करना जानता है।,"
  },
  {
    "id": 17206,
    "book": "proverbs                                ",
    "chapter": "28",
    "verse": "9",
    "text": "जो अपना कान व्यवस्था सुनने से मोड़ लेता है,"
  },
  {
    "id": 17207,
    "book": "proverbs                                ",
    "chapter": "28",
    "verse": "10",
    "text": "जो सीधे लोगों को भटकाकर कुमार्ग में ले जाता है वह अपने खोदे हुए गड्ढे में आप ही गिरता है;"
  },
  {
    "id": 17208,
    "book": "proverbs                                ",
    "chapter": "28",
    "verse": "11",
    "text": "धनी पुरुष अपनी दृष्टि में बुद्धिमान होता है,"
  },
  {
    "id": 17209,
    "book": "proverbs                                ",
    "chapter": "28",
    "verse": "12",
    "text": "जब धर्मी लोग जयवन्त होते हैं, तब बड़ी शोभा होती है;"
  },
  {
    "id": 17210,
    "book": "proverbs                                ",
    "chapter": "28",
    "verse": "13",
    "text": "जो अपने अपराध छिपा रखता है, उसका कार्य सफल नहीं होता,"
  },
  {
    "id": 17211,
    "book": "proverbs                                ",
    "chapter": "28",
    "verse": "14",
    "text": "जो मनुष्य निरन्तर प्रभु का भय मानता रहता है वह धन्य है;"
  },
  {
    "id": 17212,
    "book": "proverbs                                ",
    "chapter": "28",
    "verse": "15",
    "text": "कंगाल प्रजा पर प्रभुता करनेवाला दुष्ट, गरजनेवाले सिंह और घूमनेवाले रीछ के समान है।"
  },
  {
    "id": 17213,
    "book": "proverbs                                ",
    "chapter": "28",
    "verse": "16",
    "text": "वह शासक जिसमें समझ की कमी हो, वह बहुत अंधेर करता है;"
  },
  {
    "id": 17214,
    "book": "proverbs                                ",
    "chapter": "28",
    "verse": "17",
    "text": "जो किसी प्राणी की हत्या का अपराधी हो, वह भागकर गड्ढे में गिरेगा;"
  },
  {
    "id": 17215,
    "book": "proverbs                                ",
    "chapter": "28",
    "verse": "18",
    "text": "जो सिधाई से चलता है वह बचाया जाता है,"
  },
  {
    "id": 17216,
    "book": "proverbs                                ",
    "chapter": "28",
    "verse": "19",
    "text": "जो अपनी भूमि को जोता-बोया करता है, उसका तो पेट भरता है,"
  },
  {
    "id": 17217,
    "book": "proverbs                                ",
    "chapter": "28",
    "verse": "20",
    "text": "सच्चे मनुष्य पर बहुत आशीर्वाद होते रहते हैं,"
  },
  {
    "id": 17218,
    "book": "proverbs                                ",
    "chapter": "28",
    "verse": "21",
    "text": "पक्षपात करना अच्छा नहीं;"
  },
  {
    "id": 17219,
    "book": "proverbs                                ",
    "chapter": "28",
    "verse": "22",
    "text": "लोभी जन धन प्राप्त करने में उतावली करता है,"
  },
  {
    "id": 17220,
    "book": "proverbs                                ",
    "chapter": "28",
    "verse": "23",
    "text": "जो किसी मनुष्य को डाँटता है वह अन्त में चापलूसी करनेवाले से अधिक प्यारा हो जाता है।"
  },
  {
    "id": 17221,
    "book": "proverbs                                ",
    "chapter": "28",
    "verse": "24",
    "text": "जो अपने माँ-बाप को लूटकर कहता है कि कुछ अपराध नहीं,"
  },
  {
    "id": 17222,
    "book": "proverbs                                ",
    "chapter": "28",
    "verse": "25",
    "text": "लालची मनुष्य झगड़ा मचाता है,"
  },
  {
    "id": 17223,
    "book": "proverbs                                ",
    "chapter": "28",
    "verse": "26",
    "text": "जो अपने ऊपर भरोसा रखता है, वह मूर्ख है;"
  },
  {
