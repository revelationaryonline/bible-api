[
  {
    "id": 17115,
    "book": "proverbs                                ",
    "chapter": "25",
    "verse": "1",
    "text": "सुलैमान के नीतिवचन ये भी हैं;"
  },
  {
    "id": 17116,
    "book": "proverbs                                ",
    "chapter": "25",
    "verse": "2",
    "text": "परमेश्वर की महिमा, गुप्त रखने में है"
  },
  {
    "id": 17117,
    "book": "proverbs                                ",
    "chapter": "25",
    "verse": "3",
    "text": "स्वर्ग की ऊँचाई और पृथ्वी की गहराई"
  },
  {
    "id": 17118,
    "book": "proverbs                                ",
    "chapter": "25",
    "verse": "4",
    "text": "चाँदी में से मैल दूर करने पर वह सुनार के लिये काम की हो जाती है।"
  },
  {
    "id": 17119,
    "book": "proverbs                                ",
    "chapter": "25",
    "verse": "5",
    "text": "वैसे ही, राजा के सामने से दुष्ट को निकाल देने पर उसकी गद्दी धर्म के कारण स्थिर होगी।"
  },
  {
    "id": 17120,
    "book": "proverbs                                ",
    "chapter": "25",
    "verse": "6",
    "text": "राजा के सामने अपनी बड़ाई न करना"
  },
  {
    "id": 17121,
    "book": "proverbs                                ",
    "chapter": "25",
    "verse": "7",
    "text": "उनके लिए तुझ से यह कहना बेहतर है कि,"
  },
  {
    "id": 17122,
    "book": "proverbs                                ",
    "chapter": "25",
    "verse": "8",
    "text": "जो कुछ तूने देखा है, वह जल्दी से अदालत में न ला,"
  },
  {
    "id": 17123,
    "book": "proverbs                                ",
    "chapter": "25",
    "verse": "9",
    "text": "अपने पड़ोसी के साथ वाद-विवाद एकान्त में करना"
  },
  {
    "id": 17124,
    "book": "proverbs                                ",
    "chapter": "25",
    "verse": "10",
    "text": "ऐसा न हो कि सुननेवाला तेरी भी निन्दा करे,"
  },
  {
    "id": 17125,
    "book": "proverbs                                ",
    "chapter": "25",
    "verse": "11",
    "text": "जैसे चाँदी की टोकरियों में सोने के सेब हों,"
  },
  {
    "id": 17126,
    "book": "proverbs                                ",
    "chapter": "25",
    "verse": "12",
    "text": "जैसे सोने का नत्थ और कुन्दन का जेवर अच्छा लगता है,"
  },
  {
    "id": 17127,
    "book": "proverbs                                ",
    "chapter": "25",
    "verse": "13",
    "text": "जैसे कटनी के समय बर्फ की ठण्ड से,"
  },
  {
    "id": 17128,
    "book": "proverbs                                ",
    "chapter": "25",
    "verse": "14",
    "text": "जैसे बादल और पवन बिना वृष्टि निर्लाभ होते हैं,"
  },
  {
    "id": 17129,
    "book": "proverbs                                ",
    "chapter": "25",
    "verse": "15",
    "text": "धीरज धरने से न्यायी मनाया जाता है,"
  },
  {
    "id": 17130,
    "book": "proverbs                                ",
    "chapter": "25",
    "verse": "16",
    "text": "क्या तूने मधु पाया? तो जितना तेरे लिये ठीक हो उतना ही खाना,"
  },
  {
    "id": 17131,
    "book": "proverbs                                ",
    "chapter": "25",
    "verse": "17",
    "text": "अपने पड़ोसी के घर में बारम्बार जाने से अपने पाँव को रोक,"
  },
  {
    "id": 17132,
    "book": "proverbs                                ",
    "chapter": "25",
    "verse": "18",
    "text": "जो किसी के विरुद्ध झूठी साक्षी देता है,"
  },
  {
    "id": 17133,
    "book": "proverbs                                ",
    "chapter": "25",
    "verse": "19",
    "text": "विपत्ति के समय विश्वासघाती का भरोसा,"
  },
  {
    "id": 17134,
    "book": "proverbs                                ",
    "chapter": "25",
    "verse": "20",
    "text": "जैसा जाड़े के दिनों में किसी का वस्त्र उतारना या सज्जी पर सिरका डालना होता है,"
  },
  {
    "id": 17135,
    "book": "proverbs                                ",
    "chapter": "25",
    "verse": "21",
    "text": "यदि तेरा बैरी भूखा हो तो उसको रोटी खिलाना;"
  },
  {
    "id": 17136,
    "book": "proverbs                                ",
    "chapter": "25",
    "verse": "22",
    "text": "क्योंकि इस रीति तू उसके सिर पर अंगारे डालेगा,"
  },
  {
    "id": 17137,
    "book": "proverbs                                ",
    "chapter": "25",
    "verse": "23",
    "text": "जैसे उत्तरी वायु वर्षा को लाती है,"
  },
  {
    "id": 17138,
    "book": "proverbs                                ",
    "chapter": "25",
    "verse": "24",
    "text": "लम्बे चौड़े घर में झगड़ालू पत्नी के संग रहने से छत के कोने पर रहना उत्तम है।"
  },
  {
    "id": 17139,
    "book": "proverbs                                ",
    "chapter": "25",
    "verse": "25",
    "text": "दूर देश से शुभ सन्देश,"
  },
  {
    "id": 17140,
    "book": "proverbs                                ",
    "chapter": "25",
    "verse": "26",
    "text": "जो धर्मी दुष्ट के कहने में आता है,"
  },
  {
    "id": 17141,
    "book": "proverbs                                ",
    "chapter": "25",
    "verse": "27",
    "text": "जैसे बहुत मधु खाना अच्छा नहीं,"
  },
  {
    "id": 17142,
    "book": "proverbs                                ",
    "chapter": "25",
    "verse": "28",
    "text": "जिसकी आत्मा वश में नहीं वह ऐसे नगर के समान है जिसकी शहरपनाह घेराव करके तोड़ दी गई हो।"
  }
]
