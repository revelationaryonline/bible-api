  {
    "id": 16513,
    "book": "proverbs                                ",
    "chapter": "4",
    "verse": "22",
    "text": "क्योंकि जिनको वे प्राप्त होती हैं, वे उनके जीवित रहने का,"
  },
  {
    "id": 16514,
    "book": "proverbs                                ",
    "chapter": "4",
    "verse": "23",
    "text": "सबसे अधिक अपने मन की रक्षा कर;"
