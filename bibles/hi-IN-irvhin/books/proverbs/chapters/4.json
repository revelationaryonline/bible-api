[
  {
    "id": 16492,
    "book": "proverbs                                ",
    "chapter": "4",
    "verse": "1",
    "text": "हे मेरे पुत्रों, पिता की शिक्षा सुनो,"
  },
  {
    "id": 16493,
    "book": "proverbs                                ",
    "chapter": "4",
    "verse": "2",
    "text": "क्योंकि मैंने तुम को उत्तम शिक्षा दी है;"
  },
  {
    "id": 16494,
    "book": "proverbs                                ",
    "chapter": "4",
    "verse": "3",
    "text": "देखो, मैं भी अपने पिता का पुत्र था,"
  },
  {
    "id": 16495,
    "book": "proverbs                                ",
    "chapter": "4",
    "verse": "4",
    "text": "और मेरा पिता मुझे यह कहकर सिखाता था,"
  },
  {
