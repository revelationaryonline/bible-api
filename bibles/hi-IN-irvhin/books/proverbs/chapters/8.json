[
  {
    "id": 16604,
    "book": "proverbs                                ",
    "chapter": "8",
    "verse": "1",
    "text": "क्या बुद्धि नहीं पुकारती है?"
  },
  {
    "id": 16605,
    "book": "proverbs                                ",
    "chapter": "8",
    "verse": "2",
    "text": "बुद्धि तो मार्ग के ऊँचे स्थानों पर,"
  },
  {
    "id": 16606,
    "book": "proverbs                                ",
    "chapter": "8",
    "verse": "3",
    "text": "फाटकों के पास नगर के पैठाव में,"
  },
  {
    "id": 16607,
    "book": "proverbs                                ",
    "chapter": "8",
    "verse": "4",
    "text": "“हे लोगों, मैं तुम को पुकारती हूँ,"
  },
  {
    "id": 16608,
    "book": "proverbs                                ",
    "chapter": "8",
    "verse": "5",
    "text": "हे भोलों, चतुराई सीखो;"
  },
  {
    "id": 16609,
    "book": "proverbs                                ",
    "chapter": "8",
    "verse": "6",
    "text": "सुनो, क्योंकि मैं उत्तम बातें कहूँगी,"
  },
  {
    "id": 16610,
    "book": "proverbs                                ",
    "chapter": "8",
    "verse": "7",
    "text": "क्योंकि मुझसे सच्चाई की बातों का वर्णन होगा;"
  },
  {
    "id": 16611,
    "book": "proverbs                                ",
    "chapter": "8",
    "verse": "8",
    "text": "मेरे मुँह की सब बातें धर्म की होती हैं,"
  },
  {
    "id": 16612,
    "book": "proverbs                                ",
    "chapter": "8",
    "verse": "9",
    "text": "समझवाले के लिये वे सब सहज,"
  },
  {
    "id": 16613,
    "book": "proverbs                                ",
    "chapter": "8",
    "verse": "10",
    "text": "चाँदी नहीं, मेरी शिक्षा ही को चुन लो,"
  },
  {
    "id": 16614,
    "book": "proverbs                                ",
    "chapter": "8",
    "verse": "11",
    "text": "क्योंकि बुद्धि, बहुमूल्य रत्नों से भी अच्छी है,"
  },
  {
    "id": 16615,
    "book": "proverbs                                ",
    "chapter": "8",
    "verse": "12",
    "text": "मैं जो बुद्धि हूँ, और मैं चतुराई में वास करती हूँ8:12 मैं जो बुद्धि हूँ, और मैं चतुराई में वास करती हूँ: बुद्धि सबसे पहले चेतावनी देती है फिर प्रतिज्ञा करती है परन्तु यहाँ वह न तो प्रतिज्ञा करती न ही डराती है परन्तु अपनी श्रेष्ठता में बोलती है। ,"
  },
  {
    "id": 16616,
    "book": "proverbs                                ",
    "chapter": "8",
    "verse": "13",
    "text": "यहोवा का भय मानना बुराई से बैर रखना है।"
  },
  {
    "id": 16617,
    "book": "proverbs                                ",
    "chapter": "8",
    "verse": "14",
    "text": "उत्तम युक्ति, और खरी बुद्धि मेरी ही है, मुझ में समझ है,"
  },
  {
    "id": 16618,
    "book": "proverbs                                ",
    "chapter": "8",
    "verse": "15",
    "text": "मेरे ही द्वारा राजा राज्य करते हैं,"
  },
  {
    "id": 16619,
    "book": "proverbs                                ",
    "chapter": "8",
    "verse": "16",
    "text": "मेरे ही द्वारा राजा,"
  },
  {
    "id": 16620,
    "book": "proverbs                                ",
    "chapter": "8",
    "verse": "17",
    "text": "जो मुझसे प्रेम रखते हैं, उनसे मैं भी प्रेम रखती हूँ,"
  },
  {
    "id": 16621,
    "book": "proverbs                                ",
    "chapter": "8",
    "verse": "18",
    "text": "धन और प्रतिष्ठा,"
  },
  {
    "id": 16622,
    "book": "proverbs                                ",
    "chapter": "8",
    "verse": "19",
    "text": "मेरा फल शुद्ध सोने से,"
  },
  {
    "id": 16623,
    "book": "proverbs                                ",
    "chapter": "8",
    "verse": "20",
    "text": "मैं धर्म के मार्ग में,"
  },
  {
    "id": 16624,
    "book": "proverbs                                ",
    "chapter": "8",
    "verse": "21",
    "text": "जिससे मैं अपने प्रेमियों को धन-सम्पत्ति का भागी करूँ,"
  },
  {
    "id": 16625,
    "book": "proverbs                                ",
    "chapter": "8",
    "verse": "22",
    "text": "“यहोवा ने मुझे काम करने के आरम्भ में,"
  },
  {
    "id": 16626,
    "book": "proverbs                                ",
    "chapter": "8",
    "verse": "23",
    "text": "मैं सदा से वरन् आदि ही से पृथ्वी की सृष्टि से पहले ही से ठहराई गई हूँ।"
  },
  {
    "id": 16627,
    "book": "proverbs                                ",
    "chapter": "8",
    "verse": "24",
    "text": "जब न तो गहरा सागर था,"
  },
  {
    "id": 16628,
    "book": "proverbs                                ",
    "chapter": "8",
    "verse": "25",
    "text": "जब पहाड़ और पहाड़ियाँ स्थिर न की गई थीं,"
  },
  {
    "id": 16629,
    "book": "proverbs                                ",
    "chapter": "8",
    "verse": "26",
    "text": "जब यहोवा ने न तो पृथ्वी"
  },
  {
    "id": 16630,
    "book": "proverbs                                ",
    "chapter": "8",
    "verse": "27",
    "text": "जब उसने आकाश को स्थिर किया, तब मैं वहाँ थी,"
  },
  {
    "id": 16631,
    "book": "proverbs                                ",
    "chapter": "8",
    "verse": "28",
    "text": "जब उसने आकाशमण्डल को ऊपर से स्थिर किया,"
  },
  {
    "id": 16632,
    "book": "proverbs                                ",
    "chapter": "8",
    "verse": "29",
    "text": "जब उसने समुद्र की सीमा ठहराई,"
  },
  {
    "id": 16633,
    "book": "proverbs                                ",
    "chapter": "8",
    "verse": "30",
    "text": "तब मैं प्रधान कारीगर के समान उसके पास थी;"
  },
  {
    "id": 16634,
    "book": "proverbs                                ",
    "chapter": "8",
    "verse": "31",
    "text": "मैं उसकी बसाई हुई पृथ्वी से प्रसन्न थी"
  },
  {
    "id": 16635,
    "book": "proverbs                                ",
    "chapter": "8",
    "verse": "32",
    "text": "“इसलिए अब हे मेरे पुत्रों, मेरी सुनो;"
  },
  {
    "id": 16636,
    "book": "proverbs                                ",
    "chapter": "8",
    "verse": "33",
    "text": "शिक्षा को सुनो, और बुद्धिमान हो जाओ,"
  },
  {
    "id": 16637,
    "book": "proverbs                                ",
    "chapter": "8",
    "verse": "34",
    "text": "क्या ही धन्य है वह मनुष्य जो मेरी सुनता,"
  },
  {
    "id": 16638,
    "book": "proverbs                                ",
    "chapter": "8",
    "verse": "35",
    "text": "क्योंकि जो मुझे पाता है, वह जीवन को पाता है,"
  },
  {
    "id": 16639,
    "book": "proverbs                                ",
    "chapter": "8",
    "verse": "36",
    "text": "परन्तु जो मुझे ढूँढ़ने में विफल होता है,"
  }
]
