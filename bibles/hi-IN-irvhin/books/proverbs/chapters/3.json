[
  {
    "id": 16457,
    "book": "proverbs                                ",
    "chapter": "3",
    "verse": "1",
    "text": "हे मेरे पुत्र, मेरी शिक्षा को न भूलना;"
  },
  {
    "id": 16458,
    "book": "proverbs                                ",
    "chapter": "3",
    "verse": "2",
    "text": "क्योंकि ऐसा करने से तेरी आयु बढ़ेगी,"
  },
  {
    "id": 16459,
    "book": "proverbs                                ",
    "chapter": "3",
    "verse": "3",
    "text": "कृपा और सच्चाई तुझ से अलग न होने पाएँ;"
  },
  {
    "id": 16460,
    "book": "proverbs                                ",
    "chapter": "3",
    "verse": "4",
    "text": "तब तू परमेश्वर और मनुष्य दोनों का अनुग्रह पाएगा,"
  },
  {
    "id": 16461,
    "book": "proverbs                                ",
    "chapter": "3",
    "verse": "5",
    "text": "तू अपनी समझ का सहारा न लेना,"
  },
  {
    "id": 16462,
    "book": "proverbs                                ",
    "chapter": "3",
    "verse": "6",
    "text": "उसी को स्मरण करके सब काम करना,"
  },
  {
    "id": 16463,
    "book": "proverbs                                ",
    "chapter": "3",
    "verse": "7",
    "text": "अपनी दृष्टि में बुद्धिमान न होना;"
  },
  {
    "id": 16464,
    "book": "proverbs                                ",
    "chapter": "3",
    "verse": "8",
    "text": "ऐसा करने से तेरा शरीर भला चंगा,"
  },
  {
    "id": 16465,
    "book": "proverbs                                ",
    "chapter": "3",
    "verse": "9",
    "text": "अपनी सम्पत्ति के द्वारा"
  },
  {
    "id": 16466,
    "book": "proverbs                                ",
    "chapter": "3",
    "verse": "10",
    "text": "इस प्रकार तेरे खत्ते भरे"
  },
  {
    "id": 16467,
    "book": "proverbs                                ",
    "chapter": "3",
    "verse": "11",
    "text": "हे मेरे पुत्र, यहोवा की शिक्षा से मुँह न मोड़ना,"
  },
  {
    "id": 16468,
    "book": "proverbs                                ",
    "chapter": "3",
    "verse": "12",
    "text": "जैसे पिता अपने प्रिय पुत्र को डाँटता है,"
  },
  {
    "id": 16469,
    "book": "proverbs                                ",
    "chapter": "3",
    "verse": "13",
    "text": "क्या ही धन्य है वह मनुष्य जो बुद्धि पाए, और वह मनुष्य जो समझ प्राप्त करे,"
  },
  {
    "id": 16470,
    "book": "proverbs                                ",
    "chapter": "3",
    "verse": "14",
    "text": "जो उपलब्धि बुद्धि से प्राप्त होती है, वह चाँदी की प्राप्ति से बड़ी,"
  },
  {
    "id": 16471,
    "book": "proverbs                                ",
    "chapter": "3",
    "verse": "15",
    "text": "वह बहुमूल्य रत्नों से अधिक मूल्यवान है,"
  },
  {
    "id": 16472,
    "book": "proverbs                                ",
    "chapter": "3",
    "verse": "16",
    "text": "उसके दाहिने हाथ में दीर्घायु,"
  },
  {
    "id": 16473,
    "book": "proverbs                                ",
    "chapter": "3",
    "verse": "17",
    "text": "उसके मार्ग आनन्ददायक हैं,"
  },
  {
    "id": 16474,
    "book": "proverbs                                ",
    "chapter": "3",
    "verse": "18",
    "text": "जो बुद्धि को ग्रहण कर लेते हैं,"
  },
  {
    "id": 16475,
    "book": "proverbs                                ",
    "chapter": "3",
    "verse": "19",
    "text": "यहोवा ने पृथ्वी की नींव बुद्धि ही से डाली;"
  },
  {
    "id": 16476,
    "book": "proverbs                                ",
    "chapter": "3",
    "verse": "20",
    "text": "उसी के ज्ञान के द्वारा गहरे सागर फूट निकले,"
  },
  {
    "id": 16477,
    "book": "proverbs                                ",
    "chapter": "3",
    "verse": "21",
    "text": "हे मेरे पुत्र, ये बातें तेरी दृष्टि की ओट न होने पाए; तू खरी बुद्धि"
  },
  {
    "id": 16478,
    "book": "proverbs                                ",
    "chapter": "3",
    "verse": "22",
    "text": "तब इनसे तुझे जीवन मिलेगा,"
  },
  {
    "id": 16479,
    "book": "proverbs                                ",
    "chapter": "3",
    "verse": "23",
    "text": "तब तू अपने मार्ग पर निडर चलेगा,"
  },
  {
    "id": 16480,
    "book": "proverbs                                ",
    "chapter": "3",
    "verse": "24",
    "text": "जब तू लेटेगा, तब भय न खाएगा,"
  },
  {
    "id": 16481,
    "book": "proverbs                                ",
    "chapter": "3",
    "verse": "25",
    "text": "अचानक आनेवाले भय से न डरना,"
  },
  {
    "id": 16482,
    "book": "proverbs                                ",
    "chapter": "3",
    "verse": "26",
    "text": "क्योंकि यहोवा तुझे सहारा दिया करेगा,"
  },
  {
    "id": 16483,
    "book": "proverbs                                ",
    "chapter": "3",
    "verse": "27",
    "text": "जो भलाई के योग्य है उनका भला अवश्य करना,"
  },
  {
    "id": 16484,
    "book": "proverbs                                ",
    "chapter": "3",
    "verse": "28",
    "text": "यदि तेरे पास देने को कुछ हो,"
  },
  {
    "id": 16485,
    "book": "proverbs                                ",
    "chapter": "3",
    "verse": "29",
    "text": "जब तेरा पड़ोसी तेरे पास निश्चिन्त रहता है,"
  },
  {
    "id": 16486,
    "book": "proverbs                                ",
    "chapter": "3",
    "verse": "30",
    "text": "जिस मनुष्य ने तुझ से बुरा व्यवहार न किया हो,"
  },
  {
    "id": 16487,
    "book": "proverbs                                ",
    "chapter": "3",
    "verse": "31",
    "text": "उपद्रवी पुरुष के विषय में डाह न करना,"
  },
  {
    "id": 16488,
    "book": "proverbs                                ",
    "chapter": "3",
    "verse": "32",
    "text": "क्योंकि यहोवा कुटिल मनुष्य से घृणा करता है,"
  },
  {
    "id": 16489,
    "book": "proverbs                                ",
    "chapter": "3",
    "verse": "33",
    "text": "दुष्ट के घर पर यहोवा का श्राप"
  },
  {
    "id": 16490,
    "book": "proverbs                                ",
    "chapter": "3",
    "verse": "34",
    "text": "ठट्ठा करनेवालों का वह निश्चय ठट्ठा करता है;"
  },
  {
    "id": 16491,
    "book": "proverbs                                ",
    "chapter": "3",
    "verse": "35",
    "text": "बुद्धिमान महिमा को पाएँगे,"
  }
]
