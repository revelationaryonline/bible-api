[
  {
    "id": 17143,
    "book": "proverbs                                ",
    "chapter": "26",
    "verse": "1",
    "text": "जैसा धूपकाल में हिम का, या कटनी के समय वर्षा होना,"
  },
  {
    "id": 17144,
    "book": "proverbs                                ",
    "chapter": "26",
    "verse": "2",
    "text": "जैसे गौरैया घूमते-घूमते और शूपाबेनी उड़ते-उड़ते नहीं बैठती,"
  },
  {
    "id": 17145,
    "book": "proverbs                                ",
    "chapter": "26",
    "verse": "3",
    "text": "घोड़े के लिये कोड़ा, गदहे के लिये लगाम,"
  },
  {
    "id": 17146,
    "book": "proverbs                                ",
    "chapter": "26",
    "verse": "4",
    "text": "मूर्ख को उसकी मूर्खता के अनुसार उत्तर न देना ऐसा न हो कि तू भी उसके तुल्य ठहरे।"
  },
  {
    "id": 17147,
    "book": "proverbs                                ",
    "chapter": "26",
    "verse": "5",
    "text": "मूर्ख को उसकी मूर्खता के अनुसार उत्तर देना,"
  },
  {
    "id": 17148,
    "book": "proverbs                                ",
    "chapter": "26",
    "verse": "6",
    "text": "जो मूर्ख के हाथ से सन्देशा भेजता है,"
  },
  {
    "id": 17149,
    "book": "proverbs                                ",
    "chapter": "26",
    "verse": "7",
    "text": "जैसे लँगड़े के पाँव लड़खड़ाते हैं,"
  },
  {
    "id": 17150,
    "book": "proverbs                                ",
    "chapter": "26",
    "verse": "8",
    "text": "जैसे पत्थरों के ढेर में मणियों की थैली,"
  },
  {
    "id": 17151,
    "book": "proverbs                                ",
    "chapter": "26",
    "verse": "9",
    "text": "जैसे मतवाले के हाथ में काँटा गड़ता है,"
  },
  {
    "id": 17152,
    "book": "proverbs                                ",
    "chapter": "26",
    "verse": "10",
    "text": "जैसा कोई तीरन्दाज जो अकारण सब को मारता हो,"
  },
  {
    "id": 17153,
    "book": "proverbs                                ",
    "chapter": "26",
    "verse": "11",
    "text": "जैसे कुत्ता अपनी छाँट को चाटता है,"
  },
  {
    "id": 17154,
    "book": "proverbs                                ",
    "chapter": "26",
    "verse": "12",
    "text": "यदि तू ऐसा मनुष्य देखे जो अपनी दृष्टि में बुद्धिमान बनता हो,"
  },
  {
    "id": 17155,
    "book": "proverbs                                ",
    "chapter": "26",
    "verse": "13",
    "text": "आलसी कहता है, “मार्ग में सिंह है,"
  },
  {
    "id": 17156,
    "book": "proverbs                                ",
    "chapter": "26",
    "verse": "14",
    "text": "जैसे किवाड़ अपनी चूल पर घूमता है,"
  },
  {
    "id": 17157,
    "book": "proverbs                                ",
    "chapter": "26",
    "verse": "15",
    "text": "आलसी अपना हाथ थाली में तो डालता है,"
  },
  {
    "id": 17158,
    "book": "proverbs                                ",
    "chapter": "26",
    "verse": "16",
    "text": "आलसी अपने को ठीक उत्तर देनेवाले"
  },
  {
    "id": 17159,
    "book": "proverbs                                ",
    "chapter": "26",
    "verse": "17",
    "text": "जो मार्ग पर चलते हुए पराए झगड़े में विघ्न डालता है,"
  },
  {
    "id": 17160,
    "book": "proverbs                                ",
    "chapter": "26",
    "verse": "18",
    "text": "जैसा एक पागल जो जहरीले तीर मारता है,"
  },
  {
    "id": 17161,
    "book": "proverbs                                ",
    "chapter": "26",
    "verse": "19",
    "text": "वैसा ही वह भी होता है जो अपने पड़ोसी को धोखा देकर कहता है,"
  },
  {
    "id": 17162,
    "book": "proverbs                                ",
    "chapter": "26",
    "verse": "20",
    "text": "जैसे लकड़ी न होने से आग बुझती है,"
  },
  {
    "id": 17163,
    "book": "proverbs                                ",
    "chapter": "26",
    "verse": "21",
    "text": "जैसा अंगारों में कोयला और आग में लकड़ी होती है,"
  },
  {
    "id": 17164,
    "book": "proverbs                                ",
    "chapter": "26",
    "verse": "22",
    "text": "कानाफूसी करनेवाले के वचन,"
  },
  {
    "id": 17165,
    "book": "proverbs                                ",
    "chapter": "26",
    "verse": "23",
    "text": "जैसा कोई चाँदी का पानी चढ़ाया हुआ मिट्टी का बर्तन हो,"
  },
  {
    "id": 17166,
    "book": "proverbs                                ",
    "chapter": "26",
    "verse": "24",
    "text": "जो बैरी बात से तो अपने को भोला बनाता है,"
  },
  {
    "id": 17167,
    "book": "proverbs                                ",
    "chapter": "26",
    "verse": "25",
    "text": "उसकी मीठी-मीठी बात पर विश्वास न करना,"
  },
  {
    "id": 17168,
    "book": "proverbs                                ",
    "chapter": "26",
    "verse": "26",
    "text": "चाहे उसका बैर छल के कारण छिप भी जाए,"
  },
  {
    "id": 17169,
    "book": "proverbs                                ",
    "chapter": "26",
    "verse": "27",
    "text": "जो गड्ढा खोदे, वही उसी में गिरेगा, और जो पत्थर लुढ़काए,"
  },
  {
    "id": 17170,
    "book": "proverbs                                ",
    "chapter": "26",
    "verse": "28",
    "text": "जिसने किसी को झूठी बातों से घायल किया हो वह उससे बैर रखता है,"
  }
]
