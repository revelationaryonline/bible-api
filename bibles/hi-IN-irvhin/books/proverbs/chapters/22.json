[
  {
    "id": 17017,
    "book": "proverbs                                ",
    "chapter": "22",
    "verse": "1",
    "text": "बड़े धन से अच्छा नाम अधिक चाहने योग्य है,"
  },
  {
    "id": 17018,
    "book": "proverbs                                ",
    "chapter": "22",
    "verse": "2",
    "text": "धनी और निर्धन दोनों में एक समानता है;"
  },
  {
    "id": 17019,
    "book": "proverbs                                ",
    "chapter": "22",
    "verse": "3",
    "text": "चतुर मनुष्य विपत्ति को आते देखकर छिप जाता है;"
  },
  {
    "id": 17020,
    "book": "proverbs                                ",
    "chapter": "22",
    "verse": "4",
    "text": "नम्रता और यहोवा के भय22:4 नम्रता और यहोवा के भय: नम्रता का प्रतिफल यहोवा का भय, “धन-सम्पति, सम्मान और जीवन है।  मानने का फल धन,"
  },
  {
    "id": 17021,
    "book": "proverbs                                ",
    "chapter": "22",
    "verse": "5",
    "text": "टेढ़े मनुष्य के मार्ग में काँटे और फंदे रहते हैं;"
  },
  {
    "id": 17022,
    "book": "proverbs                                ",
    "chapter": "22",
    "verse": "6",
    "text": "लड़के को उसी मार्ग की शिक्षा दे जिसमें उसको चलना चाहिये,"
  },
  {
    "id": 17023,
    "book": "proverbs                                ",
    "chapter": "22",
    "verse": "7",
    "text": "धनी, निर्धन लोगों पर प्रभुता करता है,"
  },
  {
    "id": 17024,
    "book": "proverbs                                ",
    "chapter": "22",
    "verse": "8",
    "text": "जो कुटिलता का बीज बोता है, वह अनर्थ ही काटेगा,"
  },
  {
    "id": 17025,
    "book": "proverbs                                ",
    "chapter": "22",
    "verse": "9",
    "text": "दया करनेवाले पर आशीष फलती है,"
  },
  {
    "id": 17026,
    "book": "proverbs                                ",
    "chapter": "22",
    "verse": "10",
    "text": "ठट्ठा करनेवाले को निकाल दे, तब झगड़ा मिट जाएगा,"
  },
  {
    "id": 17027,
    "book": "proverbs                                ",
    "chapter": "22",
    "verse": "11",
    "text": "जो मन की शुद्धता से प्रीति रखता है,"
  },
  {
    "id": 17028,
    "book": "proverbs                                ",
    "chapter": "22",
    "verse": "12",
    "text": "यहोवा ज्ञानी पर दृष्टि करके, उसकी रक्षा करता है,"
  },
  {
    "id": 17029,
    "book": "proverbs                                ",
    "chapter": "22",
    "verse": "13",
    "text": "आलसी कहता है, बाहर तो सिंह होगा!"
  },
  {
    "id": 17030,
    "book": "proverbs                                ",
    "chapter": "22",
    "verse": "14",
    "text": "व्यभिचारिणी का मुँह गहरा गड्ढा है;"
  },
  {
    "id": 17031,
    "book": "proverbs                                ",
    "chapter": "22",
    "verse": "15",
    "text": "लड़के के मन में मूर्खता की गाँठ बंधी रहती है,"
  },
  {
    "id": 17032,
    "book": "proverbs                                ",
    "chapter": "22",
    "verse": "16",
    "text": "जो अपने लाभ के निमित्त कंगाल पर अंधेर करता है,"
  },
  {
    "id": 17033,
    "book": "proverbs                                ",
    "chapter": "22",
    "verse": "17",
    "text": "कान लगाकर बुद्धिमानों के वचन सुन,"
  },
  {
    "id": 17034,
    "book": "proverbs                                ",
    "chapter": "22",
    "verse": "18",
    "text": "यदि तू उसको अपने मन में रखे,"
  },
  {
    "id": 17035,
    "book": "proverbs                                ",
    "chapter": "22",
    "verse": "19",
    "text": "मैंने आज इसलिए ये बातें तुझको बताई है,"
  },
  {
    "id": 17036,
    "book": "proverbs                                ",
    "chapter": "22",
    "verse": "20",
    "text": "मैं बहुत दिनों से तेरे हित के उपदेश"
  },
  {
    "id": 17037,
    "book": "proverbs                                ",
    "chapter": "22",
    "verse": "21",
    "text": "कि मैं तुझे सत्य वचनों का निश्चय करा दूँ,"
  },
  {
    "id": 17038,
    "book": "proverbs                                ",
    "chapter": "22",
    "verse": "22",
    "text": "कंगाल पर इस कारण अंधेर न करना22:22 कंगाल पर इस कारण अंधेर न करना: कंगाल की लाचारी के कारण उसकी हानि करने के लिए परीक्षा में मत पड़ना। कि वह कंगाल है,"
  },
  {
    "id": 17039,
    "book": "proverbs                                ",
    "chapter": "22",
    "verse": "23",
    "text": "क्योंकि यहोवा उनका मुकद्दमा लड़ेगा,"
  },
  {
    "id": 17040,
    "book": "proverbs                                ",
    "chapter": "22",
    "verse": "24",
    "text": "क्रोधी मनुष्य का मित्र न होना,"
  },
  {
    "id": 17041,
    "book": "proverbs                                ",
    "chapter": "22",
    "verse": "25",
    "text": "कहीं ऐसा न हो कि तू उसकी चाल सीखे,"
  },
  {
    "id": 17042,
    "book": "proverbs                                ",
    "chapter": "22",
    "verse": "26",
    "text": "जो लोग हाथ पर हाथ मारते हैं,"
  },
  {
    "id": 17043,
    "book": "proverbs                                ",
    "chapter": "22",
    "verse": "27",
    "text": "यदि तेरे पास भुगतान करने के साधन की कमी हो,"
  },
  {
    "id": 17044,
    "book": "proverbs                                ",
    "chapter": "22",
    "verse": "28",
    "text": "जो सीमा तेरे पुरखाओं ने बाँधी हो, उस पुरानी सीमा को न बढ़ाना।"
  },
  {
    "id": 17045,
    "book": "proverbs                                ",
    "chapter": "22",
    "verse": "29",
    "text": "यदि तू ऐसा पुरुष देखे जो काम-काज में निपुण हो,"
  }
]
