[
  {
    "id": 16986,
    "book": "proverbs                                ",
    "chapter": "21",
    "verse": "1",
    "text": "राजा का मन जल की धाराओं के समान यहोवा के हाथ में रहता है,"
  },
  {
    "id": 16987,
    "book": "proverbs                                ",
    "chapter": "21",
    "verse": "2",
    "text": "मनुष्य का सारा चाल चलन अपनी दृष्टि में तो ठीक होता है,"
  },
  {
    "id": 16988,
    "book": "proverbs                                ",
    "chapter": "21",
    "verse": "3",
    "text": "धर्म और न्याय करना,"
  },
  {
    "id": 16989,
    "book": "proverbs                                ",
    "chapter": "21",
    "verse": "4",
    "text": "चढ़ी आँखें, घमण्डी मन,"
  },
  {
    "id": 16990,
    "book": "proverbs                                ",
    "chapter": "21",
    "verse": "5",
    "text": "कामकाजी की कल्पनाओं से केवल लाभ होता है,"
  },
  {
    "id": 16991,
    "book": "proverbs                                ",
    "chapter": "21",
    "verse": "6",
    "text": "जो धन झूठ के द्वारा प्राप्त हो, वह वायु से उड़ जानेवाला कुहरा है,"
  },
  {
    "id": 16992,
    "book": "proverbs                                ",
    "chapter": "21",
    "verse": "7",
    "text": "जो उपद्रव दुष्ट लोग करते हैं,"
  },
  {
    "id": 16993,
    "book": "proverbs                                ",
    "chapter": "21",
    "verse": "8",
    "text": "पाप से लदे हुए मनुष्य का मार्ग बहुत ही टेढ़ा होता है,"
  },
  {
    "id": 16994,
    "book": "proverbs                                ",
    "chapter": "21",
    "verse": "9",
    "text": "लम्बे-चौड़े घर में झगड़ालू पत्नी के संग रहने से,"
  },
  {
    "id": 16995,
    "book": "proverbs                                ",
    "chapter": "21",
    "verse": "10",
    "text": "दुष्ट जन बुराई की लालसा जी से करता है,"
  },
  {
    "id": 16996,
    "book": "proverbs                                ",
    "chapter": "21",
    "verse": "11",
    "text": "जब ठट्ठा करनेवाले को दण्ड दिया जाता है, तब भोला बुद्धिमान हो जाता है;"
  },
  {
    "id": 16997,
    "book": "proverbs                                ",
    "chapter": "21",
    "verse": "12",
    "text": "धर्मी जन दुष्टों के घराने पर बुद्धिमानी से विचार करता है,"
  },
  {
    "id": 16998,
    "book": "proverbs                                ",
    "chapter": "21",
    "verse": "13",
    "text": "जो कंगाल की दुहाई पर कान न दे,"
  },
  {
    "id": 16999,
    "book": "proverbs                                ",
    "chapter": "21",
    "verse": "14",
    "text": "गुप्त में दी हुई भेंट से क्रोध ठंडा होता है,"
  },
  {
    "id": 17000,
    "book": "proverbs                                ",
    "chapter": "21",
    "verse": "15",
    "text": "न्याय का काम करना धर्मी को तो आनन्द,"
  },
  {
    "id": 17001,
    "book": "proverbs                                ",
    "chapter": "21",
    "verse": "16",
    "text": "जो मनुष्य बुद्धि के मार्ग से भटक जाए,"
  },
  {
    "id": 17002,
    "book": "proverbs                                ",
    "chapter": "21",
    "verse": "17",
    "text": "जो रागरंग से प्रीति रखता है, वह कंगाल हो जाता है;"
  },
  {
    "id": 17003,
    "book": "proverbs                                ",
    "chapter": "21",
    "verse": "18",
    "text": "दुष्ट जन धर्मी की छुड़ौती ठहरता है,"
  },
  {
    "id": 17004,
    "book": "proverbs                                ",
    "chapter": "21",
    "verse": "19",
    "text": "झगड़ालू और चिढ़नेवाली पत्नी के संग रहने से,"
  },
  {
    "id": 17005,
    "book": "proverbs                                ",
    "chapter": "21",
    "verse": "20",
    "text": "बुद्धिमान के घर में उत्तम धन और तेल पाए जाते हैं,"
  },
  {
    "id": 17006,
    "book": "proverbs                                ",
    "chapter": "21",
    "verse": "21",
    "text": "जो धर्म और कृपा का पीछा करता है21:21 जो धर्म और कृपा का पीछा करता है: जो धर्म का पालन करता है वह निश्चय ही उसे पाएगा परन्तु उसके अतिरिक्त वह “जीवन” एवं “सम्मान” भी पाएगा जिसकी वह खोज नहीं करता है।,"
  },
  {
    "id": 17007,
    "book": "proverbs                                ",
    "chapter": "21",
    "verse": "22",
    "text": "बुद्धिमान शूरवीरों के नगर पर चढ़कर,"
  },
  {
    "id": 17008,
    "book": "proverbs                                ",
    "chapter": "21",
    "verse": "23",
    "text": "जो अपने मुँह को वश में रखता है"
  },
  {
    "id": 17009,
    "book": "proverbs                                ",
    "chapter": "21",
    "verse": "24",
    "text": "जो अभिमान से रोष में आकर काम करता है, उसका नाम अभिमानी,"
  },
  {
    "id": 17010,
    "book": "proverbs                                ",
    "chapter": "21",
    "verse": "25",
    "text": "आलसी अपनी लालसा ही में मर जाता है,"
  },
  {
    "id": 17011,
    "book": "proverbs                                ",
    "chapter": "21",
    "verse": "26",
    "text": "कोई ऐसा है, जो दिन भर लालसा ही किया करता है,"
  },
  {
    "id": 17012,
    "book": "proverbs                                ",
    "chapter": "21",
    "verse": "27",
    "text": "दुष्टों का बलिदान घृणित है;"
  },
  {
    "id": 17013,
    "book": "proverbs                                ",
    "chapter": "21",
    "verse": "28",
    "text": "झूठा साक्षी नाश हो जाएगा,"
  },
  {
    "id": 17014,
    "book": "proverbs                                ",
    "chapter": "21",
    "verse": "29",
    "text": "दुष्ट मनुष्य अपना मुख कठोर करता है,"
  },
  {
    "id": 17015,
    "book": "proverbs                                ",
    "chapter": "21",
    "verse": "30",
    "text": "यहोवा के विरुद्ध न तो कुछ बुद्धि,"
  },
  {
    "id": 17016,
    "book": "proverbs                                ",
    "chapter": "21",
    "verse": "31",
    "text": "युद्ध के दिन के लिये घोड़ा तैयार तो होता है,"
  }
]
