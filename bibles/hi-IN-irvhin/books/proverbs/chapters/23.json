[
  {
    "id": 17046,
    "book": "proverbs                                ",
    "chapter": "23",
    "verse": "1",
    "text": "जब तू किसी हाकिम के संग भोजन करने को बैठे,"
  },
  {
    "id": 17047,
    "book": "proverbs                                ",
    "chapter": "23",
    "verse": "2",
    "text": "और यदि तू अधिक खानेवाला हो,"
  },
  {
    "id": 17048,
    "book": "proverbs                                ",
    "chapter": "23",
    "verse": "3",
    "text": "उसकी स्वादिष्ट भोजनवस्तुओं की लालसा न करना,"
  },
  {
    "id": 17049,
    "book": "proverbs                                ",
    "chapter": "23",
    "verse": "4",
    "text": "धनी होने के लिये परिश्रम न करना;"
  },
  {
    "id": 17050,
    "book": "proverbs                                ",
    "chapter": "23",
    "verse": "5",
    "text": "जब तू अपनी दृष्टि धन पर लगाएगा,"
  },
  {
    "id": 17051,
    "book": "proverbs                                ",
    "chapter": "23",
    "verse": "6",
    "text": "जो डाह से देखता है, उसकी रोटी न खाना,"
  },
  {
    "id": 17052,
    "book": "proverbs                                ",
    "chapter": "23",
    "verse": "7",
    "text": "क्योंकि वह ऐसा व्यक्ति है,"
  },
  {
    "id": 17053,
    "book": "proverbs                                ",
    "chapter": "23",
    "verse": "8",
    "text": "जो कौर तूने खाया हो, उसे उगलना पड़ेगा,"
  },
  {
    "id": 17054,
    "book": "proverbs                                ",
    "chapter": "23",
    "verse": "9",
    "text": "मूर्ख के सामने न बोलना,"
  },
  {
    "id": 17055,
    "book": "proverbs                                ",
    "chapter": "23",
    "verse": "10",
    "text": "पुरानी सीमाओं को न बढ़ाना,"
  },
  {
    "id": 17056,
    "book": "proverbs                                ",
    "chapter": "23",
    "verse": "11",
    "text": "क्योंकि उनका छुड़ानेवाला सामर्थी है;"
  },
  {
    "id": 17057,
    "book": "proverbs                                ",
    "chapter": "23",
    "verse": "12",
    "text": "अपना हृदय शिक्षा की ओर,"
  },
  {
    "id": 17058,
    "book": "proverbs                                ",
    "chapter": "23",
    "verse": "13",
    "text": "लड़के की ताड़ना न छोड़ना23:13 लड़के की ताड़ना न छोड़ना: अर्थात् आपकी ताड़ना से आपके पुत्र की मृत्यु नहीं होगी परन्तु आपका उसको ताड़ना ना देना उसे बुराई की मृत्यु की ओर ले जायेगा। ;"
  },
  {
    "id": 17059,
    "book": "proverbs                                ",
    "chapter": "23",
    "verse": "14",
    "text": "तू उसको छड़ी से मारकर उसका प्राण अधोलोक से बचाएगा।"
  },
  {
    "id": 17060,
    "book": "proverbs                                ",
    "chapter": "23",
    "verse": "15",
    "text": "हे मेरे पुत्र, यदि तू बुद्धिमान हो,"
  },
  {
    "id": 17061,
    "book": "proverbs                                ",
    "chapter": "23",
    "verse": "16",
    "text": "और जब तू सीधी बातें बोले, तब मेरा मन प्रसन्न होगा।"
  },
  {
    "id": 17062,
    "book": "proverbs                                ",
    "chapter": "23",
    "verse": "17",
    "text": "तू पापियों के विषय मन में डाह न करना,"
  },
  {
    "id": 17063,
    "book": "proverbs                                ",
    "chapter": "23",
    "verse": "18",
    "text": "क्योंकि अन्त में फल होगा,"
  },
  {
    "id": 17064,
    "book": "proverbs                                ",
    "chapter": "23",
    "verse": "19",
    "text": "हे मेरे पुत्र, तू सुनकर बुद्धिमान हो,"
  },
  {
    "id": 17065,
    "book": "proverbs                                ",
    "chapter": "23",
    "verse": "20",
    "text": "दाखमधु के पीनेवालों में न होना,"
  },
  {
    "id": 17066,
    "book": "proverbs                                ",
    "chapter": "23",
    "verse": "21",
    "text": "क्योंकि पियक्कड़ और पेटू दरिद्र हो जाएँगे,"
  },
  {
    "id": 17067,
    "book": "proverbs                                ",
    "chapter": "23",
    "verse": "22",
    "text": "अपने जन्मानेवाले पिता की सुनना,"
  },
  {
    "id": 17068,
    "book": "proverbs                                ",
    "chapter": "23",
    "verse": "23",
    "text": "सच्चाई को मोल लेना, बेचना नहीं;"
  },
  {
    "id": 17069,
    "book": "proverbs                                ",
    "chapter": "23",
    "verse": "24",
    "text": "धर्मी का पिता बहुत मगन होता है;"
  },
  {
    "id": 17070,
    "book": "proverbs                                ",
    "chapter": "23",
    "verse": "25",
    "text": "तेरे कारण तेरे माता-पिता आनन्दित और तेरी जननी मगन हो।"
  },
  {
    "id": 17071,
    "book": "proverbs                                ",
    "chapter": "23",
    "verse": "26",
    "text": "हे मेरे पुत्र, अपना मन मेरी ओर लगा,"
  },
  {
    "id": 17072,
    "book": "proverbs                                ",
    "chapter": "23",
    "verse": "27",
    "text": "वेश्या गहरा गड्ढा ठहरती है;"
  },
  {
    "id": 17073,
    "book": "proverbs                                ",
    "chapter": "23",
    "verse": "28",
    "text": "वह डाकू के समान घात लगाती है,"
  },
  {
    "id": 17074,
    "book": "proverbs                                ",
    "chapter": "23",
    "verse": "29",
    "text": "कौन कहता है, हाय? कौन कहता है, हाय, हाय? कौन झगड़े-रगड़े में फँसता है?"
  },
  {
    "id": 17075,
    "book": "proverbs                                ",
    "chapter": "23",
    "verse": "30",
    "text": "उनकी जो दाखमधु देर तक पीते हैं,"
  },
  {
    "id": 17076,
    "book": "proverbs                                ",
    "chapter": "23",
    "verse": "31",
    "text": "जब दाखमधु लाल दिखाई देता है, और कटोरे में उसका सुन्दर रंग होता है,"
  },
  {
    "id": 17077,
    "book": "proverbs                                ",
    "chapter": "23",
    "verse": "32",
    "text": "क्योंकि अन्त में वह सर्प के समान डसता है,"
  },
  {
    "id": 17078,
    "book": "proverbs                                ",
    "chapter": "23",
    "verse": "33",
    "text": "तू विचित्र वस्तुएँ देखेगा,"
  },
  {
    "id": 17079,
    "book": "proverbs                                ",
    "chapter": "23",
    "verse": "34",
    "text": "और तू समुद्र के बीच लेटनेवाले"
  },
  {
    "id": 17080,
    "book": "proverbs                                ",
    "chapter": "23",
    "verse": "35",
    "text": "तू कहेगा कि मैंने मार तो खाई, परन्तु दुःखित न हुआ;"
  }
]
