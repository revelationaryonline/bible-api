[
  {
    "id": 15608,
    "book": "psalms                                  ",
    "chapter": "105",
    "verse": "1",
    "text": "यहोवा का धन्यवाद करो, उससे प्रार्थना करो,"
  },
  {
    "id": 15609,
    "book": "psalms                                  ",
    "chapter": "105",
    "verse": "2",
    "text": "उसके लिये गीत गाओ, उसके लिये भजन गाओ,"
  },
  {
    "id": 15610,
    "book": "psalms                                  ",
    "chapter": "105",
    "verse": "3",
    "text": "उसके पवित्र नाम की बड़ाई करो;"
  },
  {
    "id": 15611,
    "book": "psalms                                  ",
    "chapter": "105",
    "verse": "4",
    "text": "यहोवा और उसकी सामर्थ्य को खोजो,"
  },
  {
    "id": 15612,
    "book": "psalms                                  ",
    "chapter": "105",
    "verse": "5",
    "text": "उसके किए हुए आश्चर्यकर्मों को स्मरण करो,"
  },
  {
    "id": 15613,
    "book": "psalms                                  ",
    "chapter": "105",
    "verse": "6",
    "text": "हे उसके दास अब्राहम के वंश,"
  },
  {
    "id": 15614,
    "book": "psalms                                  ",
    "chapter": "105",
    "verse": "7",
    "text": "वही हमारा परमेश्वर यहोवा है;"
  },
  {
    "id": 15615,
    "book": "psalms                                  ",
    "chapter": "105",
    "verse": "8",
    "text": "वह अपनी वाचा को सदा स्मरण रखता आया है,"
  },
  {
    "id": 15616,
    "book": "psalms                                  ",
    "chapter": "105",
    "verse": "9",
    "text": "वही वाचा जो उसने अब्राहम के साथ बाँधी,"
  },
  {
    "id": 15617,
    "book": "psalms                                  ",
    "chapter": "105",
    "verse": "10",
    "text": "और उसी को उसने याकूब के लिये विधि करके,"
  },
  {
    "id": 15618,
    "book": "psalms                                  ",
    "chapter": "105",
    "verse": "11",
    "text": "“मैं कनान देश को तुझी को दूँगा, वह बाँट में तुम्हारा निज भाग होगा।”"
  },
  {
    "id": 15619,
    "book": "psalms                                  ",
    "chapter": "105",
    "verse": "12",
    "text": "उस समय तो वे गिनती में थोड़े थे, वरन् बहुत ही थोड़े,"
  },
  {
    "id": 15620,
    "book": "psalms                                  ",
    "chapter": "105",
    "verse": "13",
    "text": "वे एक जाति से दूसरी जाति में,"
  },
  {
    "id": 15621,
    "book": "psalms                                  ",
    "chapter": "105",
    "verse": "14",
    "text": "परन्तु उसने किसी मनुष्य को उन पर अत्याचार करने न दिया;"
  },
  {
    "id": 15622,
    "book": "psalms                                  ",
    "chapter": "105",
    "verse": "15",
    "text": "“मेरे अभिषिक्तों को मत छूओ105:15 मेरे अभिषिक्तों को मत छूओ: यहाँ अभिषिक्त शब्द का अर्थ है परमेश्वर ने उन्हें अपनी सेवा के लिए पृथक कर दिया है।,"
  },
  {
    "id": 15623,
    "book": "psalms                                  ",
    "chapter": "105",
    "verse": "16",
    "text": "फिर उसने उस देश में अकाल भेजा,"
  },
  {
    "id": 15624,
    "book": "psalms                                  ",
    "chapter": "105",
    "verse": "17",
    "text": "उसने यूसुफ नामक एक पुरुष को उनसे पहले भेजा था,"
  },
  {
    "id": 15625,
    "book": "psalms                                  ",
    "chapter": "105",
    "verse": "18",
    "text": "लोगों ने उसके पैरों में बेड़ियाँ डालकर उसे दुःख दिया;"
  },
  {
    "id": 15626,
    "book": "psalms                                  ",
    "chapter": "105",
    "verse": "19",
    "text": "जब तक कि उसकी बात पूरी न हुई"
  },
  {
    "id": 15627,
    "book": "psalms                                  ",
    "chapter": "105",
    "verse": "20",
    "text": "तब राजा ने दूत भेजकर उसे निकलवा लिया,"
  },
  {
    "id": 15628,
    "book": "psalms                                  ",
    "chapter": "105",
    "verse": "21",
    "text": "उसने उसको अपने भवन का प्रधान"
  },
  {
    "id": 15629,
    "book": "psalms                                  ",
    "chapter": "105",
    "verse": "22",
    "text": "कि वह उसके हाकिमों को अपनी इच्छा के अनुसार नियंत्रित करे"
  },
  {
    "id": 15630,
    "book": "psalms                                  ",
    "chapter": "105",
    "verse": "23",
    "text": "फिर इस्राएल मिस्र में आया;"
  },
  {
    "id": 15631,
    "book": "psalms                                  ",
    "chapter": "105",
    "verse": "24",
    "text": "तब उसने अपनी प्रजा को गिनती में बहुत बढ़ाया,"
  },
  {
    "id": 15632,
    "book": "psalms                                  ",
    "chapter": "105",
    "verse": "25",
    "text": "उसने मिस्रियों के मन को ऐसा फेर दिया,"
  },
  {
    "id": 15633,
    "book": "psalms                                  ",
    "chapter": "105",
    "verse": "26",
    "text": "उसने अपने दास मूसा को,"
  },
  {
    "id": 15634,
    "book": "psalms                                  ",
    "chapter": "105",
    "verse": "27",
    "text": "उन्होंने मिस्रियों के बीच उसकी ओर से भाँति-भाँति के चिन्ह,"
  },
  {
    "id": 15635,
    "book": "psalms                                  ",
    "chapter": "105",
    "verse": "28",
    "text": "उसने अंधकार कर दिया, और अंधियारा हो गया;"
  },
  {
    "id": 15636,
    "book": "psalms                                  ",
    "chapter": "105",
    "verse": "29",
    "text": "उसने मिस्रियों के जल को लहू कर डाला,"
  },
  {
    "id": 15637,
    "book": "psalms                                  ",
    "chapter": "105",
    "verse": "30",
    "text": "मेंढ़क उनकी भूमि में वरन् उनके राजा की कोठरियों में भी भर गए।"
  },
  {
    "id": 15638,
    "book": "psalms                                  ",
    "chapter": "105",
    "verse": "31",
    "text": "उसने आज्ञा दी, तब डांस आ गए,"
  },
  {
    "id": 15639,
    "book": "psalms                                  ",
    "chapter": "105",
    "verse": "32",
    "text": "उसने उनके लिये जलवृष्टि के बदले ओले,"
  },
  {
    "id": 15640,
    "book": "psalms                                  ",
    "chapter": "105",
    "verse": "33",
    "text": "और उसने उनकी दाखलताओं और अंजीर के वृक्षों को"
  },
  {
    "id": 15641,
    "book": "psalms                                  ",
    "chapter": "105",
    "verse": "34",
    "text": "उसने आज्ञा दी तब अनगिनत टिड्डियाँ, और कीड़े आए,"
  },
  {
    "id": 15642,
    "book": "psalms                                  ",
    "chapter": "105",
    "verse": "35",
    "text": "और उन्होंने उनके देश के सब अन्न आदि को खा डाला;"
  },
  {
    "id": 15643,
    "book": "psalms                                  ",
    "chapter": "105",
    "verse": "36",
    "text": "उसने उनके देश के सब पहिलौठों को,"
  },
  {
    "id": 15644,
    "book": "psalms                                  ",
    "chapter": "105",
    "verse": "37",
    "text": "तब वह इस्राएल को सोना चाँदी दिलाकर निकाल लाया,"
  },
  {
    "id": 15645,
    "book": "psalms                                  ",
    "chapter": "105",
    "verse": "38",
    "text": "उनके जाने से मिस्री आनन्दित हुए,"
  },
  {
    "id": 15646,
    "book": "psalms                                  ",
    "chapter": "105",
    "verse": "39",
    "text": "उसने छाया के लिये बादल फैलाया,"
  },
  {
    "id": 15647,
    "book": "psalms                                  ",
    "chapter": "105",
    "verse": "40",
    "text": "उन्होंने माँगा तब उसने बटेरें पहुँचाई,"
  },
  {
    "id": 15648,
    "book": "psalms                                  ",
    "chapter": "105",
    "verse": "41",
    "text": "उसने चट्टान फाड़ी तब पानी बह निकला;"
  },
  {
    "id": 15649,
    "book": "psalms                                  ",
    "chapter": "105",
    "verse": "42",
    "text": "क्योंकि उसने अपने पवित्र वचन 105:42 क्योंकि उसने अपने पवित्र वचन: अब्राहम से की गई प्रतिज्ञा विश्वासयोग्य है और उसने अब्राहम के वंशजों को आवश्यकता के समय स्मरण रखा है।"
  },
  {
    "id": 15650,
    "book": "psalms                                  ",
    "chapter": "105",
    "verse": "43",
    "text": "वह अपनी प्रजा को हर्षित करके"
  },
  {
    "id": 15651,
    "book": "psalms                                  ",
    "chapter": "105",
    "verse": "44",
    "text": "और उनको जाति-जाति के देश दिए;"
  },
  {
    "id": 15652,
    "book": "psalms                                  ",
    "chapter": "105",
    "verse": "45",
    "text": "कि वे उसकी विधियों को मानें,"
  }
]
