[
  {
    "id": 14978,
    "book": "psalms                                  ",
    "chapter": "71",
    "verse": "1",
    "text": "हे यहोवा, मैं तेरा शरणागत हूँ;"
  },
  {
    "id": 14979,
    "book": "psalms                                  ",
    "chapter": "71",
    "verse": "2",
    "text": "तू तो धर्मी है, मुझे छुड़ा और मेरा उद्धार कर;"
  },
  {
    "id": 14980,
    "book": "psalms                                  ",
    "chapter": "71",
    "verse": "3",
    "text": "मेरे लिये सनातन काल की चट्टान का धाम बन, जिसमें मैं नित्य जा सकूँ;"
  },
  {
    "id": 14981,
    "book": "psalms                                  ",
    "chapter": "71",
    "verse": "4",
    "text": "हे मेरे परमेश्वर, दुष्ट के"
  },
  {
    "id": 14982,
    "book": "psalms                                  ",
    "chapter": "71",
    "verse": "5",
    "text": "क्योंकि हे प्रभु यहोवा, मैं तेरी ही बाट जोहता आया हूँ;"
  },
  {
    "id": 14983,
    "book": "psalms                                  ",
    "chapter": "71",
    "verse": "6",
    "text": "मैं गर्भ से निकलते ही, तेरे द्वारा सम्भाला गया;"
  },
  {
    "id": 14984,
    "book": "psalms                                  ",
    "chapter": "71",
    "verse": "7",
    "text": "मैं बहुतों के लिये चमत्कार बना हूँ;"
  },
  {
    "id": 14985,
    "book": "psalms                                  ",
    "chapter": "71",
    "verse": "8",
    "text": "मेरे मुँह से तेरे गुणानुवाद,"
  },
  {
    "id": 14986,
    "book": "psalms                                  ",
    "chapter": "71",
    "verse": "9",
    "text": "बुढ़ापे के समय मेरा त्याग न कर;"
  },
  {
    "id": 14987,
    "book": "psalms                                  ",
    "chapter": "71",
    "verse": "10",
    "text": "क्योंकि मेरे शत्रु मेरे विषय बातें करते हैं,"
  },
  {
    "id": 14988,
    "book": "psalms                                  ",
    "chapter": "71",
    "verse": "11",
    "text": "परमेश्वर ने उसको छोड़ दिया है;"
  },
  {
    "id": 14989,
    "book": "psalms                                  ",
    "chapter": "71",
    "verse": "12",
    "text": "हे परमेश्वर, मुझसे दूर न रह;"
  },
  {
    "id": 14990,
    "book": "psalms                                  ",
    "chapter": "71",
    "verse": "13",
    "text": "जो मेरे प्राण के विरोधी हैं, वे लज्जित हो"
  },
  {
    "id": 14991,
    "book": "psalms                                  ",
    "chapter": "71",
    "verse": "14",
    "text": "मैं तो निरन्तर आशा लगाए रहूँगा,"
  },
  {
    "id": 14992,
    "book": "psalms                                  ",
    "chapter": "71",
    "verse": "15",
    "text": "मैं अपने मुँह से तेरी धार्मिकता का,"
  },
  {
    "id": 14993,
    "book": "psalms                                  ",
    "chapter": "71",
    "verse": "16",
    "text": "मैं प्रभु यहोवा के पराक्रम के कामों का वर्णन करता हुआ आऊँगा,"
  },
  {
    "id": 14994,
    "book": "psalms                                  ",
    "chapter": "71",
    "verse": "17",
    "text": "हे परमेश्वर, तू तो मुझ को बचपन ही से सिखाता आया है,"
  },
  {
    "id": 14995,
    "book": "psalms                                  ",
    "chapter": "71",
    "verse": "18",
    "text": "इसलिए हे परमेश्वर जब मैं बूढ़ा हो जाऊँ"
  },
  {
    "id": 14996,
    "book": "psalms                                  ",
    "chapter": "71",
    "verse": "19",
    "text": "हे परमेश्वर, तेरी धार्मिकता अति महान है।"
  },
  {
    "id": 14997,
    "book": "psalms                                  ",
    "chapter": "71",
    "verse": "20",
    "text": "तूने तो हमको बहुत से कठिन कष्ट दिखाए हैं"
  },
  {
    "id": 14998,
    "book": "psalms                                  ",
    "chapter": "71",
    "verse": "21",
    "text": "तू मेरे सम्मान को बढ़ाएगा71:21 तू मेरे सम्मान को बढ़ाएगा: परमेश्वर मुझे पूर्व स्थिति ही में नहीं लाएगा, वह मेरे आनन्द को भी बढ़ाएगा और मेरे लिए और भी बड़े काम करेगा।,"
  },
  {
    "id": 14999,
    "book": "psalms                                  ",
    "chapter": "71",
    "verse": "22",
    "text": "हे मेरे परमेश्वर,"
  },
  {
    "id": 15000,
    "book": "psalms                                  ",
    "chapter": "71",
    "verse": "23",
    "text": "जब मैं तेरा भजन गाऊँगा, तब अपने मुँह से"
  },
  {
    "id": 15001,
    "book": "psalms                                  ",
    "chapter": "71",
    "verse": "24",
    "text": "और मैं तेरे धार्मिकता की चर्चा दिन भर करता रहूँगा;"
  }
]
