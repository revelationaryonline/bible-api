[
  {
    "id": 15551,
    "book": "psalms                                  ",
    "chapter": "103",
    "verse": "1",
    "text": "हे मेरे मन, यहोवा को धन्य कह;"
  },
  {
    "id": 15552,
    "book": "psalms                                  ",
    "chapter": "103",
    "verse": "2",
    "text": "हे मेरे मन, यहोवा को धन्य कह,"
  },
  {
    "id": 15553,
    "book": "psalms                                  ",
    "chapter": "103",
    "verse": "3",
    "text": "वही तो तेरे सब अधर्म को क्षमा करता,"
  },
  {
    "id": 15554,
    "book": "psalms                                  ",
    "chapter": "103",
    "verse": "4",
    "text": "वही तो तेरे प्राण को नाश होने से बचा लेता है103:4 वही तो तेरे प्राण को नाश होने से बचा लेता है: संकट में मृत्यु से बचा लेता है या रोग के कारण मरने से बचाता है।,"
  },
  {
    "id": 15555,
    "book": "psalms                                  ",
    "chapter": "103",
    "verse": "5",
    "text": "वही तो तेरी लालसा को उत्तम पदार्थों से तृप्त करता है,"
  },
  {
    "id": 15556,
    "book": "psalms                                  ",
    "chapter": "103",
    "verse": "6",
    "text": "यहोवा सब पिसे हुओं के लिये"
  },
  {
    "id": 15557,
    "book": "psalms                                  ",
    "chapter": "103",
    "verse": "7",
    "text": "उसने मूसा को अपनी गति,"
  },
  {
    "id": 15558,
    "book": "psalms                                  ",
    "chapter": "103",
    "verse": "8",
    "text": "यहोवा दयालु और अनुग्रहकारी, विलम्ब से कोप करनेवाला और अति करुणामय है (भज. 86:15, भज. 145:8)"
  },
  {
    "id": 15559,
    "book": "psalms                                  ",
    "chapter": "103",
    "verse": "9",
    "text": "वह सर्वदा वाद-विवाद करता न रहेगा103:9 वह सर्वदा वाद-विवाद करता न रहेगा: झिड़केगा, विरोध करेगा, संघर्ष करेगा। वह मनुष्यों से सदैव संघर्ष नहीं करेगा, अप्रसन्न नहीं होगा। ,"
  },
  {
    "id": 15560,
    "book": "psalms                                  ",
    "chapter": "103",
    "verse": "10",
    "text": "उसने हमारे पापों के अनुसार हम से व्यवहार नहीं किया,"
  },
  {
    "id": 15561,
    "book": "psalms                                  ",
    "chapter": "103",
    "verse": "11",
    "text": "जैसे आकाश पृथ्वी के ऊपर ऊँचा है,"
  },
  {
    "id": 15562,
    "book": "psalms                                  ",
    "chapter": "103",
    "verse": "12",
    "text": "उदयाचल अस्ताचल से जितनी दूर है,"
  },
  {
    "id": 15563,
    "book": "psalms                                  ",
    "chapter": "103",
    "verse": "13",
    "text": "जैसे पिता अपने बालकों पर दया करता है,"
  },
  {
    "id": 15564,
    "book": "psalms                                  ",
    "chapter": "103",
    "verse": "14",
    "text": "क्योंकि वह हमारी सृष्टि जानता है;"
  },
  {
    "id": 15565,
    "book": "psalms                                  ",
    "chapter": "103",
    "verse": "15",
    "text": "मनुष्य की आयु घास के समान होती है,"
  },
  {
    "id": 15566,
    "book": "psalms                                  ",
    "chapter": "103",
    "verse": "16",
    "text": "जो पवन लगते ही ठहर नहीं सकता,"
  },
  {
    "id": 15567,
    "book": "psalms                                  ",
    "chapter": "103",
    "verse": "17",
    "text": "परन्तु यहोवा की करुणा उसके डरवैयों पर युग-युग,"
  },
  {
    "id": 15568,
    "book": "psalms                                  ",
    "chapter": "103",
    "verse": "18",
    "text": "अर्थात् उन पर जो उसकी वाचा का पालन करते"
  },
  {
    "id": 15569,
    "book": "psalms                                  ",
    "chapter": "103",
    "verse": "19",
    "text": "यहोवा ने तो अपना सिंहासन स्वर्ग में स्थिर किया है,"
  },
  {
    "id": 15570,
    "book": "psalms                                  ",
    "chapter": "103",
    "verse": "20",
    "text": "हे यहोवा के दूतों, तुम जो बड़े वीर हो,"
  },
  {
    "id": 15571,
    "book": "psalms                                  ",
    "chapter": "103",
    "verse": "21",
    "text": "हे यहोवा की सारी सेनाओं, हे उसके सेवकों,"
  },
  {
    "id": 15572,
    "book": "psalms                                  ",
    "chapter": "103",
    "verse": "22",
    "text": "हे यहोवा की सारी सृष्टि,"
  }
]
