[
  {
    "id": 16343,
    "book": "psalms                                  ",
    "chapter": "146",
    "verse": "1",
    "text": "यहोवा की स्तुति करो।"
  },
  {
    "id": 16344,
    "book": "psalms                                  ",
    "chapter": "146",
    "verse": "2",
    "text": "मैं जीवन भर यहोवा की स्तुति करता रहूँगा;"
  },
  {
    "id": 16345,
    "book": "psalms                                  ",
    "chapter": "146",
    "verse": "3",
    "text": "तुम प्रधानों पर भरोसा न रखना,"
  },
  {
    "id": 16346,
    "book": "psalms                                  ",
    "chapter": "146",
    "verse": "4",
    "text": "उसका भी प्राण निकलेगा, वह भी मिट्टी में मिल जाएगा;"
  },
  {
    "id": 16347,
    "book": "psalms                                  ",
    "chapter": "146",
    "verse": "5",
    "text": "क्या ही धन्य वह है,"
  },
  {
    "id": 16348,
    "book": "psalms                                  ",
    "chapter": "146",
    "verse": "6",
    "text": "वह आकाश और पृथ्वी और समुद्र"
  },
  {
    "id": 16349,
    "book": "psalms                                  ",
    "chapter": "146",
    "verse": "7",
    "text": "वह पिसे हुओं का न्याय चुकाता है;"
  },
  {
    "id": 16350,
    "book": "psalms                                  ",
    "chapter": "146",
    "verse": "8",
    "text": "यहोवा अंधों को आँखें देता है।"
  },
  {
    "id": 16351,
    "book": "psalms                                  ",
    "chapter": "146",
    "verse": "9",
    "text": "यहोवा परदेशियों की रक्षा करता है;"
  },
  {
    "id": 16352,
    "book": "psalms                                  ",
    "chapter": "146",
    "verse": "10",
    "text": "हे सिय्योन, यहोवा सदा के लिये,"
  }
]
