[
  {
    "id": 14452,
    "book": "psalms                                  ",
    "chapter": "37",
    "verse": "1",
    "text": "कुकर्मियों के कारण मत कुढ़,"
  },
  {
    "id": 14453,
    "book": "psalms                                  ",
    "chapter": "37",
    "verse": "2",
    "text": "क्योंकि वे घास के समान झट कट जाएँगे,"
  },
  {
    "id": 14454,
    "book": "psalms                                  ",
    "chapter": "37",
    "verse": "3",
    "text": "यहोवा पर भरोसा रख,"
  },
  {
    "id": 14455,
    "book": "psalms                                  ",
    "chapter": "37",
    "verse": "4",
    "text": "यहोवा को अपने सुख का मूल जान,"
  },
  {
    "id": 14456,
    "book": "psalms                                  ",
    "chapter": "37",
    "verse": "5",
    "text": "अपने मार्ग की चिन्ता यहोवा पर छोड़37:5 अपने मार्ग की चिन्ता यहोवा पर छोड़: यहाँ विचार ऐसा है कि भारी बोझ को अपने ऊपर से लुढ़काकर दूसरे पर कर दें या परमेश्वर पर डाल दें, वह उठा लेगा।;"
  },
  {
    "id": 14457,
    "book": "psalms                                  ",
    "chapter": "37",
    "verse": "6",
    "text": "और वह तेरा धर्म ज्योति के समान,"
  },
  {
    "id": 14458,
    "book": "psalms                                  ",
    "chapter": "37",
    "verse": "7",
    "text": "यहोवा के सामने चुपचाप रह,"
  },
  {
    "id": 14459,
    "book": "psalms                                  ",
    "chapter": "37",
    "verse": "8",
    "text": "क्रोध से परे रह,"
  },
  {
    "id": 14460,
    "book": "psalms                                  ",
    "chapter": "37",
    "verse": "9",
    "text": "क्योंकि कुकर्मी लोग काट डाले जाएँगे;"
  },
  {
    "id": 14461,
    "book": "psalms                                  ",
    "chapter": "37",
    "verse": "10",
    "text": "थोड़े दिन के बीतने पर दुष्ट रहेगा ही नहीं;"
  },
  {
    "id": 14462,
    "book": "psalms                                  ",
    "chapter": "37",
    "verse": "11",
    "text": "परन्तु नम्र लोग पृथ्वी के अधिकारी होंगे,"
  },
  {
    "id": 14463,
    "book": "psalms                                  ",
    "chapter": "37",
    "verse": "12",
    "text": "दुष्ट धर्मी के विरुद्ध बुरी युक्ति निकालता है,"
  },
  {
    "id": 14464,
    "book": "psalms                                  ",
    "chapter": "37",
    "verse": "13",
    "text": "परन्तु प्रभु उस पर हँसेगा,"
  },
  {
    "id": 14465,
    "book": "psalms                                  ",
    "chapter": "37",
    "verse": "14",
    "text": "दुष्ट लोग तलवार खींचे"
  },
  {
    "id": 14466,
    "book": "psalms                                  ",
    "chapter": "37",
    "verse": "15",
    "text": "उनकी तलवारों से उन्हीं के हृदय छिदेंगे,"
  },
  {
    "id": 14467,
    "book": "psalms                                  ",
    "chapter": "37",
    "verse": "16",
    "text": "धर्मी का थोड़ा सा धन दुष्टों के"
  },
  {
    "id": 14468,
    "book": "psalms                                  ",
    "chapter": "37",
    "verse": "17",
    "text": "क्योंकि दुष्टों की भुजाएँ तो तोड़ी जाएँगी;"
  },
  {
    "id": 14469,
    "book": "psalms                                  ",
    "chapter": "37",
    "verse": "18",
    "text": "यहोवा खरे लोगों की आयु की सुधि रखता है,"
  },
  {
    "id": 14470,
    "book": "psalms                                  ",
    "chapter": "37",
    "verse": "19",
    "text": "विपत्ति के समय, वे लज्जित न होंगे,"
  },
  {
    "id": 14471,
    "book": "psalms                                  ",
    "chapter": "37",
    "verse": "20",
    "text": "दुष्ट लोग नाश हो जाएँगे;"
  },
  {
    "id": 14472,
    "book": "psalms                                  ",
    "chapter": "37",
    "verse": "21",
    "text": "दुष्ट ऋण लेता है,"
  },
  {
    "id": 14473,
    "book": "psalms                                  ",
    "chapter": "37",
    "verse": "22",
    "text": "क्योंकि जो उससे आशीष पाते हैं"
  },
  {
    "id": 14474,
    "book": "psalms                                  ",
    "chapter": "37",
    "verse": "23",
    "text": "मनुष्य की गति यहोवा की"
  },
  {
    "id": 14475,
    "book": "psalms                                  ",
    "chapter": "37",
    "verse": "24",
    "text": "चाहे वह गिरे तो भी पड़ा न रह जाएगा,"
  },
  {
    "id": 14476,
    "book": "psalms                                  ",
    "chapter": "37",
    "verse": "25",
    "text": "मैं लड़कपन से लेकर बुढ़ापे"
  },
  {
    "id": 14477,
    "book": "psalms                                  ",
    "chapter": "37",
    "verse": "26",
    "text": "वह तो दिन भर अनुग्रह कर करके ऋण देता है,"
  },
  {
    "id": 14478,
    "book": "psalms                                  ",
    "chapter": "37",
    "verse": "27",
    "text": "बुराई को छोड़ भलाई कर;"
  },
  {
    "id": 14479,
    "book": "psalms                                  ",
    "chapter": "37",
    "verse": "28",
    "text": "क्योंकि यहोवा न्याय से प्रीति रखता;"
  },
  {
    "id": 14480,
    "book": "psalms                                  ",
    "chapter": "37",
    "verse": "29",
    "text": "धर्मी लोग पृथ्वी के अधिकारी होंगे,"
  },
  {
    "id": 14481,
    "book": "psalms                                  ",
    "chapter": "37",
    "verse": "30",
    "text": "धर्मी अपने मुँह से बुद्धि की बातें करता,"
  },
  {
    "id": 14482,
    "book": "psalms                                  ",
    "chapter": "37",
    "verse": "31",
    "text": "उसके परमेश्वर की व्यवस्था उसके"
  },
  {
    "id": 14483,
    "book": "psalms                                  ",
    "chapter": "37",
    "verse": "32",
    "text": "दुष्ट धर्मी की ताक में रहता है।"
  },
  {
    "id": 14484,
    "book": "psalms                                  ",
    "chapter": "37",
    "verse": "33",
    "text": "यहोवा उसको उसके हाथ में न छोड़ेगा,"
  },
  {
    "id": 14485,
    "book": "psalms                                  ",
    "chapter": "37",
    "verse": "34",
    "text": "यहोवा की बाट जोहता रह,"
  },
  {
    "id": 14486,
    "book": "psalms                                  ",
    "chapter": "37",
    "verse": "35",
    "text": "मैंने दुष्ट को बड़ा पराक्रमी"
  },
  {
    "id": 14487,
    "book": "psalms                                  ",
    "chapter": "37",
    "verse": "36",
    "text": "परन्तु जब कोई उधर से गया तो"
  },
  {
    "id": 14488,
    "book": "psalms                                  ",
    "chapter": "37",
    "verse": "37",
    "text": "खरे मनुष्य पर दृष्टि कर"
  },
  {
    "id": 14489,
    "book": "psalms                                  ",
    "chapter": "37",
    "verse": "38",
    "text": "परन्तु अपराधी एक साथ सत्यानाश किए जाएँगे;"
  },
  {
    "id": 14490,
    "book": "psalms                                  ",
    "chapter": "37",
    "verse": "39",
    "text": "धर्मियों की मुक्ति यहोवा की"
  },
  {
    "id": 14491,
    "book": "psalms                                  ",
    "chapter": "37",
    "verse": "40",
    "text": "यहोवा उनकी सहायता करके उनको बचाता है;"
  }
]
