[
  {
    "id": 14068,
    "book": "psalms                                  ",
    "chapter": "12",
    "verse": "1",
    "text": "हे यहोवा बचा ले, क्योंकि एक भी भक्त नहीं रहा;"
  },
  {
    "id": 14069,
    "book": "psalms                                  ",
    "chapter": "12",
    "verse": "2",
    "text": "प्रत्येक मनुष्य अपने पड़ोसी से झूठी बातें कहता है;"
  },
  {
    "id": 14070,
    "book": "psalms                                  ",
    "chapter": "12",
    "verse": "3",
    "text": "यहोवा सब चापलूस होठों को"
  },
  {
    "id": 14071,
    "book": "psalms                                  ",
    "chapter": "12",
    "verse": "4",
    "text": "वे कहते हैं, “हम अपनी जीभ ही से जीतेंगे,"
  },
  {
    "id": 14072,
    "book": "psalms                                  ",
    "chapter": "12",
    "verse": "5",
    "text": "दीन लोगों के लुट जाने, और दरिद्रों के कराहने के कारण,"
  },
  {
    "id": 14073,
    "book": "psalms                                  ",
    "chapter": "12",
    "verse": "6",
    "text": "यहोवा का वचन पवित्र है,"
  },
  {
    "id": 14074,
    "book": "psalms                                  ",
    "chapter": "12",
    "verse": "7",
    "text": "तू ही हे यहोवा उनकी रक्षा करेगा,"
  },
  {
    "id": 14075,
    "book": "psalms                                  ",
    "chapter": "12",
    "verse": "8",
    "text": "जब मनुष्यों में बुराई का आदर होता है,"
  }
]
