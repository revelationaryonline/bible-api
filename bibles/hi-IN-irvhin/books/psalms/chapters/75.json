[
  {
    "id": 15073,
    "book": "psalms                                  ",
    "chapter": "75",
    "verse": "1",
    "text": "हे परमेश्वर हम तेरा धन्यवाद करते, हम तेरा नाम धन्यवाद करते हैं;"
  },
  {
    "id": 15074,
    "book": "psalms                                  ",
    "chapter": "75",
    "verse": "2",
    "text": "जब ठीक समय आएगा"
  },
  {
    "id": 15075,
    "book": "psalms                                  ",
    "chapter": "75",
    "verse": "3",
    "text": "जब पृथ्वी अपने सब रहनेवालों समेत डोल रही है,"
  },
  {
    "id": 15076,
    "book": "psalms                                  ",
    "chapter": "75",
    "verse": "4",
    "text": "मैंने घमण्डियों से कहा, “घमण्ड मत करो,”"
  },
  {
    "id": 15077,
    "book": "psalms                                  ",
    "chapter": "75",
    "verse": "5",
    "text": "अपना सींग बहुत ऊँचा मत करो,"
  },
  {
    "id": 15078,
    "book": "psalms                                  ",
    "chapter": "75",
    "verse": "6",
    "text": "क्योंकि बढ़ती न तो पूरब से न पश्चिम से,"
  },
  {
    "id": 15079,
    "book": "psalms                                  ",
    "chapter": "75",
    "verse": "7",
    "text": "परन्तु परमेश्वर ही न्यायी है,"
  },
  {
    "id": 15080,
    "book": "psalms                                  ",
    "chapter": "75",
    "verse": "8",
    "text": "यहोवा के हाथ में एक कटोरा है, जिसमें का दाखमधु झागवाला है;"
  },
  {
    "id": 15081,
    "book": "psalms                                  ",
    "chapter": "75",
    "verse": "9",
    "text": "परन्तु मैं तो सदा प्रचार करता रहूँगा,"
  },
  {
    "id": 15082,
    "book": "psalms                                  ",
    "chapter": "75",
    "verse": "10",
    "text": "दुष्टों के सब सींगों को मैं काट डालूँगा,"
  }
]
