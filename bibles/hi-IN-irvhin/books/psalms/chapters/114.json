[
  {
    "id": 15824,
    "book": "psalms                                  ",
    "chapter": "114",
    "verse": "1",
    "text": "जब इस्राएल ने मिस्र से, अर्थात् याकूब के घराने ने अन्य भाषावालों के मध्य से कूच किया,"
  },
  {
    "id": 15825,
    "book": "psalms                                  ",
    "chapter": "114",
    "verse": "2",
    "text": "तब यहूदा यहोवा का पवित्रस्थान"
  },
  {
    "id": 15826,
    "book": "psalms                                  ",
    "chapter": "114",
    "verse": "3",
    "text": "समुद्र देखकर भागा,"
  },
  {
    "id": 15827,
    "book": "psalms                                  ",
    "chapter": "114",
    "verse": "4",
    "text": "पहाड़ मेढ़ों के समान उछलने लगे,"
  },
  {
    "id": 15828,
    "book": "psalms                                  ",
    "chapter": "114",
    "verse": "5",
    "text": "हे समुद्र, तुझे क्या हुआ, कि तू भागा?"
  },
  {
    "id": 15829,
    "book": "psalms                                  ",
    "chapter": "114",
    "verse": "6",
    "text": "हे पहाड़ों, तुम्हें क्या हुआ, कि तुम भेड़ों के समान,"
  },
  {
    "id": 15830,
    "book": "psalms                                  ",
    "chapter": "114",
    "verse": "7",
    "text": "हे पृथ्वी प्रभु के सामने,"
  },
  {
    "id": 15831,
    "book": "psalms                                  ",
    "chapter": "114",
    "verse": "8",
    "text": "वह चट्टान को जल का ताल,"
  }
]
