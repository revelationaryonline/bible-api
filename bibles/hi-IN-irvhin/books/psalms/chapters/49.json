[
  {
    "id": 14650,
    "book": "psalms                                  ",
    "chapter": "49",
    "verse": "1",
    "text": "हे देश-देश के सब लोगों यह सुनो!"
  },
  {
    "id": 14651,
    "book": "psalms                                  ",
    "chapter": "49",
    "verse": "2",
    "text": "क्या ऊँच, क्या नीच"
  },
  {
    "id": 14652,
    "book": "psalms                                  ",
    "chapter": "49",
    "verse": "3",
    "text": "मेरे मुँह से बुद्धि की बातें निकलेंगी;"
  },
  {
    "id": 14653,
    "book": "psalms                                  ",
    "chapter": "49",
    "verse": "4",
    "text": "मैं नीतिवचन की ओर अपना कान लगाऊँगा,"
  },
  {
    "id": 14654,
    "book": "psalms                                  ",
    "chapter": "49",
    "verse": "5",
    "text": "विपत्ति के दिनों में मैं क्यों डरूँ जब अधर्म मुझे आ घेरे?"
  },
  {
    "id": 14655,
    "book": "psalms                                  ",
    "chapter": "49",
    "verse": "6",
    "text": "जो अपनी सम्पत्ति पर भरोसा रखते,"
  },
  {
    "id": 14656,
    "book": "psalms                                  ",
    "chapter": "49",
    "verse": "7",
    "text": "उनमें से कोई अपने भाई को किसी भाँति"
  },
  {
    "id": 14657,
    "book": "psalms                                  ",
    "chapter": "49",
    "verse": "8",
    "text": "क्योंकि उनके प्राण की छुड़ौती भारी है"
  },
  {
    "id": 14658,
    "book": "psalms                                  ",
    "chapter": "49",
    "verse": "9",
    "text": "कोई ऐसा नहीं जो सदैव जीवित रहे,"
  },
  {
    "id": 14659,
    "book": "psalms                                  ",
    "chapter": "49",
    "verse": "10",
    "text": "क्योंकि देखने में आता है कि बुद्धिमान भी मरते हैं,"
  },
  {
    "id": 14660,
    "book": "psalms                                  ",
    "chapter": "49",
    "verse": "11",
    "text": "वे मन ही मन यह सोचते हैं, कि उनका घर"
  },
  {
    "id": 14661,
    "book": "psalms                                  ",
    "chapter": "49",
    "verse": "12",
    "text": "परन्तु मनुष्य प्रतिष्ठा पाकर भी स्थिर नहीं रहता,"
  },
  {
    "id": 14662,
    "book": "psalms                                  ",
    "chapter": "49",
    "verse": "13",
    "text": "उनकी यह चाल उनकी मूर्खता है,"
  },
  {
    "id": 14663,
    "book": "psalms                                  ",
    "chapter": "49",
    "verse": "14",
    "text": "वे अधोलोक की मानो भेड़ों का झुण्ड ठहराए गए हैं;"
  },
  {
    "id": 14664,
    "book": "psalms                                  ",
    "chapter": "49",
    "verse": "15",
    "text": "परन्तु परमेश्वर मेरे प्राण को अधोलोक के"
  },
  {
    "id": 14665,
    "book": "psalms                                  ",
    "chapter": "49",
    "verse": "16",
    "text": "जब कोई धनी हो जाए और उसके घर का"
  },
  {
    "id": 14666,
    "book": "psalms                                  ",
    "chapter": "49",
    "verse": "17",
    "text": "क्योंकि वह मरकर कुछ भी साथ न ले जाएगा;"
  },
  {
    "id": 14667,
    "book": "psalms                                  ",
    "chapter": "49",
    "verse": "18",
    "text": "चाहे वह जीते जी अपने आपको धन्य कहता रहे।"
  },
  {
    "id": 14668,
    "book": "psalms                                  ",
    "chapter": "49",
    "verse": "19",
    "text": "तो भी वह अपने पुरखाओं के समाज में मिलाया जाएगा,"
  },
  {
    "id": 14669,
    "book": "psalms                                  ",
    "chapter": "49",
    "verse": "20",
    "text": "मनुष्य चाहे प्रतिष्ठित भी हों परन्तु यदि वे"
  }
]
