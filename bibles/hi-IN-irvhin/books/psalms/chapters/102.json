[
  {
    "id": 15523,
    "book": "psalms                                  ",
    "chapter": "102",
    "verse": "1",
    "text": "हे यहोवा, मेरी प्रार्थना सुन;"
  },
  {
    "id": 15524,
    "book": "psalms                                  ",
    "chapter": "102",
    "verse": "2",
    "text": "मेरे संकट के दिन अपना मुख मुझसे न छिपा ले;"
  },
  {
    "id": 15525,
    "book": "psalms                                  ",
    "chapter": "102",
    "verse": "3",
    "text": "क्योंकि मेरे दिन धुएँ के समान उड़े जाते हैं,"
  },
  {
    "id": 15526,
    "book": "psalms                                  ",
    "chapter": "102",
    "verse": "4",
    "text": "मेरा मन झुलसी हुई घास के समान सूख गया है;"
  },
  {
    "id": 15527,
    "book": "psalms                                  ",
    "chapter": "102",
    "verse": "5",
    "text": "कराहते-कराहते मेरी चमड़ी हड्डियों में सट गई है।"
  },
  {
    "id": 15528,
    "book": "psalms                                  ",
    "chapter": "102",
    "verse": "6",
    "text": "मैं जंगल के धनेश के समान हो गया हूँ,"
  },
  {
    "id": 15529,
    "book": "psalms                                  ",
    "chapter": "102",
    "verse": "7",
    "text": "मैं पड़ा-पड़ा जागता रहता हूँ और गौरे के समान हो गया हूँ"
  },
  {
    "id": 15530,
    "book": "psalms                                  ",
    "chapter": "102",
    "verse": "8",
    "text": "मेरे शत्रु लगातार मेरी नामधराई करते हैं,"
  },
  {
    "id": 15531,
    "book": "psalms                                  ",
    "chapter": "102",
    "verse": "9",
    "text": "क्योंकि मैंने रोटी के समान राख खाई और आँसू मिलाकर पानी पीता हूँ।"
  },
  {
    "id": 15532,
    "book": "psalms                                  ",
    "chapter": "102",
    "verse": "10",
    "text": "यह तेरे क्रोध और कोप के कारण हुआ है,"
  },
  {
    "id": 15533,
    "book": "psalms                                  ",
    "chapter": "102",
    "verse": "11",
    "text": "मेरी आयु ढलती हुई छाया के समान है;"
  },
  {
    "id": 15534,
    "book": "psalms                                  ",
    "chapter": "102",
    "verse": "12",
    "text": "परन्तु हे यहोवा, तू सदैव विराजमान रहेगा;"
  },
  {
    "id": 15535,
    "book": "psalms                                  ",
    "chapter": "102",
    "verse": "13",
    "text": "तू उठकर सिय्योन पर दया करेगा;"
  },
  {
    "id": 15536,
    "book": "psalms                                  ",
    "chapter": "102",
    "verse": "14",
    "text": "क्योंकि तेरे दास उसके पत्थरों को चाहते हैं,"
  },
  {
    "id": 15537,
    "book": "psalms                                  ",
    "chapter": "102",
    "verse": "15",
    "text": "इसलिए जाति-जाति यहोवा के नाम का भय मानेंगी,"
  },
  {
    "id": 15538,
    "book": "psalms                                  ",
    "chapter": "102",
    "verse": "16",
    "text": "क्योंकि यहोवा ने सिय्योन को फिर बसाया है,"
  },
  {
    "id": 15539,
    "book": "psalms                                  ",
    "chapter": "102",
    "verse": "17",
    "text": "वह लाचार की प्रार्थना की ओर मुँह करता है,"
  },
  {
    "id": 15540,
    "book": "psalms                                  ",
    "chapter": "102",
    "verse": "18",
    "text": "यह बात आनेवाली पीढ़ी के लिये लिखी जाएगी,"
  },
  {
    "id": 15541,
    "book": "psalms                                  ",
    "chapter": "102",
    "verse": "19",
    "text": "क्योंकि यहोवा ने अपने ऊँचे और पवित्रस्थान से दृष्टि की;"
  },
  {
    "id": 15542,
    "book": "psalms                                  ",
    "chapter": "102",
    "verse": "20",
    "text": "ताकि बन्दियों का कराहना सुने,"
  },
  {
    "id": 15543,
    "book": "psalms                                  ",
    "chapter": "102",
    "verse": "21",
    "text": "तब लोग सिय्योन में यहोवा के नाम का वर्णन करेंगे,"
  },
  {
    "id": 15544,
    "book": "psalms                                  ",
    "chapter": "102",
    "verse": "22",
    "text": "यह उस समय होगा जब देश-देश,"
  },
  {
    "id": 15545,
    "book": "psalms                                  ",
    "chapter": "102",
    "verse": "23",
    "text": "उसने मुझे जीवन यात्रा में दुःख देकर,"
  },
  {
    "id": 15546,
    "book": "psalms                                  ",
    "chapter": "102",
    "verse": "24",
    "text": "मैंने कहा, “हे मेरे परमेश्वर, मुझे आधी आयु में न उठा ले,"
  },
  {
    "id": 15547,
    "book": "psalms                                  ",
    "chapter": "102",
    "verse": "25",
    "text": "आदि में तूने पृथ्वी की नींव डाली,"
  },
  {
    "id": 15548,
    "book": "psalms                                  ",
    "chapter": "102",
    "verse": "26",
    "text": "वह तो नाश होगा, परन्तु तू बना रहेगा;"
  },
  {
    "id": 15549,
    "book": "psalms                                  ",
    "chapter": "102",
    "verse": "27",
    "text": "परन्तु तू वहीं है,"
  },
  {
    "id": 15550,
    "book": "psalms                                  ",
    "chapter": "102",
    "verse": "28",
    "text": "तेरे दासों की सन्तान बनी रहेगी;"
  }
]
