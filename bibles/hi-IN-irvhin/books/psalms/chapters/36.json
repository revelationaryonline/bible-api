[
  {
    "id": 14440,
    "book": "psalms                                  ",
    "chapter": "36",
    "verse": "1",
    "text": "दुष्ट जन का अपराध उसके हृदय के भीतर कहता है;"
  },
  {
    "id": 14441,
    "book": "psalms                                  ",
    "chapter": "36",
    "verse": "2",
    "text": "वह अपने अधर्म के प्रगट होने"
  },
  {
    "id": 14442,
    "book": "psalms                                  ",
    "chapter": "36",
    "verse": "3",
    "text": "उसकी बातें अनर्थ और छल की हैं;"
  },
  {
    "id": 14443,
    "book": "psalms                                  ",
    "chapter": "36",
    "verse": "4",
    "text": "वह अपने बिछौने पर पड़े-पड़े"
  },
  {
    "id": 14444,
    "book": "psalms                                  ",
    "chapter": "36",
    "verse": "5",
    "text": "हे यहोवा, तेरी करुणा स्वर्ग में है,"
  },
  {
    "id": 14445,
    "book": "psalms                                  ",
    "chapter": "36",
    "verse": "6",
    "text": "तेरा धर्म ऊँचे पर्वतों के समान है,"
  },
  {
    "id": 14446,
    "book": "psalms                                  ",
    "chapter": "36",
    "verse": "7",
    "text": "हे परमेश्वर, तेरी करुणा कैसी अनमोल है!"
  },
  {
    "id": 14447,
    "book": "psalms                                  ",
    "chapter": "36",
    "verse": "8",
    "text": "वे तेरे भवन के भोजन की"
  },
  {
    "id": 14448,
    "book": "psalms                                  ",
    "chapter": "36",
    "verse": "9",
    "text": "क्योंकि जीवन का सोता तेरे ही पास है36:9 जीवन का सोता तेरे ही पास है: सोता या स्रोत जहाँ से सम्पूर्ण जीवन प्रवाहित होता है। सब जीवित प्राणी उससे जीवन पाते हैं।;"
  },
  {
    "id": 14449,
    "book": "psalms                                  ",
    "chapter": "36",
    "verse": "10",
    "text": "अपने जाननेवालों पर करुणा करता रह,"
  },
  {
    "id": 14450,
    "book": "psalms                                  ",
    "chapter": "36",
    "verse": "11",
    "text": "अहंकारी मुझ पर लात उठाने न पाए,"
  },
  {
    "id": 14451,
    "book": "psalms                                  ",
    "chapter": "36",
    "verse": "12",
    "text": "वहाँ अनर्थकारी गिर पड़े हैं;"
  }
]
