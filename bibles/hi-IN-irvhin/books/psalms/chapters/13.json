[
  {
    "id": 14076,
    "book": "psalms                                  ",
    "chapter": "13",
    "verse": "1",
    "text": "हे परमेश्वर, तू कब तक? क्या सदैव मुझे भूला रहेगा?"
  },
  {
    "id": 14077,
    "book": "psalms                                  ",
    "chapter": "13",
    "verse": "2",
    "text": "मैं कब तक अपने मन ही मन में युक्तियाँ करता रहूँ,"
  },
  {
    "id": 14078,
    "book": "psalms                                  ",
    "chapter": "13",
    "verse": "3",
    "text": "हे मेरे परमेश्वर यहोवा, मेरी ओर ध्यान दे और मुझे उत्तर दे,"
  },
  {
    "id": 14079,
    "book": "psalms                                  ",
    "chapter": "13",
    "verse": "4",
    "text": "ऐसा न हो कि मेरा शत्रु कहे, “मैं उस पर प्रबल हो गया;”"
  },
  {
    "id": 14080,
    "book": "psalms                                  ",
    "chapter": "13",
    "verse": "5",
    "text": "परन्तु मैंने तो तेरी करुणा पर भरोसा रखा है;"
  },
  {
    "id": 14081,
    "book": "psalms                                  ",
    "chapter": "13",
    "verse": "6",
    "text": "मैं यहोवा के नाम का भजन गाऊँगा,"
  }
]
