[
  {
    "id": 15795,
    "book": "psalms                                  ",
    "chapter": "111",
    "verse": "1",
    "text": "यहोवा की स्तुति करो। मैं सीधे लोगों की गोष्ठी में"
  },
  {
    "id": 15796,
    "book": "psalms                                  ",
    "chapter": "111",
    "verse": "2",
    "text": "यहोवा के काम बड़े हैं,"
  },
  {
    "id": 15797,
    "book": "psalms                                  ",
    "chapter": "111",
    "verse": "3",
    "text": "उसके काम वैभवशाली और ऐश्वर्यमय होते हैं,"
  },
  {
    "id": 15798,
    "book": "psalms                                  ",
    "chapter": "111",
    "verse": "4",
    "text": "उसने अपने आश्चर्यकर्मों का स्मरण कराया है;"
  },
  {
    "id": 15799,
    "book": "psalms                                  ",
    "chapter": "111",
    "verse": "5",
    "text": "उसने अपने डरवैयों को आहार दिया है;"
  },
  {
    "id": 15800,
    "book": "psalms                                  ",
    "chapter": "111",
    "verse": "6",
    "text": "उसने अपनी प्रजा को जाति-जाति का भाग देने के लिये,"
  },
  {
    "id": 15801,
    "book": "psalms                                  ",
    "chapter": "111",
    "verse": "7",
    "text": "सच्चाई और न्याय उसके हाथों के काम हैं;"
  },
  {
    "id": 15802,
    "book": "psalms                                  ",
    "chapter": "111",
    "verse": "8",
    "text": "वे सदा सर्वदा अटल रहेंगे,"
  },
  {
    "id": 15803,
    "book": "psalms                                  ",
    "chapter": "111",
    "verse": "9",
    "text": "उसने अपनी प्रजा का उद्धार किया है;"
  },
  {
    "id": 15804,
    "book": "psalms                                  ",
    "chapter": "111",
    "verse": "10",
    "text": "बुद्धि का मूल यहोवा का भय है;"
  }
]
