[
  {
    "id": 14193,
    "book": "psalms                                  ",
    "chapter": "21",
    "verse": "1",
    "text": "हे यहोवा तेरी सामर्थ्य से राजा आनन्दित होगा;"
  },
  {
    "id": 14194,
    "book": "psalms                                  ",
    "chapter": "21",
    "verse": "2",
    "text": "तूने उसके मनोरथ को पूरा किया है,"
  },
  {
    "id": 14195,
    "book": "psalms                                  ",
    "chapter": "21",
    "verse": "3",
    "text": "क्योंकि तू उत्तम आशीषें देता हुआ उससे मिलता है"
  },
  {
    "id": 14196,
    "book": "psalms                                  ",
    "chapter": "21",
    "verse": "4",
    "text": "उसने तुझ से जीवन माँगा, और तूने जीवनदान दिया;"
  },
  {
    "id": 14197,
    "book": "psalms                                  ",
    "chapter": "21",
    "verse": "5",
    "text": "तेरे उद्धार के कारण उसकी महिमा अधिक है;"
  },
  {
    "id": 14198,
    "book": "psalms                                  ",
    "chapter": "21",
    "verse": "6",
    "text": "क्योंकि तूने उसको सर्वदा के लिये आशीषित किया है21:6 तूने उसको सर्वदा के लिये आशीषित किया है: विचार यह है कि उसने उसे मनुष्यों के लिए या संसार के लिए आशीष का कारण बनाया था। उसे मनुष्यों के लिए आशीष का स्रोत बनाया है। ;"
  },
  {
    "id": 14199,
    "book": "psalms                                  ",
    "chapter": "21",
    "verse": "7",
    "text": "क्योंकि राजा का भरोसा यहोवा के ऊपर है;"
  },
  {
    "id": 14200,
    "book": "psalms                                  ",
    "chapter": "21",
    "verse": "8",
    "text": "तेरा हाथ तेरे सब शत्रुओं को ढूँढ़ निकालेगा,"
  },
  {
    "id": 14201,
    "book": "psalms                                  ",
    "chapter": "21",
    "verse": "9",
    "text": "तू अपने मुख के सम्मुख उन्हें जलते हुए भट्ठे"
  },
  {
    "id": 14202,
    "book": "psalms                                  ",
    "chapter": "21",
    "verse": "10",
    "text": "तू उनके फलों को पृथ्वी पर से,"
  },
  {
    "id": 14203,
    "book": "psalms                                  ",
    "chapter": "21",
    "verse": "11",
    "text": "क्योंकि उन्होंने तेरी हानि ठानी है,"
  },
  {
    "id": 14204,
    "book": "psalms                                  ",
    "chapter": "21",
    "verse": "12",
    "text": "क्योंकि तू अपना धनुष उनके विरुद्ध चढ़ाएगा,"
  },
  {
    "id": 14205,
    "book": "psalms                                  ",
    "chapter": "21",
    "verse": "13",
    "text": "हे यहोवा, अपनी सामर्थ्य में महान हो;"
  }
]
