[
  {
    "id": 14670,
    "book": "psalms                                  ",
    "chapter": "50",
    "verse": "1",
    "text": "सर्वशक्तिमान परमेश्वर यहोवा ने कहा है,"
  },
  {
    "id": 14671,
    "book": "psalms                                  ",
    "chapter": "50",
    "verse": "2",
    "text": "सिय्योन से, जो परम सुन्दर है,"
  },
  {
    "id": 14672,
    "book": "psalms                                  ",
    "chapter": "50",
    "verse": "3",
    "text": "हमारा परमेश्वर आएगा और चुपचाप न रहेगा,"
  },
  {
    "id": 14673,
    "book": "psalms                                  ",
    "chapter": "50",
    "verse": "4",
    "text": "वह अपनी प्रजा का न्याय करने के लिये"
  },
  {
    "id": 14674,
    "book": "psalms                                  ",
    "chapter": "50",
    "verse": "5",
    "text": "“मेरे भक्तों को मेरे पास इकट्ठा करो,"
  },
  {
    "id": 14675,
    "book": "psalms                                  ",
    "chapter": "50",
    "verse": "6",
    "text": "और स्वर्ग उसके धर्मी होने का प्रचार करेगा"
  },
  {
    "id": 14676,
    "book": "psalms                                  ",
    "chapter": "50",
    "verse": "7",
    "text": "“हे मेरी प्रजा, सुन, मैं बोलता हूँ,"
  },
  {
    "id": 14677,
    "book": "psalms                                  ",
    "chapter": "50",
    "verse": "8",
    "text": "मैं तुझ पर तेरे बलियों के विषय दोष नहीं लगाता,"
  },
  {
    "id": 14678,
    "book": "psalms                                  ",
    "chapter": "50",
    "verse": "9",
    "text": "मैं न तो तेरे घर से बैल"
  },
  {
    "id": 14679,
    "book": "psalms                                  ",
    "chapter": "50",
    "verse": "10",
    "text": "क्योंकि वन के सारे जीव-जन्तु"
  },
  {
    "id": 14680,
    "book": "psalms                                  ",
    "chapter": "50",
    "verse": "11",
    "text": "पहाड़ों के सब पक्षियों को मैं जानता हूँ,"
  },
  {
    "id": 14681,
    "book": "psalms                                  ",
    "chapter": "50",
    "verse": "12",
    "text": "“यदि मैं भूखा होता तो तुझ से न कहता;"
  },
  {
    "id": 14682,
    "book": "psalms                                  ",
    "chapter": "50",
    "verse": "13",
    "text": "क्या मैं बैल का माँस खाऊँ,"
  },
  {
    "id": 14683,
    "book": "psalms                                  ",
    "chapter": "50",
    "verse": "14",
    "text": "परमेश्वर को धन्यवाद ही का बलिदान चढ़ा,"
  },
  {
    "id": 14684,
    "book": "psalms                                  ",
    "chapter": "50",
    "verse": "15",
    "text": "और संकट के दिन मुझे पुकार;"
  },
  {
    "id": 14685,
    "book": "psalms                                  ",
    "chapter": "50",
    "verse": "16",
    "text": "परन्तु दुष्ट से परमेश्वर कहता है:"
  },
  {
    "id": 14686,
    "book": "psalms                                  ",
    "chapter": "50",
    "verse": "17",
    "text": "तू तो शिक्षा से बैर करता,"
  },
  {
    "id": 14687,
    "book": "psalms                                  ",
    "chapter": "50",
    "verse": "18",
    "text": "जब तूने चोर को देखा, तब उसकी संगति से प्रसन्न हुआ;"
  },
  {
    "id": 14688,
    "book": "psalms                                  ",
    "chapter": "50",
    "verse": "19",
    "text": "“तूने अपना मुँह बुराई करने के लिये खोला,"
  },
  {
    "id": 14689,
    "book": "psalms                                  ",
    "chapter": "50",
    "verse": "20",
    "text": "तू बैठा हुआ अपने भाई के विरुद्ध बोलता;"
  },
  {
    "id": 14690,
    "book": "psalms                                  ",
    "chapter": "50",
    "verse": "21",
    "text": "यह काम तूने किया, और मैं चुप रहा;"
  },
  {
    "id": 14691,
    "book": "psalms                                  ",
    "chapter": "50",
    "verse": "22",
    "text": "“हे परमेश्वर को भूलनेवालो50:22 हे परमेश्वर को भूलनेवालो: यद्यपि तुम मुँह से उसकी आराधना करते हो, सच तो यह है कि तुम उसे भूल चुके हो, तुम परमेश्वर के प्रमाणिक स्वभाव को भूल चुके हो।  यह बात भली भाँति समझ लो,"
  },
  {
    "id": 14692,
    "book": "psalms                                  ",
    "chapter": "50",
    "verse": "23",
    "text": "धन्यवाद के बलिदान का चढ़ानेवाला मेरी महिमा करता है;"
  }
]
