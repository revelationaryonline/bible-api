[
  {
    "id": 15492,
    "book": "psalms                                  ",
    "chapter": "98",
    "verse": "1",
    "text": "यहोवा के लिये एक नया गीत गाओ,"
  },
  {
    "id": 15493,
    "book": "psalms                                  ",
    "chapter": "98",
    "verse": "2",
    "text": "यहोवा ने अपना किया हुआ उद्धार प्रकाशित किया,"
  },
  {
    "id": 15494,
    "book": "psalms                                  ",
    "chapter": "98",
    "verse": "3",
    "text": "उसने इस्राएल के घराने पर की अपनी करुणा"
  },
  {
    "id": 15495,
    "book": "psalms                                  ",
    "chapter": "98",
    "verse": "4",
    "text": "हे सारी पृथ्वी98:4 सारी पृथ्वी: यह घटना इतनी महत्त्वपूर्ण है कि सब जातियाँ उत्सव मनाएँ। यह विश्वव्यापी उल्लास एवं आनन्द का विषय है।  के लोगों, यहोवा का जयजयकार करो;"
  },
  {
    "id": 15496,
    "book": "psalms                                  ",
    "chapter": "98",
    "verse": "5",
    "text": "वीणा बजाकर यहोवा का भजन गाओ,"
  },
  {
    "id": 15497,
    "book": "psalms                                  ",
    "chapter": "98",
    "verse": "6",
    "text": "तुरहियां और नरसिंगे फूँक फूँककर"
  },
  {
    "id": 15498,
    "book": "psalms                                  ",
    "chapter": "98",
    "verse": "7",
    "text": "समुद्र और उसमें की सब वस्तुएँ गरज उठें;"
  },
  {
    "id": 15499,
    "book": "psalms                                  ",
    "chapter": "98",
    "verse": "8",
    "text": "नदियाँ तालियाँ बजाएँ;"
  },
  {
    "id": 15500,
    "book": "psalms                                  ",
    "chapter": "98",
    "verse": "9",
    "text": "यह यहोवा के सामने हो, क्योंकि वह पृथ्वी का न्याय करने को आनेवाला है।"
  }
]
