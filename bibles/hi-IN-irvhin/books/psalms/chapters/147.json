[
  {
    "id": 16353,
    "book": "psalms                                  ",
    "chapter": "147",
    "verse": "1",
    "text": "यहोवा की स्तुति करो!"
  },
  {
    "id": 16354,
    "book": "psalms                                  ",
    "chapter": "147",
    "verse": "2",
    "text": "यहोवा यरूशलेम को फिर बसा रहा है;"
  },
  {
    "id": 16355,
    "book": "psalms                                  ",
    "chapter": "147",
    "verse": "3",
    "text": "वह खेदित मनवालों को चंगा करता है,"
  },
  {
    "id": 16356,
    "book": "psalms                                  ",
    "chapter": "147",
    "verse": "4",
    "text": "वह तारों को गिनता,"
  },
  {
    "id": 16357,
    "book": "psalms                                  ",
    "chapter": "147",
    "verse": "5",
    "text": "हमारा प्रभु महान और अति सामर्थी है;"
  },
  {
    "id": 16358,
    "book": "psalms                                  ",
    "chapter": "147",
    "verse": "6",
    "text": "यहोवा नम्र लोगों को सम्भालता है,"
  },
  {
    "id": 16359,
    "book": "psalms                                  ",
    "chapter": "147",
    "verse": "7",
    "text": "धन्यवाद करते हुए यहोवा का गीत गाओ;"
  },
  {
    "id": 16360,
    "book": "psalms                                  ",
    "chapter": "147",
    "verse": "8",
    "text": "वह आकाश को मेघों से भर देता है,"
  },
  {
    "id": 16361,
    "book": "psalms                                  ",
    "chapter": "147",
    "verse": "9",
    "text": "वह पशुओं को और कौवे के बच्चों को जो पुकारते हैं,"
  },
  {
    "id": 16362,
    "book": "psalms                                  ",
    "chapter": "147",
    "verse": "10",
    "text": "न तो वह घोड़े के बल को चाहता है,"
  },
  {
    "id": 16363,
    "book": "psalms                                  ",
    "chapter": "147",
    "verse": "11",
    "text": "यहोवा अपने डरवैयों ही से प्रसन्न होता है147:11 यहोवा अपने डरवैयों ही से प्रसन्न होता है: जो सच्चे दिल से उसकी उपासना करते हैं वो विनम्र और दीन होते हैं।,"
  },
  {
    "id": 16364,
    "book": "psalms                                  ",
    "chapter": "147",
    "verse": "12",
    "text": "हे यरूशलेम, यहोवा की प्रशंसा कर!"
  },
  {
    "id": 16365,
    "book": "psalms                                  ",
    "chapter": "147",
    "verse": "13",
    "text": "क्योंकि उसने तेरे फाटकों के खम्भों को दृढ़ किया है;"
  },
  {
    "id": 16366,
    "book": "psalms                                  ",
    "chapter": "147",
    "verse": "14",
    "text": "वह तेरी सीमा में शान्ति देता है,"
  },
  {
    "id": 16367,
    "book": "psalms                                  ",
    "chapter": "147",
    "verse": "15",
    "text": "वह पृथ्वी पर अपनी आज्ञा का प्रचार करता है,"
  },
  {
    "id": 16368,
    "book": "psalms                                  ",
    "chapter": "147",
    "verse": "16",
    "text": "वह ऊन के समान हिम को गिराता है,"
  },
  {
    "id": 16369,
    "book": "psalms                                  ",
    "chapter": "147",
    "verse": "17",
    "text": "वह बर्फ के टुकड़े गिराता है,"
  },
  {
    "id": 16370,
    "book": "psalms                                  ",
    "chapter": "147",
    "verse": "18",
    "text": "वह आज्ञा देकर उन्हें गलाता है;"
  },
  {
    "id": 16371,
    "book": "psalms                                  ",
    "chapter": "147",
    "verse": "19",
    "text": "वह याकूब को अपना वचन,"
  },
  {
    "id": 16372,
    "book": "psalms                                  ",
    "chapter": "147",
    "verse": "20",
    "text": "किसी और जाति से उसने ऐसा बर्ताव नहीं किया;"
  }
]
