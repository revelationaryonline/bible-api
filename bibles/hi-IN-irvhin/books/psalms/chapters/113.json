[
  {
    "id": 15815,
    "book": "psalms                                  ",
    "chapter": "113",
    "verse": "1",
    "text": "यहोवा की स्तुति करो!"
  },
  {
    "id": 15816,
    "book": "psalms                                  ",
    "chapter": "113",
    "verse": "2",
    "text": "यहोवा का नाम"
  },
  {
    "id": 15817,
    "book": "psalms                                  ",
    "chapter": "113",
    "verse": "3",
    "text": "उदयाचल से लेकर अस्ताचल तक,"
  },
  {
    "id": 15818,
    "book": "psalms                                  ",
    "chapter": "113",
    "verse": "4",
    "text": "यहोवा सारी जातियों के ऊपर महान है,"
  },
  {
    "id": 15819,
    "book": "psalms                                  ",
    "chapter": "113",
    "verse": "5",
    "text": "हमारे परमेश्वर यहोवा के तुल्य कौन है?"
  },
  {
    "id": 15820,
    "book": "psalms                                  ",
    "chapter": "113",
    "verse": "6",
    "text": "और आकाश और पृथ्वी पर,"
  },
  {
    "id": 15821,
    "book": "psalms                                  ",
    "chapter": "113",
    "verse": "7",
    "text": "वह कंगाल को मिट्टी पर से,"
  },
  {
    "id": 15822,
    "book": "psalms                                  ",
    "chapter": "113",
    "verse": "8",
    "text": "कि उसको प्रधानों के संग,"
  },
  {
    "id": 15823,
    "book": "psalms                                  ",
    "chapter": "113",
    "verse": "9",
    "text": "वह बाँझ को घर में बाल-बच्चों की आनन्द करनेवाली माता बनाता है।"
  }
]
