[
  {
    "id": 14841,
    "book": "psalms                                  ",
    "chapter": "63",
    "verse": "1",
    "text": "हे परमेश्वर, तू मेरा परमेश्वर है,"
  },
  {
    "id": 14842,
    "book": "psalms                                  ",
    "chapter": "63",
    "verse": "2",
    "text": "इस प्रकार से मैंने पवित्रस्थान में तुझ पर दृष्टि की,"
  },
  {
    "id": 14843,
    "book": "psalms                                  ",
    "chapter": "63",
    "verse": "3",
    "text": "क्योंकि तेरी करुणा जीवन से भी उत्तम है,"
  },
  {
    "id": 14844,
    "book": "psalms                                  ",
    "chapter": "63",
    "verse": "4",
    "text": "इसी प्रकार मैं जीवन भर तुझे धन्य कहता रहूँगा;"
  },
  {
    "id": 14845,
    "book": "psalms                                  ",
    "chapter": "63",
    "verse": "5",
    "text": "मेरा जीव मानो चर्बी और चिकने भोजन से तृप्त होगा,"
  },
  {
    "id": 14846,
    "book": "psalms                                  ",
    "chapter": "63",
    "verse": "6",
    "text": "जब मैं बिछौने पर पड़ा तेरा स्मरण करूँगा,"
  },
  {
    "id": 14847,
    "book": "psalms                                  ",
    "chapter": "63",
    "verse": "7",
    "text": "क्योंकि तू मेरा सहायक बना है,"
  },
  {
    "id": 14848,
    "book": "psalms                                  ",
    "chapter": "63",
    "verse": "8",
    "text": "मेरा मन तेरे पीछे-पीछे लगा चलता है;"
  },
  {
    "id": 14849,
    "book": "psalms                                  ",
    "chapter": "63",
    "verse": "9",
    "text": "परन्तु जो मेरे प्राण के खोजी हैं,"
  },
  {
    "id": 14850,
    "book": "psalms                                  ",
    "chapter": "63",
    "verse": "10",
    "text": "वे तलवार से मारे जाएँगे,"
  },
  {
    "id": 14851,
    "book": "psalms                                  ",
    "chapter": "63",
    "verse": "11",
    "text": "परन्तु राजा परमेश्वर के कारण आनन्दित होगा;"
  }
]
