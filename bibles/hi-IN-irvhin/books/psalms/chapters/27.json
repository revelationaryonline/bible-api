[
  {
    "id": 14287,
    "book": "psalms                                  ",
    "chapter": "27",
    "verse": "1",
    "text": "यहोवा मेरी ज्योति और मेरा उद्धार है;"
  },
  {
    "id": 14288,
    "book": "psalms                                  ",
    "chapter": "27",
    "verse": "2",
    "text": "जब कुकर्मियों ने जो मुझे सताते और मुझी से"
  },
  {
    "id": 14289,
    "book": "psalms                                  ",
    "chapter": "27",
    "verse": "3",
    "text": "चाहे सेना भी मेरे विरुद्ध छावनी डाले,"
  },
  {
    "id": 14290,
    "book": "psalms                                  ",
    "chapter": "27",
    "verse": "4",
    "text": "एक वर मैंने यहोवा से माँगा है,"
  },
  {
    "id": 14291,
    "book": "psalms                                  ",
    "chapter": "27",
    "verse": "5",
    "text": "क्योंकि वह तो मुझे विपत्ति के दिन में अपने"
  },
  {
    "id": 14292,
    "book": "psalms                                  ",
    "chapter": "27",
    "verse": "6",
    "text": "अब मेरा सिर मेरे चारों ओर के शत्रुओं से ऊँचा होगा;"
  },
  {
    "id": 14293,
    "book": "psalms                                  ",
    "chapter": "27",
    "verse": "7",
    "text": "हे यहोवा, मेरा शब्द सुन, मैं पुकारता हूँ,"
  },
  {
    "id": 14294,
    "book": "psalms                                  ",
    "chapter": "27",
    "verse": "8",
    "text": "तूने कहा है, “मेरे दर्शन के खोजी हो।”"
  },
  {
    "id": 14295,
    "book": "psalms                                  ",
    "chapter": "27",
    "verse": "9",
    "text": "अपना मुख मुझसे न छिपा।"
  },
  {
    "id": 14296,
    "book": "psalms                                  ",
    "chapter": "27",
    "verse": "10",
    "text": "मेरे माता-पिता ने तो मुझे छोड़ दिया है,"
  },
  {
    "id": 14297,
    "book": "psalms                                  ",
    "chapter": "27",
    "verse": "11",
    "text": "हे यहोवा, अपना मार्ग मुझे सिखा,"
  },
  {
    "id": 14298,
    "book": "psalms                                  ",
    "chapter": "27",
    "verse": "12",
    "text": "मुझ को मेरे सतानेवालों की इच्छा पर न छोड़,"
  },
  {
    "id": 14299,
    "book": "psalms                                  ",
    "chapter": "27",
    "verse": "13",
    "text": "यदि मुझे विश्वास न होता कि जीवितों की"
  },
  {
    "id": 14300,
    "book": "psalms                                  ",
    "chapter": "27",
    "verse": "14",
    "text": "यहोवा की बाट जोहता रह;"
  }
]
