[
  {
    "id": 15805,
    "book": "psalms                                  ",
    "chapter": "112",
    "verse": "1",
    "text": "यहोवा की स्तुति करो!"
  },
  {
    "id": 15806,
    "book": "psalms                                  ",
    "chapter": "112",
    "verse": "2",
    "text": "उसका वंश पृथ्वी पर पराक्रमी होगा112:2 उसका वंश पृथ्वी पर पराक्रमी होगा: उसकी सन्तान, उसके वंशज अर्थात् वे समृद्ध होंगे, सम्मानित होंगे, मनुष्यों के मध्य अपनी पहचान रखेंगे। ;"
  },
  {
    "id": 15807,
    "book": "psalms                                  ",
    "chapter": "112",
    "verse": "3",
    "text": "उसके घर में धन-सम्पत्ति रहती है;"
  },
  {
    "id": 15808,
    "book": "psalms                                  ",
    "chapter": "112",
    "verse": "4",
    "text": "सीधे लोगों के लिये अंधकार के बीच में ज्योति उदय होती है;"
  },
  {
    "id": 15809,
    "book": "psalms                                  ",
    "chapter": "112",
    "verse": "5",
    "text": "जो व्यक्ति अनुग्रह करता और उधार देता है,"
  },
  {
    "id": 15810,
    "book": "psalms                                  ",
    "chapter": "112",
    "verse": "6",
    "text": "वह तो सदा तक अटल रहेगा;"
  },
  {
    "id": 15811,
    "book": "psalms                                  ",
    "chapter": "112",
    "verse": "7",
    "text": "वह बुरे समाचार से नहीं डरता;"
  },
  {
    "id": 15812,
    "book": "psalms                                  ",
    "chapter": "112",
    "verse": "8",
    "text": "उसका हृदय सम्भला हुआ है, इसलिए वह न डरेगा,"
  },
  {
    "id": 15813,
    "book": "psalms                                  ",
    "chapter": "112",
    "verse": "9",
    "text": "उसने उदारता से दरिद्रों को दान दिया112:9 उसने उदारता से दरिद्रों को दान दिया: वह उदार है वह मुक्त हस्त दान देता है। वह आवश्यकता ग्रस्त और अभागों में बाँट देता है।,"
  },
  {
    "id": 15814,
    "book": "psalms                                  ",
    "chapter": "112",
    "verse": "10",
    "text": "दुष्ट इसे देखकर कुढ़ेगा;"
  }
]
