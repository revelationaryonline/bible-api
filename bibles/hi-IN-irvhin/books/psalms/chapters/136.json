[
  {
    "id": 16198,
    "book": "psalms                                  ",
    "chapter": "136",
    "verse": "1",
    "text": "यहोवा का धन्यवाद करो,"
  },
  {
    "id": 16199,
    "book": "psalms                                  ",
    "chapter": "136",
    "verse": "2",
    "text": "जो ईश्वरों का परमेश्वर है, उसका धन्यवाद करो,"
  },
  {
    "id": 16200,
    "book": "psalms                                  ",
    "chapter": "136",
    "verse": "3",
    "text": "जो प्रभुओं का प्रभु है, उसका धन्यवाद करो,"
  },
  {
    "id": 16201,
    "book": "psalms                                  ",
    "chapter": "136",
    "verse": "4",
    "text": "उसको छोड़कर कोई बड़े-बड़े आश्चर्यकर्म नहीं करता,"
  },
  {
    "id": 16202,
    "book": "psalms                                  ",
    "chapter": "136",
    "verse": "5",
    "text": "उसने अपनी बुद्धि से आकाश बनाया,"
  },
  {
    "id": 16203,
    "book": "psalms                                  ",
    "chapter": "136",
    "verse": "6",
    "text": "उसने पृथ्वी को जल के ऊपर फैलाया है,"
  },
  {
    "id": 16204,
    "book": "psalms                                  ",
    "chapter": "136",
    "verse": "7",
    "text": "उसने बड़ी-बड़ी ज्योतियाँ बनाईं,"
  },
  {
    "id": 16205,
    "book": "psalms                                  ",
    "chapter": "136",
    "verse": "8",
    "text": "दिन पर प्रभुता करने के लिये सूर्य को बनाया,"
  },
  {
    "id": 16206,
    "book": "psalms                                  ",
    "chapter": "136",
    "verse": "9",
    "text": "और रात पर प्रभुता करने के लिये चन्द्रमा और तारागण को बनाया,"
  },
  {
    "id": 16207,
    "book": "psalms                                  ",
    "chapter": "136",
    "verse": "10",
    "text": "उसने मिस्रियों के पहिलौठों को मारा,"
  },
  {
    "id": 16208,
    "book": "psalms                                  ",
    "chapter": "136",
    "verse": "11",
    "text": "और उनके बीच से इस्राएलियों को निकाला,"
  },
  {
    "id": 16209,
    "book": "psalms                                  ",
    "chapter": "136",
    "verse": "12",
    "text": "बलवन्त हाथ और बढ़ाई हुई भुजा से निकाल लाया,"
  },
  {
    "id": 16210,
    "book": "psalms                                  ",
    "chapter": "136",
    "verse": "13",
    "text": "उसने लाल समुद्र को विभाजित कर दिया,"
  },
  {
    "id": 16211,
    "book": "psalms                                  ",
    "chapter": "136",
    "verse": "14",
    "text": "और इस्राएल को उसके बीच से पार कर दिया,"
  },
  {
    "id": 16212,
    "book": "psalms                                  ",
    "chapter": "136",
    "verse": "15",
    "text": "और फ़िरौन को उसकी सेना समेत लाल समुद्र में डाल दिया,"
  },
  {
    "id": 16213,
    "book": "psalms                                  ",
    "chapter": "136",
    "verse": "16",
    "text": "वह अपनी प्रजा को जंगल में ले चला,"
  },
  {
    "id": 16214,
    "book": "psalms                                  ",
    "chapter": "136",
    "verse": "17",
    "text": "उसने बड़े-बड़े राजा मारे,"
  },
  {
    "id": 16215,
    "book": "psalms                                  ",
    "chapter": "136",
    "verse": "18",
    "text": "उसने प्रतापी राजाओं को भी मारा,"
  },
  {
    "id": 16216,
    "book": "psalms                                  ",
    "chapter": "136",
    "verse": "19",
    "text": "एमोरियों के राजा सीहोन को,"
  },
  {
    "id": 16217,
    "book": "psalms                                  ",
    "chapter": "136",
    "verse": "20",
    "text": "और बाशान के राजा ओग को घात किया,"
  },
  {
    "id": 16218,
    "book": "psalms                                  ",
    "chapter": "136",
    "verse": "21",
    "text": "और उनके देश को भाग होने के लिये,"
  },
  {
    "id": 16219,
    "book": "psalms                                  ",
    "chapter": "136",
    "verse": "22",
    "text": "अपने दास इस्राएलियों के भाग होने के लिये दे दिया,"
  },
  {
    "id": 16220,
    "book": "psalms                                  ",
    "chapter": "136",
    "verse": "23",
    "text": "उसने हमारी दुर्दशा में हमारी सुधि ली136:23 उसने हमारी दुर्दशा में हमारी सुधि ली: जब हम अल्पसंख्यक थे, जब दुर्बल जाति थे, जब हम महाशक्तियों से युद्ध करने योग्य नहीं थे।,"
  },
  {
    "id": 16221,
    "book": "psalms                                  ",
    "chapter": "136",
    "verse": "24",
    "text": "और हमको द्रोहियों से छुड़ाया है,"
  },
  {
    "id": 16222,
    "book": "psalms                                  ",
    "chapter": "136",
    "verse": "25",
    "text": "वह सब प्राणियों को आहार देता है136:25 वह सब प्राणियों को आहार देता है: सब प्राणियों को आकाश पृथ्वी और जल के।,"
  },
  {
    "id": 16223,
    "book": "psalms                                  ",
    "chapter": "136",
    "verse": "26",
    "text": "स्वर्ग के परमेश्वर का धन्यवाद करो,"
  }
]
