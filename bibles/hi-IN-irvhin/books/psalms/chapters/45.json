[
  {
    "id": 14599,
    "book": "psalms                                  ",
    "chapter": "45",
    "verse": "1",
    "text": "मेरा हृदय एक सुन्दर विषय की उमंग से"
  },
  {
    "id": 14600,
    "book": "psalms                                  ",
    "chapter": "45",
    "verse": "2",
    "text": "तू मनुष्य की सन्तानों में परम सुन्दर है;"
  },
  {
    "id": 14601,
    "book": "psalms                                  ",
    "chapter": "45",
    "verse": "3",
    "text": "हे वीर, तू अपनी तलवार को जो तेरा वैभव45:3 तू अपनी तलवार को जो तेरा वैभव: अर्थात् युद्ध और विजय के लिए तैयार हो जा - यहाँ मसीह को एक विजेता राजा कहा गया है।"
  },
  {
    "id": 14602,
    "book": "psalms                                  ",
    "chapter": "45",
    "verse": "4",
    "text": "सत्यता, नम्रता और धार्मिकता के निमित्त अपने"
  },
  {
    "id": 14603,
    "book": "psalms                                  ",
    "chapter": "45",
    "verse": "5",
    "text": "तेरे तीर तो तेज हैं,"
  },
  {
    "id": 14604,
    "book": "psalms                                  ",
    "chapter": "45",
    "verse": "6",
    "text": "हे परमेश्वर, तेरा सिंहासन सदा सर्वदा बना"
  },
  {
    "id": 14605,
    "book": "psalms                                  ",
    "chapter": "45",
    "verse": "7",
    "text": "तूने धार्मिकता से प्रीति और दुष्टता से बैर रखा है।"
  },
  {
    "id": 14606,
    "book": "psalms                                  ",
    "chapter": "45",
    "verse": "8",
    "text": "तेरे सारे वस्त्र गन्धरस, अगर, और तेज से"
  },
  {
    "id": 14607,
    "book": "psalms                                  ",
    "chapter": "45",
    "verse": "9",
    "text": "तेरी प्रतिष्ठित स्त्रियों में राजकुमारियाँ भी हैं;"
  },
  {
    "id": 14608,
    "book": "psalms                                  ",
    "chapter": "45",
    "verse": "10",
    "text": "हे राजकुमारी सुन, और कान लगाकर ध्यान दे;"
  },
  {
    "id": 14609,
    "book": "psalms                                  ",
    "chapter": "45",
    "verse": "11",
    "text": "और राजा तेरे रूप की चाह करेगा।"
  },
  {
    "id": 14610,
    "book": "psalms                                  ",
    "chapter": "45",
    "verse": "12",
    "text": "सोर की राजकुमारी भी भेंट करने के लिये"
  },
  {
    "id": 14611,
    "book": "psalms                                  ",
    "chapter": "45",
    "verse": "13",
    "text": "राजकुमारी महल में अति शोभायमान है,"
  },
  {
    "id": 14612,
    "book": "psalms                                  ",
    "chapter": "45",
    "verse": "14",
    "text": "वह बूटेदार वस्त्र पहने हुए राजा के पास"
  },
  {
    "id": 14613,
    "book": "psalms                                  ",
    "chapter": "45",
    "verse": "15",
    "text": "वे आनन्दित और मगन होकर पहुँचाई जाएँगी45:15 वे आनन्दित और मगन होकर पहुँचाई जाएँगी: वे दुल्हन के पास संगीत बजाते और गीत गाते हुए निकल आएँगे। जुलूस आनन्द और उत्सव का होगा। ,"
  },
  {
    "id": 14614,
    "book": "psalms                                  ",
    "chapter": "45",
    "verse": "16",
    "text": "तेरे पितरों के स्थान पर तेरे सन्तान होंगे;"
  },
  {
    "id": 14615,
    "book": "psalms                                  ",
    "chapter": "45",
    "verse": "17",
    "text": "मैं ऐसा करूँगा, कि तेरे नाम की चर्चा पीढ़ी"
  }
]
