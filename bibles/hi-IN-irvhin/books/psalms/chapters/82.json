[
  {
    "id": 15235,
    "book": "psalms                                  ",
    "chapter": "82",
    "verse": "1",
    "text": "परमेश्वर दिव्य सभा में खड़ा है:"
  },
  {
    "id": 15236,
    "book": "psalms                                  ",
    "chapter": "82",
    "verse": "2",
    "text": "“तुम लोग कब तक टेढ़ा न्याय करते"
  },
  {
    "id": 15237,
    "book": "psalms                                  ",
    "chapter": "82",
    "verse": "3",
    "text": "कंगाल और अनाथों का न्याय चुकाओ,"
  },
  {
    "id": 15238,
    "book": "psalms                                  ",
    "chapter": "82",
    "verse": "4",
    "text": "कंगाल और निर्धन को बचा लो;"
  },
  {
    "id": 15239,
    "book": "psalms                                  ",
    "chapter": "82",
    "verse": "5",
    "text": "वे न तो कुछ समझते और न कुछ जानते हैं,"
  },
  {
    "id": 15240,
    "book": "psalms                                  ",
    "chapter": "82",
    "verse": "6",
    "text": "मैंने कहा था “तुम ईश्वर हो,"
  },
  {
    "id": 15241,
    "book": "psalms                                  ",
    "chapter": "82",
    "verse": "7",
    "text": "तो भी तुम मनुष्यों के समान मरोगे,"
  },
  {
    "id": 15242,
    "book": "psalms                                  ",
    "chapter": "82",
    "verse": "8",
    "text": "हे परमेश्वर उठ, पृथ्वी का न्याय कर;"
  }
]
