[
  {
    "id": 15480,
    "book": "psalms                                  ",
    "chapter": "97",
    "verse": "1",
    "text": "यहोवा राजा हुआ है, पृथ्वी मगन हो;"
  },
  {
    "id": 15481,
    "book": "psalms                                  ",
    "chapter": "97",
    "verse": "2",
    "text": "बादल और अंधकार उसके चारों ओर हैं;"
  },
  {
    "id": 15482,
    "book": "psalms                                  ",
    "chapter": "97",
    "verse": "3",
    "text": "उसके आगे-आगे आग चलती हुई97:3 उसके आगे-आगे आग चलती हुई: अर्थात् वह स्वयं को न्यायोचित परमेश्वर सिद्ध करता है, उसके शत्रुओं से बदला लेता है।"
  },
  {
    "id": 15483,
    "book": "psalms                                  ",
    "chapter": "97",
    "verse": "4",
    "text": "उसकी बिजलियों से जगत प्रकाशित हुआ,"
  },
  {
    "id": 15484,
    "book": "psalms                                  ",
    "chapter": "97",
    "verse": "5",
    "text": "पहाड़ यहोवा के सामने,"
  },
  {
    "id": 15485,
    "book": "psalms                                  ",
    "chapter": "97",
    "verse": "6",
    "text": "आकाश ने उसके धर्म की साक्षी दी;"
  },
  {
    "id": 15486,
    "book": "psalms                                  ",
    "chapter": "97",
    "verse": "7",
    "text": "जितने खुदी हुई मूर्तियों की उपासना करते"
  },
  {
    "id": 15487,
    "book": "psalms                                  ",
    "chapter": "97",
    "verse": "8",
    "text": "सिय्योन सुनकर आनन्दित हुई,"
  },
  {
    "id": 15488,
    "book": "psalms                                  ",
    "chapter": "97",
    "verse": "9",
    "text": "क्योंकि हे यहोवा, तू सारी पृथ्वी के ऊपर परमप्रधान है;"
  },
  {
    "id": 15489,
    "book": "psalms                                  ",
    "chapter": "97",
    "verse": "10",
    "text": "हे यहोवा के प्रेमियों, बुराई से घृणा करो;"
  },
  {
    "id": 15490,
    "book": "psalms                                  ",
    "chapter": "97",
    "verse": "11",
    "text": "धर्मी के लिये ज्योति,"
  },
  {
    "id": 15491,
    "book": "psalms                                  ",
    "chapter": "97",
    "verse": "12",
    "text": "हे धर्मियों, यहोवा के कारण आनन्दित हो;"
  }
]
