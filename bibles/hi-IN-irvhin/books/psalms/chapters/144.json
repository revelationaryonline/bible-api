[
  {
    "id": 16307,
    "book": "psalms                                  ",
    "chapter": "144",
    "verse": "1",
    "text": "धन्य है यहोवा, जो मेरी चट्टान है,"
  },
  {
    "id": 16308,
    "book": "psalms                                  ",
    "chapter": "144",
    "verse": "2",
    "text": "वह मेरे लिये करुणानिधान और गढ़,"
  },
  {
    "id": 16309,
    "book": "psalms                                  ",
    "chapter": "144",
    "verse": "3",
    "text": "हे यहोवा, मनुष्य क्या है कि तू उसकी सुधि लेता है,"
  },
  {
    "id": 16310,
    "book": "psalms                                  ",
    "chapter": "144",
    "verse": "4",
    "text": "मनुष्य तो साँस के समान है;"
  },
  {
    "id": 16311,
    "book": "psalms                                  ",
    "chapter": "144",
    "verse": "5",
    "text": "हे यहोवा, अपने स्वर्ग को नीचा करके उतर आ!"
  },
  {
    "id": 16312,
    "book": "psalms                                  ",
    "chapter": "144",
    "verse": "6",
    "text": "बिजली कड़काकर उनको तितर-बितर कर दे,"
  },
  {
    "id": 16313,
    "book": "psalms                                  ",
    "chapter": "144",
    "verse": "7",
    "text": "अपना हाथ ऊपर से बढ़ाकर मुझे महासागर से उबार,"
  },
  {
    "id": 16314,
    "book": "psalms                                  ",
    "chapter": "144",
    "verse": "8",
    "text": "उनके मुँह से तो झूठी बातें निकलती हैं,"
  },
  {
    "id": 16315,
    "book": "psalms                                  ",
    "chapter": "144",
    "verse": "9",
    "text": "हे परमेश्वर, मैं तेरी स्तुति का नया गीत गाऊँगा;"
  },
  {
    "id": 16316,
    "book": "psalms                                  ",
    "chapter": "144",
    "verse": "10",
    "text": "तू राजाओं का उद्धार करता है,"
  },
  {
    "id": 16317,
    "book": "psalms                                  ",
    "chapter": "144",
    "verse": "11",
    "text": "मुझ को उबार और परदेशियों के वश से छुड़ा ले,"
  },
  {
    "id": 16318,
    "book": "psalms                                  ",
    "chapter": "144",
    "verse": "12",
    "text": "हमारे बेटे जवानी के समय पौधों के समान बढ़े हुए हों144:12 हमारे बेटे जवानी के समय पौधों के समान बढ़े हुए हों: अर्थात् आरम्भिक जीवन ही में वे स्वस्थ, बलवन्त, जीवन्त, गठे हुए रहे हों।,"
  },
  {
    "id": 16319,
    "book": "psalms                                  ",
    "chapter": "144",
    "verse": "13",
    "text": "हमारे खत्ते भरे रहें, और उनमें भाँति-भाँति का अन्न रखा जाए,"
  },
  {
    "id": 16320,
    "book": "psalms                                  ",
    "chapter": "144",
    "verse": "14",
    "text": "तब हमारे बैल खूब लदे हुए हों;"
  },
  {
    "id": 16321,
    "book": "psalms                                  ",
    "chapter": "144",
    "verse": "15",
    "text": "तो इस दशा में जो राज्य हो वह क्या ही धन्य होगा!"
  }
]
