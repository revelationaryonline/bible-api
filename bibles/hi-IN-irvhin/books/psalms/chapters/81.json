[
  {
    "id": 15219,
    "book": "psalms                                  ",
    "chapter": "81",
    "verse": "1",
    "text": "परमेश्वर जो हमारा बल है, उसका गीत आनन्द से गाओ;"
  },
  {
    "id": 15220,
    "book": "psalms                                  ",
    "chapter": "81",
    "verse": "2",
    "text": "गीत गाओ, डफ और मधुर बजनेवाली वीणा और सारंगी को ले आओ।"
  },
  {
    "id": 15221,
    "book": "psalms                                  ",
    "chapter": "81",
    "verse": "3",
    "text": "नये चाँद के दिन,"
  },
  {
    "id": 15222,
    "book": "psalms                                  ",
    "chapter": "81",
    "verse": "4",
    "text": "क्योंकि यह इस्राएल के लिये विधि,"
  },
  {
    "id": 15223,
    "book": "psalms                                  ",
    "chapter": "81",
    "verse": "5",
    "text": "इसको उसने यूसुफ में चितौनी की रीति पर उस समय चलाया,"
  },
  {
    "id": 15224,
    "book": "psalms                                  ",
    "chapter": "81",
    "verse": "6",
    "text": "“मैंने उनके कंधों पर से बोझ को उतार दिया;"
  },
  {
    "id": 15225,
    "book": "psalms                                  ",
    "chapter": "81",
    "verse": "7",
    "text": "तूने संकट में पड़कर पुकारा, तब मैंने तुझे छुड़ाया;"
  },
  {
    "id": 15226,
    "book": "psalms                                  ",
    "chapter": "81",
    "verse": "8",
    "text": "हे मेरी प्रजा, सुन, मैं तुझे चिता देता हूँ!"
  },
  {
    "id": 15227,
    "book": "psalms                                  ",
    "chapter": "81",
    "verse": "9",
    "text": "तेरे बीच में पराया ईश्वर न हो;"
  },
  {
    "id": 15228,
    "book": "psalms                                  ",
    "chapter": "81",
    "verse": "10",
    "text": "तेरा परमेश्वर यहोवा मैं हूँ,"
  },
  {
    "id": 15229,
    "book": "psalms                                  ",
    "chapter": "81",
    "verse": "11",
    "text": "“परन्तु मेरी प्रजा ने मेरी न सुनी;"
  },
  {
    "id": 15230,
    "book": "psalms                                  ",
    "chapter": "81",
    "verse": "12",
    "text": "इसलिए मैंने उसको उसके मन के हठ पर छोड़ दिया,"
  },
  {
    "id": 15231,
    "book": "psalms                                  ",
    "chapter": "81",
    "verse": "13",
    "text": "यदि मेरी प्रजा मेरी सुने,"
  },
  {
    "id": 15232,
    "book": "psalms                                  ",
    "chapter": "81",
    "verse": "14",
    "text": "तो मैं क्षण भर में उनके शत्रुओं को दबाऊँ,"
  },
  {
    "id": 15233,
    "book": "psalms                                  ",
    "chapter": "81",
    "verse": "15",
    "text": "यहोवा के बैरी उसके आगे भय में दण्डवत् करें!"
  },
  {
    "id": 15234,
    "book": "psalms                                  ",
    "chapter": "81",
    "verse": "16",
    "text": "मैं उनको उत्तम से उत्तम गेहूँ खिलाता,"
  }
]
