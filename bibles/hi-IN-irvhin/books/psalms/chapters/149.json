[
  {
    "id": 16387,
    "book": "psalms                                  ",
    "chapter": "149",
    "verse": "1",
    "text": "यहोवा की स्तुति करो!"
  },
  {
    "id": 16388,
    "book": "psalms                                  ",
    "chapter": "149",
    "verse": "2",
    "text": "इस्राएल अपने कर्ता के कारण आनन्दित हो,"
  },
  {
    "id": 16389,
    "book": "psalms                                  ",
    "chapter": "149",
    "verse": "3",
    "text": "वे नाचते हुए उसके नाम की स्तुति करें,"
  },
  {
    "id": 16390,
    "book": "psalms                                  ",
    "chapter": "149",
    "verse": "4",
    "text": "क्योंकि यहोवा अपनी प्रजा से प्रसन्न रहता है;"
  },
  {
    "id": 16391,
    "book": "psalms                                  ",
    "chapter": "149",
    "verse": "5",
    "text": "भक्त लोग महिमा के कारण प्रफुल्लित हों;"
  },
  {
    "id": 16392,
    "book": "psalms                                  ",
    "chapter": "149",
    "verse": "6",
    "text": "उनके कण्ठ से परमेश्वर की प्रशंसा हो,"
  },
  {
    "id": 16393,
    "book": "psalms                                  ",
    "chapter": "149",
    "verse": "7",
    "text": "कि वे जाति-जाति से पलटा ले सके;"
  },
  {
    "id": 16394,
    "book": "psalms                                  ",
    "chapter": "149",
    "verse": "8",
    "text": "और उनके राजाओं को जंजीरों से,"
  },
  {
    "id": 16395,
    "book": "psalms                                  ",
    "chapter": "149",
    "verse": "9",
    "text": "और उनको ठहराया हुआ दण्ड देंगे!"
  }
]
