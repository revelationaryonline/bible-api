[
  {
    "id": 14253,
    "book": "psalms                                  ",
    "chapter": "25",
    "verse": "1",
    "text": "हे यहोवा, मैं अपने मन को तेरी ओर"
  },
  {
    "id": 14254,
    "book": "psalms                                  ",
    "chapter": "25",
    "verse": "2",
    "text": "हे मेरे परमेश्वर, मैंने तुझी पर भरोसा रखा है,"
  },
  {
    "id": 14255,
    "book": "psalms                                  ",
    "chapter": "25",
    "verse": "3",
    "text": "वरन् जितने तेरी बाट जोहते हैं उनमें से कोई"
  },
  {
    "id": 14256,
    "book": "psalms                                  ",
    "chapter": "25",
    "verse": "4",
    "text": "हे यहोवा, अपने मार्ग मुझ को दिखा;"
  },
  {
    "id": 14257,
    "book": "psalms                                  ",
    "chapter": "25",
    "verse": "5",
    "text": "मुझे अपने सत्य पर चला और शिक्षा दे,"
  },
  {
    "id": 14258,
    "book": "psalms                                  ",
    "chapter": "25",
    "verse": "6",
    "text": "हे यहोवा, अपनी दया और करुणा के कामों को स्मरण कर;"
  },
  {
    "id": 14259,
    "book": "psalms                                  ",
    "chapter": "25",
    "verse": "7",
    "text": "हे यहोवा, अपनी भलाई के कारण"
  },
  {
    "id": 14260,
    "book": "psalms                                  ",
    "chapter": "25",
    "verse": "8",
    "text": "यहोवा भला और सीधा है;"
  },
  {
    "id": 14261,
    "book": "psalms                                  ",
    "chapter": "25",
    "verse": "9",
    "text": "वह नम्र लोगों को न्याय की शिक्षा देगा,"
  },
  {
    "id": 14262,
    "book": "psalms                                  ",
    "chapter": "25",
    "verse": "10",
    "text": "जो यहोवा की वाचा और चितौनियों को मानते हैं,"
  },
  {
    "id": 14263,
    "book": "psalms                                  ",
    "chapter": "25",
    "verse": "11",
    "text": "हे यहोवा, अपने नाम के निमित्त"
  },
  {
    "id": 14264,
    "book": "psalms                                  ",
    "chapter": "25",
    "verse": "12",
    "text": "वह कौन है जो यहोवा का भय मानता है?"
  },
  {
    "id": 14265,
    "book": "psalms                                  ",
    "chapter": "25",
    "verse": "13",
    "text": "वह कुशल से टिका रहेगा,"
  },
  {
    "id": 14266,
    "book": "psalms                                  ",
    "chapter": "25",
    "verse": "14",
    "text": "यहोवा के भेद को वही जानते हैं जो उससे डरते हैं,"
  },
  {
    "id": 14267,
    "book": "psalms                                  ",
    "chapter": "25",
    "verse": "15",
    "text": "मेरी आँखें सदैव यहोवा पर टकटकी लगाए रहती हैं,"
  },
  {
    "id": 14268,
    "book": "psalms                                  ",
    "chapter": "25",
    "verse": "16",
    "text": "हे यहोवा, मेरी ओर फिरकर मुझ पर दया कर;"
  },
  {
    "id": 14269,
    "book": "psalms                                  ",
    "chapter": "25",
    "verse": "17",
    "text": "मेरे हृदय का क्लेश बढ़ गया है,"
  },
  {
    "id": 14270,
    "book": "psalms                                  ",
    "chapter": "25",
    "verse": "18",
    "text": "तू मेरे दुःख और कष्ट पर दृष्टि कर,"
  },
  {
    "id": 14271,
    "book": "psalms                                  ",
    "chapter": "25",
    "verse": "19",
    "text": "मेरे शत्रुओं को देख कि वे कैसे बढ़ गए हैं,"
  },
  {
    "id": 14272,
    "book": "psalms                                  ",
    "chapter": "25",
    "verse": "20",
    "text": "मेरे प्राण की रक्षा कर, और मुझे छुड़ा;"
  },
  {
    "id": 14273,
    "book": "psalms                                  ",
    "chapter": "25",
    "verse": "21",
    "text": "खराई और सिधाई मुझे सुरक्षित रखे,"
  },
  {
    "id": 14274,
    "book": "psalms                                  ",
    "chapter": "25",
    "verse": "22",
    "text": "हे परमेश्वर इस्राएल को उसके सारे संकटों से छुड़ा ले।"
  }
]
