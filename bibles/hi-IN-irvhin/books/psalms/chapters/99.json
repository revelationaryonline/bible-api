[
  {
    "id": 15501,
    "book": "psalms                                  ",
    "chapter": "99",
    "verse": "1",
    "text": "यहोवा राजा हुआ है; देश-देश के लोग काँप उठें!"
  },
  {
    "id": 15502,
    "book": "psalms                                  ",
    "chapter": "99",
    "verse": "2",
    "text": "यहोवा सिय्योन में महान है;"
  },
  {
    "id": 15503,
    "book": "psalms                                  ",
    "chapter": "99",
    "verse": "3",
    "text": "वे तेरे महान और भययोग्य नाम का धन्यवाद करें!"
  },
  {
    "id": 15504,
    "book": "psalms                                  ",
    "chapter": "99",
    "verse": "4",
    "text": "राजा की सामर्थ्य न्याय से मेल रखती है,"
  },
  {
    "id": 15505,
    "book": "psalms                                  ",
    "chapter": "99",
    "verse": "5",
    "text": "हमारे परमेश्वर यहोवा को सराहो;"
  },
  {
    "id": 15506,
    "book": "psalms                                  ",
    "chapter": "99",
    "verse": "6",
    "text": "उसके याजकों में मूसा और हारून,"
  },
  {
    "id": 15507,
    "book": "psalms                                  ",
    "chapter": "99",
    "verse": "7",
    "text": "वह बादल के खम्भे में होकर उनसे बातें करता था;"
  },
  {
    "id": 15508,
    "book": "psalms                                  ",
    "chapter": "99",
    "verse": "8",
    "text": "हे हमारे परमेश्वर यहोवा, तू उनकी सुन लेता था;"
  },
  {
    "id": 15509,
    "book": "psalms                                  ",
