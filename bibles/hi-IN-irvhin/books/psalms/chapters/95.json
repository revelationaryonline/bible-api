[
  {
    "id": 15456,
    "book": "psalms                                  ",
    "chapter": "95",
    "verse": "1",
    "text": "आओ हम यहोवा के लिये ऊँचे स्वर से गाएँ,"
  },
  {
    "id": 15457,
    "book": "psalms                                  ",
    "chapter": "95",
    "verse": "2",
    "text": "हम धन्यवाद करते हुए उसके सम्मुख आएँ,"
  },
  {
    "id": 15458,
    "book": "psalms                                  ",
    "chapter": "95",
    "verse": "3",
    "text": "क्योंकि यहोवा महान परमेश्वर है,"
  },
  {
    "id": 15459,
    "book": "psalms                                  ",
    "chapter": "95",
    "verse": "4",
    "text": "पृथ्वी के गहरे स्थान उसी के हाथ में हैं;"
  },
  {
    "id": 15460,
    "book": "psalms                                  ",
    "chapter": "95",
    "verse": "5",
    "text": "समुद्र उसका है, और उसी ने उसको बनाया,"
  },
  {
    "id": 15461,
    "book": "psalms                                  ",
    "chapter": "95",
    "verse": "6",
    "text": "आओ हम झुककर दण्डवत् करें,"
  },
  {
    "id": 15462,
    "book": "psalms                                  ",
    "chapter": "95",
    "verse": "7",
    "text": "क्योंकि वही हमारा परमेश्वर है,"
  },
  {
    "id": 15463,
    "book": "psalms                                  ",
    "chapter": "95",
    "verse": "8",
    "text": "अपना-अपना हृदय ऐसा कठोर मत करो, जैसा मरीबा में,"
  },
  {
    "id": 15464,
    "book": "psalms                                  ",
    "chapter": "95",
    "verse": "9",
    "text": "जब तुम्हारे पुरखाओं ने मुझे परखा95:9 जब तुम्हारे पुरखाओं ने मुझे परखा: मेरी परीक्षा ली, मेरे धीरज को परखा, देखना चाहा कि मैं कितना सहन करता हूँ। ,"
  },
  {
    "id": 15465,
    "book": "psalms                                  ",
    "chapter": "95",
    "verse": "10",
    "text": "चालीस वर्ष तक मैं उस पीढ़ी के लोगों से रूठा रहा,"
  },
  {
    "id": 15466,
    "book": "psalms                                  ",
    "chapter": "95",
    "verse": "11",
    "text": "इस कारण मैंने क्रोध में आकर शपथ खाई कि"
  }
]
