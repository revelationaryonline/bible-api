[
  {
    "id": 14862,
    "book": "psalms                                  ",
    "chapter": "65",
    "verse": "1",
    "text": "हे परमेश्वर, सिय्योन में स्तुति तेरी बाट जोहती है;"
  },
  {
    "id": 14863,
    "book": "psalms                                  ",
    "chapter": "65",
    "verse": "2",
    "text": "हे प्रार्थना के सुननेवाले!"
  },
  {
    "id": 14864,
    "book": "psalms                                  ",
    "chapter": "65",
    "verse": "3",
    "text": "अधर्म के काम मुझ पर प्रबल हुए हैं;"
  },
  {
    "id": 14865,
    "book": "psalms                                  ",
    "chapter": "65",
    "verse": "4",
    "text": "क्या ही धन्य है वह, जिसको तू चुनकर अपने समीप आने देता है,"
  },
  {
    "id": 14866,
    "book": "psalms                                  ",
    "chapter": "65",
    "verse": "5",
    "text": "हे हमारे उद्धारकर्ता परमेश्वर,"
  },
  {
    "id": 14867,
    "book": "psalms                                  ",
    "chapter": "65",
    "verse": "6",
    "text": "तू जो पराक्रम का फेंटा कसे हुए,"
  },
  {
    "id": 14868,
    "book": "psalms                                  ",
    "chapter": "65",
    "verse": "7",
    "text": "तू जो समुद्र का महाशब्द, उसकी तरंगों का महाशब्द,"
  },
  {
    "id": 14869,
    "book": "psalms                                  ",
    "chapter": "65",
    "verse": "8",
    "text": "इसलिए दूर-दूर देशों के रहनेवाले तेरे चिन्ह देखकर डर गए हैं;"
  },
  {
    "id": 14870,
    "book": "psalms                                  ",
    "chapter": "65",
    "verse": "9",
    "text": "तू भूमि की सुधि लेकर उसको सींचता है,"
  },
  {
    "id": 14871,
    "book": "psalms                                  ",
    "chapter": "65",
    "verse": "10",
    "text": "तू रेघारियों को भली भाँति सींचता है,"
  },
  {
    "id": 14872,
    "book": "psalms                                  ",
    "chapter": "65",
    "verse": "11",
    "text": "तेरी भलाइयों से, तू वर्ष को मुकुट पहनता है;"
  },
  {
    "id": 14873,
    "book": "psalms                                  ",
    "chapter": "65",
    "verse": "12",
    "text": "वे जंगल की चराइयों में हरियाली फूट पड़ती हैं;"
  },
  {
    "id": 14874,
    "book": "psalms                                  ",
    "chapter": "65",
    "verse": "13",
    "text": "चराइयाँ भेड़-बकरियों से भरी हुई हैं;"
  }
]
