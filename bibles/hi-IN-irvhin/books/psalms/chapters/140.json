[
  {
    "id": 16265,
    "book": "psalms                                  ",
    "chapter": "140",
    "verse": "1",
    "text": "हे यहोवा, मुझ को बुरे मनुष्य से बचा ले;"
  },
  {
    "id": 16266,
    "book": "psalms                                  ",
    "chapter": "140",
    "verse": "2",
    "text": "क्योंकि उन्होंने मन में बुरी कल्पनाएँ की हैं;"
  },
  {
    "id": 16267,
    "book": "psalms                                  ",
    "chapter": "140",
    "verse": "3",
    "text": "उनका बोलना साँप के काटने के समान है,"
  },
  {
    "id": 16268,
    "book": "psalms                                  ",
    "chapter": "140",
    "verse": "4",
    "text": "हे यहोवा, मुझे दुष्ट के हाथों से बचा ले;"
  },
  {
    "id": 16269,
    "book": "psalms                                  ",
    "chapter": "140",
    "verse": "5",
    "text": "घमण्डियों ने मेरे लिये फंदा और पासे लगाए,"
  },
  {
    "id": 16270,
    "book": "psalms                                  ",
    "chapter": "140",
    "verse": "6",
    "text": "हे यहोवा, मैंने तुझ से कहा है कि तू मेरा परमेश्वर है;"
  },
  {
    "id": 16271,
    "book": "psalms                                  ",
    "chapter": "140",
    "verse": "7",
    "text": "हे यहोवा प्रभु, हे मेरे सामर्थी उद्धारकर्ता,"
  },
  {
    "id": 16272,
    "book": "psalms                                  ",
    "chapter": "140",
    "verse": "8",
    "text": "हे यहोवा, दुष्ट की इच्छा को पूरी न होने दे140:8 दुष्ट की इच्छा को पूरी न होने दे: अर्थात् जिस बात पर विचार किया जा रहा है। मेरे विनाश की उनकी इच्छा पूरी न हो। मेरे विरुद्ध उनकी योजना सफल न होने दे।,"
  },
  {
    "id": 16273,
    "book": "psalms                                  ",
    "chapter": "140",
    "verse": "9",
    "text": "मेरे घेरनेवालों के सिर पर उन्हीं का विचारा हुआ उत्पात पड़े!"
  },
  {
    "id": 16274,
    "book": "psalms                                  ",
    "chapter": "140",
    "verse": "10",
    "text": "उन पर अंगारे डाले जाएँ!"
  },
  {
    "id": 16275,
    "book": "psalms                                  ",
    "chapter": "140",
    "verse": "11",
    "text": "बकवादी पृथ्वी पर स्थिर नहीं होने का;"
  },
  {
    "id": 16276,
    "book": "psalms                                  ",
    "chapter": "140",
    "verse": "12",
    "text": "हे यहोवा, मुझे निश्चय है कि तू दीन जन का"
  },
  {
    "id": 16277,
    "book": "psalms                                  ",
    "chapter": "140",
    "verse": "13",
    "text": "निःसन्देह धर्मी तेरे नाम का धन्यवाद करने पाएँगे;"
  }
]
