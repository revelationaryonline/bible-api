[
  {
    "id": 14770,
    "book": "psalms                                  ",
    "chapter": "57",
    "verse": "1",
    "text": "हे परमेश्वर, मुझ पर दया कर, मुझ पर दया कर,"
  },
  {
    "id": 14771,
    "book": "psalms                                  ",
    "chapter": "57",
    "verse": "2",
    "text": "मैं परमप्रधान परमेश्वर को पुकारूँगा,"
  },
  {
    "id": 14772,
    "book": "psalms                                  ",
    "chapter": "57",
    "verse": "3",
    "text": "परमेश्वर स्वर्ग से भेजकर मुझे बचा लेगा,"
  },
  {
    "id": 14773,
    "book": "psalms                                  ",
    "chapter": "57",
    "verse": "4",
    "text": "मेरा प्राण सिंहों के बीच में है57:4 मेरा प्राण सिंहों के बीच में है: अर्थात् ऐसे मनुष्यों के मध्य हूँ जो शेरों के सामान है- खूंखार, बर्बर मनुष्य। ,"
  },
  {
    "id": 14774,
    "book": "psalms                                  ",
    "chapter": "57",
    "verse": "5",
    "text": "हे परमेश्वर तू स्वर्ग के ऊपर अति महान और तेजोमय है,"
  },
  {
    "id": 14775,
    "book": "psalms                                  ",
    "chapter": "57",
    "verse": "6",
    "text": "उन्होंने मेरे पैरों के लिये जाल बिछाया है;"
  },
  {
    "id": 14776,
    "book": "psalms                                  ",
    "chapter": "57",
    "verse": "7",
    "text": "हे परमेश्वर, मेरा मन स्थिर है, मेरा मन स्थिर है;"
  },
  {
    "id": 14777,
    "book": "psalms                                  ",
    "chapter": "57",
    "verse": "8",
    "text": "हे मेरे मन जाग जा! हे सारंगी और वीणा जाग जाओ;"
  },
  {
    "id": 14778,
    "book": "psalms                                  ",
    "chapter": "57",
    "verse": "9",
    "text": "हे प्रभु, मैं देश-देश के लोगों के बीच तेरा धन्यवाद करूँगा;"
  },
  {
    "id": 14779,
    "book": "psalms                                  ",
    "chapter": "57",
    "verse": "10",
    "text": "क्योंकि तेरी करुणा स्वर्ग तक बड़ी है,"
  },
  {
    "id": 14780,
    "book": "psalms                                  ",
    "chapter": "57",
    "verse": "11",
    "text": "हे परमेश्वर, तू स्वर्ग के ऊपर अति महान है!"
