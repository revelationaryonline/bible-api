[
  {
    "id": 14357,
    "book": "psalms                                  ",
    "chapter": "32",
    "verse": "1",
    "text": "क्या ही धन्य है वह जिसका अपराध"
  },
  {
    "id": 14358,
    "book": "psalms                                  ",
    "chapter": "32",
    "verse": "2",
    "text": "क्या ही धन्य है वह मनुष्य जिसके अधर्म"
  },
  {
    "id": 14359,
    "book": "psalms                                  ",
    "chapter": "32",
    "verse": "3",
    "text": "जब मैं चुप रहा"
  },
  {
    "id": 14360,
    "book": "psalms                                  ",
    "chapter": "32",
    "verse": "4",
    "text": "क्योंकि रात-दिन मैं तेरे हाथ के नीचे दबा रहा;"
  },
  {
    "id": 14361,
    "book": "psalms                                  ",
    "chapter": "32",
    "verse": "5",
    "text": "जब मैंने अपना पाप तुझ पर प्रगट किया"
  },
  {
    "id": 14362,
    "book": "psalms                                  ",
    "chapter": "32",
    "verse": "6",
    "text": "इस कारण हर एक भक्त तुझ से ऐसे समय"
  },
  {
    "id": 14363,
    "book": "psalms                                  ",
    "chapter": "32",
    "verse": "7",
    "text": "तू मेरे छिपने का स्थान है;"
  },
  {
    "id": 14364,
    "book": "psalms                                  ",
    "chapter": "32",
    "verse": "8",
    "text": "मैं तुझे बुद्धि दूँगा, और जिस मार्ग में तुझे"
  },
  {
    "id": 14365,
    "book": "psalms                                  ",
    "chapter": "32",
    "verse": "9",
    "text": "तुम घोड़े और खच्चर के समान न बनो जो समझ नहीं रखते,"
  },
  {
    "id": 14366,
    "book": "psalms                                  ",
    "chapter": "32",
    "verse": "10",
    "text": "दुष्ट को तो बहुत पीड़ा होगी;"
  },
  {
    "id": 14367,
    "book": "psalms                                  ",
    "chapter": "32",
    "verse": "11",
    "text": "हे धर्मियों यहोवा के कारण आनन्दित"
  }
]
