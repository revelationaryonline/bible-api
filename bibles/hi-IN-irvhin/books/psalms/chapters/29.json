[
  {
    "id": 14310,
    "book": "psalms                                  ",
    "chapter": "29",
    "verse": "1",
    "text": "हे परमेश्वर के पुत्रों, यहोवा का,"
  },
  {
    "id": 14311,
    "book": "psalms                                  ",
    "chapter": "29",
    "verse": "2",
    "text": "यहोवा के नाम की महिमा करो;"
  },
  {
    "id": 14312,
    "book": "psalms                                  ",
    "chapter": "29",
    "verse": "3",
    "text": "यहोवा की वाणी मेघों के ऊपर सुनाई देती है;"
  },
  {
    "id": 14313,
    "book": "psalms                                  ",
    "chapter": "29",
    "verse": "4",
    "text": "यहोवा की वाणी शक्तिशाली है,"
  },
  {
    "id": 14314,
    "book": "psalms                                  ",
    "chapter": "29",
    "verse": "5",
    "text": "यहोवा की वाणी देवदारों को तोड़ डालती है;"
  },
  {
    "id": 14315,
    "book": "psalms                                  ",
    "chapter": "29",
    "verse": "6",
    "text": "वह लबानोन को बछड़े के समान"
  },
  {
    "id": 14316,
    "book": "psalms                                  ",
    "chapter": "29",
    "verse": "7",
    "text": "यहोवा की वाणी आग की लपटों को चीरती है।"
  },
  {
    "id": 14317,
    "book": "psalms                                  ",
    "chapter": "29",
    "verse": "8",
    "text": "यहोवा की वाणी वन को हिला देती है,"
  },
  {
    "id": 14318,
    "book": "psalms                                  ",
    "chapter": "29",
    "verse": "9",
    "text": "यहोवा की वाणी से हिरनियों का गर्भपात हो जाता है।"
  },
  {
    "id": 14319,
    "book": "psalms                                  ",
    "chapter": "29",
    "verse": "10",
    "text": "जल-प्रलय के समय यहोवा विराजमान था;"
  },
  {
    "id": 14320,
    "book": "psalms                                  ",
    "chapter": "29",
    "verse": "11",
    "text": "यहोवा अपनी प्रजा को बल देगा;"
  }
]
