[
  {
    "id": 14734,
    "book": "psalms                                  ",
    "chapter": "55",
    "verse": "1",
    "text": "हे परमेश्वर, मेरी प्रार्थना की ओर कान लगा;"
  },
  {
    "id": 14735,
    "book": "psalms                                  ",
    "chapter": "55",
    "verse": "2",
    "text": "मेरी ओर ध्यान देकर, मुझे उत्तर दे;"
  },
  {
    "id": 14736,
    "book": "psalms                                  ",
    "chapter": "55",
    "verse": "3",
    "text": "क्योंकि शत्रु कोलाहल"
  },
  {
    "id": 14737,
    "book": "psalms                                  ",
    "chapter": "55",
    "verse": "4",
    "text": "मेरा मन भीतर ही भीतर संकट में है55:4 मेरा मन भीतर ही भीतर संकट में है: बोझ से दबा और दु:खी अर्थात् बहुत व्यथित है।,"
  },
  {
    "id": 14738,
    "book": "psalms                                  ",
    "chapter": "55",
    "verse": "5",
    "text": "भय और कंपन ने मुझे पकड़ लिया है,"
  },
  {
    "id": 14739,
    "book": "psalms                                  ",
    "chapter": "55",
    "verse": "6",
    "text": "तब मैंने कहा, “भला होता कि मेरे कबूतर के से पंख होते"
  },
  {
    "id": 14740,
    "book": "psalms                                  ",
    "chapter": "55",
    "verse": "7",
    "text": "देखो, फिर तो मैं उड़ते-उड़ते दूर निकल जाता"
  },
  {
    "id": 14741,
    "book": "psalms                                  ",
    "chapter": "55",
    "verse": "8",
    "text": "मैं प्रचण्ड बयार और आँधी के झोंके से"
  },
  {
    "id": 14742,
    "book": "psalms                                  ",
    "chapter": "55",
    "verse": "9",
    "text": "हे प्रभु, उनका सत्यानाश कर,"
  },
  {
    "id": 14743,
    "book": "psalms                                  ",
    "chapter": "55",
    "verse": "10",
    "text": "रात-दिन वे उसकी शहरपनाह पर चढ़कर चारों ओर घूमते हैं;"
  },
  {
    "id": 14744,
    "book": "psalms                                  ",
    "chapter": "55",
    "verse": "11",
    "text": "उसके भीतर दुष्टता ने बसेरा डाला है;"
  },
  {
    "id": 14745,
    "book": "psalms                                  ",
    "chapter": "55",
    "verse": "12",
    "text": "जो मेरी नामधराई करता है वह शत्रु नहीं था,"
  },
  {
    "id": 14746,
    "book": "psalms                                  ",
    "chapter": "55",
    "verse": "13",
    "text": "परन्तु वह तो तू ही था जो मेरी बराबरी का मनुष्य"
  },
  {
    "id": 14747,
    "book": "psalms                                  ",
    "chapter": "55",
    "verse": "14",
    "text": "हम दोनों आपस में कैसी मीठी-मीठी बातें करते थे;"
  },
  {
    "id": 14748,
    "book": "psalms                                  ",
    "chapter": "55",
    "verse": "15",
    "text": "उनको मृत्यु अचानक आ दबाए; वे जीवित ही अधोलोक में उतर जाएँ;"
  },
  {
    "id": 14749,
    "book": "psalms                                  ",
    "chapter": "55",
    "verse": "16",
    "text": "परन्तु मैं तो परमेश्वर को पुकारूँगा;"
  },
  {
    "id": 14750,
    "book": "psalms                                  ",
    "chapter": "55",
    "verse": "17",
    "text": "साँझ को, भोर को, दोपहर को, तीनों पहर"
  },
  {
    "id": 14751,
    "book": "psalms                                  ",
    "chapter": "55",
    "verse": "18",
    "text": "जो लड़ाई मेरे विरुद्ध मची थी उससे उसने मुझे कुशल के साथ बचा लिया है।"
  },
  {
    "id": 14752,
    "book": "psalms                                  ",
    "chapter": "55",
    "verse": "19",
    "text": "परमेश्वर जो आदि से विराजमान है यह सुनकर उनको उत्तर देगा। (सेला)"
  },
  {
    "id": 14753,
    "book": "psalms                                  ",
    "chapter": "55",
    "verse": "20",
    "text": "उसने अपने मेल रखनेवालों पर भी हाथ उठाया है,"
  },
  {
    "id": 14754,
    "book": "psalms                                  ",
    "chapter": "55",
    "verse": "21",
    "text": "उसके मुँह की बातें तो मक्खन सी चिकनी थी"
  },
  {
    "id": 14755,
    "book": "psalms                                  ",
    "chapter": "55",
    "verse": "22",
    "text": "अपना बोझ यहोवा पर डाल दे वह तुझे सम्भालेगा;"
  },
  {
    "id": 14756,
    "book": "psalms                                  ",
    "chapter": "55",
    "verse": "23",
    "text": "परन्तु हे परमेश्वर, तू उन लोगों को विनाश के गड्ढे में गिरा देगा;"
  }
]
