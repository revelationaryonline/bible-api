[
  {
    "id": 15095,
    "book": "psalms                                  ",
    "chapter": "77",
    "verse": "1",
    "text": "मैं परमेश्वर की दुहाई चिल्ला चिल्लाकर दूँगा,"
  },
  {
    "id": 15096,
    "book": "psalms                                  ",
    "chapter": "77",
    "verse": "2",
    "text": "संकट के दिन मैं प्रभु की खोज में लगा रहा;"
  },
  {
    "id": 15097,
    "book": "psalms                                  ",
    "chapter": "77",
    "verse": "3",
    "text": "मैं परमेश्वर का स्मरण कर करके कराहता हूँ;"
  },
  {
    "id": 15098,
    "book": "psalms                                  ",
    "chapter": "77",
    "verse": "4",
    "text": "तू मुझे झपकी लगने नहीं देता;"
  },
  {
    "id": 15099,
    "book": "psalms                                  ",
    "chapter": "77",
    "verse": "5",
    "text": "मैंने प्राचीनकाल के दिनों को,"
  },
  {
    "id": 15100,
    "book": "psalms                                  ",
    "chapter": "77",
    "verse": "6",
    "text": "मैं रात के समय अपने गीत को स्मरण करता;"
  },
  {
    "id": 15101,
    "book": "psalms                                  ",
    "chapter": "77",
    "verse": "7",
    "text": "“क्या प्रभु युग-युग के लिये मुझे छोड़ देगा;"
  },
  {
    "id": 15102,
    "book": "psalms                                  ",
    "chapter": "77",
    "verse": "8",
    "text": "क्या उसकी करुणा सदा के लिये जाती रही?"
  },
  {
    "id": 15103,
    "book": "psalms                                  ",
    "chapter": "77",
    "verse": "9",
    "text": "क्या परमेश्वर अनुग्रह करना भूल गया?"
  },
  {
    "id": 15104,
    "book": "psalms                                  ",
    "chapter": "77",
    "verse": "10",
    "text": "मैंने कहा, “यह तो मेरा दुःख है, कि परमप्रधान का दाहिना हाथ बदल गया है।”"
  },
  {
    "id": 15105,
    "book": "psalms                                  ",
    "chapter": "77",
    "verse": "11",
    "text": "मैं यहोवा के बड़े कामों की चर्चा करूँगा;"
  },
  {
    "id": 15106,
    "book": "psalms                                  ",
    "chapter": "77",
    "verse": "12",
    "text": "मैं तेरे सब कामों पर ध्यान करूँगा,"
  },
  {
    "id": 15107,
    "book": "psalms                                  ",
    "chapter": "77",
    "verse": "13",
    "text": "हे परमेश्वर तेरी गति पवित्रता की है।"
  },
  {
    "id": 15108,
    "book": "psalms                                  ",
    "chapter": "77",
    "verse": "14",
    "text": "अद्भुत काम करनेवाला परमेश्वर तू ही है,"
  },
  {
    "id": 15109,
    "book": "psalms                                  ",
    "chapter": "77",
    "verse": "15",
    "text": "तूने अपने भुजबल से अपनी प्रजा,"
  },
  {
    "id": 15110,
    "book": "psalms                                  ",
    "chapter": "77",
    "verse": "16",
    "text": "हे परमेश्वर, समुद्र ने तुझे देखा77:16 समुद्र ने तुझे देखा: लाल सागर और यरदन नदी। ,"
  },
  {
    "id": 15111,
    "book": "psalms                                  ",
    "chapter": "77",
    "verse": "17",
    "text": "मेघों से बड़ी वर्षा हुई;"
  },
  {
    "id": 15112,
    "book": "psalms                                  ",
    "chapter": "77",
    "verse": "18",
    "text": "बवंडर में तेरे गरजने का शब्द सुन पड़ा था;"
  },
  {
    "id": 15113,
    "book": "psalms                                  ",
    "chapter": "77",
    "verse": "19",
    "text": "तेरा मार्ग समुद्र में है,"
  },
  {
    "id": 15114,
    "book": "psalms                                  ",
    "chapter": "77",
    "verse": "20",
    "text": "तूने मूसा और हारून के द्वारा,"
  }
]
