[
  {
    "id": 14616,
    "book": "psalms                                  ",
    "chapter": "46",
    "verse": "1",
    "text": "परमेश्वर हमारा शरणस्थान और बल है,"
  },
  {
    "id": 14617,
    "book": "psalms                                  ",
    "chapter": "46",
    "verse": "2",
    "text": "इस कारण हमको कोई भय नहीं चाहे पृथ्वी"
  },
  {
    "id": 14618,
    "book": "psalms                                  ",
    "chapter": "46",
    "verse": "3",
    "text": "चाहे समुद्र गरजें और फेन उठाए,"
  },
  {
    "id": 14619,
    "book": "psalms                                  ",
    "chapter": "46",
    "verse": "4",
    "text": "एक नदी है जिसकी नहरों से परमेश्वर के"
  },
  {
    "id": 14620,
    "book": "psalms                                  ",
    "chapter": "46",
    "verse": "5",
    "text": "परमेश्वर उस नगर के बीच में है, वह कभी"
  },
  {
    "id": 14621,
    "book": "psalms                                  ",
    "chapter": "46",
    "verse": "6",
    "text": "जाति-जाति के लोग झल्ला उठे, राज्य-राज्य"
  },
  {
    "id": 14622,
    "book": "psalms                                  ",
    "chapter": "46",
    "verse": "7",
    "text": "सेनाओं का यहोवा हमारे संग है;"
  },
  {
    "id": 14623,
    "book": "psalms                                  ",
    "chapter": "46",
    "verse": "8",
    "text": "आओ, यहोवा के महाकर्म देखो,"
  },
  {
    "id": 14624,
    "book": "psalms                                  ",
    "chapter": "46",
    "verse": "9",
    "text": "वह पृथ्वी की छोर तक लड़ाइयों को मिटाता है;"
  },
  {
    "id": 14625,
    "book": "psalms                                  ",
    "chapter": "46",
    "verse": "10",
    "text": "“चुप हो जाओ, और जान लो कि मैं ही परमेश्वर हूँ46:10 जान लो कि मैं ही परमेश्वर हूँ: देखो मैंने क्या-क्या किया जो मेरे परमेश्वर होने का प्रमाण है।।"
  },
  {
    "id": 14626,
    "book": "psalms                                  ",
    "chapter": "46",
    "verse": "11",
    "text": "सेनाओं का यहोवा हमारे संग है;"
  }
]
