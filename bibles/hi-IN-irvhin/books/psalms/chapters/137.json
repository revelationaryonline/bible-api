[
  {
    "id": 16224,
    "book": "psalms                                  ",
    "chapter": "137",
    "verse": "1",
    "text": "बाबेल की नदियों के किनारे हम लोग बैठ गए,"
  },
  {
    "id": 16225,
    "book": "psalms                                  ",
    "chapter": "137",
    "verse": "2",
    "text": "उसके बीच के मजनू वृक्षों पर"
  },
  {
    "id": 16226,
    "book": "psalms                                  ",
    "chapter": "137",
    "verse": "3",
    "text": "क्योंकि जो हमको बन्दी बनाकर ले गए थे,"
  },
  {
    "id": 16227,
    "book": "psalms                                  ",
    "chapter": "137",
    "verse": "4",
    "text": "हम यहोवा के गीत को,"
  },
  {
    "id": 16228,
    "book": "psalms                                  ",
    "chapter": "137",
    "verse": "5",
    "text": "हे यरूशलेम, यदि मैं तुझे भूल जाऊँ,"
  },
  {
    "id": 16229,
    "book": "psalms                                  ",
    "chapter": "137",
    "verse": "6",
    "text": "यदि मैं तुझे स्मरण न रखूँ,"
  },
  {
    "id": 16230,
    "book": "psalms                                  ",
    "chapter": "137",
    "verse": "7",
    "text": "हे यहोवा, यरूशलेम के गिराए जाने के दिन को एदोमियों के विरुद्ध स्मरण कर,"
  },
  {
    "id": 16231,
    "book": "psalms                                  ",
    "chapter": "137",
    "verse": "8",
    "text": "हे बाबेल, तू जो जल्द उजड़नेवाली है,"
  },
  {
    "id": 16232,
    "book": "psalms                                  ",
    "chapter": "137",
    "verse": "9",
    "text": "क्या ही धन्य वह होगा, जो तेरे बच्चों को पकड़कर,"
  }
]
