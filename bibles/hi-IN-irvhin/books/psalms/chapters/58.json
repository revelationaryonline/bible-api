[
  {
    "id": 14781,
    "book": "psalms                                  ",
    "chapter": "58",
    "verse": "1",
    "text": "हे मनुष्यों, क्या तुम सचमुच धार्मिकता की बात बोलते हो?"
  },
  {
    "id": 14782,
    "book": "psalms                                  ",
    "chapter": "58",
    "verse": "2",
    "text": "नहीं, तुम मन ही मन में कुटिल काम करते हो;"
  },
  {
    "id": 14783,
    "book": "psalms                                  ",
    "chapter": "58",
    "verse": "3",
    "text": "दुष्ट लोग जन्मते ही पराए हो जाते हैं,"
  },
  {
    "id": 14784,
    "book": "psalms                                  ",
    "chapter": "58",
    "verse": "4",
    "text": "उनमें सर्प का सा विष है;"
  },
  {
    "id": 14785,
    "book": "psalms                                  ",
    "chapter": "58",
    "verse": "5",
    "text": "और सपेरा कितनी ही निपुणता से क्यों न मंत्र पढ़े,"
  },
  {
    "id": 14786,
    "book": "psalms                                  ",
    "chapter": "58",
    "verse": "6",
    "text": "हे परमेश्वर, उनके मुँह में से दाँतों को तोड़ दे;"
  },
  {
    "id": 14787,
    "book": "psalms                                  ",
    "chapter": "58",
    "verse": "7",
    "text": "वे घुलकर बहते हुए पानी के समान हो जाएँ;"
  },
  {
    "id": 14788,
    "book": "psalms                                  ",
    "chapter": "58",
    "verse": "8",
    "text": "वे घोंघे के समान हो जाएँ जो घुलकर नाश हो जाता है,"
  },
  {
    "id": 14789,
    "book": "psalms                                  ",
    "chapter": "58",
    "verse": "9",
    "text": "इससे पहले कि तुम्हारी हाँड़ियों में काँटों की आँच लगे,"
  },
  {
    "id": 14790,
    "book": "psalms                                  ",
    "chapter": "58",
    "verse": "10",
    "text": "परमेश्वर का ऐसा पलटा देखकर आनन्दित होगा;"
  },
  {
    "id": 14791,
    "book": "psalms                                  ",
    "chapter": "58",
    "verse": "11",
    "text": "तब मनुष्य कहने लगेंगे, निश्चय धर्मी के लिये फल है;"
  }
]
