[
  {
    "id": 14094,
    "book": "psalms                                  ",
    "chapter": "16",
    "verse": "1",
    "text": "हे परमेश्वर मेरी रक्षा कर,"
  },
  {
    "id": 14095,
    "book": "psalms                                  ",
    "chapter": "16",
    "verse": "2",
    "text": "मैंने यहोवा से कहा, “तू ही मेरा प्रभु है;"
  },
  {
    "id": 14096,
    "book": "psalms                                  ",
    "chapter": "16",
    "verse": "3",
    "text": "पृथ्वी पर जो पवित्र लोग हैं,"
  },
  {
    "id": 14097,
    "book": "psalms                                  ",
    "chapter": "16",
    "verse": "4",
    "text": "जो पराए देवता के पीछे भागते हैं उनका दुःख बढ़ जाएगा;"
  },
  {
    "id": 14098,
    "book": "psalms                                  ",
    "chapter": "16",
    "verse": "5",
    "text": "यहोवा तू मेरा चुना हुआ भाग और मेरा कटोरा है;"
  },
  {
    "id": 14099,
    "book": "psalms                                  ",
    "chapter": "16",
    "verse": "6",
    "text": "मेरे लिये माप की डोरी मनभावने स्थान में पड़ी,"
  },
  {
    "id": 14100,
    "book": "psalms                                  ",
    "chapter": "16",
    "verse": "7",
    "text": "मैं यहोवा को धन्य कहता हूँ,"
  },
  {
    "id": 14101,
    "book": "psalms                                  ",
    "chapter": "16",
    "verse": "8",
    "text": "मैंने यहोवा को निरन्तर अपने सम्मुख रखा है16:8 मैंने यहोवा को निरन्तर अपने सम्मुख रखा है: मैंने स्वयं को सदैव परमेश्वर की उपस्थिति में माना है; मैंने सदैव यही माना है कि उसकी दृष्टि मुझ पर है। :"
  },
  {
    "id": 14102,
    "book": "psalms                                  ",
    "chapter": "16",
    "verse": "9",
    "text": "इस कारण मेरा हृदय आनन्दित"
  },
  {
    "id": 14103,
    "book": "psalms                                  ",
    "chapter": "16",
    "verse": "10",
    "text": "क्योंकि तू मेरे प्राण को अधोलोक में न छोड़ेगा,"
  },
  {
    "id": 14104,
    "book": "psalms                                  ",
    "chapter": "16",
    "verse": "11",
    "text": "तू मुझे जीवन का रास्ता दिखाएगा;"
  }
]
