[
  {
    "id": 15002,
    "book": "psalms                                  ",
    "chapter": "72",
    "verse": "1",
    "text": "हे परमेश्वर, राजा को अपना नियम बता,"
  },
  {
    "id": 15003,
    "book": "psalms                                  ",
    "chapter": "72",
    "verse": "2",
    "text": "वह तेरी प्रजा का न्याय धार्मिकता से,"
  },
  {
    "id": 15004,
    "book": "psalms                                  ",
    "chapter": "72",
    "verse": "3",
    "text": "पहाड़ों और पहाड़ियों से प्रजा के लिये,"
  },
  {
    "id": 15005,
    "book": "psalms                                  ",
    "chapter": "72",
    "verse": "4",
    "text": "वह प्रजा के दीन लोगों का न्याय करेगा, और दरिद्र लोगों को बचाएगा;"
  },
  {
    "id": 15006,
    "book": "psalms                                  ",
    "chapter": "72",
    "verse": "5",
    "text": "जब तक सूर्य और चन्द्रमा बने रहेंगे"
  },
  {
    "id": 15007,
    "book": "psalms                                  ",
    "chapter": "72",
    "verse": "6",
    "text": "वह घास की खूँटी पर बरसने वाले मेंह,"
  },
  {
    "id": 15008,
    "book": "psalms                                  ",
    "chapter": "72",
    "verse": "7",
    "text": "उसके दिनों में धर्मी फूले फलेंगे,"
  },
  {
    "id": 15009,
    "book": "psalms                                  ",
    "chapter": "72",
    "verse": "8",
    "text": "वह समुद्र से समुद्र तक"
  },
  {
    "id": 15010,
    "book": "psalms                                  ",
    "chapter": "72",
    "verse": "9",
    "text": "उसके सामने जंगल के रहनेवाले घुटने टेकेंगे,"
  },
  {
    "id": 15011,
    "book": "psalms                                  ",
    "chapter": "72",
    "verse": "10",
    "text": "तर्शीश और द्वीप-द्वीप के राजा भेंट ले आएँगे,"
  },
  {
    "id": 15012,
    "book": "psalms                                  ",
    "chapter": "72",
    "verse": "11",
    "text": "सब राजा उसको दण्डवत् करेंगे,"
  },
  {
    "id": 15013,
    "book": "psalms                                  ",
    "chapter": "72",
    "verse": "12",
    "text": "क्योंकि वह दुहाई देनेवाले दरिद्र का,"
  },
  {
    "id": 15014,
    "book": "psalms                                  ",
    "chapter": "72",
    "verse": "13",
    "text": "वह कंगाल और दरिद्र पर तरस खाएगा,"
  },
  {
    "id": 15015,
    "book": "psalms                                  ",
    "chapter": "72",
    "verse": "14",
    "text": "वह उनके प्राणों को अत्याचार और उपद्रव से छुड़ा लेगा;"
  },
  {
    "id": 15016,
    "book": "psalms                                  ",
    "chapter": "72",
    "verse": "15",
    "text": "वह तो जीवित रहेगा और शेबा के सोने में से उसको दिया जाएगा।"
  },
  {
    "id": 15017,
    "book": "psalms                                  ",
    "chapter": "72",
    "verse": "16",
    "text": "देश में पहाड़ों की चोटियों पर बहुत सा अन्न होगा;"
  },
  {
    "id": 15018,
    "book": "psalms                                  ",
    "chapter": "72",
    "verse": "17",
    "text": "उसका नाम सदा सर्वदा बना रहेगा;"
  },
  {
    "id": 15019,
    "book": "psalms                                  ",
    "chapter": "72",
    "verse": "18",
    "text": "धन्य है यहोवा परमेश्वर, जो इस्राएल का परमेश्वर है;"
  },
  {
    "id": 15020,
    "book": "psalms                                  ",
    "chapter": "72",
    "verse": "19",
    "text": "उसका महिमायुक्त नाम सर्वदा धन्य रहेगा;"
  },
  {
    "id": 15021,
    "book": "psalms                                  ",
    "chapter": "72",
    "verse": "20",
    "text": "यिशै के पुत्र दाऊद की प्रार्थना समाप्त हुई।"
  }
]
