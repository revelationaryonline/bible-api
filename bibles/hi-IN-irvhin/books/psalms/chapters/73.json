[
  {
    "id": 15022,
    "book": "psalms                                  ",
    "chapter": "73",
    "verse": "1",
    "text": "सचमुच इस्राएल के लिये अर्थात् शुद्ध मनवालों के लिये परमेश्वर भला है।"
  },
  {
    "id": 15023,
    "book": "psalms                                  ",
    "chapter": "73",
    "verse": "2",
    "text": "मेरे डग तो उखड़ना चाहते थे,"
  },
  {
    "id": 15024,
    "book": "psalms                                  ",
    "chapter": "73",
    "verse": "3",
    "text": "क्योंकि जब मैं दुष्टों का कुशल देखता था,"
  },
  {
    "id": 15025,
    "book": "psalms                                  ",
    "chapter": "73",
    "verse": "4",
    "text": "क्योंकि उनकी मृत्यु में वेदनाएँ नहीं होतीं,"
  },
  {
    "id": 15026,
    "book": "psalms                                  ",
    "chapter": "73",
    "verse": "5",
    "text": "उनको दूसरे मनुष्यों के समान कष्ट नहीं होता;"
  },
  {
    "id": 15027,
    "book": "psalms                                  ",
    "chapter": "73",
    "verse": "6",
    "text": "इस कारण अहंकार उनके गले का हार बना है;"
  },
  {
    "id": 15028,
    "book": "psalms                                  ",
    "chapter": "73",
    "verse": "7",
    "text": "उनकी आँखें चर्बी से झलकती हैं,"
  },
  {
    "id": 15029,
    "book": "psalms                                  ",
    "chapter": "73",
    "verse": "8",
    "text": "वे ठट्ठा मारते हैं, और दुष्टता से हिंसा की बात बोलते हैं;"
  },
  {
    "id": 15030,
    "book": "psalms                                  ",
    "chapter": "73",
    "verse": "9",
    "text": "वे मानो स्वर्ग में बैठे हुए बोलते हैं73:9 वे मानो स्वर्ग में बैठे हुए बोलते हैं: वे ऐसे बातें करते हैं कि मानो वे स्वर्ग में विराजमान हैं, जैसे कि मानो वे अधिकार सम्पन्न हैं। ,"
  },
  {
    "id": 15031,
    "book": "psalms                                  ",
    "chapter": "73",
    "verse": "10",
    "text": "इसलिए उसकी प्रजा इधर लौट आएगी,"
  },
  {
    "id": 15032,
    "book": "psalms                                  ",
    "chapter": "73",
    "verse": "11",
    "text": "फिर वे कहते हैं, “परमेश्वर कैसे जानता है?"
  },
  {
    "id": 15033,
    "book": "psalms                                  ",
    "chapter": "73",
    "verse": "12",
    "text": "देखो, ये तो दुष्ट लोग हैं;"
  },
  {
    "id": 15034,
    "book": "psalms                                  ",
    "chapter": "73",
    "verse": "13",
    "text": "निश्चय, मैंने अपने हृदय को व्यर्थ शुद्ध किया"
  },
  {
    "id": 15035,
    "book": "psalms                                  ",
    "chapter": "73",
    "verse": "14",
    "text": "क्योंकि मैं दिन भर मार खाता आया हूँ"
  },
  {
    "id": 15036,
    "book": "psalms                                  ",
    "chapter": "73",
    "verse": "15",
    "text": "यदि मैंने कहा होता, “मैं ऐसा कहूँगा”,"
  },
  {
    "id": 15037,
    "book": "psalms                                  ",
    "chapter": "73",
    "verse": "16",
    "text": "जब मैं सोचने लगा कि इसे मैं कैसे समझूँ,"
  },
  {
    "id": 15038,
    "book": "psalms                                  ",
    "chapter": "73",
    "verse": "17",
    "text": "जब तक कि मैंने परमेश्वर के पवित्रस्थान में जाकर"
  },
  {
    "id": 15039,
    "book": "psalms                                  ",
    "chapter": "73",
    "verse": "18",
    "text": "निश्चय तू उन्हें फिसलनेवाले स्थानों में रखता है;"
  },
  {
    "id": 15040,
    "book": "psalms                                  ",
    "chapter": "73",
    "verse": "19",
    "text": "वे क्षण भर में कैसे उजड़ गए हैं!"
  },
  {
    "id": 15041,
    "book": "psalms                                  ",
    "chapter": "73",
    "verse": "20",
    "text": "जैसे जागनेवाला स्वप्न को तुच्छ जानता है,"
  },
  {
    "id": 15042,
    "book": "psalms                                  ",
    "chapter": "73",
    "verse": "21",
    "text": "मेरा मन तो कड़वा हो गया था,"
  },
  {
    "id": 15043,
    "book": "psalms                                  ",
    "chapter": "73",
    "verse": "22",
    "text": "मैं अबोध और नासमझ था,"
  },
  {
    "id": 15044,
    "book": "psalms                                  ",
    "chapter": "73",
    "verse": "23",
    "text": "तो भी मैं निरन्तर तेरे संग ही था;"
  },
  {
    "id": 15045,
    "book": "psalms                                  ",
    "chapter": "73",
    "verse": "24",
    "text": "तू सम्मति देता हुआ, मेरी अगुआई करेगा,"
  },
  {
    "id": 15046,
    "book": "psalms                                  ",
    "chapter": "73",
    "verse": "25",
    "text": "स्वर्ग में मेरा और कौन है?"
  },
  {
    "id": 15047,
    "book": "psalms                                  ",
    "chapter": "73",
    "verse": "26",
    "text": "मेरे हृदय और मन दोनों तो हार गए हैं,"
  },
  {
    "id": 15048,
    "book": "psalms                                  ",
    "chapter": "73",
    "verse": "27",
    "text": "जो तुझ से दूर रहते हैं वे तो नाश होंगे;"
  },
  {
    "id": 15049,
    "book": "psalms                                  ",
    "chapter": "73",
    "verse": "28",
    "text": "परन्तु परमेश्वर के समीप रहना, यही मेरे लिये भला है;"
  }
]
