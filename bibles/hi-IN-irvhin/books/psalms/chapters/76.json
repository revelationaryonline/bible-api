[
  {
    "id": 15083,
    "book": "psalms                                  ",
    "chapter": "76",
    "verse": "1",
    "text": "परमेश्वर यहूदा में जाना गया है,"
  },
  {
    "id": 15084,
    "book": "psalms                                  ",
    "chapter": "76",
    "verse": "2",
    "text": "और उसका मण्डप शालेम में,"
  },
  {
    "id": 15085,
    "book": "psalms                                  ",
    "chapter": "76",
    "verse": "3",
    "text": "वहाँ उसने तीरों को,"
  },
  {
    "id": 15086,
    "book": "psalms                                  ",
    "chapter": "76",
    "verse": "4",
    "text": "हे परमेश्वर, तू तो ज्योतिर्मय है:"
  },
  {
    "id": 15087,
    "book": "psalms                                  ",
    "chapter": "76",
    "verse": "5",
    "text": "दृढ़ मनवाले लुट गए, और भारी नींद में पड़े हैं;"
  },
  {
    "id": 15088,
    "book": "psalms                                  ",
    "chapter": "76",
    "verse": "6",
    "text": "हे याकूब के परमेश्वर, तेरी घुड़की से,"
  },
  {
    "id": 15089,
    "book": "psalms                                  ",
    "chapter": "76",
    "verse": "7",
    "text": "केवल तू ही भययोग्य है;"
  },
  {
    "id": 15090,
    "book": "psalms                                  ",
    "chapter": "76",
    "verse": "8",
    "text": "तूने स्वर्ग से निर्णय सुनाया है;"
  },
  {
    "id": 15091,
    "book": "psalms                                  ",
    "chapter": "76",
    "verse": "9",
    "text": "जब परमेश्वर न्याय करने को,"
  },
  {
    "id": 15092,
    "book": "psalms                                  ",
    "chapter": "76",
    "verse": "10",
    "text": "निश्चय मनुष्य की जलजलाहट तेरी स्तुति का कारण हो जाएगी,"
  },
  {
    "id": 15093,
    "book": "psalms                                  ",
    "chapter": "76",
    "verse": "11",
    "text": "अपने परमेश्वर यहोवा की मन्नत मानो, और पूरी भी करो;"
  },
  {
    "id": 15094,
    "book": "psalms                                  ",
    "chapter": "76",
    "verse": "12",
    "text": "वह तो प्रधानों का अभिमान मिटा देगा;"
  }
]
