[
  {
    "id": 14829,
    "book": "psalms                                  ",
    "chapter": "62",
    "verse": "1",
    "text": "सचमुच मैं चुपचाप होकर परमेश्वर की ओर मन लगाए हूँ"
  },
  {
    "id": 14830,
    "book": "psalms                                  ",
    "chapter": "62",
    "verse": "2",
    "text": "सचमुच वही, मेरी चट्टान और मेरा उद्धार है,"
  },
  {
    "id": 14831,
    "book": "psalms                                  ",
    "chapter": "62",
    "verse": "3",
    "text": "तुम कब तक एक पुरुष पर धावा करते रहोगे,"
  },
  {
    "id": 14832,
    "book": "psalms                                  ",
    "chapter": "62",
    "verse": "4",
    "text": "सचमुच वे उसको, उसके ऊँचे पद से गिराने की सम्मति करते हैं;"
  },
  {
    "id": 14833,
    "book": "psalms                                  ",
    "chapter": "62",
    "verse": "5",
    "text": "हे मेरे मन, परमेश्वर के सामने चुपचाप रह,"
  },
  {
    "id": 14834,
    "book": "psalms                                  ",
    "chapter": "62",
    "verse": "6",
    "text": "सचमुच वही मेरी चट्टान, और मेरा उद्धार है,"
  },
  {
    "id": 14835,
    "book": "psalms                                  ",
    "chapter": "62",
    "verse": "7",
    "text": "मेरे उद्धार और मेरी महिमा का आधार परमेश्वर है;"
  },
  {
    "id": 14836,
    "book": "psalms                                  ",
    "chapter": "62",
    "verse": "8",
    "text": "हे लोगों, हर समय उस पर भरोसा रखो;"
  },
  {
    "id": 14837,
    "book": "psalms                                  ",
    "chapter": "62",
    "verse": "9",
    "text": "सचमुच नीच लोग तो अस्थाई, और बड़े लोग मिथ्या ही हैं;"
  },
  {
    "id": 14838,
    "book": "psalms                                  ",
    "chapter": "62",
    "verse": "10",
    "text": "अत्याचार करने पर भरोसा मत रखो,"
  },
  {
    "id": 14839,
    "book": "psalms                                  ",
    "chapter": "62",
    "verse": "11",
    "text": "परमेश्वर ने एक बार कहा है;"
  },
  {
    "id": 14840,
    "book": "psalms                                  ",
    "chapter": "62",
    "verse": "12",
    "text": "और हे प्रभु, करुणा भी तेरी है।"
  }
]
