[
  {
    "id": 14527,
    "book": "psalms                                  ",
    "chapter": "40",
    "verse": "1",
    "text": "मैं धीरज से यहोवा की बाट जोहता रहा;"
  },
  {
    "id": 14528,
    "book": "psalms                                  ",
    "chapter": "40",
    "verse": "2",
    "text": "उसने मुझे सत्यानाश के गड्ढे"
  },
  {
    "id": 14529,
    "book": "psalms                                  ",
    "chapter": "40",
    "verse": "3",
    "text": "उसने मुझे एक नया गीत सिखाया"
  },
  {
    "id": 14530,
    "book": "psalms                                  ",
    "chapter": "40",
    "verse": "4",
    "text": "क्या ही धन्य है वह पुरुष,"
  },
  {
    "id": 14531,
    "book": "psalms                                  ",
    "chapter": "40",
    "verse": "5",
    "text": "हे मेरे परमेश्वर यहोवा, तूने बहुत से काम किए हैं!"
  },
  {
    "id": 14532,
    "book": "psalms                                  ",
    "chapter": "40",
    "verse": "6",
    "text": "मेलबलि और अन्नबलि से तू प्रसन्न नहीं होता"
  },
  {
    "id": 14533,
    "book": "psalms                                  ",
    "chapter": "40",
    "verse": "7",
    "text": "तब मैंने कहा,"
  },
  {
    "id": 14534,
    "book": "psalms                                  ",
    "chapter": "40",
    "verse": "8",
    "text": "हे मेरे परमेश्वर,"
  },
  {
    "id": 14535,
    "book": "psalms                                  ",
    "chapter": "40",
    "verse": "9",
    "text": "मैंने बड़ी सभा में धार्मिकता के शुभ समाचार का प्रचार किया है;"
  },
  {
    "id": 14536,
    "book": "psalms                                  ",
    "chapter": "40",
    "verse": "10",
    "text": "मैंने तेरी धार्मिकता मन ही में नहीं रखा;"
  },
  {
    "id": 14537,
    "book": "psalms                                  ",
    "chapter": "40",
    "verse": "11",
    "text": "हे यहोवा, तू भी अपनी बड़ी दया मुझ पर से न हटा ले,"
  },
  {
    "id": 14538,
    "book": "psalms                                  ",
    "chapter": "40",
    "verse": "12",
    "text": "क्योंकि मैं अनगिनत बुराइयों से घिरा हुआ हूँ;"
  },
  {
    "id": 14539,
    "book": "psalms                                  ",
    "chapter": "40",
    "verse": "13",
    "text": "हे यहोवा, कृपा करके मुझे छुड़ा ले!"
  },
  {
    "id": 14540,
    "book": "psalms                                  ",
    "chapter": "40",
    "verse": "14",
    "text": "जो मेरे प्राण की खोज में हैं,"
  },
  {
    "id": 14541,
    "book": "psalms                                  ",
    "chapter": "40",
    "verse": "15",
    "text": "जो मुझसे, “आहा, आहा,” कहते हैं,"
  },
  {
    "id": 14542,
    "book": "psalms                                  ",
    "chapter": "40",
    "verse": "16",
    "text": "परन्तु जितने तुझे ढूँढ़ते हैं,"
  },
  {
    "id": 14543,
    "book": "psalms                                  ",
    "chapter": "40",
    "verse": "17",
    "text": "मैं तो दीन और दरिद्र हूँ,"
  }
]
