[
  {
    "id": 14492,
    "book": "psalms                                  ",
    "chapter": "38",
    "verse": "1",
    "text": "हे यहोवा क्रोध में आकर मुझे झिड़क न दे,"
  },
  {
    "id": 14493,
    "book": "psalms                                  ",
    "chapter": "38",
    "verse": "2",
    "text": "क्योंकि तेरे तीर मुझ में लगे हैं,"
  },
  {
    "id": 14494,
    "book": "psalms                                  ",
    "chapter": "38",
    "verse": "3",
    "text": "तेरे क्रोध के कारण मेरे शरीर में कुछ भी"
  },
  {
    "id": 14495,
    "book": "psalms                                  ",
    "chapter": "38",
    "verse": "4",
    "text": "क्योंकि मेरे अधर्म के कामों में"
  },
  {
    "id": 14496,
    "book": "psalms                                  ",
    "chapter": "38",
    "verse": "5",
    "text": "मेरी मूर्खता के पाप के कारण मेरे घाव सड़ गए38:5 मेरे घाव सड़ गए: अर्थात् वह पापों के कारण प्रताड़ित किया जा रहा था और उसकी मार के चिन्ह पर सुजन ही नहीं थी वरन् वे घाव बन गए थे।"
  },
  {
    "id": 14497,
    "book": "psalms                                  ",
    "chapter": "38",
    "verse": "6",
    "text": "मैं बहुत दुःखी हूँ और झुक गया हूँ;"
  },
  {
    "id": 14498,
    "book": "psalms                                  ",
    "chapter": "38",
    "verse": "7",
    "text": "क्योंकि मेरी कमर में जलन है,"
  },
  {
    "id": 14499,
    "book": "psalms                                  ",
    "chapter": "38",
    "verse": "8",
    "text": "मैं निर्बल और बहुत ही चूर हो गया हूँ;"
  },
  {
    "id": 14500,
    "book": "psalms                                  ",
    "chapter": "38",
    "verse": "9",
    "text": "हे प्रभु मेरी सारी अभिलाषा तेरे सम्मुख है,"
  },
  {
    "id": 14501,
    "book": "psalms                                  ",
    "chapter": "38",
    "verse": "10",
    "text": "मेरा हृदय धड़कता है,"
  },
  {
    "id": 14502,
    "book": "psalms                                  ",
    "chapter": "38",
    "verse": "11",
    "text": "मेरे मित्र और मेरे संगी"
  },
  {
    "id": 14503,
    "book": "psalms                                  ",
    "chapter": "38",
    "verse": "12",
    "text": "मेरे प्राण के ग्राहक मेरे लिये जाल बिछाते हैं,"
  },
  {
    "id": 14504,
    "book": "psalms                                  ",
    "chapter": "38",
    "verse": "13",
    "text": "परन्तु मैं बहरे के समान सुनता ही नहीं,"
  },
  {
    "id": 14505,
    "book": "psalms                                  ",
    "chapter": "38",
    "verse": "14",
    "text": "वरन् मैं ऐसे मनुष्य के तुल्य हूँ"
  },
  {
    "id": 14506,
    "book": "psalms                                  ",
    "chapter": "38",
    "verse": "15",
    "text": "परन्तु हे यहोवा,"
  },
  {
    "id": 14507,
    "book": "psalms                                  ",
    "chapter": "38",
    "verse": "16",
    "text": "क्योंकि मैंने कहा,"
  },
  {
    "id": 14508,
    "book": "psalms                                  ",
    "chapter": "38",
    "verse": "17",
    "text": "क्योंकि मैं तो अब गिरने ही पर हूँ;"
  },
  {
    "id": 14509,
    "book": "psalms                                  ",
    "chapter": "38",
    "verse": "18",
    "text": "इसलिए कि मैं तो अपने अधर्म को प्रगट करूँगा,"
  },
  {
    "id": 14510,
    "book": "psalms                                  ",
    "chapter": "38",
    "verse": "19",
    "text": "परन्तु मेरे शत्रु अनगिनत हैं,"
  },
  {
    "id": 14511,
    "book": "psalms                                  ",
    "chapter": "38",
    "verse": "20",
    "text": "जो भलाई के बदले में बुराई करते हैं,"
  },
  {
    "id": 14512,
    "book": "psalms                                  ",
    "chapter": "38",
    "verse": "21",
    "text": "हे यहोवा, मुझे छोड़ न दे!"
  },
  {
    "id": 14513,
    "book": "psalms                                  ",
    "chapter": "38",
    "verse": "22",
    "text": "हे यहोवा, हे मेरे उद्धारकर्ता,"
  }
]
