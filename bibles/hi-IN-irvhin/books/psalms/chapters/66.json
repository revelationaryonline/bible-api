[
  {
    "id": 14875,
    "book": "psalms                                  ",
    "chapter": "66",
    "verse": "1",
    "text": "हे सारी पृथ्वी के लोगों, परमेश्वर के लिये जयजयकार करो;"
  },
  {
    "id": 14876,
    "book": "psalms                                  ",
    "chapter": "66",
    "verse": "2",
    "text": "उसके नाम की महिमा का भजन गाओ;"
  },
  {
    "id": 14877,
    "book": "psalms                                  ",
    "chapter": "66",
    "verse": "3",
    "text": "परमेश्वर से कहो, “तेरे काम कितने भयानक हैं66:3 तेरे काम कितने भयानक हैं: अर्थात् उसके सामर्थ्य और महानता का प्रदर्शन मन में भय एवं श्रद्धा उत्पन्न करने योग्य होता है। !"
  },
  {
    "id": 14878,
    "book": "psalms                                  ",
    "chapter": "66",
    "verse": "4",
    "text": "सारी पृथ्वी के लोग तुझे दण्डवत् करेंगे,"
  },
  {
    "id": 14879,
    "book": "psalms                                  ",
    "chapter": "66",
    "verse": "5",
    "text": "आओ परमेश्वर के कामों को देखो;"
  },
  {
    "id": 14880,
    "book": "psalms                                  ",
    "chapter": "66",
    "verse": "6",
    "text": "उसने समुद्र को सूखी भूमि कर डाला;"
  },
  {
    "id": 14881,
    "book": "psalms                                  ",
    "chapter": "66",
    "verse": "7",
    "text": "जो अपने पराक्रम से सर्वदा प्रभुता करता है,"
  },
  {
    "id": 14882,
    "book": "psalms                                  ",
    "chapter": "66",
    "verse": "8",
    "text": "हे देश-देश के लोगों, हमारे परमेश्वर को धन्य कहो,"
  },
  {
    "id": 14883,
    "book": "psalms                                  ",
    "chapter": "66",
    "verse": "9",
    "text": "जो हमको जीवित रखता है;"
  },
  {
    "id": 14884,
    "book": "psalms                                  ",
    "chapter": "66",
    "verse": "10",
    "text": "क्योंकि हे परमेश्वर तूने हमको जाँचा;"
  },
  {
    "id": 14885,
    "book": "psalms                                  ",
    "chapter": "66",
    "verse": "11",
    "text": "तूने हमको जाल में फँसाया;"
  },
  {
    "id": 14886,
    "book": "psalms                                  ",
    "chapter": "66",
    "verse": "12",
    "text": "तूने घुड़चढ़ों को हमारे सिरों के ऊपर से चलाया,"
  },
  {
    "id": 14887,
    "book": "psalms                                  ",
    "chapter": "66",
    "verse": "13",
    "text": "मैं होमबलि लेकर तेरे भवन में आऊँगा"
  },
  {
    "id": 14888,
    "book": "psalms                                  ",
    "chapter": "66",
    "verse": "14",
    "text": "जो मैंने मुँह खोलकर मानीं,"
  },
  {
    "id": 14889,
    "book": "psalms                                  ",
    "chapter": "66",
    "verse": "15",
    "text": "मैं तुझे मोटे पशुओं की होमबलि,"
  },
  {
    "id": 14890,
    "book": "psalms                                  ",
    "chapter": "66",
    "verse": "16",
    "text": "हे परमेश्वर के सब डरवैयों, आकर सुनो,"
  },
  {
    "id": 14891,
    "book": "psalms                                  ",
    "chapter": "66",
    "verse": "17",
    "text": "मैंने उसको पुकारा,"
  },
  {
    "id": 14892,
    "book": "psalms                                  ",
    "chapter": "66",
    "verse": "18",
    "text": "यदि मैं मन में अनर्थ की बात सोचता,"
  },
  {
    "id": 14893,
    "book": "psalms                                  ",
    "chapter": "66",
    "verse": "19",
    "text": "परन्तु परमेश्वर ने तो सुना है;"
  },
  {
    "id": 14894,
    "book": "psalms                                  ",
    "chapter": "66",
    "verse": "20",
    "text": "धन्य है परमेश्वर,"
  }
]
