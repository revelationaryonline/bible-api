[
  {
    "id": 15243,
    "book": "psalms                                  ",
    "chapter": "83",
    "verse": "1",
    "text": "हे परमेश्वर मौन न रह;"
  },
  {
    "id": 15244,
    "book": "psalms                                  ",
    "chapter": "83",
    "verse": "2",
    "text": "क्योंकि देख तेरे शत्रु धूम मचा रहे हैं;"
  },
  {
    "id": 15245,
    "book": "psalms                                  ",
    "chapter": "83",
    "verse": "3",
    "text": "वे चतुराई से तेरी प्रजा की हानि की सम्मति करते,"
  },
  {
    "id": 15246,
    "book": "psalms                                  ",
    "chapter": "83",
    "verse": "4",
    "text": "उन्होंने कहा, “आओ, हम उनका ऐसा नाश करें कि राज्य भी मिट जाए;"
  },
  {
    "id": 15247,
    "book": "psalms                                  ",
    "chapter": "83",
    "verse": "5",
    "text": "उन्होंने एक मन होकर युक्ति निकाली83:5 उन्होंने एक मन होकर युक्ति निकाली: इस विषय पर उनकी सम्मति में मतभेद नहीं है। उनकी एक ही अभिलाषा है और उनका उद्देश्य भी एक ही है।  है,"
  },
  {
    "id": 15248,
    "book": "psalms                                  ",
    "chapter": "83",
    "verse": "6",
    "text": "ये तो एदोम के तम्बूवाले"
  },
  {
    "id": 15249,
    "book": "psalms                                  ",
    "chapter": "83",
    "verse": "7",
    "text": "गबाली, अम्मोनी, अमालेकी,"
  },
  {
    "id": 15250,
    "book": "psalms                                  ",
    "chapter": "83",
    "verse": "8",
    "text": "इनके संग अश्शूरी भी मिल गए हैं;"
  },
  {
    "id": 15251,
    "book": "psalms                                  ",
    "chapter": "83",
    "verse": "9",
    "text": "इनसे ऐसा कर जैसा मिद्यानियों से83:9 इनसे ऐसा कर जैसा मिद्यानियों से: कनान के राजा याबीन की सेना का दबोरा भविष्यद्वक्तिन के निर्देश पर इब्रानी सेना ने उसे जीत लिया था। ,"
  },
  {
    "id": 15252,
    "book": "psalms                                  ",
    "chapter": "83",
    "verse": "10",
    "text": "वे एनदोर में नाश हुए,"
  },
  {
    "id": 15253,
    "book": "psalms                                  ",
    "chapter": "83",
    "verse": "11",
    "text": "इनके रईसों को ओरेब और जेब सरीखे,"
  },
  {
    "id": 15254,
    "book": "psalms                                  ",
    "chapter": "83",
    "verse": "12",
    "text": "जिन्होंने कहा था,"
  },
  {
    "id": 15255,
    "book": "psalms                                  ",
    "chapter": "83",
    "verse": "13",
    "text": "हे मेरे परमेश्वर इनको बवंडर की धूलि,"
  },
  {
    "id": 15256,
    "book": "psalms                                  ",
    "chapter": "83",
    "verse": "14",
    "text": "उस आग के समान जो वन को भस्म करती है,"
  },
  {
    "id": 15257,
    "book": "psalms                                  ",
    "chapter": "83",
    "verse": "15",
    "text": "तू इन्हें अपनी आँधी से भगा दे,"
  },
  {
    "id": 15258,
    "book": "psalms                                  ",
    "chapter": "83",
    "verse": "16",
    "text": "इनके मुँह को अति लज्जित कर,"
  },
  {
    "id": 15259,
    "book": "psalms                                  ",
    "chapter": "83",
    "verse": "17",
    "text": "ये सदा के लिये लज्जित और घबराए रहें,"
  },
  {
    "id": 15260,
    "book": "psalms                                  ",
    "chapter": "83",
    "verse": "18",
    "text": "जिससे ये जानें कि केवल तू जिसका नाम यहोवा है,"
  }
]
