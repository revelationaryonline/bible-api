[
  {
    "id": 14412,
    "book": "psalms                                  ",
    "chapter": "35",
    "verse": "1",
    "text": "हे यहोवा, जो मेरे साथ मुकद्दमा लड़ते हैं,"
  },
  {
    "id": 14413,
    "book": "psalms                                  ",
    "chapter": "35",
    "verse": "2",
    "text": "ढाल और भाला लेकर मेरी सहायता करने को"
  },
  {
    "id": 14414,
    "book": "psalms                                  ",
    "chapter": "35",
    "verse": "3",
    "text": "बर्छी को खींच और मेरा पीछा करनेवालों के"
  },
  {
    "id": 14415,
    "book": "psalms                                  ",
    "chapter": "35",
    "verse": "4",
    "text": "जो मेरे प्राण के ग्राहक हैं"
  },
  {
    "id": 14416,
    "book": "psalms                                  ",
    "chapter": "35",
    "verse": "5",
    "text": "वे वायु से उड़ जानेवाली भूसी के समान हों,"
  },
  {
    "id": 14417,
    "book": "psalms                                  ",
    "chapter": "35",
    "verse": "6",
    "text": "उनका मार्ग अंधियारा और फिसलाहा हो35:6 उनका मार्ग अंधियारा और फिसलाहा हो: “अन्धकार भरा” अर्थात् वे देख नहीं पाएँ कि कहाँ जाते हैं, उन्हें क्या हानि होगी, उनके सामने क्या है उसका उन्हें ज्ञान न हो। ,"
  },
  {
    "id": 14418,
    "book": "psalms                                  ",
    "chapter": "35",
    "verse": "7",
    "text": "क्योंकि अकारण उन्होंने मेरे लिये अपना"
  },
  {
    "id": 14419,
    "book": "psalms                                  ",
    "chapter": "35",
    "verse": "8",
    "text": "अचानक उन पर विपत्ति आ पड़े!"
  },
  {
    "id": 14420,
    "book": "psalms                                  ",
    "chapter": "35",
    "verse": "9",
    "text": "परन्तु मैं यहोवा के कारण अपने"
  },
  {
    "id": 14421,
    "book": "psalms                                  ",
    "chapter": "35",
    "verse": "10",
    "text": "मेरी हड्डी-हड्डी कहेंगी,"
  },
  {
    "id": 14422,
    "book": "psalms                                  ",
    "chapter": "35",
    "verse": "11",
    "text": "अधर्मी साक्षी खड़े होते हैं;"
  },
  {
    "id": 14423,
    "book": "psalms                                  ",
    "chapter": "35",
    "verse": "12",
    "text": "वे मुझसे भलाई के बदले बुराई करते हैं,"
  },
  {
    "id": 14424,
    "book": "psalms                                  ",
    "chapter": "35",
    "verse": "13",
    "text": "जब वे रोगी थे तब तो मैं टाट पहने रहा35:13 मैं टाट पहने रहा: कष्टों में उन्हें गहरी सहानुभूति दिखाई और अपमान एवं विलाप का प्रतीक धारण किया।,"
  },
  {
    "id": 14425,
    "book": "psalms                                  ",
    "chapter": "35",
    "verse": "14",
    "text": "मैं ऐसी भावना रखता था कि मानो वे मेरे"
  },
  {
    "id": 14426,
    "book": "psalms                                  ",
    "chapter": "35",
    "verse": "15",
    "text": "परन्तु जब मैं लँगड़ाने लगा तब वे"
  },
  {
    "id": 14427,
    "book": "psalms                                  ",
    "chapter": "35",
    "verse": "16",
    "text": "आदर के बिना वे मुझे ताना मारते हैं;"
  },
  {
    "id": 14428,
    "book": "psalms                                  ",
    "chapter": "35",
    "verse": "17",
    "text": "हे प्रभु, तू कब तक देखता रहेगा?"
  },
  {
    "id": 14429,
    "book": "psalms                                  ",
    "chapter": "35",
    "verse": "18",
    "text": "मैं बड़ी सभा में तेरा धन्यवाद करूँगा;"
  },
  {
    "id": 14430,
    "book": "psalms                                  ",
    "chapter": "35",
    "verse": "19",
    "text": "मेरे झूठ बोलनेवाले शत्रु मेरे विरुद्ध"
  },
  {
    "id": 14431,
    "book": "psalms                                  ",
    "chapter": "35",
    "verse": "20",
    "text": "क्योंकि वे मेल की बातें नहीं बोलते,"
  },
  {
    "id": 14432,
    "book": "psalms                                  ",
    "chapter": "35",
    "verse": "21",
    "text": "और उन्होंने मेरे विरुद्ध मुँह पसार के कहा;"
  },
  {
    "id": 14433,
    "book": "psalms                                  ",
    "chapter": "35",
    "verse": "22",
    "text": "हे यहोवा, तूने तो देखा है; चुप न रह!"
  },
  {
    "id": 14434,
    "book": "psalms                                  ",
    "chapter": "35",
    "verse": "23",
    "text": "उठ, मेरे न्याय के लिये जाग,"
  },
  {
    "id": 14435,
    "book": "psalms                                  ",
    "chapter": "35",
    "verse": "24",
    "text": "हे मेरे परमेश्वर यहोवा,"
  },
  {
    "id": 14436,
    "book": "psalms                                  ",
    "chapter": "35",
    "verse": "25",
    "text": "वे मन में न कहने पाएँ,"
  },
  {
    "id": 14437,
    "book": "psalms                                  ",
    "chapter": "35",
    "verse": "26",
    "text": "जो मेरी हानि से आनन्दित होते हैं"
  },
  {
    "id": 14438,
    "book": "psalms                                  ",
    "chapter": "35",
    "verse": "27",
    "text": "जो मेरे धर्म से प्रसन्न रहते हैं,"
  },
  {
    "id": 14439,
    "book": "psalms                                  ",
    "chapter": "35",
    "verse": "28",
    "text": "तब मेरे मुँह से तेरे धर्म की चर्चा होगी,"
  }
]
