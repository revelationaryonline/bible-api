[
  {
    "id": 14206,
    "book": "psalms                                  ",
    "chapter": "22",
    "verse": "1",
    "text": "हे मेरे परमेश्वर, हे मेरे परमेश्वर,"
  },
  {
    "id": 14207,
    "book": "psalms                                  ",
    "chapter": "22",
    "verse": "2",
    "text": "हे मेरे परमेश्वर, मैं दिन को पुकारता हूँ"
  },
  {
    "id": 14208,
    "book": "psalms                                  ",
    "chapter": "22",
    "verse": "3",
    "text": "परन्तु तू जो इस्राएल की स्तुति के सिंहासन पर विराजमान है,"
  },
  {
    "id": 14209,
    "book": "psalms                                  ",
    "chapter": "22",
    "verse": "4",
    "text": "हमारे पुरखा तुझी पर भरोसा रखते थे;"
  },
  {
    "id": 14210,
    "book": "psalms                                  ",
    "chapter": "22",
    "verse": "5",
    "text": "उन्होंने तेरी दुहाई दी और तूने उनको छुड़ाया"
  },
  {
    "id": 14211,
    "book": "psalms                                  ",
    "chapter": "22",
    "verse": "6",
    "text": "परन्तु मैं तो कीड़ा हूँ, मनुष्य नहीं;"
  },
  {
    "id": 14212,
    "book": "psalms                                  ",
    "chapter": "22",
    "verse": "7",
    "text": "वह सब जो मुझे देखते हैं मेरा ठट्ठा करते हैं,"
  },
  {
    "id": 14213,
    "book": "psalms                                  ",
    "chapter": "22",
    "verse": "8",
    "text": "वे कहते है “वह यहोवा पर भरोसा करता है,"
  },
  {
    "id": 14214,
    "book": "psalms                                  ",
    "chapter": "22",
    "verse": "9",
    "text": "परन्तु तू ही ने मुझे गर्भ से निकाला22:9 परन्तु तू ही ने मुझे गर्भ से निकाला: परमेश्वर उसे संसार में लाया था और उसे उसके अस्तित्व के आरम्भिक पलों में संकट से बचाया। अब वह प्रार्थना करता है कि संकट के दिन परमेश्वर बीच में आकर उसकी रक्षा करें। ;"
  },
  {
    "id": 14215,
    "book": "psalms                                  ",
    "chapter": "22",
    "verse": "10",
    "text": "मैं जन्मते ही तुझी पर छोड़ दिया गया,"
  },
  {
    "id": 14216,
    "book": "psalms                                  ",
    "chapter": "22",
    "verse": "11",
    "text": "मुझसे दूर न हो क्योंकि संकट निकट है,"
  },
  {
    "id": 14217,
    "book": "psalms                                  ",
    "chapter": "22",
    "verse": "12",
    "text": "बहुत से सांडों ने मुझे घेर लिया है,"
  },
  {
    "id": 14218,
    "book": "psalms                                  ",
    "chapter": "22",
    "verse": "13",
    "text": "वे फाड़ने और गरजनेवाले सिंह के समान"
  },
  {
    "id": 14219,
    "book": "psalms                                  ",
    "chapter": "22",
    "verse": "14",
    "text": "मैं जल के समान बह गया22:14 मैं जल के समान बह गया: कहने का अर्थ है कि उसकी सम्पूर्ण शक्ति समाप्त हो गई। ,"
  },
  {
    "id": 14220,
    "book": "psalms                                  ",
    "chapter": "22",
    "verse": "15",
    "text": "मेरा बल टूट गया, मैं ठीकरा हो गया;"
  },
  {
    "id": 14221,
    "book": "psalms                                  ",
    "chapter": "22",
    "verse": "16",
    "text": "क्योंकि कुत्तों ने मुझे घेर लिया है;"
  },
  {
    "id": 14222,
    "book": "psalms                                  ",
    "chapter": "22",
    "verse": "17",
    "text": "मैं अपनी सब हड्डियाँ गिन सकता हूँ;"
  },
  {
    "id": 14223,
    "book": "psalms                                  ",
    "chapter": "22",
    "verse": "18",
    "text": "वे मेरे वस्त्र आपस में बाँटते हैं,"
  },
  {
    "id": 14224,
    "book": "psalms                                  ",
    "chapter": "22",
    "verse": "19",
    "text": "परन्तु हे यहोवा तू दूर न रह!"
  },
  {
    "id": 14225,
    "book": "psalms                                  ",
    "chapter": "22",
    "verse": "20",
    "text": "मेरे प्राण को तलवार से बचा,"
  },
  {
    "id": 14226,
    "book": "psalms                                  ",
    "chapter": "22",
    "verse": "21",
    "text": "मुझे सिंह के मुँह से बचा,"
  },
  {
    "id": 14227,
    "book": "psalms                                  ",
    "chapter": "22",
    "verse": "22",
    "text": "मैं अपने भाइयों के सामने तेरे नाम का प्रचार करूँगा;"
  },
  {
    "id": 14228,
    "book": "psalms                                  ",
    "chapter": "22",
    "verse": "23",
    "text": "हे यहोवा के डरवैयों, उसकी स्तुति करो!"
  },
  {
    "id": 14229,
    "book": "psalms                                  ",
    "chapter": "22",
    "verse": "24",
    "text": "क्योंकि उसने दुःखी को तुच्छ नहीं जाना"
  },
  {
    "id": 14230,
    "book": "psalms                                  ",
    "chapter": "22",
    "verse": "25",
    "text": "बड़ी सभा में मेरा स्तुति करना तेरी ही ओर से होता है;"
  },
  {
    "id": 14231,
    "book": "psalms                                  ",
    "chapter": "22",
    "verse": "26",
    "text": "नम्र लोग भोजन करके तृप्त होंगे;"
  },
  {
    "id": 14232,
    "book": "psalms                                  ",
    "chapter": "22",
    "verse": "27",
    "text": "पृथ्वी के सब दूर-दूर देशों के लोग उसको स्मरण करेंगे"
  },
  {
    "id": 14233,
    "book": "psalms                                  ",
    "chapter": "22",
    "verse": "28",
    "text": "क्योंकि राज्य यहोवा ही का है,"
  },
  {
    "id": 14234,
    "book": "psalms                                  ",
    "chapter": "22",
    "verse": "29",
    "text": "पृथ्वी के सब हष्ट-पुष्ट लोग भोजन करके दण्डवत् करेंगे;"
  },
  {
    "id": 14235,
    "book": "psalms                                  ",
    "chapter": "22",
    "verse": "30",
    "text": "एक वंश उसकी सेवा करेगा;"
  },
  {
    "id": 14236,
    "book": "psalms                                  ",
    "chapter": "22",
    "verse": "31",
    "text": "वे आएँगे और उसके धार्मिकता के कामों को एक"
  }
]
