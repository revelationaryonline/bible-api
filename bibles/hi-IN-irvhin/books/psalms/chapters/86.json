[
  {
    "id": 15286,
    "book": "psalms                                  ",
    "chapter": "86",
    "verse": "1",
    "text": "हे यहोवा, कान लगाकर मेरी सुन ले,"
  },
  {
    "id": 15287,
    "book": "psalms                                  ",
    "chapter": "86",
    "verse": "2",
    "text": "मेरे प्राण की रक्षा कर, क्योंकि मैं भक्त हूँ;"
  },
  {
    "id": 15288,
    "book": "psalms                                  ",
    "chapter": "86",
    "verse": "3",
    "text": "हे प्रभु, मुझ पर अनुग्रह कर,"
  },
  {
    "id": 15289,
    "book": "psalms                                  ",
    "chapter": "86",
    "verse": "4",
    "text": "अपने दास के मन को आनन्दित कर,"
  },
  {
    "id": 15290,
    "book": "psalms                                  ",
    "chapter": "86",
    "verse": "5",
    "text": "क्योंकि हे प्रभु, तू भला और क्षमा करनेवाला है,"
  },
  {
    "id": 15291,
    "book": "psalms                                  ",
    "chapter": "86",
    "verse": "6",
    "text": "हे यहोवा मेरी प्रार्थना की ओर कान लगा,"
  },
  {
    "id": 15292,
    "book": "psalms                                  ",
    "chapter": "86",
    "verse": "7",
    "text": "संकट के दिन मैं तुझको पुकारूँगा,"
  },
  {
    "id": 15293,
    "book": "psalms                                  ",
    "chapter": "86",
    "verse": "8",
    "text": "हे प्रभु, देवताओं में से कोई भी तेरे तुल्य नहीं,"
  },
  {
    "id": 15294,
    "book": "psalms                                  ",
    "chapter": "86",
    "verse": "9",
    "text": "हे प्रभु, जितनी जातियों को तूने बनाया है,"
  },
  {
    "id": 15295,
    "book": "psalms                                  ",
    "chapter": "86",
    "verse": "10",
    "text": "क्योंकि तू महान और आश्चर्यकर्म करनेवाला है,"
  },
  {
    "id": 15296,
    "book": "psalms                                  ",
    "chapter": "86",
    "verse": "11",
    "text": "हे यहोवा, अपना मार्ग मुझे सिखा, तब मैं तेरे सत्य मार्ग पर चलूँगा,"
  },
  {
    "id": 15297,
    "book": "psalms                                  ",
    "chapter": "86",
    "verse": "12",
    "text": "हे प्रभु, हे मेरे परमेश्वर, मैं अपने सम्पूर्ण मन से तेरा धन्यवाद करूँगा,"
  },
  {
    "id": 15298,
    "book": "psalms                                  ",
    "chapter": "86",
    "verse": "13",
    "text": "क्योंकि तेरी करुणा मेरे ऊपर बड़ी है;"
  },
  {
    "id": 15299,
    "book": "psalms                                  ",
    "chapter": "86",
    "verse": "14",
    "text": "हे परमेश्वर, अभिमानी लोग मेरे विरुद्ध उठ गए हैं,"
  },
  {
    "id": 15300,
    "book": "psalms                                  ",
    "chapter": "86",
    "verse": "15",
    "text": "परन्तु प्रभु दयालु और अनुग्रहकारी परमेश्वर है,"
  },
  {
    "id": 15301,
    "book": "psalms                                  ",
    "chapter": "86",
    "verse": "16",
    "text": "मेरी ओर फिरकर मुझ पर अनुग्रह कर;"
  },
  {
    "id": 15302,
    "book": "psalms                                  ",
    "chapter": "86",
    "verse": "17",
    "text": "मुझे भलाई का कोई चिन्ह दिखा,"
  }
]
