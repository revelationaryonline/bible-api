[
  {
    "id": 13975,
    "book": "psalms                                  ",
    "chapter": "5",
    "verse": "1",
    "text": "हे यहोवा, मेरे वचनों पर कान लगा;"
  },
  {
    "id": 13976,
    "book": "psalms                                  ",
    "chapter": "5",
    "verse": "2",
    "text": "हे मेरे राजा, हे मेरे परमेश्वर, मेरी दुहाई पर ध्यान दे,"
  },
  {
    "id": 13977,
    "book": "psalms                                  ",
    "chapter": "5",
    "verse": "3",
    "text": "हे यहोवा, भोर को मेरी वाणी तुझे सुनाई देगी,"
  },
  {
    "id": 13978,
    "book": "psalms                                  ",
    "chapter": "5",
    "verse": "4",
    "text": "क्योंकि तू ऐसा परमेश्वर है, जो दुष्टता से प्रसन्न नहीं होता;"
  },
  {
    "id": 13979,
    "book": "psalms                                  ",
    "chapter": "5",
    "verse": "5",
    "text": "घमण्डी तेरे सम्मुख खड़े होने न पाएँगे;"
  },
  {
    "id": 13980,
    "book": "psalms                                  ",
    "chapter": "5",
    "verse": "6",
    "text": "तू उनको जो झूठ बोलते हैं नाश करेगा;"
  },
  {
    "id": 13981,
    "book": "psalms                                  ",
    "chapter": "5",
    "verse": "7",
    "text": "परन्तु मैं तो तेरी अपार करुणा के कारण तेरे भवन में आऊँगा,"
  },
  {
    "id": 13982,
    "book": "psalms                                  ",
    "chapter": "5",
    "verse": "8",
    "text": "हे यहोवा, मेरे शत्रुओं के कारण अपने धार्मिकता के मार्ग में मेरी अगुआई कर;"
  },
  {
    "id": 13983,
    "book": "psalms                                  ",
    "chapter": "5",
    "verse": "9",
    "text": "क्योंकि उनके मुँह में कोई सच्चाई नहीं;"
  },
  {
    "id": 13984,
    "book": "psalms                                  ",
    "chapter": "5",
    "verse": "10",
    "text": "हे परमेश्वर तू उनको दोषी ठहरा;"
  },
  {
    "id": 13985,
    "book": "psalms                                  ",
    "chapter": "5",
    "verse": "11",
    "text": "परन्तु जितने तुझ में शरण लेते हैं वे सब आनन्द करें,"
  },
  {
    "id": 13986,
    "book": "psalms                                  ",
    "chapter": "5",
    "verse": "12",
    "text": "क्योंकि तू धर्मी को आशीष देगा; हे यहोवा,"
  }
]
