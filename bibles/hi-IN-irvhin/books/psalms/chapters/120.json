[
  {
    "id": 16076,
    "book": "psalms                                  ",
    "chapter": "120",
    "verse": "1",
    "text": "संकट के समय मैंने यहोवा को पुकारा,"
  },
  {
    "id": 16077,
    "book": "psalms                                  ",
    "chapter": "120",
    "verse": "2",
    "text": "हे यहोवा, झूठ बोलनेवाले मुँह से"
  },
  {
    "id": 16078,
    "book": "psalms                                  ",
    "chapter": "120",
    "verse": "3",
    "text": "हे छली जीभ,"
  },
  {
    "id": 16079,
    "book": "psalms                                  ",
    "chapter": "120",
    "verse": "4",
    "text": "वीर के नोकीले तीर"
  },
  {
    "id": 16080,
    "book": "psalms                                  ",
    "chapter": "120",
    "verse": "5",
    "text": "हाय, हाय, क्योंकि मुझे मेशेक में परदेशी होकर रहना पड़ा"
  },
  {
    "id": 16081,
    "book": "psalms                                  ",
    "chapter": "120",
    "verse": "6",
    "text": "बहुत समय से मुझ को मेल के बैरियों के साथ बसना पड़ा है।"
  },
  {
    "id": 16082,
    "book": "psalms                                  ",
    "chapter": "120",
    "verse": "7",
    "text": "मैं तो मेल चाहता हूँ;"
  }
]
