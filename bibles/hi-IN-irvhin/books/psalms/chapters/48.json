[
  {
    "id": 14636,
    "book": "psalms                                  ",
    "chapter": "48",
    "verse": "1",
    "text": "हमारे परमेश्वर के नगर में, और अपने"
  },
  {
    "id": 14637,
    "book": "psalms                                  ",
    "chapter": "48",
    "verse": "2",
    "text": "सिय्योन पर्वत ऊँचाई में सुन्दर और सारी"
  },
  {
    "id": 14638,
    "book": "psalms                                  ",
    "chapter": "48",
    "verse": "3",
    "text": "उसके महलों में परमेश्वर ऊँचा गढ़ माना"
  },
  {
    "id": 14639,
    "book": "psalms                                  ",
    "chapter": "48",
    "verse": "4",
    "text": "क्योंकि देखो, राजा लोग इकट्ठे हुए,"
  },
  {
    "id": 14640,
    "book": "psalms                                  ",
    "chapter": "48",
    "verse": "5",
    "text": "उन्होंने आप ही देखा और देखते ही विस्मित हुए,"
  },
  {
    "id": 14641,
    "book": "psalms                                  ",
    "chapter": "48",
    "verse": "6",
    "text": "वहाँ कँपकँपी ने उनको आ पकड़ा,"
  },
  {
    "id": 14642,
    "book": "psalms                                  ",
    "chapter": "48",
    "verse": "7",
    "text": "तू पूर्वी वायु से"
  },
  {
    "id": 14643,
    "book": "psalms                                  ",
    "chapter": "48",
    "verse": "8",
    "text": "सेनाओं के यहोवा के नगर में,"
  },
  {
    "id": 14644,
    "book": "psalms                                  ",
    "chapter": "48",
    "verse": "9",
    "text": "हे परमेश्वर हमने तेरे मन्दिर के भीतर"
  },
  {
    "id": 14645,
    "book": "psalms                                  ",
    "chapter": "48",
    "verse": "10",
    "text": "हे परमेश्वर तेरे नाम के योग्य"
  },
  {
    "id": 14646,
    "book": "psalms                                  ",
    "chapter": "48",
    "verse": "11",
    "text": "तेरे न्याय के कामों के कारण"
  },
  {
    "id": 14647,
    "book": "psalms                                  ",
    "chapter": "48",
    "verse": "12",
    "text": "सिय्योन के चारों ओर चलो48:12 सिय्योन के चारों ओर चलो: सब मनुष्यों के लिए यह एक पुकार है कि वे सिय्योन नगर की परिक्रमा करें, उसका सर्वेक्षण करें और देखें कि वह कैसा सुन्दर एवं दृढ़ नगर है। , और उसकी"
  },
  {
    "id": 14648,
    "book": "psalms                                  ",
    "chapter": "48",
    "verse": "13",
    "text": "उसकी शहरपनाह पर दृष्टि लगाओ, उसके"
  },
  {
    "id": 14649,
    "book": "psalms                                  ",
    "chapter": "48",
    "verse": "14",
    "text": "क्योंकि वह परमेश्वर सदा सर्वदा हमारा"
  }
]
