[
  {
    "id": 14792,
    "book": "psalms                                  ",
    "chapter": "59",
    "verse": "1",
    "text": "हे मेरे परमेश्वर, मुझ को शत्रुओं से बचा,"
  },
  {
    "id": 14793,
    "book": "psalms                                  ",
    "chapter": "59",
    "verse": "2",
    "text": "मुझ को बुराई करनेवालों के हाथ से बचा,"
  },
  {
    "id": 14794,
    "book": "psalms                                  ",
    "chapter": "59",
    "verse": "3",
    "text": "क्योंकि देख, वे मेरी घात में लगे हैं;"
  },
  {
    "id": 14795,
    "book": "psalms                                  ",
    "chapter": "59",
    "verse": "4",
    "text": "मैं निर्दोष हूँ तो भी वे मुझसे लड़ने को मेरी ओर दौड़ते है;"
  },
  {
    "id": 14796,
    "book": "psalms                                  ",
    "chapter": "59",
    "verse": "5",
    "text": "हे सेनाओं के परमेश्वर यहोवा,"
  },
  {
    "id": 14797,
    "book": "psalms                                  ",
    "chapter": "59",
    "verse": "6",
    "text": "वे लोग साँझ को लौटकर कुत्ते के समान गुर्राते हैं,"
  },
  {
    "id": 14798,
    "book": "psalms                                  ",
    "chapter": "59",
    "verse": "7",
    "text": "देख वे डकारते हैं, उनके मुँह के भीतर तलवारें हैं,"
  },
  {
    "id": 14799,
    "book": "psalms                                  ",
    "chapter": "59",
    "verse": "8",
    "text": "परन्तु हे यहोवा, तू उन पर हँसेगा;"
  },
  {
    "id": 14800,
    "book": "psalms                                  ",
    "chapter": "59",
    "verse": "9",
    "text": "हे परमेश्वर, मेरे बल, मैं तुझ पर ध्यान दूँगा,"
  },
  {
    "id": 14801,
    "book": "psalms                                  ",
    "chapter": "59",
    "verse": "10",
    "text": "परमेश्वर करुणा करता हुआ मुझसे मिलेगा;"
  },
  {
    "id": 14802,
    "book": "psalms                                  ",
    "chapter": "59",
    "verse": "11",
    "text": "उन्हें घात न कर, ऐसा न हो कि मेरी प्रजा भूल जाए;"
  },
  {
    "id": 14803,
    "book": "psalms                                  ",
    "chapter": "59",
    "verse": "12",
    "text": "वह अपने मुँह के पाप, और होठों के वचन,"
  },
  {
    "id": 14804,
    "book": "psalms                                  ",
    "chapter": "59",
    "verse": "13",
    "text": "जलजलाहट में आकर उनका अन्त कर,"
  },
  {
    "id": 14805,
    "book": "psalms                                  ",
    "chapter": "59",
    "verse": "14",
    "text": "वे साँझ को लौटकर कुत्ते के समान गुर्राते,"
  },
  {
    "id": 14806,
    "book": "psalms                                  ",
    "chapter": "59",
    "verse": "15",
    "text": "वे टुकड़े के लिये मारे-मारे फिरते,"
  },
  {
    "id": 14807,
    "book": "psalms                                  ",
    "chapter": "59",
    "verse": "16",
    "text": "परन्तु मैं तेरी सामर्थ्य का यश गाऊँगा59:16 परन्तु मैं तेरी सामर्थ्य का यश गाऊँगा: मेरी शक्ति का स्रोत वही है जिसके द्वारा मैंने मुक्ति पाई है। ,"
  },
  {
    "id": 14808,
    "book": "psalms                                  ",
    "chapter": "59",
    "verse": "17",
    "text": "हे मेरे बल, मैं तेरा भजन गाऊँगा,"
  }
]
