[
  {
    "id": 15413,
    "book": "psalms                                  ",
    "chapter": "92",
    "verse": "1",
    "text": "यहोवा का धन्यवाद करना भला है,"
  },
  {
    "id": 15414,
    "book": "psalms                                  ",
    "chapter": "92",
    "verse": "2",
    "text": "प्रातःकाल को तेरी करुणा,"
  },
  {
    "id": 15415,
    "book": "psalms                                  ",
    "chapter": "92",
    "verse": "3",
    "text": "दस तारवाले बाजे और सारंगी पर,"
  },
  {
    "id": 15416,
    "book": "psalms                                  ",
    "chapter": "92",
    "verse": "4",
    "text": "क्योंकि, हे यहोवा, तूने मुझ को अपने कामों से आनन्दित किया है;"
  },
  {
    "id": 15417,
    "book": "psalms                                  ",
    "chapter": "92",
    "verse": "5",
    "text": "हे यहोवा, तेरे काम क्या ही बड़े है!"
  },
  {
    "id": 15418,
    "book": "psalms                                  ",
    "chapter": "92",
    "verse": "6",
    "text": "पशु समान मनुष्य इसको नहीं समझता,"
  },
  {
    "id": 15419,
    "book": "psalms                                  ",
    "chapter": "92",
    "verse": "7",
    "text": "कि दुष्ट जो घास के समान फूलते-फलते हैं,"
  },
  {
    "id": 15420,
    "book": "psalms                                  ",
    "chapter": "92",
    "verse": "8",
    "text": "परन्तु हे यहोवा, तू सदा विराजमान रहेगा।"
  },
  {
    "id": 15421,
    "book": "psalms                                  ",
    "chapter": "92",
    "verse": "9",
    "text": "क्योंकि हे यहोवा, तेरे शत्रु, हाँ तेरे शत्रु नाश होंगे;"
  },
  {
    "id": 15422,
    "book": "psalms                                  ",
    "chapter": "92",
    "verse": "10",
    "text": "परन्तु मेरा सींग तूने जंगली साँड़ के समान ऊँचा किया है;"
  },
  {
    "id": 15423,
    "book": "psalms                                  ",
    "chapter": "92",
    "verse": "11",
    "text": "मैं अपने शत्रुओं पर दृष्टि करके,"
  },
  {
    "id": 15424,
    "book": "psalms                                  ",
    "chapter": "92",
    "verse": "12",
    "text": "धर्मी लोग खजूर के समान फूले फलेंगे92:12 धर्मी लोग खजूर के समान फूले फलेंगे: खजूर का वृक्ष सदियों तक धीरे धीरे बड़ा होता है परन्तु स्थिरता से, उस पर ॠतुओं का प्रभाव नहीं पड़ता जो अन्य वृक्षों को प्रभावित करती हैं। ,"
  },
  {
    "id": 15425,
    "book": "psalms                                  ",
    "chapter": "92",
    "verse": "13",
    "text": "वे यहोवा के भवन में रोपे जाकर,"
  },
  {
    "id": 15426,
    "book": "psalms                                  ",
    "chapter": "92",
    "verse": "14",
    "text": "वे पुराने होने पर भी फलते रहेंगे,"
  },
  {
    "id": 15427,
    "book": "psalms                                  ",
    "chapter": "92",
    "verse": "15",
    "text": "जिससे यह प्रगट हो कि यहोवा सच्चा है;"
  }
]
