[
  {
    "id": 14120,
    "book": "psalms                                  ",
    "chapter": "18",
    "verse": "1",
    "text": "हे यहोवा, हे मेरे बल, मैं तुझ से प्रेम करता हूँ।"
  },
  {
    "id": 14121,
    "book": "psalms                                  ",
    "chapter": "18",
    "verse": "2",
    "text": "यहोवा मेरी चट्टान, और मेरा गढ़ और मेरा छुड़ानेवाला है;"
  },
  {
    "id": 14122,
    "book": "psalms                                  ",
    "chapter": "18",
    "verse": "3",
    "text": "मैं यहोवा को जो स्तुति के योग्य है पुकारूँगा;"
  },
  {
    "id": 14123,
    "book": "psalms                                  ",
    "chapter": "18",
    "verse": "4",
    "text": "मृत्यु की रस्सियों से मैं चारों ओर से घिर गया हूँ18:4 मृत्यु की रस्सियों से मैं चारों ओर से घिर गया हूँ: मेरे चारों ओर है। अर्थात् वह मृत्यु के तत्कालिक संकट में है। ,"
  },
  {
    "id": 14124,
    "book": "psalms                                  ",
    "chapter": "18",
    "verse": "5",
    "text": "अधोलोक की रस्सियाँ मेरे चारों ओर थीं,"
  },
  {
    "id": 14125,
    "book": "psalms                                  ",
    "chapter": "18",
    "verse": "6",
    "text": "अपने संकट में मैंने यहोवा परमेश्वर को पुकारा;"
  },
  {
    "id": 14126,
    "book": "psalms                                  ",
    "chapter": "18",
    "verse": "7",
    "text": "तब पृथ्वी हिल गई, और काँप उठी"
  },
  {
    "id": 14127,
    "book": "psalms                                  ",
    "chapter": "18",
    "verse": "8",
    "text": "उसके नथनों से धुआँ निकला,"
  },
  {
    "id": 14128,
    "book": "psalms                                  ",
    "chapter": "18",
    "verse": "9",
    "text": "वह स्वर्ग को नीचे झुकाकर उतर आया;"
  },
  {
    "id": 14129,
    "book": "psalms                                  ",
    "chapter": "18",
    "verse": "10",
    "text": "और वह करूब पर सवार होकर उड़ा,"
  },
  {
    "id": 14130,
    "book": "psalms                                  ",
    "chapter": "18",
    "verse": "11",
    "text": "उसने अंधियारे को अपने छिपने का स्थान"
  },
  {
    "id": 14131,
    "book": "psalms                                  ",
    "chapter": "18",
    "verse": "12",
    "text": "उसके आगे बिजली से,"
  },
  {
    "id": 14132,
    "book": "psalms                                  ",
    "chapter": "18",
    "verse": "13",
    "text": "तब यहोवा आकाश में गरजा,"
  },
  {
    "id": 14133,
    "book": "psalms                                  ",
    "chapter": "18",
    "verse": "14",
    "text": "उसने अपने तीर चला-चलाकर शत्रुओं को तितर-बितर किया;"
  },
  {
    "id": 14134,
    "book": "psalms                                  ",
    "chapter": "18",
    "verse": "15",
    "text": "तब जल के नाले देख पड़े, और जगत की नींव प्रगट हुई,"
  },
  {
    "id": 14135,
    "book": "psalms                                  ",
    "chapter": "18",
    "verse": "16",
    "text": "उसने ऊपर से हाथ बढ़ाकर मुझे थाम लिया,"
  },
  {
    "id": 14136,
    "book": "psalms                                  ",
    "chapter": "18",
    "verse": "17",
    "text": "उसने मेरे बलवन्त शत्रु से,"
  },
  {
    "id": 14137,
    "book": "psalms                                  ",
    "chapter": "18",
    "verse": "18",
    "text": "मेरे संकट के दिन वे मेरे विरुद्ध आए"
  },
  {
    "id": 14138,
    "book": "psalms                                  ",
    "chapter": "18",
    "verse": "19",
    "text": "और उसने मुझे निकालकर चौड़े स्थान में पहुँचाया,"
  },
  {
    "id": 14139,
    "book": "psalms                                  ",
    "chapter": "18",
    "verse": "20",
    "text": "यहोवा ने मुझसे मेरी धार्मिकता के अनुसार व्यवहार किया;"
  },
  {
    "id": 14140,
    "book": "psalms                                  ",
    "chapter": "18",
    "verse": "21",
    "text": "क्योंकि मैं यहोवा के मार्गों पर चलता रहा,"
  },
  {
    "id": 14141,
    "book": "psalms                                  ",
    "chapter": "18",
    "verse": "22",
    "text": "क्योंकि उसके सारे निर्णय मेरे सम्मुख बने रहे"
  },
  {
    "id": 14142,
    "book": "psalms                                  ",
    "chapter": "18",
    "verse": "23",
    "text": "और मैं उसके सम्मुख सिद्ध बना रहा,"
  },
  {
    "id": 14143,
    "book": "psalms                                  ",
    "chapter": "18",
    "verse": "24",
    "text": "यहोवा ने मुझे मेरी धार्मिकता के अनुसार बदला दिया,"
  },
  {
    "id": 14144,
    "book": "psalms                                  ",
    "chapter": "18",
    "verse": "25",
    "text": "विश्वासयोग्य के साथ तू अपने को विश्वासयोग्य दिखाता;"
  },
  {
    "id": 14145,
    "book": "psalms                                  ",
    "chapter": "18",
    "verse": "26",
    "text": "शुद्ध के साथ तू अपने को शुद्ध दिखाता,"
  },
  {
    "id": 14146,
    "book": "psalms                                  ",
    "chapter": "18",
    "verse": "27",
    "text": "क्योंकि तू दीन लोगों को तो बचाता है;"
  },
  {
    "id": 14147,
    "book": "psalms                                  ",
    "chapter": "18",
    "verse": "28",
    "text": "हाँ, तू ही मेरे दीपक को जलाता है;"
  },
  {
    "id": 14148,
    "book": "psalms                                  ",
    "chapter": "18",
    "verse": "29",
    "text": "क्योंकि तेरी सहायता से मैं सेना पर धावा करता हूँ;"
  },
  {
    "id": 14149,
    "book": "psalms                                  ",
    "chapter": "18",
    "verse": "30",
    "text": "परमेश्वर का मार्ग सिद्ध है;"
  },
  {
    "id": 14150,
    "book": "psalms                                  ",
    "chapter": "18",
    "verse": "31",
    "text": "यहोवा को छोड़ क्या कोई परमेश्वर है?"
  },
  {
    "id": 14151,
    "book": "psalms                                  ",
    "chapter": "18",
    "verse": "32",
    "text": "यह वही परमेश्वर है, जो सामर्थ्य से मेरा कमरबन्ध बाँधता है,"
  },
  {
    "id": 14152,
    "book": "psalms                                  ",
    "chapter": "18",
    "verse": "33",
    "text": "वही मेरे पैरों को हिरनी के पैरों के समान बनाता है,"
  },
  {
    "id": 14153,
    "book": "psalms                                  ",
    "chapter": "18",
    "verse": "34",
    "text": "वह मेरे हाथों को युद्ध करना सिखाता है,"
  },
  {
    "id": 14154,
    "book": "psalms                                  ",
    "chapter": "18",
    "verse": "35",
    "text": "तूने मुझ को अपने बचाव की ढाल दी है,"
  },
  {
    "id": 14155,
    "book": "psalms                                  ",
    "chapter": "18",
    "verse": "36",
    "text": "तूने मेरे पैरों के लिये स्थान चौड़ा कर दिया18:36 तूने मेरे पैरों के लिये स्थान चौड़ा कर दिया: कि मैं बिना रुकावट या बाधा के चल पाऊँ। ,"
  },
  {
    "id": 14156,
    "book": "psalms                                  ",
    "chapter": "18",
    "verse": "37",
    "text": "मैं अपने शत्रुओं का पीछा करके उन्हें पकड़ लूँगा;"
  },
  {
    "id": 14157,
    "book": "psalms                                  ",
    "chapter": "18",
    "verse": "38",
    "text": "मैं उन्हें ऐसा बेधूँगा कि वे उठ न सकेंगे;"
  },
  {
    "id": 14158,
    "book": "psalms                                  ",
    "chapter": "18",
    "verse": "39",
    "text": "क्योंकि तूने युद्ध के लिये मेरी कमर में"
  },
  {
    "id": 14159,
    "book": "psalms                                  ",
    "chapter": "18",
    "verse": "40",
    "text": "तूने मेरे शत्रुओं की पीठ मेरी ओर फेर दी;"
  },
  {
    "id": 14160,
    "book": "psalms                                  ",
    "chapter": "18",
    "verse": "41",
    "text": "उन्होंने दुहाई तो दी परन्तु उन्हें कोई बचानेवाला न मिला,"
  },
  {
    "id": 14161,
    "book": "psalms                                  ",
    "chapter": "18",
    "verse": "42",
    "text": "तब मैंने उनको कूट कूटकर पवन से उड़ाई"
  },
  {
    "id": 14162,
    "book": "psalms                                  ",
    "chapter": "18",
    "verse": "43",
    "text": "तूने मुझे प्रजा के झगड़ों से भी छुड़ाया;"
  },
  {
    "id": 14163,
    "book": "psalms                                  ",
    "chapter": "18",
    "verse": "44",
    "text": "मेरा नाम सुनते ही वे मेरी आज्ञा का पालन करेंगे;"
  },
  {
    "id": 14164,
    "book": "psalms                                  ",
    "chapter": "18",
    "verse": "45",
    "text": "परदेशी मुर्झा जाएँगे,"
  },
  {
    "id": 14165,
    "book": "psalms                                  ",
    "chapter": "18",
    "verse": "46",
    "text": "यहोवा परमेश्वर जीवित है; मेरी चट्टान धन्य है;"
  },
  {
    "id": 14166,
    "book": "psalms                                  ",
    "chapter": "18",
    "verse": "47",
    "text": "धन्य है मेरा पलटा लेनेवाला परमेश्वर!"
  },
  {
    "id": 14167,
    "book": "psalms                                  ",
    "chapter": "18",
    "verse": "48",
    "text": "और मुझे मेरे शत्रुओं से छुड़ाया है;"
  },
  {
    "id": 14168,
    "book": "psalms                                  ",
    "chapter": "18",
    "verse": "49",
    "text": "इस कारण मैं जाति-जाति के सामने तेरा धन्यवाद करूँगा,"
  },
  {
    "id": 14169,
    "book": "psalms                                  ",
    "chapter": "18",
    "verse": "50",
    "text": "वह अपने ठहराए हुए राजा को महान विजय देता है,"
  }
]
