[
  {
    "id": 14321,
    "book": "psalms                                  ",
    "chapter": "30",
    "verse": "1",
    "text": "हे यहोवा, मैं तुझे सराहूँगा क्योंकि तूने"
  },
  {
    "id": 14322,
    "book": "psalms                                  ",
    "chapter": "30",
    "verse": "2",
    "text": "हे मेरे परमेश्वर यहोवा,"
  },
  {
    "id": 14323,
    "book": "psalms                                  ",
    "chapter": "30",
    "verse": "3",
    "text": "हे यहोवा, तूने मेरा प्राण अधोलोक में से निकाला है,"
  },
  {
    "id": 14324,
    "book": "psalms                                  ",
    "chapter": "30",
    "verse": "4",
    "text": "तुम जो विश्वासयोग्य हो!"
  },
  {
    "id": 14325,
    "book": "psalms                                  ",
    "chapter": "30",
    "verse": "5",
    "text": "क्योंकि उसका क्रोध, तो क्षण भर का होता है,"
  },
  {
    "id": 14326,
    "book": "psalms                                  ",
    "chapter": "30",
    "verse": "6",
    "text": "मैंने तो अपने चैन के समय कहा था,"
  },
  {
    "id": 14327,
    "book": "psalms                                  ",
    "chapter": "30",
    "verse": "7",
    "text": "हे यहोवा, अपनी प्रसन्नता से तूने मेरे पहाड़ को दृढ़"
  },
  {
    "id": 14328,
    "book": "psalms                                  ",
    "chapter": "30",
    "verse": "8",
    "text": "हे यहोवा, मैंने तुझी को पुकारा;"
  },
  {
    "id": 14329,
    "book": "psalms                                  ",
    "chapter": "30",
    "verse": "9",
    "text": "जब मैं कब्र में चला जाऊँगा तब मेरी मृत्यु से"
  },
  {
    "id": 14330,
    "book": "psalms                                  ",
    "chapter": "30",
    "verse": "10",
    "text": "हे यहोवा, सुन, मुझ पर दया कर;"
  },
  {
    "id": 14331,
    "book": "psalms                                  ",
    "chapter": "30",
    "verse": "11",
    "text": "तूने मेरे लिये विलाप को नृत्य में बदल डाला;"
  },
  {
    "id": 14332,
    "book": "psalms                                  ",
    "chapter": "30",
    "verse": "12",
    "text": "ताकि मेरा मन तेरा भजन गाता रहे"
  }
]
