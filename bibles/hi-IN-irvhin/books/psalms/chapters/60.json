[
  {
    "id": 14809,
    "book": "psalms                                  ",
    "chapter": "60",
    "verse": "1",
    "text": "हे परमेश्वर, तूने हमको त्याग दिया,"
  },
  {
    "id": 14810,
    "book": "psalms                                  ",
    "chapter": "60",
    "verse": "2",
    "text": "तूने भूमि को कँपाया और फाड़ डाला है;"
  },
  {
    "id": 14811,
    "book": "psalms                                  ",
    "chapter": "60",
    "verse": "3",
    "text": "तूने अपनी प्रजा को कठिन समय दिखाया;"
  },
  {
    "id": 14812,
    "book": "psalms                                  ",
    "chapter": "60",
    "verse": "4",
    "text": "तूने अपने डरवैयों को झण्डा दिया है,"
  },
  {
    "id": 14813,
    "book": "psalms                                  ",
    "chapter": "60",
    "verse": "5",
    "text": "तू अपने दाहिने हाथ से बचा, और हमारी सुन ले"
  },
  {
    "id": 14814,
    "book": "psalms                                  ",
    "chapter": "60",
    "verse": "6",
    "text": "परमेश्वर पवित्रता के साथ बोला है, “मैं प्रफुल्लित होऊँगा;"
  },
  {
    "id": 14815,
    "book": "psalms                                  ",
    "chapter": "60",
    "verse": "7",
    "text": "गिलाद मेरा है; मनश्शे भी मेरा है;"
  },
  {
    "id": 14816,
    "book": "psalms                                  ",
    "chapter": "60",
    "verse": "8",
    "text": "मोआब मेरे धोने का पात्र है;"
  },
  {
    "id": 14817,
    "book": "psalms                                  ",
    "chapter": "60",
    "verse": "9",
    "text": "मुझे गढ़वाले नगर में कौन पहुँचाएगा?"
  },
  {
    "id": 14818,
    "book": "psalms                                  ",
    "chapter": "60",
    "verse": "10",
    "text": "हे परमेश्वर, क्या तूने हमको त्याग नहीं दिया?"
  },
  {
    "id": 14819,
    "book": "psalms                                  ",
    "chapter": "60",
    "verse": "11",
    "text": "शत्रु के विरुद्ध हमारी सहायता कर,"
  },
  {
    "id": 14820,
    "book": "psalms                                  ",
    "chapter": "60",
    "verse": "12",
    "text": "परमेश्वर की सहायता से हम वीरता दिखाएँगे,"
  }
]
