[
  {
    "id": 15310,
    "book": "psalms                                  ",
    "chapter": "88",
    "verse": "1",
    "text": "हे मेरे उद्धारकर्ता परमेश्वर यहोवा,"
  },
  {
    "id": 15311,
    "book": "psalms                                  ",
    "chapter": "88",
    "verse": "2",
    "text": "मेरी प्रार्थना तुझ तक पहुँचे,"
  },
  {
    "id": 15312,
    "book": "psalms                                  ",
    "chapter": "88",
    "verse": "3",
    "text": "क्योंकि मेरा प्राण क्लेश से भरा हुआ है,"
  },
  {
    "id": 15313,
    "book": "psalms                                  ",
    "chapter": "88",
    "verse": "4",
    "text": "मैं कब्र में पड़नेवालों में गिना गया हूँ;"
  },
  {
    "id": 15314,
    "book": "psalms                                  ",
    "chapter": "88",
    "verse": "5",
    "text": "मैं मुर्दों के बीच छोड़ा गया हूँ,"
  },
  {
    "id": 15315,
    "book": "psalms                                  ",
    "chapter": "88",
    "verse": "6",
    "text": "तूने मुझे गड्ढे के तल ही में,"
  },
  {
    "id": 15316,
    "book": "psalms                                  ",
    "chapter": "88",
    "verse": "7",
    "text": "तेरी जलजलाहट मुझी पर बनी हुई है88:7 तेरी जलजलाहट मुझी पर बनी हुई है: मुझे दबा देती है, मुझ पर बोझ डालती है। यह क्रोध और अप्रसन्नता को व्यक्त करने की सामान्य शब्दावली है। ,"
  },
  {
    "id": 15317,
    "book": "psalms                                  ",
    "chapter": "88",
    "verse": "8",
    "text": "तूने मेरे पहचानवालों को मुझसे दूर किया है;"
  },
  {
    "id": 15318,
    "book": "psalms                                  ",
    "chapter": "88",
    "verse": "9",
    "text": "दुःख भोगते-भोगते मेरी आँखें धुँधला गई।"
  },
  {
    "id": 15319,
    "book": "psalms                                  ",
    "chapter": "88",
    "verse": "10",
    "text": "क्या तू मुर्दों के लिये अद्भुत काम करेगा?"
  },
  {
    "id": 15320,
    "book": "psalms                                  ",
    "chapter": "88",
    "verse": "11",
    "text": "क्या कब्र में तेरी करुणा का,"
  },
  {
    "id": 15321,
    "book": "psalms                                  ",
    "chapter": "88",
    "verse": "12",
    "text": "क्या तेरे अद्भुत काम अंधकार में,"
  },
  {
    "id": 15322,
    "book": "psalms                                  ",
    "chapter": "88",
    "verse": "13",
    "text": "परन्तु हे यहोवा, मैंने तेरी दुहाई दी है;"
  },
  {
    "id": 15323,
    "book": "psalms                                  ",
    "chapter": "88",
    "verse": "14",
    "text": "हे यहोवा, तू मुझ को क्यों छोड़ता है?"
  },
  {
    "id": 15324,
    "book": "psalms                                  ",
    "chapter": "88",
    "verse": "15",
    "text": "मैं बचपन ही से दुःखी वरन् अधमुआ हूँ,"
  },
  {
    "id": 15325,
    "book": "psalms                                  ",
    "chapter": "88",
    "verse": "16",
    "text": "तेरा क्रोध मुझ पर पड़ा है;"
  },
  {
    "id": 15326,
    "book": "psalms                                  ",
    "chapter": "88",
    "verse": "17",
    "text": "वह दिन भर जल के समान मुझे घेरे रहता है;"
  },
  {
    "id": 15327,
    "book": "psalms                                  ",
    "chapter": "88",
    "verse": "18",
    "text": "तूने मित्र और भाई-बन्धु दोनों को मुझसे दूर किया है;"
  }
]
