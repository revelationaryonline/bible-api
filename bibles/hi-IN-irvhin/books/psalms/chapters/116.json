[
  {
    "id": 15850,
    "book": "psalms                                  ",
    "chapter": "116",
    "verse": "1",
    "text": "मैं प्रेम रखता हूँ, इसलिए कि यहोवा ने मेरे गिड़गिड़ाने को सुना है।"
  },
  {
    "id": 15851,
    "book": "psalms                                  ",
    "chapter": "116",
    "verse": "2",
    "text": "उसने जो मेरी ओर कान लगाया है,"
  },
  {
    "id": 15852,
    "book": "psalms                                  ",
    "chapter": "116",
    "verse": "3",
    "text": "मृत्यु की रस्सियाँ मेरे चारों ओर थीं;"
  },
  {
    "id": 15853,
    "book": "psalms                                  ",
    "chapter": "116",
    "verse": "4",
    "text": "तब मैंने यहोवा से प्रार्थना की,"
  },
  {
    "id": 15854,
    "book": "psalms                                  ",
    "chapter": "116",
    "verse": "5",
    "text": "यहोवा करुणामय और धर्मी है;"
  },
  {
    "id": 15855,
    "book": "psalms                                  ",
    "chapter": "116",
    "verse": "6",
    "text": "यहोवा भोलों की रक्षा करता है;"
  },
  {
    "id": 15856,
    "book": "psalms                                  ",
    "chapter": "116",
    "verse": "7",
    "text": "हे मेरे प्राण, तू अपने विश्रामस्थान में लौट आ;"
  },
  {
    "id": 15857,
    "book": "psalms                                  ",
    "chapter": "116",
    "verse": "8",
    "text": "तूने तो मेरे प्राण को मृत्यु से,"
  },
  {
    "id": 15858,
    "book": "psalms                                  ",
    "chapter": "116",
    "verse": "9",
    "text": "मैं जीवित रहते हुए,"
  },
  {
    "id": 15859,
    "book": "psalms                                  ",
    "chapter": "116",
    "verse": "10",
    "text": "मैंने जो ऐसा कहा है, इसे विश्वास की कसौटी पर कसकर कहा है,"
  },
  {
    "id": 15860,
    "book": "psalms                                  ",
    "chapter": "116",
    "verse": "11",
    "text": "मैंने उतावली से कहा,"
  },
  {
    "id": 15861,
    "book": "psalms                                  ",
    "chapter": "116",
    "verse": "12",
    "text": "यहोवा ने मेरे जितने उपकार किए हैं,"
  },
  {
    "id": 15862,
    "book": "psalms                                  ",
    "chapter": "116",
    "verse": "13",
    "text": "मैं उद्धार का कटोरा उठाकर,"
  },
  {
    "id": 15863,
    "book": "psalms                                  ",
    "chapter": "116",
    "verse": "14",
    "text": "मैं यहोवा के लिये अपनी मन्नतें, सभी की दृष्टि में प्रगट रूप में, उसकी सारी प्रजा के सामने पूरी करूँगा।"
  },
  {
    "id": 15864,
    "book": "psalms                                  ",
    "chapter": "116",
    "verse": "15",
    "text": "यहोवा के भक्तों की मृत्यु,"
  },
  {
    "id": 15865,
    "book": "psalms                                  ",
    "chapter": "116",
    "verse": "16",
    "text": "हे यहोवा, सुन, मैं तो तेरा दास हूँ;"
  },
  {
    "id": 15866,
    "book": "psalms                                  ",
    "chapter": "116",
    "verse": "17",
    "text": "मैं तुझको धन्यवाद-बलि चढ़ाऊँगा,"
  },
  {
    "id": 15867,
    "book": "psalms                                  ",
    "chapter": "116",
    "verse": "18",
    "text": "मैं यहोवा के लिये अपनी मन्नतें,"
  },
  {
    "id": 15868,
    "book": "psalms                                  ",
    "chapter": "116",
    "verse": "19",
    "text": "यहोवा के भवन के आँगनों में,"
  }
]
