[
  {
    "id": 14333,
    "book": "psalms                                  ",
    "chapter": "31",
    "verse": "1",
    "text": "हे यहोवा, मैं तुझ में शरण लेता हूँ;"
  },
  {
    "id": 14334,
    "book": "psalms                                  ",
    "chapter": "31",
    "verse": "2",
    "text": "अपना कान मेरी ओर लगाकर"
  },
  {
    "id": 14335,
    "book": "psalms                                  ",
    "chapter": "31",
    "verse": "3",
    "text": "क्योंकि तू मेरे लिये चट्टान और मेरा गढ़ है;"
  },
  {
    "id": 14336,
    "book": "psalms                                  ",
    "chapter": "31",
    "verse": "4",
    "text": "जो जाल उन्होंने मेरे लिये बिछाया है"
  },
  {
    "id": 14337,
    "book": "psalms                                  ",
    "chapter": "31",
    "verse": "5",
    "text": "मैं अपनी आत्मा को तेरे ही हाथ में सौंप देता हूँ;"
  },
  {
    "id": 14338,
    "book": "psalms                                  ",
    "chapter": "31",
    "verse": "6",
    "text": "जो व्यर्थ मूर्तियों पर मन लगाते हैं,"
  },
  {
    "id": 14339,
    "book": "psalms                                  ",
    "chapter": "31",
    "verse": "7",
    "text": "मैं तेरी करुणा से मगन और आनन्दित हूँ,"
  },
  {
    "id": 14340,
    "book": "psalms                                  ",
    "chapter": "31",
    "verse": "8",
    "text": "और तूने मुझे शत्रु के हाथ में पड़ने नहीं दिया;"
  },
  {
    "id": 14341,
    "book": "psalms                                  ",
    "chapter": "31",
    "verse": "9",
    "text": "हे यहोवा, मुझ पर दया कर क्योंकि मैं संकट में हूँ;"
  },
  {
    "id": 14342,
    "book": "psalms                                  ",
    "chapter": "31",
    "verse": "10",
    "text": "मेरा जीवन शोक के मारे"
  },
  {
    "id": 14343,
    "book": "psalms                                  ",
    "chapter": "31",
    "verse": "11",
    "text": "अपने सब विरोधियों के कारण मेरे पड़ोसियों"
  },
  {
    "id": 14344,
    "book": "psalms                                  ",
    "chapter": "31",
    "verse": "12",
    "text": "मैं मृतक के समान लोगों के मन से बिसर गया;"
  },
  {
    "id": 14345,
    "book": "psalms                                  ",
    "chapter": "31",
    "verse": "13",
    "text": "मैंने बहुतों के मुँह से अपनी निन्दा सुनी,"
  },
  {
    "id": 14346,
    "book": "psalms                                  ",
    "chapter": "31",
    "verse": "14",
    "text": "परन्तु हे यहोवा, मैंने तो तुझी पर भरोसा रखा है,"
  },
  {
    "id": 14347,
    "book": "psalms                                  ",
    "chapter": "31",
    "verse": "15",
    "text": "मेरे दिन तेरे हाथ में है;"
  },
  {
    "id": 14348,
    "book": "psalms                                  ",
    "chapter": "31",
    "verse": "16",
    "text": "अपने दास पर अपने मुँह का प्रकाश चमका;"
  },
  {
    "id": 14349,
    "book": "psalms                                  ",
    "chapter": "31",
    "verse": "17",
    "text": "हे यहोवा, मुझे लज्जित न होने दे"
  },
  {
    "id": 14350,
    "book": "psalms                                  ",
    "chapter": "31",
    "verse": "18",
    "text": "जो अहंकार और अपमान से धर्मी की निन्दा करते हैं,"
  },
  {
    "id": 14351,
    "book": "psalms                                  ",
    "chapter": "31",
    "verse": "19",
    "text": "आहा, तेरी भलाई क्या ही बड़ी है"
  },
  {
    "id": 14352,
    "book": "psalms                                  ",
    "chapter": "31",
    "verse": "20",
    "text": "तू उन्हें दर्शन देने के गुप्त स्थान में31:20 दर्शन देने के गुप्त स्थान में: विचार यह कि वह उन्हें छिपा लेगा या उन्हें सब के सामने से हटा लेगा या उनके बैरियों की दृष्टि से ओझल कर देगा। मनुष्यों की"
  },
  {
    "id": 14353,
    "book": "psalms                                  ",
    "chapter": "31",
    "verse": "21",
    "text": "यहोवा धन्य है,"
  },
  {
    "id": 14354,
    "book": "psalms                                  ",
    "chapter": "31",
    "verse": "22",
    "text": "मैंने तो घबराकर कहा था कि मैं यहोवा की"
  },
  {
    "id": 14355,
    "book": "psalms                                  ",
    "chapter": "31",
    "verse": "23",
    "text": "हे यहोवा के सब भक्तों, उससे प्रेम रखो!"
  },
  {
    "id": 14356,
    "book": "psalms                                  ",
    "chapter": "31",
    "verse": "24",
    "text": "हे यहोवा पर आशा रखनेवालों,"
  }
]
