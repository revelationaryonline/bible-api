[
  {
    "id": 15871,
    "book": "psalms                                  ",
    "chapter": "118",
    "verse": "1",
    "text": "यहोवा का धन्यवाद करो, क्योंकि वह भला है;"
  },
  {
    "id": 15872,
    "book": "psalms                                  ",
    "chapter": "118",
    "verse": "2",
    "text": "इस्राएल कहे,"
  },
  {
    "id": 15873,
    "book": "psalms                                  ",
    "chapter": "118",
    "verse": "3",
    "text": "हारून का घराना कहे,"
  },
  {
    "id": 15874,
    "book": "psalms                                  ",
    "chapter": "118",
    "verse": "4",
    "text": "यहोवा के डरवैये कहे,"
  },
  {
    "id": 15875,
    "book": "psalms                                  ",
    "chapter": "118",
    "verse": "5",
    "text": "मैंने सकेती में परमेश्वर को पुकारा118:5 मैंने सकेती में परमेश्वर को पुकारा: संकटों के मध्य उसने परमेश्वर से प्रार्थना की और उसकी वाणी जो उसके दु:खों की गहराई से निकलती थी सुनी गई। ,"
  },
  {
    "id": 15876,
    "book": "psalms                                  ",
    "chapter": "118",
    "verse": "6",
    "text": "यहोवा मेरी ओर है, मैं न डरूँगा।"
  },
  {
    "id": 15877,
    "book": "psalms                                  ",
    "chapter": "118",
    "verse": "7",
    "text": "यहोवा मेरी ओर मेरे सहायक है;"
  },
  {
    "id": 15878,
    "book": "psalms                                  ",
    "chapter": "118",
    "verse": "8",
    "text": "यहोवा की शरण लेना,"
  },
  {
    "id": 15879,
    "book": "psalms                                  ",
    "chapter": "118",
    "verse": "9",
    "text": "यहोवा की शरण लेना,"
  },
  {
    "id": 15880,
    "book": "psalms                                  ",
    "chapter": "118",
    "verse": "10",
    "text": "सब जातियों ने मुझ को घेर लिया है;"
  },
  {
    "id": 15881,
    "book": "psalms                                  ",
    "chapter": "118",
    "verse": "11",
    "text": "उन्होंने मुझ को घेर लिया है, निःसन्देह, उन्होंने मुझे घेर लिया है;"
  },
  {
    "id": 15882,
    "book": "psalms                                  ",
    "chapter": "118",
    "verse": "12",
    "text": "उन्होंने मुझे मधुमक्खियों के समान घेर लिया है,"
  },
  {
    "id": 15883,
    "book": "psalms                                  ",
    "chapter": "118",
    "verse": "13",
    "text": "तूने मुझे बड़ा धक्का दिया तो था, कि मैं गिर पड़ूँ,"
  },
  {
    "id": 15884,
    "book": "psalms                                  ",
    "chapter": "118",
    "verse": "14",
    "text": "परमेश्वर मेरा बल और भजन का विषय है;"
  },
  {
    "id": 15885,
    "book": "psalms                                  ",
    "chapter": "118",
    "verse": "15",
    "text": "धर्मियों के तम्बुओं में जयजयकार और उद्धार की ध्वनि हो रही है,"
  },
  {
    "id": 15886,
    "book": "psalms                                  ",
    "chapter": "118",
    "verse": "16",
    "text": "यहोवा का दाहिना हाथ महान हुआ है,"
  },
  {
    "id": 15887,
    "book": "psalms                                  ",
    "chapter": "118",
    "verse": "17",
    "text": "मैं न मरूँगा वरन् जीवित रहूँगा118:17 मैं न मरूँगा वरन् जीवित रहूँगा: स्पष्ट है कि भजनकार ने जान लिया था कि वह मर जाएगा या उसे मृत्यु के अवश्यंभावी संकट की अनुभूति हो गई थी।,"
  },
  {
    "id": 15888,
    "book": "psalms                                  ",
    "chapter": "118",
    "verse": "18",
    "text": "परमेश्वर ने मेरी बड़ी ताड़ना तो की है"
  },
  {
    "id": 15889,
    "book": "psalms                                  ",
    "chapter": "118",
    "verse": "19",
    "text": "मेरे लिये धर्म के द्वार खोलो,"
  },
  {
    "id": 15890,
    "book": "psalms                                  ",
    "chapter": "118",
    "verse": "20",
    "text": "यहोवा का द्वार यही है,"
  },
  {
    "id": 15891,
    "book": "psalms                                  ",
    "chapter": "118",
    "verse": "21",
    "text": "हे यहोवा, मैं तेरा धन्यवाद करूँगा,"
  },
  {
    "id": 15892,
    "book": "psalms                                  ",
    "chapter": "118",
    "verse": "22",
    "text": "राजमिस्त्रियों ने जिस पत्थर को निकम्मा ठहराया था"
  },
  {
    "id": 15893,
    "book": "psalms                                  ",
    "chapter": "118",
    "verse": "23",
    "text": "यह तो यहोवा की ओर से हुआ है,"
  },
  {
    "id": 15894,
    "book": "psalms                                  ",
    "chapter": "118",
    "verse": "24",
    "text": "आज वह दिन है जो यहोवा ने बनाया है;"
  },
  {
    "id": 15895,
    "book": "psalms                                  ",
    "chapter": "118",
    "verse": "25",
    "text": "हे यहोवा, विनती सुन, उद्धार कर!"
  },
  {
    "id": 15896,
    "book": "psalms                                  ",
    "chapter": "118",
    "verse": "26",
    "text": "धन्य है वह जो यहोवा के नाम से आता है!"
  },
  {
    "id": 15897,
    "book": "psalms                                  ",
    "chapter": "118",
    "verse": "27",
    "text": "यहोवा परमेश्वर है, और उसने हमको प्रकाश दिया है।"
  },
  {
    "id": 15898,
    "book": "psalms                                  ",
    "chapter": "118",
    "verse": "28",
    "text": "हे यहोवा, तू मेरा परमेश्वर है, मैं तेरा धन्यवाद करूँगा;"
  },
  {
    "id": 15899,
    "book": "psalms                                  ",
    "chapter": "118",
    "verse": "29",
    "text": "यहोवा का धन्यवाद करो, क्योंकि वह भला है;"
  }
]
