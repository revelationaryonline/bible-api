[
  {
    "id": 14557,
    "book": "psalms                                  ",
    "chapter": "42",
    "verse": "1",
    "text": "जैसे हिरनी नदी के जल के लिये हाँफती है,"
  },
  {
    "id": 14558,
    "book": "psalms                                  ",
    "chapter": "42",
    "verse": "2",
    "text": "जीविते परमेश्वर, हाँ परमेश्वर, का मैं प्यासा हूँ,"
  },
  {
    "id": 14559,
    "book": "psalms                                  ",
    "chapter": "42",
    "verse": "3",
    "text": "मेरे आँसू दिन और रात मेरा आहार हुए हैं;"
  },
  {
    "id": 14560,
    "book": "psalms                                  ",
    "chapter": "42",
    "verse": "4",
    "text": "मैं कैसे भीड़ के संग जाया करता था,"
  },
  {
    "id": 14561,
    "book": "psalms                                  ",
    "chapter": "42",
    "verse": "5",
    "text": "हे मेरे प्राण, तू क्यों गिरा जाता है?"
  },
  {
    "id": 14562,
    "book": "psalms                                  ",
    "chapter": "42",
    "verse": "6",
    "text": "हे मेरे परमेश्वर; मेरा प्राण मेरे भीतर गिरा जाता है,"
  },
  {
    "id": 14563,
    "book": "psalms                                  ",
    "chapter": "42",
    "verse": "7",
    "text": "तेरी जलधाराओं का शब्द सुनकर जल,"
  },
  {
    "id": 14564,
    "book": "psalms                                  ",
    "chapter": "42",
    "verse": "8",
    "text": "तो भी दिन को यहोवा अपनी शक्ति"
  },
  {
    "id": 14565,
    "book": "psalms                                  ",
    "chapter": "42",
    "verse": "9",
    "text": "मैं परमेश्वर से जो मेरी चट्टान है कहूँगा,"
  },
  {
    "id": 14566,
    "book": "psalms                                  ",
    "chapter": "42",
    "verse": "10",
    "text": "मेरे सतानेवाले जो मेरी निन्दा करते हैं,"
  },
  {
    "id": 14567,
    "book": "psalms                                  ",
    "chapter": "42",
    "verse": "11",
    "text": "हे मेरे प्राण तू क्यों गिरा जाता है?"
  }
]
