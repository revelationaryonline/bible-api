[
  {
    "id": 16177,
    "book": "psalms                                  ",
    "chapter": "135",
    "verse": "1",
    "text": "यहोवा की स्तुति करो,"
  },
  {
    "id": 16178,
    "book": "psalms                                  ",
    "chapter": "135",
    "verse": "2",
    "text": "तुम जो यहोवा के भवन में,"
  },
  {
    "id": 16179,
    "book": "psalms                                  ",
    "chapter": "135",
    "verse": "3",
    "text": "यहोवा की स्तुति करो, क्योंकि वो भला है;"
  },
  {
    "id": 16180,
    "book": "psalms                                  ",
    "chapter": "135",
    "verse": "4",
    "text": "यहोवा ने तो याकूब को अपने लिये चुना है135:4 यहोवा ने तो याकूब को अपने लिये चुना है: अर्थात् याकूब के वंशजों को परमेश्वर ने उन्हें पृथ्वी के सब निवासियों में से अपने लिए एक विशेष प्रजा बनाया है। ,"
  },
  {
    "id": 16181,
    "book": "psalms                                  ",
    "chapter": "135",
    "verse": "5",
    "text": "मैं तो जानता हूँ कि यहोवा महान है,"
  },
  {
    "id": 16182,
    "book": "psalms                                  ",
    "chapter": "135",
    "verse": "6",
    "text": "जो कुछ यहोवा ने चाहा"
  },
  {
    "id": 16183,
    "book": "psalms                                  ",
    "chapter": "135",
    "verse": "7",
    "text": "वह पृथ्वी की छोर से कुहरे उठाता है,"
  },
  {
    "id": 16184,
    "book": "psalms                                  ",
    "chapter": "135",
    "verse": "8",
    "text": "उसने मिस्र में क्या मनुष्य क्या पशु,"
  },
  {
    "id": 16185,
    "book": "psalms                                  ",
    "chapter": "135",
    "verse": "9",
    "text": "हे मिस्र, उसने तेरे बीच में फ़िरौन"
  },
  {
    "id": 16186,
    "book": "psalms                                  ",
    "chapter": "135",
    "verse": "10",
    "text": "उसने बहुत सी जातियाँ नाश की,"
  },
  {
    "id": 16187,
    "book": "psalms                                  ",
    "chapter": "135",
    "verse": "11",
    "text": "अर्थात् एमोरियों के राजा सीहोन को,"
  },
  {
    "id": 16188,
    "book": "psalms                                  ",
    "chapter": "135",
    "verse": "12",
    "text": "और उनके देश को बाँटकर,"
  },
  {
    "id": 16189,
    "book": "psalms                                  ",
    "chapter": "135",
    "verse": "13",
    "text": "हे यहोवा, तेरा नाम सदा स्थिर है,"
  },
  {
    "id": 16190,
    "book": "psalms                                  ",
    "chapter": "135",
    "verse": "14",
    "text": "यहोवा तो अपनी प्रजा का न्याय चुकाएगा,"
  },
  {
    "id": 16191,
    "book": "psalms                                  ",
    "chapter": "135",
    "verse": "15",
    "text": "अन्यजातियों की मूरतें सोना-चाँदी ही हैं,"
  },
  {
    "id": 16192,
    "book": "psalms                                  ",
    "chapter": "135",
    "verse": "16",
    "text": "उनके मुँह तो रहता है, परन्तु वे बोल नहीं सकती,"
  },
  {
    "id": 16193,
    "book": "psalms                                  ",
    "chapter": "135",
    "verse": "17",
    "text": "उनके कान तो रहते हैं, परन्तु वे सुन नहीं सकती,"
  },
  {
    "id": 16194,
    "book": "psalms                                  ",
    "chapter": "135",
    "verse": "18",
    "text": "जैसी वे हैं वैसे ही उनके बनानेवाले भी हैं;"
  },
  {
    "id": 16195,
    "book": "psalms                                  ",
    "chapter": "135",
    "verse": "19",
    "text": "हे इस्राएल के घराने, यहोवा को धन्य कह!"
  },
  {
    "id": 16196,
    "book": "psalms                                  ",
    "chapter": "135",
    "verse": "20",
    "text": "हे लेवी के घराने, यहोवा को धन्य कह!"
  },
  {
    "id": 16197,
    "book": "psalms                                  ",
    "chapter": "135",
    "verse": "21",
    "text": "यहोवा जो यरूशलेम में वास करता है,"
  }
]
