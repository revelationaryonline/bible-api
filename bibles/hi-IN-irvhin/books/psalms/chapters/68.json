[
  {
    "id": 14902,
    "book": "psalms                                  ",
    "chapter": "68",
    "verse": "1",
    "text": "परमेश्वर उठे, उसके शत्रु तितर-बितर हों;"
  },
  {
    "id": 14903,
    "book": "psalms                                  ",
    "chapter": "68",
    "verse": "2",
    "text": "जैसे धुआँ उड़ जाता है, वैसे ही तू उनको उड़ा दे;"
  },
  {
    "id": 14904,
    "book": "psalms                                  ",
    "chapter": "68",
    "verse": "3",
    "text": "परन्तु धर्मी आनन्दित हों; वे परमेश्वर के सामने प्रफुल्लित हों;"
  },
  {
    "id": 14905,
    "book": "psalms                                  ",
    "chapter": "68",
    "verse": "4",
    "text": "परमेश्वर का गीत गाओ, उसके नाम का भजन गाओ;"
  },
  {
    "id": 14906,
    "book": "psalms                                  ",
    "chapter": "68",
    "verse": "5",
    "text": "परमेश्वर अपने पवित्र धाम में,"
  },
  {
    "id": 14907,
    "book": "psalms                                  ",
    "chapter": "68",
    "verse": "6",
    "text": "परमेश्वर अनाथों का घर बसाता है;"
  },
  {
    "id": 14908,
    "book": "psalms                                  ",
    "chapter": "68",
    "verse": "7",
    "text": "हे परमेश्वर, जब तू अपनी प्रजा के आगे-आगे चलता था,"
  },
  {
    "id": 14909,
    "book": "psalms                                  ",
    "chapter": "68",
    "verse": "8",
    "text": "तब पृथ्वी काँप उठी,"
  },
  {
    "id": 14910,
    "book": "psalms                                  ",
    "chapter": "68",
    "verse": "9",
    "text": "हे परमेश्वर, तूने बहुतायत की वर्षा की;"
  },
  {
    "id": 14911,
    "book": "psalms                                  ",
    "chapter": "68",
    "verse": "10",
    "text": "तेरा झुण्ड उसमें बसने लगा;"
  },
  {
    "id": 14912,
    "book": "psalms                                  ",
    "chapter": "68",
    "verse": "11",
    "text": "प्रभु आज्ञा देता है,"
  },
  {
    "id": 14913,
    "book": "psalms                                  ",
    "chapter": "68",
    "verse": "12",
    "text": "अपनी-अपनी सेना समेत राजा भागे चले जाते हैं,"
  },
  {
    "id": 14914,
    "book": "psalms                                  ",
    "chapter": "68",
    "verse": "13",
    "text": "क्या तुम भेड़शालाओं के बीच लेट जाओगे?"
  },
  {
    "id": 14915,
    "book": "psalms                                  ",
    "chapter": "68",
    "verse": "14",
    "text": "जब सर्वशक्तिमान ने उसमें राजाओं को तितर-बितर किया,"
  },
  {
    "id": 14916,
    "book": "psalms                                  ",
    "chapter": "68",
    "verse": "15",
    "text": "बाशान का पहाड़ परमेश्वर का पहाड़ है;"
  },
  {
    "id": 14917,
    "book": "psalms                                  ",
    "chapter": "68",
    "verse": "16",
    "text": "परन्तु हे शिखरवाले पहाड़ों, तुम क्यों उस पर्वत को घूरते हो,"
  },
  {
    "id": 14918,
    "book": "psalms                                  ",
    "chapter": "68",
    "verse": "17",
    "text": "परमेश्वर के रथ बीस हजार, वरन् हजारों हजार हैं;"
  },
  {
    "id": 14919,
    "book": "psalms                                  ",
    "chapter": "68",
    "verse": "18",
    "text": "तू ऊँचे पर चढ़ा, तू लोगों को बँधुवाई में ले गया;"
  },
  {
    "id": 14920,
    "book": "psalms                                  ",
    "chapter": "68",
    "verse": "19",
    "text": "धन्य है प्रभु, जो प्रतिदिन हमारा बोझ उठाता है;"
  },
  {
    "id": 14921,
    "book": "psalms                                  ",
    "chapter": "68",
    "verse": "20",
    "text": "वही हमारे लिये बचानेवाला परमेश्वर ठहरा;"
  },
  {
    "id": 14922,
    "book": "psalms                                  ",
    "chapter": "68",
    "verse": "21",
    "text": "निश्चय परमेश्वर अपने शत्रुओं के सिर पर,"
  },
  {
    "id": 14923,
    "book": "psalms                                  ",
    "chapter": "68",
    "verse": "22",
    "text": "प्रभु ने कहा है, “मैं उन्हें बाशान से निकाल लाऊँगा,"
  },
  {
    "id": 14924,
    "book": "psalms                                  ",
    "chapter": "68",
    "verse": "23",
    "text": "कि तू अपने पाँव को लहू में डुबोए,"
  },
  {
    "id": 14925,
    "book": "psalms                                  ",
    "chapter": "68",
    "verse": "24",
    "text": "हे परमेश्वर तेरी शोभा-यात्राएँ देखी गई,"
  },
  {
    "id": 14926,
    "book": "psalms                                  ",
    "chapter": "68",
    "verse": "25",
    "text": "गानेवाले आगे-आगे और तारवाले बाजों के बजानेवाले पीछे-पीछे गए,"
  },
  {
    "id": 14927,
    "book": "psalms                                  ",
    "chapter": "68",
    "verse": "26",
    "text": "सभाओं में परमेश्वर का,"
  },
  {
    "id": 14928,
    "book": "psalms                                  ",
    "chapter": "68",
    "verse": "27",
    "text": "पहला बिन्यामीन जो सबसे छोटा गोत्र है,"
  },
  {
    "id": 14929,
    "book": "psalms                                  ",
    "chapter": "68",
    "verse": "28",
    "text": "तेरे परमेश्वर ने तेरी सामर्थ्य को बनाया है,"
  },
  {
    "id": 14930,
    "book": "psalms                                  ",
    "chapter": "68",
    "verse": "29",
    "text": "तेरे मन्दिर के कारण जो यरूशलेम में हैं,"
  },
  {
    "id": 14931,
    "book": "psalms                                  ",
    "chapter": "68",
    "verse": "30",
    "text": "नरकटों में रहनेवाले जंगली पशुओं को,"
  },
  {
    "id": 14932,
    "book": "psalms                                  ",
    "chapter": "68",
    "verse": "31",
    "text": "मिस्र से अधिकारी आएँगे;"
  },
  {
    "id": 14933,
    "book": "psalms                                  ",
    "chapter": "68",
    "verse": "32",
    "text": "हे पृथ्वी पर के राज्य-राज्य के लोगों परमेश्वर का गीत गाओ;"
  },
  {
    "id": 14934,
    "book": "psalms                                  ",
    "chapter": "68",
    "verse": "33",
    "text": "जो सबसे ऊँचे सनातन स्वर्ग में सवार होकर चलता है;"
  },
  {
    "id": 14935,
    "book": "psalms                                  ",
    "chapter": "68",
    "verse": "34",
    "text": "परमेश्वर की सामर्थ्य की स्तुति करो68:34 परमेश्वर की सामर्थ्य की स्तुति करो: अर्थात् उसे सामर्थ्य सम्पन्न परमेश्वर मानो। अपनी आराधना में उसकी सर्वशक्ति को स्वीकार करो।,"
  },
  {
    "id": 14936,
    "book": "psalms                                  ",
    "chapter": "68",
    "verse": "35",
    "text": "हे परमेश्वर, तू अपने पवित्रस्थानों में भययोग्य है,"
  }
]
