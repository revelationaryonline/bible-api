    "book": "psalms                                  ",
    "chapter": "121",
    "verse": "5",
    "text": "यहोवा तेरा रक्षक है;"
  },
  {
    "id": 16088,
    "book": "psalms                                  ",
    "chapter": "121",
    "verse": "6",
    "text": "न तो दिन को धूप से,"
