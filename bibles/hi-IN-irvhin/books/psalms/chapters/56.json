[
  {
    "id": 14757,
    "book": "psalms                                  ",
    "chapter": "56",
    "verse": "1",
    "text": "हे परमेश्वर, मुझ पर दया कर, क्योंकि मनुष्य मुझे निगलना चाहते हैं;"
  },
  {
    "id": 14758,
    "book": "psalms                                  ",
    "chapter": "56",
    "verse": "2",
    "text": "मेरे द्रोही दिन भर मुझे निगलना चाहते हैं,"
  },
  {
    "id": 14759,
    "book": "psalms                                  ",
    "chapter": "56",
    "verse": "3",
    "text": "जिस समय मुझे डर लगेगा,"
  },
  {
    "id": 14760,
    "book": "psalms                                  ",
    "chapter": "56",
    "verse": "4",
    "text": "परमेश्वर की सहायता से मैं उसके वचन की प्रशंसा करूँगा,"
  },
  {
    "id": 14761,
    "book": "psalms                                  ",
    "chapter": "56",
    "verse": "5",
    "text": "वे दिन भर मेरे वचनों को, उलटा अर्थ लगा लगाकर मरोड़ते रहते हैं;"
  },
  {
    "id": 14762,
    "book": "psalms                                  ",
    "chapter": "56",
    "verse": "6",
    "text": "वे सब मिलकर इकट्ठे होते हैं और छिपकर बैठते हैं;"
  },
  {
    "id": 14763,
    "book": "psalms                                  ",
    "chapter": "56",
    "verse": "7",
    "text": "क्या वे बुराई करके भी बच जाएँगे?"
  },
  {
    "id": 14764,
    "book": "psalms                                  ",
    "chapter": "56",
    "verse": "8",
    "text": "तू मेरे मारे-मारे फिरने का हिसाब रखता है;"
  },
  {
    "id": 14765,
    "book": "psalms                                  ",
    "chapter": "56",
    "verse": "9",
    "text": "तब जिस समय मैं पुकारूँगा, उसी समय मेरे शत्रु उलटे फिरेंगे।"
  },
  {
    "id": 14766,
    "book": "psalms                                  ",
    "chapter": "56",
    "verse": "10",
    "text": "परमेश्वर की सहायता से मैं उसके वचन की प्रशंसा करूँगा,"
  },
  {
    "id": 14767,
    "book": "psalms                                  ",
    "chapter": "56",
    "verse": "11",
    "text": "मैंने परमेश्वर पर भरोसा रखा है, मैं न डरूँगा।"
  },
  {
    "id": 14768,
    "book": "psalms                                  ",
    "chapter": "56",
    "verse": "12",
    "text": "हे परमेश्वर, तेरी मन्नतों का भार मुझ पर बना है;"
  },
  {
    "id": 14769,
    "book": "psalms                                  ",
    "chapter": "56",
    "verse": "13",
    "text": "क्योंकि तूने मुझ को मृत्यु से बचाया है;"
  }
]
