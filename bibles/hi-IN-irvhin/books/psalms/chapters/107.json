[
  {
    "id": 15701,
    "book": "psalms                                  ",
    "chapter": "107",
    "verse": "1",
    "text": "यहोवा का धन्यवाद करो, क्योंकि वह भला है;"
  },
  {
    "id": 15702,
    "book": "psalms                                  ",
    "chapter": "107",
    "verse": "2",
    "text": "यहोवा के छुड़ाए हुए ऐसा ही कहें,"
  },
  {
    "id": 15703,
    "book": "psalms                                  ",
    "chapter": "107",
    "verse": "3",
    "text": "और उन्हें देश-देश से,"
  },
  {
    "id": 15704,
    "book": "psalms                                  ",
    "chapter": "107",
    "verse": "4",
    "text": "वे जंगल में मरूभूमि के मार्ग पर भटकते फिरे,"
  },
  {
    "id": 15705,
    "book": "psalms                                  ",
    "chapter": "107",
    "verse": "5",
    "text": "भूख और प्यास के मारे,"
  },
  {
    "id": 15706,
    "book": "psalms                                  ",
    "chapter": "107",
    "verse": "6",
    "text": "तब उन्होंने संकट में यहोवा की दुहाई दी,"
  },
  {
    "id": 15707,
    "book": "psalms                                  ",
    "chapter": "107",
    "verse": "7",
    "text": "और उनको ठीक मार्ग पर चलाया,"
  },
  {
    "id": 15708,
    "book": "psalms                                  ",
    "chapter": "107",
    "verse": "8",
    "text": "लोग यहोवा की करुणा के कारण,"
  },
  {
    "id": 15709,
    "book": "psalms                                  ",
    "chapter": "107",
    "verse": "9",
    "text": "क्योंकि वह अभिलाषी जीव को सन्तुष्ट करता है,"
  },
  {
    "id": 15710,
    "book": "psalms                                  ",
    "chapter": "107",
    "verse": "10",
    "text": "जो अंधियारे और मृत्यु की छाया में बैठे,"
  },
  {
    "id": 15711,
    "book": "psalms                                  ",
    "chapter": "107",
    "verse": "11",
    "text": "इसलिए कि वे परमेश्वर के वचनों के विरुद्ध चले107:11 इसलिए कि वे परमेश्वर के वचनों के विरुद्ध चले: परमेश्वर की आज्ञाओं के। उन्होंने उसकी आज्ञाएँ नहीं मानीं। राष्ट्रीय अवज्ञा के कारण वे बन्धुआई में गए थे। ,"
  },
  {
    "id": 15712,
    "book": "psalms                                  ",
    "chapter": "107",
    "verse": "12",
    "text": "तब उसने उनको कष्ट के द्वारा दबाया;"
  },
  {
    "id": 15713,
    "book": "psalms                                  ",
    "chapter": "107",
    "verse": "13",
    "text": "तब उन्होंने संकट में यहोवा की दुहाई दी,"
  },
  {
    "id": 15714,
    "book": "psalms                                  ",
    "chapter": "107",
    "verse": "14",
    "text": "उसने उनको अंधियारे और मृत्यु की छाया में से निकाल लिया;"
  },
  {
    "id": 15715,
    "book": "psalms                                  ",
    "chapter": "107",
    "verse": "15",
    "text": "लोग यहोवा की करुणा के कारण,"
  },
  {
    "id": 15716,
    "book": "psalms                                  ",
    "chapter": "107",
    "verse": "16",
    "text": "क्योंकि उसने पीतल के फाटकों को तोड़ा,"
  },
  {
    "id": 15717,
    "book": "psalms                                  ",
    "chapter": "107",
    "verse": "17",
    "text": "मूर्ख अपनी कुचाल,"
  },
  {
    "id": 15718,
    "book": "psalms                                  ",
    "chapter": "107",
    "verse": "18",
    "text": "उनका जी सब भाँति के भोजन से मिचलाता है,"
  },
  {
    "id": 15719,
    "book": "psalms                                  ",
    "chapter": "107",
    "verse": "19",
    "text": "तब वे संकट में यहोवा की दुहाई देते हैं,"
  },
  {
    "id": 15720,
    "book": "psalms                                  ",
    "chapter": "107",
    "verse": "20",
    "text": "वह अपने वचन के द्वारा उनको चंगा करता107:20 वह अपने वचन के द्वारा उनको चंगा करता: उसने बस वचन से ही कर दिया। उसके लिए तो बस आज्ञा देने की बात थी और रोग उनमें से समाप्त हो गया।"
  },
  {
    "id": 15721,
    "book": "psalms                                  ",
    "chapter": "107",
    "verse": "21",
    "text": "लोग यहोवा की करुणा के कारण"
  },
  {
    "id": 15722,
    "book": "psalms                                  ",
    "chapter": "107",
    "verse": "22",
    "text": "और वे धन्यवाद-बलि चढ़ाएँ,"
  },
  {
    "id": 15723,
    "book": "psalms                                  ",
    "chapter": "107",
    "verse": "23",
    "text": "जो लोग जहाजों में समुद्र पर चलते हैं,"
  },
  {
    "id": 15724,
    "book": "psalms                                  ",
    "chapter": "107",
    "verse": "24",
    "text": "वे यहोवा के कामों को,"
  },
  {
    "id": 15725,
    "book": "psalms                                  ",
    "chapter": "107",
    "verse": "25",
    "text": "क्योंकि वह आज्ञा देता है, तब प्रचण्ड वायु उठकर तरंगों को उठाती है।"
  },
  {
    "id": 15726,
    "book": "psalms                                  ",
    "chapter": "107",
    "verse": "26",
    "text": "वे आकाश तक चढ़ जाते, फिर गहराई में उतर आते हैं;"
  },
  {
    "id": 15727,
    "book": "psalms                                  ",
    "chapter": "107",
    "verse": "27",
    "text": "वे चक्कर खाते, और मतवालों की भाँति लड़खड़ाते हैं,"
  },
  {
    "id": 15728,
    "book": "psalms                                  ",
    "chapter": "107",
    "verse": "28",
    "text": "तब वे संकट में यहोवा की दुहाई देते हैं,"
  },
  {
    "id": 15729,
    "book": "psalms                                  ",
    "chapter": "107",
    "verse": "29",
    "text": "वह आँधी को थाम देता है और तरंगें बैठ जाती हैं।"
  },
  {
    "id": 15730,
    "book": "psalms                                  ",
    "chapter": "107",
    "verse": "30",
    "text": "तब वे उनके बैठने से आनन्दित होते हैं,"
  },
  {
    "id": 15731,
    "book": "psalms                                  ",
    "chapter": "107",
    "verse": "31",
    "text": "लोग यहोवा की करुणा के कारण,"
  },
  {
    "id": 15732,
    "book": "psalms                                  ",
    "chapter": "107",
    "verse": "32",
    "text": "और सभा में उसको सराहें,"
  },
  {
    "id": 15733,
    "book": "psalms                                  ",
    "chapter": "107",
    "verse": "33",
    "text": "वह नदियों को जंगल बना डालता है,"
  },
  {
    "id": 15734,
    "book": "psalms                                  ",
    "chapter": "107",
    "verse": "34",
    "text": "वह फलवन्त भूमि को बंजर बनाता है,"
  },
  {
    "id": 15735,
    "book": "psalms                                  ",
    "chapter": "107",
    "verse": "35",
    "text": "वह जंगल को जल का ताल,"
  },
  {
    "id": 15736,
    "book": "psalms                                  ",
    "chapter": "107",
    "verse": "36",
    "text": "और वहाँ वह भूखों को बसाता है,"
  },
  {
    "id": 15737,
    "book": "psalms                                  ",
    "chapter": "107",
    "verse": "37",
    "text": "और खेती करें, और दाख की बारियाँ लगाएँ,"
  },
  {
    "id": 15738,
    "book": "psalms                                  ",
    "chapter": "107",
    "verse": "38",
    "text": "और वह उनको ऐसी आशीष देता है कि वे बहुत बढ़ जाते हैं,"
  },
  {
    "id": 15739,
    "book": "psalms                                  ",
    "chapter": "107",
    "verse": "39",
    "text": "फिर विपत्ति और शोक के कारण,"
  },
  {
    "id": 15740,
    "book": "psalms                                  ",
    "chapter": "107",
    "verse": "40",
    "text": "और वह हाकिमों को अपमान से लादकर मार्ग रहित जंगल में भटकाता है;"
  },
  {
    "id": 15741,
    "book": "psalms                                  ",
    "chapter": "107",
    "verse": "41",
    "text": "वह दरिद्रों को दुःख से छुड़ाकर ऊँचे पर रखता है,"
  },
  {
    "id": 15742,
    "book": "psalms                                  ",
    "chapter": "107",
    "verse": "42",
    "text": "सीधे लोग देखकर आनन्दित होते हैं;"
  },
  {
    "id": 15743,
    "book": "psalms                                  ",
    "chapter": "107",
    "verse": "43",
    "text": "जो कोई बुद्धिमान हो, वह इन बातों पर ध्यान करेगा;"
  }
]
