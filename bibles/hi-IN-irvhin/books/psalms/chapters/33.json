[
  {
    "id": 14368,
    "book": "psalms                                  ",
    "chapter": "33",
    "verse": "1",
    "text": "हे धर्मियों, यहोवा के कारण जयजयकार करो।"
  },
  {
    "id": 14369,
    "book": "psalms                                  ",
    "chapter": "33",
    "verse": "2",
    "text": "वीणा बजा-बजाकर यहोवा का धन्यवाद करो,"
  },
  {
    "id": 14370,
    "book": "psalms                                  ",
    "chapter": "33",
    "verse": "3",
    "text": "उसके लिये नया गीत गाओ,"
  },
  {
    "id": 14371,
    "book": "psalms                                  ",
    "chapter": "33",
    "verse": "4",
    "text": "क्योंकि यहोवा का वचन सीधा है33:4 क्योंकि यहोवा का वचन सीधा है: परमेश्वर की आज्ञा विधान प्रतिज्ञाएँ। वह जो भी कहता है सही वरन् सत्य है। ;"
  },
  {
    "id": 14372,
    "book": "psalms                                  ",
    "chapter": "33",
    "verse": "5",
    "text": "वह धार्मिकता और न्याय से प्रीति रखता है;"
  },
  {
    "id": 14373,
    "book": "psalms                                  ",
    "chapter": "33",
    "verse": "6",
    "text": "आकाशमण्डल यहोवा के वचन से,"
  },
  {
    "id": 14374,
    "book": "psalms                                  ",
    "chapter": "33",
    "verse": "7",
    "text": "वह समुद्र का जल ढेर के समान इकट्ठा करता33:7 वह समुद्र का जल ढेर के समान इकट्ठा करता: वह जहाँ चाहता है उसे रखता है जैसे किसान अपना अन्न रखता है वैसे ही वह भी जल को रखता है। ;"
  },
  {
    "id": 14375,
    "book": "psalms                                  ",
    "chapter": "33",
    "verse": "8",
    "text": "सारी पृथ्वी के लोग यहोवा से डरें,"
  },
  {
    "id": 14376,
    "book": "psalms                                  ",
    "chapter": "33",
    "verse": "9",
    "text": "क्योंकि जब उसने कहा, तब हो गया;"
  },
  {
    "id": 14377,
    "book": "psalms                                  ",
    "chapter": "33",
    "verse": "10",
    "text": "यहोवा जाति-जाति की युक्ति को"
  },
  {
    "id": 14378,
    "book": "psalms                                  ",
    "chapter": "33",
    "verse": "11",
    "text": "यहोवा की योजना सर्वदा स्थिर रहेगी,"
  },
  {
    "id": 14379,
    "book": "psalms                                  ",
    "chapter": "33",
    "verse": "12",
    "text": "क्या ही धन्य है वह जाति जिसका परमेश्वर"
  },
  {
    "id": 14380,
    "book": "psalms                                  ",
    "chapter": "33",
    "verse": "13",
    "text": "यहोवा स्वर्ग से दृष्टि करता है,"
  },
  {
    "id": 14381,
    "book": "psalms                                  ",
    "chapter": "33",
    "verse": "14",
    "text": "अपने निवास के स्थान से"
  },
  {
    "id": 14382,
    "book": "psalms                                  ",
    "chapter": "33",
    "verse": "15",
    "text": "वही जो उन सभी के हृदयों को गढ़ता,"
  },
  {
    "id": 14383,
    "book": "psalms                                  ",
    "chapter": "33",
    "verse": "16",
    "text": "कोई ऐसा राजा नहीं, जो सेना की"
  },
  {
    "id": 14384,
    "book": "psalms                                  ",
    "chapter": "33",
    "verse": "17",
    "text": "विजय पाने के लिए घोड़ा व्यर्थ सुरक्षा है,"
  },
  {
    "id": 14385,
    "book": "psalms                                  ",
    "chapter": "33",
    "verse": "18",
    "text": "देखो, यहोवा की दृष्टि उसके डरवैयों पर"
  },
  {
    "id": 14386,
    "book": "psalms                                  ",
    "chapter": "33",
    "verse": "19",
    "text": "कि वह उनके प्राण को मृत्यु से बचाए,"
  },
  {
    "id": 14387,
    "book": "psalms                                  ",
    "chapter": "33",
    "verse": "20",
    "text": "हम यहोवा की बाट जोहते हैं;"
  },
  {
    "id": 14388,
    "book": "psalms                                  ",
    "chapter": "33",
    "verse": "21",
    "text": "हमारा हृदय उसके कारण आनन्दित होगा,"
  },
  {
    "id": 14389,
    "book": "psalms                                  ",
    "chapter": "33",
    "verse": "22",
    "text": "हे यहोवा, जैसी तुझ पर हमारी आशा है,"
  }
]
