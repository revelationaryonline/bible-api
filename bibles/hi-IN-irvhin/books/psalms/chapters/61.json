[
  {
    "id": 14821,
    "book": "psalms                                  ",
    "chapter": "61",
    "verse": "1",
    "text": "हे परमेश्वर, मेरा चिल्लाना सुन,"
  },
  {
    "id": 14822,
    "book": "psalms                                  ",
    "chapter": "61",
    "verse": "2",
    "text": "मूर्छा खाते समय मैं पृथ्वी की छोर से भी तुझे पुकारूँगा,"
  },
  {
    "id": 14823,
    "book": "psalms                                  ",
    "chapter": "61",
    "verse": "3",
    "text": "क्योंकि तू मेरा शरणस्थान है,"
  },
  {
    "id": 14824,
    "book": "psalms                                  ",
    "chapter": "61",
    "verse": "4",
    "text": "मैं तेरे तम्बू में युगानुयुग बना रहूँगा।"
  },
  {
    "id": 14825,
    "book": "psalms                                  ",
    "chapter": "61",
    "verse": "5",
    "text": "क्योंकि हे परमेश्वर, तूने मेरी मन्नतें सुनीं,"
  },
  {
    "id": 14826,
    "book": "psalms                                  ",
    "chapter": "61",
    "verse": "6",
    "text": "तू राजा की आयु को बहुत बढ़ाएगा;"
  },
  {
    "id": 14827,
    "book": "psalms                                  ",
    "chapter": "61",
    "verse": "7",
    "text": "वह परमेश्वर के सम्मुख सदा बना रहेगा;"
  },
  {
    "id": 14828,
    "book": "psalms                                  ",
    "chapter": "61",
    "verse": "8",
    "text": "इस प्रकार मैं सर्वदा तेरे नाम का भजन गा गाकर"
  }
]
