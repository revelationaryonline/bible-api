[
  {
    "id": 15757,
    "book": "psalms                                  ",
    "chapter": "109",
    "verse": "1",
    "text": "हे परमेश्वर तू, जिसकी मैं स्तुति करता हूँ, चुप न रह!"
  },
  {
    "id": 15758,
    "book": "psalms                                  ",
    "chapter": "109",
    "verse": "2",
    "text": "क्योंकि दुष्ट और कपटी मनुष्यों ने मेरे विरुद्ध मुँह खोला है,"
  },
  {
    "id": 15759,
    "book": "psalms                                  ",
    "chapter": "109",
    "verse": "3",
    "text": "उन्होंने बैर के वचनों से मुझे चारों ओर घेर लिया है,"
  },
  {
    "id": 15760,
    "book": "psalms                                  ",
    "chapter": "109",
    "verse": "4",
    "text": "मेरे प्रेम के बदले में वे मेरी चुगली करते हैं,"
  },
  {
    "id": 15761,
    "book": "psalms                                  ",
    "chapter": "109",
    "verse": "5",
    "text": "उन्होंने भलाई के बदले में मुझसे बुराई की"
  },
  {
    "id": 15762,
    "book": "psalms                                  ",
    "chapter": "109",
    "verse": "6",
    "text": "तू उसको किसी दुष्ट के अधिकार में रख,"
  },
  {
    "id": 15763,
    "book": "psalms                                  ",
    "chapter": "109",
    "verse": "7",
    "text": "जब उसका न्याय किया जाए, तब वह दोषी निकले,"
  },
  {
    "id": 15764,
    "book": "psalms                                  ",
    "chapter": "109",
    "verse": "8",
    "text": "उसके दिन थोड़े हों,"
  },
  {
    "id": 15765,
    "book": "psalms                                  ",
    "chapter": "109",
    "verse": "9",
    "text": "उसके बच्चे अनाथ हो जाएँ,"
  },
  {
    "id": 15766,
    "book": "psalms                                  ",
    "chapter": "109",
    "verse": "10",
    "text": "और उसके बच्चे मारे-मारे फिरें, और भीख माँगा करे;"
  },
  {
    "id": 15767,
    "book": "psalms                                  ",
    "chapter": "109",
    "verse": "11",
    "text": "महाजन फंदा लगाकर, उसका सर्वस्व ले ले109:11 महाजन फंदा लगाकर, उसका सर्वस्व ले ले: प्रार्थना यह है, कि वह ऐसी परिस्थितियों में हो सकता है कि उसकी सम्पूर्ण सम्पदा छीननेवालों के हाथों में पड़ जाए।;"
  },
  {
    "id": 15768,
    "book": "psalms                                  ",
    "chapter": "109",
    "verse": "12",
    "text": "कोई न हो जो उस पर करुणा करता रहे,"
  },
  {
    "id": 15769,
    "book": "psalms                                  ",
    "chapter": "109",
    "verse": "13",
    "text": "उसका वंश नाश हो जाए,"
  },
  {
    "id": 15770,
    "book": "psalms                                  ",
    "chapter": "109",
    "verse": "14",
    "text": "उसके पितरों का अधर्म यहोवा को स्मरण रहे,"
  },
  {
    "id": 15771,
    "book": "psalms                                  ",
    "chapter": "109",
    "verse": "15",
    "text": "वह निरन्तर यहोवा के सम्मुख रहे,"
  },
  {
    "id": 15772,
    "book": "psalms                                  ",
    "chapter": "109",
    "verse": "16",
    "text": "क्योंकि वह दुष्ट, करुणा करना भूल गया"
  },
  {
    "id": 15773,
    "book": "psalms                                  ",
    "chapter": "109",
    "verse": "17",
    "text": "वह श्राप देने से प्रीति रखता था, और श्राप उस पर आ पड़ा;"
  },
  {
    "id": 15774,
    "book": "psalms                                  ",
    "chapter": "109",
    "verse": "18",
    "text": "वह श्राप देना वस्त्र के समान पहनता था,"
  },
  {
    "id": 15775,
    "book": "psalms                                  ",
    "chapter": "109",
    "verse": "19",
    "text": "वह उसके लिये ओढ़ने का काम दे,"
  },
  {
    "id": 15776,
    "book": "psalms                                  ",
    "chapter": "109",
    "verse": "20",
    "text": "यहोवा की ओर से मेरे विरोधियों को,"
  },
  {
    "id": 15777,
    "book": "psalms                                  ",
    "chapter": "109",
    "verse": "21",
    "text": "परन्तु हे यहोवा प्रभु, तू अपने नाम के निमित्त मुझसे बर्ताव कर;"
  },
  {
    "id": 15778,
    "book": "psalms                                  ",
    "chapter": "109",
    "verse": "22",
    "text": "क्योंकि मैं दीन और दरिद्र हूँ,"
  },
  {
    "id": 15779,
    "book": "psalms                                  ",
    "chapter": "109",
    "verse": "23",
    "text": "मैं ढलती हुई छाया के समान जाता रहा हूँ;"
  },
  {
    "id": 15780,
    "book": "psalms                                  ",
    "chapter": "109",
    "verse": "24",
    "text": "उपवास करते-करते मेरे घुटने निर्बल हो गए;"
  },
  {
    "id": 15781,
    "book": "psalms                                  ",
    "chapter": "109",
    "verse": "25",
    "text": "मेरी तो उन लोगों से नामधराई होती है;"
  },
  {
    "id": 15782,
    "book": "psalms                                  ",
    "chapter": "109",
    "verse": "26",
    "text": "हे मेरे परमेश्वर यहोवा, मेरी सहायता कर!"
  },
  {
    "id": 15783,
    "book": "psalms                                  ",
    "chapter": "109",
    "verse": "27",
    "text": "जिससे वे जाने कि यह तेरा काम है,"
  },
  {
    "id": 15784,
    "book": "psalms                                  ",
    "chapter": "109",
    "verse": "28",
    "text": "वे मुझे कोसते तो रहें, परन्तु तू आशीष दे!"
  },
  {
    "id": 15785,
    "book": "psalms                                  ",
    "chapter": "109",
    "verse": "29",
    "text": "मेरे विरोधियों को अनादररूपी वस्त्र पहनाया जाए,"
  },
  {
    "id": 15786,
    "book": "psalms                                  ",
    "chapter": "109",
    "verse": "30",
    "text": "मैं यहोवा का बहुत धन्यवाद करूँगा,"
  },
  {
    "id": 15787,
    "book": "psalms                                  ",
    "chapter": "109",
    "verse": "31",
    "text": "क्योंकि वह दरिद्र की दाहिनी ओर खड़ा रहेगा,"
  }
]
