[
  {
    "id": 14301,
    "book": "psalms                                  ",
    "chapter": "28",
    "verse": "1",
    "text": "हे यहोवा, मैं तुझी को पुकारूँगा;"
  },
  {
    "id": 14302,
    "book": "psalms                                  ",
    "chapter": "28",
    "verse": "2",
    "text": "जब मैं तेरी दुहाई दूँ,"
  },
  {
    "id": 14303,
    "book": "psalms                                  ",
    "chapter": "28",
    "verse": "3",
    "text": "उन दुष्टों और अनर्थकारियों के संग मुझे न घसीट;"
  },
  {
    "id": 14304,
    "book": "psalms                                  ",
    "chapter": "28",
    "verse": "4",
    "text": "उनके कामों के और उनकी करनी की बुराई"
  },
  {
    "id": 14305,
    "book": "psalms                                  ",
    "chapter": "28",
    "verse": "5",
    "text": "क्योंकि वे यहोवा के कामों को"
  },
  {
    "id": 14306,
    "book": "psalms                                  ",
    "chapter": "28",
    "verse": "6",
    "text": "यहोवा धन्य है;"
  },
  {
    "id": 14307,
    "book": "psalms                                  ",
    "chapter": "28",
    "verse": "7",
    "text": "यहोवा मेरा बल और मेरी ढाल है;"
  },
  {
    "id": 14308,
    "book": "psalms                                  ",
    "chapter": "28",
    "verse": "8",
    "text": "यहोवा अपने लोगों की सामर्थ्य है,"
  },
  {
    "id": 14309,
    "book": "psalms                                  ",
    "chapter": "28",
    "verse": "9",
    "text": "हे यहोवा अपनी प्रजा का उद्धार कर,"
  }
]
