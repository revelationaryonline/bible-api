[
  {
    "id": 22770,
    "book": "habakkuk                                ",
    "chapter": "3",
    "verse": "1",
    "text": "शिग्योनीत की रीति पर हबक्कूक नबी की प्रार्थना।"
  },
  {
    "id": 22771,
    "book": "habakkuk                                ",
    "chapter": "3",
    "verse": "2",
    "text": "हे यहोवा, मैं तेरी कीर्ति3:2 कीर्ति: भजन 7 के अतिरिक्त यह इब्रानी शब्द शिग्योनीत: एक ही बार प्रगट है भजनों में यह संगीतवाद्य के साथ है मधुर धुन या भजन के प्रथम शब्द जिसकी धुन ग्रहण की गई है।  सुनकर डर गया।"
  },
  {
    "id": 22772,
    "book": "habakkuk                                ",
    "chapter": "3",
    "verse": "3",
    "text": "परमेश्वर तेमान से आया,"
  },
  {
    "id": 22773,
    "book": "habakkuk                                ",
    "chapter": "3",
    "verse": "4",
    "text": "उसकी ज्योति सूर्य के तुल्य थी,"
  },
  {
    "id": 22774,
    "book": "habakkuk                                ",
    "chapter": "3",
    "verse": "5",
    "text": "उसके आगे-आगे मरी फैलती गई,"
  },
  {
    "id": 22775,
    "book": "habakkuk                                ",
    "chapter": "3",
    "verse": "6",
    "text": "वह खड़ा होकर पृथ्वी को नाप रहा था;"
  },
  {
    "id": 22776,
    "book": "habakkuk                                ",
    "chapter": "3",
    "verse": "7",
    "text": "मुझे कूशान के तम्बू में रहनेवाले दुःख से दबे दिखाई पड़े;"
  },
  {
    "id": 22777,
    "book": "habakkuk                                ",
    "chapter": "3",
    "verse": "8",
    "text": "हे यहोवा, क्या तू नदियों पर रिसियाया था?"
  },
  {
    "id": 22778,
    "book": "habakkuk                                ",
    "chapter": "3",
    "verse": "9",
    "text": "तेरा धनुष खोल में से निकल गया,"
  },
  {
    "id": 22779,
    "book": "habakkuk                                ",
    "chapter": "3",
    "verse": "10",
    "text": "पहाड़ तुझे देखकर काँप उठे;"
  },
  {
    "id": 22780,
    "book": "habakkuk                                ",
    "chapter": "3",
    "verse": "11",
    "text": "तेरे उड़नेवाले तीरों के चलने की ज्योति से,"
  },
  {
    "id": 22781,
    "book": "habakkuk                                ",
    "chapter": "3",
    "verse": "12",
    "text": "तू क्रोध में आकर पृथ्वी पर चल निकला,"
  },
  {
    "id": 22782,
    "book": "habakkuk                                ",
    "chapter": "3",
    "verse": "13",
    "text": "तू अपनी प्रजा के उद्धार के लिये निकला,"
  },
  {
    "id": 22783,
    "book": "habakkuk                                ",
    "chapter": "3",
    "verse": "14",
    "text": "तूने उसके योद्धाओं के सिरों को उसी की बर्छी से छेदा है,"
  },
  {
    "id": 22784,
    "book": "habakkuk                                ",
    "chapter": "3",
    "verse": "15",
    "text": "तू अपने घोड़ों पर सवार होकर समुद्र से हाँ, जल-प्रलय से पार हो गया।"
  },
  {
    "id": 22785,
    "book": "habakkuk                                ",
    "chapter": "3",
    "verse": "16",
    "text": "यह सब सुनते ही मेरा कलेजा3:16 यह सब सुनते ही मेरा कलेजा: अर्थात् सम्पूर्ण आन्तरिक मनुष्यत्व शरीर और मानसिक स्थिति, सब शक्तियाँ काँप उठी। काँप उठा,"
  },
  {
    "id": 22786,
    "book": "habakkuk                                ",
    "chapter": "3",
    "verse": "17",
    "text": "क्योंकि चाहे अंजीर के वृक्षों में फूल न लगें,"
  },
  {
    "id": 22787,
    "book": "habakkuk                                ",
    "chapter": "3",
    "verse": "18",
    "text": "तो भी मैं यहोवा के कारण आनन्दित और मगन रहूँगा,"
  },
  {
    "id": 22788,
    "book": "habakkuk                                ",
    "chapter": "3",
    "verse": "19",
    "text": "यहोवा परमेश्वर मेरा बलमूल है,"
  }
