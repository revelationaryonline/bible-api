[
  {
    "id": 5812,
    "book": "deuteronomy                             ",
    "chapter": "33",
    "verse": "1",
    "text": "जो आशीर्वाद परमेश्वर के जन33:1 परमेश्वर के जन: परमेश्वर का जन पुराने नियम में उस मनुष्य को कहा जाता था जिसे अपरोक्ष प्रकाशन प्राप्त होता था। आवश्यक नहीं कि वह भविष्यद्वक्ता हो।  मूसा ने अपनी मृत्यु से पहले इस्राएलियों को दिया वह यह है।"
  },
  {
    "id": 5813,
    "book": "deuteronomy                             ",
    "chapter": "33",
    "verse": "2",
    "text": "उसने कहा,"
  },
  {
    "id": 5814,
    "book": "deuteronomy                             ",
    "chapter": "33",
    "verse": "3",
    "text": "वह निश्चय लोगों से प्रेम करता है;"
  },
  {
    "id": 5815,
    "book": "deuteronomy                             ",
    "chapter": "33",
    "verse": "4",
    "text": "मूसा ने हमें व्यवस्था दी, और वह याकूब की मण्डली का निज भाग ठहरी।"
  },
  {
    "id": 5816,
    "book": "deuteronomy                             ",
    "chapter": "33",
    "verse": "5",
    "text": "जब प्रजा के मुख्य-मुख्य पुरुष, और इस्राएल के सभी गोत्र एक संग होकर एकत्रित हुए,"
  },
  {
    "id": 5817,
    "book": "deuteronomy                             ",
    "chapter": "33",
    "verse": "6",
    "text": "“रूबेन न मरे, वरन् जीवित रहे, तो भी उसके यहाँ के मनुष्य थोड़े हों।”"
  },
  {
    "id": 5818,
    "book": "deuteronomy                             ",
    "chapter": "33",
    "verse": "7",
    "text": "और यहूदा पर यह आशीर्वाद हुआ जो मूसा ने कहा,"
  },
  {
    "id": 5819,
    "book": "deuteronomy                             ",
    "chapter": "33",
    "verse": "8",
    "text": "फिर लेवी के विषय में उसने कहा,"
  },
  {
    "id": 5820,
    "book": "deuteronomy                             ",
    "chapter": "33",
    "verse": "9",
    "text": "उसने तो अपने माता-पिता के विषय में कहा, ‘मैं उनको नहीं जानता;’"
  },
  {
    "id": 5821,
    "book": "deuteronomy                             ",
    "chapter": "33",
    "verse": "10",
    "text": "वे याकूब को तेरे नियम, और इस्राएल को तेरी व्यवस्था सिखाएँगे;"
  },
  {
    "id": 5822,
    "book": "deuteronomy                             ",
    "chapter": "33",
    "verse": "11",
    "text": "हे यहोवा, उसकी सम्पत्ति पर आशीष दे, और उसके हाथों की सेवा को ग्रहण कर;"
  },
  {
    "id": 5823,
    "book": "deuteronomy                             ",
    "chapter": "33",
    "verse": "12",
    "text": "फिर उसने बिन्यामीन के विषय में कहा,"
  },
  {
    "id": 5824,
    "book": "deuteronomy                             ",
    "chapter": "33",
    "verse": "13",
    "text": "फिर यूसुफ के विषय में उसने कहा;"
  },
  {
    "id": 5825,
    "book": "deuteronomy                             ",
    "chapter": "33",
    "verse": "14",
    "text": "और सूर्य के पकाए हुए अनमोल फल,"
  },
  {
    "id": 5826,
    "book": "deuteronomy                             ",
    "chapter": "33",
    "verse": "15",
    "text": "और प्राचीन पहाड़ों के उत्तम पदार्थ,"
  },
  {
    "id": 5827,
    "book": "deuteronomy                             ",
    "chapter": "33",
    "verse": "16",
    "text": "और पृथ्वी और जो अनमोल पदार्थ उसमें भरें हैं,"
  },
  {
    "id": 5828,
    "book": "deuteronomy                             ",
    "chapter": "33",
    "verse": "17",
    "text": "वह प्रतापी है, मानो गाय का पहलौठा है, और उसके सींग जंगली बैल के से हैं;"
  },
  {
    "id": 5829,
    "book": "deuteronomy                             ",
    "chapter": "33",
    "verse": "18",
    "text": "फिर जबूलून के विषय में उसने कहा,"
  },
  {
    "id": 5830,
    "book": "deuteronomy                             ",
    "chapter": "33",
    "verse": "19",
    "text": "वे देश-देश के लोगों को पहाड़ पर बुलाएँगे;"
  },
  {
    "id": 5831,
    "book": "deuteronomy                             ",
    "chapter": "33",
    "verse": "20",
    "text": "फिर गाद के विषय में उसने कहा,"
  },
  {
    "id": 5832,
    "book": "deuteronomy                             ",
    "chapter": "33",
    "verse": "21",
    "text": "और उसने पहला अंश तो अपने लिये चुन लिया,"
  },
  {
    "id": 5833,
    "book": "deuteronomy                             ",
    "chapter": "33",
    "verse": "22",
    "text": "फिर दान के विषय में उसने कहा,"
  },
  {
    "id": 5834,
    "book": "deuteronomy                             ",
    "chapter": "33",
    "verse": "23",
    "text": "फिर नप्ताली के विषय में उसने कहा,"
  },
  {
    "id": 5835,
    "book": "deuteronomy                             ",
    "chapter": "33",
    "verse": "24",
    "text": "फिर आशेर के विषय में उसने कहा,"
  },
  {
    "id": 5836,
    "book": "deuteronomy                             ",
    "chapter": "33",
    "verse": "25",
    "text": "तेरे जूते लोहे और पीतल के होंगे,"
  },
  {
    "id": 5837,
    "book": "deuteronomy                             ",
    "chapter": "33",
    "verse": "26",
    "text": "“हे यशूरून, परमेश्वर के तुल्य और कोई नहीं है,"
  },
  {
    "id": 5838,
    "book": "deuteronomy                             ",
    "chapter": "33",
    "verse": "27",
    "text": "अनादि परमेश्वर तेरा गृहधाम है,"
  },
  {
    "id": 5839,
    "book": "deuteronomy                             ",
    "chapter": "33",
    "verse": "28",
    "text": "और इस्राएल निडर बसा रहता है,"
  },
  {
    "id": 5840,
    "book": "deuteronomy                             ",
    "chapter": "33",
    "verse": "29",
    "text": "हे इस्राएल, तू क्या ही धन्य है!"
  }
]
