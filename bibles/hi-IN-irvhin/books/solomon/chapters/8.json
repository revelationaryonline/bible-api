[
  {
    "id": 17642,
    "book": "solomon                                 ",
    "chapter": "8",
    "verse": "1",
    "text": "भला होता कि तू मेरे भाई के समान होता,"
  },
  {
    "id": 17643,
    "book": "solomon                                 ",
    "chapter": "8",
    "verse": "2",
    "text": "मैं तुझको अपनी माता के घर ले चलती,"
  },
  {
    "id": 17644,
    "book": "solomon                                 ",
    "chapter": "8",
    "verse": "3",
    "text": "काश, उसका बायाँ हाथ मेरे सिर के नीचे होता,"
  },
  {
    "id": 17645,
    "book": "solomon                                 ",
    "chapter": "8",
    "verse": "4",
    "text": "हे यरूशलेम की पुत्रियों, मैं तुम को शपथ धराती हूँ,"
  },
  {
    "id": 17646,
    "book": "solomon                                 ",
    "chapter": "8",
    "verse": "5",
    "text": "यह कौन है जो अपने प्रेमी पर टेक लगाए हुए"
  },
  {
    "id": 17647,
    "book": "solomon                                 ",
    "chapter": "8",
    "verse": "6",
    "text": "मुझे नगीने के समान अपने हृदय पर लगा रख,"
  },
  {
    "id": 17648,
    "book": "solomon                                 ",
    "chapter": "8",
    "verse": "7",
    "text": "पानी की बाढ़ से भी प्रेम नहीं बुझ सकता,"
  },
  {
    "id": 17649,
    "book": "solomon                                 ",
    "chapter": "8",
    "verse": "8",
    "text": "हमारी एक छोटी बहन है,"
  },
  {
    "id": 17650,
    "book": "solomon                                 ",
    "chapter": "8",
    "verse": "9",
    "text": "यदि वह शहरपनाह होती"
  },
  {
    "id": 17651,
    "book": "solomon                                 ",
    "chapter": "8",
    "verse": "10",
    "text": "मैं शहरपनाह थी और मेरी छातियाँ उसके गुम्मट;"
  },
  {
    "id": 17652,
    "book": "solomon                                 ",
    "chapter": "8",
    "verse": "11",
    "text": "बाल्हामोन में सुलैमान की एक दाख की बारी थी;"
  },
  {
    "id": 17653,
    "book": "solomon                                 ",
    "chapter": "8",
    "verse": "12",
    "text": "मेरी निज दाख की बारी मेरे ही लिये है;"
  },
  {
    "id": 17654,
    "book": "solomon                                 ",
    "chapter": "8",
    "verse": "13",
    "text": "तू जो बारियों में रहती है,"
  },
  {
    "id": 17655,
    "book": "solomon                                 ",
    "chapter": "8",
    "verse": "14",
    "text": "हे मेरे प्रेमी, शीघ्रता कर,"
  }
