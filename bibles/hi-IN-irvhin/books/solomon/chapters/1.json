[
  {
    "id": 17539,
    "book": "solomon                                 ",
    "chapter": "1",
    "verse": "1",
    "text": "श्रेष्ठगीत जो सुलैमान का है। (1 राजा. 4:32)"
  },
  {
    "id": 17540,
    "book": "solomon                                 ",
    "chapter": "1",
    "verse": "2",
    "text": "तू अपने मुँह के चुम्बनों से मुझे चूमे!"
  },
  {
    "id": 17541,
    "book": "solomon                                 ",
    "chapter": "1",
    "verse": "3",
    "text": "तेरे भाँति-भाँति के इत्रों का सुगन्ध उत्तम है,"
  },
  {
    "id": 17542,
    "book": "solomon                                 ",
    "chapter": "1",
    "verse": "4",
    "text": "मुझे खींच ले; हम तेरे पीछे दौड़ेंगे।"
  },
  {
    "id": 17543,
    "book": "solomon                                 ",
    "chapter": "1",
    "verse": "5",
    "text": "हे यरूशलेम की पुत्रियों,"
  },
  {
    "id": 17544,
    "book": "solomon                                 ",
    "chapter": "1",
    "verse": "6",
    "text": "मुझे इसलिए न घूर कि मैं साँवली हूँ,"
  },
  {
    "id": 17545,
    "book": "solomon                                 ",
    "chapter": "1",
    "verse": "7",
    "text": "हे मेरे प्राणप्रिय मुझे बता,"
  },
  {
    "id": 17546,
    "book": "solomon                                 ",
    "chapter": "1",
    "verse": "8",
    "text": "हे स्त्रियों में सुन्दरी, यदि तू यह न जानती हो"
  },
  {
    "id": 17547,
    "book": "solomon                                 ",
    "chapter": "1",
    "verse": "9",
    "text": "हे मेरी प्रिय मैंने तेरी तुलना"
  },
  {
    "id": 17548,
    "book": "solomon                                 ",
    "chapter": "1",
    "verse": "10",
    "text": "तेरे गाल केशों के लटों के बीच क्या ही सुन्दर हैं,"
  },
  {
    "id": 17549,
    "book": "solomon                                 ",
    "chapter": "1",
    "verse": "11",
    "text": "हम तेरे लिये चाँदी के फूलदार सोने के आभूषण बनाएँगे।"
  },
  {
    "id": 17550,
    "book": "solomon                                 ",
    "chapter": "1",
    "verse": "12",
    "text": "जब राजा अपनी मेज के पास बैठा था"
  },
  {
    "id": 17551,
    "book": "solomon                                 ",
    "chapter": "1",
    "verse": "13",
    "text": "मेरा प्रेमी मेरे लिये लोबान की थैली के समान है"
  },
  {
    "id": 17552,
    "book": "solomon                                 ",
    "chapter": "1",
    "verse": "14",
    "text": "मेरा प्रेमी मेरे लिये मेंहदी के फूलों के गुच्छे के समान है,"
  },
  {
    "id": 17553,
    "book": "solomon                                 ",
    "chapter": "1",
    "verse": "15",
    "text": "तू सुन्दरी है, हे मेरी प्रिय, तू सुन्दरी है;"
  },
  {
    "id": 17554,
    "book": "solomon                                 ",
    "chapter": "1",
    "verse": "16",
    "text": "हे मेरे प्रिय तू सुन्दर और मनभावना है"
  },
  {
    "id": 17555,
    "book": "solomon                                 ",
    "chapter": "1",
    "verse": "17",
    "text": "हमारे घर के धरन देवदार हैं"
  }
