[
  {
    "id": 17600,
    "book": "solomon                                 ",
    "chapter": "5",
    "verse": "1",
    "text": "हे मेरी बहन, हे मेरी दुल्हन,"
  },
  {
    "id": 17601,
    "book": "solomon                                 ",
    "chapter": "5",
    "verse": "2",
    "text": "मैं सोती थी, परन्तु मेरा मन जागता था।"
  },
  {
    "id": 17602,
    "book": "solomon                                 ",
    "chapter": "5",
    "verse": "3",
    "text": "मैं अपना वस्त्र उतार चुकी थी मैं उसे फिर कैसे पहनूँ?"
  },
  {
    "id": 17603,
    "book": "solomon                                 ",
    "chapter": "5",
    "verse": "4",
    "text": "मेरे प्रेमी ने अपना हाथ किवाड़ के छेद से भीतर डाल दिया,"
  },
  {
    "id": 17604,
    "book": "solomon                                 ",
    "chapter": "5",
    "verse": "5",
    "text": "मैं अपने प्रेमी के लिये द्वार खोलने को उठी,"
  },
  {
    "id": 17605,
    "book": "solomon                                 ",
    "chapter": "5",
    "verse": "6",
    "text": "मैंने अपने प्रेमी के लिये द्वार तो खोला"
  },
  {
    "id": 17606,
    "book": "solomon                                 ",
    "chapter": "5",
    "verse": "7",
    "text": "पहरेदार जो नगर में घूमते थे, मुझे मिले,"
  },
  {
    "id": 17607,
    "book": "solomon                                 ",
    "chapter": "5",
    "verse": "8",
    "text": "हे यरूशलेम की पुत्रियों, मैं तुम को शपथ धराकर कहती हूँ, यदि मेरा प्रेमी तुम को मिल जाए,"
  },
  {
    "id": 17608,
    "book": "solomon                                 ",
    "chapter": "5",
    "verse": "9",
    "text": "हे स्त्रियों में परम सुन्दरी"
  },
  {
    "id": 17609,
    "book": "solomon                                 ",
    "chapter": "5",
    "verse": "10",
    "text": "मेरा प्रेमी गोरा और लाल सा है,"
  },
  {
    "id": 17610,
    "book": "solomon                                 ",
    "chapter": "5",
    "verse": "11",
    "text": "उसका सिर उत्तम कुन्दन है;"
  },
  {
    "id": 17611,
    "book": "solomon                                 ",
    "chapter": "5",
    "verse": "12",
    "text": "उसकी आँखें उन कबूतरों के समान हैं जो"
  },
  {
    "id": 17612,
    "book": "solomon                                 ",
    "chapter": "5",
    "verse": "13",
    "text": "उसके गाल फूलों की फुलवारी और बलसान"
  },
  {
    "id": 17613,
    "book": "solomon                                 ",
    "chapter": "5",
    "verse": "14",
    "text": "उसके हाथ फीरोजा जड़े हुए सोने की छड़ें हैं।"
  },
  {
    "id": 17614,
    "book": "solomon                                 ",
    "chapter": "5",
    "verse": "15",
    "text": "उसके पाँव कुन्दन पर बैठाये हुए संगमरमर के खम्भे हैं।"
  },
  {
    "id": 17615,
    "book": "solomon                                 ",
    "chapter": "5",
    "verse": "16",
    "text": "उसकी वाणी अति मधुर है, हाँ वह परम सुन्दर है।"
  }
]
