[
  {
    "id": 13469,
    "book": "job                                     ",
    "chapter": "26",
    "verse": "1",
    "text": "तब अय्यूब ने कहा,"
  },
  {
    "id": 13470,
    "book": "job                                     ",
    "chapter": "26",
    "verse": "2",
    "text": "“निर्बल जन की तूने क्या ही बड़ी सहायता की,"
  },
  {
    "id": 13471,
    "book": "job                                     ",
    "chapter": "26",
    "verse": "3",
    "text": "निर्बुद्धि मनुष्य को तूने क्या ही अच्छी सम्मति दी,"
  },
  {
    "id": 13472,
    "book": "job                                     ",
    "chapter": "26",
    "verse": "4",
    "text": "तूने किसके हित के लिये बातें कही?"
  },
  {
    "id": 13473,
    "book": "job                                     ",
    "chapter": "26",
    "verse": "5",
    "text": "“बहुत दिन के मरे हुए लोग भी"
  },
  {
    "id": 13474,
    "book": "job                                     ",
    "chapter": "26",
    "verse": "6",
    "text": "अधोलोक उसके सामने उघड़ा रहता है,"
  },
  {
    "id": 13475,
    "book": "job                                     ",
    "chapter": "26",
    "verse": "7",
    "text": "वह उत्तर दिशा को निराधार फैलाए रहता है,"
  },
  {
    "id": 13476,
    "book": "job                                     ",
    "chapter": "26",
    "verse": "8",
    "text": "वह जल को अपनी काली घटाओं में बाँध रखता26:8 वह जल को अपनी काली घटाओं में बाँध रखता: बादलों में पानी ऐसा रहता है जैसे बंधा है जब तक कि परमेश्वर उसे बूँदों के रूप में पृथ्वी पर न बरसाएँ। ,"
  },
  {
    "id": 13477,
    "book": "job                                     ",
    "chapter": "26",
    "verse": "9",
    "text": "वह अपने सिंहासन के सामने बादल फैलाकर"
  },
  {
    "id": 13478,
    "book": "job                                     ",
    "chapter": "26",
    "verse": "10",
    "text": "उजियाले और अंधियारे के बीच जहाँ सीमा बंधी है,"
  },
  {
    "id": 13479,
    "book": "job                                     ",
    "chapter": "26",
    "verse": "11",
    "text": "उसकी घुड़की से"
  },
  {
    "id": 13480,
    "book": "job                                     ",
    "chapter": "26",
    "verse": "12",
    "text": "वह अपने बल से समुद्र को शान्त,"
  },
  {
    "id": 13481,
    "book": "job                                     ",
    "chapter": "26",
    "verse": "13",
    "text": "उसकी आत्मा से आकाशमण्डल स्वच्छ हो जाता है,"
  },
  {
    "id": 13482,
    "book": "job                                     ",
    "chapter": "26",
    "verse": "14",
    "text": "देखो, ये तो उसकी गति के किनारे ही हैं;"
