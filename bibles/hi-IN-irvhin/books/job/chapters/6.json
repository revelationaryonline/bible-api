  {
    "id": 12988,
    "book": "job                                     ",
    "chapter": "6",
    "verse": "9",
    "text": "कि परमेश्वर प्रसन्न होकर मुझे कुचल डालता,"
  },
  {
    "id": 12989,
    "book": "job                                     ",
    "chapter": "6",
    "verse": "10",
    "text": "यही मेरी शान्ति का कारण;"
