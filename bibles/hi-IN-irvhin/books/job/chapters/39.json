[
  {
    "id": 13836,
    "book": "job                                     ",
    "chapter": "39",
    "verse": "1",
    "text": "“क्या तू जानता है कि पहाड़ पर की जंगली बकरियाँ कब बच्चे देती हैं?"
  },
  {
    "id": 13837,
    "book": "job                                     ",
    "chapter": "39",
    "verse": "2",
    "text": "क्या तू उनके महीने गिन सकता है,"
  },
  {
    "id": 13838,
    "book": "job                                     ",
    "chapter": "39",
    "verse": "3",
    "text": "जब वे बैठकर अपने बच्चों को जनतीं,"
  },
  {
    "id": 13839,
    "book": "job                                     ",
    "chapter": "39",
    "verse": "4",
    "text": "उनके बच्चे हष्ट-पुष्ट होकर मैदान में बढ़ जाते हैं;"
  },
  {
    "id": 13840,
    "book": "job                                     ",
    "chapter": "39",
    "verse": "5",
    "text": "“किसने जंगली गदहे को स्वाधीन करके छोड़ दिया है?"
  },
  {
    "id": 13841,
    "book": "job                                     ",
    "chapter": "39",
    "verse": "6",
    "text": "उसका घर मैंने निर्जल देश को,"
  },
  {
    "id": 13842,
    "book": "job                                     ",
    "chapter": "39",
    "verse": "7",
    "text": "वह नगर के कोलाहल पर हँसता,"
  },
  {
    "id": 13843,
    "book": "job                                     ",
    "chapter": "39",
    "verse": "8",
    "text": "पहाड़ों पर जो कुछ मिलता है उसे वह चरता"
  },
  {
    "id": 13844,
    "book": "job                                     ",
    "chapter": "39",
    "verse": "9",
    "text": "“क्या जंगली साँड़ तेरा काम करने को प्रसन्न होगा?"
  },
  {
    "id": 13845,
    "book": "job                                     ",
    "chapter": "39",
    "verse": "10",
    "text": "क्या तू जंगली साँड़ को रस्से से बाँधकर रेघारियों में चला सकता है?"
  },
  {
    "id": 13846,
    "book": "job                                     ",
    "chapter": "39",
    "verse": "11",
    "text": "क्या तू उसके बड़े बल के कारण उस पर भरोसा करेगा?"
  },
  {
    "id": 13847,
    "book": "job                                     ",
    "chapter": "39",
    "verse": "12",
    "text": "क्या तू उसका विश्वास करेगा, कि वह तेरा अनाज घर ले आए,"
  },
  {
    "id": 13848,
    "book": "job                                     ",
    "chapter": "39",
    "verse": "13",
    "text": "“फिर शुतुर्मुर्गी अपने पंखों को आनन्द से फुलाती है,"
  },
  {
    "id": 13849,
    "book": "job                                     ",
    "chapter": "39",
    "verse": "14",
    "text": "क्योंकि वह तो अपने अण्डे भूमि पर छोड़ देती39:14 वह तो अपने अण्डे भूमि पर छोड़ देती: वह अन्य पक्षियों की नाई घोसला नहीं बनाती है। वह रेत में अण्डा देती है।"
  },
  {
    "id": 13850,
    "book": "job                                     ",
    "chapter": "39",
    "verse": "15",
    "text": "और इसकी सुधि नहीं रखती, कि वे पाँव से कुचले जाएँगे,"
  },
  {
    "id": 13851,
    "book": "job                                     ",
    "chapter": "39",
    "verse": "16",
    "text": "वह अपने बच्चों से ऐसी कठोरता करती है कि मानो उसके नहीं हैं;"
  },
  {
    "id": 13852,
    "book": "job                                     ",
    "chapter": "39",
    "verse": "17",
    "text": "क्योंकि परमेश्वर ने उसको बुद्धिरहित बनाया,"
  },
  {
    "id": 13853,
    "book": "job                                     ",
    "chapter": "39",
    "verse": "18",
    "text": "जिस समय वह सीधी होकर अपने पंख फैलाती है,"
  },
  {
    "id": 13854,
    "book": "job                                     ",
    "chapter": "39",
    "verse": "19",
    "text": "“क्या तूने घोड़े को उसका बल दिया है?"
  },
  {
    "id": 13855,
    "book": "job                                     ",
    "chapter": "39",
    "verse": "20",
    "text": "क्या उसको टिड्डी की सी उछलने की शक्ति तू देता है?"
  },
  {
    "id": 13856,
    "book": "job                                     ",
    "chapter": "39",
    "verse": "21",
    "text": "वह तराई में टाप मारता है और अपने बल से हर्षित रहता है,"
  },
  {
    "id": 13857,
    "book": "job                                     ",
    "chapter": "39",
    "verse": "22",
    "text": "वह डर की बात पर हँसता39:22 वह डर की बात पर हँसता: वह डरावनी बात पर हँसता है अर्थात् वह निर्भीक है। , और नहीं घबराता;"
  },
  {
    "id": 13858,
    "book": "job                                     ",
    "chapter": "39",
    "verse": "23",
    "text": "तरकश और चमकता हुआ सांग और भाला"
  },
  {
    "id": 13859,
    "book": "job                                     ",
    "chapter": "39",
    "verse": "24",
    "text": "वह रिस और क्रोध के मारे भूमि को निगलता है;"
  },
  {
    "id": 13860,
    "book": "job                                     ",
    "chapter": "39",
    "verse": "25",
    "text": "जब जब नरसिंगा बजता तब-तब वह हिन-हिन करता है,"
  },
  {
    "id": 13861,
    "book": "job                                     ",
    "chapter": "39",
    "verse": "26",
    "text": "“क्या तेरे समझाने से बाज उड़ता है,"
  },
  {
    "id": 13862,
    "book": "job                                     ",
    "chapter": "39",
    "verse": "27",
    "text": "क्या उकाब तेरी आज्ञा से ऊपर चढ़ जाता है,"
  },
  {
    "id": 13863,
    "book": "job                                     ",
    "chapter": "39",
    "verse": "28",
    "text": "वह चट्टान पर रहता और चट्टान की चोटी"
  },
  {
    "id": 13864,
    "book": "job                                     ",
    "chapter": "39",
    "verse": "29",
    "text": "वह अपनी आँखों से दूर तक देखता है,"
  },
  {
    "id": 13865,
    "book": "job                                     ",
    "chapter": "39",
    "verse": "30",
    "text": "उसके बच्चे भी लहू चूसते हैं;"
  }
]
