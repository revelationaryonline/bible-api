[
  {
    "id": 13890,
    "book": "job                                     ",
    "chapter": "41",
    "verse": "1",
    "text": "“फिर क्या तू लिव्यातान को बंसी के द्वारा खींच सकता है,"
  },
  {
    "id": 13891,
    "book": "job                                     ",
    "chapter": "41",
    "verse": "2",
    "text": "क्या तू उसकी नाक में नकेल लगा सकता"
  },
  {
    "id": 13892,
    "book": "job                                     ",
    "chapter": "41",
    "verse": "3",
    "text": "क्या वह तुझ से बहुत गिड़गिड़ाहट करेगा,"
  },
  {
    "id": 13893,
    "book": "job                                     ",
    "chapter": "41",
    "verse": "4",
    "text": "क्या वह तुझ से वाचा बाँधेगा"
  },
  {
    "id": 13894,
    "book": "job                                     ",
    "chapter": "41",
    "verse": "5",
    "text": "क्या तू उससे ऐसे खेलेगा जैसे चिड़िया से,"
  },
  {
    "id": 13895,
    "book": "job                                     ",
    "chapter": "41",
    "verse": "6",
    "text": "क्या मछुए के दल उसे बिकाऊ माल समझेंगे?"
  },
  {
    "id": 13896,
    "book": "job                                     ",
    "chapter": "41",
    "verse": "7",
    "text": "क्या तू उसका चमड़ा भाले से,"
  },
  {
    "id": 13897,
    "book": "job                                     ",
    "chapter": "41",
    "verse": "8",
    "text": "तू उस पर अपना हाथ ही धरे, तो लड़ाई को कभी न भूलेगा,"
  },
  {
    "id": 13898,
    "book": "job                                     ",
    "chapter": "41",
    "verse": "9",
    "text": "देख, उसे पकड़ने की आशा निष्फल रहती है;"
  },
  {
    "id": 13899,
    "book": "job                                     ",
    "chapter": "41",
    "verse": "10",
    "text": "कोई ऐसा साहसी नहीं, जो लिव्यातान को भड़काए;"
  },
  {
    "id": 13900,
    "book": "job                                     ",
    "chapter": "41",
    "verse": "11",
    "text": "किसने मुझे पहले दिया है, जिसका बदला मुझे देना पड़े!"
  },
  {
    "id": 13901,
    "book": "job                                     ",
    "chapter": "41",
    "verse": "12",
    "text": "“मैं लिव्यातान के अंगों के विषय,"
  },
  {
    "id": 13902,
    "book": "job                                     ",
    "chapter": "41",
    "verse": "13",
    "text": "उसके ऊपर के पहरावे को कौन उतार सकता है?41:13 उसके ऊपर के पहरावे को कौन उतार सकता है?: नि:सन्देह ऊपर का पहरावा अर्थात् उसकी त्वचा। अर्थात् उसकी कठोर त्वचा उसकी रक्षा का कवच है और कोई भी इस कवच को उतार कर, उस पर हावी नहीं हो सकता है।"
  },
  {
    "id": 13903,
    "book": "job                                     ",
    "chapter": "41",
    "verse": "14",
    "text": "उसके मुख के दोनों किवाड़ कौन खोल सकता है?"
  },
  {
    "id": 13904,
    "book": "job                                     ",
    "chapter": "41",
    "verse": "15",
    "text": "उसके छिलकों की रेखाएँ घमण्ड का कारण हैं;"
  },
  {
    "id": 13905,
    "book": "job                                     ",
    "chapter": "41",
    "verse": "16",
    "text": "वे एक दूसरे से ऐसे जुड़े हुए हैं,"
  },
  {
    "id": 13906,
    "book": "job                                     ",
    "chapter": "41",
    "verse": "17",
    "text": "वे आपस में मिले हुए"
  },
  {
    "id": 13907,
    "book": "job                                     ",
    "chapter": "41",
    "verse": "18",
    "text": "फिर उसके छींकने से उजियाला चमक उठता है,"
  },
  {
    "id": 13908,
    "book": "job                                     ",
    "chapter": "41",
    "verse": "19",
    "text": "उसके मुँह से जलते हुए पलीते निकलते हैं,"
  },
  {
    "id": 13909,
    "book": "job                                     ",
    "chapter": "41",
    "verse": "20",
    "text": "उसके नथनों से ऐसा धुआँ निकलता है,"
  },
  {
    "id": 13910,
    "book": "job                                     ",
    "chapter": "41",
    "verse": "21",
    "text": "उसकी साँस से कोयले सुलगते,"
  },
  {
    "id": 13911,
    "book": "job                                     ",
    "chapter": "41",
    "verse": "22",
    "text": "उसकी गर्दन में सामर्थ्य बनी रहती है,"
  },
  {
    "id": 13912,
    "book": "job                                     ",
    "chapter": "41",
    "verse": "23",
    "text": "उसके माँस पर माँस चढ़ा हुआ है,"
  },
  {
    "id": 13913,
    "book": "job                                     ",
    "chapter": "41",
    "verse": "24",
    "text": "उसका हृदय पत्थर सा दृढ़ है,"
  },
  {
    "id": 13914,
    "book": "job                                     ",
    "chapter": "41",
    "verse": "25",
    "text": "जब वह उठने लगता है, तब सामर्थी भी डर जाते हैं,"
  },
  {
    "id": 13915,
    "book": "job                                     ",
    "chapter": "41",
    "verse": "26",
    "text": "यदि कोई उस पर तलवार चलाए, तो उससे कुछ न बन पड़ेगा;"
  },
  {
    "id": 13916,
    "book": "job                                     ",
    "chapter": "41",
    "verse": "27",
    "text": "वह लोहे को पुआल सा,"
  },
  {
    "id": 13917,
    "book": "job                                     ",
    "chapter": "41",
    "verse": "28",
    "text": "वह तीर से भगाया नहीं जाता,"
  },
  {
    "id": 13918,
    "book": "job                                     ",
    "chapter": "41",
    "verse": "29",
    "text": "लाठियाँ भी भूसे के समान गिनी जाती हैं;"
  },
  {
    "id": 13919,
    "book": "job                                     ",
    "chapter": "41",
    "verse": "30",
    "text": "उसके निचले भाग पैने ठीकरे के समान हैं,"
  },
  {
    "id": 13920,
    "book": "job                                     ",
    "chapter": "41",
    "verse": "31",
    "text": "वह गहरे जल को हण्डे के समान मथता है"
  },
  {
    "id": 13921,
    "book": "job                                     ",
    "chapter": "41",
    "verse": "32",
    "text": "वह अपने पीछे चमकीली लीक छोड़ता जाता है।"
  },
  {
    "id": 13922,
    "book": "job                                     ",
    "chapter": "41",
    "verse": "33",
    "text": "धरती पर उसके तुल्य और कोई नहीं है,"
  },
  {
    "id": 13923,
    "book": "job                                     ",
    "chapter": "41",
    "verse": "34",
    "text": "जो कुछ ऊँचा है, उसे वह ताकता ही रहता है,"
  }
]
