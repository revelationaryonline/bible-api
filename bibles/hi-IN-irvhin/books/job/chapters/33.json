[
  {
    "id": 13652,
    "book": "job                                     ",
    "chapter": "33",
    "verse": "1",
    "text": "“इसलिए अब, हे अय्यूब! मेरी बातें सुन ले,"
  },
  {
    "id": 13653,
    "book": "job                                     ",
    "chapter": "33",
    "verse": "2",
    "text": "मैंने तो अपना मुँह खोला है,"
  },
  {
    "id": 13654,
    "book": "job                                     ",
    "chapter": "33",
    "verse": "3",
    "text": "मेरी बातें मेरे मन की सिधाई प्रगट करेंगी;"
  },
  {
    "id": 13655,
    "book": "job                                     ",
    "chapter": "33",
    "verse": "4",
    "text": "मुझे परमेश्वर की आत्मा ने बनाया है,"
  },
  {
    "id": 13656,
    "book": "job                                     ",
    "chapter": "33",
    "verse": "5",
    "text": "यदि तू मुझे उत्तर दे सके, तो दे;"
  },
  {
    "id": 13657,
    "book": "job                                     ",
    "chapter": "33",
    "verse": "6",
    "text": "देख, मैं परमेश्वर के सन्मुख तेरे तुल्य हूँ;"
  },
  {
    "id": 13658,
    "book": "job                                     ",
    "chapter": "33",
    "verse": "7",
    "text": "सुन, तुझे डर के मारे घबराना न पड़ेगा,"
  },
  {
    "id": 13659,
    "book": "job                                     ",
    "chapter": "33",
    "verse": "8",
    "text": "“निःसन्देह तेरी ऐसी बात मेरे कानों में पड़ी है"
  },
  {
    "id": 13660,
    "book": "job                                     ",
    "chapter": "33",
    "verse": "9",
    "text": "‘मैं तो पवित्र और निरपराध और निष्कलंक हूँ;"
  },
  {
    "id": 13661,
    "book": "job                                     ",
    "chapter": "33",
    "verse": "10",
    "text": "देख, परमेश्वर मुझसे झगड़ने के दाँव ढूँढ़ता है33:10 परमेश्वर मुझसे झगड़ने के दाँव ढूँढ़ता है: अर्थात् परमेश्वर ने अय्यूब का विरोध करने के अवसर खोजे कि वह उसे दण्ड देने का आधार एवं कारण देखने का इच्छुक है। ,"
  },
  {
    "id": 13662,
    "book": "job                                     ",
    "chapter": "33",
    "verse": "11",
    "text": "वह मेरे दोनों पाँवों को काठ में ठोंक देता है,"
  },
  {
    "id": 13663,
    "book": "job                                     ",
    "chapter": "33",
    "verse": "12",
    "text": "“देख, मैं तुझे उत्तर देता हूँ, इस बात में तू सच्चा नहीं है।"
  },
  {
    "id": 13664,
    "book": "job                                     ",
    "chapter": "33",
    "verse": "13",
    "text": "तू उससे क्यों झगड़ता है?"
  },
  {
    "id": 13665,
    "book": "job                                     ",
    "chapter": "33",
    "verse": "14",
    "text": "क्योंकि परमेश्वर तो एक क्या वरन् दो बार बोलता है,"
  },
  {
    "id": 13666,
    "book": "job                                     ",
    "chapter": "33",
    "verse": "15",
    "text": "स्वप्न में, या रात को दिए हुए दर्शन में,"
  },
  {
    "id": 13667,
    "book": "job                                     ",
    "chapter": "33",
    "verse": "16",
    "text": "तब वह मनुष्यों के कान खोलता है,"
  },
  {
    "id": 13668,
    "book": "job                                     ",
    "chapter": "33",
    "verse": "17",
    "text": "जिससे वह मनुष्य को उसके संकल्प से रोके33:17 जिससे वह मनुष्य को उसके संकल्प से रोके: परमेश्वर उसे विधर्म की योजनाओं को कार्यान्वित करने के परिणामों की चेतावनी की युक्ति रचता है। वह उसे चेतावनी देखकर स्पष्ट करता है कि उसका मार्ग उसे दण्ड दिलाएगा।"
  },
  {
    "id": 13669,
    "book": "job                                     ",
    "chapter": "33",
    "verse": "18",
    "text": "वह उसके प्राण को गड्ढे से बचाता है33:18 वह उसके प्राण को गड्ढे से बचाता है: वह मनुष्यों को चिताने के लिए ऐसा करता है कि वे अपना विनाश न लाएँ। ,"
  },
  {
    "id": 13670,
    "book": "job                                     ",
    "chapter": "33",
    "verse": "19",
    "text": "“उसकी ताड़ना भी होती है, कि वह अपने बिछौने पर पड़ा-पड़ा तड़पता है,"
  },
  {
    "id": 13671,
    "book": "job                                     ",
    "chapter": "33",
    "verse": "20",
    "text": "यहाँ तक कि उसका प्राण रोटी से,"
  },
  {
    "id": 13672,
    "book": "job                                     ",
    "chapter": "33",
    "verse": "21",
    "text": "उसका माँस ऐसा सूख जाता है कि दिखाई नहीं देता;"
  },
  {
    "id": 13673,
    "book": "job                                     ",
    "chapter": "33",
    "verse": "22",
    "text": "तब वह कब्र के निकट पहुँचता है,"
  },
  {
    "id": 13674,
    "book": "job                                     ",
    "chapter": "33",
    "verse": "23",
    "text": "यदि उसके लिये कोई बिचवई स्वर्गदूत मिले,"
  },
  {
    "id": 13675,
    "book": "job                                     ",
    "chapter": "33",
    "verse": "24",
    "text": "तो वह उस पर अनुग्रह करके कहता है,"
  },
  {
    "id": 13676,
    "book": "job                                     ",
    "chapter": "33",
    "verse": "25",
    "text": "तब उस मनुष्य की देह बालक की देह से अधिक स्वस्थ और कोमल हो जाएगी;"
  },
  {
    "id": 13677,
    "book": "job                                     ",
    "chapter": "33",
    "verse": "26",
    "text": "वह परमेश्वर से विनती करेगा, और वह उससे प्रसन्न होगा,"
  },
  {
    "id": 13678,
    "book": "job                                     ",
    "chapter": "33",
    "verse": "27",
    "text": "वह मनुष्यों के सामने गाने और कहने लगता है,"
  },
  {
    "id": 13679,
    "book": "job                                     ",
    "chapter": "33",
    "verse": "28",
    "text": "उसने मेरे प्राण कब्र में पड़ने से बचाया है,"
  },
  {
    "id": 13680,
    "book": "job                                     ",
    "chapter": "33",
    "verse": "29",
    "text": "“देख, ऐसे-ऐसे सब काम परमेश्वर मनुष्य के साथ दो बार क्या"
  },
  {
    "id": 13681,
    "book": "job                                     ",
    "chapter": "33",
    "verse": "30",
    "text": "जिससे उसको कब्र से बचाए,"
  },
  {
    "id": 13682,
    "book": "job                                     ",
    "chapter": "33",
    "verse": "31",
    "text": "हे अय्यूब! कान लगाकर मेरी सुन;"
  },
  {
    "id": 13683,
    "book": "job                                     ",
    "chapter": "33",
    "verse": "32",
    "text": "यदि तुझे बात कहनी हो, तो मुझे उत्तर दे;"
  },
  {
    "id": 13684,
    "book": "job                                     ",
    "chapter": "33",
    "verse": "33",
    "text": "यदि नहीं, तो तू मेरी सुन;"
  }
]
