[
  {
    "id": 13278,
    "book": "job                                     ",
    "chapter": "18",
    "verse": "1",
    "text": "तब शूही बिल्दद ने कहा,"
  },
  {
    "id": 13279,
    "book": "job                                     ",
    "chapter": "18",
    "verse": "2",
    "text": "“तुम कब तक फंदे लगा लगाकर वचन पकड़ते रहोगे?"
  },
  {
    "id": 13280,
    "book": "job                                     ",
    "chapter": "18",
    "verse": "3",
    "text": "हम लोग तुम्हारी दृष्टि में क्यों पशु के तुल्य समझे जाते,"
  },
  {
    "id": 13281,
    "book": "job                                     ",
    "chapter": "18",
    "verse": "4",
    "text": "हे अपने को क्रोध में फाड़नेवाले"
  },
  {
    "id": 13282,
    "book": "job                                     ",
    "chapter": "18",
    "verse": "5",
    "text": "“तो भी दुष्टों का दीपक बुझ जाएगा,"
