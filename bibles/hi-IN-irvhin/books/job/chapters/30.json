[
  {
    "id": 13559,
    "book": "job                                     ",
    "chapter": "30",
    "verse": "1",
    "text": "“परन्तु अब जिनकी आयु मुझसे कम है30:1 जिनकी आयु मुझसे कम है जो मुझसे छोटे हैं, वे मेरी हँसी करते हैं,"
  },
  {
    "id": 13560,
    "book": "job                                     ",
    "chapter": "30",
    "verse": "2",
    "text": "उनके भुजबल से मुझे क्या लाभ हो सकता था?"
  },
  {
    "id": 13561,
    "book": "job                                     ",
    "chapter": "30",
    "verse": "3",
    "text": "वे दरिद्रता और काल के मारे दुबले पड़े हुए हैं,"
  },
  {
    "id": 13562,
    "book": "job                                     ",
    "chapter": "30",
    "verse": "4",
    "text": "वे झाड़ी के आस-पास का लोनिया साग तोड़ लेते,"
  },
  {
    "id": 13563,
    "book": "job                                     ",
    "chapter": "30",
    "verse": "5",
    "text": "वे मनुष्यों के बीच में से निकाले जाते हैं,"
  },
  {
    "id": 13564,
    "book": "job                                     ",
    "chapter": "30",
    "verse": "6",
    "text": "डरावने नालों में, भूमि के बिलों में,"
  },
  {
    "id": 13565,
    "book": "job                                     ",
    "chapter": "30",
    "verse": "7",
    "text": "वे झाड़ियों के बीच रेंकते,"
  },
  {
    "id": 13566,
    "book": "job                                     ",
    "chapter": "30",
    "verse": "8",
    "text": "वे मूर्खों और नीच लोगों के वंश हैं"
  },
  {
    "id": 13567,
    "book": "job                                     ",
    "chapter": "30",
    "verse": "9",
    "text": "“ऐसे ही लोग अब मुझ पर लगते गीत गाते,"
  },
  {
    "id": 13568,
    "book": "job                                     ",
    "chapter": "30",
    "verse": "10",
    "text": "वे मुझसे घिन खाकर दूर रहते30:10 वे मुझसे घिन खाकर दूर रहते: वे मुझे घृणित समझते हैं। ,"
  },
  {
    "id": 13569,
    "book": "job                                     ",
    "chapter": "30",
    "verse": "11",
    "text": "परमेश्वर ने जो मेरी रस्सी खोलकर मुझे दुःख दिया है,"
  },
  {
    "id": 13570,
    "book": "job                                     ",
    "chapter": "30",
    "verse": "12",
    "text": "मेरी दाहिनी ओर बाज़ारू लोग उठ खड़े होते हैं30:12 मेरी दाहिनी ओर बाज़ारू लोग उठ खड़े होते हैं: दाहिना पक्ष सम्मान का स्थान होता है और कोई उस स्थान को ले तो वह घोर अपमान माना जाता है। ,"
  },
  {
    "id": 13571,
    "book": "job                                     ",
    "chapter": "30",
    "verse": "13",
    "text": "जिनके कोई सहायक नहीं,"
  },
  {
    "id": 13572,
    "book": "job                                     ",
    "chapter": "30",
    "verse": "14",
    "text": "मानो बड़े नाके से घुसकर वे आ पड़ते हैं,"
