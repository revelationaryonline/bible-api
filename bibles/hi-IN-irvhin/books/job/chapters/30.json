  {
    "id": 13573,
    "book": "job                                     ",
    "chapter": "30",
    "verse": "15",
    "text": "मुझ में घबराहट छा गई है,"
  },
  {
    "id": 13574,
    "book": "job                                     ",
    "chapter": "30",
    "verse": "16",
    "text": "“और अब मैं शोकसागर में डूबा जाता हूँ;"
