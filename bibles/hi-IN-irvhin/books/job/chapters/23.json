[
  {
    "id": 13421,
    "book": "job                                     ",
    "chapter": "23",
    "verse": "1",
    "text": "तब अय्यूब ने कहा,"
  },
  {
    "id": 13422,
    "book": "job                                     ",
    "chapter": "23",
    "verse": "2",
    "text": "“मेरी कुड़कुड़ाहट अब भी नहीं रुक सकती23:2 मेरी कुड़कुड़ाहट अब भी नहीं रुक सकती: मेरी आहें मेरे कष्टों के बराबर भी नहीं है। वे मेरे दु:खों की अभिव्यक्ति के लिए भी तो पूरी नहीं पड़ती है। ,"
  },
  {
    "id": 13423,
    "book": "job                                     ",
    "chapter": "23",
    "verse": "3",
    "text": "भला होता, कि मैं जानता कि वह कहाँ मिल सकता है,"
  },
  {
    "id": 13424,
    "book": "job                                     ",
    "chapter": "23",
    "verse": "4",
    "text": "मैं उसके सामने अपना मुकद्दमा पेश करता,"
  },
  {
    "id": 13425,
    "book": "job                                     ",
    "chapter": "23",
    "verse": "5",
    "text": "मैं जान लेता कि वह मुझसे उत्तर में क्या कह सकता है,"
  },
  {
    "id": 13426,
    "book": "job                                     ",
    "chapter": "23",
    "verse": "6",
    "text": "क्या वह अपना बड़ा बल दिखाकर मुझसे मुकद्दमा लड़ता?"
  },
  {
    "id": 13427,
    "book": "job                                     ",
    "chapter": "23",
    "verse": "7",
    "text": "सज्जन उससे विवाद कर सकते,"
  },
  {
    "id": 13428,
    "book": "job                                     ",
    "chapter": "23",
    "verse": "8",
    "text": "“देखो, मैं आगे जाता हूँ परन्तु वह नहीं मिलता;"
  },
  {
    "id": 13429,
    "book": "job                                     ",
    "chapter": "23",
    "verse": "9",
    "text": "जब वह बाईं ओर काम करता है तब वह मुझे दिखाई नहीं देता;"
  },
  {
    "id": 13430,
    "book": "job                                     ",
    "chapter": "23",
    "verse": "10",
    "text": "परन्तु वह जानता है, कि मैं कैसी चाल चला हूँ;"
  },
  {
    "id": 13431,
    "book": "job                                     ",
    "chapter": "23",
    "verse": "11",
    "text": "मेरे पैर उसके मार्गों में स्थिर रहे;"
  },
  {
    "id": 13432,
    "book": "job                                     ",
    "chapter": "23",
    "verse": "12",
    "text": "उसकी आज्ञा का पालन करने से मैं न हटा,"
  },
  {
    "id": 13433,
    "book": "job                                     ",
    "chapter": "23",
    "verse": "13",
    "text": "परन्तु वह एक ही बात पर अड़ा रहता है,"
  },
  {
    "id": 13434,
    "book": "job                                     ",
    "chapter": "23",
    "verse": "14",
    "text": "जो कुछ मेरे लिये उसने ठाना है,"
  },
  {
    "id": 13435,
    "book": "job                                     ",
    "chapter": "23",
    "verse": "15",
    "text": "इस कारण मैं उसके सम्मुख घबरा जाता हूँ;"
  },
  {
    "id": 13436,
    "book": "job                                     ",
    "chapter": "23",
    "verse": "16",
    "text": "क्योंकि मेरा मन परमेश्वर ही ने कच्चा कर दिया,"
  },
  {
    "id": 13437,
    "book": "job                                     ",
    "chapter": "23",
    "verse": "17",
    "text": "क्योंकि मैं अंधकार से घिरा हुआ हूँ,"
  }
