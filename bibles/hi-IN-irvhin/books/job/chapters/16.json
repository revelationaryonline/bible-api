[
  {
    "id": 13240,
    "book": "job                                     ",
    "chapter": "16",
    "verse": "1",
    "text": "तब अय्यूब ने कहा,"
  },
  {
    "id": 13241,
    "book": "job                                     ",
    "chapter": "16",
    "verse": "2",
    "text": "“ऐसी बहुत सी बातें मैं सुन चुका हूँ,"
  },
  {
    "id": 13242,
    "book": "job                                     ",
    "chapter": "16",
    "verse": "3",
    "text": "क्या व्यर्थ बातों का अन्त कभी होगा?"
  },
  {
    "id": 13243,
    "book": "job                                     ",
    "chapter": "16",
    "verse": "4",
    "text": "यदि तुम्हारी दशा मेरी सी होती,"
  },
  {
    "id": 13244,
    "book": "job                                     ",
    "chapter": "16",
    "verse": "5",
    "text": "वरन् मैं अपने वचनों से तुम को हियाव दिलाता,"
  },
  {
    "id": 13245,
    "book": "job                                     ",
    "chapter": "16",
    "verse": "6",
    "text": "“चाहे मैं बोलूँ तो भी मेरा शोक न घटेगा,"
  },
  {
    "id": 13246,
    "book": "job                                     ",
    "chapter": "16",
    "verse": "7",
    "text": "परन्तु अब उसने मुझे थका दिया है16:7 उसने मुझे थका दिया है: अर्थात् परमेश्वर ने मुझे अशक्त बना दिया है वह विपत्तियों से आरम्भ करता है जिन्हें परमेश्वर ने उस पर डाली।;"
  },
  {
    "id": 13247,
    "book": "job                                     ",
    "chapter": "16",
    "verse": "8",
    "text": "और उसने जो मेरे शरीर को सूखा डाला है, वह मेरे विरुद्ध साक्षी ठहरा है,"
  },
  {
    "id": 13248,
    "book": "job                                     ",
    "chapter": "16",
    "verse": "9",
    "text": "उसने क्रोध में आकर मुझ को फाड़ा और मेरे पीछे पड़ा है;"
  },
  {
    "id": 13249,
    "book": "job                                     ",
    "chapter": "16",
    "verse": "10",
    "text": "अब लोग मुझ पर मुँह पसारते हैं,"
  },
  {
    "id": 13250,
    "book": "job                                     ",
    "chapter": "16",
    "verse": "11",
    "text": "परमेश्वर ने मुझे कुटिलों के वश में कर दिया,"
  },
  {
    "id": 13251,
    "book": "job                                     ",
    "chapter": "16",
    "verse": "12",
    "text": "मैं सुख से रहता था, और उसने मुझे चूर चूरकर डाला;"
  },
  {
    "id": 13252,
    "book": "job                                     ",
    "chapter": "16",
    "verse": "13",
    "text": "उसके तीर मेरे चारों ओर उड़ रहे हैं,"
  },
  {
    "id": 13253,
    "book": "job                                     ",
    "chapter": "16",
    "verse": "14",
    "text": "वह शूर के समान मुझ पर धावा करके मुझे"
  },
  {
    "id": 13254,
    "book": "job                                     ",
    "chapter": "16",
    "verse": "15",
    "text": "मैंने अपनी खाल पर टाट को सी लिया है,"
  },
  {
    "id": 13255,
    "book": "job                                     ",
    "chapter": "16",
    "verse": "16",
    "text": "रोते-रोते मेरा मुँह सूज गया है,"
  },
  {
    "id": 13256,
    "book": "job                                     ",
    "chapter": "16",
    "verse": "17",
    "text": "तो भी मुझसे कोई उपद्रव नहीं हुआ है,"
  },
  {
    "id": 13257,
    "book": "job                                     ",
    "chapter": "16",
    "verse": "18",
    "text": "“हे पृथ्वी, तू मेरे लहू को न ढाँपना,"
  },
  {
    "id": 13258,
    "book": "job                                     ",
    "chapter": "16",
    "verse": "19",
    "text": "अब भी स्वर्ग में मेरा साक्षी है16:19 स्वर्ग में मेरा साक्षी है: अर्थात् मैं अपनी सत्यनिष्ठा के लिए परमेश्वर को पुकार सकता हूँ। वह मेरा गवाह है और मेरा लेखा रखेगा। ,"
  },
  {
    "id": 13259,
    "book": "job                                     ",
    "chapter": "16",
    "verse": "20",
    "text": "मेरे मित्र मुझसे घृणा करते हैं,"
  },
  {
    "id": 13260,
    "book": "job                                     ",
    "chapter": "16",
    "verse": "21",
    "text": "कि कोई परमेश्वर के सामने सज्जन का,"
  },
  {
    "id": 13261,
    "book": "job                                     ",
    "chapter": "16",
    "verse": "22",
    "text": "क्योंकि थोड़े ही वर्षों के बीतने पर मैं उस मार्ग"
  }
]
