[
  {
    "id": 13205,
    "book": "job                                     ",
    "chapter": "15",
    "verse": "1",
    "text": "तब तेमानी एलीपज ने कहा"
  },
  {
    "id": 13206,
    "book": "job                                     ",
    "chapter": "15",
    "verse": "2",
    "text": "“क्या बुद्धिमान को उचित है कि अज्ञानता के साथ उत्तर दे,"
  },
  {
    "id": 13207,
    "book": "job                                     ",
    "chapter": "15",
    "verse": "3",
    "text": "क्या वह निष्फल वचनों से,"
  },
  {
    "id": 13208,
    "book": "job                                     ",
    "chapter": "15",
    "verse": "4",
    "text": "वरन् तू परमेश्वर का भय मानना छोड़ देता,"
  },
  {
    "id": 13209,
    "book": "job                                     ",
    "chapter": "15",
    "verse": "5",
    "text": "तू अपने मुँह से अपना अधर्म प्रगट करता है,"
  },
  {
    "id": 13210,
    "book": "job                                     ",
    "chapter": "15",
    "verse": "6",
    "text": "मैं तो नहीं परन्तु तेरा मुँह ही तुझे दोषी ठहराता है;"
  },
  {
    "id": 13211,
    "book": "job                                     ",
    "chapter": "15",
    "verse": "7",
    "text": "“क्या पहला मनुष्य तू ही उत्पन्न हुआ?"
  },
  {
    "id": 13212,
    "book": "job                                     ",
    "chapter": "15",
    "verse": "8",
    "text": "क्या तू परमेश्वर की सभा में बैठा सुनता था?"
  },
  {
    "id": 13213,
    "book": "job                                     ",
    "chapter": "15",
    "verse": "9",
    "text": "तू ऐसा क्या जानता है जिसे हम नहीं जानते?"
  },
  {
    "id": 13214,
    "book": "job                                     ",
    "chapter": "15",
    "verse": "10",
    "text": "हम लोगों में तो पक्के बाल वाले और अति पुरनिये मनुष्य हैं,"
  },
  {
    "id": 13215,
    "book": "job                                     ",
    "chapter": "15",
    "verse": "11",
    "text": "परमेश्वर की शान्तिदायक बातें,"
  },
  {
    "id": 13216,
    "book": "job                                     ",
    "chapter": "15",
    "verse": "12",
    "text": "तेरा मन क्यों तुझे खींच ले जाता है?"
  },
  {
    "id": 13217,
    "book": "job                                     ",
    "chapter": "15",
    "verse": "13",
    "text": "तू भी अपनी आत्मा परमेश्वर के विरुद्ध करता है,"
  },
  {
    "id": 13218,
    "book": "job                                     ",
    "chapter": "15",
    "verse": "14",
    "text": "मनुष्य है क्या कि वह निष्कलंक हो?"
  },
  {
    "id": 13219,
    "book": "job                                     ",
    "chapter": "15",
    "verse": "15",
    "text": "देख, वह अपने पवित्रों पर भी विश्वास नहीं करता,"
  },
  {
    "id": 13220,
    "book": "job                                     ",
    "chapter": "15",
    "verse": "16",
    "text": "फिर मनुष्य अधिक घिनौना और भ्रष्ट है जो"
  },
  {
    "id": 13221,
    "book": "job                                     ",
    "chapter": "15",
    "verse": "17",
    "text": "“मैं तुझे समझा दूँगा, इसलिए मेरी सुन ले,"
  },
  {
    "id": 13222,
    "book": "job                                     ",
    "chapter": "15",
    "verse": "18",
    "text": "(वे ही बातें जो बुद्धिमानों ने अपने पुरखाओं से सुनकर"
  },
  {
    "id": 13223,
    "book": "job                                     ",
    "chapter": "15",
    "verse": "19",
    "text": "केवल उन्हीं को देश दिया गया था,"
  },
  {
    "id": 13224,
    "book": "job                                     ",
    "chapter": "15",
    "verse": "20",
    "text": "दुष्ट जन जीवन भर पीड़ा से तड़पता है, और"
  },
  {
    "id": 13225,
    "book": "job                                     ",
    "chapter": "15",
    "verse": "21",
    "text": "उसके कान में डरावना शब्द गूँजता रहता है,"
  },
  {
    "id": 13226,
    "book": "job                                     ",
    "chapter": "15",
    "verse": "22",
    "text": "उसे अंधियारे में से फिर निकलने की कुछ आशा नहीं होती,"
  },
  {
    "id": 13227,
    "book": "job                                     ",
    "chapter": "15",
    "verse": "23",
    "text": "वह रोटी के लिये मारा-मारा फिरता है, कि कहाँ मिलेगी?"
  },
  {
    "id": 13228,
    "book": "job                                     ",
    "chapter": "15",
    "verse": "24",
    "text": "संकट और दुर्घटना से उसको डर लगता रहता है,"
  },
  {
    "id": 13229,
    "book": "job                                     ",
    "chapter": "15",
    "verse": "25",
    "text": "क्योंकि उसने तो परमेश्वर के विरुद्ध हाथ बढ़ाया है,"
  },
  {
    "id": 13230,
    "book": "job                                     ",
    "chapter": "15",
    "verse": "26",
    "text": "और सिर उठाकर और अपनी मोटी-मोटी"
  },
  {
    "id": 13231,
    "book": "job                                     ",
    "chapter": "15",
    "verse": "27",
    "text": "इसलिए कि उसके मुँह पर चिकनाई छा गई है,"
  },
  {
    "id": 13232,
    "book": "job                                     ",
    "chapter": "15",
    "verse": "28",
    "text": "और वह उजाड़े हुए नगरों में बस गया है,"
  },
  {
    "id": 13233,
    "book": "job                                     ",
    "chapter": "15",
    "verse": "29",
    "text": "वह धनी न रहेगा, और न उसकी सम्पत्ति बनी रहेगी,"
  },
  {
    "id": 13234,
    "book": "job                                     ",
    "chapter": "15",
    "verse": "30",
    "text": "वह अंधियारे से कभी न निकलेगा,"
  },
  {
    "id": 13235,
    "book": "job                                     ",
    "chapter": "15",
    "verse": "31",
    "text": "वह अपने को धोखा देकर व्यर्थ बातों का भरोसा न करे,"
  },
  {
    "id": 13236,
    "book": "job                                     ",
    "chapter": "15",
    "verse": "32",
    "text": "वह उसके नियत दिन से पहले पूरा हो जाएगा;"
  },
  {
    "id": 13237,
    "book": "job                                     ",
    "chapter": "15",
    "verse": "33",
    "text": "दाख के समान उसके कच्चे फल झड़ जाएँगे,"
  },
  {
    "id": 13238,
    "book": "job                                     ",
    "chapter": "15",
    "verse": "34",
    "text": "क्योंकि भक्तिहीन के परिवार से कुछ बन न पड़ेगा,"
  },
  {
    "id": 13239,
    "book": "job                                     ",
    "chapter": "15",
    "verse": "35",
    "text": "उनको उपद्रव का गर्भ रहता, और वे अनर्थ को जन्म देते है15:35 उनको उपद्रव का गर्भ रहता, और वे अनर्थ को जन्म देते है: इस पद का अर्थ है कि वे बुराई की योजना रचते हैं और उसे कार्यान्वित करते हैं।"
  }
]
