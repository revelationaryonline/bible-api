[
  {
    "id": 13795,
    "book": "job                                     ",
    "chapter": "38",
    "verse": "1",
    "text": "तब यहोवा ने अय्यूब को आँधी में से यूँ उत्तर दिया38:1 तब यहोवा ने अय्यूब को आँधी में से यूँ उत्तर दिया: यह विशेष करके अय्यूब के लिए है, इसलिए नहीं कि वह इस पुस्तक का मुख्य नायक है परन्तु इसलिए कि वह कुड़कुड़ा रहा है और शिकायत कर रहा है।,"
  },
  {
    "id": 13796,
    "book": "job                                     ",
    "chapter": "38",
    "verse": "2",
    "text": "“यह कौन है जो अज्ञानता की बातें कहकर"
  },
  {
    "id": 13797,
    "book": "job                                     ",
    "chapter": "38",
    "verse": "3",
    "text": "पुरुष के समान अपनी कमर बाँध ले,"
  },
  {
    "id": 13798,
    "book": "job                                     ",
    "chapter": "38",
    "verse": "4",
    "text": "“जब मैंने पृथ्वी की नींव डाली, तब तू कहाँ था?"
  },
  {
    "id": 13799,
    "book": "job                                     ",
    "chapter": "38",
    "verse": "5",
    "text": "उसकी नाप किसने ठहराई, क्या तू जानता है"
  },
  {
    "id": 13800,
    "book": "job                                     ",
    "chapter": "38",
    "verse": "6",
    "text": "उसकी नींव कौन सी वस्तु पर रखी गई,"
  },
  {
    "id": 13801,
    "book": "job                                     ",
    "chapter": "38",
    "verse": "7",
    "text": "जबकि भोर के तारे एक संग आनन्द से गाते थे"
  },
  {
    "id": 13802,
    "book": "job                                     ",
    "chapter": "38",
    "verse": "8",
    "text": "“फिर जब समुद्र ऐसा फूट निकला मानो वह गर्भ से फूट निकला,"
  },
  {
    "id": 13803,
    "book": "job                                     ",
    "chapter": "38",
    "verse": "9",
    "text": "जबकि मैंने उसको बादल पहनाया"
  },
  {
    "id": 13804,
    "book": "job                                     ",
    "chapter": "38",
    "verse": "10",
    "text": "और उसके लिये सीमा बाँधा"
  },
  {
    "id": 13805,
    "book": "job                                     ",
    "chapter": "38",
    "verse": "11",
    "text": "‘यहीं तक आ, और आगे न बढ़,"
  },
  {
    "id": 13806,
    "book": "job                                     ",
    "chapter": "38",
    "verse": "12",
    "text": "“क्या तूने जीवन भर में कभी भोर को आज्ञा दी,"
  },
  {
    "id": 13807,
    "book": "job                                     ",
    "chapter": "38",
    "verse": "13",
    "text": "ताकि वह पृथ्वी की छोरों को वश में करे,"
  },
  {
    "id": 13808,
    "book": "job                                     ",
    "chapter": "38",
    "verse": "14",
    "text": "वह ऐसा बदलता है जैसा मोहर के नीचे चिकनी मिट्टी बदलती है,"
  },
  {
    "id": 13809,
    "book": "job                                     ",
    "chapter": "38",
    "verse": "15",
    "text": "दुष्टों से उनका उजियाला रोक लिया जाता है,"
  },
  {
    "id": 13810,
    "book": "job                                     ",
    "chapter": "38",
    "verse": "16",
    "text": "“क्या तू कभी समुद्र के सोतों तक पहुँचा है,"
  },
  {
    "id": 13811,
    "book": "job                                     ",
    "chapter": "38",
    "verse": "17",
    "text": "क्या मृत्यु के फाटक तुझ पर प्रगट हुए38:17 क्या मृत्यु के फाटक तुझ पर प्रगट हुए: अर्थात् भूलोक के वे फाटक जहाँ मृत्यु का राज है या मृत्युलोक में खुलनेवाले फाटक।,"
  },
  {
    "id": 13812,
    "book": "job                                     ",
    "chapter": "38",
    "verse": "18",
    "text": "क्या तूने पृथ्वी की चौड़ाई को पूरी रीति से समझ लिया है?"
  },
  {
    "id": 13813,
    "book": "job                                     ",
    "chapter": "38",
    "verse": "19",
    "text": "“उजियाले के निवास का मार्ग कहाँ है,"
  },
  {
    "id": 13814,
    "book": "job                                     ",
    "chapter": "38",
    "verse": "20",
    "text": "क्या तू उसे उसकी सीमा तक हटा सकता है,"
  },
  {
    "id": 13815,
    "book": "job                                     ",
    "chapter": "38",
    "verse": "21",
    "text": "निःसन्देह तू यह सब कुछ जानता होगा! क्योंकि तू तो उस समय उत्पन्न हुआ था,"
  },
  {
    "id": 13816,
    "book": "job                                     ",
    "chapter": "38",
    "verse": "22",
    "text": "फिर क्या तू कभी हिम के भण्डार में पैठा,"
  },
  {
    "id": 13817,
    "book": "job                                     ",
    "chapter": "38",
    "verse": "23",
    "text": "जिसको मैंने संकट के समय और युद्ध"
  },
  {
    "id": 13818,
    "book": "job                                     ",
    "chapter": "38",
    "verse": "24",
    "text": "किस मार्ग से उजियाला फैलाया जाता है,"
  },
  {
    "id": 13819,
    "book": "job                                     ",
    "chapter": "38",
    "verse": "25",
    "text": "“महावृष्टि के लिये किसने नाला काटा,"
  },
  {
    "id": 13820,
    "book": "job                                     ",
    "chapter": "38",
    "verse": "26",
    "text": "कि निर्जन देश में और जंगल में जहाँ कोई मनुष्य नहीं रहता मेंह बरसाकर,"
  },
  {
    "id": 13821,
    "book": "job                                     ",
    "chapter": "38",
    "verse": "27",
    "text": "उजाड़ ही उजाड़ देश को सींचे, और हरी घास उगाए?"
  },
  {
    "id": 13822,
    "book": "job                                     ",
    "chapter": "38",
    "verse": "28",
    "text": "क्या मेंह का कोई पिता है,"
  },
  {
    "id": 13823,
    "book": "job                                     ",
    "chapter": "38",
    "verse": "29",
    "text": "किसके गर्भ से बर्फ निकला है,"
  },
  {
    "id": 13824,
    "book": "job                                     ",
    "chapter": "38",
    "verse": "30",
    "text": "जल पत्थर के समान जम जाता है,"
  },
  {
    "id": 13825,
    "book": "job                                     ",
    "chapter": "38",
    "verse": "31",
    "text": "“क्या तू कचपचिया का गुच्छा गूँथ सकता"
  },
  {
    "id": 13826,
    "book": "job                                     ",
    "chapter": "38",
    "verse": "32",
    "text": "क्या तू राशियों को ठीक-ठीक समय पर उदय कर सकता,"
  },
  {
    "id": 13827,
    "book": "job                                     ",
    "chapter": "38",
    "verse": "33",
    "text": "क्या तू आकाशमण्डल की विधियाँ जानता"
  },
  {
    "id": 13828,
    "book": "job                                     ",
    "chapter": "38",
    "verse": "34",
    "text": "क्या तू बादलों तक अपनी वाणी पहुँचा सकता है,"
  },
  {
    "id": 13829,
    "book": "job                                     ",
    "chapter": "38",
    "verse": "35",
    "text": "क्या तू बिजली को आज्ञा दे सकता है, कि वह जाए,"
  },
  {
    "id": 13830,
    "book": "job                                     ",
    "chapter": "38",
    "verse": "36",
    "text": "किसने अन्तःकरण में बुद्धि उपजाई,"
  },
  {
    "id": 13831,
    "book": "job                                     ",
    "chapter": "38",
    "verse": "37",
    "text": "कौन बुद्धि से बादलों को गिन सकता है?"
  },
  {
    "id": 13832,
    "book": "job                                     ",
    "chapter": "38",
    "verse": "38",
    "text": "जब धूलि जम जाती है,"
  },
  {
    "id": 13833,
    "book": "job                                     ",
    "chapter": "38",
    "verse": "39",
    "text": "“क्या तू सिंहनी के लिये अहेर पकड़ सकता,"
  },
  {
    "id": 13834,
    "book": "job                                     ",
    "chapter": "38",
    "verse": "40",
    "text": "जब वे माँद में बैठे हों"
  },
  {
    "id": 13835,
    "book": "job                                     ",
    "chapter": "38",
    "verse": "41",
    "text": "फिर जब कौवे के बच्चे परमेश्वर की दुहाई देते हुए निराहार उड़ते फिरते हैं,"
  }
]
