[
  {
    "id": 13328,
    "book": "job                                     ",
    "chapter": "20",
    "verse": "1",
    "text": "तब नामाती सोपर ने कहा,"
  },
  {
    "id": 13329,
    "book": "job                                     ",
    "chapter": "20",
    "verse": "2",
    "text": "“मेरा जी चाहता है कि उत्तर दूँ,"
  },
  {
    "id": 13330,
    "book": "job                                     ",
    "chapter": "20",
    "verse": "3",
    "text": "मैंने ऐसी डाँट सुनी जिससे मेरी निन्दा हुई,"
  },
  {
    "id": 13331,
    "book": "job                                     ",
    "chapter": "20",
    "verse": "4",
    "text": "क्या तू यह नियम नहीं जानता जो प्राचीन"
  },
  {
    "id": 13332,
    "book": "job                                     ",
    "chapter": "20",
    "verse": "5",
    "text": "दुष्टों की विजय क्षण भर का होता है,"
  },
  {
    "id": 13333,
    "book": "job                                     ",
    "chapter": "20",
    "verse": "6",
    "text": "चाहे ऐसे मनुष्य का माहात्म्य आकाश तक पहुँच जाए,"
  },
  {
    "id": 13334,
    "book": "job                                     ",
    "chapter": "20",
    "verse": "7",
    "text": "तो भी वह अपनी विष्ठा के समान सदा के लिये नाश हो जाएगा;"
  },
  {
    "id": 13335,
    "book": "job                                     ",
    "chapter": "20",
    "verse": "8",
    "text": "वह स्वप्न के समान लोप हो जाएगा और किसी को फिर न मिलेगा;"
  },
  {
    "id": 13336,
    "book": "job                                     ",
    "chapter": "20",
    "verse": "9",
    "text": "जिसने उसको देखा हो फिर उसे न देखेगा,"
  },
  {
    "id": 13337,
    "book": "job                                     ",
    "chapter": "20",
    "verse": "10",
    "text": "उसके बच्चे कंगालों से भी विनती करेंगे,"
  },
  {
    "id": 13338,
    "book": "job                                     ",
    "chapter": "20",
    "verse": "11",
    "text": "उसकी हड्डियों में जवानी का बल भरा हुआ है"
  },
  {
    "id": 13339,
    "book": "job                                     ",
    "chapter": "20",
    "verse": "12",
    "text": "“चाहे बुराई उसको मीठी लगे20:12 चाहे बुराई उसको मीठी लगे: इस पद का और अग्रिम पदों का अर्थ है कि यद्यपि मनुष्य को पाप करने में आनन्द प्राप्त होता है, उसका परिणाम कड़वा होता है। ,"
  },
  {
    "id": 13340,
    "book": "job                                     ",
    "chapter": "20",
    "verse": "13",
    "text": "और वह उसे बचा रखे और न छोड़े,"
  },
  {
    "id": 13341,
    "book": "job                                     ",
    "chapter": "20",
    "verse": "14",
    "text": "तो भी उसका भोजन उसके पेट में पलटेगा,"
  },
  {
    "id": 13342,
    "book": "job                                     ",
    "chapter": "20",
    "verse": "15",
    "text": "उसने जो धन निगल लिया है उसे वह फिर उगल देगा;"
  },
  {
    "id": 13343,
    "book": "job                                     ",
    "chapter": "20",
    "verse": "16",
    "text": "वह नागों का विष चूस लेगा,"
  },
  {
    "id": 13344,
    "book": "job                                     ",
    "chapter": "20",
    "verse": "17",
    "text": "वह नदियों अर्थात् मधु"
  },
  {
    "id": 13345,
    "book": "job                                     ",
    "chapter": "20",
    "verse": "18",
    "text": "जिसके लिये उसने परिश्रम किया,"
  },
  {
    "id": 13346,
    "book": "job                                     ",
    "chapter": "20",
    "verse": "19",
    "text": "क्योंकि उसने कंगालों को पीसकर छोड़ दिया,"
  },
  {
    "id": 13347,
    "book": "job                                     ",
    "chapter": "20",
    "verse": "20",
    "text": "“लालसा के मारे उसको कभी शान्ति नहीं मिलती थी,"
  },
  {
    "id": 13348,
    "book": "job                                     ",
    "chapter": "20",
    "verse": "21",
    "text": "कोई वस्तु उसका कौर बिना हुए न बचती थी;"
  },
  {
    "id": 13349,
    "book": "job                                     ",
    "chapter": "20",
    "verse": "22",
    "text": "पूरी सम्पत्ति रहते भी वह सकेती में पड़ेगा;"
  },
  {
    "id": 13350,
    "book": "job                                     ",
    "chapter": "20",
    "verse": "23",
    "text": "ऐसा होगा, कि उसका पेट भरने पर होगा,"
  },
  {
    "id": 13351,
    "book": "job                                     ",
    "chapter": "20",
    "verse": "24",
    "text": "वह लोहे के हथियार से भागेगा,"
  },
  {
    "id": 13352,
    "book": "job                                     ",
    "chapter": "20",
    "verse": "25",
    "text": "वह उस तीर को खींचकर अपने पेट से निकालेगा,"
  },
  {
    "id": 13353,
    "book": "job                                     ",
    "chapter": "20",
    "verse": "26",
    "text": "उसके गड़े हुए धन पर घोर अंधकार छा जाएगा।"
  },
  {
    "id": 13354,
    "book": "job                                     ",
    "chapter": "20",
    "verse": "27",
    "text": "आकाश उसका अधर्म प्रगट करेगा,"
  },
  {
    "id": 13355,
    "book": "job                                     ",
    "chapter": "20",
    "verse": "28",
    "text": "उसके घर की बढ़ती जाती रहेगी,"
  },
  {
    "id": 13356,
    "book": "job                                     ",
    "chapter": "20",
    "verse": "29",
    "text": "परमेश्वर की ओर से दुष्ट मनुष्य का अंश,"
  }
]
