[
  {
    "id": 13685,
    "book": "job                                     ",
    "chapter": "34",
    "verse": "1",
    "text": "फिर एलीहू यह कहता गया;"
  },
  {
    "id": 13686,
    "book": "job                                     ",
    "chapter": "34",
    "verse": "2",
    "text": "“हे बुद्धिमानों! मेरी बातें सुनो,"
  },
  {
    "id": 13687,
    "book": "job                                     ",
    "chapter": "34",
    "verse": "3",
    "text": "क्योंकि जैसे जीभ से चखा जाता है,"
  },
  {
    "id": 13688,
    "book": "job                                     ",
    "chapter": "34",
    "verse": "4",
    "text": "जो कुछ ठीक है, हम अपने लिये चुन लें;"
  },
  {
    "id": 13689,
    "book": "job                                     ",
    "chapter": "34",
    "verse": "5",
    "text": "क्योंकि अय्यूब ने कहा है, ‘मैं निर्दोष हूँ,"
  },
  {
    "id": 13690,
    "book": "job                                     ",
    "chapter": "34",
    "verse": "6",
    "text": "यद्यपि मैं सच्चाई पर हूँ, तो भी झूठा ठहरता हूँ,"
  },
  {
    "id": 13691,
    "book": "job                                     ",
    "chapter": "34",
    "verse": "7",
    "text": "अय्यूब के तुल्य कौन शूरवीर है,"
  },
  {
    "id": 13692,
    "book": "job                                     ",
    "chapter": "34",
    "verse": "8",
    "text": "जो अनर्थ करनेवालों का साथ देता,"
  },
  {
    "id": 13693,
    "book": "job                                     ",
    "chapter": "34",
    "verse": "9",
    "text": "उसने तो कहा है, ‘मनुष्य को इससे कुछ लाभ नहीं"
  },
  {
    "id": 13694,
    "book": "job                                     ",
    "chapter": "34",
    "verse": "10",
    "text": "“इसलिए हे समझवालों! मेरी सुनो,"
  },
  {
    "id": 13695,
    "book": "job                                     ",
    "chapter": "34",
    "verse": "11",
    "text": "वह मनुष्य की करनी का फल देता है,"
  },
  {
    "id": 13696,
    "book": "job                                     ",
    "chapter": "34",
    "verse": "12",
    "text": "निःसन्देह परमेश्वर दुष्टता नहीं करता34:12 निःसन्देह परमेश्वर दुष्टता नहीं करता: अय्यूब से एलीहू की शिकायत का आधार था कि वह अपने सिद्धान्तों पर दृढ़ नहीं रहा अपने कष्टों के कारण विवश होकर उसने ऐसी बातें कह दीं जिनका अर्थ है कि परमेश्वर अनर्थ करता है।"
  },
  {
    "id": 13697,
    "book": "job                                     ",
    "chapter": "34",
    "verse": "13",
    "text": "किसने पृथ्वी को उसके हाथ में सौंप दिया?"
  },
  {
    "id": 13698,
    "book": "job                                     ",
    "chapter": "34",
    "verse": "14",
    "text": "यदि वह मनुष्य से अपना मन हटाए"
  },
  {
    "id": 13699,
    "book": "job                                     ",
    "chapter": "34",
    "verse": "15",
    "text": "तो सब देहधारी एक संग नाश हो जाएँगे,"
  },
  {
    "id": 13700,
    "book": "job                                     ",
    "chapter": "34",
    "verse": "16",
    "text": "“इसलिए इसको सुनकर समझ रख,"
  },
  {
    "id": 13701,
    "book": "job                                     ",
    "chapter": "34",
    "verse": "17",
    "text": "जो न्याय का बैरी हो, क्या वह शासन करे?34:17 जो न्याय का बैरी हो, क्या वह शासन करे?: इस प्रश्न का अभिप्रेत अर्थ है कि जो अन्यायी है वह ब्रह्मांड का संचालन कैसे कर सकता है।"
  },
  {
    "id": 13702,
    "book": "job                                     ",
    "chapter": "34",
    "verse": "18",
    "text": "वह राजा से कहता है, ‘तू नीच है’;"
  },
  {
    "id": 13703,
    "book": "job                                     ",
    "chapter": "34",
    "verse": "19",
    "text": "परमेश्वर तो हाकिमों का पक्ष नहीं करता"
  },
  {
    "id": 13704,
    "book": "job                                     ",
    "chapter": "34",
    "verse": "20",
    "text": "आधी रात को पल भर में वे मर जाते हैं,"
  },
  {
    "id": 13705,
    "book": "job                                     ",
    "chapter": "34",
    "verse": "21",
    "text": "“क्योंकि परमेश्वर की आँखें मनुष्य की चाल चलन पर लगी रहती हैं,"
  },
  {
    "id": 13706,
    "book": "job                                     ",
    "chapter": "34",
    "verse": "22",
    "text": "ऐसा अंधियारा या घोर अंधकार कहीं नहीं है"
  },
  {
    "id": 13707,
    "book": "job                                     ",
    "chapter": "34",
    "verse": "23",
    "text": "क्योंकि उसने मनुष्य का कुछ समय नहीं ठहराया"
  },
  {
    "id": 13708,
    "book": "job                                     ",
    "chapter": "34",
    "verse": "24",
    "text": "वह बड़े-बड़े बलवानों को बिना पूछपाछ के चूर-चूर करता है,"
  },
  {
    "id": 13709,
    "book": "job                                     ",
    "chapter": "34",
    "verse": "25",
    "text": "इसलिए कि वह उनके कामों को भली भाँति जानता है,"
  },
  {
    "id": 13710,
    "book": "job                                     ",
    "chapter": "34",
    "verse": "26",
    "text": "वह उन्हें दुष्ट जानकर सभी के देखते मारता है,"
  },
  {
    "id": 13711,
    "book": "job                                     ",
    "chapter": "34",
    "verse": "27",
    "text": "क्योंकि उन्होंने उसके पीछे चलना छोड़ दिया है,"
  },
  {
    "id": 13712,
    "book": "job                                     ",
    "chapter": "34",
    "verse": "28",
    "text": "यहाँ तक कि उनके कारण कंगालों की दुहाई उस तक पहुँची"
  },
  {
    "id": 13713,
    "book": "job                                     ",
    "chapter": "34",
    "verse": "29",
    "text": "जब वह चुप रहता है तो उसे कौन दोषी ठहरा सकता है?"
  },
  {
    "id": 13714,
    "book": "job                                     ",
    "chapter": "34",
    "verse": "30",
    "text": "ताकि भक्तिहीन राज्य करता न रहे,"
  },
  {
    "id": 13715,
    "book": "job                                     ",
    "chapter": "34",
    "verse": "31",
    "text": "“क्या किसी ने कभी परमेश्वर से कहा,"
  },
  {
    "id": 13716,
    "book": "job                                     ",
    "chapter": "34",
    "verse": "32",
    "text": "जो कुछ मुझे नहीं सूझ पड़ता, वह तू मुझे सिखा दे;"
  },
  {
    "id": 13717,
    "book": "job                                     ",
    "chapter": "34",
    "verse": "33",
    "text": "क्या वह तेरे ही मन के अनुसार बदला पाए क्योंकि तू उससे अप्रसन्न है?"
  },
  {
    "id": 13718,
    "book": "job                                     ",
    "chapter": "34",
    "verse": "34",
    "text": "सब ज्ञानी पुरुष"
  },
  {
    "id": 13719,
    "book": "job                                     ",
    "chapter": "34",
    "verse": "35",
    "text": "‘अय्यूब ज्ञान की बातें नहीं कहता,"
  },
  {
    "id": 13720,
    "book": "job                                     ",
    "chapter": "34",
    "verse": "36",
    "text": "भला होता, कि अय्यूब अन्त तक परीक्षा में रहता,"
  },
  {
    "id": 13721,
    "book": "job                                     ",
    "chapter": "34",
    "verse": "37",
    "text": "और वह अपने पाप में विरोध बढ़ाता है;"
  }
]
