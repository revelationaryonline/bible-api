[
  {
    "id": 13771,
    "book": "job                                     ",
    "chapter": "37",
    "verse": "1",
    "text": "“फिर इस बात पर भी मेरा हृदय काँपता है,"
  },
  {
    "id": 13772,
    "book": "job                                     ",
    "chapter": "37",
    "verse": "2",
    "text": "उसके बोलने का शब्द तो सुनो,"
  },
  {
    "id": 13773,
    "book": "job                                     ",
    "chapter": "37",
    "verse": "3",
    "text": "वह उसको सारे आकाश के तले,"
  },
  {
    "id": 13774,
    "book": "job                                     ",
    "chapter": "37",
    "verse": "4",
    "text": "उसके पीछे गरजने का शब्द होता है;"
  },
  {
    "id": 13775,
    "book": "job                                     ",
    "chapter": "37",
    "verse": "5",
    "text": "परमेश्वर गरजकर अपना शब्द अद्भुत रीति से सुनाता है37:5 परमेश्वर गरजकर अपना शब्द अद्भुत रीति से सुनाता है: उसकी गर्जन विस्मय उत्पन्न करती है। कहने का अर्थ है कि उसकी गर्जन उसके वैभव और सामर्थ्य का अद्भुत प्रदर्शन है। ,"
  },
  {
    "id": 13776,
    "book": "job                                     ",
    "chapter": "37",
    "verse": "6",
    "text": "वह तो हिम से कहता है, पृथ्वी पर गिर,"
  },
  {
    "id": 13777,
    "book": "job                                     ",
    "chapter": "37",
    "verse": "7",
    "text": "वह सब मनुष्यों के हाथ पर मुहर कर देता है,"
  },
  {
    "id": 13778,
    "book": "job                                     ",
    "chapter": "37",
    "verse": "8",
    "text": "तब वन पशु गुफाओं में घुस जाते,"
  },
  {
    "id": 13779,
    "book": "job                                     ",
    "chapter": "37",
    "verse": "9",
    "text": "दक्षिण दिशा से बवण्डर"
  },
  {
    "id": 13780,
    "book": "job                                     ",
    "chapter": "37",
    "verse": "10",
    "text": "परमेश्वर की श्वास की फूँक से बर्फ पड़ता है,"
  },
  {
    "id": 13781,
    "book": "job                                     ",
    "chapter": "37",
    "verse": "11",
    "text": "फिर वह घटाओं को भाप से लादता,"
  },
  {
    "id": 13782,
    "book": "job                                     ",
    "chapter": "37",
    "verse": "12",
    "text": "वे उसकी बुद्धि की युक्ति से इधर-उधर फिराए जाते हैं,"
  },
  {
    "id": 13783,
    "book": "job                                     ",
    "chapter": "37",
    "verse": "13",
    "text": "चाहे ताड़ना देने के लिये, चाहे अपनी पृथ्वी की भलाई के लिये"
  },
  {
    "id": 13784,
    "book": "job                                     ",
    "chapter": "37",
    "verse": "14",
    "text": "“हे अय्यूब! इस पर कान लगा और सुन ले; चुपचाप खड़ा रह,"
  },
  {
    "id": 13785,
    "book": "job                                     ",
    "chapter": "37",
    "verse": "15",
    "text": "क्या तू जानता है, कि परमेश्वर क्यों अपने बादलों को आज्ञा देता,"
  },
  {
    "id": 13786,
    "book": "job                                     ",
    "chapter": "37",
    "verse": "16",
    "text": "क्या तू घटाओं का तौलना,"
  },
  {
    "id": 13787,
    "book": "job                                     ",
    "chapter": "37",
    "verse": "17",
    "text": "जब पृथ्वी पर दक्षिणी हवा ही के कारण से सन्नाटा रहता है"
  },
  {
    "id": 13788,
    "book": "job                                     ",
    "chapter": "37",
    "verse": "18",
    "text": "फिर क्या तू उसके साथ आकाशमण्डल को तान सकता है,"
  },
  {
    "id": 13789,
    "book": "job                                     ",
    "chapter": "37",
    "verse": "19",
    "text": "तू हमें यह सिखा कि उससे क्या कहना चाहिये?"
  },
  {
    "id": 13790,
    "book": "job                                     ",
    "chapter": "37",
    "verse": "20",
    "text": "क्या उसको बताया जाए कि मैं बोलना चाहता हूँ?"
  },
  {
    "id": 13791,
    "book": "job                                     ",
    "chapter": "37",
    "verse": "21",
    "text": "“अभी तो आकाशमण्डल में का बड़ा प्रकाश देखा नहीं जाता"
  },
  {
    "id": 13792,
    "book": "job                                     ",
    "chapter": "37",
    "verse": "22",
    "text": "उत्तर दिशा से सुनहरी ज्योति आती है"
  },
  {
    "id": 13793,
    "book": "job                                     ",
    "chapter": "37",
    "verse": "23",
    "text": "सर्वशक्तिमान परमेश्वर जो अति सामर्थी है,"
  },
  {
    "id": 13794,
    "book": "job                                     ",
    "chapter": "37",
    "verse": "24",
    "text": "इसी कारण सज्जन उसका भय मानते हैं,"
  }
]
