[
  {
    "id": 13590,
    "book": "job                                     ",
    "chapter": "31",
    "verse": "1",
    "text": "“मैंने अपनी आँखों के विषय वाचा बाँधी है,"
  },
  {
    "id": 13591,
    "book": "job                                     ",
    "chapter": "31",
    "verse": "2",
    "text": "क्योंकि परमेश्वर स्वर्ग से कौन सा अंश"
  },
  {
    "id": 13592,
    "book": "job                                     ",
    "chapter": "31",
    "verse": "3",
    "text": "क्या वह कुटिल मनुष्यों के लिये विपत्ति"
  },
  {
    "id": 13593,
    "book": "job                                     ",
    "chapter": "31",
    "verse": "4",
    "text": "क्या वह मेरी गति नहीं देखता"
  },
  {
    "id": 13594,
    "book": "job                                     ",
    "chapter": "31",
    "verse": "5",
    "text": "यदि मैं व्यर्थ चाल चलता हूँ,"
  },
  {
    "id": 13595,
    "book": "job                                     ",
    "chapter": "31",
    "verse": "6",
    "text": "(तो मैं धर्म के तराजू में तौला जाऊँ,"
  },
  {
    "id": 13596,
    "book": "job                                     ",
    "chapter": "31",
    "verse": "7",
    "text": "यदि मेरे पग मार्ग से बहक गए हों,"
  },
  {
    "id": 13597,
    "book": "job                                     ",
    "chapter": "31",
    "verse": "8",
    "text": "तो मैं बीज बोऊँ, परन्तु दूसरा खाए;"
  },
  {
    "id": 13598,
    "book": "job                                     ",
    "chapter": "31",
    "verse": "9",
    "text": "“यदि मेरा हृदय किसी स्त्री पर मोहित हो गया है,"
  },
  {
    "id": 13599,
    "book": "job                                     ",
    "chapter": "31",
    "verse": "10",
    "text": "तो मेरी स्त्री दूसरे के लिये पीसे,"
  },
  {
    "id": 13600,
    "book": "job                                     ",
    "chapter": "31",
    "verse": "11",
    "text": "क्योंकि वह तो महापाप होता;"
  },
  {
    "id": 13601,
    "book": "job                                     ",
    "chapter": "31",
    "verse": "12",
    "text": "क्योंकि वह ऐसी आग है जो जलाकर भस्म कर देती है31:12 वह ऐसी आग है जो जलाकर भस्म कर देती है: इसका सम्भावित अर्थ है कि ऐसा कुकर्म एक अपराध है जिसके कारण परमेश्वर विनाश ढाने पर विवश होता है। ,"
  },
  {
    "id": 13602,
    "book": "job                                     ",
    "chapter": "31",
    "verse": "13",
    "text": "“जब मेरे दास व दासी ने मुझसे झगड़ा किया,"
  },
  {
    "id": 13603,
    "book": "job                                     ",
    "chapter": "31",
    "verse": "14",
    "text": "तो जब परमेश्वर उठ खड़ा होगा, तब मैं क्या करूँगा?"
  },
  {
    "id": 13604,
    "book": "job                                     ",
    "chapter": "31",
    "verse": "15",
    "text": "क्या वह उसका बनानेवाला नहीं जिसने मुझे गर्भ में बनाया?"
  },
  {
    "id": 13605,
    "book": "job                                     ",
    "chapter": "31",
    "verse": "16",
    "text": "“यदि मैंने कंगालों की इच्छा पूरी न की हो,"
  },
  {
    "id": 13606,
    "book": "job                                     ",
    "chapter": "31",
    "verse": "17",
    "text": "या मैंने अपना टुकड़ा अकेला खाया हो,"
  },
  {
    "id": 13607,
    "book": "job                                     ",
    "chapter": "31",
    "verse": "18",
    "text": "(परन्तु वह मेरे लड़कपन ही से मेरे साथ इस प्रकार पला जिस प्रकार पिता के साथ,"
  },
  {
    "id": 13608,
    "book": "job                                     ",
    "chapter": "31",
    "verse": "19",
    "text": "यदि मैंने किसी को वस्त्रहीन मरते हुए देखा,"
  },
  {
    "id": 13609,
    "book": "job                                     ",
    "chapter": "31",
    "verse": "20",
    "text": "और उसको अपनी भेड़ों की ऊन के कपड़े न दिए हों,"
  },
  {
    "id": 13610,
    "book": "job                                     ",
    "chapter": "31",
    "verse": "21",
    "text": "या यदि मैंने फाटक में अपने सहायक देखकर"
  },
  {
    "id": 13611,
    "book": "job                                     ",
    "chapter": "31",
    "verse": "22",
    "text": "तो मेरी बाँह कंधे से उखड़कर गिर पड़े,"
  },
  {
    "id": 13612,
    "book": "job                                     ",
    "chapter": "31",
    "verse": "23",
    "text": "क्योंकि परमेश्वर के प्रताप के कारण मैं ऐसा नहीं कर सकता था,"
  },
  {
    "id": 13613,
    "book": "job                                     ",
    "chapter": "31",
    "verse": "24",
    "text": "“यदि मैंने सोने का भरोसा किया होता,"
  },
  {
    "id": 13614,
    "book": "job                                     ",
    "chapter": "31",
    "verse": "25",
    "text": "या अपने बहुत से धन"
  },
  {
    "id": 13615,
    "book": "job                                     ",
    "chapter": "31",
    "verse": "26",
    "text": "या सूर्य को चमकते"
  },
  {
    "id": 13616,
    "book": "job                                     ",
    "chapter": "31",
    "verse": "27",
    "text": "मैं मन ही मन मोहित हो गया होता,"
  },
  {
    "id": 13617,
    "book": "job                                     ",
    "chapter": "31",
    "verse": "28",
    "text": "तो यह भी न्यायियों से दण्ड पाने के योग्य अधर्म का काम होता;"
  },
  {
    "id": 13618,
    "book": "job                                     ",
    "chapter": "31",
    "verse": "29",
    "text": "“यदि मैं अपने बैरी के नाश से आनन्दित होता31:29 यदि मैं अपने बैरी के नाश से आनन्दित होता: अय्यूब अब अपराधों की एक और श्रेणी की चर्चा करता है जिसमें भी वह निर्दोष है। यहाँ विषय है कि हमारी हानि करनेवालों के साथ भी अच्छा व्यवहार करें। ,"
  },
  {
    "id": 13619,
    "book": "job                                     ",
    "chapter": "31",
    "verse": "30",
    "text": "(परन्तु मैंने न तो उसको श्राप देते हुए,"
  },
  {
    "id": 13620,
    "book": "job                                     ",
    "chapter": "31",
    "verse": "31",
    "text": "यदि मेरे डेरे के रहनेवालों ने यह न कहा होता,"
  },
  {
    "id": 13621,
    "book": "job                                     ",
    "chapter": "31",
    "verse": "32",
    "text": "(परदेशी को सड़क पर टिकना न पड़ता था;"
  },
  {
    "id": 13622,
    "book": "job                                     ",
    "chapter": "31",
    "verse": "33",
    "text": "यदि मैंने आदम के समान अपना अपराध छिपाकर"
  },
  {
    "id": 13623,
    "book": "job                                     ",
    "chapter": "31",
    "verse": "34",
    "text": "इस कारण कि मैं बड़ी भीड़ से भय खाता था,"
  },
  {
    "id": 13624,
    "book": "job                                     ",
    "chapter": "31",
    "verse": "35",
    "text": "भला होता कि मेरा कोई सुननेवाला होता!"
  },
  {
    "id": 13625,
    "book": "job                                     ",
    "chapter": "31",
    "verse": "36",
    "text": "निश्चय मैं उसको अपने कंधे पर उठाए फिरता;"
  },
  {
    "id": 13626,
    "book": "job                                     ",
    "chapter": "31",
    "verse": "37",
    "text": "मैं उसको अपने पग-पग का हिसाब देता;"
  },
  {
    "id": 13627,
    "book": "job                                     ",
    "chapter": "31",
    "verse": "38",
    "text": "“यदि मेरी भूमि मेरे विरुद्ध दुहाई देती हो,"
  },
  {
    "id": 13628,
    "book": "job                                     ",
    "chapter": "31",
    "verse": "39",
    "text": "यदि मैंने अपनी भूमि की उपज बिना मजदूरी दिए खाई,"
  },
  {
    "id": 13629,
    "book": "job                                     ",
    "chapter": "31",
    "verse": "40",
    "text": "तो गेहूँ के बदले झड़बेरी,"
  }
]
