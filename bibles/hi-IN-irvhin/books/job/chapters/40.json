[
  {
    "id": 13866,
    "book": "job                                     ",
    "chapter": "40",
    "verse": "1",
    "text": "फिर यहोवा ने अय्यूब से यह भी कहा:"
  },
  {
    "id": 13867,
    "book": "job                                     ",
    "chapter": "40",
    "verse": "2",
    "text": "“क्या जो बकवास करता है वह सर्वशक्तिमान से झगड़ा करे?"
  },
  {
    "id": 13868,
    "book": "job                                     ",
    "chapter": "40",
    "verse": "3",
    "text": "तब अय्यूब ने यहोवा को उत्तर दिया:"
  },
  {
    "id": 13869,
    "book": "job                                     ",
    "chapter": "40",
    "verse": "4",
    "text": "“देख, मैं तो तुच्छ हूँ, मैं तुझे क्या उत्तर दूँ?"
  },
  {
    "id": 13870,
    "book": "job                                     ",
    "chapter": "40",
    "verse": "5",
    "text": "एक बार तो मैं कह चुका40:5 एक बार तो मैं कह चुका: स्वयं को निरपराध दर्शाने के लिए। उसने एक बार परमेश्वर के बारे में श्रद्धा रहित एवं अनुचित भाषा का उपयोग किया जिसे अब वह समझ रहा है। , परन्तु और कुछ न कहूँगा:"
  },
  {
    "id": 13871,
    "book": "job                                     ",
    "chapter": "40",
    "verse": "6",
    "text": "तब यहोवा ने अय्यूब को आँधी में से यह उत्तर दिया:"
  },
  {
    "id": 13872,
    "book": "job                                     ",
    "chapter": "40",
    "verse": "7",
    "text": "“पुरुष के समान अपनी कमर बाँध ले,"
  },
  {
    "id": 13873,
    "book": "job                                     ",
    "chapter": "40",
    "verse": "8",
    "text": "क्या तू मेरा न्याय भी व्यर्थ ठहराएगा?"
  },
  {
    "id": 13874,
    "book": "job                                     ",
    "chapter": "40",
    "verse": "9",
    "text": "क्या तेरा बाहुबल परमेश्वर के तुल्य है?40:9 क्या तेरा बाहुबल परमेश्वर के तुल्य है?: बाहुबल अर्थात् शक्ति; अय्यूब क्या अपनी शक्ति की तुलना परमेश्वर की सर्वशक्ति से करने का साहस करेगा?"
  },
  {
    "id": 13875,
    "book": "job                                     ",
    "chapter": "40",
    "verse": "10",
    "text": "“अब अपने को महिमा और प्रताप से संवार"
  },
  {
    "id": 13876,
    "book": "job                                     ",
    "chapter": "40",
    "verse": "11",
    "text": "अपने अति क्रोध की बाढ़ को बहा दे,"
  },
  {
    "id": 13877,
    "book": "job                                     ",
    "chapter": "40",
    "verse": "12",
    "text": "हर एक घमण्डी को देखकर झुका दे,"
  },
  {
    "id": 13878,
    "book": "job                                     ",
    "chapter": "40",
    "verse": "13",
    "text": "उनको एक संग मिट्टी में मिला दे,"
  },
  {
    "id": 13879,
    "book": "job                                     ",
    "chapter": "40",
    "verse": "14",
    "text": "तब मैं भी तेरे विषय में मान लूँगा,"
  },
  {
    "id": 13880,
    "book": "job                                     ",
    "chapter": "40",
    "verse": "15",
    "text": "“उस जलगज को देख, जिसको मैंने तेरे साथ बनाया है,"
  },
  {
    "id": 13881,
    "book": "job                                     ",
    "chapter": "40",
    "verse": "16",
    "text": "देख उसकी कमर में बल है,"
  },
  {
    "id": 13882,
    "book": "job                                     ",
    "chapter": "40",
    "verse": "17",
    "text": "वह अपनी पूँछ को देवदार के समान हिलाता है;"
  },
  {
    "id": 13883,
    "book": "job                                     ",
    "chapter": "40",
    "verse": "18",
    "text": "उसकी हड्डियाँ मानो पीतल की नलियाँ हैं,"
  },
  {
    "id": 13884,
    "book": "job                                     ",
    "chapter": "40",
    "verse": "19",
    "text": "“वह परमेश्वर का मुख्य कार्य है;"
  },
  {
    "id": 13885,
    "book": "job                                     ",
    "chapter": "40",
    "verse": "20",
    "text": "निश्चय पहाड़ों पर उसका चारा मिलता है,"
  },
  {
    "id": 13886,
    "book": "job                                     ",
    "chapter": "40",
    "verse": "21",
    "text": "वह कमल के पौधों के नीचे रहता नरकटों की आड़ में"
  },
  {
    "id": 13887,
    "book": "job                                     ",
    "chapter": "40",
    "verse": "22",
    "text": "कमल के पौधे उस पर छाया करते हैं,"
  },
  {
    "id": 13888,
    "book": "job                                     ",
    "chapter": "40",
    "verse": "23",
    "text": "चाहे नदी की बाढ़ भी हो तो भी वह न घबराएगा,"
  },
  {
    "id": 13889,
    "book": "job                                     ",
    "chapter": "40",
    "verse": "24",
    "text": "जब वह चौकस हो तब क्या कोई उसको पकड़ सकेगा,"
  }
]
