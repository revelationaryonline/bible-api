[
  {
    "id": 12906,
    "book": "job                                     ",
    "chapter": "3",
    "verse": "1",
    "text": "इसके बाद अय्यूब मुँह खोलकर अपने जन्मदिन को धिक्कारने"
  },
  {
    "id": 12907,
    "book": "job                                     ",
    "chapter": "3",
    "verse": "2",
    "text": "और कहने लगा,"
  },
  {
    "id": 12908,
    "book": "job                                     ",
    "chapter": "3",
    "verse": "3",
    "text": "“वह दिन नाश हो जाए जिसमें मैं उत्पन्न हुआ,"
  },
  {
    "id": 12909,
    "book": "job                                     ",
    "chapter": "3",
    "verse": "4",
    "text": "वह दिन अंधियारा हो जाए!"
  },
  {
    "id": 12910,
    "book": "job                                     ",
    "chapter": "3",
    "verse": "5",
    "text": "अंधियारा और मृत्यु की छाया उस पर रहे।"
  },
  {
    "id": 12911,
    "book": "job                                     ",
    "chapter": "3",
    "verse": "6",
    "text": "घोर अंधकार उस रात को पकड़े;"
  },
  {
    "id": 12912,
    "book": "job                                     ",
    "chapter": "3",
    "verse": "7",
    "text": "सुनो, वह रात बाँझ हो जाए;"
  },
  {
    "id": 12913,
    "book": "job                                     ",
    "chapter": "3",
    "verse": "8",
    "text": "जो लोग किसी दिन को धिक्कारते हैं,"
  },
  {
    "id": 12914,
    "book": "job                                     ",
    "chapter": "3",
    "verse": "9",
    "text": "उसकी संध्या के तारे प्रकाश न दें;"
  },
  {
    "id": 12915,
    "book": "job                                     ",
    "chapter": "3",
    "verse": "10",
    "text": "क्योंकि उसने मेरी माता की कोख को बन्द"
  },
  {
    "id": 12916,
    "book": "job                                     ",
    "chapter": "3",
    "verse": "11",
    "text": "“मैं गर्भ ही में क्यों न मर गया?"
  },
  {
    "id": 12917,
    "book": "job                                     ",
    "chapter": "3",
    "verse": "12",
    "text": "मैं घुटनों पर क्यों लिया गया?"
  },
  {
    "id": 12918,
    "book": "job                                     ",
    "chapter": "3",
    "verse": "13",
    "text": "ऐसा न होता तो मैं चुपचाप पड़ा रहता, मैं"
  },
  {
    "id": 12919,
    "book": "job                                     ",
    "chapter": "3",
    "verse": "14",
    "text": "और मैं पृथ्वी के उन राजाओं और मंत्रियों के साथ3:14 राजाओं और मंत्रियों के साथ: महान एवं बुद्धिमान लोग आपातकालीन स्थिति में राजाओं को परामर्श देते थे।  होता"
  },
  {
    "id": 12920,
    "book": "job                                     ",
    "chapter": "3",
    "verse": "15",
    "text": "या मैं उन राजकुमारों के साथ होता जिनके पास सोना था"
  },
  {
    "id": 12921,
    "book": "job                                     ",
    "chapter": "3",
    "verse": "16",
    "text": "या मैं असमय गिरे हुए गर्भ के समान हुआ होता,"
  },
  {
    "id": 12922,
    "book": "job                                     ",
    "chapter": "3",
    "verse": "17",
    "text": "उस दशा में दुष्ट लोग फिर दुःख नहीं देते,"
  },
  {
    "id": 12923,
    "book": "job                                     ",
    "chapter": "3",
    "verse": "18",
    "text": "उसमें बन्धुए एक संग सुख से रहते हैं;"
  },
  {
    "id": 12924,
    "book": "job                                     ",
    "chapter": "3",
    "verse": "19",
    "text": "उसमें छोटे बड़े सब रहते हैं3:19 छोटे बड़े सब रहते हैं: वृद्ध एवं युवा, उच्च पदाधिकारी एवं नगण्य लोग मृत्यु सब को बराबर बना देती है।, और दास अपने"
  },
  {
    "id": 12925,
    "book": "job                                     ",
    "chapter": "3",
    "verse": "20",
    "text": "“दुःखियों को उजियाला,"
  },
  {
    "id": 12926,
    "book": "job                                     ",
    "chapter": "3",
    "verse": "21",
    "text": "वे मृत्यु की बाट जोहते हैं पर वह आती नहीं;"
  },
  {
    "id": 12927,
    "book": "job                                     ",
    "chapter": "3",
    "verse": "22",
    "text": "वे कब्र को पहुँचकर आनन्दित और अत्यन्त मगन होते हैं।"
  },
  {
    "id": 12928,
    "book": "job                                     ",
    "chapter": "3",
    "verse": "23",
    "text": "उजियाला उस पुरुष को क्यों मिलता है"
  },
  {
    "id": 12929,
    "book": "job                                     ",
    "chapter": "3",
    "verse": "24",
    "text": "मुझे तो रोटी खाने के बदले लम्बी-लम्बी साँसें आती हैं,"
  },
  {
    "id": 12930,
    "book": "job                                     ",
    "chapter": "3",
    "verse": "25",
    "text": "क्योंकि जिस डरावनी बात से मैं डरता हूँ, वही मुझ पर आ पड़ती है,"
  },
  {
    "id": 12931,
    "book": "job                                     ",
    "chapter": "3",
    "verse": "26",
    "text": "मुझे न तो चैन, न शान्ति, न विश्राम मिलता"
  }
]
