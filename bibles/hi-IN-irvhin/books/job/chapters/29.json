[
  {
    "id": 13534,
    "book": "job                                     ",
    "chapter": "29",
    "verse": "1",
    "text": "अय्यूब ने और भी अपनी गूढ़ बात उठाई और कहा,"
  },
  {
    "id": 13535,
    "book": "job                                     ",
    "chapter": "29",
    "verse": "2",
    "text": "“भला होता, कि मेरी दशा बीते हुए महीनों की सी होती,"
  },
  {
    "id": 13536,
    "book": "job                                     ",
    "chapter": "29",
    "verse": "3",
    "text": "जब उसके दीपक का प्रकाश मेरे सिर पर रहता था,"
  },
  {
    "id": 13537,
    "book": "job                                     ",
    "chapter": "29",
    "verse": "4",
    "text": "वे तो मेरी जवानी के दिन थे,"
  },
  {
    "id": 13538,
    "book": "job                                     ",
    "chapter": "29",
    "verse": "5",
    "text": "उस समय तक तो सर्वशक्तिमान परमेश्वर मेरे संग रहता था,"
  },
  {
    "id": 13539,
    "book": "job                                     ",
    "chapter": "29",
    "verse": "6",
    "text": "तब मैं अपने पैरों को मलाई से धोता था और"
  },
  {
    "id": 13540,
    "book": "job                                     ",
    "chapter": "29",
    "verse": "7",
    "text": "जब-जब मैं नगर के फाटक की ओर चलकर खुले स्थान में"
  },
  {
    "id": 13541,
    "book": "job                                     ",
    "chapter": "29",
    "verse": "8",
    "text": "तब-तब जवान मुझे देखकर छिप जाते,"
  },
  {
    "id": 13542,
    "book": "job                                     ",
    "chapter": "29",
    "verse": "9",
    "text": "हाकिम लोग भी बोलने से रुक जाते,"
  },
  {
    "id": 13543,
    "book": "job                                     ",
    "chapter": "29",
    "verse": "10",
    "text": "प्रधान लोग चुप रहते थे"
  },
  {
    "id": 13544,
    "book": "job                                     ",
    "chapter": "29",
    "verse": "11",
    "text": "क्योंकि जब कोई मेरा समाचार सुनता, तब वह मुझे धन्य कहता था,"
  },
  {
    "id": 13545,
    "book": "job                                     ",
    "chapter": "29",
    "verse": "12",
    "text": "क्योंकि मैं दुहाई देनेवाले दीन जन को,"
  },
  {
    "id": 13546,
    "book": "job                                     ",
    "chapter": "29",
    "verse": "13",
    "text": "जो नाश होने पर था मुझे आशीर्वाद देता था,"
  },
  {
    "id": 13547,
    "book": "job                                     ",
    "chapter": "29",
    "verse": "14",
    "text": "मैं धार्मिकता को पहने रहा, और वह मुझे ढांके रहा;"
  },
  {
    "id": 13548,
    "book": "job                                     ",
    "chapter": "29",
    "verse": "15",
    "text": "मैं अंधों के लिये आँखें,"
  },
  {
    "id": 13549,
    "book": "job                                     ",
    "chapter": "29",
    "verse": "16",
    "text": "दरिद्र लोगों का मैं पिता ठहरता था,"
  },
  {
    "id": 13550,
    "book": "job                                     ",
    "chapter": "29",
    "verse": "17",
    "text": "मैं कुटिल मनुष्यों की डाढ़ें तोड़ डालता,"
  },
  {
    "id": 13551,
    "book": "job                                     ",
    "chapter": "29",
    "verse": "18",
    "text": "तब मैं सोचता था, ‘मेरे दिन रेतकणों के समान अनगिनत होंगे,"
  },
  {
    "id": 13552,
    "book": "job                                     ",
    "chapter": "29",
    "verse": "19",
    "text": "मेरी जड़ जल की ओर फैली,"
  },
  {
    "id": 13553,
    "book": "job                                     ",
    "chapter": "29",
    "verse": "20",
    "text": "मेरी महिमा ज्यों की त्यों बनी रहेगी,"
  },
  {
    "id": 13554,
    "book": "job                                     ",
    "chapter": "29",
    "verse": "21",
    "text": "“लोग मेरी ही ओर कान लगाकर ठहरे रहते थे"
  },
  {
    "id": 13555,
    "book": "job                                     ",
    "chapter": "29",
    "verse": "22",
    "text": "जब मैं बोल चुकता था, तब वे और कुछ न बोलते थे,"
  },
  {
    "id": 13556,
    "book": "job                                     ",
    "chapter": "29",
    "verse": "23",
    "text": "जैसे लोग बरसात की, वैसे ही मेरी भी बाट देखते थे29:23 जैसे लोग बरसात की, वैसे ही मेरी भी बाट देखते थे: अर्थात् जैसे सूखी और प्यासी भूमि वर्षा की प्रतिक्षा करती है। ;"
  },
  {
    "id": 13557,
    "book": "job                                     ",
    "chapter": "29",
    "verse": "24",
    "text": "जब उनको कुछ आशा न रहती थी तब मैं हँसकर उनको प्रसन्न करता था;"
  },
  {
    "id": 13558,
    "book": "job                                     ",
    "chapter": "29",
    "verse": "25",
    "text": "मैं उनका मार्ग चुन लेता, और उनमें मुख्य ठहरकर बैठा करता था,"
  }
]
