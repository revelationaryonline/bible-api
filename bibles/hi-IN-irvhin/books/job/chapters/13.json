[
  {
    "id": 13155,
    "book": "job                                     ",
    "chapter": "13",
    "verse": "1",
    "text": "“सुनो, मैं यह सब कुछ अपनी आँख से देख चुका,"
  },
  {
    "id": 13156,
    "book": "job                                     ",
    "chapter": "13",
    "verse": "2",
    "text": "जो कुछ तुम जानते हो वह मैं भी जानता हूँ;"
  },
  {
    "id": 13157,
    "book": "job                                     ",
    "chapter": "13",
    "verse": "3",
    "text": "मैं तो सर्वशक्तिमान से बातें करूँगा,"
  },
  {
    "id": 13158,
    "book": "job                                     ",
    "chapter": "13",
    "verse": "4",
    "text": "परन्तु तुम लोग झूठी बात के गढ़नेवाले हो;"
  },
  {
    "id": 13159,
    "book": "job                                     ",
    "chapter": "13",
    "verse": "5",
    "text": "भला होता, कि तुम बिल्कुल चुप रहते,"
  },
  {
    "id": 13160,
    "book": "job                                     ",
    "chapter": "13",
    "verse": "6",
    "text": "मेरा विवाद सुनो,"
  },
  {
    "id": 13161,
    "book": "job                                     ",
    "chapter": "13",
    "verse": "7",
    "text": "क्या तुम परमेश्वर के निमित्त टेढ़ी बातें कहोगे,"
  },
  {
    "id": 13162,
    "book": "job                                     ",
    "chapter": "13",
    "verse": "8",
    "text": "क्या तुम उसका पक्षपात करोगे?"
  },
  {
    "id": 13163,
    "book": "job                                     ",
    "chapter": "13",
    "verse": "9",
    "text": "क्या यह भला होगा, कि वह तुम को जाँचे?"
  },
  {
    "id": 13164,
    "book": "job                                     ",
    "chapter": "13",
    "verse": "10",
    "text": "यदि तुम छिपकर पक्षपात करो,"
  },
  {
    "id": 13165,
    "book": "job                                     ",
    "chapter": "13",
    "verse": "11",
    "text": "क्या तुम उसके माहात्म्य से भय न खाओगे?"
  },
  {
    "id": 13166,
    "book": "job                                     ",
    "chapter": "13",
    "verse": "12",
    "text": "तुम्हारे स्मरणयोग्य नीतिवचन राख के समान हैं;"
  },
  {
    "id": 13167,
    "book": "job                                     ",
    "chapter": "13",
    "verse": "13",
    "text": "“मुझसे बात करना छोड़ो, कि मैं भी कुछ कहने पाऊँ;"
  },
  {
    "id": 13168,
    "book": "job                                     ",
    "chapter": "13",
    "verse": "14",
    "text": "मैं क्यों अपना माँस अपने दाँतों से चबाऊँ?"
  },
  {
    "id": 13169,
    "book": "job                                     ",
    "chapter": "13",
    "verse": "15",
    "text": "वह मुझे घात करेगा13:15 वह मुझे घात करेगा: परमेश्वर मेरे दु:खों और कष्टों को इतना बढ़ा दे कि मैं जीवित न रह पाऊँ। मैं देख सकता हूँ कि मैं आपदाओं के तीव्रता के सामने हूँ, परन्तु मैं फिर भी उनका सामना करने को तैयार हूँ। , मुझे कुछ आशा नहीं;"
  },
  {
    "id": 13170,
    "book": "job                                     ",
    "chapter": "13",
    "verse": "16",
    "text": "और यह ही मेरे बचाव का कारण होगा, कि"
  },
  {
    "id": 13171,
    "book": "job                                     ",
    "chapter": "13",
    "verse": "17",
    "text": "चित्त लगाकर मेरी बात सुनो,"
  },
  {
    "id": 13172,
    "book": "job                                     ",
    "chapter": "13",
    "verse": "18",
    "text": "देखो, मैंने अपने मुकद्दमे की पूरी तैयारी की है;"
  },
  {
    "id": 13173,
    "book": "job                                     ",
    "chapter": "13",
    "verse": "19",
    "text": "कौन है जो मुझसे मुकद्दमा लड़ सकेगा?"
  },
  {
    "id": 13174,
    "book": "job                                     ",
    "chapter": "13",
    "verse": "20",
    "text": "दो ही काम मेरे लिए कर,"
  },
  {
    "id": 13175,
    "book": "job                                     ",
    "chapter": "13",
    "verse": "21",
    "text": "अपनी ताड़ना मुझसे दूर कर ले,"
  },
  {
    "id": 13176,
    "book": "job                                     ",
    "chapter": "13",
    "verse": "22",
    "text": "तब तेरे बुलाने पर मैं बोलूँगा;"
  },
  {
    "id": 13177,
    "book": "job                                     ",
    "chapter": "13",
    "verse": "23",
    "text": "मुझसे कितने अधर्म के काम और पाप हुए हैं?"
  },
  {
    "id": 13178,
    "book": "job                                     ",
    "chapter": "13",
    "verse": "24",
    "text": "तू किस कारण अपना मुँह फेर लेता है,"
  },
  {
    "id": 13179,
    "book": "job                                     ",
    "chapter": "13",
    "verse": "25",
    "text": "क्या तू उड़ते हुए पत्ते को भी कँपाएगा?"
  },
  {
    "id": 13180,
    "book": "job                                     ",
    "chapter": "13",
    "verse": "26",
    "text": "तू मेरे लिये कठिन दुःखों की आज्ञा देता है,"
  },
  {
    "id": 13181,
    "book": "job                                     ",
    "chapter": "13",
    "verse": "27",
    "text": "और मेरे पाँवों को काठ में ठोंकता,"
  },
  {
    "id": 13182,
    "book": "job                                     ",
    "chapter": "13",
    "verse": "28",
    "text": "और मैं सड़ी-गली वस्तु के तुल्य हूँ जो नाश"
  }
]
