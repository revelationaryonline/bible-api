[
  {
    "id": 13483,
    "book": "job                                     ",
    "chapter": "27",
    "verse": "1",
    "text": "अय्यूब ने और भी अपनी गूढ़ बात उठाई और कहा,"
  },
  {
    "id": 13484,
    "book": "job                                     ",
    "chapter": "27",
    "verse": "2",
    "text": "“मैं परमेश्वर के जीवन की शपथ खाता हूँ जिसने मेरा न्याय बिगाड़ दिया,"
  },
  {
    "id": 13485,
    "book": "job                                     ",
    "chapter": "27",
    "verse": "3",
    "text": "क्योंकि अब तक मेरी साँस बराबर आती है,"
  },
  {
    "id": 13486,
    "book": "job                                     ",
    "chapter": "27",
    "verse": "4",
    "text": "मैं यह कहता हूँ कि मेरे मुँह से कोई कुटिल बात न निकलेगी,"
  },
  {
    "id": 13487,
    "book": "job                                     ",
    "chapter": "27",
    "verse": "5",
    "text": "परमेश्वर न करे कि मैं तुम लोगों को सच्चा ठहराऊँ,"
  },
  {
    "id": 13488,
    "book": "job                                     ",
    "chapter": "27",
    "verse": "6",
    "text": "मैं अपनी धार्मिकता पकड़े हुए हूँ और उसको हाथ से जाने न दूँगा;"
  },
  {
    "id": 13489,
    "book": "job                                     ",
    "chapter": "27",
    "verse": "7",
    "text": "“मेरा शत्रु दुष्टों के समान,"
  },
  {
    "id": 13490,
    "book": "job                                     ",
    "chapter": "27",
    "verse": "8",
    "text": "जब परमेश्वर भक्तिहीन मनुष्य का प्राण ले ले,"
  },
  {
    "id": 13491,
    "book": "job                                     ",
    "chapter": "27",
    "verse": "9",
    "text": "जब वह संकट में पड़े,"
  },
  {
    "id": 13492,
    "book": "job                                     ",
    "chapter": "27",
    "verse": "10",
    "text": "क्या वह सर्वशक्तिमान परमेश्वर में सुख पा सकेगा, और"
  },
  {
    "id": 13493,
    "book": "job                                     ",
    "chapter": "27",
    "verse": "11",
    "text": "मैं तुम्हें परमेश्वर के काम के विषय शिक्षा दूँगा,"
  },
  {
    "id": 13494,
    "book": "job                                     ",
    "chapter": "27",
    "verse": "12",
    "text": "देखो, तुम लोग सब के सब उसे स्वयं देख चुके हो,"
  },
  {
    "id": 13495,
    "book": "job                                     ",
    "chapter": "27",
    "verse": "13",
    "text": "“दुष्ट मनुष्य का भाग परमेश्वर की ओर से यह है,"
  },
  {
    "id": 13496,
    "book": "job                                     ",
    "chapter": "27",
    "verse": "14",
    "text": "चाहे उसके बच्चे गिनती में बढ़ भी जाएँ, तो भी तलवार ही के लिये बढ़ेंगे,"
  },
  {
    "id": 13497,
    "book": "job                                     ",
    "chapter": "27",
    "verse": "15",
    "text": "उसके जो लोग बच जाएँ वे मरकर कब्र को पहुँचेंगे;"
  },
  {
    "id": 13498,
    "book": "job                                     ",
    "chapter": "27",
    "verse": "16",
    "text": "चाहे वह रुपया धूलि के समान बटोर रखे"
  },
  {
    "id": 13499,
    "book": "job                                     ",
    "chapter": "27",
    "verse": "17",
    "text": "वह उन्हें तैयार कराए तो सही, परन्तु धर्मी उन्हें पहन लेगा,"
  },
  {
    "id": 13500,
    "book": "job                                     ",
    "chapter": "27",
    "verse": "18",
    "text": "उसने अपना घर मकड़ी का सा बनाया,"
  },
  {
    "id": 13501,
    "book": "job                                     ",
    "chapter": "27",
    "verse": "19",
    "text": "वह धनी होकर लेट जाए परन्तु वह बना न रहेगा;"
  },
  {
    "id": 13502,
    "book": "job                                     ",
    "chapter": "27",
    "verse": "20",
    "text": "भय की धाराएँ उसे बहा ले जाएँगी,"
  },
  {
    "id": 13503,
    "book": "job                                     ",
    "chapter": "27",
    "verse": "21",
    "text": "पूर्वी वायु उसे ऐसा उड़ा ले जाएगी, और वह जाता रहेगा"
  },
  {
    "id": 13504,
    "book": "job                                     ",
    "chapter": "27",
    "verse": "22",
    "text": "क्योंकि परमेश्वर उस पर विपत्तियाँ बिना तरस खाए डाल देगा27:22 परमेश्वर उस पर विपत्तियाँ बिना तरस खाए डाल देगा: अर्थात् परमेश्वर जब उस पर आपदाओं की वर्षा करेगा तब तरस नहीं खाएगा।,"
  },
  {
    "id": 13505,
    "book": "job                                     ",
    "chapter": "27",
    "verse": "23",
    "text": "लोग उस पर ताली बजाएँगे,"
  }
]
