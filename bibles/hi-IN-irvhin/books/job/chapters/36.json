[
  {
    "id": 13738,
    "book": "job                                     ",
    "chapter": "36",
    "verse": "1",
    "text": "फिर एलीहू ने यह भी कहा,"
  },
  {
    "id": 13739,
    "book": "job                                     ",
    "chapter": "36",
    "verse": "2",
    "text": "“कुछ ठहरा रह, और मैं तुझको समझाऊँगा,"
  },
  {
    "id": 13740,
    "book": "job                                     ",
    "chapter": "36",
    "verse": "3",
    "text": "मैं अपने ज्ञान की बात दूर से ले आऊँगा,"
  },
  {
    "id": 13741,
    "book": "job                                     ",
    "chapter": "36",
    "verse": "4",
    "text": "निश्चय मेरी बातें झूठी न होंगी,"
  },
  {
    "id": 13742,
    "book": "job                                     ",
    "chapter": "36",
    "verse": "5",
    "text": "“देख, परमेश्वर सामर्थी है, और किसी को तुच्छ नहीं जानता;"
  },
  {
    "id": 13743,
    "book": "job                                     ",
    "chapter": "36",
    "verse": "6",
    "text": "वह दुष्टों को जिलाए नहीं रखता,"
  },
  {
    "id": 13744,
    "book": "job                                     ",
    "chapter": "36",
    "verse": "7",
    "text": "वह धर्मियों से अपनी आँखें नहीं फेरता36:7 वह धर्मियों से अपनी आँखें नहीं फेरता: वह लगातार उन पर दृष्टि लगाए रहता है कि उनका जीवन किस स्तर पर है- अधिक ऊँचे या नीचे स्तर पर। ,"
  },
  {
    "id": 13745,
    "book": "job                                     ",
    "chapter": "36",
    "verse": "8",
    "text": "और चाहे वे बेड़ियों में जकड़े जाएँ"
  },
  {
    "id": 13746,
    "book": "job                                     ",
    "chapter": "36",
    "verse": "9",
    "text": "तो भी परमेश्वर उन पर उनके काम,"
  },
  {
    "id": 13747,
    "book": "job                                     ",
    "chapter": "36",
    "verse": "10",
    "text": "वह उनके कान शिक्षा सुनने के लिये खोलता है36:10 वह उनके कान शिक्षा सुनने के लिये खोलता है: वह उन्हें कष्टों द्वारा मिलनेवाली शिक्षा सुनने या सीखने के लिए इच्छुक बनाता है।,"
  },
  {
    "id": 13748,
    "book": "job                                     ",
    "chapter": "36",
    "verse": "11",
    "text": "यदि वे सुनकर उसकी सेवा करें,"
  },
  {
    "id": 13749,
    "book": "job                                     ",
    "chapter": "36",
    "verse": "12",
    "text": "परन्तु यदि वे न सुनें, तो वे तलवार से नाश हो जाते हैं,"
  },
  {
    "id": 13750,
    "book": "job                                     ",
    "chapter": "36",
    "verse": "13",
    "text": "“परन्तु वे जो मन ही मन भक्तिहीन होकर क्रोध बढ़ाते,"
  },
  {
    "id": 13751,
    "book": "job                                     ",
    "chapter": "36",
    "verse": "14",
    "text": "वे जवानी में मर जाते हैं"
  },
  {
    "id": 13752,
    "book": "job                                     ",
    "chapter": "36",
    "verse": "15",
    "text": "वह दुःखियों को उनके दुःख से छुड़ाता है,"
  },
  {
    "id": 13753,
    "book": "job                                     ",
    "chapter": "36",
    "verse": "16",
    "text": "परन्तु वह तुझको भी क्लेश के मुँह में से निकालकर"
  },
  {
    "id": 13754,
    "book": "job                                     ",
    "chapter": "36",
    "verse": "17",
    "text": "“परन्तु तूने दुष्टों का सा निर्णय किया है इसलिए"
  },
  {
    "id": 13755,
    "book": "job                                     ",
    "chapter": "36",
    "verse": "18",
    "text": "देख, तू जलजलाहट से भर के ठट्ठा मत कर,"
  },
  {
    "id": 13756,
    "book": "job                                     ",
    "chapter": "36",
    "verse": "19",
    "text": "क्या तेरा रोना या तेरा बल तुझे दुःख से छुटकारा देगा?"
  },
  {
    "id": 13757,
    "book": "job                                     ",
    "chapter": "36",
    "verse": "20",
    "text": "उस रात की अभिलाषा न कर36:20 उस रात की अभिलाषा न कर: स्पष्टतः मृत्यु की रात। ,"
  },
  {
    "id": 13758,
    "book": "job                                     ",
    "chapter": "36",
    "verse": "21",
    "text": "चौकस रह, अनर्थ काम की ओर मत फिर,"
  },
  {
    "id": 13759,
    "book": "job                                     ",
    "chapter": "36",
    "verse": "22",
    "text": "देख, परमेश्वर अपने सामर्थ्य से बड़े-बड़े काम करता है,"
  },
  {
    "id": 13760,
    "book": "job                                     ",
    "chapter": "36",
    "verse": "23",
    "text": "किसने उसके चलने का मार्ग ठहराया है?"
  },
  {
    "id": 13761,
    "book": "job                                     ",
    "chapter": "36",
    "verse": "24",
    "text": "“उसके कामों की महिमा और प्रशंसा करने को स्मरण रख,"
  },
  {
    "id": 13762,
    "book": "job                                     ",
    "chapter": "36",
    "verse": "25",
    "text": "सब मनुष्य उसको ध्यान से देखते आए हैं,"
  },
  {
    "id": 13763,
    "book": "job                                     ",
    "chapter": "36",
    "verse": "26",
    "text": "देख, परमेश्वर महान और हमारे ज्ञान से कहीं परे है,"
  },
  {
    "id": 13764,
    "book": "job                                     ",
    "chapter": "36",
    "verse": "27",
    "text": "क्योंकि वह तो जल की बूँदें ऊपर को खींच लेता है"
  },
  {
    "id": 13765,
    "book": "job                                     ",
    "chapter": "36",
    "verse": "28",
    "text": "वे ऊँचे-ऊँचे बादल उण्डेलते हैं"
  },
  {
    "id": 13766,
    "book": "job                                     ",
    "chapter": "36",
    "verse": "29",
    "text": "फिर क्या कोई बादलों का फैलना"
  },
  {
    "id": 13767,
    "book": "job                                     ",
    "chapter": "36",
    "verse": "30",
    "text": "देख, वह अपने उजियाले को चहुँ ओर फैलाता है,"
  },
  {
    "id": 13768,
    "book": "job                                     ",
    "chapter": "36",
    "verse": "31",
    "text": "क्योंकि वह देश-देश के लोगों का न्याय इन्हीं से करता है,"
  },
  {
    "id": 13769,
    "book": "job                                     ",
    "chapter": "36",
    "verse": "32",
    "text": "वह बिजली को अपने हाथ में लेकर"
  },
  {
    "id": 13770,
    "book": "job                                     ",
    "chapter": "36",
    "verse": "33",
    "text": "इसकी कड़क उसी का समाचार देती है"
  }
]
