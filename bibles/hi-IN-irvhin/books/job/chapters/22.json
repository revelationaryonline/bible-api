[
  {
    "id": 13391,
    "book": "job                                     ",
    "chapter": "22",
    "verse": "1",
    "text": "तब तेमानी एलीपज ने कहा,"
  },
  {
    "id": 13392,
    "book": "job                                     ",
    "chapter": "22",
    "verse": "2",
    "text": "“क्या मनुष्य से परमेश्वर को लाभ पहुँच सकता है?"
  },
  {
    "id": 13393,
    "book": "job                                     ",
    "chapter": "22",
    "verse": "3",
    "text": "क्या तेरे धर्मी होने से सर्वशक्तिमान सुख पा सकता है?"
  },
  {
    "id": 13394,
    "book": "job                                     ",
    "chapter": "22",
    "verse": "4",
    "text": "वह तो तुझे डाँटता है, और तुझ से मुकद्दमा लड़ता है,"
  },
  {
    "id": 13395,
    "book": "job                                     ",
    "chapter": "22",
    "verse": "5",
    "text": "क्या तेरी बुराई बहुत नहीं?"
  },
  {
    "id": 13396,
    "book": "job                                     ",
    "chapter": "22",
    "verse": "6",
    "text": "तूने तो अपने भाई का बन्धक अकारण रख लिया है,"
  },
  {
    "id": 13397,
    "book": "job                                     ",
    "chapter": "22",
    "verse": "7",
    "text": "थके हुए को तूने पानी न पिलाया,"
  },
  {
    "id": 13398,
    "book": "job                                     ",
    "chapter": "22",
    "verse": "8",
    "text": "जो बलवान था उसी को भूमि मिली,"
  },
  {
    "id": 13399,
    "book": "job                                     ",
    "chapter": "22",
    "verse": "9",
    "text": "तूने विधवाओं को खाली हाथ लौटा दिया।"
  },
  {
    "id": 13400,
    "book": "job                                     ",
    "chapter": "22",
    "verse": "10",
    "text": "इस कारण तेरे चारों ओर फंदे लगे हैं,"
  },
  {
    "id": 13401,
    "book": "job                                     ",
    "chapter": "22",
    "verse": "11",
    "text": "क्या तू अंधियारे को नहीं देखता,"
  },
  {
    "id": 13402,
    "book": "job                                     ",
    "chapter": "22",
    "verse": "12",
    "text": "“क्या परमेश्वर स्वर्ग के ऊँचे स्थान में नहीं है?"
  },
  {
    "id": 13403,
    "book": "job                                     ",
    "chapter": "22",
    "verse": "13",
    "text": "फिर तू कहता है, ‘परमेश्वर क्या जानता है?"
  },
  {
    "id": 13404,
    "book": "job                                     ",
    "chapter": "22",
    "verse": "14",
    "text": "काली घटाओं से वह ऐसा छिपा रहता है कि वह कुछ नहीं देख सकता,"
  },
  {
    "id": 13405,
    "book": "job                                     ",
    "chapter": "22",
    "verse": "15",
    "text": "क्या तू उस पुराने रास्ते को पकड़े रहेगा,"
  },
  {
    "id": 13406,
    "book": "job                                     ",
    "chapter": "22",
    "verse": "16",
    "text": "वे अपने समय से पहले उठा लिए गए"
