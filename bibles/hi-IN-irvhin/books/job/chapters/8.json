[
  {
    "id": 13031,
    "book": "job                                     ",
    "chapter": "8",
    "verse": "1",
    "text": "तब शूही बिल्दद ने कहा,"
  },
  {
    "id": 13032,
    "book": "job                                     ",
    "chapter": "8",
    "verse": "2",
    "text": "“तू कब तक ऐसी-ऐसी बातें करता रहेगा?"
  },
  {
    "id": 13033,
    "book": "job                                     ",
    "chapter": "8",
    "verse": "3",
    "text": "क्या परमेश्वर अन्याय करता है?"
  },
  {
    "id": 13034,
    "book": "job                                     ",
    "chapter": "8",
    "verse": "4",
    "text": "यदि तेरे बच्चों ने उसके विरुद्ध पाप किया है8:4 यदि तेरे बच्चों ने उसके विरुद्ध पाप किया है: बिल्दद का अनुमान है कि अय्यूब की सन्तान ने पाप किया था और वे अपने पापों में नष्ट हो गए।,"
  },
  {
    "id": 13035,
    "book": "job                                     ",
    "chapter": "8",
    "verse": "5",
    "text": "तो भी यदि तू आप परमेश्वर को यत्न से ढूँढ़ता,"
  },
  {
    "id": 13036,
    "book": "job                                     ",
    "chapter": "8",
    "verse": "6",
    "text": "और यदि तू निर्मल और धर्मी रहता,"
  },
  {
    "id": 13037,
    "book": "job                                     ",
    "chapter": "8",
    "verse": "7",
    "text": "चाहे तेरा भाग पहले छोटा ही रहा हो परन्तु"
  },
  {
    "id": 13038,
    "book": "job                                     ",
    "chapter": "8",
    "verse": "8",
    "text": "“पिछली पीढ़ी के लोगों से तो पूछ,"
  },
  {
    "id": 13039,
    "book": "job                                     ",
    "chapter": "8",
    "verse": "9",
    "text": "क्योंकि हम तो कल ही के हैं, और कुछ नहीं जानते;"
  },
  {
    "id": 13040,
    "book": "job                                     ",
    "chapter": "8",
    "verse": "10",
    "text": "क्या वे लोग तुझ से शिक्षा की बातें न कहेंगे?"
  },
  {
    "id": 13041,
    "book": "job                                     ",
    "chapter": "8",
    "verse": "11",
    "text": "“क्या कछार की घास पानी बिना बढ़ सकती है?"
  },
  {
    "id": 13042,
    "book": "job                                     ",
    "chapter": "8",
    "verse": "12",
    "text": "चाहे वह हरी हो, और काटी भी न गई हो,"
  },
  {
    "id": 13043,
    "book": "job                                     ",
    "chapter": "8",
    "verse": "13",
    "text": "परमेश्वर के सब बिसरानेवालों की गति ऐसी ही होती है"
  },
  {
    "id": 13044,
    "book": "job                                     ",
    "chapter": "8",
    "verse": "14",
    "text": "उसकी आशा का मूल कट जाता है;"
  },
  {
    "id": 13045,
    "book": "job                                     ",
    "chapter": "8",
    "verse": "15",
    "text": "चाहे वह अपने घर पर टेक लगाए परन्तु वह न ठहरेगा;"
  },
  {
    "id": 13046,
    "book": "job                                     ",
    "chapter": "8",
    "verse": "16",
    "text": "वह धूप पाकर हरा भरा हो जाता है,"
  },
  {
    "id": 13047,
    "book": "job                                     ",
    "chapter": "8",
    "verse": "17",
    "text": "उसकी जड़ कंकड़ों के ढेर में लिपटी हुई रहती है,"
  },
  {
    "id": 13048,
    "book": "job                                     ",
    "chapter": "8",
    "verse": "18",
    "text": "परन्तु जब वह अपने स्थान पर से नाश किया जाए,"
  },
  {
    "id": 13049,
    "book": "job                                     ",
    "chapter": "8",
    "verse": "19",
    "text": "देख, उसकी आनन्द भरी चाल यही है;"
  },
  {
    "id": 13050,
    "book": "job                                     ",
    "chapter": "8",
    "verse": "20",
    "text": "“देख, परमेश्वर न तो खरे मनुष्य को निकम्मा जानकर छोड़ देता है8:20 परमेश्वर न तो खरे मनुष्य को निकम्मा जानकर छोड़ देता है: परमेश्वर सदाचारी का मित्र है परन्तु दुष्ट का साथ नहीं देता है।,"
  },
  {
    "id": 13051,
    "book": "job                                     ",
    "chapter": "8",
    "verse": "21",
    "text": "वह तो तुझे हँसमुख करेगा;"
  },
  {
    "id": 13052,
    "book": "job                                     ",
    "chapter": "8",
    "verse": "22",
    "text": "तेरे बैरी लज्जा का वस्त्र पहनेंगे,"
  }
]
