[
  {
    "id": 6625,
    "book": "judges                                  ",
    "chapter": "5",
    "verse": "1",
    "text": "उसी दिन दबोरा और अबीनोअम के पुत्र बाराक ने यह गीत गाया:"
  },
  {
    "id": 6626,
    "book": "judges                                  ",
    "chapter": "5",
    "verse": "2",
    "text": "“इस्राएल के अगुओं ने जो अगुआई की और प्रजा जो अपनी ही इच्छा से भरती हुई,"
  },
  {
    "id": 6627,
    "book": "judges                                  ",
    "chapter": "5",
    "verse": "3",
    "text": "“हे राजाओं, सुनो; हे अधिपतियों कान लगाओ,"
  },
  {
    "id": 6628,
    "book": "judges                                  ",
    "chapter": "5",
    "verse": "4",
    "text": "हे यहोवा, जब तू सेईर से निकल चला,"
  },
  {
    "id": 6629,
    "book": "judges                                  ",
    "chapter": "5",
    "verse": "5",
    "text": "यहोवा के प्रताप से पहाड़,"
  },
  {
    "id": 6630,
    "book": "judges                                  ",
    "chapter": "5",
    "verse": "6",
    "text": "“अनात के पुत्र शमगर के दिनों में,"
  },
  {
    "id": 6631,
    "book": "judges                                  ",
    "chapter": "5",
    "verse": "7",
    "text": "जब तक मैं दबोरा न उठी,"
  },
  {
    "id": 6632,
    "book": "judges                                  ",
    "chapter": "5",
    "verse": "8",
    "text": "नये-नये देवता माने गए,"
  },
  {
    "id": 6633,
    "book": "judges                                  ",
    "chapter": "5",
    "verse": "9",
    "text": "मेरा मन इस्राएल के हाकिमों की ओर लगा है,"
  },
  {
    "id": 6634,
    "book": "judges                                  ",
    "chapter": "5",
    "verse": "10",
    "text": "“हे उजली गदहियों पर चढ़ने‍वालों,"
  },
  {
    "id": 6635,
    "book": "judges                                  ",
    "chapter": "5",
    "verse": "11",
    "text": "पनघटों के आस-पास धनुर्धारियों की बात के कारण,"
  },
  {
    "id": 6636,
    "book": "judges                                  ",
    "chapter": "5",
    "verse": "12",
    "text": "“जाग, जाग, हे दबोरा!"
  },
  {
    "id": 6637,
    "book": "judges                                  ",
    "chapter": "5",
    "verse": "13",
    "text": "उस समय थोड़े से रईस प्रजा समेत उतर पड़े;"
  },
  {
    "id": 6638,
    "book": "judges                                  ",
    "chapter": "5",
    "verse": "14",
    "text": "एप्रैम में से वे आए जिसकी जड़ अमालेक में है;"
  },
  {
    "id": 6639,
    "book": "judges                                  ",
    "chapter": "5",
    "verse": "15",
    "text": "और इस्साकार के हाकिम दबोरा के संग हुए,"
  },
  {
    "id": 6640,
    "book": "judges                                  ",
    "chapter": "5",
    "verse": "16",
    "text": "तू चरवाहों का सीटी बजाना सुनने को भेड़शालाओं के बीच क्यों बैठा रहा?"
  },
  {
    "id": 6641,
    "book": "judges                                  ",
    "chapter": "5",
    "verse": "17",
    "text": "गिलाद यरदन पार रह गया; और दान क्यों जहाजों में रह गया?"
  },
  {
    "id": 6642,
    "book": "judges                                  ",
    "chapter": "5",
    "verse": "18",
    "text": "जबूलून अपने प्राण पर खेलनेवाले लोग ठहरे;"
  },
  {
    "id": 6643,
    "book": "judges                                  ",
    "chapter": "5",
    "verse": "19",
    "text": "“राजा आकर लड़े,"
  },
  {
    "id": 6644,
    "book": "judges                                  ",
    "chapter": "5",
    "verse": "20",
    "text": "आकाश की ओर से भी लड़ाई हुई;"
  },
  {
    "id": 6645,
    "book": "judges                                  ",
    "chapter": "5",
    "verse": "21",
    "text": "कीशोन नदी ने उनको बहा दिया,"
  },
  {
    "id": 6646,
    "book": "judges                                  ",
    "chapter": "5",
    "verse": "22",
    "text": "“उस समय घोड़े के खुरों से टाप का शब्द होने लगा,"
  },
  {
    "id": 6647,
    "book": "judges                                  ",
    "chapter": "5",
    "verse": "23",
    "text": "“यहोवा का दूत कहता है,"
  },
  {
    "id": 6648,
    "book": "judges                                  ",
    "chapter": "5",
    "verse": "24",
    "text": "“सब स्त्रियों में से केनी हेबेर की स्त्री याएल धन्य ठहरेगी;"
  },
  {
    "id": 6649,
    "book": "judges                                  ",
    "chapter": "5",
    "verse": "25",
    "text": "सीसरा ने पानी माँगा, उसने दूध दिया,"
  },
  {
    "id": 6650,
    "book": "judges                                  ",
    "chapter": "5",
    "verse": "26",
    "text": "उसने अपना हाथ खूँटी की ओर,"
  },
  {
    "id": 6651,
    "book": "judges                                  ",
    "chapter": "5",
    "verse": "27",
    "text": "उस स्त्री के पाँवों पर वह झुका, वह गिरा, वह पड़ा रहा;"
  },
  {
    "id": 6652,
    "book": "judges                                  ",
    "chapter": "5",
    "verse": "28",
    "text": "“खिड़की में से एक स्त्री झाँककर चिल्लाई,"
  },
  {
    "id": 6653,
    "book": "judges                                  ",
    "chapter": "5",
    "verse": "29",
    "text": "उसकी बुद्धिमान प्रतिष्ठित स्त्रियों ने उसे उत्तर दिया,"
  },
  {
    "id": 6654,
    "book": "judges                                  ",
    "chapter": "5",
    "verse": "30",
    "text": "‘क्या उन्होंने लूट पाकर बाँट नहीं ली?"
  },
  {
    "id": 6655,
    "book": "judges                                  ",
    "chapter": "5",
    "verse": "31",
    "text": "“हे यहोवा, “तेरे सब शत्रु ऐसे ही नाश हो जाएँ!"
  }
]
