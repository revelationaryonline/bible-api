[
  {
    "id": 5823,
    "book": "john                                    ",
    "chapter": "9",
    "verse": "1",
    "text": "Одного разу, проходячи, Ісус побачив чоловіка, сліпого від народження."
  },
  {
    "id": 5824,
    "book": "john                                    ",
    "chapter": "9",
    "verse": "2",
    "text": "Його учні запитали:"
  },
  {
    "id": 5825,
    "book": "john                                    ",
    "chapter": "9",
    "verse": "3",
    "text": "Ісус відповів:"
  },
  {
    "id": 5826,
    "book": "john                                    ",
    "chapter": "9",
    "verse": "4",
    "text": "Доки ще день, ми маємо виконувати діла Того, Хто послав Мене. Коли настане ніч, ніхто вже не зможе працювати."
  },
  {
    "id": 5827,
    "book": "john                                    ",
    "chapter": "9",
    "verse": "5",
    "text": "Доки Я у світі, Я – світло світу."
  },
  {
    "id": 5828,
    "book": "john                                    ",
    "chapter": "9",
    "verse": "6",
    "text": "Сказавши це, Ісус плюнув на землю, змішав грязь зі слини й землі та помазав очі сліпому."
  },
  {
    "id": 5829,
    "book": "john                                    ",
    "chapter": "9",
    "verse": "7",
    "text": "Потім сказав йому: «Іди та вмийся в купальні Силоам» (що в перекладі означає: «Посланий»)."
  },
  {
    "id": 5830,
    "book": "john                                    ",
    "chapter": "9",
    "verse": "8",
    "text": "Сусіди й ті, хто бачив його раніше, як він просив, казали:"
  },
  {
    "id": 5831,
    "book": "john                                    ",
    "chapter": "9",
    "verse": "9",
    "text": "Одні казали:"
  },
  {
    "id": 5832,
    "book": "john                                    ",
    "chapter": "9",
    "verse": "10",
    "text": "Тоді запитали його:"
  },
  {
    "id": 5833,
    "book": "john                                    ",
    "chapter": "9",
    "verse": "11",
    "text": "Він відповів:"
  },
  {
    "id": 5834,
    "book": "john                                    ",
    "chapter": "9",
    "verse": "12",
    "text": "Вони його запитали:"
  },
  {
    "id": 5835,
    "book": "john                                    ",
    "chapter": "9",
    "verse": "13",
    "text": "Чоловіка, який раніше був сліпий, привели до фарисеїв."
  },
  {
    "id": 5836,
    "book": "john                                    ",
    "chapter": "9",
    "verse": "14",
    "text": "А того дня, коли Ісус змішав грязь і відкрив йому очі, була Субота."
  },
  {
    "id": 5837,
    "book": "john                                    ",
    "chapter": "9",
    "verse": "15",
    "text": "Фарисеї знову запитали його, як він прозрів. Той відповів:"
  },
  {
    "id": 5838,
    "book": "john                                    ",
    "chapter": "9",
    "verse": "16",
    "text": "Деякі фарисеї почали казати:"
  },
  {
    "id": 5839,
    "book": "john                                    ",
    "chapter": "9",
    "verse": "17",
    "text": "Тоді вони знов запитали сліпого:"
  },
  {
    "id": 5840,
    "book": "john                                    ",
    "chapter": "9",
    "verse": "18",
    "text": "Юдеї не вірили, що він був сліпий і прозрів, доки не покликали його батьків."
  },
  {
    "id": 5841,
    "book": "john                                    ",
    "chapter": "9",
    "verse": "19",
    "text": "Вони запитали:"
  },
  {
    "id": 5842,
    "book": "john                                    ",
    "chapter": "9",
    "verse": "20",
    "text": "Тоді батьки його відповіли:"
  },
  {
    "id": 5843,
    "book": "john                                    ",
    "chapter": "9",
    "verse": "21",
    "text": "А як він вже бачить, не знаємо. І хто відкрив йому очі, ми не знаємо. Запитайте його. Він дорослий і може сам відповісти за себе."
  },
  {
    "id": 5844,
    "book": "john                                    ",
    "chapter": "9",
    "verse": "22",
    "text": "Його батьки казали так, адже боялися юдеїв, бо ті вже вирішили: хто визнає Ісуса Христом, буде відлучений від синагоги."
  },
  {
    "id": 5845,
    "book": "john                                    ",
    "chapter": "9",
    "verse": "23",
    "text": "Тому його батьки й сказали: «Він вже дорослий, запитайте в нього!»"
  },
  {
    "id": 5846,
    "book": "john                                    ",
    "chapter": "9",
    "verse": "24",
    "text": "Вони вдруге покликали чоловіка, який був сліпий, та сказали йому:"
  },
  {
    "id": 5847,
    "book": "john                                    ",
    "chapter": "9",
    "verse": "25",
    "text": "Він відповів:"
  },
  {
    "id": 5848,
    "book": "john                                    ",
    "chapter": "9",
    "verse": "26",
    "text": "Тоді вони запитали:"
  },
  {
    "id": 5849,
    "book": "john                                    ",
    "chapter": "9",
    "verse": "27",
    "text": "Він відповів:"
  },
  {
    "id": 5850,
    "book": "john                                    ",
    "chapter": "9",
    "verse": "28",
    "text": "Вони докорили йому та сказали:"
  },
  {
    "id": 5851,
    "book": "john                                    ",
    "chapter": "9",
    "verse": "29",
    "text": "Ми знаємо, що з Мойсеєм говорив Бог, а Цього ми не знаємо, звідки Він."
  },
  {
    "id": 5852,
    "book": "john                                    ",
    "chapter": "9",
    "verse": "30",
    "text": "Чоловік сказав їм у відповідь:"
  },
  {
    "id": 5853,
    "book": "john                                    ",
    "chapter": "9",
    "verse": "31",
    "text": "Ми знаємо, що Бог не слухає грішників. Він слухає тільки тих, хто шанує Його й виконує Його волю."
  },
  {
    "id": 5854,
    "book": "john                                    ",
    "chapter": "9",
    "verse": "32",
    "text": "Споконвіку ніхто не чув, щоб хтось відкрив очі тому, хто народився сліпий.9:32 Див. Іс. 29:18; 35:5; 42:7."
  },
  {
    "id": 5855,
    "book": "john                                    ",
    "chapter": "9",
    "verse": "33",
    "text": "Якби Він не був від Бога, то не зміг би зробити нічого."
  },
  {
    "id": 5856,
    "book": "john                                    ",
    "chapter": "9",
    "verse": "34",
    "text": "Вони відповіли:"
  },
  {
    "id": 5857,
    "book": "john                                    ",
    "chapter": "9",
    "verse": "35",
    "text": "Ісус, почувши, що вони вигнали геть зціленого, знайшов його й запитав:"
  },
  {
    "id": 5858,
    "book": "john                                    ",
    "chapter": "9",
    "verse": "36",
    "text": "Зцілений відповів:"
  },
  {
    "id": 5859,
    "book": "john                                    ",
    "chapter": "9",
    "verse": "37",
    "text": "Ісус сказав:"
  },
  {
    "id": 5860,
    "book": "john                                    ",
    "chapter": "9",
    "verse": "38",
    "text": "Тоді чоловік відповів:"
  },
  {
    "id": 5861,
    "book": "john                                    ",
    "chapter": "9",
    "verse": "39",
    "text": "Ісус сказав:"
  },
  {
    "id": 5862,
    "book": "john                                    ",
    "chapter": "9",
    "verse": "40",
    "text": "Фарисеї, які були з Ним і почули це, сказали Йому:"
  },
  {
    "id": 5863,
    "book": "john                                    ",
    "chapter": "9",
    "verse": "41",
    "text": "Ісус сказав:"
  }
]
