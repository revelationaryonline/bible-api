[
  {
    "id": 1881,
    "book": "psalms                                  ",
    "chapter": "108",
    "verse": "1",
    "text": "Керівнику хору. Псалом Давидів."
  },
  {
    "id": 1882,
    "book": "psalms                                  ",
    "chapter": "108",
    "verse": "2",
    "text": "адже нечестиві й підступні люди"
  },
  {
    "id": 1883,
    "book": "psalms                                  ",
    "chapter": "108",
    "verse": "3",
    "text": "Оточили мене словами ненависті"
  },
  {
    "id": 1884,
    "book": "psalms                                  ",
    "chapter": "108",
    "verse": "4",
    "text": "За любов мою ворогують зі мною,"
  },
  {
    "id": 1885,
    "book": "psalms                                  ",
    "chapter": "108",
    "verse": "5",
    "text": "Вони віддячують мені злом за добро"
  },
  {
    "id": 1886,
    "book": "psalms                                  ",
    "chapter": "108",
    "verse": "6",
    "text": "Постав над ним нечестивця,"
  },
  {
    "id": 1887,
    "book": "psalms                                  ",
    "chapter": "108",
    "verse": "7",
    "text": "Коли постане він перед судом, нехай виявиться винним"
  },
  {
    "id": 1888,
    "book": "psalms                                  ",
    "chapter": "108",
    "verse": "8",
    "text": "Нехай дні його будуть нечисленними,"
  },
  {
    "id": 1889,
    "book": "psalms                                  ",
    "chapter": "108",
    "verse": "9",
    "text": "Нехай діти його стануть сиротами,"
  },
  {
    "id": 1890,
    "book": "psalms                                  ",
    "chapter": "108",
    "verse": "10",
    "text": "Нехай нащадки його тиняються й жебрають,"
  },
  {
    "id": 1891,
    "book": "psalms                                  ",
    "chapter": "108",
    "verse": "11",
    "text": "Нехай захопить лихвар усе, що є в нього,"
  },
  {
    "id": 1892,
    "book": "psalms                                  ",
    "chapter": "108",
    "verse": "12",
    "text": "Нехай не буде нікого, хто виявив би йому співчуття,"
  },
  {
    "id": 1893,
    "book": "psalms                                  ",
    "chapter": "108",
    "verse": "13",
    "text": "Нехай будуть викорінені його нащадки"
  },
  {
    "id": 1894,
    "book": "psalms                                  ",
    "chapter": "108",
    "verse": "14",
    "text": "Нехай згадаються перед Господом беззаконня його предків"
  },
  {
    "id": 1895,
    "book": "psalms                                  ",
    "chapter": "108",
    "verse": "15",
    "text": "Нехай гріхи його будуть завжди перед Господом"
  },
  {
    "id": 1896,
    "book": "psalms                                  ",
    "chapter": "108",
    "verse": "16",
    "text": "за те, що він не пам’ятав виявляти іншим милість,"
  },
  {
    "id": 1897,
    "book": "psalms                                  ",
    "chapter": "108",
    "verse": "17",
    "text": "Він любив прокляття –"
  },
  {
    "id": 1898,
    "book": "psalms                                  ",
    "chapter": "108",
    "verse": "18",
    "text": "Оскільки він вдягався в прокляття, мов у шати,"
  },
  {
    "id": 1899,
    "book": "psalms                                  ",
    "chapter": "108",
    "verse": "19",
    "text": "Нехай стане воно для нього одягом,"
  },
  {
    "id": 1900,
    "book": "psalms                                  ",
    "chapter": "108",
    "verse": "20",
    "text": "Така відплата від Господа тому, хто ворогує проти мене,"
  },
  {
    "id": 1901,
    "book": "psalms                                  ",
    "chapter": "108",
    "verse": "21",
    "text": "Ти ж, Господи, Володарю,"
  },
  {
    "id": 1902,
    "book": "psalms                                  ",
    "chapter": "108",
    "verse": "22",
    "text": "Адже я пригнічений і бідний"
  },
  {
    "id": 1903,
    "book": "psalms                                  ",
    "chapter": "108",
    "verse": "23",
    "text": "Я сную, немов похилена тінь,"
  },
  {
    "id": 1904,
    "book": "psalms                                  ",
    "chapter": "108",
    "verse": "24",
    "text": "Мої коліна ослабли від посту,"
  },
  {
    "id": 1905,
    "book": "psalms                                  ",
    "chapter": "108",
    "verse": "25",
    "text": "Я став посміховищем для них:"
  },
  {
    "id": 1906,
    "book": "psalms                                  ",
    "chapter": "108",
    "verse": "26",
    "text": "Допоможи мені, Господи, Боже мій,"
  },
  {
    "id": 1907,
    "book": "psalms                                  ",
    "chapter": "108",
    "verse": "27",
    "text": "Нехай же знають, що це рука Твоя,"
  },
  {
    "id": 1908,
    "book": "psalms                                  ",
    "chapter": "108",
    "verse": "28",
    "text": "Нехай вони проклинають, а Ти благослови;"
  },
  {
    "id": 1909,
    "book": "psalms                                  ",
    "chapter": "108",
    "verse": "29",
    "text": "Нехай вдягнуться в безчестя ті, хто проти мене ворогує,"
  },
  {
    "id": 1910,
    "book": "psalms                                  ",
    "chapter": "108",
    "verse": "30",
    "text": "Я буду славити вустами моїми Господа завзято"
  },
  {
    "id": 1911,
    "book": "psalms                                  ",
    "chapter": "108",
    "verse": "31",
    "text": "Бо Він стоїть по правиці від бідняка,"
  }
]
