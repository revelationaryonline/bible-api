[
  {
    "id": 1602,
    "book": "psalms                                  ",
    "chapter": "96",
    "verse": "1",
    "text": "Господь царює!"
  },
  {
    "id": 1603,
    "book": "psalms                                  ",
    "chapter": "96",
    "verse": "2",
    "text": "Хмара й імла навколо Нього;"
  },
  {
    "id": 1604,
    "book": "psalms                                  ",
    "chapter": "96",
    "verse": "3",
    "text": "Вогонь іде перед Ним"
  },
  {
    "id": 1605,
    "book": "psalms                                  ",
    "chapter": "96",
    "verse": "4",
    "text": "Блискавки Його освітлюють всесвіт,"
  },
  {
    "id": 1606,
    "book": "psalms                                  ",
    "chapter": "96",
    "verse": "5",
    "text": "Гори тануть, немов віск, перед обличчям Господа,"
  },
  {
    "id": 1607,
    "book": "psalms                                  ",
    "chapter": "96",
    "verse": "6",
    "text": "Небеса сповіщають Його правду,"
  },
  {
    "id": 1608,
    "book": "psalms                                  ",
    "chapter": "96",
    "verse": "7",
    "text": "Нехай соромом вкриються всі, хто служить ідолам,"
  },
  {
    "id": 1609,
    "book": "psalms                                  ",
    "chapter": "96",
    "verse": "8",
    "text": "Почув це Сіон і зрадів,"
  },
  {
    "id": 1610,
    "book": "psalms                                  ",
    "chapter": "96",
    "verse": "9",
    "text": "Адже Ти, Господи, Всевишній над усією землею,"
  },
  {
    "id": 1611,
    "book": "psalms                                  ",
    "chapter": "96",
    "verse": "10",
    "text": "Ті, хто Господа любить, ненавидьте зло!"
  },
  {
    "id": 1612,
    "book": "psalms                                  ",
    "chapter": "96",
    "verse": "11",
    "text": "Світло посіяне у праведника,96:11 Так у єврейському тексті, у грецькому перекладі: світло сходить для праведника."
  },
  {
    "id": 1613,
    "book": "psalms                                  ",
    "chapter": "96",
    "verse": "12",
    "text": "Радійте, праведні, у Господі,"
  }
]
