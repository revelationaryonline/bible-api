[
  {
    "id": 1161,
    "book": "psalms                                  ",
    "chapter": "73",
    "verse": "1",
    "text": "Повчання Асафа."
  },
  {
    "id": 1162,
    "book": "psalms                                  ",
    "chapter": "73",
    "verse": "2",
    "text": "Згадай громаду Свою, яку придбав Ти віддавна,"
  },
  {
    "id": 1163,
    "book": "psalms                                  ",
    "chapter": "73",
    "verse": "3",
    "text": "Спрямуй кроки Твої до вікових руїн –"
  },
  {
    "id": 1164,
    "book": "psalms                                  ",
    "chapter": "73",
    "verse": "4",
    "text": "Супротивники Твої ревли посеред місць зборів Твого народу,"
  },
  {
    "id": 1165,
    "book": "psalms                                  ",
    "chapter": "73",
    "verse": "5",
    "text": "Поводилися ніби лісоруб,"
  },
  {
    "id": 1166,
    "book": "psalms                                  ",
    "chapter": "73",
    "verse": "6",
    "text": "Та й тепер стесують разом різьблення Храму"
  },
  {
    "id": 1167,
    "book": "psalms                                  ",
    "chapter": "73",
    "verse": "7",
    "text": "Вогню віддали святилище Твоє,"
  },
  {
    "id": 1168,
    "book": "psalms                                  ",
    "chapter": "73",
    "verse": "8",
    "text": "Промовили в серцях своїх:"
  },
  {
    "id": 1169,
    "book": "psalms                                  ",
    "chapter": "73",
    "verse": "9",
    "text": "Ми не бачимо ознак Божих,"
  },
  {
    "id": 1170,
    "book": "psalms                                  ",
    "chapter": "73",
    "verse": "10",
    "text": "Доки, Боже, глумитиметься супротивник?"
  },
  {
    "id": 1171,
    "book": "psalms                                  ",
    "chapter": "73",
    "verse": "11",
    "text": "Чому Ти стримуєш руку Свою, правицю Свою?"
  },
  {
    "id": 1172,
    "book": "psalms                                  ",
    "chapter": "73",
    "verse": "12",
    "text": "Боже, Царю мій споконвічний,"
  },
  {
    "id": 1173,
    "book": "psalms                                  ",
    "chapter": "73",
    "verse": "13",
    "text": "Ти розділив море міццю Своєю,"
  },
  {
    "id": 1174,
    "book": "psalms                                  ",
    "chapter": "73",
    "verse": "14",
    "text": "Ти розбив голову Левіятана,"
  },
  {
    "id": 1175,
    "book": "psalms                                  ",
    "chapter": "73",
    "verse": "15",
    "text": "Ти висікав джерело і потік,"
  },
  {
    "id": 1176,
    "book": "psalms                                  ",
    "chapter": "73",
    "verse": "16",
    "text": "Тобі належить і день, і ніч;"
  },
  {
    "id": 1177,
    "book": "psalms                                  ",
    "chapter": "73",
    "verse": "17",
    "text": "Ти визначив усі межі землі,"
  },
  {
    "id": 1178,
    "book": "psalms                                  ",
    "chapter": "73",
    "verse": "18",
    "text": "Згадай, як ганьбив ворог Тебе, Господи,"
  },
  {
    "id": 1179,
    "book": "psalms                                  ",
    "chapter": "73",
    "verse": "19",
    "text": "Не віддавай звірам душі голубки Своєї,"
  },
  {
    "id": 1180,
    "book": "psalms                                  ",
    "chapter": "73",
    "verse": "20",
    "text": "Поглянь на Завіт Свій,"
  },
  {
    "id": 1181,
    "book": "psalms                                  ",
    "chapter": "73",
    "verse": "21",
    "text": "Нехай пригнічений не повертається посоромленим,"
  },
  {
    "id": 1182,
    "book": "psalms                                  ",
    "chapter": "73",
    "verse": "22",
    "text": "Повстань, Боже, втруться в судову суперечку Свою;"
  },
  {
    "id": 1183,
    "book": "psalms                                  ",
    "chapter": "73",
    "verse": "23",
    "text": "Не забувай крику супротивників Своїх,"
  }
]
