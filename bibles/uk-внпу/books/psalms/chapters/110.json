[
  {
    "id": 1919,
    "book": "psalms                                  ",
    "chapter": "110",
    "verse": "1",
    "text": "Алілуя!"
  },
  {
    "id": 1920,
    "book": "psalms                                  ",
    "chapter": "110",
    "verse": "2",
    "text": "Діяння Господа величні,"
  },
  {
    "id": 1921,
    "book": "psalms                                  ",
    "chapter": "110",
    "verse": "3",
    "text": "Слава й велич – діяння Його,"
  },
  {
    "id": 1922,
    "book": "psalms                                  ",
    "chapter": "110",
    "verse": "4",
    "text": "Пам’ятними зробив Він чудеса Свої;"
  },
  {
    "id": 1923,
    "book": "psalms                                  ",
    "chapter": "110",
    "verse": "5",
    "text": "Їжу дає Він тим, хто боїться Його,"
  },
  {
    "id": 1924,
    "book": "psalms                                  ",
    "chapter": "110",
    "verse": "6",
    "text": "Силу діянь Своїх з’явив Він народові Своєму,"
  },
  {
    "id": 1925,
    "book": "psalms                                  ",
    "chapter": "110",
    "verse": "7",
    "text": "Діяння рук Його – істина й справедливість,"
  },
  {
    "id": 1926,
    "book": "psalms                                  ",
    "chapter": "110",
    "verse": "8",
    "text": "Вони утверджені на віки вічні,"
  },
  {
    "id": 1927,
    "book": "psalms                                  ",
    "chapter": "110",
    "verse": "9",
    "text": "Він послав визволення Своєму народові,"
  },
  {
    "id": 1928,
    "book": "psalms                                  ",
    "chapter": "110",
    "verse": "10",
    "text": "Початок мудрості – страх Господній."
  }
]
