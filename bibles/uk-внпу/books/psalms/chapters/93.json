[
  {
    "id": 1555,
    "book": "psalms                                  ",
    "chapter": "93",
    "verse": "1",
    "text": "О Боже помсти, Господи,"
  },
  {
    "id": 1556,
    "book": "psalms                                  ",
    "chapter": "93",
    "verse": "2",
    "text": "Піднімися, Судде землі,"
  },
  {
    "id": 1557,
    "book": "psalms                                  ",
    "chapter": "93",
    "verse": "3",
    "text": "Аж доки нечестиві, Господи,"
  },
  {
    "id": 1558,
    "book": "psalms                                  ",
    "chapter": "93",
    "verse": "4",
    "text": "Вивергають, промовляють вони пиху,"
  },
  {
    "id": 1559,
    "book": "psalms                                  ",
    "chapter": "93",
    "verse": "5",
    "text": "Народ Твій, Господи, вони вражають ударами"
  },
  {
    "id": 1560,
    "book": "psalms                                  ",
    "chapter": "93",
    "verse": "6",
    "text": "Вдову й приходька вбивають,"
  },
  {
    "id": 1561,
    "book": "psalms                                  ",
    "chapter": "93",
    "verse": "7",
    "text": "кажучи: «Не бачить Господь,"
  },
  {
    "id": 1562,
    "book": "psalms                                  ",
    "chapter": "93",
    "verse": "8",
    "text": "Схаменіться, невігласи серед народу!"
  },
  {
    "id": 1563,
    "book": "psalms                                  ",
    "chapter": "93",
    "verse": "9",
    "text": "Той, Хто насадив вухо, хіба не почує?"
  },
  {
    "id": 1564,
    "book": "psalms                                  ",
    "chapter": "93",
    "verse": "10",
    "text": "Той, Хто народи карає, хіба не докорить?"
  },
  {
    "id": 1565,
    "book": "psalms                                  ",
    "chapter": "93",
    "verse": "11",
    "text": "Господь знає думки людини,"
  },
  {
    "id": 1566,
    "book": "psalms                                  ",
    "chapter": "93",
    "verse": "12",
    "text": "Блаженний муж, якого Ти наставляєш, Господи,"
  },
  {
    "id": 1567,
    "book": "psalms                                  ",
    "chapter": "93",
    "verse": "13",
    "text": "щоб заспокоїти його у дні лиха,"
  },
  {
    "id": 1568,
    "book": "psalms                                  ",
    "chapter": "93",
    "verse": "14",
    "text": "Адже не покине Господь народу Свого"
  },
  {
    "id": 1569,
    "book": "psalms                                  ",
    "chapter": "93",
    "verse": "15",
    "text": "Суд знову стане справедливим,"
  },
  {
    "id": 1570,
    "book": "psalms                                  ",
    "chapter": "93",
    "verse": "16",
    "text": "Хто стане за мене проти злодіїв?"
  },
  {
    "id": 1571,
    "book": "psalms                                  ",
    "chapter": "93",
    "verse": "17",
    "text": "Якби Господь не був допомогою моєю,"
  },
  {
    "id": 1572,
    "book": "psalms                                  ",
    "chapter": "93",
    "verse": "18",
    "text": "Коли сказав я: «Хитається нога моя»,"
  },
  {
    "id": 1573,
    "book": "psalms                                  ",
    "chapter": "93",
    "verse": "19",
    "text": "Коли тривожні думки множаться в нутрі моєму,"
  },
  {
    "id": 1574,
    "book": "psalms                                  ",
    "chapter": "93",
    "verse": "20",
    "text": "Хіба може мати щось спільне з Тобою престол загибелі,"
  },
  {
    "id": 1575,
    "book": "psalms                                  ",
    "chapter": "93",
    "verse": "21",
    "text": "Натовпом тиснуть вони на душу праведника,"
  },
  {
    "id": 1576,
    "book": "psalms                                  ",
    "chapter": "93",
    "verse": "22",
    "text": "Але Господь став моєю твердинею,"
  },
  {
    "id": 1577,
    "book": "psalms                                  ",
    "chapter": "93",
    "verse": "23",
    "text": "Він поверне проти них їхні власні гріхи"
  }
]
