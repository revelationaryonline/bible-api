[
  {
    "id": 1589,
    "book": "psalms                                  ",
    "chapter": "95",
    "verse": "1",
    "text": "Співайте Господеві нову пісню;"
  },
  {
    "id": 1590,
    "book": "psalms                                  ",
    "chapter": "95",
    "verse": "2",
    "text": "Співайте Господеві, благословляйте ім’я Його,"
  },
  {
    "id": 1591,
    "book": "psalms                                  ",
    "chapter": "95",
    "verse": "3",
    "text": "Розповідайте серед народів про славу Його,"
  },
  {
    "id": 1592,
    "book": "psalms                                  ",
    "chapter": "95",
    "verse": "4",
    "text": "Господь великий і вельми прославлений;"
  },
  {
    "id": 1593,
    "book": "psalms                                  ",
    "chapter": "95",
    "verse": "5",
    "text": "Адже всі боги народів – лише ідоли,"
  },
  {
    "id": 1594,
    "book": "psalms                                  ",
    "chapter": "95",
    "verse": "6",
    "text": "Слава й велич перед обличчям Його,"
  },
  {
    "id": 1595,
    "book": "psalms                                  ",
    "chapter": "95",
    "verse": "7",
    "text": "Віддайте Господеві, сім’ї народів,"
  },
  {
    "id": 1596,
    "book": "psalms                                  ",
    "chapter": "95",
    "verse": "8",
    "text": "Віддайте Господеві славу, належну Його імені."
  },
  {
    "id": 1597,
    "book": "psalms                                  ",
    "chapter": "95",
    "verse": "9",
    "text": "Вклоніться Господеві у величі святині."
  },
  {
    "id": 1598,
    "book": "psalms                                  ",
    "chapter": "95",
    "verse": "10",
    "text": "Скажіть серед народів: «Господь царює!»"
  },
  {
    "id": 1599,
    "book": "psalms                                  ",
    "chapter": "95",
    "verse": "11",
    "text": "Нехай радіють небеса й веселиться земля;"
  },
  {
    "id": 1600,
    "book": "psalms                                  ",
    "chapter": "95",
    "verse": "12",
    "text": "Нехай радіє поле і все, що в ньому;"
  },
  {
    "id": 1601,
    "book": "psalms                                  ",
    "chapter": "95",
    "verse": "13",
    "text": "перед обличчям Господа, бо Він іде,"
  }
]
