[
  {
    "id": 569,
    "book": "psalms                                  ",
    "chapter": "37",
    "verse": "1",
    "text": "Псалом Давидів. На спомин."
  },
  {
    "id": 570,
    "book": "psalms                                  ",
    "chapter": "37",
    "verse": "2",
    "text": "Господи, не докоряй мені у гніві Твоєму"
  },
  {
    "id": 571,
    "book": "psalms                                  ",
    "chapter": "37",
    "verse": "3",
    "text": "Бо стріли Твої пронизали мене"
  },
  {
    "id": 572,
    "book": "psalms                                  ",
    "chapter": "37",
    "verse": "4",
    "text": "Немає жодного цілого місця на моєму тілі"
  },
  {
    "id": 573,
    "book": "psalms                                  ",
    "chapter": "37",
    "verse": "5",
    "text": "Бо беззаконня мої накрили мою голову,"
  },
  {
    "id": 574,
    "book": "psalms                                  ",
    "chapter": "37",
    "verse": "6",
    "text": "Смердять, ятріють мої рани"
  },
  {
    "id": 575,
    "book": "psalms                                  ",
    "chapter": "37",
    "verse": "7",
    "text": "Похилений і занадто пригнічений,"
  },
  {
    "id": 576,
    "book": "psalms                                  ",
    "chapter": "37",
    "verse": "8",
    "text": "Бо стегна мої повні палючого болю,"
  },
  {
    "id": 577,
    "book": "psalms                                  ",
    "chapter": "37",
    "verse": "9",
    "text": "Я заціпенілий і вкрай розбитий духом,"
  },
  {
    "id": 578,
    "book": "psalms                                  ",
    "chapter": "37",
    "verse": "10",
    "text": "Володарю, усі бажання мої перед Тобою,"
  },
  {
    "id": 579,
    "book": "psalms                                  ",
    "chapter": "37",
    "verse": "11",
    "text": "Серце моє тріпотить, сила моя полишила мене,"
  },
  {
    "id": 580,
    "book": "psalms                                  ",
    "chapter": "37",
    "verse": "12",
    "text": "Мої друзі й приятелі"
  },
  {
    "id": 581,
    "book": "psalms                                  ",
    "chapter": "37",
    "verse": "13",
    "text": "Розставляють пастки ті, хто шукає душі моєї;37:13 Або: прагне моєї смерті."
  },
  {
    "id": 582,
    "book": "psalms                                  ",
    "chapter": "37",
    "verse": "14",
    "text": "А я, наче глухий, не чую,"
  },
  {
    "id": 583,
    "book": "psalms                                  ",
    "chapter": "37",
    "verse": "15",
    "text": "Я став ніби той, що не чує"
  },
  {
    "id": 584,
    "book": "psalms                                  ",
    "chapter": "37",
    "verse": "16",
    "text": "Та на Тебе, Господи, сподіваюся;"
  },
  {
    "id": 585,
    "book": "psalms                                  ",
    "chapter": "37",
    "verse": "17",
    "text": "Бо казав я Тобі: «Нехай же вони не зловтішаються з мене;"
  },
  {
    "id": 586,
    "book": "psalms                                  ",
    "chapter": "37",
    "verse": "18",
    "text": "Бо я стою хитаючись,"
  },
  {
    "id": 587,
    "book": "psalms                                  ",
    "chapter": "37",
    "verse": "19",
    "text": "Адже я визнаю беззаконня моє,"
  },
  {
    "id": 588,
    "book": "psalms                                  ",
    "chapter": "37",
    "verse": "20",
    "text": "А вороги мої живі та могутні,"
  },
  {
    "id": 589,
    "book": "psalms                                  ",
    "chapter": "37",
    "verse": "21",
    "text": "Вони віддячують мені злом за добро,"
  },
  {
    "id": 590,
    "book": "psalms                                  ",
    "chapter": "37",
    "verse": "22",
    "text": "Не покинь мене, Господи,"
  },
  {
    "id": 591,
    "book": "psalms                                  ",
    "chapter": "37",
    "verse": "23",
    "text": "Поспіши мені на допомогу,"
  }
]
