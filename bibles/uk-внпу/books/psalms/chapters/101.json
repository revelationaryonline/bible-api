[
  {
    "id": 1645,
    "book": "psalms                                  ",
    "chapter": "101",
    "verse": "1",
    "text": "Молитва страдника, коли він знемагає й виливає перед Господом свій жаль."
  },
  {
    "id": 1646,
    "book": "psalms                                  ",
    "chapter": "101",
    "verse": "2",
    "text": "Господи, почуй мою молитву,"
  },
  {
    "id": 1647,
    "book": "psalms                                  ",
    "chapter": "101",
    "verse": "3",
    "text": "Не ховай від мене Твого обличчя"
  },
  {
    "id": 1648,
    "book": "psalms                                  ",
    "chapter": "101",
    "verse": "4",
    "text": "Бо дні мої щезли, мов дим,"
  },
  {
    "id": 1649,
    "book": "psalms                                  ",
    "chapter": "101",
    "verse": "5",
    "text": "Немов витоптана трава, висохло серце моє,"
  },
  {
    "id": 1650,
    "book": "psalms                                  ",
    "chapter": "101",
    "verse": "6",
    "text": "Від голосу мого зітхання"
  },
  {
    "id": 1651,
    "book": "psalms                                  ",
    "chapter": "101",
    "verse": "7",
    "text": "Я уподібнився до сича в пустелі,"
  },
  {
    "id": 1652,
    "book": "psalms                                  ",
    "chapter": "101",
    "verse": "8",
    "text": "Не сплю, став наче птах,"
  },
  {
    "id": 1653,
    "book": "psalms                                  ",
    "chapter": "101",
    "verse": "9",
    "text": "Щодня вороги мої ганьблять мене,"
  },
  {
    "id": 1654,
    "book": "psalms                                  ",
    "chapter": "101",
    "verse": "10",
    "text": "Я їм попіл замість хліба"
  },
  {
    "id": 1655,
    "book": "psalms                                  ",
    "chapter": "101",
    "verse": "11",
    "text": "через гнів Твій і лють,"
  },
  {
    "id": 1656,
    "book": "psalms                                  ",
    "chapter": "101",
    "verse": "12",
    "text": "Дні мої – немов нахилена тінь,"
  },
  {
    "id": 1657,
    "book": "psalms                                  ",
    "chapter": "101",
    "verse": "13",
    "text": "А Ти, Господи, житимеш повіки,"
  },
  {
    "id": 1658,
    "book": "psalms                                  ",
    "chapter": "101",
    "verse": "14",
    "text": "Ти встанеш, змилуєшся над Сіоном,"
  },
  {
    "id": 1659,
    "book": "psalms                                  ",
    "chapter": "101",
    "verse": "15",
    "text": "Адже слуги Твої уподобали навіть каміння його,"
  },
  {
    "id": 1660,
    "book": "psalms                                  ",
    "chapter": "101",
    "verse": "16",
    "text": "Тоді будуть боятися народи імені Господа,"
  },
  {
    "id": 1661,
    "book": "psalms                                  ",
    "chapter": "101",
    "verse": "17",
    "text": "Бо відбудує Господь Сіон,"
  },
  {
    "id": 1662,
    "book": "psalms                                  ",
    "chapter": "101",
    "verse": "18",
    "text": "Зглянеться на молитву нужденних"
  },
  {
    "id": 1663,
    "book": "psalms                                  ",
    "chapter": "101",
    "verse": "19",
    "text": "Нехай записано це буде для прийдешнього покоління,"
  },
  {
    "id": 1664,
    "book": "psalms                                  ",
    "chapter": "101",
    "verse": "20",
    "text": "Бо Він поглянув із висот святині Своєї,"
  },
  {
    "id": 1665,
    "book": "psalms                                  ",
    "chapter": "101",
    "verse": "21",
    "text": "щоб почути стогони в’язня"
  },
  {
    "id": 1666,
    "book": "psalms                                  ",
    "chapter": "101",
    "verse": "22",
    "text": "щоб сповістити на Сіоні ім’я Господа"
  },
  {
    "id": 1667,
    "book": "psalms                                  ",
    "chapter": "101",
    "verse": "23",
    "text": "коли зберуться народи й царства разом,"
  },
  {
    "id": 1668,
    "book": "psalms                                  ",
    "chapter": "101",
    "verse": "24",
    "text": "Він виснажив силу мою в дорозі,"
  },
  {
    "id": 1669,
    "book": "psalms                                  ",
    "chapter": "101",
    "verse": "25",
    "text": "Я сказав: «Боже мій, не забирай мене в середині днів моїх,"
  },
  {
    "id": 1670,
    "book": "psalms                                  ",
    "chapter": "101",
    "verse": "26",
    "text": "На початку Ти заклав основи землі,"
  },
  {
    "id": 1671,
    "book": "psalms                                  ",
    "chapter": "101",
    "verse": "27",
    "text": "Вони згинуть, а Ти існуватимеш завжди;"
  },
  {
    "id": 1672,
    "book": "psalms                                  ",
    "chapter": "101",
    "verse": "28",
    "text": "Але Ти – Той самий,"
  },
  {
    "id": 1673,
    "book": "psalms                                  ",
    "chapter": "101",
    "verse": "29",
    "text": "Сини рабів Твоїх житимуть,"
  }
]
