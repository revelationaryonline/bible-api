[
  {
    "id": 1133,
    "book": "psalms                                  ",
    "chapter": "72",
    "verse": "1",
    "text": "Псалом Асафів."
  },
  {
    "id": 1134,
    "book": "psalms                                  ",
    "chapter": "72",
    "verse": "2",
    "text": "А в мене ледь не похитнулися мої ноги,"
  },
  {
    "id": 1135,
    "book": "psalms                                  ",
    "chapter": "72",
    "verse": "3",
    "text": "коли я позаздрив нерозумним,"
  },
  {
    "id": 1136,
    "book": "psalms                                  ",
    "chapter": "72",
    "verse": "4",
    "text": "Адже немає в них страждань до самої смерті"
  },
  {
    "id": 1137,
    "book": "psalms                                  ",
    "chapter": "72",
    "verse": "5",
    "text": "Вони вільні від тягарів людських,"
  },
  {
    "id": 1138,
    "book": "psalms                                  ",
    "chapter": "72",
    "verse": "6",
    "text": "Тому пиха вкрила їм шию намистом,"
  },
  {
    "id": 1139,
    "book": "psalms                                  ",
    "chapter": "72",
    "verse": "7",
    "text": "Вирячилися від жиру їхні очі –"
  },
  {
    "id": 1140,
    "book": "psalms                                  ",
    "chapter": "72",
    "verse": "8",
    "text": "Глузують і говорять злісно,"
  },
  {
    "id": 1141,
    "book": "psalms                                  ",
    "chapter": "72",
    "verse": "9",
    "text": "На небеса зазіхають вуста їхні,"
  },
  {
    "id": 1142,
    "book": "psalms                                  ",
    "chapter": "72",
    "verse": "10",
    "text": "Тому туди ж народ Його звертається,"
  },
  {
    "id": 1143,
    "book": "psalms                                  ",
    "chapter": "72",
    "verse": "11",
    "text": "Вони говорять: «Як дізнається Бог?"
  },
  {
    "id": 1144,
    "book": "psalms                                  ",
    "chapter": "72",
    "verse": "12",
    "text": "Ось вони нечестиві, але завжди безтурботні"
  },
  {
    "id": 1145,
    "book": "psalms                                  ",
    "chapter": "72",
    "verse": "13",
    "text": "Так чи не дарма я тримав у чистоті моє серце"
  },
  {
    "id": 1146,
    "book": "psalms                                  ",
    "chapter": "72",
    "verse": "14",
    "text": "Я був уражений картанням цілий день"
  },
  {
    "id": 1147,
    "book": "psalms                                  ",
    "chapter": "72",
    "verse": "15",
    "text": "Якби сказав я сам собі: «Буду міркувати, як вони!»,"
  },
  {
    "id": 1148,
    "book": "psalms                                  ",
    "chapter": "72",
    "verse": "16",
    "text": "І роздумував я, щоб пізнати це,"
  },
  {
    "id": 1149,
    "book": "psalms                                  ",
    "chapter": "72",
    "verse": "17",
    "text": "Аж поки не увійшов я до святилища Божого"
  },
  {
    "id": 1150,
    "book": "psalms                                  ",
    "chapter": "72",
    "verse": "18",
    "text": "Так, Ти ставиш їх на стежках слизьких"
  },
  {
    "id": 1151,
    "book": "psalms                                  ",
    "chapter": "72",
    "verse": "19",
    "text": "Як несподівано вони перетворилися на руїну,"
  },
  {
    "id": 1152,
    "book": "psalms                                  ",
    "chapter": "72",
    "verse": "20",
    "text": "Як сновидіння зникає після пробудження,"
  },
  {
    "id": 1153,
    "book": "psalms                                  ",
    "chapter": "72",
    "verse": "21",
    "text": "Коли ж серце моє гарячилося"
  },
  {
    "id": 1154,
    "book": "psalms                                  ",
    "chapter": "72",
    "verse": "22",
    "text": "тоді я був невігласом і нерозумним,"
  },
  {
    "id": 1155,
    "book": "psalms                                  ",
    "chapter": "72",
    "verse": "23",
    "text": "Та я завжди з Тобою:"
  },
  {
    "id": 1156,
    "book": "psalms                                  ",
    "chapter": "72",
    "verse": "24",
    "text": "Ти ведеш мене Своєю порадою,"
  },
  {
    "id": 1157,
    "book": "psalms                                  ",
    "chapter": "72",
    "verse": "25",
    "text": "Хто є в мене на небі, крім Тебе?"
  },
  {
    "id": 1158,
    "book": "psalms                                  ",
    "chapter": "72",
    "verse": "26",
    "text": "Виснажилося моє тіло й моє серце,"
  },
  {
    "id": 1159,
    "book": "psalms                                  ",
    "chapter": "72",
    "verse": "27",
    "text": "Ось ті, хто далекий від Тебе, загинуть;"
  },
  {
    "id": 1160,
    "book": "psalms                                  ",
    "chapter": "72",
    "verse": "28",
    "text": "А щодо мене, то добре мені наближатися до Бога;"
  }
]
