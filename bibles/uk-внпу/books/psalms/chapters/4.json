[
  {
    "id": 28,
    "book": "psalms                                  ",
    "chapter": "4",
    "verse": "1",
    "text": "Керівнику хору. На струнних інструментах. Псалом Давидів."
  },
  {
    "id": 29,
    "book": "psalms                                  ",
    "chapter": "4",
    "verse": "2",
    "text": "Коли я кличу, дай мені відповідь,"
  },
  {
    "id": 30,
    "book": "psalms                                  ",
    "chapter": "4",
    "verse": "3",
    "text": "О сини людські, доки ви честь мою безчестити будете?"
  },
  {
    "id": 31,
    "book": "psalms                                  ",
    "chapter": "4",
    "verse": "4",
    "text": "Знайте ж, що Господь відокремив для Себе вірного слугу,"
  },
  {
    "id": 32,
    "book": "psalms                                  ",
    "chapter": "4",
    "verse": "5",
    "text": "Тремтіть перед Ним4:5 Або: Гнівайтеся, та не грішіть. і не грішіть;"
  },
  {
    "id": 33,
    "book": "psalms                                  ",
    "chapter": "4",
    "verse": "6",
    "text": "Принесіть жертви правди"
  },
  {
    "id": 34,
    "book": "psalms                                  ",
    "chapter": "4",
    "verse": "7",
    "text": "Багато хто каже: «Хто нам покаже добро?»"
  },
  {
    "id": 35,
    "book": "psalms                                  ",
    "chapter": "4",
    "verse": "8",
    "text": "Ти дав моєму серцю більшу радість,"
  },
  {
    "id": 36,
    "book": "psalms                                  ",
    "chapter": "4",
    "verse": "9",
    "text": "У повному спокої я ляжу й засну,"
  }
]
