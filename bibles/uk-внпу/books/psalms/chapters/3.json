[
  {
    "id": 19,
    "book": "psalms                                  ",
    "chapter": "3",
    "verse": "1",
    "text": "Псалом Давидів, коли він втікав від свого сина Авесалома."
  },
  {
    "id": 20,
    "book": "psalms                                  ",
    "chapter": "3",
    "verse": "2",
    "text": "Господи, як багато супротивників у мене стало!"
  },
  {
    "id": 21,
    "book": "psalms                                  ",
    "chapter": "3",
    "verse": "3",
    "text": "Багато хто каже про мене:"
  },
  {
    "id": 22,
    "book": "psalms                                  ",
    "chapter": "3",
    "verse": "4",
    "text": "Але Ти, Господи, – щит для мене,"
  },
  {
    "id": 23,
    "book": "psalms                                  ",
    "chapter": "3",
    "verse": "5",
    "text": "Голосом моїм я кличу до Господа,"
  },
  {
    "id": 24,
    "book": "psalms                                  ",
    "chapter": "3",
    "verse": "6",
    "text": "Я лягаю і сплю, прокидаюся знову,"
  },
  {
    "id": 25,
    "book": "psalms                                  ",
    "chapter": "3",
    "verse": "7",
    "text": "Не боятимусь я десятків тисяч людей,"
  },
  {
    "id": 26,
    "book": "psalms                                  ",
    "chapter": "3",
    "verse": "8",
    "text": "Повстань, Господи!"
  },
  {
    "id": 27,
    "book": "psalms                                  ",
    "chapter": "3",
    "verse": "9",
    "text": "Тільки в Господа спасіння!"
  }
