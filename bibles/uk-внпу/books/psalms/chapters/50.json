[
  {
    "id": 781,
    "book": "psalms                                  ",
    "chapter": "50",
    "verse": "1",
    "text": "Керівнику хору. Псалом Давидів,"
  },
  {
    "id": 782,
    "book": "psalms                                  ",
    "chapter": "50",
    "verse": "2",
    "text": "коли приходив до нього пророк Натан, після того, як Давид учинив перелюб із Вірсавією.50:2 Див. 2 Сам. 11:1–12:23."
  },
  {
    "id": 783,
    "book": "psalms                                  ",
    "chapter": "50",
    "verse": "3",
    "text": "Помилуй мене, Боже,"
  },
  {
    "id": 784,
    "book": "psalms                                  ",
    "chapter": "50",
    "verse": "4",
    "text": "Обмий мене від переступу мого"
  },
  {
    "id": 785,
    "book": "psalms                                  ",
    "chapter": "50",
    "verse": "5",
    "text": "адже я усвідомлюю беззаконня своє,"
  },
  {
    "id": 786,
    "book": "psalms                                  ",
    "chapter": "50",
    "verse": "6",
    "text": "Проти Тебе Самого згрішив я"
  },
  {
    "id": 787,
    "book": "psalms                                  ",
    "chapter": "50",
    "verse": "7",
    "text": "Ось у беззаконні я народжений,"
  },
  {
    "id": 788,
    "book": "psalms                                  ",
    "chapter": "50",
    "verse": "8",
    "text": "Ось істину Ти вподобав у надрах внутрішнього світу50:8 Буквально: у прихованих місцях; ідеться про глибинний внутрішній світ людини."
  },
  {
    "id": 789,
    "book": "psalms                                  ",
    "chapter": "50",
    "verse": "9",
    "text": "Очисти мене гісопом від гріха – і буду чистий;"
  },
  {
    "id": 790,
    "book": "psalms                                  ",
    "chapter": "50",
    "verse": "10",
    "text": "Дай мені почути звуки веселощів і радості,"
  },
  {
    "id": 791,
    "book": "psalms                                  ",
    "chapter": "50",
    "verse": "11",
    "text": "Відверни обличчя Своє від гріхів моїх"
  },
  {
    "id": 792,
    "book": "psalms                                  ",
    "chapter": "50",
    "verse": "12",
    "text": "Створи в мені серце чисте, Боже,"
  },
  {
    "id": 793,
    "book": "psalms                                  ",
    "chapter": "50",
    "verse": "13",
    "text": "Не відштовхни мене від обличчя Свого"
  },
  {
    "id": 794,
    "book": "psalms                                  ",
    "chapter": "50",
    "verse": "14",
    "text": "Поверни мені радість Твого спасіння"
  },
  {
    "id": 795,
    "book": "psalms                                  ",
    "chapter": "50",
    "verse": "15",
    "text": "Тоді беззаконних я навчатиму шляхів Твоїх"
  },
  {
    "id": 796,
    "book": "psalms                                  ",
    "chapter": "50",
    "verse": "16",
    "text": "Зніми з мене тягар вини кровопролиття, Боже,"
  },
  {
    "id": 797,
    "book": "psalms                                  ",
    "chapter": "50",
    "verse": "17",
    "text": "Володарю, відкрий вуста мої,"
  },
  {
    "id": 798,
    "book": "psalms                                  ",
    "chapter": "50",
    "verse": "18",
    "text": "Бо жертвоприношення Тобі не до вподоби – я приніс би його,"
  },
  {
    "id": 799,
    "book": "psalms                                  ",
    "chapter": "50",
    "verse": "19",
    "text": "Жертва Богові – дух зламаний;"
  },
  {
    "id": 800,
    "book": "psalms                                  ",
    "chapter": "50",
    "verse": "20",
    "text": "Ощаслив Сіон прихильністю Твоєю,"
  },
  {
    "id": 801,
    "book": "psalms                                  ",
    "chapter": "50",
    "verse": "21",
    "text": "Тоді приємними Тобі будуть жертви правди,"
  }
]
