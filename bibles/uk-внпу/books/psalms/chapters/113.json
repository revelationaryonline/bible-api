[
  {
    "id": 1948,
    "book": "psalms                                  ",
    "chapter": "113",
    "verse": "1",
    "text": "Коли Ізраїль виходив з Єгипту,"
  },
  {
    "id": 1949,
    "book": "psalms                                  ",
    "chapter": "113",
    "verse": "2",
    "text": "тоді Юда став Його святинею,"
  },
  {
    "id": 1950,
    "book": "psalms                                  ",
    "chapter": "113",
    "verse": "3",
    "text": "Море побачило це й кинулося навтіки,"
  },
  {
    "id": 1951,
    "book": "psalms                                  ",
    "chapter": "113",
    "verse": "4",
    "text": "Гори скакали, немов барани,"
  },
  {
    "id": 1952,
    "book": "psalms                                  ",
    "chapter": "113",
    "verse": "5",
    "text": "Що з тобою, море, що ти втікаєш,"
  },
  {
    "id": 1953,
    "book": "psalms                                  ",
    "chapter": "113",
    "verse": "6",
    "text": "Що це ви, гори, скакаєте, як барани,"
  },
  {
    "id": 1954,
    "book": "psalms                                  ",
    "chapter": "113",
    "verse": "7",
    "text": "Тремти, земле, перед Володарем,"
  },
  {
    "id": 1955,
    "book": "psalms                                  ",
    "chapter": "113",
    "verse": "8",
    "text": "Який перетворює скелю на водойму,"
  },
  {
    "id": 1956,
    "book": "psalms                                  ",
    "chapter": "113",
    "verse": "9",
    "text": "Не нам, Господи, не нам,"
  },
  {
    "id": 1957,
    "book": "psalms                                  ",
    "chapter": "113",
    "verse": "10",
    "text": "Чому б народи говорили:"
  },
  {
    "id": 1958,
    "book": "psalms                                  ",
    "chapter": "113",
    "verse": "11",
    "text": "А Бог наш на небесах,"
  },
  {
    "id": 1959,
    "book": "psalms                                  ",
    "chapter": "113",
    "verse": "12",
    "text": "Ідоли їхні – срібло й золото,"
  },
  {
    "id": 1960,
    "book": "psalms                                  ",
    "chapter": "113",
    "verse": "13",
    "text": "У них є вуста, але вони не говорять;"
  },
  {
    "id": 1961,
    "book": "psalms                                  ",
    "chapter": "113",
    "verse": "14",
    "text": "у них є вуха, але не чують;"
  },
  {
    "id": 1962,
    "book": "psalms                                  ",
    "chapter": "113",
    "verse": "15",
    "text": "у них є руки, але не відчувають дотику;"
  },
  {
    "id": 1963,
    "book": "psalms                                  ",
    "chapter": "113",
    "verse": "16",
    "text": "Подібними до них нехай стануть ті, хто їх робить,"
  },
  {
    "id": 1964,
    "book": "psalms                                  ",
    "chapter": "113",
    "verse": "17",
    "text": "Ізраїлю, покладай надію на Господа –"
  },
  {
    "id": 1965,
    "book": "psalms                                  ",
    "chapter": "113",
    "verse": "18",
    "text": "Доме Ааронів, покладай надію на Господа –"
  },
  {
    "id": 1966,
    "book": "psalms                                  ",
    "chapter": "113",
    "verse": "19",
    "text": "Ті, хто Господа боїться, покладайте надію на Господа –"
  },
  {
    "id": 1967,
    "book": "psalms                                  ",
    "chapter": "113",
    "verse": "20",
    "text": "Господь пам’ятає нас і благословить:"
  },
  {
    "id": 1968,
    "book": "psalms                                  ",
    "chapter": "113",
    "verse": "21",
    "text": "благословить тих, хто боїться Господа,"
  },
  {
    "id": 1969,
    "book": "psalms                                  ",
    "chapter": "113",
    "verse": "22",
    "text": "Нехай Господь примножить вам добро,"
  },
  {
    "id": 1970,
    "book": "psalms                                  ",
    "chapter": "113",
    "verse": "23",
    "text": "Благословенні ви у Господа,"
  },
  {
    "id": 1971,
    "book": "psalms                                  ",
    "chapter": "113",
    "verse": "24",
    "text": "Небеса – Господеві належить небо,"
  },
  {
    "id": 1972,
    "book": "psalms                                  ",
    "chapter": "113",
    "verse": "25",
    "text": "Не мертві хвалитимуть Господа"
  },
  {
    "id": 1973,
    "book": "psalms                                  ",
    "chapter": "113",
    "verse": "26",
    "text": "але ми благословлятимемо Господа"
  }
]
