[
  {
    "id": 2024,
    "book": "psalms                                  ",
    "chapter": "118",
    "verse": "1",
    "text": "Блаженні ті, чия дорога невинна,"
  },
  {
    "id": 2025,
    "book": "psalms                                  ",
    "chapter": "118",
    "verse": "2",
    "text": "Блаженні ті, що дотримуються одкровень Його,"
  },
  {
    "id": 2026,
    "book": "psalms                                  ",
    "chapter": "118",
    "verse": "3",
    "text": "Вони не чинять беззаконня,"
  },
  {
    "id": 2027,
    "book": "psalms                                  ",
    "chapter": "118",
    "verse": "4",
    "text": "Ти заповів настанов Твоїх"
  },
  {
    "id": 2028,
    "book": "psalms                                  ",
    "chapter": "118",
    "verse": "5",
    "text": "О, якби утверджувалися дороги мої"
  },
  {
    "id": 2029,
    "book": "psalms                                  ",
    "chapter": "118",
    "verse": "6",
    "text": "Тоді не посоромився б я,"
  },
  {
    "id": 2030,
    "book": "psalms                                  ",
    "chapter": "118",
    "verse": "7",
    "text": "Буду славити Тебе в щирості серця,"
  },
  {
    "id": 2031,
    "book": "psalms                                  ",
    "chapter": "118",
    "verse": "8",
    "text": "Постанов Твоїх я дотримуватися буду,"
  },
  {
    "id": 2032,
    "book": "psalms                                  ",
    "chapter": "118",
    "verse": "9",
    "text": "Як зможе юнак тримати стежку свою в чистоті?"
  },
  {
    "id": 2033,
    "book": "psalms                                  ",
    "chapter": "118",
    "verse": "10",
    "text": "Усім серцем моїм шукаю Тебе,"
  },
  {
    "id": 2034,
    "book": "psalms                                  ",
    "chapter": "118",
    "verse": "11",
    "text": "У серці моєму сховав я сказане Тобою,"
  },
  {
    "id": 2035,
    "book": "psalms                                  ",
    "chapter": "118",
    "verse": "12",
    "text": "Благословенний Ти, Господи!"
  },
  {
    "id": 2036,
    "book": "psalms                                  ",
    "chapter": "118",
    "verse": "13",
    "text": "Вустами моїми я звіщаю"
  },
  {
    "id": 2037,
    "book": "psalms                                  ",
    "chapter": "118",
    "verse": "14",
    "text": "На шляху одкровень Твоїх радію я,"
  },
  {
    "id": 2038,
    "book": "psalms                                  ",
    "chapter": "118",
    "verse": "15",
    "text": "Про настанови Твої я роздумую"
  },
  {
    "id": 2039,
    "book": "psalms                                  ",
    "chapter": "118",
    "verse": "16",
    "text": "Я підбадьорююся постановами Твоїми,"
  },
  {
    "id": 2040,
    "book": "psalms                                  ",
    "chapter": "118",
    "verse": "17",
    "text": "Віддяч добром слузі Своєму,"
  },
  {
    "id": 2041,
    "book": "psalms                                  ",
    "chapter": "118",
    "verse": "18",
    "text": "Відкрий мої очі,"
  },
  {
    "id": 2042,
    "book": "psalms                                  ",
    "chapter": "118",
    "verse": "19",
    "text": "Приходьком живу я на землі,"
  },
  {
    "id": 2043,
    "book": "psalms                                  ",
    "chapter": "118",
    "verse": "20",
    "text": "Зомліла душа моя,"
  },
  {
    "id": 2044,
    "book": "psalms                                  ",
    "chapter": "118",
    "verse": "21",
    "text": "Ти звинуватив проклятих зухвальців,"
  },
  {
    "id": 2045,
    "book": "psalms                                  ",
    "chapter": "118",
    "verse": "22",
    "text": "Зніми з мене ганьбу й сором,"
  },
  {
    "id": 2046,
    "book": "psalms                                  ",
    "chapter": "118",
    "verse": "23",
    "text": "Хоча князі сидять і змовляються проти мене,"
  },
  {
    "id": 2047,
    "book": "psalms                                  ",
    "chapter": "118",
    "verse": "24",
    "text": "Одкровення ж Твої – мої радощі,"
  },
  {
    "id": 2048,
    "book": "psalms                                  ",
    "chapter": "118",
    "verse": "25",
    "text": "Прилинула до пороху душа моя,"
  },
  {
    "id": 2049,
    "book": "psalms                                  ",
    "chapter": "118",
    "verse": "26",
    "text": "Я розповів Тобі про дороги свої,"
  },
  {
    "id": 2050,
    "book": "psalms                                  ",
    "chapter": "118",
    "verse": "27",
    "text": "Дай мені зрозуміти шлях настанов Твоїх,"
  },
  {
    "id": 2051,
    "book": "psalms                                  ",
    "chapter": "118",
    "verse": "28",
    "text": "Розпливлася від смутку душа моя,"
  },
  {
    "id": 2052,
    "book": "psalms                                  ",
    "chapter": "118",
    "verse": "29",
    "text": "Дорогу неправди віддали від мене"
  },
  {
    "id": 2053,
    "book": "psalms                                  ",
    "chapter": "118",
    "verse": "30",
    "text": "Я обрав дорогу істини,"
  },
  {
    "id": 2054,
    "book": "psalms                                  ",
    "chapter": "118",
    "verse": "31",
    "text": "Я прилинув до одкровень Твоїх, Господи,"
  },
  {
    "id": 2055,
    "book": "psalms                                  ",
    "chapter": "118",
    "verse": "32",
    "text": "Побіжу я дорогою заповідей Твоїх,"
  },
  {
    "id": 2056,
    "book": "psalms                                  ",
    "chapter": "118",
    "verse": "33",
    "text": "Навчи мене, Господи, шляху постанов Твоїх,"
  },
  {
    "id": 2057,
    "book": "psalms                                  ",
    "chapter": "118",
    "verse": "34",
    "text": "Дай мені розуміння, і я дотримуватися Закону Твого буду"
  },
  {
    "id": 2058,
    "book": "psalms                                  ",
    "chapter": "118",
    "verse": "35",
    "text": "Поведи мене стежкою заповідей Твоїх,"
  },
  {
    "id": 2059,
    "book": "psalms                                  ",
    "chapter": "118",
    "verse": "36",
    "text": "Прихили серце моє до Твоїх одкровень,"
  },
  {
    "id": 2060,
    "book": "psalms                                  ",
    "chapter": "118",
    "verse": "37",
    "text": "Відведи очі мої, щоб не бачили марноти;"
  },
  {
    "id": 2061,
    "book": "psalms                                  ",
    "chapter": "118",
    "verse": "38",
    "text": "Виконай усе сказане Тобою рабові Своєму,"
  },
  {
    "id": 2062,
    "book": "psalms                                  ",
    "chapter": "118",
    "verse": "39",
    "text": "Відверни від мене ганьбу, якої я жахаюся,"
  },
  {
    "id": 2063,
    "book": "psalms                                  ",
    "chapter": "118",
    "verse": "40",
    "text": "О, як я прагну настанов Твоїх!"
  },
  {
    "id": 2064,
    "book": "psalms                                  ",
    "chapter": "118",
    "verse": "41",
    "text": "Нехай прийде до мене, Господи, милість Твоя,"
  },
  {
    "id": 2065,
    "book": "psalms                                  ",
    "chapter": "118",
    "verse": "42",
    "text": "Тоді відповім я тому, хто словом ганьбить мене,"
  },
  {
    "id": 2066,
    "book": "psalms                                  ",
    "chapter": "118",
    "verse": "43",
    "text": "Ніколи не забирай слова істини від моїх вуст,"
  },
  {
    "id": 2067,
    "book": "psalms                                  ",
    "chapter": "118",
    "verse": "44",
    "text": "Я буду дотримуватися Закону Твого завжди,"
  },
  {
    "id": 2068,
    "book": "psalms                                  ",
    "chapter": "118",
    "verse": "45",
    "text": "і ходитиму вільно,"
  },
  {
    "id": 2069,
    "book": "psalms                                  ",
    "chapter": "118",
    "verse": "46",
    "text": "І говоритиму я про одкровення Твої перед царями,"
  },
  {
    "id": 2070,
    "book": "psalms                                  ",
    "chapter": "118",
    "verse": "47",
    "text": "і радітиму Твоїм заповідям,"
  },
  {
    "id": 2071,
    "book": "psalms                                  ",
    "chapter": "118",
    "verse": "48",
    "text": "Тоді простягну долоні свої до заповідей Твоїх,"
  },
  {
    "id": 2072,
    "book": "psalms                                  ",
    "chapter": "118",
    "verse": "49",
    "text": "Згадай слово Своє до слуги Твого,"
  },
  {
    "id": 2073,
    "book": "psalms                                  ",
    "chapter": "118",
    "verse": "50",
    "text": "Це – втіха у скорботі моїй,"
  },
  {
    "id": 2074,
    "book": "psalms                                  ",
    "chapter": "118",
    "verse": "51",
    "text": "Зухвальці надмірно насміхаються з мене,"
  },
  {
    "id": 2075,
    "book": "psalms                                  ",
    "chapter": "118",
    "verse": "52",
    "text": "Згадую Твої одвічні закони правосуддя, Господи,"
  },
  {
    "id": 2076,
    "book": "psalms                                  ",
    "chapter": "118",
    "verse": "53",
    "text": "Жах охоплює мене через нечестивців,"
  },
  {
    "id": 2077,
    "book": "psalms                                  ",
    "chapter": "118",
    "verse": "54",
    "text": "Співом стали для мене постанови Твої"
  },
  {
    "id": 2078,
    "book": "psalms                                  ",
    "chapter": "118",
    "verse": "55",
    "text": "Я згадую вночі ім’я Твоє, Господи,"
  },
  {
    "id": 2079,
    "book": "psalms                                  ",
    "chapter": "118",
    "verse": "56",
    "text": "Моїм він став,"
  },
  {
    "id": 2080,
    "book": "psalms                                  ",
    "chapter": "118",
    "verse": "57",
    "text": "Господи, – сказав я, – доля моя –"
  },
  {
    "id": 2081,
    "book": "psalms                                  ",
    "chapter": "118",
    "verse": "58",
    "text": "Шукав я прихильності обличчя Твого усім серцем:"
  },
  {
    "id": 2082,
    "book": "psalms                                  ",
    "chapter": "118",
    "verse": "59",
    "text": "Я обдумував дороги свої"
  },
  {
    "id": 2083,
    "book": "psalms                                  ",
    "chapter": "118",
    "verse": "60",
    "text": "поспішав і не зволікав"
  },
  {
    "id": 2084,
    "book": "psalms                                  ",
    "chapter": "118",
    "verse": "61",
    "text": "Кайдани нечестивців облягли мене,"
  },
  {
    "id": 2085,
    "book": "psalms                                  ",
    "chapter": "118",
    "verse": "62",
    "text": "Опівночі вставав я славити Тебе"
  },
  {
    "id": 2086,
    "book": "psalms                                  ",
    "chapter": "118",
    "verse": "63",
    "text": "Я спільник усім, хто боїться Тебе"
  },
  {
    "id": 2087,
    "book": "psalms                                  ",
    "chapter": "118",
    "verse": "64",
    "text": "Милістю Твоєю, Господи, наповнена земля;"
  },
  {
    "id": 2088,
    "book": "psalms                                  ",
    "chapter": "118",
    "verse": "65",
    "text": "Добре вчинив Ти зі слугою Своїм"
  },
  {
    "id": 2089,
    "book": "psalms                                  ",
    "chapter": "118",
    "verse": "66",
    "text": "Доброго розуміння й пізнання навчи мене,"
  },
  {
    "id": 2090,
    "book": "psalms                                  ",
    "chapter": "118",
    "verse": "67",
    "text": "Перш ніж я зазнав страждання мого, я блукав,"
  },
  {
    "id": 2091,
    "book": "psalms                                  ",
    "chapter": "118",
    "verse": "68",
    "text": "Добрий Ти і чиниш добро,"
  },
  {
    "id": 2092,
    "book": "psalms                                  ",
    "chapter": "118",
    "verse": "69",
    "text": "Плетуть зухвальці на мене неправду,"
  },
  {
    "id": 2093,
    "book": "psalms                                  ",
    "chapter": "118",
    "verse": "70",
    "text": "Нечулим, немов лій, стало їхнє серце,"
  },
  {
    "id": 2094,
    "book": "psalms                                  ",
    "chapter": "118",
    "verse": "71",
    "text": "Добре мені, що постраждав я,"
  },
  {
    "id": 2095,
    "book": "psalms                                  ",
    "chapter": "118",
    "verse": "72",
    "text": "Ліпший для мене Закон Твій,"
  },
  {
    "id": 2096,
    "book": "psalms                                  ",
    "chapter": "118",
    "verse": "73",
    "text": "Руки Твої створили й утвердили мене;"
  },
  {
    "id": 2097,
    "book": "psalms                                  ",
    "chapter": "118",
    "verse": "74",
    "text": "Побачать мене ті, хто боїться Тебе, і зрадіють,"
  },
  {
    "id": 2098,
    "book": "psalms                                  ",
    "chapter": "118",
    "verse": "75",
    "text": "Я знаю, Господи, що справедливі суди Твої,"
  },
  {
    "id": 2099,
    "book": "psalms                                  ",
    "chapter": "118",
    "verse": "76",
    "text": "Нехай милість Твоя стане втіхою моєю,"
  },
  {
    "id": 2100,
    "book": "psalms                                  ",
    "chapter": "118",
    "verse": "77",
    "text": "Нехай прийде до мене милосердя Твоє, і я оживу,"
  },
  {
    "id": 2101,
    "book": "psalms                                  ",
    "chapter": "118",
    "verse": "78",
    "text": "Нехай же посоромляться зухвальці за те,"
  },
  {
    "id": 2102,
    "book": "psalms                                  ",
    "chapter": "118",
    "verse": "79",
    "text": "Нехай навернуться до мене ті, хто боїться Тебе"
  },
  {
    "id": 2103,
    "book": "psalms                                  ",
    "chapter": "118",
    "verse": "80",
    "text": "Нехай серце моє буде невинним щодо постанов Твоїх,"
  },
  {
    "id": 2104,
    "book": "psalms                                  ",
    "chapter": "118",
    "verse": "81",
    "text": "Знемагає душа моя від туги за спасінням Твоїм,"
  },
  {
    "id": 2105,
    "book": "psalms                                  ",
    "chapter": "118",
    "verse": "82",
    "text": "Тануть очі мої, на слово Твоє чекаючи"
  },
  {
    "id": 2106,
    "book": "psalms                                  ",
    "chapter": "118",
    "verse": "83",
    "text": "Бо я став, немов міх у диму,"
  },
  {
    "id": 2107,
    "book": "psalms                                  ",
    "chapter": "118",
    "verse": "84",
    "text": "Скільки днів відведено слузі Твоєму?"
  },
  {
    "id": 2108,
    "book": "psalms                                  ",
    "chapter": "118",
    "verse": "85",
    "text": "Зухвальці викопали мені ями"
  },
  {
    "id": 2109,
    "book": "psalms                                  ",
    "chapter": "118",
    "verse": "86",
    "text": "Усі заповіді Твої – істина."
  },
  {
    "id": 2110,
    "book": "psalms                                  ",
    "chapter": "118",
    "verse": "87",
    "text": "Мало не згубили мене на землі,"
  },
  {
    "id": 2111,
    "book": "psalms                                  ",
    "chapter": "118",
    "verse": "88",
    "text": "За милістю Своєю оживи мене,"
  },
  {
    "id": 2112,
    "book": "psalms                                  ",
    "chapter": "118",
    "verse": "89",
    "text": "Навіки, Господи, слово Твоє"
  },
  {
    "id": 2113,
    "book": "psalms                                  ",
    "chapter": "118",
    "verse": "90",
    "text": "з роду в рід – вірність Твоя."
  },
  {
    "id": 2114,
    "book": "psalms                                  ",
    "chapter": "118",
    "verse": "91",
    "text": "за Твоїми законами правосуддя все стоїть донині,"
  },
  {
    "id": 2115,
    "book": "psalms                                  ",
    "chapter": "118",
    "verse": "92",
    "text": "Якби Закон Твій не був моєю втіхою,"
  },
  {
    "id": 2116,
    "book": "psalms                                  ",
    "chapter": "118",
    "verse": "93",
    "text": "Я повіки не забуду настанов Твоїх,"
  },
  {
    "id": 2117,
    "book": "psalms                                  ",
    "chapter": "118",
    "verse": "94",
    "text": "Я – Твій, врятуй же мене,"
  },
  {
    "id": 2118,
    "book": "psalms                                  ",
    "chapter": "118",
    "verse": "95",
    "text": "Нечестиві очікують, щоб погубити мене,"
  },
  {
    "id": 2119,
    "book": "psalms                                  ",
    "chapter": "118",
    "verse": "96",
    "text": "Я бачив межу всілякої досконалості,"
  },
  {
    "id": 2120,
    "book": "psalms                                  ",
    "chapter": "118",
    "verse": "97",
    "text": "Як люблю я Закон Твій!"
  },
  {
    "id": 2121,
    "book": "psalms                                  ",
    "chapter": "118",
    "verse": "98",
    "text": "Заповіддю Своєю Ти зробив мене мудрішим від ворогів моїх,"
  },
  {
    "id": 2122,
    "book": "psalms                                  ",
    "chapter": "118",
    "verse": "99",
    "text": "Я став розумнішим від усіх вчителів моїх,"
  },
  {
    "id": 2123,
    "book": "psalms                                  ",
    "chapter": "118",
    "verse": "100",
    "text": "Я розумію більше, ніж старці,"
  },
  {
    "id": 2124,
    "book": "psalms                                  ",
    "chapter": "118",
    "verse": "101",
    "text": "Від усілякої лихої стежки утримую ноги мої,"
  },
  {
    "id": 2125,
    "book": "psalms                                  ",
    "chapter": "118",
    "verse": "102",
    "text": "Від Твоїх законів правосуддя не відступаю,"
  },
  {
    "id": 2126,
    "book": "psalms                                  ",
    "chapter": "118",
    "verse": "103",
    "text": "Які солодкі для мого піднебіння слова Твої!"
  },
  {
    "id": 2127,
    "book": "psalms                                  ",
    "chapter": "118",
    "verse": "104",
    "text": "Від настанов Твоїх я набираюсь розуміння,"
  },
  {
    "id": 2128,
    "book": "psalms                                  ",
    "chapter": "118",
    "verse": "105",
    "text": "Слово Твоє – світильник для ноги моєї"
  },
  {
    "id": 2129,
    "book": "psalms                                  ",
    "chapter": "118",
    "verse": "106",
    "text": "Присягнув я виконувати справедливі закони правосуддя Твого"
  },
  {
    "id": 2130,
    "book": "psalms                                  ",
    "chapter": "118",
    "verse": "107",
    "text": "Постраждав я занадто, Господи,"
  },
  {
    "id": 2131,
    "book": "psalms                                  ",
    "chapter": "118",
    "verse": "108",
    "text": "Добровільні жертви вуст моїх"
  },
  {
    "id": 2132,
    "book": "psalms                                  ",
    "chapter": "118",
    "verse": "109",
    "text": "Душа моя завжди в моїй руці,118:109 Або: завжди в небезпеці."
  },
  {
    "id": 2133,
    "book": "psalms                                  ",
    "chapter": "118",
    "verse": "110",
    "text": "Нечестиві розставили тенета для мене,"
  },
  {
    "id": 2134,
    "book": "psalms                                  ",
    "chapter": "118",
    "verse": "111",
    "text": "Я прийняв, як вічний спадок, одкровення Твої,"
  },
  {
    "id": 2135,
    "book": "psalms                                  ",
    "chapter": "118",
    "verse": "112",
    "text": "Нахилив я серце своє до того,"
  },
  {
    "id": 2136,
    "book": "psalms                                  ",
    "chapter": "118",
    "verse": "113",
    "text": "Ненавиджу двоєдушних людей,118:113 Буквально: розділених."
  },
  {
    "id": 2137,
    "book": "psalms                                  ",
    "chapter": "118",
    "verse": "114",
    "text": "Ти – сховище моє й щит;"
  },
  {
    "id": 2138,
    "book": "psalms                                  ",
    "chapter": "118",
    "verse": "115",
    "text": "Відступіться від мене, злодії,"
  },
  {
    "id": 2139,
    "book": "psalms                                  ",
    "chapter": "118",
    "verse": "116",
    "text": "Підтримай мене згідно зі словом Твоїм, і я житиму;"
  },
  {
    "id": 2140,
    "book": "psalms                                  ",
    "chapter": "118",
    "verse": "117",
    "text": "Підтримай мене, і я буду врятований,"
  },
  {
    "id": 2141,
    "book": "psalms                                  ",
    "chapter": "118",
    "verse": "118",
    "text": "Ти відкидаєш усіх, хто ухиляється від постанов Твоїх,"
  },
  {
    "id": 2142,
    "book": "psalms                                  ",
    "chapter": "118",
    "verse": "119",
    "text": "Немов золу, відкинеш Ти усіх нечестивців землі;"
  },
  {
    "id": 2143,
    "book": "psalms                                  ",
    "chapter": "118",
    "verse": "120",
    "text": "Тремтить від страху перед Тобою тіло моє,"
  },
  {
    "id": 2144,
    "book": "psalms                                  ",
    "chapter": "118",
    "verse": "121",
    "text": "Я чинив правосудно й справедливо, –"
  },
  {
    "id": 2145,
    "book": "psalms                                  ",
    "chapter": "118",
    "verse": "122",
    "text": "Заступися за слугу Свого на добро,"
  },
  {
    "id": 2146,
    "book": "psalms                                  ",
    "chapter": "118",
    "verse": "123",
    "text": "Очі мої тануть, чекаючи на Твій порятунок"
  },
  {
    "id": 2147,
    "book": "psalms                                  ",
    "chapter": "118",
    "verse": "124",
    "text": "Вчини з рабом Своїм за милістю Твоєю"
  },
  {
    "id": 2148,
    "book": "psalms                                  ",
    "chapter": "118",
    "verse": "125",
    "text": "Я – слуга Твій, настав мене,"
  },
  {
    "id": 2149,
    "book": "psalms                                  ",
    "chapter": "118",
    "verse": "126",
    "text": "Час діяти, Господи:"
  },
  {
    "id": 2150,
    "book": "psalms                                  ",
    "chapter": "118",
    "verse": "127",
    "text": "Тому полюбив я заповіді Твої"
  },
  {
    "id": 2151,
    "book": "psalms                                  ",
    "chapter": "118",
    "verse": "128",
    "text": "тому всі настанови Твої визнаю справедливими,"
  },
  {
    "id": 2152,
    "book": "psalms                                  ",
    "chapter": "118",
    "verse": "129",
    "text": "Дивовижні одкровення Твої,"
  },
  {
    "id": 2153,
    "book": "psalms                                  ",
    "chapter": "118",
    "verse": "130",
    "text": "Розкриття Твоїх слів просвітлює,"
  },
  {
    "id": 2154,
    "book": "psalms                                  ",
    "chapter": "118",
    "verse": "131",
    "text": "Уста свої розкриваю й прагну,"
  },
  {
    "id": 2155,
    "book": "psalms                                  ",
    "chapter": "118",
    "verse": "132",
    "text": "Обернися до мене й змилуйся,"
  },
  {
    "id": 2156,
    "book": "psalms                                  ",
    "chapter": "118",
    "verse": "133",
    "text": "Зміцни мої стопи словом Твоїм"
  },
  {
    "id": 2157,
    "book": "psalms                                  ",
    "chapter": "118",
    "verse": "134",
    "text": "Визволи мене від гноблення людського,"
  },
  {
    "id": 2158,
    "book": "psalms                                  ",
    "chapter": "118",
    "verse": "135",
    "text": "Обличчям Своїм осяй слугу Твого"
  },
  {
    "id": 2159,
    "book": "psalms                                  ",
    "chapter": "118",
    "verse": "136",
    "text": "Потоками водними течуть мої очі,"
  },
  {
    "id": 2160,
    "book": "psalms                                  ",
    "chapter": "118",
    "verse": "137",
    "text": "Праведний Ти, Господи,"
  },
  {
    "id": 2161,
    "book": "psalms                                  ",
    "chapter": "118",
    "verse": "138",
    "text": "Одкровення, заповідані Тобою,"
  },
  {
    "id": 2162,
    "book": "psalms                                  ",
    "chapter": "118",
    "verse": "139",
    "text": "Знесилився я через ревність мою,"
  },
  {
    "id": 2163,
    "book": "psalms                                  ",
    "chapter": "118",
    "verse": "140",
    "text": "Слово Твоє випробуване досконало,"
  },
  {
    "id": 2164,
    "book": "psalms                                  ",
    "chapter": "118",
    "verse": "141",
    "text": "Я нікчемний і зганьблений,"
  },
  {
    "id": 2165,
    "book": "psalms                                  ",
    "chapter": "118",
    "verse": "142",
    "text": "Правда Твоя – правда вічна,"
  },
  {
    "id": 2166,
    "book": "psalms                                  ",
    "chapter": "118",
    "verse": "143",
    "text": "Тіснота й скорбота спіткали мене,"
  },
  {
    "id": 2167,
    "book": "psalms                                  ",
    "chapter": "118",
    "verse": "144",
    "text": "Правда одкровень Твоїх вічна,"
  },
  {
    "id": 2168,
    "book": "psalms                                  ",
    "chapter": "118",
    "verse": "145",
    "text": "Я кличу всім серцем – дай мені відповідь, Господи,"
  },
  {
    "id": 2169,
    "book": "psalms                                  ",
    "chapter": "118",
    "verse": "146",
    "text": "Я кличу Тебе, врятуй мене,"
  },
  {
    "id": 2170,
    "book": "psalms                                  ",
    "chapter": "118",
    "verse": "147",
    "text": "Перед ранковими сутінками волаю я,"
  },
  {
    "id": 2171,
    "book": "psalms                                  ",
    "chapter": "118",
    "verse": "148",
    "text": "Випереджають очі мої ранкову сторожу,118:148 У давнину нічний час поділявся на три сторожі відповідно до трьох змін варти на міських мурах: від заходу сонця до півночі, від півночі до глибокої ночі, від глибокої ночі до світанку (ранкова сторожа)."
  },
  {
    "id": 2172,
    "book": "psalms                                  ",
    "chapter": "118",
    "verse": "149",
    "text": "Почуй мій голос заради милості Твоєї, Господи,"
  },
  {
    "id": 2173,
    "book": "psalms                                  ",
    "chapter": "118",
    "verse": "150",
    "text": "Наблизилися до мене зловмисники,"
  },
  {
    "id": 2174,
    "book": "psalms                                  ",
    "chapter": "118",
    "verse": "151",
    "text": "Ти ж близько, Господи,"
  },
  {
    "id": 2175,
    "book": "psalms                                  ",
    "chapter": "118",
    "verse": "152",
    "text": "Здавна знаю я про одкровення Твої,"
  },
  {
    "id": 2176,
    "book": "psalms                                  ",
    "chapter": "118",
    "verse": "153",
    "text": "Поглянь на приниження моє й визволи мене,"
  },
  {
    "id": 2177,
    "book": "psalms                                  ",
    "chapter": "118",
    "verse": "154",
    "text": "Вступися в судову тяганину мою й визволи мене,"
  },
  {
    "id": 2178,
    "book": "psalms                                  ",
    "chapter": "118",
    "verse": "155",
    "text": "Далеке від нечестивців спасіння,"
  },
  {
    "id": 2179,
    "book": "psalms                                  ",
    "chapter": "118",
    "verse": "156",
    "text": "Щедроти Твої численні, Господи,"
  },
  {
    "id": 2180,
    "book": "psalms                                  ",
    "chapter": "118",
    "verse": "157",
    "text": "Численні переслідувачі й супротивники мої,"
  },
  {
    "id": 2181,
    "book": "psalms                                  ",
    "chapter": "118",
    "verse": "158",
    "text": "Дивлюся на відступників з огидою,"
  },
  {
    "id": 2182,
    "book": "psalms                                  ",
    "chapter": "118",
    "verse": "159",
    "text": "Подивися, як люблю я Твої настанови,"
  },
  {
    "id": 2183,
    "book": "psalms                                  ",
    "chapter": "118",
    "verse": "160",
    "text": "Сутність слів Твоїх – істина,"
  },
  {
    "id": 2184,
    "book": "psalms                                  ",
    "chapter": "118",
    "verse": "161",
    "text": "Князі переслідують мене безвинно,"
  },
  {
    "id": 2185,
    "book": "psalms                                  ",
    "chapter": "118",
    "verse": "162",
    "text": "Радію я слову Твоєму,"
  },
  {
    "id": 2186,
    "book": "psalms                                  ",
    "chapter": "118",
    "verse": "163",
    "text": "Я ненавиджу неправду, бриджуся нею,"
  },
  {
    "id": 2187,
    "book": "psalms                                  ",
    "chapter": "118",
    "verse": "164",
    "text": "Сім разів на день прославляю Тебе"
  },
  {
    "id": 2188,
    "book": "psalms                                  ",
    "chapter": "118",
    "verse": "165",
    "text": "Великий мир у тих, хто любить Закон Твій,"
  },
  {
    "id": 2189,
    "book": "psalms                                  ",
    "chapter": "118",
    "verse": "166",
    "text": "Очікую спасіння Твого, Господи,"
  },
  {
    "id": 2190,
    "book": "psalms                                  ",
    "chapter": "118",
    "verse": "167",
    "text": "Душа моя береже одкровення Твої"
  },
  {
    "id": 2191,
    "book": "psalms                                  ",
    "chapter": "118",
    "verse": "168",
    "text": "Я дотримуюсь настанов і одкровень Твоїх,"
  },
  {
    "id": 2192,
    "book": "psalms                                  ",
    "chapter": "118",
    "verse": "169",
    "text": "Нехай наблизиться волання моє до обличчя Твого, Господи,"
  },
  {
    "id": 2193,
    "book": "psalms                                  ",
    "chapter": "118",
    "verse": "170",
    "text": "Нехай прийде благання моє перед обличчя Твоє,"
  },
  {
    "id": 2194,
    "book": "psalms                                  ",
    "chapter": "118",
    "verse": "171",
    "text": "Переливатимуться вуста мої хвалою,"
  },
  {
    "id": 2195,
    "book": "psalms                                  ",
    "chapter": "118",
    "verse": "172",
    "text": "Проголошуватиме язик мій слово Твоє,"
  },
  {
    "id": 2196,
    "book": "psalms                                  ",
    "chapter": "118",
    "verse": "173",
    "text": "Нехай рука Твоя буде мені допомогою,"
  },
  {
    "id": 2197,
    "book": "psalms                                  ",
    "chapter": "118",
    "verse": "174",
    "text": "Я прагну спасіння Твого, Господи,"
  },
  {
    "id": 2198,
    "book": "psalms                                  ",
    "chapter": "118",
    "verse": "175",
    "text": "Нехай живе душа моя й прославляє Тебе"
  },
  {
    "id": 2199,
    "book": "psalms                                  ",
    "chapter": "118",
    "verse": "176",
    "text": "Заблукав я, немов вівця загублена."
  }
]
