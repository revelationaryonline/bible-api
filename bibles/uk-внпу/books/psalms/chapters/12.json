    "verse": "1",
    "text": "Керівнику хору. Псалом Давидів."
  },
  {
    "id": 145,
    "book": "psalms                                  ",
    "chapter": "12",
    "verse": "2",
    "text": "Доки, Господи? Невже Ти забув мене навіки?"
  },
  {
    "id": 146,
    "book": "psalms                                  ",
    "chapter": "12",
    "verse": "3",
    "text": "Доки тяжкі роздуми носитиму я в душі своїй"
