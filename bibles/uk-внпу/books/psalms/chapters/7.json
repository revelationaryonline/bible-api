[
  {
    "id": 61,
    "book": "psalms                                  ",
    "chapter": "7",
    "verse": "1",
    "text": "Жалобна пісня7:1 Значення давньоєврейського слова шіґґайо́н невідоме, воно зустрічається також у Книзі Пророка Аввакума 3:1 у формі шіґйоно́т; можливо, походить від кореня, що означає бути виразним, сяяти, тобто виразна, емоційна пісня. Давида, яку він співав Господеві стосовно Куша, із коліна Веніаміна."
  },
  {
    "id": 62,
    "book": "psalms                                  ",
    "chapter": "7",
    "verse": "2",
    "text": "Господи, Боже мій, на Тебе я надію покладаю."
  },
  {
    "id": 63,
    "book": "psalms                                  ",
    "chapter": "7",
    "verse": "3",
    "text": "щоб душу мою не розтерзав ворог; як лев;"
  },
  {
    "id": 64,
    "book": "psalms                                  ",
    "chapter": "7",
    "verse": "4",
    "text": "Господи, Боже мій! Якщо я зробив це,"
  },
  {
    "id": 65,
    "book": "psalms                                  ",
    "chapter": "7",
    "verse": "5",
    "text": "якщо злом я віддячив тому,"
  },
  {
    "id": 66,
    "book": "psalms                                  ",
    "chapter": "7",
    "verse": "6",
    "text": "то нехай ворог переслідує мою душу,"
  },
  {
    "id": 67,
    "book": "psalms                                  ",
    "chapter": "7",
    "verse": "7",
    "text": "Устань, Господи, у гніві Твоєму,"
  },
  {
    "id": 68,
    "book": "psalms                                  ",
    "chapter": "7",
    "verse": "8",
    "text": "Нехай оточить Тебе зібрання племен,"
  },
  {
    "id": 69,
    "book": "psalms                                  ",
    "chapter": "7",
    "verse": "9",
    "text": "Нехай Господь судить народи!"
  },
  {
    "id": 70,
    "book": "psalms                                  ",
    "chapter": "7",
    "verse": "10",
    "text": "Нехай же буде покладено край злу нечестивих,"
  },
  {
    "id": 71,
    "book": "psalms                                  ",
    "chapter": "7",
    "verse": "11",
    "text": "Щит мій – Бог Всевишній,"
  },
  {
    "id": 72,
    "book": "psalms                                  ",
    "chapter": "7",
    "verse": "12",
    "text": "Бог – суддя праведний,"
  },
  {
    "id": 73,
    "book": "psalms                                  ",
    "chapter": "7",
    "verse": "13",
    "text": "Якщо хтось не навернеться,"
  },
  {
    "id": 74,
    "book": "psalms                                  ",
    "chapter": "7",
    "verse": "14",
    "text": "і приготує смертоносну зброю,"
  },
  {
    "id": 75,
    "book": "psalms                                  ",
    "chapter": "7",
    "verse": "15",
    "text": "Ось той, хто зачинає беззаконня"
  },
  {
    "id": 76,
    "book": "psalms                                  ",
    "chapter": "7",
    "verse": "16",
    "text": "Він рив яму, викопав її,"
  },
  {
    "id": 77,
    "book": "psalms                                  ",
    "chapter": "7",
    "verse": "17",
    "text": "Повернеться задумане ним лихо на його ж голову,"
  },
  {
    "id": 78,
    "book": "psalms                                  ",
    "chapter": "7",
    "verse": "18",
    "text": "Прославлю Господа за Його правду"
  }
]
