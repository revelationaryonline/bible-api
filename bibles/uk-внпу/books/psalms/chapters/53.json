[
  {
    "id": 820,
    "book": "psalms                                  ",
    "chapter": "53",
    "verse": "1",
    "text": "Керівнику хору. На струнних інструментах. Повчання Давидове,"
  },
  {
    "id": 821,
    "book": "psalms                                  ",
    "chapter": "53",
    "verse": "2",
    "text": "коли прийшли зіф’яни й сказали Саулові: «Хіба не у нас ховається Давид?»53:2 Див. 1 Сам. 23:19-28; 26:1-2."
  },
  {
    "id": 822,
    "book": "psalms                                  ",
    "chapter": "53",
    "verse": "3",
    "text": "Боже, врятуй мене іменем Твоїм"
  },
  {
    "id": 823,
    "book": "psalms                                  ",
    "chapter": "53",
    "verse": "4",
    "text": "Боже, почуй мою молитву,"
  },
  {
    "id": 824,
    "book": "psalms                                  ",
    "chapter": "53",
    "verse": "5",
    "text": "Бо чужинці повстали проти мене"
  },
  {
    "id": 825,
    "book": "psalms                                  ",
    "chapter": "53",
    "verse": "6",
    "text": "Ось Бог мені допомагає;"
  },
  {
    "id": 826,
    "book": "psalms                                  ",
    "chapter": "53",
    "verse": "7",
    "text": "Він віддячить за зло моїм супротивникам,"
  },
  {
    "id": 827,
    "book": "psalms                                  ",
    "chapter": "53",
    "verse": "8",
    "text": "Із доброї волі принесу я Тобі жертву,"
  },
  {
    "id": 828,
    "book": "psalms                                  ",
    "chapter": "53",
    "verse": "9",
    "text": "Адже від усіх скорбот Ти врятував мене,"
  }
]
