[
  {
    "id": 813,
    "book": "psalms                                  ",
    "chapter": "52",
    "verse": "1",
    "text": "Керівнику хору. На мотив махалат.52:1 Цей музичний термін, можливо, означає виконання на мотив співу в хороводі, від євр. махо́л – хоровод. Повчання Давидове."
  },
  {
    "id": 814,
    "book": "psalms                                  ",
    "chapter": "52",
    "verse": "2",
    "text": "Промовив безумний у своєму серці: «Немає Бога»."
  },
  {
    "id": 815,
    "book": "psalms                                  ",
    "chapter": "52",
    "verse": "3",
    "text": "Бог із небес поглядає на синів людських,"
  },
  {
    "id": 816,
    "book": "psalms                                  ",
    "chapter": "52",
    "verse": "4",
    "text": "Усі як один збочили з дороги, зіпсувалися;"
  },
  {
    "id": 817,
    "book": "psalms                                  ",
    "chapter": "52",
    "verse": "5",
    "text": "Невже не схаменуться всі ті, хто чинить беззаконня,"
  },
  {
    "id": 818,
    "book": "psalms                                  ",
    "chapter": "52",
    "verse": "6",
    "text": "Там охопить їх страх,"
  },
  {
    "id": 819,
    "book": "psalms                                  ",
    "chapter": "52",
    "verse": "7",
    "text": "О, хто дав би із Сіону порятунок Ізраїлеві!"
  }
]
