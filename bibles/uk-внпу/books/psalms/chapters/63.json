[
  {
    "id": 957,
    "book": "psalms                                  ",
    "chapter": "63",
    "verse": "1",
    "text": "Керівнику хору. Псалом Давидів."
  },
  {
    "id": 958,
    "book": "psalms                                  ",
    "chapter": "63",
    "verse": "2",
    "text": "Боже, почуй мій голос, коли я скаржуся;"
  },
  {
    "id": 959,
    "book": "psalms                                  ",
    "chapter": "63",
    "verse": "3",
    "text": "Сховай мене від таємних задумів злочинців,"
  },
  {
    "id": 960,
    "book": "psalms                                  ",
    "chapter": "63",
    "verse": "4",
    "text": "Вони нагострили язики свої, немов мечі,"
  },
  {
    "id": 961,
    "book": "psalms                                  ",
    "chapter": "63",
    "verse": "5",
    "text": "щоб стріляти зі своїх засідок у невинного."
  },
  {
    "id": 962,
    "book": "psalms                                  ",
    "chapter": "63",
    "verse": "6",
    "text": "Підбадьорюють себе у справі лихій,"
  },
  {
    "id": 963,
    "book": "psalms                                  ",
    "chapter": "63",
    "verse": "7",
    "text": "Ретельно обдумують свої майбутні беззаконня:"
  },
  {
    "id": 964,
    "book": "psalms                                  ",
    "chapter": "63",
    "verse": "8",
    "text": "Але Бог випустить у них стрілу зненацька –"
  },
  {
    "id": 965,
    "book": "psalms                                  ",
    "chapter": "63",
    "verse": "9",
    "text": "Він зробить так,"
  },
  {
    "id": 966,
    "book": "psalms                                  ",
    "chapter": "63",
    "verse": "10",
    "text": "Тоді страх охопить усіх людей,"
  },
  {
    "id": 967,
    "book": "psalms                                  ",
    "chapter": "63",
    "verse": "11",
    "text": "Нехай праведник радіє в Господі"
  }
]
