[
  {
    "id": 443,
    "book": "psalms                                  ",
    "chapter": "32",
    "verse": "1",
    "text": "Веселіться, праведні, у Господі!"
  },
  {
    "id": 444,
    "book": "psalms                                  ",
    "chapter": "32",
    "verse": "2",
    "text": "Славте Господа під звуки арфи,"
  },
  {
    "id": 445,
    "book": "psalms                                  ",
    "chapter": "32",
    "verse": "3",
    "text": "Співайте Йому нову пісню,"
  },
  {
    "id": 446,
    "book": "psalms                                  ",
    "chapter": "32",
    "verse": "4",
    "text": "Бо Слово Господа справедливе"
  },
  {
    "id": 447,
    "book": "psalms                                  ",
    "chapter": "32",
    "verse": "5",
    "text": "Він любить праведність і справедливість;"
  },
  {
    "id": 448,
    "book": "psalms                                  ",
    "chapter": "32",
    "verse": "6",
    "text": "Словом Господа створені небеса,"
  },
  {
    "id": 449,
    "book": "psalms                                  ",
    "chapter": "32",
    "verse": "7",
    "text": "Він збирає грудами води моря,"
  },
  {
    "id": 450,
    "book": "psalms                                  ",
    "chapter": "32",
    "verse": "8",
    "text": "Нехай боїться Господа вся земля;"
  },
  {
    "id": 451,
    "book": "psalms                                  ",
    "chapter": "32",
    "verse": "9",
    "text": "Бо Він сказав – і стало,"
  },
  {
    "id": 452,
    "book": "psalms                                  ",
    "chapter": "32",
    "verse": "10",
    "text": "Господь руйнує намір народів,"
  },
  {
    "id": 453,
    "book": "psalms                                  ",
    "chapter": "32",
    "verse": "11",
    "text": "А намір Господа стоятиме повіки,"
  },
  {
    "id": 454,
    "book": "psalms                                  ",
    "chapter": "32",
    "verse": "12",
    "text": "Блаженний народ, чиїм Богом є Господь,"
  },
  {
    "id": 455,
    "book": "psalms                                  ",
    "chapter": "32",
    "verse": "13",
    "text": "Господь поглядає з небес,"
  },
  {
    "id": 456,
    "book": "psalms                                  ",
    "chapter": "32",
    "verse": "14",
    "text": "Із місця Свого перебування приглядається пильно"
  },
  {
    "id": 457,
    "book": "psalms                                  ",
    "chapter": "32",
    "verse": "15",
    "text": "Творець усіх сердець їхніх"
  },
  {
    "id": 458,
    "book": "psalms                                  ",
    "chapter": "32",
    "verse": "16",
    "text": "Царя не врятує численне військо,"
  },
  {
    "id": 459,
    "book": "psalms                                  ",
    "chapter": "32",
    "verse": "17",
    "text": "Кінь ненадійний для порятунку:"
  },
  {
    "id": 460,
    "book": "psalms                                  ",
    "chapter": "32",
    "verse": "18",
    "text": "Ось очі Господні звернені на тих, хто боїться Його,"
  },
  {
    "id": 461,
    "book": "psalms                                  ",
    "chapter": "32",
    "verse": "19",
    "text": "щоб від смерті врятувати їх"
  },
  {
    "id": 462,
    "book": "psalms                                  ",
    "chapter": "32",
    "verse": "20",
    "text": "Душа наша в надії чекає на Господа,"
  },
  {
    "id": 463,
    "book": "psalms                                  ",
    "chapter": "32",
    "verse": "21",
    "text": "Ним радіє наше серце,"
  },
  {
    "id": 464,
    "book": "psalms                                  ",
    "chapter": "32",
    "verse": "22",
    "text": "Нехай милість Твоя, Господи, буде над нами,"
  }
]
