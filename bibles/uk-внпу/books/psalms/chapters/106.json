[
  {
    "id": 1824,
    "book": "psalms                                  ",
    "chapter": "106",
    "verse": "1",
    "text": "Славте Господа, бо Він добрий,"
  },
  {
    "id": 1825,
    "book": "psalms                                  ",
    "chapter": "106",
    "verse": "2",
    "text": "Нехай скажуть це викуплені Господом,"
  },
  {
    "id": 1826,
    "book": "psalms                                  ",
    "chapter": "106",
    "verse": "3",
    "text": "й зібрав із різних земель –"
  },
  {
    "id": 1827,
    "book": "psalms                                  ",
    "chapter": "106",
    "verse": "4",
    "text": "Вони блукали в пустелі, дорогою в дикій землі,"
  },
  {
    "id": 1828,
    "book": "psalms                                  ",
    "chapter": "106",
    "verse": "5",
    "text": "Були голодні й спраглі,"
  },
  {
    "id": 1829,
    "book": "psalms                                  ",
    "chapter": "106",
    "verse": "6",
    "text": "Тоді заволали вони до Господа у своїй скорботі,"
  },
  {
    "id": 1830,
    "book": "psalms                                  ",
    "chapter": "106",
    "verse": "7",
    "text": "І повів їх шляхом прямим,"
  },
  {
    "id": 1831,
    "book": "psalms                                  ",
    "chapter": "106",
    "verse": "8",
    "text": "Нехай славлять Господа за милість Його"
  },
  {
    "id": 1832,
    "book": "psalms                                  ",
    "chapter": "106",
    "verse": "9",
    "text": "бо задовольнив Він душу спраглу"
  },
  {
    "id": 1833,
    "book": "psalms                                  ",
    "chapter": "106",
    "verse": "10",
    "text": "Вони сиділи в темряві й тіні смерті,"
  },
  {
    "id": 1834,
    "book": "psalms                                  ",
    "chapter": "106",
    "verse": "11",
    "text": "за те, що повстали проти слів Бога"
  },
  {
    "id": 1835,
    "book": "psalms                                  ",
    "chapter": "106",
    "verse": "12",
    "text": "Він упокорив серця їхні працею тяжкою,"
  },
  {
    "id": 1836,
    "book": "psalms                                  ",
    "chapter": "106",
    "verse": "13",
    "text": "Тоді заволали вони до Господа у своїй скорботі,"
  },
  {
    "id": 1837,
    "book": "psalms                                  ",
    "chapter": "106",
    "verse": "14",
    "text": "І вивів їх із темряви й тіні смерті,"
  },
  {
    "id": 1838,
    "book": "psalms                                  ",
    "chapter": "106",
    "verse": "15",
    "text": "Нехай славлять Господа за милість Його"
  },
  {
    "id": 1839,
    "book": "psalms                                  ",
    "chapter": "106",
    "verse": "16",
    "text": "бо зламав Він двері бронзові"
  },
  {
    "id": 1840,
    "book": "psalms                                  ",
    "chapter": "106",
    "verse": "17",
    "text": "Нерозумні, через шлях беззаконь"
  },
  {
    "id": 1841,
    "book": "psalms                                  ",
    "chapter": "106",
    "verse": "18",
    "text": "Будь-яка їжа стала гидкою душам їхнім,"
  },
  {
    "id": 1842,
    "book": "psalms                                  ",
    "chapter": "106",
    "verse": "19",
    "text": "Тоді заволали вони до Господа у своїй скорботі,"
  },
  {
    "id": 1843,
    "book": "psalms                                  ",
    "chapter": "106",
    "verse": "20",
    "text": "Послав Своє слово й зцілив їх,"
  },
  {
    "id": 1844,
    "book": "psalms                                  ",
    "chapter": "106",
    "verse": "21",
    "text": "Нехай дякують Господеві за милість Його"
  },
  {
    "id": 1845,
    "book": "psalms                                  ",
    "chapter": "106",
    "verse": "22",
    "text": "і нехай приносять жертви подяки"
  },
  {
    "id": 1846,
    "book": "psalms                                  ",
    "chapter": "106",
    "verse": "23",
    "text": "Ті, хто виходить у море на кораблях,"
  },
  {
    "id": 1847,
    "book": "psalms                                  ",
    "chapter": "106",
    "verse": "24",
    "text": "бачили діяння Господа"
  },
  {
    "id": 1848,
    "book": "psalms                                  ",
    "chapter": "106",
    "verse": "25",
    "text": "Він сказав – і піднявся вітер штормовий,"
  },
  {
    "id": 1849,
    "book": "psalms                                  ",
    "chapter": "106",
    "verse": "26",
    "text": "Вони підняли кораблі до небес і скинули в безодню –"
  },
  {
    "id": 1850,
    "book": "psalms                                  ",
    "chapter": "106",
    "verse": "27",
    "text": "Кружляють, хитаються вони, немов п’яні,"
  },
  {
    "id": 1851,
    "book": "psalms                                  ",
    "chapter": "106",
    "verse": "28",
    "text": "Тоді заволали до Господа у своїй скорботі,"
  },
  {
    "id": 1852,
    "book": "psalms                                  ",
    "chapter": "106",
    "verse": "29",
    "text": "Він перетворив вітер штормовий на тишу,"
  },
  {
    "id": 1853,
    "book": "psalms                                  ",
    "chapter": "106",
    "verse": "30",
    "text": "Тоді моряки зраділи, що стихли хвилі,"
  },
  {
    "id": 1854,
    "book": "psalms                                  ",
    "chapter": "106",
    "verse": "31",
    "text": "Нехай славлять Господа за милість Його"
  },
  {
    "id": 1855,
    "book": "psalms                                  ",
    "chapter": "106",
    "verse": "32",
    "text": "Нехай величають Його в зібранні народу"
  },
  {
    "id": 1856,
    "book": "psalms                                  ",
    "chapter": "106",
    "verse": "33",
    "text": "Він перетворює ріки на пустелю"
  },
  {
    "id": 1857,
    "book": "psalms                                  ",
    "chapter": "106",
    "verse": "34",
    "text": "землю родючу – на солончак"
  },
  {
    "id": 1858,
    "book": "psalms                                  ",
    "chapter": "106",
    "verse": "35",
    "text": "Він перетворює пустелю на болотистий став"
  },
  {
    "id": 1859,
    "book": "psalms                                  ",
    "chapter": "106",
    "verse": "36",
    "text": "І поселяє там голодних,"
  },
  {
    "id": 1860,
    "book": "psalms                                  ",
    "chapter": "106",
    "verse": "37",
    "text": "засівають поля й насаджують виноградники,"
  },
  {
    "id": 1861,
    "book": "psalms                                  ",
    "chapter": "106",
    "verse": "38",
    "text": "Він благословляє їх, і вони розмножуються вельми,"
  },
  {
    "id": 1862,
    "book": "psalms                                  ",
    "chapter": "106",
    "verse": "39",
    "text": "Та коли зменшуються числом"
  },
  {
    "id": 1863,
    "book": "psalms                                  ",
    "chapter": "106",
    "verse": "40",
    "text": "Він виливає презирство на шляхетних мужів,"
  },
  {
    "id": 1864,
    "book": "psalms                                  ",
    "chapter": "106",
    "verse": "41",
    "text": "А бідного Він підіймає із приниження"
  },
  {
    "id": 1865,
    "book": "psalms                                  ",
    "chapter": "106",
    "verse": "42",
    "text": "Побачать це праведники й зрадіють,"
  },
  {
    "id": 1866,
    "book": "psalms                                  ",
    "chapter": "106",
    "verse": "43",
    "text": "Хто мудрий, нехай збереже ці слова"
  }
]
