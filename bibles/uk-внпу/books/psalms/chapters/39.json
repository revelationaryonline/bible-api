[
  {
    "id": 606,
    "book": "psalms                                  ",
    "chapter": "39",
    "verse": "1",
    "text": "Керівнику хору. Псалом Давидів."
  },
  {
    "id": 607,
    "book": "psalms                                  ",
    "chapter": "39",
    "verse": "2",
    "text": "Непохитно я надіявся на Господа, і Він прихилився до мене"
  },
  {
    "id": 608,
    "book": "psalms                                  ",
    "chapter": "39",
    "verse": "3",
    "text": "Він підняв мене зі згубної ями,"
  },
  {
    "id": 609,
    "book": "psalms                                  ",
    "chapter": "39",
    "verse": "4",
    "text": "І вклав Він в уста мої нову пісню –"
  },
  {
    "id": 610,
    "book": "psalms                                  ",
    "chapter": "39",
    "verse": "5",
    "text": "Блаженний той,"
  },
  {
    "id": 611,
    "book": "psalms                                  ",
    "chapter": "39",
    "verse": "6",
    "text": "Численні чудеса, які Ти,"
  },
  {
    "id": 612,
    "book": "psalms                                  ",
    "chapter": "39",
    "verse": "7",
    "text": "Не забажав Ти ані жертви, ані дару,"
  },
  {
    "id": 613,
    "book": "psalms                                  ",
    "chapter": "39",
    "verse": "8",
    "text": "Тоді сказав я: «Ось я прийшов,"
  },
  {
    "id": 614,
    "book": "psalms                                  ",
    "chapter": "39",
    "verse": "9",
    "text": "Я бажаю виконати Твою волю, мій Боже,"
  },
  {
    "id": 615,
    "book": "psalms                                  ",
    "chapter": "39",
    "verse": "10",
    "text": "Я звіщав правду у великому зібранні;"
  },
  {
    "id": 616,
    "book": "psalms                                  ",
    "chapter": "39",
    "verse": "11",
    "text": "Праведність Твою я не приховував у моєму серці,"
  },
  {
    "id": 617,
    "book": "psalms                                  ",
    "chapter": "39",
    "verse": "12",
    "text": "Ти ж, Господи,"
  },
  {
    "id": 618,
    "book": "psalms                                  ",
    "chapter": "39",
    "verse": "13",
    "text": "Бо оточили мене біди – немає їм ліку!"
  },
  {
    "id": 619,
    "book": "psalms                                  ",
    "chapter": "39",
    "verse": "14",
    "text": "Нехай бажанням Твоїм, Господи, буде визволити мене!"
  },
  {
    "id": 620,
    "book": "psalms                                  ",
    "chapter": "39",
    "verse": "15",
    "text": "Нехай посоромляться й ганьбою вкриються ті,"
  },
  {
    "id": 621,
    "book": "psalms                                  ",
    "chapter": "39",
    "verse": "16",
    "text": "Нехай вжахнуться через свій сором ті,"
  },
  {
    "id": 622,
    "book": "psalms                                  ",
    "chapter": "39",
    "verse": "17",
    "text": "Нехай же веселяться й радіють Тобою всі,"
  },
  {
    "id": 623,
    "book": "psalms                                  ",
    "chapter": "39",
    "verse": "18",
    "text": "Я ж принижений та бідний,"
  }
]
