[
  {
    "id": 1046,
    "book": "psalms                                  ",
    "chapter": "68",
    "verse": "1",
    "text": "Керівнику хору. На мотив «Лілея». Псалом Давидів."
  },
  {
    "id": 1047,
    "book": "psalms                                  ",
    "chapter": "68",
    "verse": "2",
    "text": "Врятуй мене, Боже,"
  },
  {
    "id": 1048,
    "book": "psalms                                  ",
    "chapter": "68",
    "verse": "3",
    "text": "Я загруз у глибокій трясовині"
  },
  {
    "id": 1049,
    "book": "psalms                                  ",
    "chapter": "68",
    "verse": "4",
    "text": "Я виснажився від крику, моє горло палає."
  },
  {
    "id": 1050,
    "book": "psalms                                  ",
    "chapter": "68",
    "verse": "5",
    "text": "Ненависників моїх стало більше,"
  },
  {
    "id": 1051,
    "book": "psalms                                  ",
    "chapter": "68",
    "verse": "6",
    "text": "Боже, ти знаєш мою нерозсудливість,"
  },
  {
    "id": 1052,
    "book": "psalms                                  ",
    "chapter": "68",
    "verse": "7",
    "text": "Нехай же не будуть через мене засоромлені ті,"
  },
  {
    "id": 1053,
    "book": "psalms                                  ",
    "chapter": "68",
    "verse": "8",
    "text": "Адже заради Тебе я несу ганьбу,"
  },
  {
    "id": 1054,
    "book": "psalms                                  ",
    "chapter": "68",
    "verse": "9",
    "text": "Вигнанцем став я для братів моїх"
  },
  {
    "id": 1055,
    "book": "psalms                                  ",
    "chapter": "68",
    "verse": "10",
    "text": "бо ревність до Дому Твого з’їдає мене,"
  },
  {
    "id": 1056,
    "book": "psalms                                  ",
    "chapter": "68",
    "verse": "11",
    "text": "Коли душа моя плакала постячись,"
  },
  {
    "id": 1057,
    "book": "psalms                                  ",
    "chapter": "68",
    "verse": "12",
    "text": "Коли вдягав на себе лахміття,"
  },
  {
    "id": 1058,
    "book": "psalms                                  ",
    "chapter": "68",
    "verse": "13",
    "text": "Пересуджують мене ті, хто сидить біля воріт,"
  },
  {
    "id": 1059,
    "book": "psalms                                  ",
    "chapter": "68",
    "verse": "14",
    "text": "А я молюся до Тебе, Господи,"
  },
  {
    "id": 1060,
    "book": "psalms                                  ",
    "chapter": "68",
    "verse": "15",
    "text": "Визволи мене з багнюки –"
  },
  {
    "id": 1061,
    "book": "psalms                                  ",
    "chapter": "68",
    "verse": "16",
    "text": "Нехай не накриє мене бурхливий водний потік,"
  },
  {
    "id": 1062,
    "book": "psalms                                  ",
    "chapter": "68",
    "verse": "17",
    "text": "Дай мені відповідь, Господи, бо добра милість Твоя;"
  },
  {
    "id": 1063,
    "book": "psalms                                  ",
    "chapter": "68",
    "verse": "18",
    "text": "Не ховай обличчя Свого від раба Твого,"
  },
  {
    "id": 1064,
    "book": "psalms                                  ",
    "chapter": "68",
    "verse": "19",
    "text": "Наблизься до душі моєї, визволи її;"
  },
  {
    "id": 1065,
    "book": "psalms                                  ",
    "chapter": "68",
    "verse": "20",
    "text": "Ти знаєш, наскільки вкритий я"
  },
  {
    "id": 1066,
    "book": "psalms                                  ",
    "chapter": "68",
    "verse": "21",
    "text": "Ганьба розбила моє серце, і я розчавлений."
  },
  {
    "id": 1067,
    "book": "psalms                                  ",
    "chapter": "68",
    "verse": "22",
    "text": "Але дали мені замість втішної їжі68:22 Давньоєврейське слово бару́т означає їжу, яку давали для підтримки бідних та засмучених. жовч;"
  },
  {
    "id": 1068,
    "book": "psalms                                  ",
    "chapter": "68",
    "verse": "23",
    "text": "Нехай трапеза їхня стане для них пасткою,"
  },
  {
    "id": 1069,
    "book": "psalms                                  ",
    "chapter": "68",
    "verse": "24",
    "text": "Нехай потемніють їхні очі, щоб не бачили,"
  },
  {
    "id": 1070,
    "book": "psalms                                  ",
    "chapter": "68",
    "verse": "25",
    "text": "Вилий на них Свій гнів,"
  },
  {
    "id": 1071,
    "book": "psalms                                  ",
    "chapter": "68",
    "verse": "26",
    "text": "Нехай будуть спустошені поселення їхні;"
  },
  {
    "id": 1072,
    "book": "psalms                                  ",
    "chapter": "68",
    "verse": "27",
    "text": "Адже вони переслідують тих, кого Ти вразив,"
  },
  {
    "id": 1073,
    "book": "psalms                                  ",
    "chapter": "68",
    "verse": "28",
    "text": "Додай же і цей гріх до їхніх гріхів,"
  },
  {
    "id": 1074,
    "book": "psalms                                  ",
    "chapter": "68",
    "verse": "29",
    "text": "Нехай вони викреслені будуть із книги життя"
  },
  {
    "id": 1075,
    "book": "psalms                                  ",
    "chapter": "68",
    "verse": "30",
    "text": "Я ж пригнічений і сповнений болю –"
  },
  {
    "id": 1076,
    "book": "psalms                                  ",
    "chapter": "68",
    "verse": "31",
    "text": "Я прославлю ім’я Бога піснею"
  },
  {
    "id": 1077,
    "book": "psalms                                  ",
    "chapter": "68",
    "verse": "32",
    "text": "Це буде приємніше Господеві, ніж віл,"
  },
  {
    "id": 1078,
    "book": "psalms                                  ",
    "chapter": "68",
    "verse": "33",
    "text": "Побачать пригнічені й зрадіють –"
  },
  {
    "id": 1079,
    "book": "psalms                                  ",
    "chapter": "68",
    "verse": "34",
    "text": "Бо прислухається до бідних Господь"
  },
  {
    "id": 1080,
    "book": "psalms                                  ",
    "chapter": "68",
    "verse": "35",
    "text": "Нехай прославляють Його небеса і земля,"
  },
  {
    "id": 1081,
    "book": "psalms                                  ",
    "chapter": "68",
    "verse": "36",
    "text": "бо врятує Бог Сіон"
  },
  {
    "id": 1082,
    "book": "psalms                                  ",
    "chapter": "68",
    "verse": "37",
    "text": "нащадки рабів Його вспадкують їх,"
  }
]
