[
  {
    "id": 360,
    "book": "psalms                                  ",
    "chapter": "26",
    "verse": "1",
    "text": "Псалом Давидів."
  },
  {
    "id": 361,
    "book": "psalms                                  ",
    "chapter": "26",
    "verse": "2",
    "text": "Коли наблизяться до мене злодії,"
  },
  {
    "id": 362,
    "book": "psalms                                  ",
    "chapter": "26",
    "verse": "3",
    "text": "Якщо військо стане табором проти мене,"
  },
  {
    "id": 363,
    "book": "psalms                                  ",
    "chapter": "26",
    "verse": "4",
    "text": "Одного лиш просив я в Господа,"
  },
  {
    "id": 364,
    "book": "psalms                                  ",
    "chapter": "26",
    "verse": "5",
    "text": "Бо Він сховає мене в помешканні Своєму в день лиха,"
  },
  {
    "id": 365,
    "book": "psalms                                  ",
    "chapter": "26",
    "verse": "6",
    "text": "Тоді піднесеться голова моя над ворогами моїми, що оточують мене,"
  },
  {
    "id": 366,
    "book": "psalms                                  ",
    "chapter": "26",
    "verse": "7",
    "text": "Почуй, Господи, мій голос, адже кличу я,"
  },
  {
    "id": 367,
    "book": "psalms                                  ",
    "chapter": "26",
    "verse": "8",
    "text": "«До Тебе!» – каже серце моє."
  },
  {
    "id": 368,
    "book": "psalms                                  ",
    "chapter": "26",
    "verse": "9",
    "text": "Не відвертай обличчя Твого від мене,"
  },
  {
    "id": 369,
    "book": "psalms                                  ",
    "chapter": "26",
    "verse": "10",
    "text": "Хоча мої батько й мати полишили мене,"
  },
  {
    "id": 370,
    "book": "psalms                                  ",
    "chapter": "26",
    "verse": "11",
    "text": "Покажи мені, Господи, дорогу Твою"
  },
  {
    "id": 371,
    "book": "psalms                                  ",
    "chapter": "26",
    "verse": "12",
    "text": "Не віддавай мене на поталу супротивникам моїм,"
  },
  {
    "id": 372,
    "book": "psalms                                  ",
    "chapter": "26",
    "verse": "13",
    "text": "Однак я твердо вірю,"
  },
  {
    "id": 373,
    "book": "psalms                                  ",
    "chapter": "26",
    "verse": "14",
    "text": "Надійся на Господа,"
  }
]
