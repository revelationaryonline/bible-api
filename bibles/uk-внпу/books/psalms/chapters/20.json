[
  {
    "id": 264,
    "book": "psalms                                  ",
    "chapter": "20",
    "verse": "1",
    "text": "Керівнику хору. Псалом Давидів."
  },
  {
    "id": 265,
    "book": "psalms                                  ",
    "chapter": "20",
    "verse": "2",
    "text": "Господи, цар радіє міці Твоїй"
  },
  {
    "id": 266,
    "book": "psalms                                  ",
    "chapter": "20",
    "verse": "3",
    "text": "Ти дав йому те, чого бажало його серце,"
  },
  {
    "id": 267,
    "book": "psalms                                  ",
    "chapter": "20",
    "verse": "4",
    "text": "Але зустрів його рясними благословеннями,"
  },
  {
    "id": 268,
    "book": "psalms                                  ",
    "chapter": "20",
    "verse": "5",
    "text": "Він просив життя у Тебе – Ти дав йому,"
  },
  {
    "id": 269,
    "book": "psalms                                  ",
    "chapter": "20",
    "verse": "6",
    "text": "Велика слава в нього через перемоги, даровані Тобою;"
  },
  {
    "id": 270,
    "book": "psalms                                  ",
    "chapter": "20",
    "verse": "7",
    "text": "Ти обдарував його благословеннями навіки,"
  },
  {
    "id": 271,
    "book": "psalms                                  ",
    "chapter": "20",
    "verse": "8",
    "text": "Бо на Господа цар покладає надію,"
  },
  {
    "id": 272,
    "book": "psalms                                  ",
    "chapter": "20",
    "verse": "9",
    "text": "Знайде рука Твоя всіх ворогів Твоїх,"
  },
  {
    "id": 273,
    "book": "psalms                                  ",
    "chapter": "20",
    "verse": "10",
    "text": "Ти зробиш їх подібними до вогняної печі"
  },
  {
    "id": 274,
    "book": "psalms                                  ",
    "chapter": "20",
    "verse": "11",
    "text": "Нащадків їхніх Ти знищиш із землі,"
  },
  {
    "id": 275,
    "book": "psalms                                  ",
    "chapter": "20",
    "verse": "12",
    "text": "Бо вони задумують зло проти Тебе,"
  },
  {
    "id": 276,
    "book": "psalms                                  ",
    "chapter": "20",
    "verse": "13",
    "text": "Ти зробиш їх ціллю для лука Свого,"
  },
  {
    "id": 277,
    "book": "psalms                                  ",
    "chapter": "20",
    "verse": "14",
    "text": "Піднімися, о Господи, у міці Твоїй!"
  }
]
