[
  {
    "id": 2468,
    "book": "psalms                                  ",
    "chapter": "145",
    "verse": "1",
    "text": "Алілуя!"
  },
  {
    "id": 2469,
    "book": "psalms                                  ",
    "chapter": "145",
    "verse": "2",
    "text": "Буду Господа хвалити все життя моє,"
  },
  {
    "id": 2470,
    "book": "psalms                                  ",
    "chapter": "145",
    "verse": "3",
    "text": "Не покладайте надії на мужів шляхетних,"
  },
  {
    "id": 2471,
    "book": "psalms                                  ",
    "chapter": "145",
    "verse": "4",
    "text": "Дух її виходить, і вона повертається в землю, –"
  },
  {
    "id": 2472,
    "book": "psalms                                  ",
    "chapter": "145",
    "verse": "5",
    "text": "Блаженний той, чия допомога – Бог Яковів,"
  },
  {
    "id": 2473,
    "book": "psalms                                  ",
    "chapter": "145",
    "verse": "6",
    "text": "Того, Хто створив небеса, землю,"
  },
  {
    "id": 2474,
    "book": "psalms                                  ",
    "chapter": "145",
    "verse": "7",
    "text": "Того, Хто правосуддя чинить для пригнічених,"
  },
  {
    "id": 2475,
    "book": "psalms                                  ",
    "chapter": "145",
    "verse": "8",
    "text": "Господь відкриває очі сліпим,"
  },
  {
    "id": 2476,
    "book": "psalms                                  ",
    "chapter": "145",
    "verse": "9",
    "text": "Господь оберігає приходьків,"
  },
  {
    "id": 2477,
    "book": "psalms                                  ",
    "chapter": "145",
    "verse": "10",
    "text": "Буде царювати Господь повіки,"
  }
]
