[
  {
    "id": 879,
    "book": "psalms                                  ",
    "chapter": "57",
    "verse": "1",
    "text": "Керівнику хору. На мотив «Не згуби». Міхтам Давидів."
  },
  {
    "id": 880,
    "book": "psalms                                  ",
    "chapter": "57",
    "verse": "2",
    "text": "Чи справді ви, можновладці, говорите правду?"
  },
  {
    "id": 881,
    "book": "psalms                                  ",
    "chapter": "57",
    "verse": "3",
    "text": "Авжеж! У серці чините беззаконня,"
  },
  {
    "id": 882,
    "book": "psalms                                  ",
    "chapter": "57",
    "verse": "4",
    "text": "Відступники нечестиві вже від утроби матері,"
  },
  {
    "id": 883,
    "book": "psalms                                  ",
    "chapter": "57",
    "verse": "5",
    "text": "Їхня отрута подібна до отрути зміїної,"
  },
  {
    "id": 884,
    "book": "psalms                                  ",
    "chapter": "57",
    "verse": "6",
    "text": "щоб не чути голосу шептунів,"
  },
  {
    "id": 885,
    "book": "psalms                                  ",
    "chapter": "57",
    "verse": "7",
    "text": "Боже, розтрощи зуби в їхніх устах;"
  },
  {
    "id": 886,
    "book": "psalms                                  ",
    "chapter": "57",
    "verse": "8",
    "text": "Нехай зникнуть, як вода, що розтікається."
  },
  {
    "id": 887,
    "book": "psalms                                  ",
    "chapter": "57",
    "verse": "9",
    "text": "Нехай будуть немов слимак, що спливає слизом у спеку;"
  },
  {
    "id": 888,
    "book": "psalms                                  ",
    "chapter": "57",
    "verse": "10",
    "text": "Перш ніж казани ваші відчують розпалений хмиз, –"
  },
  {
    "id": 889,
    "book": "psalms                                  ",
    "chapter": "57",
    "verse": "11",
    "text": "Радітиме праведник, коли побачить помсту на них,"
  },
  {
    "id": 890,
    "book": "psalms                                  ",
    "chapter": "57",
    "verse": "12",
    "text": "Тоді скаже людина:"
  }
]
