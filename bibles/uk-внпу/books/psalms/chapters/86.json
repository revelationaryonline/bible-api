    "verse": "1",
    "text": "Псалом синів Кореєвих. Пісня."
  },
  {
    "id": 1423,
    "book": "psalms                                  ",
    "chapter": "86",
    "verse": "2",
    "text": "Основи його – на горах святих."
  },
  {
    "id": 1424,
    "book": "psalms                                  ",
    "chapter": "86",
    "verse": "3",
    "text": "Славне говорять про тебе,"
