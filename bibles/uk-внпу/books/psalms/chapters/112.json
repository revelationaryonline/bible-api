[
  {
    "id": 1939,
    "book": "psalms                                  ",
    "chapter": "112",
    "verse": "1",
    "text": "Алілуя!"
  },
  {
    "id": 1940,
    "book": "psalms                                  ",
    "chapter": "112",
    "verse": "2",
    "text": "Нехай буде ім’я Господнє благословенне"
  },
  {
    "id": 1941,
    "book": "psalms                                  ",
    "chapter": "112",
    "verse": "3",
    "text": "Від сходу сонця й до його заходу"
  },
  {
    "id": 1942,
    "book": "psalms                                  ",
    "chapter": "112",
    "verse": "4",
    "text": "Господь піднісся високо над усіма народами,"
  },
  {
    "id": 1943,
    "book": "psalms                                  ",
    "chapter": "112",
    "verse": "5",
    "text": "Хто подібний до Господа, Бога нашого,"
  },
  {
    "id": 1944,
    "book": "psalms                                  ",
    "chapter": "112",
    "verse": "6",
    "text": "схиляється подивитися"
  },
  {
    "id": 1945,
    "book": "psalms                                  ",
    "chapter": "112",
    "verse": "7",
    "text": "Він піднімає із пилу вбогого,"
  },
  {
    "id": 1946,
    "book": "psalms                                  ",
    "chapter": "112",
    "verse": "8",
    "text": "щоб посадити його зі шляхетними,"
  },
  {
    "id": 1947,
    "book": "psalms                                  ",
    "chapter": "112",
    "verse": "9",
    "text": "Він неплідну жінку вселяє в дім"
  }
]
