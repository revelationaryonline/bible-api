[
  {
    "id": 2258,
    "book": "psalms                                  ",
    "chapter": "128",
    "verse": "1",
    "text": "Пісня сходження."
  },
  {
    "id": 2259,
    "book": "psalms                                  ",
    "chapter": "128",
    "verse": "2",
    "text": "досить пригнічували мене ще з юності,"
  },
  {
    "id": 2260,
    "book": "psalms                                  ",
    "chapter": "128",
    "verse": "3",
    "text": "На спині моїй орали орачі,"
  },
  {
    "id": 2261,
    "book": "psalms                                  ",
    "chapter": "128",
    "verse": "4",
    "text": "Господь праведний:"
  },
  {
    "id": 2262,
    "book": "psalms                                  ",
    "chapter": "128",
    "verse": "5",
    "text": "Нехай осоромляться й назад відсахнуться"
  },
  {
    "id": 2263,
    "book": "psalms                                  ",
    "chapter": "128",
    "verse": "6",
    "text": "Нехай стануть вони, як трава на даху,"
  },
  {
    "id": 2264,
    "book": "psalms                                  ",
    "chapter": "128",
    "verse": "7",
    "text": "якою жнець не наповнить долоні своєї,"
  },
  {
    "id": 2265,
    "book": "psalms                                  ",
    "chapter": "128",
    "verse": "8",
    "text": "І не скажуть перехожі:"
  }
]
