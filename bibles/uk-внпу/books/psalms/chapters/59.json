[
  {
    "id": 909,
    "book": "psalms                                  ",
    "chapter": "59",
    "verse": "1",
    "text": "Керівнику хору. На мотив «Лілея свідчення».59:1 Свідчення – особливий жанр духовної поезії, див. також Пс. 79:1. Міхтам Давидів. Для повчання."
  },
  {
    "id": 910,
    "book": "psalms                                  ",
    "chapter": "59",
    "verse": "2",
    "text": "Коли він виходив на війну проти Арам-Нагараїма й Арам-Цови59:2 Арам-Нагараїм та Арам-Цова – невеликі арамейські держави в північно-західному та центральному Межиріччі., і коли Йоав повернувся і вразив дванадцять тисяч едомітів у Соляній долині.59:2 Див. 2 Сам. 8–10; 1 Хр. 18–19."
  },
  {
    "id": 911,
    "book": "psalms                                  ",
    "chapter": "59",
    "verse": "3",
    "text": "Боже, Ти відкинув нас і зламав;"
  },
  {
    "id": 912,
    "book": "psalms                                  ",
    "chapter": "59",
    "verse": "4",
    "text": "Ти змусив землю тремтіти, вкрив її тріщинами;"
  },
  {
    "id": 913,
    "book": "psalms                                  ",
    "chapter": "59",
    "verse": "5",
    "text": "Ти дав народові Своєму зазнати важких часів."
  },
  {
    "id": 914,
    "book": "psalms                                  ",
    "chapter": "59",
    "verse": "6",
    "text": "Ти дав знамено тим, хто боїться Тебе,"
  },
  {
    "id": 915,
    "book": "psalms                                  ",
    "chapter": "59",
    "verse": "7",
    "text": "Щоб улюблені Твої були визволені,"
  },
  {
    "id": 916,
    "book": "psalms                                  ",
    "chapter": "59",
    "verse": "8",
    "text": "Бог промовив у Своєму святилищі:"
  },
  {
    "id": 917,
    "book": "psalms                                  ",
    "chapter": "59",
    "verse": "9",
    "text": "Мені належить Ґілеад, і Манассія – Мій,"
  },
  {
    "id": 918,
    "book": "psalms                                  ",
    "chapter": "59",
    "verse": "10",
    "text": "Моав – Моя чаша для омовіння,"
  },
  {
    "id": 919,
    "book": "psalms                                  ",
    "chapter": "59",
    "verse": "11",
    "text": "Хто введе мене в місто укріплене?"
  },
  {
    "id": 920,
    "book": "psalms                                  ",
    "chapter": "59",
    "verse": "12",
    "text": "Хіба не Ти, Боже, Котрий відкинув нас"
  },
  {
    "id": 921,
    "book": "psalms                                  ",
    "chapter": "59",
    "verse": "13",
    "text": "Подай нам допомогу в боротьбі з ворогом,"
  },
  {
    "id": 922,
    "book": "psalms                                  ",
    "chapter": "59",
    "verse": "14",
    "text": "У Бозі ми виявимо силу,"
  }
]
