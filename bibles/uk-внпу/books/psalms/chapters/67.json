[
  {
    "id": 1010,
    "book": "psalms                                  ",
    "chapter": "67",
    "verse": "1",
    "text": "Керівнику хору. Псалом Давидів. Пісня."
  },
  {
    "id": 1011,
    "book": "psalms                                  ",
    "chapter": "67",
    "verse": "2",
    "text": "Нехай устане Бог, нехай розсіються вороги Його;"
  },
  {
    "id": 1012,
    "book": "psalms                                  ",
    "chapter": "67",
    "verse": "3",
    "text": "Як розвіюється дим, так Ти їх розсій!"
  },
  {
    "id": 1013,
    "book": "psalms                                  ",
    "chapter": "67",
    "verse": "4",
    "text": "А праведники нехай радіють,"
  },
  {
    "id": 1014,
    "book": "psalms                                  ",
    "chapter": "67",
    "verse": "5",
    "text": "Співайте Богові, грайте, підносьте ім’я Того, Села"
  },
  {
    "id": 1015,
    "book": "psalms                                  ",
    "chapter": "67",
    "verse": "6",
    "text": "Батько сиріт і Суддя вдів –"
  },
  {
    "id": 1016,
    "book": "psalms                                  ",
    "chapter": "67",
    "verse": "7",
    "text": "Бог поселяє самотніх у дім,"
  },
  {
    "id": 1017,
    "book": "psalms                                  ",
    "chapter": "67",
    "verse": "8",
    "text": "Боже, коли Ти йшов перед народом,"
  },
  {
    "id": 1018,
    "book": "psalms                                  ",
    "chapter": "67",
    "verse": "9",
    "text": "земля здригалася,"
  },
  {
    "id": 1019,
    "book": "psalms                                  ",
    "chapter": "67",
    "verse": "10",
    "text": "Рясним дощем Ти зрошував, Боже,"
  },
  {
    "id": 1020,
    "book": "psalms                                  ",
    "chapter": "67",
    "verse": "11",
    "text": "Твій люд поселився на ній;"
  },
  {
    "id": 1021,
    "book": "psalms                                  ",
    "chapter": "67",
    "verse": "12",
    "text": "Володар промовив слово –"
  },
  {
    "id": 1022,
    "book": "psalms                                  ",
    "chapter": "67",
    "verse": "13",
    "text": "«Царі з військами зазнають поразки й втікають,"
  },
  {
    "id": 1023,
    "book": "psalms                                  ",
    "chapter": "67",
    "verse": "14",
    "text": "Навіть якщо ви затишно спочиваєте вдома,67:14 Тут вжито метафору навіть якщо ви між саквами спочиваєте, що означає жити спокійно й затишно."
  },
  {
    "id": 1024,
    "book": "psalms                                  ",
    "chapter": "67",
    "verse": "15",
    "text": "Коли Всемогутній розсіяв царів на обраній Ним землі,"
  },
  {
    "id": 1025,
    "book": "psalms                                  ",
    "chapter": "67",
    "verse": "16",
    "text": "Гора Божа – гора Башан;"
  },
  {
    "id": 1026,
    "book": "psalms                                  ",
    "chapter": "67",
    "verse": "17",
    "text": "Чому ви заздрісно поглядаєте, гори з кількома вершинами,"
  },
  {
    "id": 1027,
    "book": "psalms                                  ",
    "chapter": "67",
    "verse": "18",
    "text": "Колісниць Божих – десятки тисяч, тисячі тисяч."
  },
  {
    "id": 1028,
    "book": "psalms                                  ",
    "chapter": "67",
    "verse": "19",
    "text": "Ти піднявся на висоту, полонив бранців,"
  },
  {
    "id": 1029,
    "book": "psalms                                  ",
    "chapter": "67",
    "verse": "20",
    "text": "Благословенний Володар!"
  },
  {
    "id": 1030,
    "book": "psalms                                  ",
    "chapter": "67",
    "verse": "21",
    "text": "Бог для нас – Бог спасіння,"
  },
  {
    "id": 1031,
    "book": "psalms                                  ",
    "chapter": "67",
    "verse": "22",
    "text": "Так, Бог вразить голову ворогів Своїх,"
  },
  {
    "id": 1032,
    "book": "psalms                                  ",
    "chapter": "67",
    "verse": "23",
    "text": "Сказав Володар: «Із Башану поверну тебе,"
  },
  {
    "id": 1033,
    "book": "psalms                                  ",
    "chapter": "67",
    "verse": "24",
    "text": "щоб ти занурив ногу твою у кров ворогів"
  },
  {
    "id": 1034,
    "book": "psalms                                  ",
    "chapter": "67",
    "verse": "25",
    "text": "Побачили вони ходу Твою, Боже, –"
  },
  {
    "id": 1035,
    "book": "psalms                                  ",
    "chapter": "67",
    "verse": "26",
    "text": "Попереду співаки йдуть,"
  },
  {
    "id": 1036,
    "book": "psalms                                  ",
    "chapter": "67",
    "verse": "27",
    "text": "Благословіть Бога на зборах,"
  },
  {
    "id": 1037,
    "book": "psalms                                  ",
    "chapter": "67",
    "verse": "28",
    "text": "Там їх веде наймолодший Веніамін,"
  },
  {
    "id": 1038,
    "book": "psalms                                  ",
    "chapter": "67",
    "verse": "29",
    "text": "Наказав Бог Твій зміцнити тебе.67:29 Так у єврейському тексті; у грецькому та сирійському перекладах: Збери, Боже, силу Свою."
  },
  {
    "id": 1039,
    "book": "psalms                                  ",
    "chapter": "67",
    "verse": "30",
    "text": "Заради Храму Твого в Єрусалимі"
  },
  {
    "id": 1040,
    "book": "psalms                                  ",
    "chapter": "67",
    "verse": "31",
    "text": "Пригрози тому звірові в очереті,67:31 Звір в очереті, тобто крокодил або гіпопотам – образ Єгипту."
  },
  {
    "id": 1041,
    "book": "psalms                                  ",
    "chapter": "67",
    "verse": "32",
    "text": "Прийдуть вельможні67:32 Або: вдягнені у бронзові обладунки. з Єгипту,"
  },
  {
    "id": 1042,
    "book": "psalms                                  ",
    "chapter": "67",
    "verse": "33",
    "text": "Царства землі, співайте Богові!"
  },
  {
    "id": 1043,
    "book": "psalms                                  ",
    "chapter": "67",
    "verse": "34",
    "text": "Який їде на колісниці в небесах споконвічних:"
  },
  {
    "id": 1044,
    "book": "psalms                                  ",
    "chapter": "67",
    "verse": "35",
    "text": "Визнайте, що сила у Бога,"
  },
  {
    "id": 1045,
    "book": "psalms                                  ",
    "chapter": "67",
    "verse": "36",
    "text": "Страшний Бог у святилищі Своєму,"
  }
]
