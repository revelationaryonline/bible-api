[
  {
    "id": 968,
    "book": "psalms                                  ",
    "chapter": "64",
    "verse": "1",
    "text": "Керівнику хору. Псалом Давидів. Пісня."
  },
  {
    "id": 969,
    "book": "psalms                                  ",
    "chapter": "64",
    "verse": "2",
    "text": "Тобі, Боже, належить тиха хвала на Сіоні,"
  },
  {
    "id": 970,
    "book": "psalms                                  ",
    "chapter": "64",
    "verse": "3",
    "text": "Ти чуєш молитву;"
  },
  {
    "id": 971,
    "book": "psalms                                  ",
    "chapter": "64",
    "verse": "4",
    "text": "Здолали мене справи беззаконні,"
  },
  {
    "id": 972,
    "book": "psalms                                  ",
    "chapter": "64",
    "verse": "5",
    "text": "Блаженний той, кого Ти обираєш і наближуєш,"
  },
  {
    "id": 973,
    "book": "psalms                                  ",
    "chapter": "64",
    "verse": "6",
    "text": "Ти справедливо відповідаєш нам діяннями, що страх наводять,"
  },
  {
    "id": 974,
    "book": "psalms                                  ",
    "chapter": "64",
    "verse": "7",
    "text": "Ти, підперезаний могутністю,"
  },
  {
    "id": 975,
    "book": "psalms                                  ",
    "chapter": "64",
    "verse": "8",
    "text": "Ти втихомирюєш шум морів,"
  },
  {
    "id": 976,
    "book": "psalms                                  ",
    "chapter": "64",
    "verse": "9",
    "text": "І злякаються мешканці країв землі"
  },
  {
    "id": 977,
    "book": "psalms                                  ",
    "chapter": "64",
    "verse": "10",
    "text": "Ти турбуєшся про землю й напуваєш її,"
  },
  {
    "id": 978,
    "book": "psalms                                  ",
    "chapter": "64",
    "verse": "11",
    "text": "Ти зволожуєш її ріллю,"
  },
  {
    "id": 979,
    "book": "psalms                                  ",
    "chapter": "64",
    "verse": "12",
    "text": "Ти увінчуєш рік добротою Своєю,"
  },
  {
    "id": 980,
    "book": "psalms                                  ",
    "chapter": "64",
    "verse": "13",
    "text": "Крапають вологою пустельні пасовища,"
  },
  {
    "id": 981,
    "book": "psalms                                  ",
    "chapter": "64",
    "verse": "14",
    "text": "Луги вдяглися отарами худоби,"
  }
]
