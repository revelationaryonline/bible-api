[
  {
    "id": 1208,
    "book": "psalms                                  ",
    "chapter": "76",
    "verse": "1",
    "text": "Керівнику хору, Єдутуну.76:1 Див. Пс. 61:1; 1 Хр. 16:41, 42. Псалом Асафів."
  },
  {
    "id": 1209,
    "book": "psalms                                  ",
    "chapter": "76",
    "verse": "2",
    "text": "Голосом своїм я волатиму до Бога,"
  },
  {
    "id": 1210,
    "book": "psalms                                  ",
    "chapter": "76",
    "verse": "3",
    "text": "У день скорботи моєї я шукав Володаря;"
  },
  {
    "id": 1211,
    "book": "psalms                                  ",
    "chapter": "76",
    "verse": "4",
    "text": "Згадаю про Бога – і охопить мене трепет;"
  },
  {
    "id": 1212,
    "book": "psalms                                  ",
    "chapter": "76",
    "verse": "5",
    "text": "Ти тримав розплющеними повіки очей моїх;"
  },
  {
    "id": 1213,
    "book": "psalms                                  ",
    "chapter": "76",
    "verse": "6",
    "text": "Подумав я про дні давноминулі,"
  },
  {
    "id": 1214,
    "book": "psalms                                  ",
    "chapter": "76",
    "verse": "7",
    "text": "Згадую наспіви мої вночі,"
  },
  {
    "id": 1215,
    "book": "psalms                                  ",
    "chapter": "76",
    "verse": "8",
    "text": "Невже навіки покинув нас Володар"
  },
  {
    "id": 1216,
    "book": "psalms                                  ",
    "chapter": "76",
    "verse": "9",
    "text": "Невже назавжди зникла Його милість,"
  },
  {
    "id": 1217,
    "book": "psalms                                  ",
    "chapter": "76",
    "verse": "10",
    "text": "Хіба забув Бог, як милувати,"
  },
  {
    "id": 1218,
    "book": "psalms                                  ",
    "chapter": "76",
    "verse": "11",
    "text": "Тоді сказав я: «Що гнітить мене,"
  },
  {
    "id": 1219,
    "book": "psalms                                  ",
    "chapter": "76",
    "verse": "12",
    "text": "Згадаю я про діяння Господа;"
  },
  {
    "id": 1220,
    "book": "psalms                                  ",
    "chapter": "76",
    "verse": "13",
    "text": "Споглядатиму всі справи Твої"
  },
  {
    "id": 1221,
    "book": "psalms                                  ",
    "chapter": "76",
    "verse": "14",
    "text": "Боже, у святості шлях Твій!"
  },
  {
    "id": 1222,
    "book": "psalms                                  ",
    "chapter": "76",
    "verse": "15",
    "text": "Ти – Бог, Який творить чудеса;"
  },
  {
    "id": 1223,
    "book": "psalms                                  ",
    "chapter": "76",
    "verse": "16",
    "text": "Ти визволив рукою Своєю народ Твій,"
  },
  {
    "id": 1224,
    "book": "psalms                                  ",
    "chapter": "76",
    "verse": "17",
    "text": "Побачили Тебе води, Боже,"
  },
  {
    "id": 1225,
    "book": "psalms                                  ",
    "chapter": "76",
    "verse": "18",
    "text": "Потоками лилася вода із темних хмар,"
  },
  {
    "id": 1226,
    "book": "psalms                                  ",
    "chapter": "76",
    "verse": "19",
    "text": "Гуркіт Твого грому на небокраї,"
  },
  {
    "id": 1227,
    "book": "psalms                                  ",
    "chapter": "76",
    "verse": "20",
    "text": "Шлях Твій пролягав через море,"
  },
  {
    "id": 1228,
    "book": "psalms                                  ",
    "chapter": "76",
    "verse": "21",
    "text": "Ти вів, немов отару, народ Свій"
  }
]
