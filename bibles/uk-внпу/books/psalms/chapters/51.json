[
  {
    "id": 802,
    "book": "psalms                                  ",
    "chapter": "51",
    "verse": "1",
    "text": "Керівнику хору. Повчання Давидове,"
  },
  {
    "id": 803,
    "book": "psalms                                  ",
    "chapter": "51",
    "verse": "2",
    "text": "коли прийшов Доеґ-едомітянин до Саула й повідомив йому: «Давид у домі Ахімелеха»."
  },
  {
    "id": 804,
    "book": "psalms                                  ",
    "chapter": "51",
    "verse": "3",
    "text": "Чому ти хизуєшся злодійством, сильний?"
  },
  {
    "id": 805,
    "book": "psalms                                  ",
    "chapter": "51",
    "verse": "4",
    "text": "Язик твій задумує загибель,"
  },
  {
    "id": 806,
    "book": "psalms                                  ",
    "chapter": "51",
    "verse": "5",
    "text": "Ти полюбив зло більше, ніж добро,"
  },
  {
    "id": 807,
    "book": "psalms                                  ",
    "chapter": "51",
    "verse": "6",
    "text": "Ти любиш усілякі згубні слова,"
  },
  {
    "id": 808,
    "book": "psalms                                  ",
    "chapter": "51",
    "verse": "7",
    "text": "Але Бог уразить тебе навіки;"
  },
  {
    "id": 809,
    "book": "psalms                                  ",
    "chapter": "51",
    "verse": "8",
    "text": "Тоді побачать це праведні й сповняться страхом,"
  },
  {
    "id": 810,
    "book": "psalms                                  ",
    "chapter": "51",
    "verse": "9",
    "text": "«Ось муж,"
  },
  {
    "id": 811,
    "book": "psalms                                  ",
    "chapter": "51",
    "verse": "10",
    "text": "А я, немов ряснолиста маслина в домі Божому,"
  },
  {
    "id": 812,
    "book": "psalms                                  ",
    "chapter": "51",
    "verse": "11",
    "text": "Прославлятиму Тебе вічно перед Твоїми вірними за те,"
  }
]
