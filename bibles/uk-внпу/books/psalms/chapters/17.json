[
  {
    "id": 188,
    "book": "psalms                                  ",
    "chapter": "17",
    "verse": "1",
    "text": "Керівнику хору. Псалом раба Господнього Давида. Він заспівав слова цієї пісні Господеві того дня, коли визволив його Господь від руки всіх ворогів його й від руки Саула."
  },
  {
    "id": 189,
    "book": "psalms                                  ",
    "chapter": "17",
    "verse": "2",
    "text": "І сказав він:"
  },
  {
    "id": 190,
    "book": "psalms                                  ",
    "chapter": "17",
    "verse": "3",
    "text": "Господь – бескид крутий для мене, твердиня моя і мій Визволитель."
  },
  {
    "id": 191,
    "book": "psalms                                  ",
    "chapter": "17",
    "verse": "4",
    "text": "До Господа прославленого кличу я –"
  },
  {
    "id": 192,
    "book": "psalms                                  ",
    "chapter": "17",
    "verse": "5",
    "text": "Облягли мене пута смерті,"
  },
  {
    "id": 193,
    "book": "psalms                                  ",
    "chapter": "17",
    "verse": "6",
    "text": "Пута царства мертвих охопили мене,"
  },
  {
    "id": 194,
    "book": "psalms                                  ",
    "chapter": "17",
    "verse": "7",
    "text": "У скорботі моїй я кликав Господа"
  },
  {
    "id": 195,
    "book": "psalms                                  ",
    "chapter": "17",
    "verse": "8",
    "text": "Тоді здригнулася земля, захиталась,"
  },
  {
    "id": 196,
    "book": "psalms                                  ",
    "chapter": "17",
    "verse": "9",
    "text": "Дим піднявся із ніздрів Його,"
  },
  {
    "id": 197,
    "book": "psalms                                  ",
    "chapter": "17",
    "verse": "10",
    "text": "Він нахилив небеса і зійшов,"
  },
  {
    "id": 198,
    "book": "psalms                                  ",
    "chapter": "17",
    "verse": "11",
    "text": "Він сів верхи на херувима й полетів,"
  },
  {
    "id": 199,
    "book": "psalms                                  ",
    "chapter": "17",
    "verse": "12",
    "text": "Морок зробив Він Своїм покровом, немов шатро навколо Нього –"
  },
  {
    "id": 200,
    "book": "psalms                                  ",
    "chapter": "17",
    "verse": "13",
    "text": "Від сяйва, що перед Ним, випливають хмари –"
  },
  {
    "id": 201,
    "book": "psalms                                  ",
    "chapter": "17",
    "verse": "14",
    "text": "Тоді загримів на небесах Господь,"
  },
  {
    "id": 202,
    "book": "psalms                                  ",
    "chapter": "17",
    "verse": "15",
    "text": "І пустив Він стріли Свої, і розсіяв ворогів,"
  },
  {
    "id": 203,
    "book": "psalms                                  ",
    "chapter": "17",
    "verse": "16",
    "text": "Тоді з’явилися джерела води"
  },
  {
    "id": 204,
    "book": "psalms                                  ",
    "chapter": "17",
    "verse": "17",
    "text": "Він схилився з висоти, узяв мене,"
  },
  {
    "id": 205,
    "book": "psalms                                  ",
    "chapter": "17",
    "verse": "18",
    "text": "Визволив мене від сильного мого ворога"
  },
  {
    "id": 206,
    "book": "psalms                                  ",
    "chapter": "17",
    "verse": "19",
    "text": "Вони стали переді мною в день лиха,"
  },
  {
    "id": 207,
    "book": "psalms                                  ",
    "chapter": "17",
    "verse": "20",
    "text": "Він вивів мене на просторе місце,"
  },
  {
    "id": 208,
    "book": "psalms                                  ",
    "chapter": "17",
    "verse": "21",
    "text": "Віддячив мені Господь за правдою моєю,"
  },
  {
    "id": 209,
    "book": "psalms                                  ",
    "chapter": "17",
    "verse": "22",
    "text": "Адже я тримався шляхів Господніх"
  },
  {
    "id": 210,
    "book": "psalms                                  ",
    "chapter": "17",
    "verse": "23",
    "text": "Бо всі закони Його правосуддя – переді мною,"
  },
  {
    "id": 211,
    "book": "psalms                                  ",
    "chapter": "17",
    "verse": "24",
    "text": "Я був бездоганний перед Ним"
  },
  {
    "id": 212,
    "book": "psalms                                  ",
    "chapter": "17",
    "verse": "25",
    "text": "Тому й винагородив мене Господь за правдою моєю,"
  },
  {
    "id": 213,
    "book": "psalms                                  ",
    "chapter": "17",
    "verse": "26",
    "text": "Ти вірність виявляєш тому, хто сам вірний,"
  },
  {
    "id": 214,
    "book": "psalms                                  ",
    "chapter": "17",
    "verse": "27",
    "text": "із чистим Ти обходишся щиро,"
  },
  {
    "id": 215,
    "book": "psalms                                  ",
    "chapter": "17",
    "verse": "28",
    "text": "Адже Ти рятуєш людей смиренних,"
  },
  {
    "id": 216,
    "book": "psalms                                  ",
    "chapter": "17",
    "verse": "29",
    "text": "Ти запалюєш мій світильник;"
  },
  {
    "id": 217,
    "book": "psalms                                  ",
    "chapter": "17",
    "verse": "30",
    "text": "Разом із Тобою я змушую вороже військо тікати,"
  },
  {
    "id": 218,
    "book": "psalms                                  ",
    "chapter": "17",
    "verse": "31",
    "text": "Бог! Бездоганний шлях Його,"
  },
  {
    "id": 219,
    "book": "psalms                                  ",
    "chapter": "17",
    "verse": "32",
    "text": "Бо хто ще є Богом, окрім Господа?"
  },
  {
    "id": 220,
    "book": "psalms                                  ",
    "chapter": "17",
    "verse": "33",
    "text": "Бог підперізує мене силою"
  },
  {
    "id": 221,
    "book": "psalms                                  ",
    "chapter": "17",
    "verse": "34",
    "text": "Він робить ноги мої, мов у лані,"
  },
  {
    "id": 222,
    "book": "psalms                                  ",
    "chapter": "17",
    "verse": "35",
    "text": "Він привчає руки мої до битви,"
  },
  {
    "id": 223,
    "book": "psalms                                  ",
    "chapter": "17",
    "verse": "36",
    "text": "Ти дав мені щит порятунку Твого,"
  },
  {
    "id": 224,
    "book": "psalms                                  ",
    "chapter": "17",
    "verse": "37",
    "text": "Ти розширюєш мій крок піді мною,"
  },
  {
    "id": 225,
    "book": "psalms                                  ",
    "chapter": "17",
    "verse": "38",
    "text": "Я переслідую ворогів моїх і наздоганяю їх,"
  },
  {
    "id": 226,
    "book": "psalms                                  ",
    "chapter": "17",
    "verse": "39",
    "text": "Я вражаю їх так, що не можуть більше встати,"
  },
  {
    "id": 227,
    "book": "psalms                                  ",
    "chapter": "17",
    "verse": "40",
    "text": "Ти підперезав мене силою для битви,"
  },
  {
    "id": 228,
    "book": "psalms                                  ",
    "chapter": "17",
    "verse": "41",
    "text": "Ти ворогів моїх обернув до мене спиною,"
  },
  {
    "id": 229,
    "book": "psalms                                  ",
    "chapter": "17",
    "verse": "42",
    "text": "Вони волали про допомогу, але не було рятівника,"
  },
  {
    "id": 230,
    "book": "psalms                                  ",
    "chapter": "17",
    "verse": "43",
    "text": "Я стер їх у порох, у пил, що розноситься на крилах вітру;"
  },
  {
    "id": 231,
    "book": "psalms                                  ",
    "chapter": "17",
    "verse": "44",
    "text": "Ти визволив мене від заколоту в народі,"
  },
  {
    "id": 232,
    "book": "psalms                                  ",
    "chapter": "17",
    "verse": "45",
    "text": "слухаються мене, лише почувши краєм вуха про мене."
  },
  {
    "id": 233,
    "book": "psalms                                  ",
    "chapter": "17",
    "verse": "46",
    "text": "Понурилися сини чужинців і завмирають від страху,"
  },
  {
    "id": 234,
    "book": "psalms                                  ",
    "chapter": "17",
    "verse": "47",
    "text": "Живий Господь і благословенна Скеля моя!"
  },
  {
    "id": 235,
    "book": "psalms                                  ",
    "chapter": "17",
    "verse": "48",
    "text": "Він – Бог, Який помсту за мене вчиняє,"
  },
  {
    "id": 236,
    "book": "psalms                                  ",
    "chapter": "17",
    "verse": "49",
    "text": "й визволяє мене від ворогів моїх."
  },
  {
    "id": 237,
    "book": "psalms                                  ",
    "chapter": "17",
    "verse": "50",
    "text": "За це я славитиму Тебе серед народів, Господи,"
  },
  {
    "id": 238,
    "book": "psalms                                  ",
    "chapter": "17",
    "verse": "51",
    "text": "Звеличує Він перемогою поставленого Ним царя"
  }
]
