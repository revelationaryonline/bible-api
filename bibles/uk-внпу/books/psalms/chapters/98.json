[
  {
    "id": 1623,
    "book": "psalms                                  ",
    "chapter": "98",
    "verse": "1",
    "text": "Господь царює –"
  },
  {
    "id": 1624,
    "book": "psalms                                  ",
    "chapter": "98",
    "verse": "2",
    "text": "Господь великий на Сіоні,"
  },
  {
    "id": 1625,
    "book": "psalms                                  ",
    "chapter": "98",
    "verse": "3",
    "text": "Нехай прославлять вони ім’я Твоє велике й грізне:"
  },
  {
    "id": 1626,
    "book": "psalms                                  ",
    "chapter": "98",
    "verse": "4",
    "text": "Могутнє правління Царя любить правосуддя."
  },
  {
    "id": 1627,
    "book": "psalms                                  ",
    "chapter": "98",
    "verse": "5",
    "text": "Піднесено славте Господа, Бога нашого,"
  },
  {
    "id": 1628,
    "book": "psalms                                  ",
    "chapter": "98",
    "verse": "6",
    "text": "Мойсей і Аарон серед священників Його,"
  },
  {
    "id": 1629,
    "book": "psalms                                  ",
    "chapter": "98",
    "verse": "7",
    "text": "У хмарному стовпі говорив до них;"
  },
  {
    "id": 1630,
    "book": "psalms                                  ",
    "chapter": "98",
    "verse": "8",
    "text": "Господи, Боже наш, Ти відповідав їм!"
  },
  {
    "id": 1631,
    "book": "psalms                                  ",
    "chapter": "98",
    "verse": "9",
    "text": "Піднесено славте Господа, Бога нашого,"
  }
