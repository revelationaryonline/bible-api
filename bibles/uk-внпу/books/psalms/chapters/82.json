[
  {
    "id": 1359,
    "book": "psalms                                  ",
    "chapter": "82",
    "verse": "1",
    "text": "Пісня. Псалом Асафів."
  },
  {
    "id": 1360,
    "book": "psalms                                  ",
    "chapter": "82",
    "verse": "2",
    "text": "Боже, не залишайся в тиші,"
  },
  {
    "id": 1361,
    "book": "psalms                                  ",
    "chapter": "82",
    "verse": "3",
    "text": "Адже вороги Твої гомонять"
  },
  {
    "id": 1362,
    "book": "psalms                                  ",
    "chapter": "82",
    "verse": "4",
    "text": "Складають змову проти Твого народу"
  },
  {
    "id": 1363,
    "book": "psalms                                  ",
    "chapter": "82",
    "verse": "5",
    "text": "Сказали вони: «Ходімо, знищимо їх з-поміж народів,"
  },
  {
    "id": 1364,
    "book": "psalms                                  ",
    "chapter": "82",
    "verse": "6",
    "text": "Змовилися одностайно,"
  },
  {
    "id": 1365,
    "book": "psalms                                  ",
    "chapter": "82",
    "verse": "7",
    "text": "шатри Едомові й ізмаїльтяни,"
  },
  {
    "id": 1366,
    "book": "psalms                                  ",
    "chapter": "82",
    "verse": "8",
    "text": "Ґевал, Аммон і Амалик,"
  },
  {
    "id": 1367,
    "book": "psalms                                  ",
    "chapter": "82",
    "verse": "9",
    "text": "Навіть Ассирія приєдналася до них,"
  },
  {
    "id": 1368,
    "book": "psalms                                  ",
    "chapter": "82",
    "verse": "10",
    "text": "Зроби з ними так, як із Мідіаном,82:10 Див. Суд. 7:1-25."
  },
  {
    "id": 1369,
    "book": "psalms                                  ",
    "chapter": "82",
    "verse": "11",
    "text": "що були знищені в Ен-Дорі"
  },
  {
    "id": 1370,
    "book": "psalms                                  ",
    "chapter": "82",
    "verse": "12",
    "text": "Учини з вельможами їхніми, як з Оревом і Зевом,82:12 Див. Суд. 7:25."
  },
  {
    "id": 1371,
    "book": "psalms                                  ",
    "chapter": "82",
    "verse": "13",
    "text": "що говорили: «Візьмемо собі у спадок"
  },
  {
    "id": 1372,
    "book": "psalms                                  ",
    "chapter": "82",
    "verse": "14",
    "text": "Боже мій, нехай будуть вони, як курява,"
  },
  {
    "id": 1373,
    "book": "psalms                                  ",
    "chapter": "82",
    "verse": "15",
    "text": "Як вогонь пожирає ліс"
  },
  {
    "id": 1374,
    "book": "psalms                                  ",
    "chapter": "82",
    "verse": "16",
    "text": "так Ти пожени їх Своєю бурею"
  },
  {
    "id": 1375,
    "book": "psalms                                  ",
    "chapter": "82",
    "verse": "17",
    "text": "Вкрий їхні обличчя безчестям,"
  },
  {
    "id": 1376,
    "book": "psalms                                  ",
    "chapter": "82",
    "verse": "18",
    "text": "Нехай вони посоромляться й збентежаться навіки,"
  },
  {
    "id": 1377,
    "book": "psalms                                  ",
    "chapter": "82",
    "verse": "19",
    "text": "Нехай пізнають, що Ти, Чиє ім’я – Господь,"
  }
]
