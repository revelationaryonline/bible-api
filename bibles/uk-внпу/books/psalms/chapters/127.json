[
  {
    "id": 2252,
    "book": "psalms                                  ",
    "chapter": "127",
    "verse": "1",
    "text": "Пісня сходження."
  },
  {
    "id": 2253,
    "book": "psalms                                  ",
    "chapter": "127",
    "verse": "2",
    "text": "Ти їстимеш плоди праці рук своїх;"
  },
  {
    "id": 2254,
    "book": "psalms                                  ",
    "chapter": "127",
    "verse": "3",
    "text": "Дружина твоя – немов плодовита лоза"
  },
  {
    "id": 2255,
    "book": "psalms                                  ",
    "chapter": "127",
    "verse": "4",
    "text": "Ось так благословенний буде муж,"
  },
  {
    "id": 2256,
    "book": "psalms                                  ",
    "chapter": "127",
    "verse": "5",
    "text": "Нехай благословить тебе Господь із Сіону,"
  },
  {
    "id": 2257,
    "book": "psalms                                  ",
    "chapter": "127",
    "verse": "6",
    "text": "і щоб побачив ти синів своїх синів."
  }
]
