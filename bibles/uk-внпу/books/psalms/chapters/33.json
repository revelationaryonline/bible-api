[
  {
    "id": 465,
    "book": "psalms                                  ",
    "chapter": "33",
    "verse": "1",
    "text": "Псалом Давидів, коли він вдавав із себе божевільного перед Авімелехом, був вигнаний від нього й пішов.33:1 Див. 1 Сам. 21:10–22:1."
  },
  {
    "id": 466,
    "book": "psalms                                  ",
    "chapter": "33",
    "verse": "2",
    "text": "Благословлятиму Господа повсякчасно,"
  },
  {
    "id": 467,
    "book": "psalms                                  ",
    "chapter": "33",
    "verse": "3",
    "text": "Душа моя хвалитиметься Господом;"
  },
  {
    "id": 468,
    "book": "psalms                                  ",
    "chapter": "33",
    "verse": "4",
    "text": "Величайте Господа зі мною;"
  },
  {
    "id": 469,
    "book": "psalms                                  ",
    "chapter": "33",
    "verse": "5",
    "text": "Я шукав Господа, і Він відповів мені"
  },
  {
    "id": 470,
    "book": "psalms                                  ",
    "chapter": "33",
    "verse": "6",
    "text": "Хто погляд свій звертав на Нього, ті засяяли від радості,"
  },
  {
    "id": 471,
    "book": "psalms                                  ",
    "chapter": "33",
    "verse": "7",
    "text": "Цей пригноблений кликав, і Господь почув"
  },
  {
    "id": 472,
    "book": "psalms                                  ",
    "chapter": "33",
    "verse": "8",
    "text": "Ангел Господній стає табором довкола тих,"
  },
  {
    "id": 473,
    "book": "psalms                                  ",
    "chapter": "33",
    "verse": "9",
    "text": "Скоштуйте й побачте, що добрий Господь!"
  },
  {
    "id": 474,
    "book": "psalms                                  ",
    "chapter": "33",
    "verse": "10",
    "text": "Бійтеся Господа, святі Його,"
  },
  {
    "id": 475,
    "book": "psalms                                  ",
    "chapter": "33",
    "verse": "11",
    "text": "Молоді леви терплять нестачу й голодують,"
  },
  {
    "id": 476,
    "book": "psalms                                  ",
    "chapter": "33",
    "verse": "12",
    "text": "Приходьте, нащадки,33:12 Або: сини, діти. послухайте мене,"
  },
  {
    "id": 477,
    "book": "psalms                                  ",
    "chapter": "33",
    "verse": "13",
    "text": "Той, хто бажає насолоджуватися життям,"
  },
  {
    "id": 478,
    "book": "psalms                                  ",
    "chapter": "33",
    "verse": "14",
    "text": "стримуй язик свій від зла"
  },
  {
    "id": 479,
    "book": "psalms                                  ",
    "chapter": "33",
    "verse": "15",
    "text": "Ухиляйся від зла й чини добро,"
  },
  {
    "id": 480,
    "book": "psalms                                  ",
    "chapter": "33",
    "verse": "16",
    "text": "Очі Господа – на праведних,"
  },
  {
    "id": 481,
    "book": "psalms                                  ",
    "chapter": "33",
    "verse": "17",
    "text": "Обличчя Господа – проти тих, хто чинить зло,"
  },
  {
    "id": 482,
    "book": "psalms                                  ",
    "chapter": "33",
    "verse": "18",
    "text": "Кличуть праведні, і Господь чує"
  },
  {
    "id": 483,
    "book": "psalms                                  ",
    "chapter": "33",
    "verse": "19",
    "text": "Близький Господь до людей зі зламаним серцем,"
  },
  {
    "id": 484,
    "book": "psalms                                  ",
    "chapter": "33",
    "verse": "20",
    "text": "Багато лих у праведного,"
  },
  {
    "id": 485,
    "book": "psalms                                  ",
    "chapter": "33",
    "verse": "21",
    "text": "Береже Він усі кістки його,"
  },
  {
    "id": 486,
    "book": "psalms                                  ",
    "chapter": "33",
    "verse": "22",
    "text": "Зло приведе до смерті нечестивого,"
  },
  {
    "id": 487,
    "book": "psalms                                  ",
    "chapter": "33",
    "verse": "23",
    "text": "Визволяє Господь душі слуг Своїх,"
  }
]
