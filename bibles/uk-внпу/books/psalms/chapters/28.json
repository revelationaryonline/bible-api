    "text": "Псалом Давидів."
  },
  {
    "id": 384,
    "book": "psalms                                  ",
    "chapter": "28",
    "verse": "2",
    "text": "Віддайте імені Господа славу,"
  },
  {
    "id": 385,
    "book": "psalms                                  ",
    "chapter": "28",
    "verse": "3",
    "text": "Голос Господа – над водами;"
  },
  {
    "id": 386,
    "book": "psalms                                  ",
    "chapter": "28",
    "verse": "4",
    "text": "Голос Господа сильний;"
  },
  {
    "id": 387,
    "book": "psalms                                  ",
    "chapter": "28",
    "verse": "5",
    "text": "Голос Господа ламає кедри,"
  },
  {
    "id": 388,
    "book": "psalms                                  ",
    "chapter": "28",
    "verse": "6",
    "text": "Він змушує їх танцювати, як телят,"
  },
  {
    "id": 389,
    "book": "psalms                                  ",
    "chapter": "28",
    "verse": "7",
    "text": "Голос Господа викрешує язики полум’я."
  },
  {
    "id": 390,
    "book": "psalms                                  ",
    "chapter": "28",
    "verse": "8",
    "text": "Голос Господа змушує тремтіти пустелю,"
  },
  {
    "id": 391,
    "book": "psalms                                  ",
    "chapter": "28",
    "verse": "9",
    "text": "Голос Господа гне дуби28:9 Або: дає силу народжувати ланям."
  },
  {
    "id": 392,
    "book": "psalms                                  ",
    "chapter": "28",
    "verse": "10",
    "text": "Господь сидів над водами потопу;"
  },
  {
    "id": 393,
    "book": "psalms                                  ",
    "chapter": "28",
    "verse": "11",
    "text": "Господь дає міць Своєму народові;"
  }
