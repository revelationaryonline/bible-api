[
  {
    "id": 1974,
    "book": "psalms                                  ",
    "chapter": "114",
    "verse": "1",
    "text": "Люблю я Господа,"
  },
  {
    "id": 1975,
    "book": "psalms                                  ",
    "chapter": "114",
    "verse": "2",
    "text": "Через те, що прихилив Він вухо Своє до мене,"
  },
  {
    "id": 1976,
    "book": "psalms                                  ",
    "chapter": "114",
    "verse": "3",
    "text": "Облягли мене кайдани смерті,"
  },
  {
    "id": 1977,
    "book": "psalms                                  ",
    "chapter": "114",
    "verse": "4",
    "text": "Тоді я кликав ім’я Господа:"
  },
  {
    "id": 1978,
    "book": "psalms                                  ",
    "chapter": "114",
    "verse": "5",
    "text": "Милостивий Господь і праведний,"
  },
  {
    "id": 1979,
    "book": "psalms                                  ",
    "chapter": "114",
    "verse": "6",
    "text": "Господь береже недосвідчених:"
  },
  {
    "id": 1980,
    "book": "psalms                                  ",
    "chapter": "114",
    "verse": "7",
    "text": "Повернися, душе моя, до свого спокою,"
  },
  {
    "id": 1981,
    "book": "psalms                                  ",
    "chapter": "114",
    "verse": "8",
    "text": "Бо Ти визволив душу мою від смерті,"
  },
  {
    "id": 1982,
    "book": "psalms                                  ",
    "chapter": "114",
    "verse": "9",
    "text": "Я буду ходити перед обличчям Господа"
  }
]
