[
  {
    "id": 2389,
    "book": "psalms                                  ",
    "chapter": "139",
    "verse": "1",
    "text": "Керівнику хору. Псалом Давидів."
  },
  {
    "id": 2390,
    "book": "psalms                                  ",
    "chapter": "139",
    "verse": "2",
    "text": "Врятуй мене, Господи, від людини злої,"
  },
  {
    "id": 2391,
    "book": "psalms                                  ",
    "chapter": "139",
    "verse": "3",
    "text": "які зло задумують у серці,"
  },
  {
    "id": 2392,
    "book": "psalms                                  ",
    "chapter": "139",
    "verse": "4",
    "text": "Гострять язики свої, наче змії;"
  },
  {
    "id": 2393,
    "book": "psalms                                  ",
    "chapter": "139",
    "verse": "5",
    "text": "Оберігай мене, Господи, від рук нечестивця,"
  },
  {
    "id": 2394,
    "book": "psalms                                  ",
    "chapter": "139",
    "verse": "6",
    "text": "Горді приховали пастку й мотузки для мене,"
  },
  {
    "id": 2395,
    "book": "psalms                                  ",
    "chapter": "139",
    "verse": "7",
    "text": "Я сказав Господеві: «Ти – мій Бог!"
  },
  {
    "id": 2396,
    "book": "psalms                                  ",
    "chapter": "139",
    "verse": "8",
    "text": "Господи, Владико, сило спасіння мого,"
  },
  {
    "id": 2397,
    "book": "psalms                                  ",
    "chapter": "139",
    "verse": "9",
    "text": "Не дай, Господи, нечестивому того, що він бажає,"
  },
  {
    "id": 2398,
    "book": "psalms                                  ",
    "chapter": "139",
    "verse": "10",
    "text": "Голови тих, хто оточив мене,"
  },
  {
    "id": 2399,
    "book": "psalms                                  ",
    "chapter": "139",
    "verse": "11",
    "text": "Нехай впаде на них розжарене вугілля,"
  },
  {
    "id": 2400,
    "book": "psalms                                  ",
    "chapter": "139",
    "verse": "12",
    "text": "Людина зі злим язиком не утвердиться на землі;"
  },
  {
    "id": 2401,
    "book": "psalms                                  ",
    "chapter": "139",
    "verse": "13",
    "text": "Я знаю, що Господь здійснить суд бідному,"
  },
  {
    "id": 2402,
    "book": "psalms                                  ",
    "chapter": "139",
    "verse": "14",
    "text": "Так, прославлятимуть праведні ім’я Твоє,"
  }
]
