[
  {
    "id": 758,
    "book": "psalms                                  ",
    "chapter": "49",
    "verse": "1",
    "text": "Псалом Асафів."
  },
  {
    "id": 759,
    "book": "psalms                                  ",
    "chapter": "49",
    "verse": "2",
    "text": "Із Сіону, досконалої краси,"
  },
  {
    "id": 760,
    "book": "psalms                                  ",
    "chapter": "49",
    "verse": "3",
    "text": "Іде наш Бог і не мовчить;"
  },
  {
    "id": 761,
    "book": "psalms                                  ",
    "chapter": "49",
    "verse": "4",
    "text": "Він закликає небеса вгорі"
  },
  {
    "id": 762,
    "book": "psalms                                  ",
    "chapter": "49",
    "verse": "5",
    "text": "«Зберіть-но до Мене Моїх вірних,"
  },
  {
    "id": 763,
    "book": "psalms                                  ",
    "chapter": "49",
    "verse": "6",
    "text": "І небеса сповіщатимуть правду Його,"
  },
  {
    "id": 764,
    "book": "psalms                                  ",
    "chapter": "49",
    "verse": "7",
    "text": "«Слухай, народе Мій, Я говоритиму;"
  },
  {
    "id": 765,
    "book": "psalms                                  ",
    "chapter": "49",
    "verse": "8",
    "text": "Не за жертвоприношення твої Я докорятиму тобі –"
  },
  {
    "id": 766,
    "book": "psalms                                  ",
    "chapter": "49",
    "verse": "9",
    "text": "Я не прийму вола із твого дому,"
  },
  {
    "id": 767,
    "book": "psalms                                  ",
    "chapter": "49",
    "verse": "10",
    "text": "Адже всі тварини в лісі – Мої,"
  },
  {
    "id": 768,
    "book": "psalms                                  ",
    "chapter": "49",
    "verse": "11",
    "text": "Я знаю кожного птаха в горах,"
  },
  {
    "id": 769,
    "book": "psalms                                  ",
    "chapter": "49",
    "verse": "12",
    "text": "Якби Я був голодний,"
  },
  {
    "id": 770,
    "book": "psalms                                  ",
    "chapter": "49",
    "verse": "13",
    "text": "Хіба Я їм м’ясо биків"
  },
  {
    "id": 771,
    "book": "psalms                                  ",
    "chapter": "49",
    "verse": "14",
    "text": "Принеси Богові в жертву подяку"
  },
  {
    "id": 772,
    "book": "psalms                                  ",
    "chapter": "49",
    "verse": "15",
    "text": "Поклич Мене в день скорботи –"
  },
  {
    "id": 773,
    "book": "psalms                                  ",
    "chapter": "49",
    "verse": "16",
    "text": "Нечестивому ж говорить Бог:"
  },
  {
    "id": 774,
    "book": "psalms                                  ",
    "chapter": "49",
    "verse": "17",
    "text": "Ти ж ненавидиш настанови"
  },
  {
    "id": 775,
    "book": "psalms                                  ",
    "chapter": "49",
    "verse": "18",
    "text": "Коли ти бачиш крадія, заводиш із ним приязні стосунки;"
  },
  {
    "id": 776,
    "book": "psalms                                  ",
    "chapter": "49",
    "verse": "19",
    "text": "Вуста твої вживаєш для зла,"
  },
  {
    "id": 777,
    "book": "psalms                                  ",
    "chapter": "49",
    "verse": "20",
    "text": "Сидиш на суді, намовляєш на брата твого,"
  },
  {
    "id": 778,
    "book": "psalms                                  ",
    "chapter": "49",
    "verse": "21",
    "text": "Ти чинив це, а Я мовчав,"
  },
  {
    "id": 779,
    "book": "psalms                                  ",
    "chapter": "49",
    "verse": "22",
    "text": "Зрозумійте ж це ті, хто забуває Бога,"
  },
  {
    "id": 780,
    "book": "psalms                                  ",
    "chapter": "49",
    "verse": "23",
    "text": "Той, хто приносить у жертву подяку, шанує Мене;"
  }
]
