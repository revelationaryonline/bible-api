[
  {
    "id": 1314,
    "book": "psalms                                  ",
    "chapter": "79",
    "verse": "1",
    "text": "Керівнику хору. На мотив «Лілея». Свідчення. Псалом Асафів."
  },
  {
    "id": 1315,
    "book": "psalms                                  ",
    "chapter": "79",
    "verse": "2",
    "text": "Почуй нас, о Пастирю Ізраїля!"
  },
  {
    "id": 1316,
    "book": "psalms                                  ",
    "chapter": "79",
    "verse": "3",
    "text": "перед Єфремом, Веніаміном і Манассією!"
  },
  {
    "id": 1317,
    "book": "psalms                                  ",
    "chapter": "79",
    "verse": "4",
    "text": "Боже, віднови нас,"
  },
  {
    "id": 1318,
    "book": "psalms                                  ",
    "chapter": "79",
    "verse": "5",
    "text": "Господи, Боже Воїнств,"
  },
  {
    "id": 1319,
    "book": "psalms                                  ",
    "chapter": "79",
    "verse": "6",
    "text": "Ти нагодував нас хлібом скорботним,"
  },
  {
    "id": 1320,
    "book": "psalms                                  ",
    "chapter": "79",
    "verse": "7",
    "text": "зробив нас причиною суперечки між сусідами нашими,"
  },
  {
    "id": 1321,
    "book": "psalms                                  ",
    "chapter": "79",
    "verse": "8",
    "text": "Боже Воїнств, віднови нас,"
  },
  {
    "id": 1322,
    "book": "psalms                                  ",
    "chapter": "79",
    "verse": "9",
    "text": "Ти приніс з Єгипту виноградну галузку,"
  },
  {
    "id": 1323,
    "book": "psalms                                  ",
    "chapter": "79",
    "verse": "10",
    "text": "Ти очистив місце для неї –"
  },
  {
    "id": 1324,
    "book": "psalms                                  ",
    "chapter": "79",
    "verse": "11",
    "text": "Гори вкрилися її тінню,"
  },
  {
    "id": 1325,
    "book": "psalms                                  ",
    "chapter": "79",
    "verse": "12",
    "text": "Розкинула свої пагони аж до моря"
  },
  {
    "id": 1326,
    "book": "psalms                                  ",
    "chapter": "79",
    "verse": "13",
    "text": "Навіщо ж зруйнував Ти її огорожу,"
  },
  {
    "id": 1327,
    "book": "psalms                                  ",
    "chapter": "79",
    "verse": "14",
    "text": "Підриває її вепр лісовий,"
  },
  {
    "id": 1328,
    "book": "psalms                                  ",
    "chapter": "79",
    "verse": "15",
    "text": "Боже Воїнств, повернися до нас,"
  },
  {
    "id": 1329,
    "book": "psalms                                  ",
    "chapter": "79",
    "verse": "16",
    "text": "це коріння, яке насадила Твоя правиця,"
  },
  {
    "id": 1330,
    "book": "psalms                                  ",
    "chapter": "79",
    "verse": "17",
    "text": "Вогнем обпалена, обсічена лоза,"
  },
  {
    "id": 1331,
    "book": "psalms                                  ",
    "chapter": "79",
    "verse": "18",
    "text": "Нехай рука Твоя буде над мужем правиці Твоєї,"
  },
  {
    "id": 1332,
    "book": "psalms                                  ",
    "chapter": "79",
    "verse": "19",
    "text": "Тоді ми не відступимо від Тебе;"
  },
  {
    "id": 1333,
    "book": "psalms                                  ",
    "chapter": "79",
    "verse": "20",
    "text": "Господи, Боже Воїнств, віднови нас!"
  }
]
