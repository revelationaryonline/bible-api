[
  {
    "id": 1995,
    "book": "psalms                                  ",
    "chapter": "117",
    "verse": "1",
    "text": "Славте Господа, бо Він добрий,"
  },
  {
    "id": 1996,
    "book": "psalms                                  ",
    "chapter": "117",
    "verse": "2",
    "text": "Нехай скаже Ізраїль:"
  },
  {
    "id": 1997,
    "book": "psalms                                  ",
    "chapter": "117",
    "verse": "3",
    "text": "Нехай скаже дім Ааронів:"
  },
  {
    "id": 1998,
    "book": "psalms                                  ",
    "chapter": "117",
    "verse": "4",
    "text": "Нехай скажуть ті, що бояться Господа:"
  },
  {
    "id": 1999,
    "book": "psalms                                  ",
    "chapter": "117",
    "verse": "5",
    "text": "Із тісноти покликав я Господа –"
  },
  {
    "id": 2000,
    "book": "psalms                                  ",
    "chapter": "117",
    "verse": "6",
    "text": "Господь зі мною – не боятимуся!"
  },
  {
    "id": 2001,
    "book": "psalms                                  ",
    "chapter": "117",
    "verse": "7",
    "text": "Господь зі мною, щоб допомагати мені –"
  },
  {
    "id": 2002,
    "book": "psalms                                  ",
    "chapter": "117",
    "verse": "8",
    "text": "Краще захисту шукати в Господа,"
  },
  {
    "id": 2003,
    "book": "psalms                                  ",
    "chapter": "117",
    "verse": "9",
    "text": "Краще захисту шукати в Господа,"
  },
  {
    "id": 2004,
    "book": "psalms                                  ",
    "chapter": "117",
    "verse": "10",
    "text": "Усі народи оточили мене,"
  },
  {
    "id": 2005,
    "book": "psalms                                  ",
    "chapter": "117",
    "verse": "11",
    "text": "Оточили мене, обступили з усіх боків,"
  },
  {
    "id": 2006,
    "book": "psalms                                  ",
    "chapter": "117",
    "verse": "12",
    "text": "Оточили мене, як бджоли,"
  },
  {
    "id": 2007,
    "book": "psalms                                  ",
    "chapter": "117",
    "verse": "13",
    "text": "Ти штовхнув мене, вороже,"
  },
  {
    "id": 2008,
    "book": "psalms                                  ",
    "chapter": "117",
    "verse": "14",
    "text": "Сила моя і пісня моя – Господь;"
  },
  {
    "id": 2009,
    "book": "psalms                                  ",
    "chapter": "117",
    "verse": "15",
    "text": "Голос радості й перемоги в наметах праведників:"
  },
  {
    "id": 2010,
    "book": "psalms                                  ",
    "chapter": "117",
    "verse": "16",
    "text": "Правиця Господня піднята вгору,"
  },
  {
    "id": 2011,
    "book": "psalms                                  ",
    "chapter": "117",
    "verse": "17",
    "text": "Не помру, але буду жити"
  },
  {
    "id": 2012,
    "book": "psalms                                  ",
    "chapter": "117",
    "verse": "18",
    "text": "Господь покарав мене тяжко,"
  },
  {
    "id": 2013,
    "book": "psalms                                  ",
    "chapter": "117",
    "verse": "19",
    "text": "Відчиніть мені брами правди,"
  },
  {
    "id": 2014,
    "book": "psalms                                  ",
    "chapter": "117",
    "verse": "20",
    "text": "Це брама Господня,"
  },
  {
    "id": 2015,
    "book": "psalms                                  ",
    "chapter": "117",
    "verse": "21",
    "text": "Прославлю Тебе, бо Ти відповів мені"
  },
  {
    "id": 2016,
    "book": "psalms                                  ",
    "chapter": "117",
    "verse": "22",
    "text": "Камінь, який відкинули будівничі,"
  },
  {
    "id": 2017,
    "book": "psalms                                  ",
    "chapter": "117",
    "verse": "23",
    "text": "Від Господа це було,"
  },
  {
    "id": 2018,
    "book": "psalms                                  ",
    "chapter": "117",
    "verse": "24",
    "text": "Цей день створив Господь:"
  },
  {
    "id": 2019,
    "book": "psalms                                  ",
    "chapter": "117",
    "verse": "25",
    "text": "О Господи, врятуй же,"
  },
  {
    "id": 2020,
    "book": "psalms                                  ",
    "chapter": "117",
    "verse": "26",
    "text": "Благословенний Той, Хто йде в ім’я Господа!"
  },
  {
    "id": 2021,
    "book": "psalms                                  ",
    "chapter": "117",
    "verse": "27",
    "text": "Бог – це Господь,"
  },
  {
    "id": 2022,
    "book": "psalms                                  ",
    "chapter": "117",
    "verse": "28",
    "text": "Ти – мій Бог, і я прославлю Тебе."
  },
  {
    "id": 2023,
    "book": "psalms                                  ",
    "chapter": "117",
    "verse": "29",
    "text": "Славте Господа, бо Він добрий,"
  }
]
