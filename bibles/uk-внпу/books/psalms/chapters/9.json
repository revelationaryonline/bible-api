[
  {
    "id": 89,
    "book": "psalms                                  ",
    "chapter": "9",
    "verse": "1",
    "text": "Керівнику хору. На мотив «Смерть сина». Псалом Давидів."
  },
  {
    "id": 90,
    "book": "psalms                                  ",
    "chapter": "9",
    "verse": "2",
    "text": "Славитиму Тебе, Господи, від щирого серця,"
  },
  {
    "id": 91,
    "book": "psalms                                  ",
    "chapter": "9",
    "verse": "3",
    "text": "Радітиму й веселитимусь Тобою,"
  },
  {
    "id": 92,
    "book": "psalms                                  ",
    "chapter": "9",
    "verse": "4",
    "text": "Коли вороги мої відсахнулися назад,"
  },
  {
    "id": 93,
    "book": "psalms                                  ",
    "chapter": "9",
    "verse": "5",
    "text": "Бо Ти підтримав мене на суді у позові моєму проти них;"
  },
  {
    "id": 94,
    "book": "psalms                                  ",
    "chapter": "9",
    "verse": "6",
    "text": "Ти звинуватив народи, згубив нечестивих,"
  },
  {
    "id": 95,
    "book": "psalms                                  ",
    "chapter": "9",
    "verse": "7",
    "text": "Руйнування ворога завершене навіки;"
  },
  {
    "id": 96,
    "book": "psalms                                  ",
    "chapter": "9",
    "verse": "8",
    "text": "А Господь перебуватиме вічно,"
  },
  {
    "id": 97,
    "book": "psalms                                  ",
    "chapter": "9",
    "verse": "9",
    "text": "Він судитиме всесвіт за правдою,"
  },
  {
    "id": 98,
    "book": "psalms                                  ",
    "chapter": "9",
    "verse": "10",
    "text": "І буде Господь сховищем пригніченому,"
  },
  {
    "id": 99,
    "book": "psalms                                  ",
    "chapter": "9",
    "verse": "11",
    "text": "Надію покладатимуть на Тебе всі, хто знає ім’я Твоє,"
  },
  {
    "id": 100,
    "book": "psalms                                  ",
    "chapter": "9",
    "verse": "12",
    "text": "Співайте Господеві, Що мешкає на Сіоні,"
  },
  {
    "id": 101,
    "book": "psalms                                  ",
    "chapter": "9",
    "verse": "13",
    "text": "Бо Він вимагає розплати за кров невинних, пам’ятає про них,"
  },
  {
    "id": 102,
    "book": "psalms                                  ",
    "chapter": "9",
    "verse": "14",
    "text": "Змилуйся наді мною, Господи, поглянь, як гнітять мене мої ненависники,"
  },
  {
    "id": 103,
    "book": "psalms                                  ",
    "chapter": "9",
    "verse": "15",
    "text": "щоби звіщав я хвалу Тобі"
  },
  {
    "id": 104,
    "book": "psalms                                  ",
    "chapter": "9",
    "verse": "16",
    "text": "Народи попадали в яму, яку самі ж і викопали,"
  },
  {
    "id": 105,
    "book": "psalms                                  ",
    "chapter": "9",
    "verse": "17",
    "text": "Виявив Себе Господь, вчинивши суд:"
  },
  {
    "id": 106,
    "book": "psalms                                  ",
    "chapter": "9",
    "verse": "18",
    "text": "Зійдуть нечестиві до царства мертвих –"
  },
  {
    "id": 107,
    "book": "psalms                                  ",
    "chapter": "9",
    "verse": "19",
    "text": "Але вбогий не назавжди буде забутий,"
  },
  {
    "id": 108,
    "book": "psalms                                  ",
    "chapter": "9",
    "verse": "20",
    "text": "Повстань, Господи! Нехай не перемагає людина!"
  },
  {
    "id": 109,
    "book": "psalms                                  ",
    "chapter": "9",
    "verse": "21",
    "text": "Наведи жах на них, Господи,"
  },
  {
    "id": 110,
    "book": "psalms                                  ",
    "chapter": "9",
    "verse": "22",
    "text": "Чому, Господи, Ти стоїш осторонь,"
  },
  {
    "id": 111,
    "book": "psalms                                  ",
    "chapter": "9",
    "verse": "23",
    "text": "Нечестивий пихато переслідує пригніченого –"
  },
  {
    "id": 112,
    "book": "psalms                                  ",
    "chapter": "9",
    "verse": "24",
    "text": "Бо хизується нечестивий пристрастями душі своєї"
  },
  {
    "id": 113,
    "book": "psalms                                  ",
    "chapter": "9",
    "verse": "25",
    "text": "Зухвало нехтує нечестивець тим, щоб Господа шукати,"
  },
  {
    "id": 114,
    "book": "psalms                                  ",
    "chapter": "9",
    "verse": "26",
    "text": "Його справи йдуть успішно повсякчас,9:26 Буквально: Він має успіх на всіх шляхах своїх повсякчас."
  },
  {
    "id": 115,
    "book": "psalms                                  ",
    "chapter": "9",
    "verse": "27",
    "text": "Говорить він у серці своєму: «Не похитнуся,"
  },
  {
    "id": 116,
    "book": "psalms                                  ",
    "chapter": "9",
    "verse": "28",
    "text": "Його вуста наповнені прокляттям, підступом і пригніченням,"
  },
  {
    "id": 117,
    "book": "psalms                                  ",
    "chapter": "9",
    "verse": "29",
    "text": "Залягає він у засідку біля огороджених поселень,"
  },
  {
    "id": 118,
    "book": "psalms                                  ",
    "chapter": "9",
    "verse": "30",
    "text": "Чатує у схованці, немов лев у лігві;"
  },
  {
    "id": 119,
    "book": "psalms                                  ",
    "chapter": "9",
    "verse": "31",
    "text": "Понівечений, він згинається й падає,"
  },
  {
    "id": 120,
    "book": "psalms                                  ",
    "chapter": "9",
    "verse": "32",
    "text": "Говорить безбожний у своєму серці: «Бог забув, Він сховав обличчя Своє,"
  },
  {
    "id": 121,
    "book": "psalms                                  ",
    "chapter": "9",
    "verse": "33",
    "text": "Повстань, Господи! Здійми руку Твою, Боже!"
  },
  {
    "id": 122,
    "book": "psalms                                  ",
    "chapter": "9",
    "verse": "34",
    "text": "Чому нехтує Богом нечестивий,"
  },
  {
    "id": 123,
    "book": "psalms                                  ",
    "chapter": "9",
    "verse": "35",
    "text": "Але ж Ти бачиш! На утиск і гніт Ти уважно дивишся,"
  },
  {
    "id": 124,
    "book": "psalms                                  ",
    "chapter": "9",
    "verse": "36",
    "text": "Зламай же плече нечестивому й злому,"
  },
  {
    "id": 125,
    "book": "psalms                                  ",
    "chapter": "9",
    "verse": "37",
    "text": "Господь – Цар на віки вічні,"
  },
  {
    "id": 126,
    "book": "psalms                                  ",
    "chapter": "9",
    "verse": "38",
    "text": "Бажання бідних Ти чуєш, Господи,"
  },
  {
    "id": 127,
    "book": "psalms                                  ",
    "chapter": "9",
    "verse": "39",
    "text": "щоб здійснити правосуддя для сироти й пригніченого,"
  }
]
