[
  {
    "id": 326,
    "book": "psalms                                  ",
    "chapter": "24",
    "verse": "1",
    "text": "Псалом Давидів."
  },
  {
    "id": 327,
    "book": "psalms                                  ",
    "chapter": "24",
    "verse": "2",
    "text": "Боже мій, на Тебе надію покладаю;"
  },
  {
    "id": 328,
    "book": "psalms                                  ",
    "chapter": "24",
    "verse": "3",
    "text": "Не дай жодному з тих, хто на Тебе надію покладає,"
  },
  {
    "id": 329,
    "book": "psalms                                  ",
    "chapter": "24",
    "verse": "4",
    "text": "Покажи мені, шляхи Твої, Господи,"
  },
  {
    "id": 330,
    "book": "psalms                                  ",
    "chapter": "24",
    "verse": "5",
    "text": "Веди мене істиною Твоєю й навчи мене,"
  },
  {
    "id": 331,
    "book": "psalms                                  ",
    "chapter": "24",
    "verse": "6",
    "text": "Згадай, Господи, любов Твою й Твоє милосердя,"
  },
  {
    "id": 332,
    "book": "psalms                                  ",
    "chapter": "24",
    "verse": "7",
    "text": "Гріхів юності моєї"
  },
  {
    "id": 333,
    "book": "psalms                                  ",
    "chapter": "24",
    "verse": "8",
    "text": "Добрий і справедливий Господь,"
  },
  {
    "id": 334,
    "book": "psalms                                  ",
    "chapter": "24",
    "verse": "9",
    "text": "Він спрямовує смиренних до справедливості"
  },
  {
    "id": 335,
    "book": "psalms                                  ",
    "chapter": "24",
    "verse": "10",
    "text": "Усі стежки Господні – милість та істина"
  },
  {
    "id": 336,
    "book": "psalms                                  ",
    "chapter": "24",
    "verse": "11",
    "text": "Заради імені Твого, Господи,"
  },
  {
    "id": 337,
    "book": "psalms                                  ",
    "chapter": "24",
    "verse": "12",
    "text": "Хто той муж, що Господа боїться?"
  },
  {
    "id": 338,
    "book": "psalms                                  ",
    "chapter": "24",
    "verse": "13",
    "text": "Душа його житиме в достатку,"
  },
  {
    "id": 339,
    "book": "psalms                                  ",
    "chapter": "24",
    "verse": "14",
    "text": "Таємницю Свою Господь довіряє тим, хто боїться Його,"
  },
  {
    "id": 340,
    "book": "psalms                                  ",
    "chapter": "24",
    "verse": "15",
    "text": "Очі мої завжди звернені до Господа,"
  },
  {
    "id": 341,
    "book": "psalms                                  ",
    "chapter": "24",
    "verse": "16",
    "text": "Зглянься на мене й змилуйся наді мною,"
  },
  {
    "id": 342,
    "book": "psalms                                  ",
    "chapter": "24",
    "verse": "17",
    "text": "Скорботи мого серця примножилися –"
  },
  {
    "id": 343,
    "book": "psalms                                  ",
    "chapter": "24",
    "verse": "18",
    "text": "Поглянь на приниження моє й муку мою"
  },
  {
    "id": 344,
    "book": "psalms                                  ",
    "chapter": "24",
    "verse": "19",
    "text": "Подивися на ворогів моїх, які численні вони стали"
  },
  {
    "id": 345,
    "book": "psalms                                  ",
    "chapter": "24",
    "verse": "20",
    "text": "Збережи мою душу й визволи мене,"
  },
  {
    "id": 346,
    "book": "psalms                                  ",
    "chapter": "24",
    "verse": "21",
    "text": "Невинність і справедливість нехай стережуть мене,"
  },
  {
    "id": 347,
    "book": "psalms                                  ",
    "chapter": "24",
    "verse": "22",
    "text": "Визволи, Боже, Ізраїля"
  }
]
