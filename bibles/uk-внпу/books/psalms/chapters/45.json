    "chapter": "45",
    "verse": "1",
    "text": "Керівнику хору. Синів Кореєвих пісня. На мотив аламот.45:1 Музичний термін, можливо, означає виконання високим голосом (євр. альма́– жінка)."
  },
  {
    "id": 701,
    "book": "psalms                                  ",
    "chapter": "45",
    "verse": "2",
    "text": "Бог – пристановище наше й міць,"
  },
  {
    "id": 702,
    "book": "psalms                                  ",
    "chapter": "45",
    "verse": "3",
    "text": "Тому ми не злякаємось,"
  },
  {
    "id": 703,
    "book": "psalms                                  ",
    "chapter": "45",
    "verse": "4",
    "text": "так що заревли б і запінилися води від їхнього падіння,"
  },
  {
    "id": 704,
    "book": "psalms                                  ",
    "chapter": "45",
    "verse": "5",
    "text": "Річкові потоки радують місто Боже,"
  },
  {
    "id": 705,
    "book": "psalms                                  ",
    "chapter": "45",
    "verse": "6",
    "text": "Бог посеред нього – воно не захитається;"
  },
  {
    "id": 706,
    "book": "psalms                                  ",
    "chapter": "45",
    "verse": "7",
    "text": "Збентежилися народи, похитнулися царства,"
  },
  {
    "id": 707,
    "book": "psalms                                  ",
    "chapter": "45",
    "verse": "8",
    "text": "Господь Воїнств45:8 Передачу давньоєврейського словосполучення Ягве́ Цевао́т, яке в деяких перекладах передано із збереженням без перекладу другого слова: Господь Саваот. із нами;"
  },
  {
    "id": 708,
    "book": "psalms                                  ",
    "chapter": "45",
    "verse": "9",
    "text": "Підіть-но, погляньте на діяння Господа,"
  },
  {
    "id": 709,
    "book": "psalms                                  ",
    "chapter": "45",
    "verse": "10",
    "text": "припиняючи війни аж до краю землі."
  },
  {
    "id": 710,
    "book": "psalms                                  ",
    "chapter": "45",
    "verse": "11",
    "text": "«Вгамуйтеся й пізнайте, що Я – Бог;"
  },
  {
    "id": 711,
    "book": "psalms                                  ",
    "chapter": "45",
    "verse": "12",
    "text": "Господь Воїнств із нами,"
  }
