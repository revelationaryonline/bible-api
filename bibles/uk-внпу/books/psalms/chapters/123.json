[
  {
    "id": 2228,
    "book": "psalms                                  ",
    "chapter": "123",
    "verse": "1",
    "text": "Пісня сходження Давидова."
  },
  {
    "id": 2229,
    "book": "psalms                                  ",
    "chapter": "123",
    "verse": "2",
    "text": "якби не був із нами Господь,"
  },
  {
    "id": 2230,
    "book": "psalms                                  ",
    "chapter": "123",
    "verse": "3",
    "text": "то вони живцем поглинули б нас,"
  },
  {
    "id": 2231,
    "book": "psalms                                  ",
    "chapter": "123",
    "verse": "4",
    "text": "Тоді води потопили б нас,"
  },
  {
    "id": 2232,
    "book": "psalms                                  ",
    "chapter": "123",
    "verse": "5",
    "text": "тоді пронеслися б над нашою душею води бурхливі."
  },
  {
    "id": 2233,
    "book": "psalms                                  ",
    "chapter": "123",
    "verse": "6",
    "text": "Благословенний Господь,"
  },
  {
    "id": 2234,
    "book": "psalms                                  ",
    "chapter": "123",
    "verse": "7",
    "text": "Душа наша, мов птах, що звільнився з сильця ловців:"
  },
  {
    "id": 2235,
    "book": "psalms                                  ",
    "chapter": "123",
    "verse": "8",
    "text": "Допомога наша – в імені Господа,"
  }
]
