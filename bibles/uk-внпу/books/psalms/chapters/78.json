[
  {
    "id": 1301,
    "book": "psalms                                  ",
    "chapter": "78",
    "verse": "1",
    "text": "Псалом Асафів."
  },
  {
    "id": 1302,
    "book": "psalms                                  ",
    "chapter": "78",
    "verse": "2",
    "text": "Віддали трупи рабів Твоїх"
  },
  {
    "id": 1303,
    "book": "psalms                                  ",
    "chapter": "78",
    "verse": "3",
    "text": "Вони пролили кров їхню, як воду,"
  },
  {
    "id": 1304,
    "book": "psalms                                  ",
    "chapter": "78",
    "verse": "4",
    "text": "Ми стали ганьбою у сусідів наших,"
  },
  {
    "id": 1305,
    "book": "psalms                                  ",
    "chapter": "78",
    "verse": "5",
    "text": "Доки, Господи, гнів Твій триватиме – вічно?"
  },
  {
    "id": 1306,
    "book": "psalms                                  ",
    "chapter": "78",
    "verse": "6",
    "text": "Вилий лють Свою на народи, які Тебе не знають,"
  },
  {
    "id": 1307,
    "book": "psalms                                  ",
    "chapter": "78",
    "verse": "7",
    "text": "бо пожерли вони Якова"
  },
  {
    "id": 1308,
    "book": "psalms                                  ",
    "chapter": "78",
    "verse": "8",
    "text": "Не згадуй нам гріхів наших попередників;"
  },
  {
    "id": 1309,
    "book": "psalms                                  ",
    "chapter": "78",
    "verse": "9",
    "text": "Допоможи нам, Боже спасіння нашого,"
  },
  {
    "id": 1310,
    "book": "psalms                                  ",
    "chapter": "78",
    "verse": "10",
    "text": "Чому мали б народи говорити:"
  },
  {
    "id": 1311,
    "book": "psalms                                  ",
    "chapter": "78",
    "verse": "11",
    "text": "Нехай стогін в’язня дійде до обличчя Твого;"
  },
  {
    "id": 1312,
    "book": "psalms                                  ",
    "chapter": "78",
    "verse": "12",
    "text": "Віддяч усемеро в саме нутро сусідам нашим за наругу їхню,"
  },
  {
    "id": 1313,
    "book": "psalms                                  ",
    "chapter": "78",
    "verse": "13",
    "text": "А ми, народ Твій, вівці Твого пасовища,"
  }
]
