[
  {
    "id": 655,
    "book": "psalms                                  ",
    "chapter": "43",
    "verse": "1",
    "text": "Керівнику хору. Повчання синів Корея."
  },
  {
    "id": 656,
    "book": "psalms                                  ",
    "chapter": "43",
    "verse": "2",
    "text": "Боже, ми чули своїми вухами,"
  },
  {
    "id": 657,
    "book": "psalms                                  ",
    "chapter": "43",
    "verse": "3",
    "text": "Ти вигнав Своєю рукою народи,"
  },
  {
    "id": 658,
    "book": "psalms                                  ",
    "chapter": "43",
    "verse": "4",
    "text": "Адже не мечем своїм батьки наші взяли у спадок землю"
  },
  {
    "id": 659,
    "book": "psalms                                  ",
    "chapter": "43",
    "verse": "5",
    "text": "Ти – Цар мій, Боже."
  },
  {
    "id": 660,
    "book": "psalms                                  ",
    "chapter": "43",
    "verse": "6",
    "text": "З Тобою ми здолаємо в битві супротивників наших,"
  },
  {
    "id": 661,
    "book": "psalms                                  ",
    "chapter": "43",
    "verse": "7",
    "text": "Бо не на лук свій я покладаю надію"
  },
  {
    "id": 662,
    "book": "psalms                                  ",
    "chapter": "43",
    "verse": "8",
    "text": "Але Ти рятуєш нас від супротивників наших"
  },
  {
    "id": 663,
    "book": "psalms                                  ",
    "chapter": "43",
    "verse": "9",
    "text": "Богом ми хвалимось цілий день"
  },
  {
    "id": 664,
    "book": "psalms                                  ",
    "chapter": "43",
    "verse": "10",
    "text": "Тепер же Ти покинув і посоромив нас,"
  },
  {
    "id": 665,
    "book": "psalms                                  ",
    "chapter": "43",
    "verse": "11",
    "text": "Ти змусив нас втікати назад від супротивника,"
  },
  {
    "id": 666,
    "book": "psalms                                  ",
    "chapter": "43",
    "verse": "12",
    "text": "Ти віддав нас, як овець, на поїдання"
  },
  {
    "id": 667,
    "book": "psalms                                  ",
    "chapter": "43",
    "verse": "13",
    "text": "Ти продав народ Твій за безцінь,"
  },
  {
    "id": 668,
    "book": "psalms                                  ",
    "chapter": "43",
    "verse": "14",
    "text": "Ти вкрив нас ганьбою перед сусідами нашими,"
  },
  {
    "id": 669,
    "book": "psalms                                  ",
    "chapter": "43",
    "verse": "15",
    "text": "Приказкою глузливою Ти зробив нас серед народів,"
  },
  {
    "id": 670,
    "book": "psalms                                  ",
    "chapter": "43",
    "verse": "16",
    "text": "Щодня безчестя моє переді мною,"
  },
  {
    "id": 671,
    "book": "psalms                                  ",
    "chapter": "43",
    "verse": "17",
    "text": "через те, що голос лихослова й глузія я чую,"
  },
  {
    "id": 672,
    "book": "psalms                                  ",
    "chapter": "43",
    "verse": "18",
    "text": "Усе це лихо спіткало нас,"
  },
  {
    "id": 673,
    "book": "psalms                                  ",
    "chapter": "43",
    "verse": "19",
    "text": "Серця наші не відступили назад,"
  },
  {
    "id": 674,
    "book": "psalms                                  ",
    "chapter": "43",
    "verse": "20",
    "text": "Але Ти вразив нас у пустельному місці,"
  },
  {
    "id": 675,
    "book": "psalms                                  ",
    "chapter": "43",
    "verse": "21",
    "text": "Якби ми забули ім’я Бога нашого"
  },
  {
    "id": 676,
    "book": "psalms                                  ",
    "chapter": "43",
    "verse": "22",
    "text": "хіба Бог не виявив би цього?"
  },
  {
    "id": 677,
    "book": "psalms                                  ",
    "chapter": "43",
    "verse": "23",
    "text": "Однак заради Тебе нас убивають щодня,"
  },
  {
    "id": 678,
    "book": "psalms                                  ",
    "chapter": "43",
    "verse": "24",
    "text": "Прокинься! Чому Ти спиш, Владико?"
  },
  {
    "id": 679,
    "book": "psalms                                  ",
    "chapter": "43",
    "verse": "25",
    "text": "Чому Ти ховаєш Своє обличчя,"
  },
  {
    "id": 680,
    "book": "psalms                                  ",
    "chapter": "43",
    "verse": "26",
    "text": "Адже до пороху земного зведена душа наша,"
  },
  {
    "id": 681,
    "book": "psalms                                  ",
    "chapter": "43",
    "verse": "27",
    "text": "Повстань, будь нам допомогою!"
  }
]
