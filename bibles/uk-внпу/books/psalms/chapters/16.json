[
  {
    "id": 173,
    "book": "psalms                                  ",
    "chapter": "16",
    "verse": "1",
    "text": "Молитва Давидова."
  },
  {
    "id": 174,
    "book": "psalms                                  ",
    "chapter": "16",
    "verse": "2",
    "text": "Від Тебе Самого нехай прийде мені суд справедливий,"
  },
  {
    "id": 175,
    "book": "psalms                                  ",
    "chapter": "16",
    "verse": "3",
    "text": "Ти випробував моє серце,"
  },
  {
    "id": 176,
    "book": "psalms                                  ",
    "chapter": "16",
    "verse": "4",
    "text": "Щодо справ людських,"
  },
  {
    "id": 177,
    "book": "psalms                                  ",
    "chapter": "16",
    "verse": "5",
    "text": "Стопи мої крокували тільки Твоїми стежками,"
  },
  {
    "id": 178,
    "book": "psalms                                  ",
    "chapter": "16",
    "verse": "6",
    "text": "Я кличу до Тебе, бо Ти відповіси мені, Боже;"
  },
  {
    "id": 179,
    "book": "psalms                                  ",
    "chapter": "16",
    "verse": "7",
    "text": "З’яви дивну милість Твою,"
  },
  {
    "id": 180,
    "book": "psalms                                  ",
    "chapter": "16",
    "verse": "8",
    "text": "Бережи мене мов зіницю ока,"
  },
  {
    "id": 181,
    "book": "psalms                                  ",
    "chapter": "16",
    "verse": "9",
    "text": "від нечестивих, що грабують мене,"
  },
  {
    "id": 182,
    "book": "psalms                                  ",
    "chapter": "16",
    "verse": "10",
    "text": "Вони заплили жиром,"
  },
  {
    "id": 183,
    "book": "psalms                                  ",
    "chapter": "16",
    "verse": "11",
    "text": "Підкрадалися до мене таємно, а тепер оточили мене,"
  },
  {
    "id": 184,
    "book": "psalms                                  ",
    "chapter": "16",
    "verse": "12",
    "text": "Немов той лев, що прагне терзати здобич,"
  },
  {
    "id": 185,
    "book": "psalms                                  ",
    "chapter": "16",
    "verse": "13",
    "text": "Піднімися, Господи, стань перед ним, кинь додолу його;"
  },
  {
    "id": 186,
    "book": "psalms                                  ",
    "chapter": "16",
    "verse": "14",
    "text": "рукою Твоєю від мужів, Господи, –"
  },
  {
    "id": 187,
    "book": "psalms                                  ",
    "chapter": "16",
    "verse": "15",
    "text": "А я в правді побачу обличчя Твоє,"
  }
]
