[
  {
    "id": 1429,
    "book": "psalms                                  ",
    "chapter": "87",
    "verse": "1",
    "text": "Пісня. Псалом синів Кореєвих. Керівнику хору. На мотив махалат лаанот.87:1 Або: хоровод, що йде назустріч. Див. також пояснення до Пс. 52:1. Повчання Гемана-езрахітянина."
  },
  {
    "id": 1430,
    "book": "psalms                                  ",
    "chapter": "87",
    "verse": "2",
    "text": "Господи, Боже мого спасіння,"
  },
  {
    "id": 1431,
    "book": "psalms                                  ",
    "chapter": "87",
    "verse": "3",
    "text": "Нехай молитва моя дійде до Твого обличчя,"
  },
  {
    "id": 1432,
    "book": "psalms                                  ",
    "chapter": "87",
    "verse": "4",
    "text": "Бо душа моя наситилася стражданнями"
  },
  {
    "id": 1433,
    "book": "psalms                                  ",
    "chapter": "87",
    "verse": "5",
    "text": "Мене зараховано до тих, хто спускається до прірви;"
  },
  {
    "id": 1434,
    "book": "psalms                                  ",
    "chapter": "87",
    "verse": "6",
    "text": "Я покинутий між мертвими,"
  },
  {
    "id": 1435,
    "book": "psalms                                  ",
    "chapter": "87",
    "verse": "7",
    "text": "Ти поклав мене в глибоку прірву,"
  },
  {
    "id": 1436,
    "book": "psalms                                  ",
    "chapter": "87",
    "verse": "8",
    "text": "Твій гнів тяжіє наді мною,"
  },
  {
    "id": 1437,
    "book": "psalms                                  ",
    "chapter": "87",
    "verse": "9",
    "text": "Ти віддалив від мене моїх знайомих,"
  },
  {
    "id": 1438,
    "book": "psalms                                  ",
    "chapter": "87",
    "verse": "10",
    "text": "очі мої виснажилися від гніту."
  },
  {
    "id": 1439,
    "book": "psalms                                  ",
    "chapter": "87",
    "verse": "11",
    "text": "Хіба Ти твориш чудеса для померлих?"
  },
  {
    "id": 1440,
    "book": "psalms                                  ",
    "chapter": "87",
    "verse": "12",
    "text": "Чи буде звіщатися в могилі милість Твоя"
  },
  {
    "id": 1441,
    "book": "psalms                                  ",
    "chapter": "87",
    "verse": "13",
    "text": "Хіба серед мороку звіщають чудеса Твої"
  },
  {
    "id": 1442,
    "book": "psalms                                  ",
    "chapter": "87",
    "verse": "14",
    "text": "Я ж, Господи, волаю до Тебе,"
  },
  {
    "id": 1443,
    "book": "psalms                                  ",
    "chapter": "87",
    "verse": "15",
    "text": "Чому, Господи, Ти цураєшся душі моєї,"
  },
  {
    "id": 1444,
    "book": "psalms                                  ",
    "chapter": "87",
    "verse": "16",
    "text": "Від юності своєї я пригнічений і виснажений,"
  },
  {
    "id": 1445,
    "book": "psalms                                  ",
    "chapter": "87",
    "verse": "17",
    "text": "Твоя лють пройшла наді мною,"
  },
  {
    "id": 1446,
    "book": "psalms                                  ",
    "chapter": "87",
    "verse": "18",
    "text": "Вони, як вода, оточують мене цілий день,"
  },
  {
    "id": 1447,
    "book": "psalms                                  ",
    "chapter": "87",
    "verse": "19",
    "text": "Ти віддалив від мене приятеля й друга,"
  }
]
