[
  {
    "id": 516,
    "book": "psalms                                  ",
    "chapter": "35",
    "verse": "1",
    "text": "Керівнику хору. Псалом слуги Господнього, Давида."
  },
  {
    "id": 517,
    "book": "psalms                                  ",
    "chapter": "35",
    "verse": "2",
    "text": "Промовляє беззаконня до нечестивця"
  },
  {
    "id": 518,
    "book": "psalms                                  ",
    "chapter": "35",
    "verse": "3",
    "text": "Адже він так сам себе улещує в очах своїх,"
  },
  {
    "id": 519,
    "book": "psalms                                  ",
    "chapter": "35",
    "verse": "4",
    "text": "Слова вуст його – беззаконня й підступ;"
  },
  {
    "id": 520,
    "book": "psalms                                  ",
    "chapter": "35",
    "verse": "5",
    "text": "Він задумує беззаконня навіть на своєму ложі,"
  },
  {
    "id": 521,
    "book": "psalms                                  ",
    "chapter": "35",
    "verse": "6",
    "text": "Господи, Твоя милість сягає небес,"
  },
  {
    "id": 522,
    "book": "psalms                                  ",
    "chapter": "35",
    "verse": "7",
    "text": "Праведність Твоя – немов могутні гори,"
  },
  {
    "id": 523,
    "book": "psalms                                  ",
    "chapter": "35",
    "verse": "8",
    "text": "Яка дорогоцінна милість Твоя, Боже!"
  },
  {
    "id": 524,
    "book": "psalms                                  ",
    "chapter": "35",
    "verse": "9",
    "text": "Насичуються вони від достатку благ Твого дому,"
  },
  {
    "id": 525,
    "book": "psalms                                  ",
    "chapter": "35",
    "verse": "10",
    "text": "Адже в Тебе джерело життя,"
  },
  {
    "id": 526,
    "book": "psalms                                  ",
    "chapter": "35",
    "verse": "11",
    "text": "Продовж Свою милість для тих, хто Тебе знає,"
  },
  {
    "id": 527,
    "book": "psalms                                  ",
    "chapter": "35",
    "verse": "12",
    "text": "Нехай не наступить на мене нога зухвалого,"
  },
  {
    "id": 528,
    "book": "psalms                                  ",
    "chapter": "35",
    "verse": "13",
    "text": "Поглянь-но: ось там упали ті, що чинять беззаконня,"
  }
]
