[
  {
    "id": 2365,
    "book": "psalms                                  ",
    "chapter": "138",
    "verse": "1",
    "text": "Керівнику хору. Псалом Давидів."
  },
  {
    "id": 2366,
    "book": "psalms                                  ",
    "chapter": "138",
    "verse": "2",
    "text": "Сідаю я чи встаю – Ти знаєш;"
  },
  {
    "id": 2367,
    "book": "psalms                                  ",
    "chapter": "138",
    "verse": "3",
    "text": "Ти спостерігаєш за мандрівкою моєю й відпочинком,"
  },
  {
    "id": 2368,
    "book": "psalms                                  ",
    "chapter": "138",
    "verse": "4",
    "text": "Ще немає слова на язиці у мене,"
  },
  {
    "id": 2369,
    "book": "psalms                                  ",
    "chapter": "138",
    "verse": "5",
    "text": "Ти оточив мене ззаду й спереду"
  },
  {
    "id": 2370,
    "book": "psalms                                  ",
    "chapter": "138",
    "verse": "6",
    "text": "Дивне для мене знання Твоє,"
  },
  {
    "id": 2371,
    "book": "psalms                                  ",
    "chapter": "138",
    "verse": "7",
    "text": "Куди піти я можу від Духа Твого?"
  },
  {
    "id": 2372,
    "book": "psalms                                  ",
    "chapter": "138",
    "verse": "8",
    "text": "Якщо зійду на небеса – Ти там;"
  },
  {
    "id": 2373,
    "book": "psalms                                  ",
    "chapter": "138",
    "verse": "9",
    "text": "Чи піднесусь на крилах досвітньої зорі,"
  },
  {
    "id": 2374,
    "book": "psalms                                  ",
    "chapter": "138",
    "verse": "10",
    "text": "навіть там рука Твоя поведе мене,"
  },
  {
    "id": 2375,
    "book": "psalms                                  ",
    "chapter": "138",
    "verse": "11",
    "text": "А якщо скажу: «Напевно, темрява сховає мене"
  },
  {
    "id": 2376,
    "book": "psalms                                  ",
    "chapter": "138",
    "verse": "12",
    "text": "то навіть темрява не буде темною для Тебе,"
  },
  {
    "id": 2377,
    "book": "psalms                                  ",
    "chapter": "138",
    "verse": "13",
    "text": "Адже Ти створив нутрощі мої,"
  },
  {
    "id": 2378,
    "book": "psalms                                  ",
    "chapter": "138",
    "verse": "14",
    "text": "Буду славити Тебе за те,"
  },
  {
    "id": 2379,
    "book": "psalms                                  ",
    "chapter": "138",
    "verse": "15",
    "text": "Не були приховані від Тебе мої кості,"
  },
  {
    "id": 2380,
    "book": "psalms                                  ",
    "chapter": "138",
    "verse": "16",
    "text": "Твої очі бачили мій зародок,"
  },
  {
    "id": 2381,
    "book": "psalms                                  ",
    "chapter": "138",
    "verse": "17",
    "text": "Які ж дорогі для мене думки Твої, Боже!"
  },
  {
    "id": 2382,
    "book": "psalms                                  ",
    "chapter": "138",
    "verse": "18",
    "text": "Почну лічити їх –"
  },
  {
    "id": 2383,
    "book": "psalms                                  ",
    "chapter": "138",
    "verse": "19",
    "text": "О Боже, якби Ти знищив нечестивого!"
  },
  {
    "id": 2384,
    "book": "psalms                                  ",
    "chapter": "138",
    "verse": "20",
    "text": "Вони говорять про Тебе з лукавством,"
  },
  {
    "id": 2385,
    "book": "psalms                                  ",
    "chapter": "138",
    "verse": "21",
    "text": "Як же не зненавидіти мені тих,"
  },
  {
    "id": 2386,
    "book": "psalms                                  ",
    "chapter": "138",
    "verse": "22",
    "text": "Ненавиджу їх повною ненавистю,"
  },
  {
    "id": 2387,
    "book": "psalms                                  ",
    "chapter": "138",
    "verse": "23",
    "text": "Досліди мене, Боже, і пізнай моє серце;"
  },
  {
    "id": 2388,
    "book": "psalms                                  ",
    "chapter": "138",
    "verse": "24",
    "text": "І подивися, чи не на хибній я дорозі,"
  }
]
