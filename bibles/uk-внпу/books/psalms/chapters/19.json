[
  {
    "id": 254,
    "book": "psalms                                  ",
    "chapter": "19",
    "verse": "1",
    "text": "Керівнику хору. Псалом Давидів."
  },
  {
    "id": 255,
    "book": "psalms                                  ",
    "chapter": "19",
    "verse": "2",
    "text": "Нехай відповість тобі Господь у день скорботи."
  },
  {
    "id": 256,
    "book": "psalms                                  ",
    "chapter": "19",
    "verse": "3",
    "text": "Нехай пошле Він тобі допомогу зі Святилища"
  },
  {
    "id": 257,
    "book": "psalms                                  ",
    "chapter": "19",
    "verse": "4",
    "text": "Нехай Він згадає усі твої жертвоприношення з прихильністю"
  },
  {
    "id": 258,
    "book": "psalms                                  ",
    "chapter": "19",
    "verse": "5",
    "text": "Нехай Він дасть тобі те, чого бажає твоє серце,"
  },
  {
    "id": 259,
    "book": "psalms                                  ",
    "chapter": "19",
    "verse": "6",
    "text": "Ми радісно гукатимемо про твою перемогу,"
  },
  {
    "id": 260,
    "book": "psalms                                  ",
    "chapter": "19",
    "verse": "7",
    "text": "Тепер я знаю, що рятує Господь помазанця Свого,"
  },
  {
    "id": 261,
    "book": "psalms                                  ",
    "chapter": "19",
    "verse": "8",
    "text": "Дехто хвалиться колісницями, дехто – конями,"
  },
  {
    "id": 262,
    "book": "psalms                                  ",
    "chapter": "19",
    "verse": "9",
    "text": "Вони похилилися й впали,"
  },
  {
    "id": 263,
    "book": "psalms                                  ",
    "chapter": "19",
    "verse": "10",
    "text": "Господи, даруй перемогу!"
  }
]
