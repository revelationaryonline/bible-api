[
  {
    "id": 2403,
    "book": "psalms                                  ",
    "chapter": "140",
    "verse": "1",
    "text": "Псалом Давидів."
  },
  {
    "id": 2404,
    "book": "psalms                                  ",
    "chapter": "140",
    "verse": "2",
    "text": "Нехай молитва моя постане"
  },
  {
    "id": 2405,
    "book": "psalms                                  ",
    "chapter": "140",
    "verse": "3",
    "text": "Господи, постав варту біля моїх вуст,"
  },
  {
    "id": 2406,
    "book": "psalms                                  ",
    "chapter": "140",
    "verse": "4",
    "text": "Не дай серцю моєму ухилитися в бік зла,"
  },
  {
    "id": 2407,
    "book": "psalms                                  ",
    "chapter": "140",
    "verse": "5",
    "text": "Нехай картає мене праведник – це милість;"
  },
  {
    "id": 2408,
    "book": "psalms                                  ",
    "chapter": "140",
    "verse": "6",
    "text": "Нехай би скинуті були судді їхні з країв скелі,"
  },
  {
    "id": 2409,
    "book": "psalms                                  ",
    "chapter": "140",
    "verse": "7",
    "text": "Як орють землю й розбивають грудки на ній,"
  },
  {
    "id": 2410,
    "book": "psalms                                  ",
    "chapter": "140",
    "verse": "8",
    "text": "Але до Тебе, Господи, Владико, звернені мої очі;"
  },
  {
    "id": 2411,
    "book": "psalms                                  ",
    "chapter": "140",
    "verse": "9",
    "text": "Убережи мене від тенет, що розкинуті для мене,"
  },
  {
    "id": 2412,
    "book": "psalms                                  ",
    "chapter": "140",
    "verse": "10",
    "text": "Нехай впадуть нечестиві у свої ж пастки,"
  }
]
