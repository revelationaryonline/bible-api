[
  {
    "id": 1534,
    "book": "psalms                                  ",
    "chapter": "91",
    "verse": "1",
    "text": "Псалом. Пісня на день суботній."
  },
  {
    "id": 1535,
    "book": "psalms                                  ",
    "chapter": "91",
    "verse": "2",
    "text": "Як добре славити Господа"
  },
  {
    "id": 1536,
    "book": "psalms                                  ",
    "chapter": "91",
    "verse": "3",
    "text": "звіщати вранці милість Твою"
  },
  {
    "id": 1537,
    "book": "psalms                                  ",
    "chapter": "91",
    "verse": "4",
    "text": "на лірі десятиструнній"
  },
  {
    "id": 1538,
    "book": "psalms                                  ",
    "chapter": "91",
    "verse": "5",
    "text": "Бо Ти порадував мене, Господи, діянням Своїм,"
  },
  {
    "id": 1539,
    "book": "psalms                                  ",
    "chapter": "91",
    "verse": "6",
    "text": "Які величні діяння Твої, Господи,"
  },
  {
    "id": 1540,
    "book": "psalms                                  ",
    "chapter": "91",
    "verse": "7",
    "text": "Невіглас не знає,"
  },
  {
    "id": 1541,
    "book": "psalms                                  ",
    "chapter": "91",
    "verse": "8",
    "text": "Хоча нечестиві розростаються, як трава,"
  },
  {
    "id": 1542,
    "book": "psalms                                  ",
    "chapter": "91",
    "verse": "9",
    "text": "Ти ж, Господи, навіки піднесений."
  },
  {
    "id": 1543,
    "book": "psalms                                  ",
    "chapter": "91",
    "verse": "10",
    "text": "Бо справді, вороги Твої, Господи,"
  },
  {
    "id": 1544,
    "book": "psalms                                  ",
    "chapter": "91",
    "verse": "11",
    "text": "А Ти підніс мій ріг, як ріг тура,91:11 Або: зубр або єдиноріг. –"
  },
  {
    "id": 1545,
    "book": "psalms                                  ",
    "chapter": "91",
    "verse": "12",
    "text": "Око моє бачить падіння ворогів моїх,"
  },
  {
    "id": 1546,
    "book": "psalms                                  ",
    "chapter": "91",
    "verse": "13",
    "text": "Праведник цвіте, мов пальма,"
  },
  {
    "id": 1547,
    "book": "psalms                                  ",
    "chapter": "91",
    "verse": "14",
    "text": "Посаджені в домі Господньому,"
  },
  {
    "id": 1548,
    "book": "psalms                                  ",
    "chapter": "91",
    "verse": "15",
    "text": "Навіть у старості принесуть плоди,"
  },
  {
    "id": 1549,
    "book": "psalms                                  ",
    "chapter": "91",
    "verse": "16",
    "text": "щоб звіщати, що справедливий Господь, скеля моя,"
  }
]
