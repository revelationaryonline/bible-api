[
  {
    "id": 1089,
    "book": "psalms                                  ",
    "chapter": "70",
    "verse": "1",
    "text": "У Тебе, Господи, я шукаю захисту,"
  },
  {
    "id": 1090,
    "book": "psalms                                  ",
    "chapter": "70",
    "verse": "2",
    "text": "У Своїй праведності визволи мене і врятуй;"
  },
  {
    "id": 1091,
    "book": "psalms                                  ",
    "chapter": "70",
    "verse": "3",
    "text": "Будь для мене скелею для оселі моєї,"
  },
  {
    "id": 1092,
    "book": "psalms                                  ",
    "chapter": "70",
    "verse": "4",
    "text": "Боже мій, визволи мене від руки нечестивого,"
  },
  {
    "id": 1093,
    "book": "psalms                                  ",
    "chapter": "70",
    "verse": "5",
    "text": "Бо Ти – надія моя, Владико Господи,"
  },
  {
    "id": 1094,
    "book": "psalms                                  ",
    "chapter": "70",
    "verse": "6",
    "text": "На Тобі я утверджувався від самого народження;"
  },
  {
    "id": 1095,
    "book": "psalms                                  ",
    "chapter": "70",
    "verse": "7",
    "text": "Я став ніби знаком для багатьох,"
  },
  {
    "id": 1096,
    "book": "psalms                                  ",
    "chapter": "70",
    "verse": "8",
    "text": "Нехай вуста мої наповняться хвалою Тобі,"
  },
  {
    "id": 1097,
    "book": "psalms                                  ",
    "chapter": "70",
    "verse": "9",
    "text": "Не залиши мене в час старості;"
  },
  {
    "id": 1098,
    "book": "psalms                                  ",
    "chapter": "70",
    "verse": "10",
    "text": "Бо подейкують про мене вороги мої,"
  },
  {
    "id": 1099,
    "book": "psalms                                  ",
    "chapter": "70",
    "verse": "11",
    "text": "кажучи: «Бог покинув його."
  },
  {
    "id": 1100,
    "book": "psalms                                  ",
    "chapter": "70",
    "verse": "12",
    "text": "Боже, не віддаляйся від мене!"
  },
  {
    "id": 1101,
    "book": "psalms                                  ",
    "chapter": "70",
    "verse": "13",
    "text": "Нехай посоромлені будуть і загинуть супротивники душі моєї;"
  },
  {
    "id": 1102,
    "book": "psalms                                  ",
    "chapter": "70",
    "verse": "14",
    "text": "А я завжди сподіватимуся"
  },
  {
    "id": 1103,
    "book": "psalms                                  ",
    "chapter": "70",
    "verse": "15",
    "text": "Вуста мої проголошуватимуть Твою праведність"
  },
  {
    "id": 1104,
    "book": "psalms                                  ",
    "chapter": "70",
    "verse": "16",
    "text": "Я увійду в роздуми про могутність Владики Господа,"
  },
  {
    "id": 1105,
    "book": "psalms                                  ",
    "chapter": "70",
    "verse": "17",
    "text": "Боже, Ти вчив мене від часів юності моєї,"
  },
  {
    "id": 1106,
    "book": "psalms                                  ",
    "chapter": "70",
    "verse": "18",
    "text": "Тож і до старості й сивини, Боже,"
  },
  {
    "id": 1107,
    "book": "psalms                                  ",
    "chapter": "70",
    "verse": "19",
    "text": "А праведність Твоя, Боже, до висот сягає;"
  },
  {
    "id": 1108,
    "book": "psalms                                  ",
    "chapter": "70",
    "verse": "20",
    "text": "Хоча Ти показав мені чимало тяжких скорбот,"
  },
  {
    "id": 1109,
    "book": "psalms                                  ",
    "chapter": "70",
    "verse": "21",
    "text": "Ти примножував велич мою"
  },
  {
    "id": 1110,
    "book": "psalms                                  ",
    "chapter": "70",
    "verse": "22",
    "text": "Тож і я прославлю Тебе струнами ліри"
  },
  {
    "id": 1111,
    "book": "psalms                                  ",
    "chapter": "70",
    "verse": "23",
    "text": "Радісно вигукують уста мої, коли я співаю для Тебе,"
  },
  {
    "id": 1112,
    "book": "psalms                                  ",
    "chapter": "70",
    "verse": "24",
    "text": "також і язик мій цілий день промовлятиме правду Твою,"
  }
]
