[
  {
    "id": 1501,
    "book": "psalms                                  ",
    "chapter": "89",
    "verse": "1",
    "text": "Молитва Мойсея, чоловіка Божого."
  },
  {
    "id": 1502,
    "book": "psalms                                  ",
    "chapter": "89",
    "verse": "2",
    "text": "Владико, Ти був пристановищем нашим"
  },
  {
    "id": 1503,
    "book": "psalms                                  ",
    "chapter": "89",
    "verse": "3",
    "text": "Перш ніж народилися гори"
  },
  {
    "id": 1504,
    "book": "psalms                                  ",
    "chapter": "89",
    "verse": "4",
    "text": "Ти повертаєш людину назад у порох"
  },
  {
    "id": 1505,
    "book": "psalms                                  ",
    "chapter": "89",
    "verse": "5",
    "text": "Адже тисяча років в очах Твоїх,"
  },
  {
    "id": 1506,
    "book": "psalms                                  ",
    "chapter": "89",
    "verse": "6",
    "text": "Потоком Ти несеш людей,"
  },
  {
    "id": 1507,
    "book": "psalms                                  ",
    "chapter": "89",
    "verse": "7",
    "text": "Ми щезаємо у гніві Твоєму,"
  },
  {
    "id": 1508,
    "book": "psalms                                  ",
    "chapter": "89",
    "verse": "8",
    "text": "Ти поклав наші беззаконня перед Собою,"
  },
  {
    "id": 1509,
    "book": "psalms                                  ",
    "chapter": "89",
    "verse": "9",
    "text": "Бо всі дні наші проходять у люті Твоїй;"
  },
  {
    "id": 1510,
    "book": "psalms                                  ",
    "chapter": "89",
    "verse": "10",
    "text": "Днів наших – сімдесят років,"
  },
  {
    "id": 1511,
    "book": "psalms                                  ",
    "chapter": "89",
    "verse": "11",
    "text": "Хто знає силу гніву Твого?"
  },
  {
    "id": 1512,
    "book": "psalms                                  ",
    "chapter": "89",
    "verse": "12",
    "text": "Навчи нас так лічити дні наші,"
  },
  {
    "id": 1513,
    "book": "psalms                                  ",
    "chapter": "89",
    "verse": "13",
    "text": "Повернися ж, Господи, доки так буде?"
  },
  {
    "id": 1514,
    "book": "psalms                                  ",
    "chapter": "89",
    "verse": "14",
    "text": "Насичуй нас милістю Твоєю вранці,"
  },
  {
    "id": 1515,
    "book": "psalms                                  ",
    "chapter": "89",
    "verse": "15",
    "text": "Дай нам порадіти за ті дні, коли Ти упокорював нас,"
  },
  {
    "id": 1516,
    "book": "psalms                                  ",
    "chapter": "89",
    "verse": "16",
    "text": "Нехай з’явиться Твоє діло рабам Твоїм,"
  },
  {
    "id": 1517,
    "book": "psalms                                  ",
    "chapter": "89",
    "verse": "17",
    "text": "І нехай перебуватиме прихильність Володаря, Бога нашого, на нас."
  }
]
