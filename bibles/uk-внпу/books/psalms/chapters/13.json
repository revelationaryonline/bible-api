[
  {
    "id": 150,
    "book": "psalms                                  ",
    "chapter": "13",
    "verse": "1",
    "text": "Керівнику хору. Давидів."
  },
  {
    "id": 151,
    "book": "psalms                                  ",
    "chapter": "13",
    "verse": "2",
    "text": "Господь із небес поглядає на синів людських,"
  },
  {
    "id": 152,
    "book": "psalms                                  ",
    "chapter": "13",
    "verse": "3",
    "text": "Усі як один вони збочили з дороги,"
  },
  {
    "id": 153,
    "book": "psalms                                  ",
    "chapter": "13",
    "verse": "4",
    "text": "Невже не схаменуться всі ті, хто чинить беззаконня,"
  },
  {
    "id": 154,
    "book": "psalms                                  ",
    "chapter": "13",
    "verse": "5",
    "text": "Там, на шляху їхньому, охопить їх страх,"
  },
  {
    "id": 155,
    "book": "psalms                                  ",
    "chapter": "13",
    "verse": "6",
    "text": "Ви глузуєте зі сподівань пригнобленого,"
  },
  {
    "id": 156,
    "book": "psalms                                  ",
    "chapter": "13",
    "verse": "7",
    "text": "О, хто дав би із Сіону порятунок Ізраїлеві!"
  }
]
