[
  {
    "id": 624,
    "book": "psalms                                  ",
    "chapter": "40",
    "verse": "1",
    "text": "Керівнику хору. Псалом Давидів."
  },
  {
    "id": 625,
    "book": "psalms                                  ",
    "chapter": "40",
    "verse": "2",
    "text": "Блаженний той, хто дбає про слабкого:"
  },
  {
    "id": 626,
    "book": "psalms                                  ",
    "chapter": "40",
    "verse": "3",
    "text": "Господь берегтиме його й додасть йому життєвих сил,"
  },
  {
    "id": 627,
    "book": "psalms                                  ",
    "chapter": "40",
    "verse": "4",
    "text": "Господь підтримає його на ложі під час недуги,"
  },
  {
    "id": 628,
    "book": "psalms                                  ",
    "chapter": "40",
    "verse": "5",
    "text": "Я сказав: «Господи, помилуй мене,"
  },
  {
    "id": 629,
    "book": "psalms                                  ",
    "chapter": "40",
    "verse": "6",
    "text": "Вороги мої злісно говорять про мене:"
  },
  {
    "id": 630,
    "book": "psalms                                  ",
    "chapter": "40",
    "verse": "7",
    "text": "А коли хто приходить побачитись зі мною,"
  },
  {
    "id": 631,
    "book": "psalms                                  ",
    "chapter": "40",
    "verse": "8",
    "text": "Шепочуться разом проти мене всі, хто ненавидить мене,"
  },
  {
    "id": 632,
    "book": "psalms                                  ",
    "chapter": "40",
    "verse": "9",
    "text": "«Кара за віроломство спіткала його;"
  },
  {
    "id": 633,
    "book": "psalms                                  ",
    "chapter": "40",
    "verse": "10",
    "text": "Навіть близький друг мій, якому я довіряв,"
  },
  {
    "id": 634,
    "book": "psalms                                  ",
    "chapter": "40",
    "verse": "11",
    "text": "Ти ж, Господи, помилуй мене;"
  },
  {
    "id": 635,
    "book": "psalms                                  ",
    "chapter": "40",
    "verse": "12",
    "text": "Через це я дізнаюся, що Ти прихильний до мене,"
  },
  {
    "id": 636,
    "book": "psalms                                  ",
    "chapter": "40",
    "verse": "13",
    "text": "Адже Ти підтримаєш мене заради невинності моєї"
  },
  {
    "id": 637,
    "book": "psalms                                  ",
    "chapter": "40",
    "verse": "14",
    "text": "Благословенний Господь, Бог Ізраїлю,"
  }
]
