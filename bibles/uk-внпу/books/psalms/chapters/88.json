[
  {
    "id": 1448,
    "book": "psalms                                  ",
    "chapter": "88",
    "verse": "1",
    "text": "Роздуми Етана-езрахітянина."
  },
  {
    "id": 1449,
    "book": "psalms                                  ",
    "chapter": "88",
    "verse": "2",
    "text": "Про милість Господа повіки співатиму,"
  },
  {
    "id": 1450,
    "book": "psalms                                  ",
    "chapter": "88",
    "verse": "3",
    "text": "Кажу-бо я: навіки поставлена милість,"
  },
  {
    "id": 1451,
    "book": "psalms                                  ",
    "chapter": "88",
    "verse": "4",
    "text": "«Уклав Я Завіт Свій з обраним Моїм,"
  },
  {
    "id": 1452,
    "book": "psalms                                  ",
    "chapter": "88",
    "verse": "5",
    "text": "навіки утверджу насіння Твоє,"
  },
  {
    "id": 1453,
    "book": "psalms                                  ",
    "chapter": "88",
    "verse": "6",
    "text": "І небеса прославлять чудеса Твої, Господи,"
  },
  {
    "id": 1454,
    "book": "psalms                                  ",
    "chapter": "88",
    "verse": "7",
    "text": "Бо хто на хмарах може стати в один ряд із Господом?"
  },
  {
    "id": 1455,
    "book": "psalms                                  ",
    "chapter": "88",
    "verse": "8",
    "text": "Бог трепетно вшанований на великій раді святих"
  },
  {
    "id": 1456,
    "book": "psalms                                  ",
    "chapter": "88",
    "verse": "9",
    "text": "Господи, Боже Воїнств, хто такий могутній, як Ти?"
  },
  {
    "id": 1457,
    "book": "psalms                                  ",
    "chapter": "88",
    "verse": "10",
    "text": "Ти пануєш над розбурханим морем;"
  },
  {
    "id": 1458,
    "book": "psalms                                  ",
    "chapter": "88",
    "verse": "11",
    "text": "Ти вразив Раава88:11 Раав – інша назва Єгипту. Див. Пс. 86:4., немов убитого в бою;"
  },
  {
    "id": 1459,
    "book": "psalms                                  ",
    "chapter": "88",
    "verse": "12",
    "text": "Твої небеса і земля Твоя;"
  },
  {
    "id": 1460,
    "book": "psalms                                  ",
    "chapter": "88",
    "verse": "13",
    "text": "Ти створив північ і південь;"
  },
  {
    "id": 1461,
    "book": "psalms                                  ",
    "chapter": "88",
    "verse": "14",
    "text": "Рамено Твоє могутнє, рука Твоя міцна,"
  },
  {
    "id": 1462,
    "book": "psalms                                  ",
    "chapter": "88",
    "verse": "15",
    "text": "Правда й справедливість – основа Твого престолу,"
  },
  {
    "id": 1463,
    "book": "psalms                                  ",
    "chapter": "88",
    "verse": "16",
    "text": "Блаженний народ, що знає звук сурми –"
  },
  {
    "id": 1464,
    "book": "psalms                                  ",
    "chapter": "88",
    "verse": "17",
    "text": "Іменем Твоїм веселяться цілий день"
  },
  {
    "id": 1465,
    "book": "psalms                                  ",
    "chapter": "88",
    "verse": "18",
    "text": "Бо окраса їхньої міці – Ти,"
  },
  {
    "id": 1466,
    "book": "psalms                                  ",
    "chapter": "88",
    "verse": "19",
    "text": "Адже від Господа – щит наш,"
  },
  {
    "id": 1467,
    "book": "psalms                                  ",
    "chapter": "88",
    "verse": "20",
    "text": "Колись промовляв Ти у видінні вірним Своїм, кажучи:"
  },
  {
    "id": 1468,
    "book": "psalms                                  ",
    "chapter": "88",
    "verse": "21",
    "text": "Я знайшов Давида, раба Мого,"
  },
  {
    "id": 1469,
    "book": "psalms                                  ",
    "chapter": "88",
    "verse": "22",
    "text": "Рука Моя підтримає його,"
  },
  {
    "id": 1470,
    "book": "psalms                                  ",
    "chapter": "88",
    "verse": "23",
    "text": "Не здолає його ворог,"
  },
  {
    "id": 1471,
    "book": "psalms                                  ",
    "chapter": "88",
    "verse": "24",
    "text": "Пошматую перед ним усіх ворогів його"
  },
  {
    "id": 1472,
    "book": "psalms                                  ",
    "chapter": "88",
    "verse": "25",
    "text": "Вірність і милість Моя з ним,"
  },
  {
    "id": 1473,
    "book": "psalms                                  ",
    "chapter": "88",
    "verse": "26",
    "text": "Покладу його руку на море,"
  },
  {
    "id": 1474,
    "book": "psalms                                  ",
    "chapter": "88",
    "verse": "27",
    "text": "Він буде кликати Мене: „Ти – мій Батько,"
  },
  {
    "id": 1475,
    "book": "psalms                                  ",
    "chapter": "88",
    "verse": "28",
    "text": "Я зроблю його первістком,"
  },
  {
    "id": 1476,
    "book": "psalms                                  ",
    "chapter": "88",
    "verse": "29",
    "text": "Повіки берегтиму милість Мою до нього,"
  },
  {
    "id": 1477,
    "book": "psalms                                  ",
    "chapter": "88",
    "verse": "30",
    "text": "Продовжу насіння його навіки,"
  },
  {
    "id": 1478,
    "book": "psalms                                  ",
    "chapter": "88",
    "verse": "31",
    "text": "Якщо ж залишать нащадки його Закон Мій"
  },
  {
    "id": 1479,
    "book": "psalms                                  ",
    "chapter": "88",
    "verse": "32",
    "text": "якщо статутами Моїми знехтують"
  },
  {
    "id": 1480,
    "book": "psalms                                  ",
    "chapter": "88",
    "verse": "33",
    "text": "то Я жезлом покараю беззаконня їхні"
  },
  {
    "id": 1481,
    "book": "psalms                                  ",
    "chapter": "88",
    "verse": "34",
    "text": "Але милості Моєї не відійму від нього"
  },
  {
    "id": 1482,
    "book": "psalms                                  ",
    "chapter": "88",
    "verse": "35",
    "text": "Не збезчещу Завіт Мій"
  },
  {
    "id": 1483,
    "book": "psalms                                  ",
    "chapter": "88",
    "verse": "36",
    "text": "Одного разу заприсягнув Я святістю Моєю,"
  },
  {
    "id": 1484,
    "book": "psalms                                  ",
    "chapter": "88",
    "verse": "37",
    "text": "Насіння його повік перебуватиме,"
  },
  {
    "id": 1485,
    "book": "psalms                                  ",
    "chapter": "88",
    "verse": "38",
    "text": "як той місяць – свідок вірний на хмарах –"
  },
  {
    "id": 1486,
    "book": "psalms                                  ",
    "chapter": "88",
    "verse": "39",
    "text": "Але Ти знехтував, відкинув,"
  },
  {
    "id": 1487,
    "book": "psalms                                  ",
    "chapter": "88",
    "verse": "40",
    "text": "Ти зневажив Завіт із рабом Своїм,"
  },
  {
    "id": 1488,
    "book": "psalms                                  ",
    "chapter": "88",
    "verse": "41",
    "text": "Ти зруйнував усі огорожі його,"
  },
  {
    "id": 1489,
    "book": "psalms                                  ",
    "chapter": "88",
    "verse": "42",
    "text": "Грабують його всі, хто проходить дорогою;"
  },
  {
    "id": 1490,
    "book": "psalms                                  ",
    "chapter": "88",
    "verse": "43",
    "text": "Ти підніс правицю супротивників його,"
  },
  {
    "id": 1491,
    "book": "psalms                                  ",
    "chapter": "88",
    "verse": "44",
    "text": "Ти повернув назад вістря його меча"
  },
  {
    "id": 1492,
    "book": "psalms                                  ",
    "chapter": "88",
    "verse": "45",
    "text": "Ти поклав край його величі"
  },
  {
    "id": 1493,
    "book": "psalms                                  ",
    "chapter": "88",
    "verse": "46",
    "text": "Ти скоротив дні юності його,"
  },
  {
    "id": 1494,
    "book": "psalms                                  ",
    "chapter": "88",
    "verse": "47",
    "text": "Доки, Господи, ховатися будеш? Чи назавжди?"
  },
  {
    "id": 1495,
    "book": "psalms                                  ",
    "chapter": "88",
    "verse": "48",
    "text": "Згадай, яке швидкоплинне життя моє!88:48 Буквально: Згадай, наскільки швидкоплинний я!"
  },
  {
    "id": 1496,
    "book": "psalms                                  ",
    "chapter": "88",
    "verse": "49",
    "text": "Чи може хто жити й не побачити смерті?"
  },
  {
    "id": 1497,
    "book": "psalms                                  ",
    "chapter": "88",
    "verse": "50",
    "text": "Де ж милість Твоя, яку раніше Ти з’являв, Володарю,"
  },
  {
    "id": 1498,
    "book": "psalms                                  ",
    "chapter": "88",
    "verse": "51",
    "text": "Згадай, Володарю, ганьбу рабів Твоїх,"
  },
  {
    "id": 1499,
    "book": "psalms                                  ",
    "chapter": "88",
    "verse": "52",
    "text": "як безчестять вороги Твої, Господи,"
  },
  {
    "id": 1500,
    "book": "psalms                                  ",
    "chapter": "88",
    "verse": "53",
    "text": "Благословенний Господь повіки!"
  }
]
