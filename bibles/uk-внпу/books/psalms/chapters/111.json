[
  {
    "id": 1929,
    "book": "psalms                                  ",
    "chapter": "111",
    "verse": "1",
    "text": "Алілуя!"
  },
  {
    "id": 1930,
    "book": "psalms                                  ",
    "chapter": "111",
    "verse": "2",
    "text": "Будуть сильними на землі нащадки його;"
  },
  {
    "id": 1931,
    "book": "psalms                                  ",
    "chapter": "111",
    "verse": "3",
    "text": "Достаток і багатство в домі його,"
  },
  {
    "id": 1932,
    "book": "psalms                                  ",
    "chapter": "111",
    "verse": "4",
    "text": "Сяє в темряві світло для справедливих:"
  },
  {
    "id": 1933,
    "book": "psalms                                  ",
    "chapter": "111",
    "verse": "5",
    "text": "Добре тому, хто милує й позичає,"
  },
  {
    "id": 1934,
    "book": "psalms                                  ",
    "chapter": "111",
    "verse": "6",
    "text": "Бо він не похитнеться повіки;"
  },
  {
    "id": 1935,
    "book": "psalms                                  ",
    "chapter": "111",
    "verse": "7",
    "text": "Не злякається лихої чутки,"
  },
  {
    "id": 1936,
    "book": "psalms                                  ",
    "chapter": "111",
    "verse": "8",
    "text": "Утверджене його серце, не злякається,"
  },
  {
    "id": 1937,
    "book": "psalms                                  ",
    "chapter": "111",
    "verse": "9",
    "text": "Він щедро роздав бідним,"
  },
  {
    "id": 1938,
    "book": "psalms                                  ",
    "chapter": "111",
    "verse": "10",
    "text": "Нечестивий побачить це й розгнівається,"
  }
]
