[
  {
    "id": 945,
    "book": "psalms                                  ",
    "chapter": "62",
    "verse": "1",
    "text": "Псалом Давидів, коли він був у пустелі Юдейській.62:1 Див. 1 Сам. 23–24; 2 Сам. 15:13–17:29."
  },
  {
    "id": 946,
    "book": "psalms                                  ",
    "chapter": "62",
    "verse": "2",
    "text": "Боже, Ти – мій Бог, Тебе я пристрасно шукаю."
  },
  {
    "id": 947,
    "book": "psalms                                  ",
    "chapter": "62",
    "verse": "3",
    "text": "Так я споглядав Тебе у святилищі,"
  },
  {
    "id": 948,
    "book": "psalms                                  ",
    "chapter": "62",
    "verse": "4",
    "text": "Бо милість Твоя краща від самого життя,"
  },
  {
    "id": 949,
    "book": "psalms                                  ",
    "chapter": "62",
    "verse": "5",
    "text": "Я благословлятиму Тебе, поки житиму,"
  },
  {
    "id": 950,
    "book": "psalms                                  ",
    "chapter": "62",
    "verse": "6",
    "text": "Неначе лоєм і олією, насичується душа моя,"
  },
  {
    "id": 951,
    "book": "psalms                                  ",
    "chapter": "62",
    "verse": "7",
    "text": "коли я згадую Тебе на моєму ложі,"
  },
  {
    "id": 952,
    "book": "psalms                                  ",
    "chapter": "62",
    "verse": "8",
    "text": "Бо Ти був мені допомогою,"
  },
  {
    "id": 953,
    "book": "psalms                                  ",
    "chapter": "62",
    "verse": "9",
    "text": "Прилинула до Тебе душа моя,"
  },
  {
    "id": 954,
    "book": "psalms                                  ",
    "chapter": "62",
    "verse": "10",
    "text": "А ті, хто прагне загибелі для душі моєї,"
  },
  {
    "id": 955,
    "book": "psalms                                  ",
    "chapter": "62",
    "verse": "11",
    "text": "Нехай віддані мечу,"
  },
  {
    "id": 956,
    "book": "psalms                                  ",
    "chapter": "62",
    "verse": "12",
    "text": "Цар же нехай радіє Богом,"
  }
]
