[
  {
    "id": 394,
    "book": "psalms                                  ",
    "chapter": "29",
    "verse": "1",
    "text": "Псалом. Пісня Давидова на посвячення дому."
  },
  {
    "id": 395,
    "book": "psalms                                  ",
    "chapter": "29",
    "verse": "2",
    "text": "Величатиму Тебе, Господи,"
  },
  {
    "id": 396,
    "book": "psalms                                  ",
    "chapter": "29",
    "verse": "3",
    "text": "Господи, Боже мій, я волав до Тебе,"
  },
  {
    "id": 397,
    "book": "psalms                                  ",
    "chapter": "29",
    "verse": "4",
    "text": "Господи, Ти вивів мою душу із царства мертвих,"
  },
  {
    "id": 398,
    "book": "psalms                                  ",
    "chapter": "29",
    "verse": "5",
    "text": "Співайте Господеві, вірні Йому,"
  },
  {
    "id": 399,
    "book": "psalms                                  ",
    "chapter": "29",
    "verse": "6",
    "text": "Адже гнів Його триває лише мить,"
  },
  {
    "id": 400,
    "book": "psalms                                  ",
    "chapter": "29",
    "verse": "7",
    "text": "У добробуті перебуваючи, сказав я:"
  },
  {
    "id": 401,
    "book": "psalms                                  ",
    "chapter": "29",
    "verse": "8",
    "text": "Господи, через Твою прихильність до мене"
  },
  {
    "id": 402,
    "book": "psalms                                  ",
    "chapter": "29",
    "verse": "9",
    "text": "До Тебе, Господи, я кличу,"
  },
  {
    "id": 403,
    "book": "psalms                                  ",
    "chapter": "29",
    "verse": "10",
    "text": "Яка користь від того, що кров моя проллється,"
  },
  {
    "id": 404,
    "book": "psalms                                  ",
    "chapter": "29",
    "verse": "11",
    "text": "Почуй, Господи, і помилуй мене!"
  },
  {
    "id": 405,
    "book": "psalms                                  ",
    "chapter": "29",
    "verse": "12",
    "text": "Ти ридання моє перетворив на веселий хоровод,"
  },
  {
    "id": 406,
    "book": "psalms                                  ",
    "chapter": "29",
    "verse": "13",
    "text": "щоб слава Тобі звучала й не змовкала."
  }
]
