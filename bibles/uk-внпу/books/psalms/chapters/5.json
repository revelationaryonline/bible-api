[
  {
    "id": 37,
    "book": "psalms                                  ",
    "chapter": "5",
    "verse": "1",
    "text": "Керівнику хору. Для виконання в супроводі сопілок. Псалом Давидів."
  },
  {
    "id": 38,
    "book": "psalms                                  ",
    "chapter": "5",
    "verse": "2",
    "text": "Зваж на слова мої, Господи,"
  },
  {
    "id": 39,
    "book": "psalms                                  ",
    "chapter": "5",
    "verse": "3",
    "text": "Прислухайся до звуків мого зойку,"
  },
  {
    "id": 40,
    "book": "psalms                                  ",
    "chapter": "5",
    "verse": "4",
    "text": "Господи, вранці Ти почуй мій голос,"
  },
  {
    "id": 41,
    "book": "psalms                                  ",
    "chapter": "5",
    "verse": "5",
    "text": "Адже Ти не той Бог, Якому до вподоби беззаконня,"
  },
  {
    "id": 42,
    "book": "psalms                                  ",
    "chapter": "5",
    "verse": "6",
    "text": "Не встоять пихаті перед Твоїми очима,"
  },
  {
    "id": 43,
    "book": "psalms                                  ",
    "chapter": "5",
    "verse": "7",
    "text": "Ти знищиш тих, що промовляють неправду;"
  },
  {
    "id": 44,
    "book": "psalms                                  ",
    "chapter": "5",
    "verse": "8",
    "text": "Але я, завдяки великій Твоїй милості,"
  },
  {
    "id": 45,
    "book": "psalms                                  ",
    "chapter": "5",
    "verse": "9",
    "text": "Господи, веди мене Твоєю правдою"
  },
  {
    "id": 46,
    "book": "psalms                                  ",
    "chapter": "5",
    "verse": "10",
    "text": "Адже немає у вустах їхніх щирості,"
  },
  {
    "id": 47,
    "book": "psalms                                  ",
    "chapter": "5",
    "verse": "11",
    "text": "Оголоси їм вирок, Боже!"
  },
  {
    "id": 48,
    "book": "psalms                                  ",
    "chapter": "5",
    "verse": "12",
    "text": "І тоді радітимуть усі,"
  },
  {
    "id": 49,
    "book": "psalms                                  ",
    "chapter": "5",
    "verse": "13",
    "text": "Бо Ти благословляєш праведного, Господи,"
  }
]
