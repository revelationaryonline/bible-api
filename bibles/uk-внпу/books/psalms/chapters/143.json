[
  {
    "id": 2432,
    "book": "psalms                                  ",
    "chapter": "143",
    "verse": "1",
    "text": "Псалом Давидів."
  },
  {
    "id": 2433,
    "book": "psalms                                  ",
    "chapter": "143",
    "verse": "2",
    "text": "Він – милість моя, твердиня моя,"
  },
  {
    "id": 2434,
    "book": "psalms                                  ",
    "chapter": "143",
    "verse": "3",
    "text": "Господи, хто така людина, що Ти знаєш про неї,"
  },
  {
    "id": 2435,
    "book": "psalms                                  ",
    "chapter": "143",
    "verse": "4",
    "text": "Людина – немов подих вітру;"
  },
  {
    "id": 2436,
    "book": "psalms                                  ",
    "chapter": "143",
    "verse": "5",
    "text": "Господи, нахили небеса і зійди,"
  },
  {
    "id": 2437,
    "book": "psalms                                  ",
    "chapter": "143",
    "verse": "6",
    "text": "Блисни блискавкою й розсій їх,"
  },
  {
    "id": 2438,
    "book": "psalms                                  ",
    "chapter": "143",
    "verse": "7",
    "text": "Простягни руку Твою з висоти,"
  },
  {
    "id": 2439,
    "book": "psalms                                  ",
    "chapter": "143",
    "verse": "8",
    "text": "що вустами своїми марне промовляють"
  },
  {
    "id": 2440,
    "book": "psalms                                  ",
    "chapter": "143",
    "verse": "9",
    "text": "Боже, пісню нову заспіваю Тобі,"
  },
  {
    "id": 2441,
    "book": "psalms                                  ",
    "chapter": "143",
    "verse": "10",
    "text": "Тому, Хто дає перемогу царям,"
  },
  {
    "id": 2442,
    "book": "psalms                                  ",
    "chapter": "143",
    "verse": "11",
    "text": "Визволи мене й врятуй"
  },
  {
    "id": 2443,
    "book": "psalms                                  ",
    "chapter": "143",
    "verse": "12",
    "text": "Тоді будуть сини наші"
  },
  {
    "id": 2444,
    "book": "psalms                                  ",
    "chapter": "143",
    "verse": "13",
    "text": "комори будуть повні"
  },
  {
    "id": 2445,
    "book": "psalms                                  ",
    "chapter": "143",
    "verse": "14",
    "text": "бики наші будуть витривалими;"
  },
  {
    "id": 2446,
    "book": "psalms                                  ",
    "chapter": "143",
    "verse": "15",
    "text": "Блаженний народ, що так йому ведеться;"
  }
]
