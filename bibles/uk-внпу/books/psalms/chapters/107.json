[
  {
    "id": 1867,
    "book": "psalms                                  ",
    "chapter": "107",
    "verse": "1",
    "text": "Пісня. Псалом Давидів."
  },
  {
    "id": 1868,
    "book": "psalms                                  ",
    "chapter": "107",
    "verse": "2",
    "text": "Серце моє непохитне, Боже;"
  },
  {
    "id": 1869,
    "book": "psalms                                  ",
    "chapter": "107",
    "verse": "3",
    "text": "Прокинься, ліро й арфо!"
  },
  {
    "id": 1870,
    "book": "psalms                                  ",
    "chapter": "107",
    "verse": "4",
    "text": "Я прославлю Тебе серед народів, Господи,"
  },
  {
    "id": 1871,
    "book": "psalms                                  ",
    "chapter": "107",
    "verse": "5",
    "text": "Бо велика понад небеса милість Твоя"
  },
  {
    "id": 1872,
    "book": "psalms                                  ",
    "chapter": "107",
    "verse": "6",
    "text": "Піднімися понад небесами, Боже;"
  },
  {
    "id": 1873,
    "book": "psalms                                  ",
    "chapter": "107",
    "verse": "7",
    "text": "Щоб улюблені Твої були визволені,"
  },
  {
    "id": 1874,
    "book": "psalms                                  ",
    "chapter": "107",
    "verse": "8",
    "text": "Бог промовив у Своєму святилищі:"
  },
  {
    "id": 1875,
    "book": "psalms                                  ",
    "chapter": "107",
    "verse": "9",
    "text": "Мені належить Ґілеад, і Манассія – Мій,"
  },
  {
    "id": 1876,
    "book": "psalms                                  ",
    "chapter": "107",
    "verse": "10",
    "text": "Моав – Моя чаша для омовіння,"
  },
  {
    "id": 1877,
    "book": "psalms                                  ",
    "chapter": "107",
    "verse": "11",
    "text": "Хто введе мене в місто укріплене?"
  },
  {
    "id": 1878,
    "book": "psalms                                  ",
    "chapter": "107",
    "verse": "12",
    "text": "Хіба не Ти, Боже, Котрий відкинув нас"
  },
  {
    "id": 1879,
    "book": "psalms                                  ",
    "chapter": "107",
    "verse": "13",
    "text": "Подай нам допомогу в боротьбі з ворогом,"
  },
  {
    "id": 1880,
    "book": "psalms                                  ",
    "chapter": "107",
    "verse": "14",
    "text": "У Бозі ми виявимо силу,"
  }
]
