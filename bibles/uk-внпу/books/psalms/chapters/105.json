[
  {
    "id": 1776,
    "book": "psalms                                  ",
    "chapter": "105",
    "verse": "1",
    "text": "Алілуя!"
  },
  {
    "id": 1777,
    "book": "psalms                                  ",
    "chapter": "105",
    "verse": "2",
    "text": "Хто може виразити словами могутність Господа"
  },
  {
    "id": 1778,
    "book": "psalms                                  ",
    "chapter": "105",
    "verse": "3",
    "text": "Блаженні ті, хто стереже правосуддя,"
  },
  {
    "id": 1779,
    "book": "psalms                                  ",
    "chapter": "105",
    "verse": "4",
    "text": "Згадай мене, Господи, заради прихильності до Свого народу,"
  },
  {
    "id": 1780,
    "book": "psalms                                  ",
    "chapter": "105",
    "verse": "5",
    "text": "щоб міг я побачити добробут обраних Тобою,"
  },
  {
    "id": 1781,
    "book": "psalms                                  ",
    "chapter": "105",
    "verse": "6",
    "text": "Згрішили ми, як і предки наші,"
  },
  {
    "id": 1782,
    "book": "psalms                                  ",
    "chapter": "105",
    "verse": "7",
    "text": "Батьки наші в Єгипті не збагнули Його чудес,"
  },
  {
    "id": 1783,
    "book": "psalms                                  ",
    "chapter": "105",
    "verse": "8",
    "text": "Та Він все ж врятував їх заради Свого імені,"
  },
  {
    "id": 1784,
    "book": "psalms                                  ",
    "chapter": "105",
    "verse": "9",
    "text": "Пригрозив Він морю Червоному,105:9 Червоне море – так передано цю географічну назву в більшості перекладів завдяки грецькому перекладу (Септуаґінта), у єврейському тексті вжито назву Очеретяне море йам-су́ф, що позначає, імовірно, Акабську затоку (1 Цар. 9:6). і висохло воно,"
  },
  {
    "id": 1785,
    "book": "psalms                                  ",
    "chapter": "105",
    "verse": "10",
    "text": "І врятував їх від руки ненависника,"
  },
  {
    "id": 1786,
    "book": "psalms                                  ",
    "chapter": "105",
    "verse": "11",
    "text": "Покрили води супротивників їхніх –"
  },
  {
    "id": 1787,
    "book": "psalms                                  ",
    "chapter": "105",
    "verse": "12",
    "text": "Тоді повірили вони словам Його"
  },
  {
    "id": 1788,
    "book": "psalms                                  ",
    "chapter": "105",
    "verse": "13",
    "text": "Та швидко забули Його діяння,"
  },
  {
    "id": 1789,
    "book": "psalms                                  ",
    "chapter": "105",
    "verse": "14",
    "text": "Запалали пристрастю в пустелі"
  },
  {
    "id": 1790,
    "book": "psalms                                  ",
    "chapter": "105",
    "verse": "15",
    "text": "Тоді Він задовольнив прохання їхнє,"
  },
  {
    "id": 1791,
    "book": "psalms                                  ",
    "chapter": "105",
    "verse": "16",
    "text": "Та вони позаздрили Мойсею у стані"
  },
  {
    "id": 1792,
    "book": "psalms                                  ",
    "chapter": "105",
    "verse": "17",
    "text": "Відкрилася земля, і поглинула Датана,"
  },
  {
    "id": 1793,
    "book": "psalms                                  ",
    "chapter": "105",
    "verse": "18",
    "text": "Запалав вогонь серед їхнього зборища,"
  },
  {
    "id": 1794,
    "book": "psalms                                  ",
    "chapter": "105",
    "verse": "19",
    "text": "Вони зробили теля на Хориві"
  },
  {
    "id": 1795,
    "book": "psalms                                  ",
    "chapter": "105",
    "verse": "20",
    "text": "проміняли Славу свою"
  },
  {
    "id": 1796,
    "book": "psalms                                  ",
    "chapter": "105",
    "verse": "21",
    "text": "Забули Бога, Рятівника свого,"
  },
  {
    "id": 1797,
    "book": "psalms                                  ",
    "chapter": "105",
    "verse": "22",
    "text": "чудеса в землі Хамовій,"
  },
  {
    "id": 1798,
    "book": "psalms                                  ",
    "chapter": "105",
    "verse": "23",
    "text": "Він наказав би знищити їх,"
  },
  {
    "id": 1799,
    "book": "psalms                                  ",
    "chapter": "105",
    "verse": "24",
    "text": "І знехтували вони Землею Бажаною,"
  },
  {
    "id": 1800,
    "book": "psalms                                  ",
    "chapter": "105",
    "verse": "25",
    "text": "і ремствували в шатрах своїх,"
  },
  {
    "id": 1801,
    "book": "psalms                                  ",
    "chapter": "105",
    "verse": "26",
    "text": "Тоді Він простягнув руку Свою на них,"
  },
  {
    "id": 1802,
    "book": "psalms                                  ",
    "chapter": "105",
    "verse": "27",
    "text": "і розкидати нащадків їхніх поміж народами,"
  },
  {
    "id": 1803,
    "book": "psalms                                  ",
    "chapter": "105",
    "verse": "28",
    "text": "Вони пристали до Ваал-Пеора"
  },
  {
    "id": 1804,
    "book": "psalms                                  ",
    "chapter": "105",
    "verse": "29",
    "text": "І гнівили Бога вчинками своїми,"
  },
  {
    "id": 1805,
    "book": "psalms                                  ",
    "chapter": "105",
    "verse": "30",
    "text": "Постав Пінхас і вчинив суд,"
  },
  {
    "id": 1806,
    "book": "psalms                                  ",
    "chapter": "105",
    "verse": "31",
    "text": "Це зараховано було йому в праведність"
  },
  {
    "id": 1807,
    "book": "psalms                                  ",
    "chapter": "105",
    "verse": "32",
    "text": "І розлютили Його при водах Мериви,"
  },
  {
    "id": 1808,
    "book": "psalms                                  ",
    "chapter": "105",
    "verse": "33",
    "text": "бо засмутили вони його дух,"
  },
  {
    "id": 1809,
    "book": "psalms                                  ",
    "chapter": "105",
    "verse": "34",
    "text": "Вони не знищили народів,"
  },
  {
    "id": 1810,
    "book": "psalms                                  ",
    "chapter": "105",
    "verse": "35",
    "text": "але змішалися з народами"
  },
  {
    "id": 1811,
    "book": "psalms                                  ",
    "chapter": "105",
    "verse": "36",
    "text": "служили ідолам їхнім,"
  },
  {
    "id": 1812,
    "book": "psalms                                  ",
    "chapter": "105",
    "verse": "37",
    "text": "Приносили синів своїх і доньок"
  },
  {
    "id": 1813,
    "book": "psalms                                  ",
    "chapter": "105",
    "verse": "38",
    "text": "і проливали невинну кров,"
  },
  {
    "id": 1814,
    "book": "psalms                                  ",
    "chapter": "105",
    "verse": "39",
    "text": "Вони стали нечистими через свої діяння,"
  },
  {
    "id": 1815,
    "book": "psalms                                  ",
    "chapter": "105",
    "verse": "40",
    "text": "Тоді спалахнула лють Господа на народ Його,"
  },
  {
    "id": 1816,
    "book": "psalms                                  ",
    "chapter": "105",
    "verse": "41",
    "text": "І віддав Він їх у руки народів,"
  },
  {
    "id": 1817,
    "book": "psalms                                  ",
    "chapter": "105",
    "verse": "42",
    "text": "Вороги гнобили їх,"
  },
  {
    "id": 1818,
    "book": "psalms                                  ",
    "chapter": "105",
    "verse": "43",
    "text": "Він багато разів визволяв їх,"
  },
  {
    "id": 1819,
    "book": "psalms                                  ",
    "chapter": "105",
    "verse": "44",
    "text": "Але Він зглянувся на скорботу їхню,"
  },
  {
    "id": 1820,
    "book": "psalms                                  ",
    "chapter": "105",
    "verse": "45",
    "text": "і згадав про Завіт Свій з ними,"
  },
  {
    "id": 1821,
    "book": "psalms                                  ",
    "chapter": "105",
    "verse": "46",
    "text": "І викликав співчуття до них"
  },
  {
    "id": 1822,
    "book": "psalms                                  ",
    "chapter": "105",
    "verse": "47",
    "text": "Врятуй нас, Господи, Боже наш,"
  },
  {
    "id": 1823,
    "book": "psalms                                  ",
    "chapter": "105",
    "verse": "48",
    "text": "Благословенний Господь, Бог Ізраїлю,"
  }
]
