[
  {
    "id": 1378,
    "book": "psalms                                  ",
    "chapter": "83",
    "verse": "1",
    "text": "Керівнику хору. На мотив ґіттіт. Псалом синів Кореєвих."
  },
  {
    "id": 1379,
    "book": "psalms                                  ",
    "chapter": "83",
    "verse": "2",
    "text": "Які любі оселі Твої,"
  },
  {
    "id": 1380,
    "book": "psalms                                  ",
    "chapter": "83",
    "verse": "3",
    "text": "Душа моя охоплена прагненням і тужить"
  },
  {
    "id": 1381,
    "book": "psalms                                  ",
    "chapter": "83",
    "verse": "4",
    "text": "Навіть пташка знаходить собі домівку"
  },
  {
    "id": 1382,
    "book": "psalms                                  ",
    "chapter": "83",
    "verse": "5",
    "text": "Блаженні ті, що живуть у домі Твоєму –"
  },
  {
    "id": 1383,
    "book": "psalms                                  ",
    "chapter": "83",
    "verse": "6",
    "text": "Блаженна людина, чия міць у Тобі,"
  },
  {
    "id": 1384,
    "book": "psalms                                  ",
    "chapter": "83",
    "verse": "7",
    "text": "Проходячи долиною плачу,"
  },
  {
    "id": 1385,
    "book": "psalms                                  ",
    "chapter": "83",
    "verse": "8",
    "text": "Зростають їхні сили,83:8 Буквально: йдуть від сили до сили."
  },
  {
    "id": 1386,
    "book": "psalms                                  ",
    "chapter": "83",
    "verse": "9",
    "text": "Господи, Боже Воїнств, почуй мою молитву,"
  },
  {
    "id": 1387,
    "book": "psalms                                  ",
    "chapter": "83",
    "verse": "10",
    "text": "Щите наш, Боже, подивися,"
  },
  {
    "id": 1388,
    "book": "psalms                                  ",
    "chapter": "83",
    "verse": "11",
    "text": "Адже один день у Твоїх дворах"
  },
  {
    "id": 1389,
    "book": "psalms                                  ",
    "chapter": "83",
    "verse": "12",
    "text": "Бо сонце і щит – Господь Бог!"
  },
  {
    "id": 1390,
    "book": "psalms                                  ",
    "chapter": "83",
    "verse": "13",
    "text": "Господи Воїнств! Блаженна людина,"
  }
]
