    "chapter": "75",
    "verse": "1",
    "text": "Керівнику хору. На струнних інструментах. Псалом Асафа. Пісня."
  },
  {
    "id": 1196,
    "book": "psalms                                  ",
    "chapter": "75",
    "verse": "2",
    "text": "Відомий в Юдеї Бог,"
  },
  {
    "id": 1197,
    "book": "psalms                                  ",
    "chapter": "75",
    "verse": "3",
    "text": "Був у Салемі75:3 Салим – давня назва Єрусалима, див Бут. 14:18. намет Його,"
  },
  {
    "id": 1198,
    "book": "psalms                                  ",
    "chapter": "75",
    "verse": "4",
    "text": "Там зламав Він полум’яні стріли лука,"
  },
  {
    "id": 1199,
    "book": "psalms                                  ",
    "chapter": "75",
    "verse": "5",
    "text": "Ти осяяний величчю"
  },
  {
    "id": 1200,
    "book": "psalms                                  ",
    "chapter": "75",
    "verse": "6",
    "text": "Міцні серцем стали здобиччю,"
  },
  {
    "id": 1201,
    "book": "psalms                                  ",
    "chapter": "75",
    "verse": "7",
    "text": "Від грізних докорів Твоїх, Боже Якова,"
  },
  {
    "id": 1202,
    "book": "psalms                                  ",
    "chapter": "75",
    "verse": "8",
    "text": "Ти – грізний,"
  },
  {
    "id": 1203,
    "book": "psalms                                  ",
    "chapter": "75",
    "verse": "9",
    "text": "З небес Ти проголосив суд –"
  },
  {
    "id": 1204,
    "book": "psalms                                  ",
    "chapter": "75",
    "verse": "10",
    "text": "коли повстав Бог, щоб судити,"
  },
  {
    "id": 1205,
    "book": "psalms                                  ",
    "chapter": "75",
    "verse": "11",
    "text": "Адже навіть гнів людський обернеться на славу Тобі,"
  },
  {
    "id": 1206,
    "book": "psalms                                  ",
    "chapter": "75",
    "verse": "12",
    "text": "Давайте обітниці Господеві, Богові вашому, і виконуйте їх;"
  },
  {
    "id": 1207,
    "book": "psalms                                  ",
    "chapter": "75",
    "verse": "13",
    "text": "Він приборкує дух вождів,"
  }
