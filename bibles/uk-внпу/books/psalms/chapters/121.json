[
  {
    "id": 2215,
    "book": "psalms                                  ",
    "chapter": "121",
    "verse": "1",
    "text": "Пісня сходження Давидова."
  },
  {
    "id": 2216,
    "book": "psalms                                  ",
    "chapter": "121",
    "verse": "2",
    "text": "Наші ноги стоять"
  },
  {
    "id": 2217,
    "book": "psalms                                  ",
    "chapter": "121",
    "verse": "3",
    "text": "Єрусалиме, що збудований щільно"
  },
  {
    "id": 2218,
    "book": "psalms                                  ",
    "chapter": "121",
    "verse": "4",
    "text": "куди піднімаються племена, Господні племена,"
  },
  {
    "id": 2219,
    "book": "psalms                                  ",
    "chapter": "121",
    "verse": "5",
    "text": "Бо там стоять престоли судні,"
  },
  {
    "id": 2220,
    "book": "psalms                                  ",
    "chapter": "121",
    "verse": "6",
    "text": "Просіть миру для Єрусалима:"
  },
  {
    "id": 2221,
    "book": "psalms                                  ",
    "chapter": "121",
    "verse": "7",
    "text": "Нехай мир буде в укріпленнях твоїх"
  },
  {
    "id": 2222,
    "book": "psalms                                  ",
    "chapter": "121",
    "verse": "8",
    "text": "Заради братів моїх і друзів"
  },
  {
    "id": 2223,
    "book": "psalms                                  ",
    "chapter": "121",
    "verse": "9",
    "text": "Заради дому Господа, Бога нашого,"
  }
]
