[
  {
    "id": 712,
    "book": "psalms                                  ",
    "chapter": "46",
    "verse": "1",
    "text": "Керівнику хору. Псалом синів Кореєвих."
  },
  {
    "id": 713,
    "book": "psalms                                  ",
    "chapter": "46",
    "verse": "2",
    "text": "Усі народи, плескайте в долоні,"
  },
  {
    "id": 714,
    "book": "psalms                                  ",
    "chapter": "46",
    "verse": "3",
    "text": "Бо Господь Всевишній грізний,"
  },
  {
    "id": 715,
    "book": "psalms                                  ",
    "chapter": "46",
    "verse": "4",
    "text": "Він підкорив нам народи"
  },
  {
    "id": 716,
    "book": "psalms                                  ",
    "chapter": "46",
    "verse": "5",
    "text": "Він обрав для нас спадок –"
  },
  {
    "id": 717,
    "book": "psalms                                  ",
    "chapter": "46",
    "verse": "6",
    "text": "Бог піднявся під радісні вигуки,"
  },
  {
    "id": 718,
    "book": "psalms                                  ",
    "chapter": "46",
    "verse": "7",
    "text": "Співайте Богові, співайте!"
  },
  {
    "id": 719,
    "book": "psalms                                  ",
    "chapter": "46",
    "verse": "8",
    "text": "Бо Цар усієї землі – Бог,"
  },
  {
    "id": 720,
    "book": "psalms                                  ",
    "chapter": "46",
    "verse": "9",
    "text": "Бог царює над народами,"
  },
  {
    "id": 721,
    "book": "psalms                                  ",
    "chapter": "46",
    "verse": "10",
    "text": "Шляхетні з народів зібралися"
  }
]
