[
  {
    "id": 829,
    "book": "psalms                                  ",
    "chapter": "54",
    "verse": "1",
    "text": "Керівнику хору. На струнних інструментах. Повчання Давидове."
  },
  {
    "id": 830,
    "book": "psalms                                  ",
    "chapter": "54",
    "verse": "2",
    "text": "Прислухайся, Боже, до моєї молитви,"
  },
  {
    "id": 831,
    "book": "psalms                                  ",
    "chapter": "54",
    "verse": "3",
    "text": "прислухайся до мене і дай мені відповідь!"
  },
  {
    "id": 832,
    "book": "psalms                                  ",
    "chapter": "54",
    "verse": "4",
    "text": "від голосу ворога,"
  },
  {
    "id": 833,
    "book": "psalms                                  ",
    "chapter": "54",
    "verse": "5",
    "text": "Серце моє тремтить у моєму нутрі,"
  },
  {
    "id": 834,
    "book": "psalms                                  ",
    "chapter": "54",
    "verse": "6",
    "text": "Страх і трепет увійшли в мене,"
  },
  {
    "id": 835,
    "book": "psalms                                  ",
    "chapter": "54",
    "verse": "7",
    "text": "Сказав я: «Хто б дав мені крила голубині!"
  },
  {
    "id": 836,
    "book": "psalms                                  ",
    "chapter": "54",
    "verse": "8",
    "text": "полинув би вдалечінь,"
  },
  {
    "id": 837,
    "book": "psalms                                  ",
    "chapter": "54",
    "verse": "9",
    "text": "Поспішив би знайти собі прихисток"
  },
  {
    "id": 838,
    "book": "psalms                                  ",
    "chapter": "54",
    "verse": "10",
    "text": "Збентеж їх, Владико, розділи їм язики,"
  },
  {
    "id": 839,
    "book": "psalms                                  ",
    "chapter": "54",
    "verse": "11",
    "text": "Удень та вночі вони обходять його на стінах,"
  },
  {
    "id": 840,
    "book": "psalms                                  ",
    "chapter": "54",
    "verse": "12",
    "text": "Погибель серед міста,"
  },
  {
    "id": 841,
    "book": "psalms                                  ",
    "chapter": "54",
    "verse": "13",
    "text": "Адже не ворог ганьбить мене, –"
  },
  {
    "id": 842,
    "book": "psalms                                  ",
    "chapter": "54",
    "verse": "14",
    "text": "Але ти, кого я вважав одним цілим із собою,"
  },
  {
    "id": 843,
    "book": "psalms                                  ",
    "chapter": "54",
    "verse": "15",
    "text": "з ким разом ми насолоджувалися щирим спілкуванням,"
  },
  {
    "id": 844,
    "book": "psalms                                  ",
    "chapter": "54",
    "verse": "16",
    "text": "Нехай же смерть спіткає їх,"
  },
  {
    "id": 845,
    "book": "psalms                                  ",
    "chapter": "54",
    "verse": "17",
    "text": "Я ж до Бога кличу,"
  },
  {
    "id": 846,
    "book": "psalms                                  ",
    "chapter": "54",
    "verse": "18",
    "text": "Увечері, вранці й опівдні"
  },
  {
    "id": 847,
    "book": "psalms                                  ",
    "chapter": "54",
    "verse": "19",
    "text": "Він мирно визволить мою душу"
  },
  {
    "id": 848,
    "book": "psalms                                  ",
    "chapter": "54",
    "verse": "20",
    "text": "Бог почує та упокорить їх,"
  },
  {
    "id": 849,
    "book": "psalms                                  ",
    "chapter": "54",
    "verse": "21",
    "text": "Підняв товариш мій руки свої на близьких друзів,"
  },
  {
    "id": 850,
    "book": "psalms                                  ",
    "chapter": "54",
    "verse": "22",
    "text": "Вуста його слизькі, немов масло,"
  },
  {
    "id": 851,
    "book": "psalms                                  ",
    "chapter": "54",
    "verse": "23",
    "text": "Переклади свій тягар на Господа –"
  },
  {
    "id": 852,
    "book": "psalms                                  ",
    "chapter": "54",
    "verse": "24",
    "text": "Але Ти, Боже, скинеш їх"
  }
]
