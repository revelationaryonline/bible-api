[
  {
    "id": 1083,
    "book": "psalms                                  ",
    "chapter": "69",
    "verse": "1",
    "text": "Керівнику хору. Псалом Давидів. На спомин."
  },
  {
    "id": 1084,
    "book": "psalms                                  ",
    "chapter": "69",
    "verse": "2",
    "text": "Боже, визволи мене!"
  },
  {
    "id": 1085,
    "book": "psalms                                  ",
    "chapter": "69",
    "verse": "3",
    "text": "Нехай посоромляться й ганьбою вкриються ті,"
  },
  {
    "id": 1086,
    "book": "psalms                                  ",
    "chapter": "69",
    "verse": "4",
    "text": "Нехай назад обернуться через свій сором ті,"
  },
  {
    "id": 1087,
    "book": "psalms                                  ",
    "chapter": "69",
    "verse": "5",
    "text": "Нехай же веселяться й радіють Тобою всі,"
  },
  {
    "id": 1088,
    "book": "psalms                                  ",
    "chapter": "69",
    "verse": "6",
    "text": "Я ж принижений та бідний."
  }
]
