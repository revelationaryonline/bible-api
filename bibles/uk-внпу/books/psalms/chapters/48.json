[
  {
    "id": 737,
    "book": "psalms                                  ",
    "chapter": "48",
    "verse": "1",
    "text": "Керівнику хору. Синів Кореєвих псалом."
  },
  {
    "id": 738,
    "book": "psalms                                  ",
    "chapter": "48",
    "verse": "2",
    "text": "Послухайте це, усі народи,"
  },
  {
    "id": 739,
    "book": "psalms                                  ",
    "chapter": "48",
    "verse": "3",
    "text": "сини Адамові, сини людські, –"
  },
  {
    "id": 740,
    "book": "psalms                                  ",
    "chapter": "48",
    "verse": "4",
    "text": "Вуста мої промовлять мудрість,"
  },
  {
    "id": 741,
    "book": "psalms                                  ",
    "chapter": "48",
    "verse": "5",
    "text": "Схилю своє вухо до притчі,"
  },
  {
    "id": 742,
    "book": "psalms                                  ",
    "chapter": "48",
    "verse": "6",
    "text": "Чого мені боятися в дні лиха,"
  },
  {
    "id": 743,
    "book": "psalms                                  ",
    "chapter": "48",
    "verse": "7",
    "text": "тих, хто на власні статки покладає надію"
  },
  {
    "id": 744,
    "book": "psalms                                  ",
    "chapter": "48",
    "verse": "8",
    "text": "Але ж брата ніхто не зможе викупити,"
  },
  {
    "id": 745,
    "book": "psalms                                  ",
    "chapter": "48",
    "verse": "9",
    "text": "Бо занадто дорогим був би викуп за його душу,"
  },
  {
    "id": 746,
    "book": "psalms                                  ",
    "chapter": "48",
    "verse": "10",
    "text": "щоб хтось жив вічно"
  },
  {
    "id": 747,
    "book": "psalms                                  ",
    "chapter": "48",
    "verse": "11",
    "text": "Адже кожен бачить, що мудрі помирають,"
  },
  {
    "id": 748,
    "book": "psalms                                  ",
    "chapter": "48",
    "verse": "12",
    "text": "Могили стали для них вічним домом,"
  },
  {
    "id": 749,
    "book": "psalms                                  ",
    "chapter": "48",
    "verse": "13",
    "text": "Але ж людина не завжди перебуватиме в пошані,"
  },
  {
    "id": 750,
    "book": "psalms                                  ",
    "chapter": "48",
    "verse": "14",
    "text": "Так, життєві дороги їхні – невігластво!"
  },
  {
    "id": 751,
    "book": "psalms                                  ",
    "chapter": "48",
    "verse": "15",
    "text": "Немов вівці, вони приготовані для царства смерті;"
  },
  {
    "id": 752,
    "book": "psalms                                  ",
    "chapter": "48",
    "verse": "16",
    "text": "Але Бог викупить душу мою з-під влади царства мертвих,"
  },
  {
    "id": 753,
    "book": "psalms                                  ",
    "chapter": "48",
    "verse": "17",
    "text": "Не переймайся, коли хтось багатіє,"
  },
  {
    "id": 754,
    "book": "psalms                                  ",
    "chapter": "48",
    "verse": "18",
    "text": "Адже в час смерті нічого не візьме він із собою,"
  },
  {
    "id": 755,
    "book": "psalms                                  ",
    "chapter": "48",
    "verse": "19",
    "text": "Навіть якщо за життя він вважав себе благословенним, –"
  },
  {
    "id": 756,
    "book": "psalms                                  ",
    "chapter": "48",
    "verse": "20",
    "text": "однак піде він до роду своїх предків,"
  },
  {
    "id": 757,
    "book": "psalms                                  ",
    "chapter": "48",
    "verse": "21",
    "text": "Людина в пошані, але нерозумна,"
  }
]
