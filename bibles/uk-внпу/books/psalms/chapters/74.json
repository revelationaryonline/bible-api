[
  {
    "id": 1184,
    "book": "psalms                                  ",
    "chapter": "74",
    "verse": "1",
    "text": "Керівнику хору. На мотив «Не згуби». Псалом Асафа. Пісня."
  },
  {
    "id": 1185,
    "book": "psalms                                  ",
    "chapter": "74",
    "verse": "2",
    "text": "Славимо Тебе, Боже, славимо,"
  },
  {
    "id": 1186,
    "book": "psalms                                  ",
    "chapter": "74",
    "verse": "3",
    "text": "Бо Ти сказав: «Я оберу певний час"
  },
  {
    "id": 1187,
    "book": "psalms                                  ",
    "chapter": "74",
    "verse": "4",
    "text": "Тане земля74:4 Танення або коливання землі вживаються часто як образ нехтування правосуддям людьми, Див. Пс. 10:4. й мешканці її –"
  },
  {
    "id": 1188,
    "book": "psalms                                  ",
    "chapter": "74",
    "verse": "5",
    "text": "Сказав Я зухвалим: «Не бундючтеся!» –"
  },
  {
    "id": 1189,
    "book": "psalms                                  ",
    "chapter": "74",
    "verse": "6",
    "text": "Не підносьте високо роги ваші,"
  },
  {
    "id": 1190,
    "book": "psalms                                  ",
    "chapter": "74",
    "verse": "7",
    "text": "Бо не зі сходу, не із заходу"
  },
  {
    "id": 1191,
    "book": "psalms                                  ",
    "chapter": "74",
    "verse": "8",
    "text": "Адже Бог – Суддя:"
  },
  {
    "id": 1192,
    "book": "psalms                                  ",
    "chapter": "74",
    "verse": "9",
    "text": "Бо чаша в руці Господа –"
  },
  {
    "id": 1193,
    "book": "psalms                                  ",
    "chapter": "74",
    "verse": "10",
    "text": "А я звіщатиму це повіки,"
  },
  {
    "id": 1194,
    "book": "psalms                                  ",
    "chapter": "74",
    "verse": "11",
    "text": "«Усі роги нечестивих повідрубую,"
  }
]
