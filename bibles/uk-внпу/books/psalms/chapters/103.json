[
  {
    "id": 1696,
    "book": "psalms                                  ",
    "chapter": "103",
    "verse": "1",
    "text": "Благослови, душе моя, Господа!"
  },
  {
    "id": 1697,
    "book": "psalms                                  ",
    "chapter": "103",
    "verse": "2",
    "text": "Він огортається світлом, немов шатами;"
  },
  {
    "id": 1698,
    "book": "psalms                                  ",
    "chapter": "103",
    "verse": "3",
    "text": "закладає на водах основи Своїх вишніх світлиць."
  },
  {
    "id": 1699,
    "book": "psalms                                  ",
    "chapter": "103",
    "verse": "4",
    "text": "Він робить Своїми посланцями вітри,"
  },
  {
    "id": 1700,
    "book": "psalms                                  ",
    "chapter": "103",
    "verse": "5",
    "text": "Він заклав землю на її основах,"
  },
  {
    "id": 1701,
    "book": "psalms                                  ",
    "chapter": "103",
    "verse": "6",
    "text": "Ти вкрив її безоднею, мов одягом,"
  },
  {
    "id": 1702,
    "book": "psalms                                  ",
    "chapter": "103",
    "verse": "7",
    "text": "та від грізного крику Твого побігли вони,"
  },
  {
    "id": 1703,
    "book": "psalms                                  ",
    "chapter": "103",
    "verse": "8",
    "text": "Піднялися були в гори вони"
  },
  {
    "id": 1704,
    "book": "psalms                                  ",
    "chapter": "103",
    "verse": "9",
    "text": "Ти поклав межу, яку вони не перейдуть,"
  },
  {
    "id": 1705,
    "book": "psalms                                  ",
    "chapter": "103",
    "verse": "10",
    "text": "Ти посилаєш води джерела в річища,"
  },
  {
    "id": 1706,
    "book": "psalms                                  ",
    "chapter": "103",
    "verse": "11",
    "text": "напувають усіх звірів польових;"
  },
  {
    "id": 1707,
    "book": "psalms                                  ",
    "chapter": "103",
    "verse": "12",
    "text": "При водах тих живуть птахи небесні,"
  },
  {
    "id": 1708,
    "book": "psalms                                  ",
    "chapter": "103",
    "verse": "13",
    "text": "Він напуває гори з вишніх світлиць Своїх."
  },
  {
    "id": 1709,
    "book": "psalms                                  ",
    "chapter": "103",
    "verse": "14",
    "text": "Ти вирощуєш траву для худоби"
  },
  {
    "id": 1710,
    "book": "psalms                                  ",
    "chapter": "103",
    "verse": "15",
    "text": "і вино, що серце людське веселить,"
  },
  {
    "id": 1711,
    "book": "psalms                                  ",
    "chapter": "103",
    "verse": "16",
    "text": "Насичуються дерева Господні,"
  },
  {
    "id": 1712,
    "book": "psalms                                  ",
    "chapter": "103",
    "verse": "17",
    "text": "Там птахи в’ють гнізда,"
  },
  {
    "id": 1713,
    "book": "psalms                                  ",
    "chapter": "103",
    "verse": "18",
    "text": "Високі гори диким козлам належать,"
  },
  {
    "id": 1714,
    "book": "psalms                                  ",
    "chapter": "103",
    "verse": "19",
    "text": "Він створив місяць, щоб час визначати;"
  },
  {
    "id": 1715,
    "book": "psalms                                  ",
    "chapter": "103",
    "verse": "20",
    "text": "Ти наводиш темряву, і настає ніч,"
  },
  {
    "id": 1716,
    "book": "psalms                                  ",
    "chapter": "103",
    "verse": "21",
    "text": "Молоді леви ричать за здобиччю,"
  },
  {
    "id": 1717,
    "book": "psalms                                  ",
    "chapter": "103",
    "verse": "22",
    "text": "Сходить сонце – вони збираються разом"
  },
  {
    "id": 1718,
    "book": "psalms                                  ",
    "chapter": "103",
    "verse": "23",
    "text": "Людина виходить на свою працю"
  },
  {
    "id": 1719,
    "book": "psalms                                  ",
    "chapter": "103",
    "verse": "24",
    "text": "Які численні діяння Твої, Господи!"
  },
  {
    "id": 1720,
    "book": "psalms                                  ",
    "chapter": "103",
    "verse": "25",
    "text": "Ось море велике й просторе,"
  },
  {
    "id": 1721,
    "book": "psalms                                  ",
    "chapter": "103",
    "verse": "26",
    "text": "Там ходять кораблі,"
  },
  {
    "id": 1722,
    "book": "psalms                                  ",
    "chapter": "103",
    "verse": "27",
    "text": "Усі вони очікують від Тебе,"
  },
  {
    "id": 1723,
    "book": "psalms                                  ",
    "chapter": "103",
    "verse": "28",
    "text": "Ти даєш їм – вони приймають,"
  },
  {
    "id": 1724,
    "book": "psalms                                  ",
    "chapter": "103",
    "verse": "29",
    "text": "Сховаєш обличчя Своє –"
  },
  {
    "id": 1725,
    "book": "psalms                                  ",
    "chapter": "103",
    "verse": "30",
    "text": "Пошлеш духа Свого –"
  },
  {
    "id": 1726,
    "book": "psalms                                  ",
    "chapter": "103",
    "verse": "31",
    "text": "Нехай буде слава Господня навіки,"
  },
  {
    "id": 1727,
    "book": "psalms                                  ",
    "chapter": "103",
    "verse": "32",
    "text": "Він погляне на землю, і вона затремтить;"
  },
  {
    "id": 1728,
    "book": "psalms                                  ",
    "chapter": "103",
    "verse": "33",
    "text": "Я співатиму Господеві усе життя моє;"
  },
  {
    "id": 1729,
    "book": "psalms                                  ",
    "chapter": "103",
    "verse": "34",
    "text": "Нехай буде приємним Йому мій роздум:"
  },
  {
    "id": 1730,
    "book": "psalms                                  ",
    "chapter": "103",
    "verse": "35",
    "text": "Нехай згинуть грішники із землі"
  }
]
