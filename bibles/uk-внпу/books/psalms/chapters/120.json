    "chapter": "120",
    "verse": "1",
    "text": "Пісня сходження."
  },
  {
    "id": 2208,
    "book": "psalms                                  ",
    "chapter": "120",
    "verse": "2",
    "text": "Допомога моя від Господа,"
  },
  {
    "id": 2209,
    "book": "psalms                                  ",
    "chapter": "120",
    "verse": "3",
    "text": "Він не дасть захитатися нозі твоїй,"
  },
  {
    "id": 2210,
    "book": "psalms                                  ",
    "chapter": "120",
    "verse": "4",
    "text": "Так, не задрімає й не засне"
  },
  {
    "id": 2211,
    "book": "psalms                                  ",
    "chapter": "120",
    "verse": "5",
    "text": "Господь – сторож твій;"
  },
  {
    "id": 2212,
    "book": "psalms                                  ",
    "chapter": "120",
    "verse": "6",
    "text": "Сонце не вразить тебе вдень,"
  },
  {
    "id": 2213,
    "book": "psalms                                  ",
    "chapter": "120",
    "verse": "7",
    "text": "Господь оберігатиме тебе від усякого зла;"
  },
  {
    "id": 2214,
    "book": "psalms                                  ",
    "chapter": "120",
    "verse": "8",
    "text": "Господь оберігатиме тебе,"
  }
