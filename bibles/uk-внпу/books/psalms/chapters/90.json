[
  {
    "id": 1518,
    "book": "psalms                                  ",
    "chapter": "90",
    "verse": "1",
    "text": "Той, хто живе під покровом Всевишнього,"
  },
  {
    "id": 1519,
    "book": "psalms                                  ",
    "chapter": "90",
    "verse": "2",
    "text": "Скажу Господеві: «Пристановище моє й твердиня моя –"
  },
  {
    "id": 1520,
    "book": "psalms                                  ",
    "chapter": "90",
    "verse": "3",
    "text": "Адже Він визволить тебе від тенет людолова й"
  },
  {
    "id": 1521,
    "book": "psalms                                  ",
    "chapter": "90",
    "verse": "4",
    "text": "Мов птах, вкриє тебе Своїм пір’ям,"
  },
  {
    "id": 1522,
    "book": "psalms                                  ",
    "chapter": "90",
    "verse": "5",
    "text": "Не будеш боятися жаху нічного,"
  },
  {
    "id": 1523,
    "book": "psalms                                  ",
    "chapter": "90",
    "verse": "6",
    "text": "ані моровиці, що в пітьмі ходить,"
  },
  {
    "id": 1524,
    "book": "psalms                                  ",
    "chapter": "90",
    "verse": "7",
    "text": "Впаде поруч із тобою тисяча ворогів,"
  },
  {
    "id": 1525,
    "book": "psalms                                  ",
    "chapter": "90",
    "verse": "8",
    "text": "Тільки очима своїми будеш дивитися"
  },
  {
    "id": 1526,
    "book": "psalms                                  ",
    "chapter": "90",
    "verse": "9",
    "text": "Оскільки ти Господа – притулок мій,"
  },
  {
    "id": 1527,
    "book": "psalms                                  ",
    "chapter": "90",
    "verse": "10",
    "text": "не спіткає тебе лихо"
  },
  {
    "id": 1528,
    "book": "psalms                                  ",
    "chapter": "90",
    "verse": "11",
    "text": "Бо Він ангелам Своїм про тебе накаже,"
  },
  {
    "id": 1529,
    "book": "psalms                                  ",
    "chapter": "90",
    "verse": "12",
    "text": "Вони понесуть тебе на своїх долонях,"
  },
  {
    "id": 1530,
    "book": "psalms                                  ",
    "chapter": "90",
    "verse": "13",
    "text": "На лева й на кобру наступиш,"
  },
  {
    "id": 1531,
    "book": "psalms                                  ",
    "chapter": "90",
    "verse": "14",
    "text": "«За те, що він полюбив Мене, врятую його,"
  },
  {
    "id": 1532,
    "book": "psalms                                  ",
    "chapter": "90",
    "verse": "15",
    "text": "Коли він покличе Мене, Я відповім йому,"
  },
  {
    "id": 1533,
    "book": "psalms                                  ",
    "chapter": "90",
    "verse": "16",
    "text": "Довголіттям насичу його"
  }
]
