[
  {
    "id": 2266,
    "book": "psalms                                  ",
    "chapter": "129",
    "verse": "1",
    "text": "Пісня сходження."
  },
  {
    "id": 2267,
    "book": "psalms                                  ",
    "chapter": "129",
    "verse": "2",
    "text": "Володарю, почуй же мій голос,"
  },
  {
    "id": 2268,
    "book": "psalms                                  ",
    "chapter": "129",
    "verse": "3",
    "text": "Якщо беззаконня Ти, Господи, пильнуватимеш,"
  },
  {
    "id": 2269,
    "book": "psalms                                  ",
    "chapter": "129",
    "verse": "4",
    "text": "Але в Тебе прощення,"
  },
  {
    "id": 2270,
    "book": "psalms                                  ",
    "chapter": "129",
    "verse": "5",
    "text": "Я покладаю надію на Господа, надію має душа моя,"
  },
  {
    "id": 2271,
    "book": "psalms                                  ",
    "chapter": "129",
    "verse": "6",
    "text": "Душа моя на Владику чекає"
  },
  {
    "id": 2272,
    "book": "psalms                                  ",
    "chapter": "129",
    "verse": "7",
    "text": "Нехай Ізраїль сподівається на Господа,"
  },
  {
    "id": 2273,
    "book": "psalms                                  ",
    "chapter": "129",
    "verse": "8",
    "text": "І Він визволить Ізраїля"
  }
]
