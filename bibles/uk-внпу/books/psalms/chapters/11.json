[
  {
    "id": 135,
    "book": "psalms                                  ",
    "chapter": "11",
    "verse": "1",
    "text": "Керівнику хору. У супроводі восьмиструнного інструмента. Псалом Давидів."
  },
  {
    "id": 136,
    "book": "psalms                                  ",
    "chapter": "11",
    "verse": "2",
    "text": "Врятуй, Господи, бо не стало справедливого,"
  },
  {
    "id": 137,
    "book": "psalms                                  ",
    "chapter": "11",
    "verse": "3",
    "text": "Марне говорять одне одному,"
  },
  {
    "id": 138,
    "book": "psalms                                  ",
    "chapter": "11",
    "verse": "4",
    "text": "Нехай розрубає Господь кожні слизькі вуста"
  },
  {
    "id": 139,
    "book": "psalms                                  ",
    "chapter": "11",
    "verse": "5",
    "text": "що говорять: «Нашим язиком здолаємо кого завгодно;"
  },
  {
    "id": 140,
    "book": "psalms                                  ",
    "chapter": "11",
    "verse": "6",
    "text": "«Через те, що грабують пригноблених,"
  },
  {
    "id": 141,
    "book": "psalms                                  ",
    "chapter": "11",
    "verse": "7",
    "text": "Слова Господні – слова чисті,"
  },
  {
    "id": 142,
    "book": "psalms                                  ",
    "chapter": "11",
    "verse": "8",
    "text": "Ти, Господи, берегтимеш нужденних,"
  },
  {
    "id": 143,
    "book": "psalms                                  ",
    "chapter": "11",
    "verse": "9",
    "text": "поки навколо тиняються нечестиві"
  }
]
