[
  {
    "id": 348,
    "book": "psalms                                  ",
    "chapter": "25",
    "verse": "1",
    "text": "Псалом Давидів."
  },
  {
    "id": 349,
    "book": "psalms                                  ",
    "chapter": "25",
    "verse": "2",
    "text": "Випробуй мене, Господи, оціни мене,"
  },
  {
    "id": 350,
    "book": "psalms                                  ",
    "chapter": "25",
    "verse": "3",
    "text": "Бо милість Твоя перед моїми очима,"
  },
  {
    "id": 351,
    "book": "psalms                                  ",
    "chapter": "25",
    "verse": "4",
    "text": "Я не сиджу з нікчемними людьми"
  },
  {
    "id": 352,
    "book": "psalms                                  ",
    "chapter": "25",
    "verse": "5",
    "text": "Я ненавиджу зборище злодіїв"
  },
  {
    "id": 353,
    "book": "psalms                                  ",
    "chapter": "25",
    "verse": "6",
    "text": "Омиватиму свої руки в невинності"
  },
  {
    "id": 354,
    "book": "psalms                                  ",
    "chapter": "25",
    "verse": "7",
    "text": "голосно звіщаючи подяку"
  },
  {
    "id": 355,
    "book": "psalms                                  ",
    "chapter": "25",
    "verse": "8",
    "text": "Господи, я полюбив оселю Твого дому,"
  },
  {
    "id": 356,
    "book": "psalms                                  ",
    "chapter": "25",
    "verse": "9",
    "text": "Не дай душі моїй загинути з грішниками"
  },
  {
    "id": 357,
    "book": "psalms                                  ",
    "chapter": "25",
    "verse": "10",
    "text": "у чиїх руках злий задум"
  },
  {
    "id": 358,
    "book": "psalms                                  ",
    "chapter": "25",
    "verse": "11",
    "text": "А я бездоганно ходжу життєвим шляхом."
  },
  {
    "id": 359,
    "book": "psalms                                  ",
    "chapter": "25",
    "verse": "12",
    "text": "Нога моя стоїть на рівній землі;"
  }
]
