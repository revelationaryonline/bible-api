    "verse": "1",
    "text": "Алілуя!"
  },
  {
    "id": 2522,
    "book": "psalms                                  ",
    "chapter": "150",
    "verse": "2",
    "text": "Хваліть Його за могутні діяння Його,"
  },
  {
    "id": 2523,
    "book": "psalms                                  ",
    "chapter": "150",
    "verse": "3",
    "text": "Хваліть Його зі звуком сурми,150:3 Буквально: зі звуком шофару; що таке шофар, див. пояснення до Пс. 46:6."
  },
  {
    "id": 2524,
    "book": "psalms                                  ",
    "chapter": "150",
    "verse": "4",
    "text": "Хваліть Його з бубном і хороводом,"
  },
  {
    "id": 2525,
    "book": "psalms                                  ",
    "chapter": "150",
    "verse": "5",
    "text": "Хваліть Його на звучних цимбалах,"
