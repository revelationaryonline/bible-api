[
  {
    "id": 853,
    "book": "psalms                                  ",
    "chapter": "55",
    "verse": "1",
    "text": "Керівнику хору. На мотив «Голубка в далекій діброві». Міхтам55:1 Див. Пс. 15:1. Давидів, коли филистимляни схопили його в Ґаті.55:1 Див. 1 Сам. 21:10-15; 27:1-4."
  },
  {
    "id": 854,
    "book": "psalms                                  ",
    "chapter": "55",
    "verse": "2",
    "text": "Помилуй мене, Боже,"
  },
  {
    "id": 855,
    "book": "psalms                                  ",
    "chapter": "55",
    "verse": "3",
    "text": "Цькують мене супротивники цілий день:"
  },
  {
    "id": 856,
    "book": "psalms                                  ",
    "chapter": "55",
    "verse": "4",
    "text": "У день страху"
  },
  {
    "id": 857,
    "book": "psalms                                  ",
    "chapter": "55",
    "verse": "5",
    "text": "Я сподіваюся на Бога,"
  },
  {
    "id": 858,
    "book": "psalms                                  ",
    "chapter": "55",
    "verse": "6",
    "text": "Цілий день мої слова перекручують,"
  },
  {
    "id": 859,
    "book": "psalms                                  ",
    "chapter": "55",
    "verse": "7",
    "text": "Вони сперечаються, спостерігають,"
  },
  {
    "id": 860,
    "book": "psalms                                  ",
    "chapter": "55",
    "verse": "8",
    "text": "Не дай же їм уникнути кари за беззаконня;"
  },
  {
    "id": 861,
    "book": "psalms                                  ",
    "chapter": "55",
    "verse": "9",
    "text": "О, якби полічив Ти мої поневіряння!"
  },
  {
    "id": 862,
    "book": "psalms                                  ",
    "chapter": "55",
    "verse": "10",
    "text": "Тоді вороги мої обернуться назад,"
  },
  {
    "id": 863,
    "book": "psalms                                  ",
    "chapter": "55",
    "verse": "11",
    "text": "На Бога, Чиє слово я прославляю,"
  },
  {
    "id": 864,
    "book": "psalms                                  ",
    "chapter": "55",
    "verse": "12",
    "text": "на Бога покладаюсь я,"
  },
  {
    "id": 865,
    "book": "psalms                                  ",
    "chapter": "55",
    "verse": "13",
    "text": "На мені, Боже, обітниці, що дав я Тобі, –"
  },
  {
    "id": 866,
    "book": "psalms                                  ",
    "chapter": "55",
    "verse": "14",
    "text": "Бо Ти визволив мою душу від смерті,"
  }
]
