[
  {
    "id": 2348,
    "book": "psalms                                  ",
    "chapter": "136",
    "verse": "1",
    "text": "Біля річок Вавилона, там сиділи ми й плакали,"
  },
  {
    "id": 2349,
    "book": "psalms                                  ",
    "chapter": "136",
    "verse": "2",
    "text": "На вербах посеред міста"
  },
  {
    "id": 2350,
    "book": "psalms                                  ",
    "chapter": "136",
    "verse": "3",
    "text": "бо там поневолювачі наші просили від нас слів пісні"
  },
  {
    "id": 2351,
    "book": "psalms                                  ",
    "chapter": "136",
    "verse": "4",
    "text": "Як можемо ми пісню Господню"
  },
  {
    "id": 2352,
    "book": "psalms                                  ",
    "chapter": "136",
    "verse": "5",
    "text": "Якщо я забуду тебе, Єрусалиме,"
  },
  {
    "id": 2353,
    "book": "psalms                                  ",
    "chapter": "136",
    "verse": "6",
    "text": "Нехай прилипне язик мій до піднебіння,"
  },
  {
    "id": 2354,
    "book": "psalms                                  ",
    "chapter": "136",
    "verse": "7",
    "text": "Нагадай, Господи, синам Едомовим"
  },
  {
    "id": 2355,
    "book": "psalms                                  ",
    "chapter": "136",
    "verse": "8",
    "text": "Донько Вавилона, приречена на спустошення,"
  },
  {
    "id": 2356,
    "book": "psalms                                  ",
    "chapter": "136",
    "verse": "9",
    "text": "Блаженний той, хто схопить"
  }
]
