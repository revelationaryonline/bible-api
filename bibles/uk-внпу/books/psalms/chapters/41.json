[
  {
    "id": 638,
    "book": "psalms                                  ",
    "chapter": "41",
    "verse": "1",
    "text": "Керівнику хору. Повчання синів Кореєвих."
  },
  {
    "id": 639,
    "book": "psalms                                  ",
    "chapter": "41",
    "verse": "2",
    "text": "Як олень лине до потоків води,"
  },
  {
    "id": 640,
    "book": "psalms                                  ",
    "chapter": "41",
    "verse": "3",
    "text": "Душа моя спрагла Бога, живого Бога."
  },
  {
    "id": 641,
    "book": "psalms                                  ",
    "chapter": "41",
    "verse": "4",
    "text": "Сльози мої були для мене хлібом вдень і вночі,"
  },
  {
    "id": 642,
    "book": "psalms                                  ",
    "chapter": "41",
    "verse": "5",
    "text": "Ось про що я згадую, і виливається від туги душа моя:"
  },
  {
    "id": 643,
    "book": "psalms                                  ",
    "chapter": "41",
    "verse": "6",
    "text": "Чому ти сумуєш, душе моя,"
  },
  {
    "id": 644,
    "book": "psalms                                  ",
    "chapter": "41",
    "verse": "7",
    "text": "Боже мій, за Тобою сумує душа моя,"
  },
  {
    "id": 645,
    "book": "psalms                                  ",
    "chapter": "41",
    "verse": "8",
    "text": "Безодня до безодні кличе"
  },
  {
    "id": 646,
    "book": "psalms                                  ",
    "chapter": "41",
    "verse": "9",
    "text": "Удень заповість Господь Своїй милості прийти до мене,"
  },
  {
    "id": 647,
    "book": "psalms                                  ",
    "chapter": "41",
    "verse": "10",
    "text": "Скажу-но я Богові, скелі моїй:"
  },
  {
    "id": 648,
    "book": "psalms                                  ",
    "chapter": "41",
    "verse": "11",
    "text": "У кістках моїх – виснаження;"
  },
  {
    "id": 649,
    "book": "psalms                                  ",
    "chapter": "41",
    "verse": "12",
    "text": "Чому ти сумуєш, душе моя,"
  }
]
