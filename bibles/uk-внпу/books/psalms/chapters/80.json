[
  {
    "id": 1334,
    "book": "psalms                                  ",
    "chapter": "80",
    "verse": "1",
    "text": "Керівнику хору. У стилі ґіттіт.80:1 Пояснення цього терміну Див. Пс. 8:1. Псалом Асафів."
  },
  {
    "id": 1335,
    "book": "psalms                                  ",
    "chapter": "80",
    "verse": "2",
    "text": "Радісно співайте Богові, твердині нашій,"
  },
  {
    "id": 1336,
    "book": "psalms                                  ",
    "chapter": "80",
    "verse": "3",
    "text": "Заспівайте пісню, вдарте у бубон,"
  },
  {
    "id": 1337,
    "book": "psalms                                  ",
    "chapter": "80",
    "verse": "4",
    "text": "Сурміть у ріг80:4 Буквально: шофар – ритуальний духовий музичний інструмент із баранячого рогу. Див. пояснення до Пс. 46:6. на свято нового місяця"
  },
  {
    "id": 1338,
    "book": "psalms                                  ",
    "chapter": "80",
    "verse": "5",
    "text": "Бо це постанова для Ізраїля,"
  },
  {
    "id": 1339,
    "book": "psalms                                  ",
    "chapter": "80",
    "verse": "6",
    "text": "Він встановив це як одкровення для Йосифа,"
  },
  {
    "id": 1340,
    "book": "psalms                                  ",
    "chapter": "80",
    "verse": "7",
    "text": "«Я зняв ярмо з його плеч,"
  },
  {
    "id": 1341,
    "book": "psalms                                  ",
    "chapter": "80",
    "verse": "8",
    "text": "У скорботі ти покликав Мене, і Я визволив тебе;"
  },
  {
    "id": 1342,
    "book": "psalms                                  ",
    "chapter": "80",
    "verse": "9",
    "text": "Слухай, народе Мій, Я буду свідчити тобі."
  },
  {
    "id": 1343,
    "book": "psalms                                  ",
    "chapter": "80",
    "verse": "10",
    "text": "Нехай не буде в тебе чужого бога,"
  },
  {
    "id": 1344,
    "book": "psalms                                  ",
    "chapter": "80",
    "verse": "11",
    "text": "Я – Господь, Бог твій,"
  },
  {
    "id": 1345,
    "book": "psalms                                  ",
    "chapter": "80",
    "verse": "12",
    "text": "Але народ Мій не слухався Мого голосу,"
  },
  {
    "id": 1346,
    "book": "psalms                                  ",
    "chapter": "80",
    "verse": "13",
    "text": "Тому полишив Я їх владі впертості власних сердець –"
  },
  {
    "id": 1347,
    "book": "psalms                                  ",
    "chapter": "80",
    "verse": "14",
    "text": "О, якби народ Мій слухався Мене,"
  },
  {
    "id": 1348,
    "book": "psalms                                  ",
    "chapter": "80",
    "verse": "15",
    "text": "Ще трохи, і Я підкорив би ворогів їхніх"
  },
  {
    "id": 1349,
    "book": "psalms                                  ",
    "chapter": "80",
    "verse": "16",
    "text": "Ті, хто Господа ненавидить, плазували б перед Ним,"
  },
  {
    "id": 1350,
    "book": "psalms                                  ",
    "chapter": "80",
    "verse": "17",
    "text": "Я годував би Ізраїля найкращою пшеницею"
  }
]
