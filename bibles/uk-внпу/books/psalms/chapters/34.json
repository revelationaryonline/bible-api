[
  {
    "id": 488,
    "book": "psalms                                  ",
    "chapter": "34",
    "verse": "1",
    "text": "Псалом Давидів."
  },
  {
    "id": 489,
    "book": "psalms                                  ",
    "chapter": "34",
    "verse": "2",
    "text": "Візьми щит і обладунки34:2 Буквально: візьми малого щита й великого щита."
  },
  {
    "id": 490,
    "book": "psalms                                  ",
    "chapter": "34",
    "verse": "3",
    "text": "Махни списом"
  },
  {
    "id": 491,
    "book": "psalms                                  ",
    "chapter": "34",
    "verse": "4",
    "text": "Нехай посоромлені й принижені будуть ті,"
  },
  {
    "id": 492,
    "book": "psalms                                  ",
    "chapter": "34",
    "verse": "5",
    "text": "Нехай будуть вони як полова перед вітром,"
  },
  {
    "id": 493,
    "book": "psalms                                  ",
    "chapter": "34",
    "verse": "6",
    "text": "Нехай шлях їхній буде темний і слизький,"
  },
  {
    "id": 494,
    "book": "psalms                                  ",
    "chapter": "34",
    "verse": "7",
    "text": "За те, що приховали для мене тенета без причини"
  },
  {
    "id": 495,
    "book": "psalms                                  ",
    "chapter": "34",
    "verse": "8",
    "text": "Нехай погибель прийде на нього несподівано,"
  },
  {
    "id": 496,
    "book": "psalms                                  ",
    "chapter": "34",
    "verse": "9",
    "text": "А моя душа веселитись буде в Господі,"
  },
  {
    "id": 497,
    "book": "psalms                                  ",
    "chapter": "34",
    "verse": "10",
    "text": "Усі кістки мої нехай скажуть:"
  },
  {
    "id": 498,
    "book": "psalms                                  ",
    "chapter": "34",
    "verse": "11",
    "text": "Повстали проти мене жорстокі свідки,"
  },
  {
    "id": 499,
    "book": "psalms                                  ",
    "chapter": "34",
    "verse": "12",
    "text": "Віддячують мені злом за добро,"
  },
  {
    "id": 500,
    "book": "psalms                                  ",
    "chapter": "34",
    "verse": "13",
    "text": "Та коли вони хворіли, я вдягався в лахміття,"
  },
  {
    "id": 501,
    "book": "psalms                                  ",
    "chapter": "34",
    "verse": "14",
    "text": "Я ходив,"
  },
  {
    "id": 502,
    "book": "psalms                                  ",
    "chapter": "34",
    "verse": "15",
    "text": "А коли я спіткнувся,"
  },
  {
    "id": 503,
    "book": "psalms                                  ",
    "chapter": "34",
    "verse": "16",
    "text": "Безбожними глузуваннями насміхалися,"
  },
  {
    "id": 504,
    "book": "psalms                                  ",
    "chapter": "34",
    "verse": "17",
    "text": "Володарю, доки Ти дивитимешся на це?"
  },
  {
    "id": 505,
    "book": "psalms                                  ",
    "chapter": "34",
    "verse": "18",
    "text": "Я прославлю Тебе в зібранні великому,"
  },
  {
    "id": 506,
    "book": "psalms                                  ",
    "chapter": "34",
    "verse": "19",
    "text": "Нехай же не зловтішаються наді мною вороги мої неправедно,"
  },
  {
    "id": 507,
    "book": "psalms                                  ",
    "chapter": "34",
    "verse": "20",
    "text": "Бо не про мир вони говорять,"
  },
  {
    "id": 508,
    "book": "psalms                                  ",
    "chapter": "34",
    "verse": "21",
    "text": "Роззявляють на мене свої пащі, кажучи:"
  },
  {
    "id": 509,
    "book": "psalms                                  ",
    "chapter": "34",
    "verse": "22",
    "text": "Але ж і Ти, Господи, побачив це, не мовчи!"
  },
  {
    "id": 510,
    "book": "psalms                                  ",
    "chapter": "34",
    "verse": "23",
    "text": "Пробудися і встань на мій суд,"
  },
  {
    "id": 511,
    "book": "psalms                                  ",
    "chapter": "34",
    "verse": "24",
    "text": "Суди мене за правдою Твоєю, Господи, Боже мій;"
  },
  {
    "id": 512,
    "book": "psalms                                  ",
    "chapter": "34",
    "verse": "25",
    "text": "Нехай не говорять вони в серцях своїх: «Ага, сталося, як ми хотіли!»34:25 Буквально: Ага, задоволена душа наша!"
  },
  {
    "id": 513,
    "book": "psalms                                  ",
    "chapter": "34",
    "verse": "26",
    "text": "Нехай посоромляться й ганьбою вкриються всі,"
  },
  {
    "id": 514,
    "book": "psalms                                  ",
    "chapter": "34",
    "verse": "27",
    "text": "Нехай же веселяться й радіють ті,"
  },
  {
    "id": 515,
    "book": "psalms                                  ",
    "chapter": "34",
    "verse": "28",
    "text": "Тоді язик мій проголошуватиме Твою правду,"
  }
]
