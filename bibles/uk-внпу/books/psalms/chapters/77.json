[
  {
    "id": 1229,
    "book": "psalms                                  ",
    "chapter": "77",
    "verse": "1",
    "text": "Повчання Асафові."
  },
  {
    "id": 1230,
    "book": "psalms                                  ",
    "chapter": "77",
    "verse": "2",
    "text": "Відкрию в притчі вуста мої,"
  },
  {
    "id": 1231,
    "book": "psalms                                  ",
    "chapter": "77",
    "verse": "3",
    "text": "які ми чули й пізнали"
  },
  {
    "id": 1232,
    "book": "psalms                                  ",
    "chapter": "77",
    "verse": "4",
    "text": "Не будемо приховувати їх від синів наших,"
  },
  {
    "id": 1233,
    "book": "psalms                                  ",
    "chapter": "77",
    "verse": "5",
    "text": "Він засвідчив одкровення Своє Якову"
  },
  {
    "id": 1234,
    "book": "psalms                                  ",
    "chapter": "77",
    "verse": "6",
    "text": "щоб знало наступне покоління,"
  },
  {
    "id": 1235,
    "book": "psalms                                  ",
    "chapter": "77",
    "verse": "7",
    "text": "Тоді вони сподівання своє покладуть на Бога,"
  },
  {
    "id": 1236,
    "book": "psalms                                  ",
    "chapter": "77",
    "verse": "8",
    "text": "Вони не будуть подібні до своїх предків,"
  },
  {
    "id": 1237,
    "book": "psalms                                  ",
    "chapter": "77",
    "verse": "9",
    "text": "Сини Єфремові, хоча й озброєні стрільці з лука,"
  },
  {
    "id": 1238,
    "book": "psalms                                  ",
    "chapter": "77",
    "verse": "10",
    "text": "Не дотримувалися вони Завіту Божого"
  },
  {
    "id": 1239,
    "book": "psalms                                  ",
    "chapter": "77",
    "verse": "11",
    "text": "Вони забули про Його звершення й чудеса,"
  },
  {
    "id": 1240,
    "book": "psalms                                  ",
    "chapter": "77",
    "verse": "12",
    "text": "Перед предками їхніми здійснив Він чудо"
  },
  {
    "id": 1241,
    "book": "psalms                                  ",
    "chapter": "77",
    "verse": "13",
    "text": "Він розділив навпіл море й провів їх через нього,"
  },
  {
    "id": 1242,
    "book": "psalms                                  ",
    "chapter": "77",
    "verse": "14",
    "text": "Вів їх хмарою вдень,"
  },
  {
    "id": 1243,
    "book": "psalms                                  ",
    "chapter": "77",
    "verse": "15",
    "text": "Він розсікав скелі в пустелі"
  },
  {
    "id": 1244,
    "book": "psalms                                  ",
    "chapter": "77",
    "verse": "16",
    "text": "Із скелі вивів потоки,"
  },
  {
    "id": 1245,
    "book": "psalms                                  ",
    "chapter": "77",
    "verse": "17",
    "text": "Але вони продовжували грішити проти Нього,"
  },
  {
    "id": 1246,
    "book": "psalms                                  ",
    "chapter": "77",
    "verse": "18",
    "text": "Випробовували Бога в серцях своїх,"
  },
  {
    "id": 1247,
    "book": "psalms                                  ",
    "chapter": "77",
    "verse": "19",
    "text": "Вони говорили зухвало проти Бога, кажучи:"
  },
  {
    "id": 1248,
    "book": "psalms                                  ",
    "chapter": "77",
    "verse": "20",
    "text": "Ось Він вдарив скелю, і потекли води,"
  },
  {
    "id": 1249,
    "book": "psalms                                  ",
    "chapter": "77",
    "verse": "21",
    "text": "Тому, коли почув це Господь, то розгнівався:"
  },
  {
    "id": 1250,
    "book": "psalms                                  ",
    "chapter": "77",
    "verse": "22",
    "text": "бо не повірили вони Богові"
  },
  {
    "id": 1251,
    "book": "psalms                                  ",
    "chapter": "77",
    "verse": "23",
    "text": "Тож наказав Він хмарам вгорі,"
  },
  {
    "id": 1252,
    "book": "psalms                                  ",
    "chapter": "77",
    "verse": "24",
    "text": "і дощем пролив на них манну, щоб їли,"
  },
  {
    "id": 1253,
    "book": "psalms                                  ",
    "chapter": "77",
    "verse": "25",
    "text": "Хліб могутніх77:25 У грецькому перекладі хліб ангелів. їла людина,"
  },
  {
    "id": 1254,
    "book": "psalms                                  ",
    "chapter": "77",
    "verse": "26",
    "text": "Він здійняв східний вітер у небесах"
  },
  {
    "id": 1255,
    "book": "psalms                                  ",
    "chapter": "77",
    "verse": "27",
    "text": "Дощем пролив Він на них м’ясо, немов пил,"
  },
  {
    "id": 1256,
    "book": "psalms                                  ",
    "chapter": "77",
    "verse": "28",
    "text": "яких розкидав Він серед табору,"
  },
  {
    "id": 1257,
    "book": "psalms                                  ",
    "chapter": "77",
    "verse": "29",
    "text": "Вони їли й добре наситилися –"
  },
  {
    "id": 1258,
    "book": "psalms                                  ",
    "chapter": "77",
    "verse": "30",
    "text": "Та ще не встигли вони вгамувати своєї примхи,"
  },
  {
    "id": 1259,
    "book": "psalms                                  ",
    "chapter": "77",
    "verse": "31",
    "text": "як гнів Божий піднявся проти них,"
  },
  {
    "id": 1260,
    "book": "psalms                                  ",
    "chapter": "77",
    "verse": "32",
    "text": "Та попри все це вони далі грішили"
  },
  {
    "id": 1261,
    "book": "psalms                                  ",
    "chapter": "77",
    "verse": "33",
    "text": "Тому Він загубив дні їхні в марноті"
  },
  {
    "id": 1262,
    "book": "psalms                                  ",
    "chapter": "77",
    "verse": "34",
    "text": "Коли Він вбивав їх, тоді вони шукали Його,"
  },
  {
    "id": 1263,
    "book": "psalms                                  ",
    "chapter": "77",
    "verse": "35",
    "text": "І згадували, що Бог – їхня скеля"
  },
  {
    "id": 1264,
    "book": "psalms                                  ",
    "chapter": "77",
    "verse": "36",
    "text": "Тоді промовляли Йому лестощі устами своїми"
  },
  {
    "id": 1265,
    "book": "psalms                                  ",
    "chapter": "77",
    "verse": "37",
    "text": "та серцями своїми не були вони з Ним щирі"
  },
  {
    "id": 1266,
    "book": "psalms                                  ",
    "chapter": "77",
    "verse": "38",
    "text": "Та Він, милостивий,"
  },
  {
    "id": 1267,
    "book": "psalms                                  ",
    "chapter": "77",
    "verse": "39",
    "text": "Він пам’ятав, що вони – тіло,"
  },
  {
    "id": 1268,
    "book": "psalms                                  ",
    "chapter": "77",
    "verse": "40",
    "text": "Скільки разів вони бунтували проти Нього в пустелі,"
  },
  {
    "id": 1269,
    "book": "psalms                                  ",
    "chapter": "77",
    "verse": "41",
    "text": "Знову й знову випробовували Бога"
  },
  {
    "id": 1270,
    "book": "psalms                                  ",
    "chapter": "77",
    "verse": "42",
    "text": "Не пам’ятали ні діянь руки Його,"
  },
  {
    "id": 1271,
    "book": "psalms                                  ",
    "chapter": "77",
    "verse": "43",
    "text": "коли ознаки Свої показав у Єгипті"
  },
  {
    "id": 1272,
    "book": "psalms                                  ",
    "chapter": "77",
    "verse": "44",
    "text": "Він перетворив їхні ріки на кров,"
  },
  {
    "id": 1273,
    "book": "psalms                                  ",
    "chapter": "77",
    "verse": "45",
    "text": "Він послав на них рої комах,"
  },
  {
    "id": 1274,
    "book": "psalms                                  ",
    "chapter": "77",
    "verse": "46",
    "text": "Він віддав врожай їхній гусені"
  },
  {
    "id": 1275,
    "book": "psalms                                  ",
    "chapter": "77",
    "verse": "47",
    "text": "Побив виноградники їхні градом"
  },
  {
    "id": 1276,
    "book": "psalms                                  ",
    "chapter": "77",
    "verse": "48",
    "text": "Він віддав на поталу градові їхню худобу"
  },
  {
    "id": 1277,
    "book": "psalms                                  ",
    "chapter": "77",
    "verse": "49",
    "text": "Він послав на них полум’я Свого гніву,"
  },
  {
    "id": 1278,
    "book": "psalms                                  ",
    "chapter": "77",
    "verse": "50",
    "text": "Вирівняв стежку для гніву Свого;"
  },
  {
    "id": 1279,
    "book": "psalms                                  ",
    "chapter": "77",
    "verse": "51",
    "text": "І вразив усіх первістків у Єгипті –"
  },
  {
    "id": 1280,
    "book": "psalms                                  ",
    "chapter": "77",
    "verse": "52",
    "text": "Немов овець отару, Він вивів народ Свій,"
  },
  {
    "id": 1281,
    "book": "psalms                                  ",
    "chapter": "77",
    "verse": "53",
    "text": "Вів їх у безпеці, так що вони не боялися,"
  },
  {
    "id": 1282,
    "book": "psalms                                  ",
    "chapter": "77",
    "verse": "54",
    "text": "І привів їх до границь святині Своєї,"
  },
  {
    "id": 1283,
    "book": "psalms                                  ",
    "chapter": "77",
    "verse": "55",
    "text": "Прогнав перед ними народи,"
  },
  {
    "id": 1284,
    "book": "psalms                                  ",
    "chapter": "77",
    "verse": "56",
    "text": "Але вони випробовували Бога Всевишнього,"
  },
  {
    "id": 1285,
    "book": "psalms                                  ",
    "chapter": "77",
    "verse": "57",
    "text": "І відступали, і зраджували, як і батьки їхні;"
  },
  {
    "id": 1286,
    "book": "psalms                                  ",
    "chapter": "77",
    "verse": "58",
    "text": "Гнівили Його в капищах на своїх пагорбах"
  },
  {
    "id": 1287,
    "book": "psalms                                  ",
    "chapter": "77",
    "verse": "59",
    "text": "Почув Бог, і запалав гнівом,"
  },
  {
    "id": 1288,
    "book": "psalms                                  ",
    "chapter": "77",
    "verse": "60",
    "text": "Покинув Оселю Свою в Шило –"
  },
  {
    "id": 1289,
    "book": "psalms                                  ",
    "chapter": "77",
    "verse": "61",
    "text": "І віддав Він могутність Свою у полон"
  },
  {
    "id": 1290,
    "book": "psalms                                  ",
    "chapter": "77",
    "verse": "62",
    "text": "Віддав Він народ Свій мечу на поталу"
  },
  {
    "id": 1291,
    "book": "psalms                                  ",
    "chapter": "77",
    "verse": "63",
    "text": "Юнаків їхніх пожер вогонь,"
  },
  {
    "id": 1292,
    "book": "psalms                                  ",
    "chapter": "77",
    "verse": "64",
    "text": "Священники його попадали від меча,"
  },
  {
    "id": 1293,
    "book": "psalms                                  ",
    "chapter": "77",
    "verse": "65",
    "text": "Тоді прокинувся Володар, немов від сну,"
  },
  {
    "id": 1294,
    "book": "psalms                                  ",
    "chapter": "77",
    "verse": "66",
    "text": "І вразив ворогів його ззаду,"
  },
  {
    "id": 1295,
    "book": "psalms                                  ",
    "chapter": "77",
    "verse": "67",
    "text": "Тоді відцурався Він шатра Йосифового"
  },
  {
    "id": 1296,
    "book": "psalms                                  ",
    "chapter": "77",
    "verse": "68",
    "text": "Але вибрав Він плем’я Юди,"
  },
  {
    "id": 1297,
    "book": "psalms                                  ",
    "chapter": "77",
    "verse": "69",
    "text": "Він збудував, немов висоти небес, святилище Своє,"
  },
  {
    "id": 1298,
    "book": "psalms                                  ",
    "chapter": "77",
    "verse": "70",
    "text": "І обрав Свого слугу Давида,"
  },
  {
    "id": 1299,
    "book": "psalms                                  ",
    "chapter": "77",
    "verse": "71",
    "text": "привів його від овечок дійних,"
  },
  {
    "id": 1300,
    "book": "psalms                                  ",
    "chapter": "77",
    "verse": "72",
    "text": "І він пас їх у невинності свого серця"
  }
]
