[
  {
    "id": 2447,
    "book": "psalms                                  ",
    "chapter": "144",
    "verse": "1",
    "text": "Хвала Давидова."
  },
  {
    "id": 2448,
    "book": "psalms                                  ",
    "chapter": "144",
    "verse": "2",
    "text": "Щодня благословлятиму Тебе"
  },
  {
    "id": 2449,
    "book": "psalms                                  ",
    "chapter": "144",
    "verse": "3",
    "text": "Великий Господь і вельми прославлений,"
  },
  {
    "id": 2450,
    "book": "psalms                                  ",
    "chapter": "144",
    "verse": "4",
    "text": "Покоління поколінню хвалитиме діяння Твої"
  },
  {
    "id": 2451,
    "book": "psalms                                  ",
    "chapter": "144",
    "verse": "5",
    "text": "Про дивну славу величі Твоєї"
  },
  {
    "id": 2452,
    "book": "psalms                                  ",
    "chapter": "144",
    "verse": "6",
    "text": "Коли говоритимуть про силу грізних діянь Твоїх,"
  },
  {
    "id": 2453,
    "book": "psalms                                  ",
    "chapter": "144",
    "verse": "7",
    "text": "На згадку про велику доброту Твою будуть промовляти"
  },
  {
    "id": 2454,
    "book": "psalms                                  ",
    "chapter": "144",
    "verse": "8",
    "text": "Милостивий і милосердний Господь,"
  },
  {
    "id": 2455,
    "book": "psalms                                  ",
    "chapter": "144",
    "verse": "9",
    "text": "Добрий Господь до всіх,"
  },
  {
    "id": 2456,
    "book": "psalms                                  ",
    "chapter": "144",
    "verse": "10",
    "text": "Прославлять Тебе, Господи, усі творіння Твої,"
  },
  {
    "id": 2457,
    "book": "psalms                                  ",
    "chapter": "144",
    "verse": "11",
    "text": "Про славу Царства Твого розповідатимуть"
  },
  {
    "id": 2458,
    "book": "psalms                                  ",
    "chapter": "144",
    "verse": "12",
    "text": "щоб звістити синам людським"
  },
  {
    "id": 2459,
    "book": "psalms                                  ",
    "chapter": "144",
    "verse": "13",
    "text": "Царство Твоє – царство на всі віки,"
  },
  {
    "id": 2460,
    "book": "psalms                                  ",
    "chapter": "144",
    "verse": "14",
    "text": "Господь підтримує усіх, хто падає,"
  },
  {
    "id": 2461,
    "book": "psalms                                  ",
    "chapter": "144",
    "verse": "15",
    "text": "Очі всіх на Тебе звернені з надією,"
  },
  {
    "id": 2462,
    "book": "psalms                                  ",
    "chapter": "144",
    "verse": "16",
    "text": "Відкриваєш руку Свою"
  },
  {
    "id": 2463,
    "book": "psalms                                  ",
    "chapter": "144",
    "verse": "17",
    "text": "Праведний Господь в усіх Своїх дорогах"
  },
  {
    "id": 2464,
    "book": "psalms                                  ",
    "chapter": "144",
    "verse": "18",
    "text": "Близький Господь до всіх, хто кличе Його,"
  },
  {
    "id": 2465,
    "book": "psalms                                  ",
    "chapter": "144",
    "verse": "19",
    "text": "Бажання тих, хто боїться Його, Він здійснює,"
  },
  {
    "id": 2466,
    "book": "psalms                                  ",
    "chapter": "144",
    "verse": "20",
    "text": "Оберігає Господь усіх, хто любить Його,"
  },
  {
    "id": 2467,
    "book": "psalms                                  ",
    "chapter": "144",
    "verse": "21",
    "text": "Хвалу Господеві проголосять уста мої,"
  }
]
