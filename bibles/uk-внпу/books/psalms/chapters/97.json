    "verse": "1",
    "text": "Псалом."
  },
  {
    "id": 1615,
    "book": "psalms                                  ",
    "chapter": "97",
    "verse": "2",
    "text": "Звістив Господь спасіння Своє,"
  },
  {
    "id": 1616,
    "book": "psalms                                  ",
    "chapter": "97",
    "verse": "3",
    "text": "Згадав Він милість Свою"
  },
  {
    "id": 1617,
    "book": "psalms                                  ",
    "chapter": "97",
    "verse": "4",
    "text": "Вигукни радісно Господеві, уся земле!"
  },
  {
    "id": 1618,
    "book": "psalms                                  ",
    "chapter": "97",
    "verse": "5",
    "text": "Грайте Господеві на арфі,"
  },
  {
    "id": 1619,
    "book": "psalms                                  ",
    "chapter": "97",
    "verse": "6",
    "text": "Під звуки труб і сурми97:6 Сурма – мається на увазі шофар; Див. Пс. 46:6."
  },
  {
    "id": 1620,
    "book": "psalms                                  ",
    "chapter": "97",
    "verse": "7",
    "text": "Нехай гуркотить море і все, що його наповнює,"
  },
  {
    "id": 1621,
    "book": "psalms                                  ",
    "chapter": "97",
    "verse": "8",
    "text": "Нехай ріки плещуть у долоні,"
  },
  {
    "id": 1622,
    "book": "psalms                                  ",
    "chapter": "97",
    "verse": "9",
    "text": "перед обличчям Господа,"
  }
