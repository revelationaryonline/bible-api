    "chapter": "22",
    "verse": "1",
    "text": "Псалом Давидів"
  },
  {
    "id": 311,
    "book": "psalms                                  ",
    "chapter": "22",
    "verse": "2",
    "text": "Він дає мені спочинок на трав’янистих пасовищах,"
  },
  {
    "id": 312,
    "book": "psalms                                  ",
    "chapter": "22",
    "verse": "3",
    "text": "Він оживляє мою душу,"
  },
  {
    "id": 313,
    "book": "psalms                                  ",
    "chapter": "22",
    "verse": "4",
    "text": "Навіть коли я піду долиною тіней смерті,"
  },
  {
    "id": 314,
    "book": "psalms                                  ",
    "chapter": "22",
    "verse": "5",
    "text": "Ти готуєш для мене святковий стіл"
  },
  {
    "id": 315,
    "book": "psalms                                  ",
    "chapter": "22",
    "verse": "6",
    "text": "Тож нехай добро й милість супроводжують мене"
  }
]
