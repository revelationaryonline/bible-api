[
  {
    "id": 1637,
    "book": "psalms                                  ",
    "chapter": "100",
    "verse": "1",
    "text": "Псалом Давидів."
  },
  {
    "id": 1638,
    "book": "psalms                                  ",
    "chapter": "100",
    "verse": "2",
    "text": "Я уважно стежитиму за дорогою невинною."
  },
  {
    "id": 1639,
    "book": "psalms                                  ",
    "chapter": "100",
    "verse": "3",
    "text": "Не покладу перед очима своїми"
  },
  {
    "id": 1640,
    "book": "psalms                                  ",
    "chapter": "100",
    "verse": "4",
    "text": "Зіпсоване серце віддалене буде від мене;"
  },
  {
    "id": 1641,
    "book": "psalms                                  ",
    "chapter": "100",
    "verse": "5",
    "text": "Того, хто таємно зводить наклепи на ближнього свого,"
  },
  {
    "id": 1642,
    "book": "psalms                                  ",
    "chapter": "100",
    "verse": "6",
    "text": "Очі мої – на вірних землі,"
  },
  {
    "id": 1643,
    "book": "psalms                                  ",
    "chapter": "100",
    "verse": "7",
    "text": "Віроломний не житиме в домі моєму,"
  },
  {
    "id": 1644,
    "book": "psalms                                  ",
    "chapter": "100",
    "verse": "8",
    "text": "Щоранку знищуватиму всіх нечестивців землі,"
  }
]
