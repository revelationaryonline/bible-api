[
  {
    "id": 592,
    "book": "psalms                                  ",
    "chapter": "38",
    "verse": "1",
    "text": "Керівнику хору Єдутуну. Псалом Давидів."
  },
  {
    "id": 593,
    "book": "psalms                                  ",
    "chapter": "38",
    "verse": "2",
    "text": "Я сказав: «Я стежитиму за своїми життєвими дорогами,"
  },
  {
    "id": 594,
    "book": "psalms                                  ",
    "chapter": "38",
    "verse": "3",
    "text": "Я онімів, затих,"
  },
  {
    "id": 595,
    "book": "psalms                                  ",
    "chapter": "38",
    "verse": "4",
    "text": "серце моє запалало зсередини."
  },
  {
    "id": 596,
    "book": "psalms                                  ",
    "chapter": "38",
    "verse": "5",
    "text": "«Дай мені знати, Господи, час мого кінця"
  },
  {
    "id": 597,
    "book": "psalms                                  ",
    "chapter": "38",
    "verse": "6",
    "text": "Ось Ти дав мені днів лише на ширину долоні,"
  },
  {
    "id": 598,
    "book": "psalms                                  ",
    "chapter": "38",
    "verse": "7",
    "text": "Так, людина снує в сутінках,"
  },
  {
    "id": 599,
    "book": "psalms                                  ",
    "chapter": "38",
    "verse": "8",
    "text": "Тож на що мені тепер надіятися, мій Володарю?"
  },
  {
    "id": 600,
    "book": "psalms                                  ",
    "chapter": "38",
    "verse": "9",
    "text": "Визволи мене від усіх беззаконь моїх,"
  },
  {
    "id": 601,
    "book": "psalms                                  ",
    "chapter": "38",
    "verse": "10",
    "text": "Я онімів, не відкриваю вуст моїх,"
  },
  {
    "id": 602,
    "book": "psalms                                  ",
    "chapter": "38",
    "verse": "11",
    "text": "Відведи від мене удар Твій;"
  },
  {
    "id": 603,
    "book": "psalms                                  ",
    "chapter": "38",
    "verse": "12",
    "text": "Докорами за беззаконня Ти караєш людину"
  },
  {
    "id": 604,
    "book": "psalms                                  ",
    "chapter": "38",
    "verse": "13",
    "text": "Почуй молитву мою, Господи,"
  },
  {
    "id": 605,
    "book": "psalms                                  ",
    "chapter": "38",
    "verse": "14",
    "text": "Відведи Свій суворий погляд від мене, щоб я трохи порадів,"
  }
]
