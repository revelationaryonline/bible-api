[
  {
    "id": 2357,
    "book": "psalms                                  ",
    "chapter": "137",
    "verse": "1",
    "text": "Псалом Давидів."
  },
  {
    "id": 2358,
    "book": "psalms                                  ",
    "chapter": "137",
    "verse": "2",
    "text": "Поклонюся перед Храмом святині Твоєї"
  },
  {
    "id": 2359,
    "book": "psalms                                  ",
    "chapter": "137",
    "verse": "3",
    "text": "Того дня, коли я кликав Тебе, Ти відповів мені,"
  },
  {
    "id": 2360,
    "book": "psalms                                  ",
    "chapter": "137",
    "verse": "4",
    "text": "Прославлять Тебе, Господи, усі царі земні,"
  },
  {
    "id": 2361,
    "book": "psalms                                  ",
    "chapter": "137",
    "verse": "5",
    "text": "і будуть оспівувати дороги Господні,"
  },
  {
    "id": 2362,
    "book": "psalms                                  ",
    "chapter": "137",
    "verse": "6",
    "text": "Хоч високо Господь, але бачить смиренного"
  },
  {
    "id": 2363,
    "book": "psalms                                  ",
    "chapter": "137",
    "verse": "7",
    "text": "Навіть якщо я йтиму серед скорботи,"
  },
  {
    "id": 2364,
    "book": "psalms                                  ",
    "chapter": "137",
    "verse": "8",
    "text": "Господь здійснить правосуддя для мене."
  }
]
