[
  {
    "id": 2489,
    "book": "psalms                                  ",
    "chapter": "147",
    "verse": "1",
    "text": "Хвали, Єрусалиме, Господа;"
  },
  {
    "id": 2490,
    "book": "psalms                                  ",
    "chapter": "147",
    "verse": "2",
    "text": "Бо Він зміцнив засуви воріт твоїх,"
  },
  {
    "id": 2491,
    "book": "psalms                                  ",
    "chapter": "147",
    "verse": "3",
    "text": "Він встановлює мир на твоїх кордонах,"
  },
  {
    "id": 2492,
    "book": "psalms                                  ",
    "chapter": "147",
    "verse": "4",
    "text": "Він посилає наказ Свій землі,"
  },
  {
    "id": 2493,
    "book": "psalms                                  ",
    "chapter": "147",
    "verse": "5",
    "text": "Він дає сніг, немов вовну,"
  },
  {
    "id": 2494,
    "book": "psalms                                  ",
    "chapter": "147",
    "verse": "6",
    "text": "кидає кригу Свою, ніби дрібні камінці;"
  },
  {
    "id": 2495,
    "book": "psalms                                  ",
    "chapter": "147",
    "verse": "7",
    "text": "Він пошле слово Своє, і все розтане,"
  },
  {
    "id": 2496,
    "book": "psalms                                  ",
    "chapter": "147",
    "verse": "8",
    "text": "Він звіщає слово Своє Якову,"
  },
  {
    "id": 2497,
    "book": "psalms                                  ",
    "chapter": "147",
    "verse": "9",
    "text": "Він не зробив такого жодному іншому народові,"
  }
]
