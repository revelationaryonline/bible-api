[
  {
    "id": 2512,
    "book": "psalms                                  ",
    "chapter": "149",
    "verse": "1",
    "text": "Алілуя!"
  },
  {
    "id": 2513,
    "book": "psalms                                  ",
    "chapter": "149",
    "verse": "2",
    "text": "Нехай радіє Ізраїль своїм Творцем,"
  },
  {
    "id": 2514,
    "book": "psalms                                  ",
    "chapter": "149",
    "verse": "3",
    "text": "Хваліть ім’я Його в хороводі,"
  },
  {
    "id": 2515,
    "book": "psalms                                  ",
    "chapter": "149",
    "verse": "4",
    "text": "бо вподобав Господь народ Свій,"
  },
  {
    "id": 2516,
    "book": "psalms                                  ",
    "chapter": "149",
    "verse": "5",
    "text": "Нехай вірні веселяться у славі,"
  },
  {
    "id": 2517,
    "book": "psalms                                  ",
    "chapter": "149",
    "verse": "6",
    "text": "Богові хвала піднесена на вустах у них"
  },
  {
    "id": 2518,
    "book": "psalms                                  ",
    "chapter": "149",
    "verse": "7",
    "text": "щоб вчинити помсту народам,"
  },
  {
    "id": 2519,
    "book": "psalms                                  ",
    "chapter": "149",
    "verse": "8",
    "text": "щоб зв’язати царів їхніх кайданами"
  },
  {
    "id": 2520,
    "book": "psalms                                  ",
    "chapter": "149",
    "verse": "9",
    "text": "щоб звершити над ними записаний вирок."
  }
]
