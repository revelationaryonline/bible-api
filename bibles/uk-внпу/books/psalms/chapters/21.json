[
  {
    "id": 278,
    "book": "psalms                                  ",
    "chapter": "21",
    "verse": "1",
    "text": "Керівнику хору. На мотив «Лань на світанку». Псалом Давидів."
  },
  {
    "id": 279,
    "book": "psalms                                  ",
    "chapter": "21",
    "verse": "2",
    "text": "Боже мій, Боже мій, чому Ти покинув мене?"
  },
  {
    "id": 280,
    "book": "psalms                                  ",
    "chapter": "21",
    "verse": "3",
    "text": "Боже мій, я кличу вдень – Ти не відповідаєш,"
  },
  {
    "id": 281,
    "book": "psalms                                  ",
    "chapter": "21",
    "verse": "4",
    "text": "Але ж Ти – Святий;"
  },
  {
    "id": 282,
    "book": "psalms                                  ",
    "chapter": "21",
    "verse": "5",
    "text": "На Тебе покладалися батьки наші,"
  },
  {
    "id": 283,
    "book": "psalms                                  ",
    "chapter": "21",
    "verse": "6",
    "text": "До Тебе волали й були визволені,"
  },
  {
    "id": 284,
    "book": "psalms                                  ",
    "chapter": "21",
    "verse": "7",
    "text": "Я ж – черв’як, а не людина,"
  },
  {
    "id": 285,
    "book": "psalms                                  ",
    "chapter": "21",
    "verse": "8",
    "text": "Усі, хто бачить мене, глузують з мене:"
  },
  {
    "id": 286,
    "book": "psalms                                  ",
    "chapter": "21",
    "verse": "9",
    "text": "«Він покладався на Господа,"
  },
  {
    "id": 287,
    "book": "psalms                                  ",
    "chapter": "21",
    "verse": "10",
    "text": "Ти ж, Господи, вивів мене з утроби,"
  },
  {
    "id": 288,
    "book": "psalms                                  ",
    "chapter": "21",
    "verse": "11",
    "text": "На Тебе я покинутий від самого народження,"
  },
  {
    "id": 289,
    "book": "psalms                                  ",
    "chapter": "21",
    "verse": "12",
    "text": "Не віддаляйся від мене,"
  },
  {
    "id": 290,
    "book": "psalms                                  ",
    "chapter": "21",
    "verse": "13",
    "text": "Оточили мене численні бугаї,"
  },
  {
    "id": 291,
    "book": "psalms                                  ",
    "chapter": "21",
    "verse": "14",
    "text": "Пащі свої роззявили на мене,"
  },
  {
    "id": 292,
    "book": "psalms                                  ",
    "chapter": "21",
    "verse": "15",
    "text": "Я розлився, як вода,"
  },
  {
    "id": 293,
    "book": "psalms                                  ",
    "chapter": "21",
    "verse": "16",
    "text": "Моя життєва сила висохла, немов череп’я,"
  },
  {
    "id": 294,
    "book": "psalms                                  ",
    "chapter": "21",
    "verse": "17",
    "text": "Пси обступили мене,"
  },
  {
    "id": 295,
    "book": "psalms                                  ",
    "chapter": "21",
    "verse": "18",
    "text": "Усі кістки свої я можу перелічити,"
  },
  {
    "id": 296,
    "book": "psalms                                  ",
    "chapter": "21",
    "verse": "19",
    "text": "Вони ділять між собою мої шати"
  },
  {
    "id": 297,
    "book": "psalms                                  ",
    "chapter": "21",
    "verse": "20",
    "text": "А Ти, Господи, не віддаляйся!"
  },
  {
    "id": 298,
    "book": "psalms                                  ",
    "chapter": "21",
    "verse": "21",
    "text": "Визволи мою душу від меча,"
  },
  {
    "id": 299,
    "book": "psalms                                  ",
    "chapter": "21",
    "verse": "22",
    "text": "Врятуй мене від пащі лева,"
  },
  {
    "id": 300,
    "book": "psalms                                  ",
    "chapter": "21",
    "verse": "23",
    "text": "Я звіщатиму ім’я Твоє братам моїм,"
  },
  {
    "id": 301,
    "book": "psalms                                  ",
    "chapter": "21",
    "verse": "24",
    "text": "Ті, хто Господа боїться, хваліть Його!"
  },
  {
    "id": 302,
    "book": "psalms                                  ",
    "chapter": "21",
    "verse": "25",
    "text": "Бо не знехтував Він"
  },
  {
    "id": 303,
    "book": "psalms                                  ",
    "chapter": "21",
    "verse": "26",
    "text": "Тобі моя хвала у зібранні великому."
  },
  {
    "id": 304,
    "book": "psalms                                  ",
    "chapter": "21",
    "verse": "27",
    "text": "Бідняки їстимуть і наситяться,"
  },
  {
    "id": 305,
    "book": "psalms                                  ",
    "chapter": "21",
    "verse": "28",
    "text": "Згадають Господа й навернуться до Нього всі краї землі,"
  },
  {
    "id": 306,
    "book": "psalms                                  ",
    "chapter": "21",
    "verse": "29",
    "text": "Бо Господеві належить царство,"
  },
  {
    "id": 307,
    "book": "psalms                                  ",
    "chapter": "21",
    "verse": "30",
    "text": "Усі багатії21:30 Буквально: товстуни. землі будуть їсти й поклоняться Йому;"
  },
  {
    "id": 308,
    "book": "psalms                                  ",
    "chapter": "21",
    "verse": "31",
    "text": "Нащадки служитимуть Йому,"
  },
  {
    "id": 309,
    "book": "psalms                                  ",
    "chapter": "21",
    "verse": "32",
    "text": "Прийдуть і звіщатимуть Його правду"
  }
]
