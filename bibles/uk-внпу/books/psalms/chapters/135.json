[
  {
    "id": 2322,
    "book": "psalms                                  ",
    "chapter": "135",
    "verse": "1",
    "text": "Славте Господа, бо Він добрий,"
  },
  {
    "id": 2323,
    "book": "psalms                                  ",
    "chapter": "135",
    "verse": "2",
    "text": "Славте Бога над богами,"
  },
  {
    "id": 2324,
    "book": "psalms                                  ",
    "chapter": "135",
    "verse": "3",
    "text": "Славте Владику над владиками,"
  },
  {
    "id": 2325,
    "book": "psalms                                  ",
    "chapter": "135",
    "verse": "4",
    "text": "Того, Хто лише один здійснює чудеса великі,"
  },
  {
    "id": 2326,
    "book": "psalms                                  ",
    "chapter": "135",
    "verse": "5",
    "text": "Того, Хто створив небеса розумно,"
  },
  {
    "id": 2327,
    "book": "psalms                                  ",
    "chapter": "135",
    "verse": "6",
    "text": "Того, Хто розкинув землю над водами,"
  },
  {
    "id": 2328,
    "book": "psalms                                  ",
    "chapter": "135",
    "verse": "7",
    "text": "Того, Хто створив світила великі,"
  },
  {
    "id": 2329,
    "book": "psalms                                  ",
    "chapter": "135",
    "verse": "8",
    "text": "сонце, щоб панувати над днем,"
  },
  {
    "id": 2330,
    "book": "psalms                                  ",
    "chapter": "135",
    "verse": "9",
    "text": "місяць і зорі, щоб керувати ніччю,"
  },
  {
    "id": 2331,
    "book": "psalms                                  ",
    "chapter": "135",
    "verse": "10",
    "text": "Він вразив Єгипет через його первістків,"
  },
  {
    "id": 2332,
    "book": "psalms                                  ",
    "chapter": "135",
    "verse": "11",
    "text": "і вивів Ізраїля з-поміж них,"
  },
  {
    "id": 2333,
    "book": "psalms                                  ",
    "chapter": "135",
    "verse": "12",
    "text": "рукою сильною й плечем простягнутим,"
  },
  {
    "id": 2334,
    "book": "psalms                                  ",
    "chapter": "135",
    "verse": "13",
    "text": "Того, Хто Море Червоне розділив навпіл,"
  },
  {
    "id": 2335,
    "book": "psalms                                  ",
    "chapter": "135",
    "verse": "14",
    "text": "і провів Ізраїля посеред нього,"
  },
  {
    "id": 2336,
    "book": "psalms                                  ",
    "chapter": "135",
    "verse": "15",
    "text": "але жбурнув фараона й військо його в Море Червоне,"
  },
  {
    "id": 2337,
    "book": "psalms                                  ",
    "chapter": "135",
    "verse": "16",
    "text": "Він провів народ Свій через пустелю,"
  },
  {
    "id": 2338,
    "book": "psalms                                  ",
    "chapter": "135",
    "verse": "17",
    "text": "Він вразив великих царів,"
  },
  {
    "id": 2339,
    "book": "psalms                                  ",
    "chapter": "135",
    "verse": "18",
    "text": "убив могутніх царів,"
  },
  {
    "id": 2340,
    "book": "psalms                                  ",
    "chapter": "135",
    "verse": "19",
    "text": "Сіхона, царя аморейського,"
  },
  {
    "id": 2341,
    "book": "psalms                                  ",
    "chapter": "135",
    "verse": "20",
    "text": "й Оґа, царя Башану,"
  },
  {
    "id": 2342,
    "book": "psalms                                  ",
    "chapter": "135",
    "verse": "21",
    "text": "і віддав їхню землю у спадок,"
  },
  {
    "id": 2343,
    "book": "psalms                                  ",
    "chapter": "135",
    "verse": "22",
    "text": "у спадок Ізраїлеві, слузі Своєму,"
  },
  {
    "id": 2344,
    "book": "psalms                                  ",
    "chapter": "135",
    "verse": "23",
    "text": "Того, Хто згадав нас у приниженні нашому,"
  },
  {
    "id": 2345,
    "book": "psalms                                  ",
    "chapter": "135",
    "verse": "24",
    "text": "і визволив нас від супротивників наших,"
  },
  {
    "id": 2346,
    "book": "psalms                                  ",
    "chapter": "135",
    "verse": "25",
    "text": "Того, Хто дає їжу всьому живому,135:25 Буквально: всякій плоті."
  },
  {
    "id": 2347,
    "book": "psalms                                  ",
    "chapter": "135",
    "verse": "26",
    "text": "Славте Бога небес,"
  }
]
