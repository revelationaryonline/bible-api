    "chapter": "2",
    "verse": "1",
    "text": "Чому бентежаться народи"
  },
  {
    "id": 8,
    "book": "psalms                                  ",
    "chapter": "2",
    "verse": "2",
    "text": "Повстають царі землі,"
  },
  {
    "id": 9,
    "book": "psalms                                  ",
    "chapter": "2",
    "verse": "3",
    "text": "«Розірвемо їхні кайдани, – кажуть вони, –"
  },
  {
    "id": 10,
    "book": "psalms                                  ",
    "chapter": "2",
    "verse": "4",
    "text": "Той, Хто сидить на небесах, сміється,"
  },
  {
    "id": 11,
    "book": "psalms                                  ",
    "chapter": "2",
    "verse": "5",
    "text": "Тоді Він промовить до них у гніві Своєму"
  },
  {
    "id": 12,
    "book": "psalms                                  ",
    "chapter": "2",
    "verse": "6",
    "text": "«Ось Я поставив царя Мого"
  },
  {
    "id": 13,
    "book": "psalms                                  ",
    "chapter": "2",
    "verse": "7",
    "text": "Сповіщу-но я постанову Господню:"
  },
  {
    "id": 14,
    "book": "psalms                                  ",
    "chapter": "2",
    "verse": "8",
    "text": "Проси в Мене –"
  },
  {
    "id": 15,
    "book": "psalms                                  ",
    "chapter": "2",
    "verse": "9",
    "text": "Ти уразиш їх жезлом залізним,"
  },
  {
    "id": 16,
    "book": "psalms                                  ",
    "chapter": "2",
    "verse": "10",
    "text": "Отже, царі, схаменіться,"
  },
  {
    "id": 17,
    "book": "psalms                                  ",
    "chapter": "2",
    "verse": "11",
    "text": "Служіть Господеві зі страхом"
  },
  {
    "id": 18,
    "book": "psalms                                  ",
    "chapter": "2",
    "verse": "12",
    "text": "Цілуйте Сина,2:12 Цілування нового царя було знаком визнання його влади, див. попереднє посилання."
  }
]
