[
  {
    "id": 982,
    "book": "psalms                                  ",
    "chapter": "65",
    "verse": "1",
    "text": "Керівнику хору. Пісня. Псалом."
  },
  {
    "id": 983,
    "book": "psalms                                  ",
    "chapter": "65",
    "verse": "2",
    "text": "Співайте славу імені Його,"
  },
  {
    "id": 984,
    "book": "psalms                                  ",
    "chapter": "65",
    "verse": "3",
    "text": "Скажіть Богові: «Які грізні діяння Твої!"
  },
  {
    "id": 985,
    "book": "psalms                                  ",
    "chapter": "65",
    "verse": "4",
    "text": "Уся земля вклоняється Тобі"
  },
  {
    "id": 986,
    "book": "psalms                                  ",
    "chapter": "65",
    "verse": "5",
    "text": "Прийдіть, погляньте на звершення Бога –"
  },
  {
    "id": 987,
    "book": "psalms                                  ",
    "chapter": "65",
    "verse": "6",
    "text": "Він перетворив море на суходіл,65:6 Див. Вих. 14."
  },
  {
    "id": 988,
    "book": "psalms                                  ",
    "chapter": "65",
    "verse": "7",
    "text": "Він панує в могутності Своїй вічно,"
  },
  {
    "id": 989,
    "book": "psalms                                  ",
    "chapter": "65",
    "verse": "8",
    "text": "Благословляйте, народи, Бога нашого"
  },
  {
    "id": 990,
    "book": "psalms                                  ",
    "chapter": "65",
    "verse": "9",
    "text": "Він зберіг серед живих душу нашу"
  },
  {
    "id": 991,
    "book": "psalms                                  ",
    "chapter": "65",
    "verse": "10",
    "text": "Ти випробував нас, Боже,"
  },
  {
    "id": 992,
    "book": "psalms                                  ",
    "chapter": "65",
    "verse": "11",
    "text": "Ти завів нас у сіть,"
  },
  {
    "id": 993,
    "book": "psalms                                  ",
    "chapter": "65",
    "verse": "12",
    "text": "Дозволив вершникам проїхати по головам нашим."
  },
  {
    "id": 994,
    "book": "psalms                                  ",
    "chapter": "65",
    "verse": "13",
    "text": "Увійду я до дому Твого із цілопаленнями,"
  },
  {
    "id": 995,
    "book": "psalms                                  ",
    "chapter": "65",
    "verse": "14",
    "text": "що їх висловили вуста мої"
  },
  {
    "id": 996,
    "book": "psalms                                  ",
    "chapter": "65",
    "verse": "15",
    "text": "Цілопалення жирних овець піднесу Тобі"
  },
  {
    "id": 997,
    "book": "psalms                                  ",
    "chapter": "65",
    "verse": "16",
    "text": "Прийдіть, послухайте,"
  },
  {
    "id": 998,
    "book": "psalms                                  ",
    "chapter": "65",
    "verse": "17",
    "text": "До Нього я кликав моїми вустами,"
  },
  {
    "id": 999,
    "book": "psalms                                  ",
    "chapter": "65",
    "verse": "18",
    "text": "Якби я бачив беззаконня у своєму серці,"
  },
  {
    "id": 1000,
    "book": "psalms                                  ",
    "chapter": "65",
    "verse": "19",
    "text": "Але Бог почув,"
  },
  {
    "id": 1001,
    "book": "psalms                                  ",
    "chapter": "65",
    "verse": "20",
    "text": "Благословенний Бог,"
  }
]
