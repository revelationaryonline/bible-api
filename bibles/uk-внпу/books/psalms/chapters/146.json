[
  {
    "id": 2478,
    "book": "psalms                                  ",
    "chapter": "146",
    "verse": "1",
    "text": "Алілуя!"
  },
  {
    "id": 2479,
    "book": "psalms                                  ",
    "chapter": "146",
    "verse": "2",
    "text": "Господь відбудовує Єрусалим,"
  },
  {
    "id": 2480,
    "book": "psalms                                  ",
    "chapter": "146",
    "verse": "3",
    "text": "зцілює розбитих серцем"
  },
  {
    "id": 2481,
    "book": "psalms                                  ",
    "chapter": "146",
    "verse": "4",
    "text": "обчислює кількість зірок"
  },
  {
    "id": 2482,
    "book": "psalms                                  ",
    "chapter": "146",
    "verse": "5",
    "text": "Великий Володар наш і вельми сильний,"
  },
  {
    "id": 2483,
    "book": "psalms                                  ",
    "chapter": "146",
    "verse": "6",
    "text": "Господь підтримує пригноблених,"
  },
  {
    "id": 2484,
    "book": "psalms                                  ",
    "chapter": "146",
    "verse": "7",
    "text": "Віддайте Господеві подяку,"
  },
  {
    "id": 2485,
    "book": "psalms                                  ",
    "chapter": "146",
    "verse": "8",
    "text": "Він небеса вкриває хмарами,"
  },
  {
    "id": 2486,
    "book": "psalms                                  ",
    "chapter": "146",
    "verse": "9",
    "text": "дає худобі їжу"
  },
  {
    "id": 2487,
    "book": "psalms                                  ",
    "chapter": "146",
    "verse": "10",
    "text": "Не міць коня Йому до вподоби,"
  },
  {
    "id": 2488,
    "book": "psalms                                  ",
    "chapter": "146",
    "verse": "11",
    "text": "Господь уподобав тих, хто боїться Його,"
  }
]
