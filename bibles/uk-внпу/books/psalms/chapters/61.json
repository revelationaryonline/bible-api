[
  {
    "id": 932,
    "book": "psalms                                  ",
    "chapter": "61",
    "verse": "1",
    "text": "Керівнику хору, Єдутуну.61:1 Єдутун та його сини були співаками й музикантами, що їх призначив цар Давид прославляти Бога у святилищі; Див. 1 Хр. 16:41, 42. Псалом Давидів."
  },
  {
    "id": 933,
    "book": "psalms                                  ",
    "chapter": "61",
    "verse": "2",
    "text": "Лише в Бозі спокій моєї душі,"
  },
  {
    "id": 934,
    "book": "psalms                                  ",
    "chapter": "61",
    "verse": "3",
    "text": "Тільки Він – моя скеля і мій порятунок,"
  },
  {
    "id": 935,
    "book": "psalms                                  ",
    "chapter": "61",
    "verse": "4",
    "text": "Доки ви будете нападати на людину,"
  },
  {
    "id": 936,
    "book": "psalms                                  ",
    "chapter": "61",
    "verse": "5",
    "text": "Радяться лише про те,"
  },
  {
    "id": 937,
    "book": "psalms                                  ",
    "chapter": "61",
    "verse": "6",
    "text": "Лише в Бозі заспокоюйся, душе моя;"
  },
  {
    "id": 938,
    "book": "psalms                                  ",
    "chapter": "61",
    "verse": "7",
    "text": "Тільки Він – моя скеля і мій порятунок,"
  },
  {
    "id": 939,
    "book": "psalms                                  ",
    "chapter": "61",
    "verse": "8",
    "text": "У Бозі спасіння моє і слава моя;"
  },
  {
    "id": 940,
    "book": "psalms                                  ",
    "chapter": "61",
    "verse": "9",
    "text": "Народе, покладайся на Нього повсякчас,"
  },
  {
    "id": 941,
    "book": "psalms                                  ",
    "chapter": "61",
    "verse": "10",
    "text": "Сини людські – лише марнота,"
  },
  {
    "id": 942,
    "book": "psalms                                  ",
    "chapter": "61",
    "verse": "11",
    "text": "Не покладайтеся на гноблення інших"
  },
  {
    "id": 943,
    "book": "psalms                                  ",
    "chapter": "61",
    "verse": "12",
    "text": "Один раз Бог промовив,"
  },
  {
    "id": 944,
    "book": "psalms                                  ",
    "chapter": "61",
    "verse": "13",
    "text": "у Тебе, Володарю, милість."
  }
]
