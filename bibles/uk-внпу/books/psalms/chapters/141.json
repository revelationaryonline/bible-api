[
  {
    "id": 2413,
    "book": "psalms                                  ",
    "chapter": "141",
    "verse": "1",
    "text": "Роздуми Давидові, коли він був у печері.141:1 Див. 1 Цар. 22:1-2. Молитва."
  },
  {
    "id": 2414,
    "book": "psalms                                  ",
    "chapter": "141",
    "verse": "2",
    "text": "Виливаю перед Ним скаргу мою,"
  },
  {
    "id": 2415,
    "book": "psalms                                  ",
    "chapter": "141",
    "verse": "3",
    "text": "Коли знемагав у мені дух,"
  },
  {
    "id": 2416,
    "book": "psalms                                  ",
    "chapter": "141",
    "verse": "4",
    "text": "Поглянь, Господи, праворуч і побач:"
  },
  {
    "id": 2417,
    "book": "psalms                                  ",
    "chapter": "141",
    "verse": "5",
    "text": "До Тебе волаю я, Господи,"
  },
  {
    "id": 2418,
    "book": "psalms                                  ",
    "chapter": "141",
    "verse": "6",
    "text": "Прислухайся до волання мого,"
  },
  {
    "id": 2419,
    "book": "psalms                                  ",
    "chapter": "141",
    "verse": "7",
    "text": "Виведи з в’язниці душу мою,"
  }
]
