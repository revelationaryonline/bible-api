    "chapter": "27",
    "verse": "1",
    "text": "Псалом Давидів."
  },
  {
    "id": 375,
    "book": "psalms                                  ",
    "chapter": "27",
    "verse": "2",
    "text": "Почуй голос благань моїх,"
  },
  {
    "id": 376,
    "book": "psalms                                  ",
    "chapter": "27",
    "verse": "3",
    "text": "Не став мене на один рівень із нечестивими,27:3 Буквально: не тягни мене з нечествими, тобто не поводься зі мною так, як із ними."
  },
  {
    "id": 377,
    "book": "psalms                                  ",
    "chapter": "27",
    "verse": "4",
    "text": "Віддай їм за їхніми вчинками,"
  },
  {
    "id": 378,
    "book": "psalms                                  ",
    "chapter": "27",
    "verse": "5",
    "text": "За те, що не задумуються вони над звершеннями Господа"
  },
  {
    "id": 379,
    "book": "psalms                                  ",
    "chapter": "27",
    "verse": "6",
    "text": "Благословенний Господь,"
  },
  {
    "id": 380,
    "book": "psalms                                  ",
    "chapter": "27",
    "verse": "7",
    "text": "Господь – твердиня моя й щит мій;"
  },
  {
    "id": 381,
    "book": "psalms                                  ",
    "chapter": "27",
    "verse": "8",
    "text": "Господь – сила Свого народу,"
  },
  {
    "id": 382,
    "book": "psalms                                  ",
    "chapter": "27",
    "verse": "9",
    "text": "Врятуй народ Твій і благослови Свій спадок;"
  }
]
