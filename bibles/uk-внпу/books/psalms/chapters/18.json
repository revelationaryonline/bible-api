[
  {
    "id": 239,
    "book": "psalms                                  ",
    "chapter": "18",
    "verse": "1",
    "text": "Керівнику хору. Псалом Давидів."
  },
  {
    "id": 240,
    "book": "psalms                                  ",
    "chapter": "18",
    "verse": "2",
    "text": "Небеса проголошують славу Божу,"
  },
  {
    "id": 241,
    "book": "psalms                                  ",
    "chapter": "18",
    "verse": "3",
    "text": "День у день виливають вони мову свою"
  },
  {
    "id": 242,
    "book": "psalms                                  ",
    "chapter": "18",
    "verse": "4",
    "text": "Хоча без слів їхня мова"
  },
  {
    "id": 243,
    "book": "psalms                                  ",
    "chapter": "18",
    "verse": "5",
    "text": "по всій землі розходиться їхній голос,"
  },
  {
    "id": 244,
    "book": "psalms                                  ",
    "chapter": "18",
    "verse": "6",
    "text": "і воно виходить із нього, немов наречений із весільної світлиці,"
  },
  {
    "id": 245,
    "book": "psalms                                  ",
    "chapter": "18",
    "verse": "7",
    "text": "З одного краю небес воно виходить,"
  },
  {
    "id": 246,
    "book": "psalms                                  ",
    "chapter": "18",
    "verse": "8",
    "text": "Закон Господа бездоганний,"
  },
  {
    "id": 247,
    "book": "psalms                                  ",
    "chapter": "18",
    "verse": "9",
    "text": "Настанови Господні справедливі,"
  },
  {
    "id": 248,
    "book": "psalms                                  ",
    "chapter": "18",
    "verse": "10",
    "text": "Страх Господній чистий,"
  },
  {
    "id": 249,
    "book": "psalms                                  ",
    "chapter": "18",
    "verse": "11",
    "text": "Вони бажаніші від золота,"
  },
  {
    "id": 250,
    "book": "psalms                                  ",
    "chapter": "18",
    "verse": "12",
    "text": "Тож Твій слуга бережеться ними;"
  },
  {
    "id": 251,
    "book": "psalms                                  ",
    "chapter": "18",
    "verse": "13",
    "text": "А помилки свої – хто їх помітити може?"
  },
  {
    "id": 252,
    "book": "psalms                                  ",
    "chapter": "18",
    "verse": "14",
    "text": "і від свідомих гріхів стримай раба Твого –"
  },
  {
    "id": 253,
    "book": "psalms                                  ",
    "chapter": "18",
    "verse": "15",
    "text": "Нехай приємні Тобі будуть слова вуст моїх"
  }
]
