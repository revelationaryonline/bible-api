    "book": "psalms                                  ",
    "chapter": "66",
    "verse": "1",
    "text": "Керівнику хору. На струнних інструментах. Псалом. Пісня."
  },
  {
    "id": 1003,
    "book": "psalms                                  ",
    "chapter": "66",
    "verse": "2",
    "text": "Боже, змилуйся над нами й благослови нас;"
  },
  {
    "id": 1004,
    "book": "psalms                                  ",
    "chapter": "66",
    "verse": "3",
    "text": "щоб на землі пізнали Твої дороги,"
  },
  {
    "id": 1005,
    "book": "psalms                                  ",
    "chapter": "66",
    "verse": "4",
    "text": "Нехай прославлять Тебе народи, Боже,"
  },
  {
    "id": 1006,
    "book": "psalms                                  ",
    "chapter": "66",
    "verse": "5",
    "text": "Нехай радіють і радісно вигукують племена,"
  },
  {
    "id": 1007,
    "book": "psalms                                  ",
    "chapter": "66",
    "verse": "6",
    "text": "Нехай прославлять Тебе народи, Боже,"
  },
  {
    "id": 1008,
    "book": "psalms                                  ",
    "chapter": "66",
    "verse": "7",
    "text": "Земля принесла свій врожай;"
