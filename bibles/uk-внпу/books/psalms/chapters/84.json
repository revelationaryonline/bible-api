[
  {
    "id": 1391,
    "book": "psalms                                  ",
    "chapter": "84",
    "verse": "1",
    "text": "Керівнику хору. Псалом синів Кореєвих."
  },
  {
    "id": 1392,
    "book": "psalms                                  ",
    "chapter": "84",
    "verse": "2",
    "text": "Ти вподобав землю Свою, Господи,"
  },
  {
    "id": 1393,
    "book": "psalms                                  ",
    "chapter": "84",
    "verse": "3",
    "text": "Ти простив беззаконня народу Твого,"
  },
  {
    "id": 1394,
    "book": "psalms                                  ",
    "chapter": "84",
    "verse": "4",
    "text": "Ти забрав від нас увесь Свій гнів,"
  },
  {
    "id": 1395,
    "book": "psalms                                  ",
    "chapter": "84",
    "verse": "5",
    "text": "Віднови нас, Боже спасіння нашого,"
  },
  {
    "id": 1396,
    "book": "psalms                                  ",
    "chapter": "84",
    "verse": "6",
    "text": "Невже Ти гніватимешся на нас вічно,"
  },
  {
    "id": 1397,
    "book": "psalms                                  ",
    "chapter": "84",
    "verse": "7",
    "text": "Невже не оживиш нас знову,"
  },
  {
    "id": 1398,
    "book": "psalms                                  ",
    "chapter": "84",
    "verse": "8",
    "text": "З’яви нам, Господи, милість Свою"
  },
  {
    "id": 1399,
    "book": "psalms                                  ",
    "chapter": "84",
    "verse": "9",
    "text": "Послухаю-но, що скаже Бог, Господь,"
  },
  {
    "id": 1400,
    "book": "psalms                                  ",
    "chapter": "84",
    "verse": "10",
    "text": "Справді, близьке спасіння Його до тих, хто Його боїться,"
  },
  {
    "id": 1401,
    "book": "psalms                                  ",
    "chapter": "84",
    "verse": "11",
    "text": "Милість та істина зустрінуться,"
  },
  {
    "id": 1402,
    "book": "psalms                                  ",
    "chapter": "84",
    "verse": "12",
    "text": "Істина проросте із землі,"
  },
  {
    "id": 1403,
    "book": "psalms                                  ",
    "chapter": "84",
    "verse": "13",
    "text": "і дасть Господь добро,"
  },
  {
    "id": 1404,
    "book": "psalms                                  ",
    "chapter": "84",
    "verse": "14",
    "text": "Правда піде перед Ним,"
  }
]
