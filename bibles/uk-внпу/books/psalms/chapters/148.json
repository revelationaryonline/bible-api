[
  {
    "id": 2498,
    "book": "psalms                                  ",
    "chapter": "148",
    "verse": "1",
    "text": "Алілуя!"
  },
  {
    "id": 2499,
    "book": "psalms                                  ",
    "chapter": "148",
    "verse": "2",
    "text": "Хваліть Його, усі ангели Його,"
  },
  {
    "id": 2500,
    "book": "psalms                                  ",
    "chapter": "148",
    "verse": "3",
    "text": "Хваліть Його, сонце і місяць,"
  },
  {
    "id": 2501,
    "book": "psalms                                  ",
    "chapter": "148",
    "verse": "4",
    "text": "Хваліть Його, небеса небес,"
  },
  {
    "id": 2502,
    "book": "psalms                                  ",
    "chapter": "148",
    "verse": "5",
    "text": "Хваліть ім’я Господа,"
  },
  {
    "id": 2503,
    "book": "psalms                                  ",
    "chapter": "148",
    "verse": "6",
    "text": "Він утвердив їх на віки вічні –"
  },
  {
    "id": 2504,
    "book": "psalms                                  ",
    "chapter": "148",
    "verse": "7",
    "text": "Хваліть Господа з землі,"
  },
  {
    "id": 2505,
    "book": "psalms                                  ",
    "chapter": "148",
    "verse": "8",
    "text": "вогонь і град, сніг і туман,"
  },
  {
    "id": 2506,
    "book": "psalms                                  ",
    "chapter": "148",
    "verse": "9",
    "text": "гори й усі пагорби,"
  },
  {
    "id": 2507,
    "book": "psalms                                  ",
    "chapter": "148",
    "verse": "10",
    "text": "звірі й уся худоба,"
  },
  {
    "id": 2508,
    "book": "psalms                                  ",
    "chapter": "148",
    "verse": "11",
    "text": "царі земні й усі племена,"
  },
  {
    "id": 2509,
    "book": "psalms                                  ",
    "chapter": "148",
    "verse": "12",
    "text": "юнаки й дівчата,"
  },
  {
    "id": 2510,
    "book": "psalms                                  ",
    "chapter": "148",
    "verse": "13",
    "text": "хваліть ім’я Господа,"
  },
  {
    "id": 2511,
    "book": "psalms                                  ",
    "chapter": "148",
    "verse": "14",
    "text": "Він підняв ріг народу Свого,"
  }
]
