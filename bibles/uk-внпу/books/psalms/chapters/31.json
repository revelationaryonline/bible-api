[
  {
    "id": 432,
    "book": "psalms                                  ",
    "chapter": "31",
    "verse": "1",
    "text": "Псалом Давидів. Повчання."
  },
  {
    "id": 433,
    "book": "psalms                                  ",
    "chapter": "31",
    "verse": "2",
    "text": "Блаженна та людина,"
  },
  {
    "id": 434,
    "book": "psalms                                  ",
    "chapter": "31",
    "verse": "3",
    "text": "Поки я мовчав,"
  },
  {
    "id": 435,
    "book": "psalms                                  ",
    "chapter": "31",
    "verse": "4",
    "text": "Бо вдень і вночі"
  },
  {
    "id": 436,
    "book": "psalms                                  ",
    "chapter": "31",
    "verse": "5",
    "text": "Та визнав я свій гріх перед Тобою"
  },
  {
    "id": 437,
    "book": "psalms                                  ",
    "chapter": "31",
    "verse": "6",
    "text": "Тому помолиться Тобі кожен вірний"
  },
  {
    "id": 438,
    "book": "psalms                                  ",
    "chapter": "31",
    "verse": "7",
    "text": "Ти – потаємний притулок для мене;"
  },
  {
    "id": 439,
    "book": "psalms                                  ",
    "chapter": "31",
    "verse": "8",
    "text": "«Я тебе наставлятиму й спрямовувати тебе буду"
  },
  {
    "id": 440,
    "book": "psalms                                  ",
    "chapter": "31",
    "verse": "9",
    "text": "Тож не будьте як кінь чи мул,"
  },
  {
    "id": 441,
    "book": "psalms                                  ",
    "chapter": "31",
    "verse": "10",
    "text": "Багато скорбот у нечестивого,"
  },
  {
    "id": 442,
    "book": "psalms                                  ",
    "chapter": "31",
    "verse": "11",
    "text": "Радійте в Господі й веселіться, праведні!"
  }
]
