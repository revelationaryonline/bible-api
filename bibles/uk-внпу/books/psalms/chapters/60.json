[
  {
    "id": 923,
    "book": "psalms                                  ",
    "chapter": "60",
    "verse": "1",
    "text": "Керівнику хору. На струнних інструментах. Псалом Давидів."
  },
  {
    "id": 924,
    "book": "psalms                                  ",
    "chapter": "60",
    "verse": "2",
    "text": "Почуй, Боже, моє волання,"
  },
  {
    "id": 925,
    "book": "psalms                                  ",
    "chapter": "60",
    "verse": "3",
    "text": "Від краю землі я кличу до Тебе"
  },
  {
    "id": 926,
    "book": "psalms                                  ",
    "chapter": "60",
    "verse": "4",
    "text": "Адже Ти – пристановище для мене,"
  },
  {
    "id": 927,
    "book": "psalms                                  ",
    "chapter": "60",
    "verse": "5",
    "text": "Нехай би мешкав я в шатрі Твоєму вічно,"
  },
  {
    "id": 928,
    "book": "psalms                                  ",
    "chapter": "60",
    "verse": "6",
    "text": "Адже Ти, Боже, почув мої обітниці,"
  },
  {
    "id": 929,
    "book": "psalms                                  ",
    "chapter": "60",
    "verse": "7",
    "text": "Додай цареві днів життя,"
  },
  {
    "id": 930,
    "book": "psalms                                  ",
    "chapter": "60",
    "verse": "8",
    "text": "Нехай він перебуває вічно перед Богом,"
  },
  {
    "id": 931,
    "book": "psalms                                  ",
    "chapter": "60",
    "verse": "9",
    "text": "Тоді я співатиму імені Твоєму повік,"
  }
]
