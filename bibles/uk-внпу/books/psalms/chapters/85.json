[
  {
    "id": 1405,
    "book": "psalms                                  ",
    "chapter": "85",
    "verse": "1",
    "text": "Молитва Давидова."
  },
  {
    "id": 1406,
    "book": "psalms                                  ",
    "chapter": "85",
    "verse": "2",
    "text": "Збережи душу мою, адже я вірний Тобі."
  },
  {
    "id": 1407,
    "book": "psalms                                  ",
    "chapter": "85",
    "verse": "3",
    "text": "помилуй мене, Владико,"
  },
  {
    "id": 1408,
    "book": "psalms                                  ",
    "chapter": "85",
    "verse": "4",
    "text": "Даруй радість душі раба Свого,"
  },
  {
    "id": 1409,
    "book": "psalms                                  ",
    "chapter": "85",
    "verse": "5",
    "text": "Адже Ти, Владико, добрий і прощаєш,"
  },
  {
    "id": 1410,
    "book": "psalms                                  ",
    "chapter": "85",
    "verse": "6",
    "text": "Зваж, Господи, на мою молитву,"
  },
  {
    "id": 1411,
    "book": "psalms                                  ",
    "chapter": "85",
    "verse": "7",
    "text": "У день скорботи своєї я кличу до Тебе,"
  },
  {
    "id": 1412,
    "book": "psalms                                  ",
    "chapter": "85",
    "verse": "8",
    "text": "Немає подібного до Тебе серед богів, Владико,"
  },
  {
    "id": 1413,
    "book": "psalms                                  ",
    "chapter": "85",
    "verse": "9",
    "text": "Усі народи, створені Тобою,"
  },
  {
    "id": 1414,
    "book": "psalms                                  ",
    "chapter": "85",
    "verse": "10",
    "text": "Бо Ти великий і твориш чудеса;"
  },
  {
    "id": 1415,
    "book": "psalms                                  ",
    "chapter": "85",
    "verse": "11",
    "text": "Покажи мені, Господи, дорогу Твою,"
  },
  {
    "id": 1416,
    "book": "psalms                                  ",
    "chapter": "85",
    "verse": "12",
    "text": "Прославлю Тебе, Владико, Боже мій, усім своїм серцем;"
  },
  {
    "id": 1417,
    "book": "psalms                                  ",
    "chapter": "85",
    "verse": "13",
    "text": "Бо велика милість Твоя до мене;"
  },
  {
    "id": 1418,
    "book": "psalms                                  ",
    "chapter": "85",
    "verse": "14",
    "text": "Боже, зухвальці повстали на мене,"
  },
  {
    "id": 1419,
    "book": "psalms                                  ",
    "chapter": "85",
    "verse": "15",
    "text": "Але Ти, Володарю, Бог милостивий і милосердний,"
  },
  {
    "id": 1420,
    "book": "psalms                                  ",
    "chapter": "85",
    "verse": "16",
    "text": "Обернися до мене й помилуй мене;"
  },
  {
    "id": 1421,
    "book": "psalms                                  ",
    "chapter": "85",
    "verse": "17",
    "text": "Дай мені знак, що Ти добрий до мене;"
  }
]
