[
  {
    "id": 2420,
    "book": "psalms                                  ",
    "chapter": "142",
    "verse": "1",
    "text": "Псалом Давидів."
  },
  {
    "id": 2421,
    "book": "psalms                                  ",
    "chapter": "142",
    "verse": "2",
    "text": "Не судися з рабом Своїм,"
  },
  {
    "id": 2422,
    "book": "psalms                                  ",
    "chapter": "142",
    "verse": "3",
    "text": "Бо ворог переслідує душу мою,"
  },
  {
    "id": 2423,
    "book": "psalms                                  ",
    "chapter": "142",
    "verse": "4",
    "text": "Знемігся в мені дух мій,"
  },
  {
    "id": 2424,
    "book": "psalms                                  ",
    "chapter": "142",
    "verse": "5",
    "text": "Я згадую дні прадавні,"
  },
  {
    "id": 2425,
    "book": "psalms                                  ",
    "chapter": "142",
    "verse": "6",
    "text": "Простягаю руки свої до Тебе;"
  },
  {
    "id": 2426,
    "book": "psalms                                  ",
    "chapter": "142",
    "verse": "7",
    "text": "Поспіши відповісти мені, Господи,"
  },
  {
    "id": 2427,
    "book": "psalms                                  ",
    "chapter": "142",
    "verse": "8",
    "text": "Дай мені почути вранці про милість Твою,"
  },
  {
    "id": 2428,
    "book": "psalms                                  ",
    "chapter": "142",
    "verse": "9",
    "text": "Визволи мене від ворогів моїх, Господи,"
  },
  {
    "id": 2429,
    "book": "psalms                                  ",
    "chapter": "142",
    "verse": "10",
    "text": "Навчи мене виконувати волю Твою,"
  },
  {
    "id": 2430,
    "book": "psalms                                  ",
    "chapter": "142",
    "verse": "11",
    "text": "Заради імені Твого, Господи, оживи мене;"
  },
  {
    "id": 2431,
    "book": "psalms                                  ",
    "chapter": "142",
    "verse": "12",
    "text": "За милістю Своєю знищ ворогів моїх"
  }
]
