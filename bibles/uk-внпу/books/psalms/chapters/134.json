[
  {
    "id": 2301,
    "book": "psalms                                  ",
    "chapter": "134",
    "verse": "1",
    "text": "Алілуя!"
  },
  {
    "id": 2302,
    "book": "psalms                                  ",
    "chapter": "134",
    "verse": "2",
    "text": "що стоять у домі Господньому,"
  },
  {
    "id": 2303,
    "book": "psalms                                  ",
    "chapter": "134",
    "verse": "3",
    "text": "Хваліть Господа, бо добрий Господь;"
  },
  {
    "id": 2304,
    "book": "psalms                                  ",
    "chapter": "134",
    "verse": "4",
    "text": "адже Господь вибрав Собі Якова,"
  },
  {
    "id": 2305,
    "book": "psalms                                  ",
    "chapter": "134",
    "verse": "5",
    "text": "Бо пізнав я, що великий Господь"
  },
  {
    "id": 2306,
    "book": "psalms                                  ",
    "chapter": "134",
    "verse": "6",
    "text": "Усе, що бажає Господь, Він робить"
  },
  {
    "id": 2307,
    "book": "psalms                                  ",
    "chapter": "134",
    "verse": "7",
    "text": "Піднімає хмари від краю землі,"
  },
  {
    "id": 2308,
    "book": "psalms                                  ",
    "chapter": "134",
    "verse": "8",
    "text": "Він вразив первістків Єгипту,"
  },
  {
    "id": 2309,
    "book": "psalms                                  ",
    "chapter": "134",
    "verse": "9",
    "text": "Послав знамення й чудеса посеред тебе, о Єгипте,"
  },
  {
    "id": 2310,
    "book": "psalms                                  ",
    "chapter": "134",
    "verse": "10",
    "text": "Він вразив численні народи"
  },
  {
    "id": 2311,
    "book": "psalms                                  ",
    "chapter": "134",
    "verse": "11",
    "text": "Сіхона, царя аморейського,"
  },
  {
    "id": 2312,
    "book": "psalms                                  ",
    "chapter": "134",
    "verse": "12",
    "text": "і віддав землі їхні у спадок,"
  },
  {
    "id": 2313,
    "book": "psalms                                  ",
    "chapter": "134",
    "verse": "13",
    "text": "Господи, ім’я Твоє – навіки;"
  },
  {
    "id": 2314,
    "book": "psalms                                  ",
    "chapter": "134",
    "verse": "14",
    "text": "Адже судитиме Господь народ Свій"
  },
  {
    "id": 2315,
    "book": "psalms                                  ",
    "chapter": "134",
    "verse": "15",
    "text": "Ідоли народів – лише срібло й золото,"
  },
  {
    "id": 2316,
    "book": "psalms                                  ",
    "chapter": "134",
    "verse": "16",
    "text": "Є в них вуста, але вони не говорять;"
  },
  {
    "id": 2317,
    "book": "psalms                                  ",
    "chapter": "134",
    "verse": "17",
    "text": "у них є вуха, але вони не чують,"
  },
  {
    "id": 2318,
    "book": "psalms                                  ",
    "chapter": "134",
    "verse": "18",
    "text": "Подібними до них нехай стануть ті,"
  },
  {
    "id": 2319,
    "book": "psalms                                  ",
    "chapter": "134",
    "verse": "19",
    "text": "Доме Ізраїлів, благослови Господа!"
  },
  {
    "id": 2320,
    "book": "psalms                                  ",
    "chapter": "134",
    "verse": "20",
    "text": "Доме Левіїв, благослови Господа!"
  },
  {
    "id": 2321,
    "book": "psalms                                  ",
    "chapter": "134",
    "verse": "21",
    "text": "Благословенний із Сіону Господь,"
  }
]
