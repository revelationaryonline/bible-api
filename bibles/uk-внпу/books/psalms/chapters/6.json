[
  {
    "id": 50,
    "book": "psalms                                  ",
    "chapter": "6",
    "verse": "1",
    "text": "Керівнику хору. У супроводі струнних інструментів. Псалом Давидів."
  },
  {
    "id": 51,
    "book": "psalms                                  ",
    "chapter": "6",
    "verse": "2",
    "text": "Господи, не докоряй мені у гніві Твоєму,"
  },
  {
    "id": 52,
    "book": "psalms                                  ",
    "chapter": "6",
    "verse": "3",
    "text": "Помилуй мене, Господи, бо я знемігся."
  },
  {
    "id": 53,
    "book": "psalms                                  ",
    "chapter": "6",
    "verse": "4",
    "text": "Душа моя вкрай збентежена."
  },
  {
    "id": 54,
    "book": "psalms                                  ",
    "chapter": "6",
    "verse": "5",
    "text": "Повернися до мене, Господи, визволи мою душу,"
  },
  {
    "id": 55,
    "book": "psalms                                  ",
    "chapter": "6",
    "verse": "6",
    "text": "Адже в смерті немає згадки про Тебе."
  },
  {
    "id": 56,
    "book": "psalms                                  ",
    "chapter": "6",
    "verse": "7",
    "text": "Я виснажився від стогнання мого,"
  },
  {
    "id": 57,
    "book": "psalms                                  ",
    "chapter": "6",
    "verse": "8",
    "text": "Очі мої змарніли від смутку,"
  },
  {
    "id": 58,
    "book": "psalms                                  ",
    "chapter": "6",
    "verse": "9",
    "text": "Відступіться геть від мене всі ті, хто поводиться свавільно,"
  },
  {
    "id": 59,
    "book": "psalms                                  ",
    "chapter": "6",
    "verse": "10",
    "text": "Почув Господь благання моє,"
  },
  {
    "id": 60,
    "book": "psalms                                  ",
    "chapter": "6",
    "verse": "11",
    "text": "Нехай засоромлені будуть і збентежені вкрай усі вороги мої,"
  }
]
