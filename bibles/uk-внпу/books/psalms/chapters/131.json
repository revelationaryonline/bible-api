[
  {
    "id": 2277,
    "book": "psalms                                  ",
    "chapter": "131",
    "verse": "1",
    "text": "Пісня сходження."
  },
  {
    "id": 2278,
    "book": "psalms                                  ",
    "chapter": "131",
    "verse": "2",
    "text": "коли він присягнув Господеві,"
  },
  {
    "id": 2279,
    "book": "psalms                                  ",
    "chapter": "131",
    "verse": "3",
    "text": "«Не увійду в шатро свого дому,"
  },
  {
    "id": 2280,
    "book": "psalms                                  ",
    "chapter": "131",
    "verse": "4",
    "text": "не дам сну очам моїм"
  },
  {
    "id": 2281,
    "book": "psalms                                  ",
    "chapter": "131",
    "verse": "5",
    "text": "аж поки не знайду місця для Господа,"
  },
  {
    "id": 2282,
    "book": "psalms                                  ",
    "chapter": "131",
    "verse": "6",
    "text": "Ось ми чули про нього в Ефраті,"
  },
  {
    "id": 2283,
    "book": "psalms                                  ",
    "chapter": "131",
    "verse": "7",
    "text": "Підійдімо ж до Його помешкання,"
  },
  {
    "id": 2284,
    "book": "psalms                                  ",
    "chapter": "131",
    "verse": "8",
    "text": "Повстань, Господи, прийди до місця Свого спокою,"
  },
  {
    "id": 2285,
    "book": "psalms                                  ",
    "chapter": "131",
    "verse": "9",
    "text": "Священники Твої нехай зодягнуться правдою"
  },
  {
    "id": 2286,
    "book": "psalms                                  ",
    "chapter": "131",
    "verse": "10",
    "text": "Заради Давида, слуги Свого,"
  },
  {
    "id": 2287,
    "book": "psalms                                  ",
    "chapter": "131",
    "verse": "11",
    "text": "Істинно присягався Господь Давидові,"
  },
  {
    "id": 2288,
    "book": "psalms                                  ",
    "chapter": "131",
    "verse": "12",
    "text": "Якщо дотримуватися будуть сини твої Завіту Мого"
  },
  {
    "id": 2289,
    "book": "psalms                                  ",
    "chapter": "131",
    "verse": "13",
    "text": "Адже обрав Господь Сіон,"
  },
  {
    "id": 2290,
    "book": "psalms                                  ",
    "chapter": "131",
    "verse": "14",
    "text": "«Це місце спочинку Мого на віки вічні,"
  },
  {
    "id": 2291,
    "book": "psalms                                  ",
    "chapter": "131",
    "verse": "15",
    "text": "Щедро благословлю його їжею,"
  },
  {
    "id": 2292,
    "book": "psalms                                  ",
    "chapter": "131",
    "verse": "16",
    "text": "Священників його зодягну спасінням,"
  },
  {
    "id": 2293,
    "book": "psalms                                  ",
    "chapter": "131",
    "verse": "17",
    "text": "Там Я дам розростися рогові Давидовому,"
  },
  {
    "id": 2294,
    "book": "psalms                                  ",
    "chapter": "131",
    "verse": "18",
    "text": "Ворогів його зодягну соромом,"
  }
]
