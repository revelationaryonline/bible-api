[
  {
    "id": 1351,
    "book": "psalms                                  ",
    "chapter": "81",
    "verse": "1",
    "text": "Псалом Асафів."
  },
  {
    "id": 1352,
    "book": "psalms                                  ",
    "chapter": "81",
    "verse": "2",
    "text": "«Доки ви будете судити беззаконно"
  },
  {
    "id": 1353,
    "book": "psalms                                  ",
    "chapter": "81",
    "verse": "3",
    "text": "Судіть чесно бідняка й сироту,"
  },
  {
    "id": 1354,
    "book": "psalms                                  ",
    "chapter": "81",
    "verse": "4",
    "text": "Визволяйте вбогого й бідного,"
  },
  {
    "id": 1355,
    "book": "psalms                                  ",
    "chapter": "81",
    "verse": "5",
    "text": "Не знають, не розуміють судді,"
  },
  {
    "id": 1356,
    "book": "psalms                                  ",
    "chapter": "81",
    "verse": "6",
    "text": "Я сказав: „Ви – боги,"
  },
  {
    "id": 1357,
    "book": "psalms                                  ",
    "chapter": "81",
    "verse": "7",
    "text": "але ви помрете, як люди,"
  },
  {
    "id": 1358,
    "book": "psalms                                  ",
    "chapter": "81",
    "verse": "8",
    "text": "Повстань, Боже, суди землю,"
  }
]
