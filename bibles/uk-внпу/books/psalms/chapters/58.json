[
  {
    "id": 891,
    "book": "psalms                                  ",
    "chapter": "58",
    "verse": "1",
    "text": "Керівнику хору. На мотив «Не згуби». Міхтам Давидів, коли Саул послав людей стерегти його дім, щоб убити його."
  },
  {
    "id": 892,
    "book": "psalms                                  ",
    "chapter": "58",
    "verse": "2",
    "text": "Визволи мене від ворогів Моїх, Боже мій,"
  },
  {
    "id": 893,
    "book": "psalms                                  ",
    "chapter": "58",
    "verse": "3",
    "text": "Від тих, що чинять беззаконня, визволи мене"
  },
  {
    "id": 894,
    "book": "psalms                                  ",
    "chapter": "58",
    "verse": "4",
    "text": "Ось вони чатують на душу мою,"
  },
  {
    "id": 895,
    "book": "psalms                                  ",
    "chapter": "58",
    "verse": "5",
    "text": "Немає беззаконня в мене,"
  },
  {
    "id": 896,
    "book": "psalms                                  ",
    "chapter": "58",
    "verse": "6",
    "text": "Ти, Господи, Боже Воїнств, Боже Ізраїлю,"
  },
  {
    "id": 897,
    "book": "psalms                                  ",
    "chapter": "58",
    "verse": "7",
    "text": "Вони повертаються в сутінках вечірніх,"
  },
  {
    "id": 898,
    "book": "psalms                                  ",
    "chapter": "58",
    "verse": "8",
    "text": "Ось вивергають вони ганьбу,"
  },
  {
    "id": 899,
    "book": "psalms                                  ",
    "chapter": "58",
    "verse": "9",
    "text": "Але Ти, Господи, посмієшся з них,"
  },
  {
    "id": 900,
    "book": "psalms                                  ",
    "chapter": "58",
    "verse": "10",
    "text": "Сило моя, Тебе я пильную очікуючи,"
  },
  {
    "id": 901,
    "book": "psalms                                  ",
    "chapter": "58",
    "verse": "11",
    "text": "Бог, Що милує мене,"
  },
  {
    "id": 902,
    "book": "psalms                                  ",
    "chapter": "58",
    "verse": "12",
    "text": "Не вбивай їх,"
  },
  {
    "id": 903,
    "book": "psalms                                  ",
    "chapter": "58",
    "verse": "13",
    "text": "Гріх вуст їхніх –"
  },
  {
    "id": 904,
    "book": "psalms                                  ",
    "chapter": "58",
    "verse": "14",
    "text": "Знищ їх у гніві, знищ,"
  },
  {
    "id": 905,
    "book": "psalms                                  ",
    "chapter": "58",
    "verse": "15",
    "text": "А вони повертаються в сутінках вечірніх,"
  },
  {
    "id": 906,
    "book": "psalms                                  ",
    "chapter": "58",
    "verse": "16",
    "text": "Вони вештаються в пошуках їжі,"
  },
  {
    "id": 907,
    "book": "psalms                                  ",
    "chapter": "58",
    "verse": "17",
    "text": "А я буду співати про міць Твою"
  },
  {
    "id": 908,
    "book": "psalms                                  ",
    "chapter": "58",
    "verse": "18",
    "text": "Сило моя, Тобі я співатиму,"
  }
]
