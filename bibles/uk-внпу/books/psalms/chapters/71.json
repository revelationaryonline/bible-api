[
  {
    "id": 1113,
    "book": "psalms                                  ",
    "chapter": "71",
    "verse": "1",
    "text": "Про Соломона."
  },
  {
    "id": 1114,
    "book": "psalms                                  ",
    "chapter": "71",
    "verse": "2",
    "text": "Нехай судить він народ Твій справедливо"
  },
  {
    "id": 1115,
    "book": "psalms                                  ",
    "chapter": "71",
    "verse": "3",
    "text": "Нехай гори принесуть народові мир,"
  },
  {
    "id": 1116,
    "book": "psalms                                  ",
    "chapter": "71",
    "verse": "4",
    "text": "Нехай судить він пригнічених народу,"
  },
  {
    "id": 1117,
    "book": "psalms                                  ",
    "chapter": "71",
    "verse": "5",
    "text": "Будуть боятися Тебе, аж поки сонце і місяць існують,"
  },
  {
    "id": 1118,
    "book": "psalms                                  ",
    "chapter": "71",
    "verse": "6",
    "text": "Нехай зійде він як дощ на покіс,"
  },
  {
    "id": 1119,
    "book": "psalms                                  ",
    "chapter": "71",
    "verse": "7",
    "text": "У дні його нехай процвітає праведник"
  },
  {
    "id": 1120,
    "book": "psalms                                  ",
    "chapter": "71",
    "verse": "8",
    "text": "Він пануватиме від моря й до моря"
  },
  {
    "id": 1121,
    "book": "psalms                                  ",
    "chapter": "71",
    "verse": "9",
    "text": "Схилять перед ним коліна мешканці пустель,"
  },
  {
    "id": 1122,
    "book": "psalms                                  ",
    "chapter": "71",
    "verse": "10",
    "text": "Царі Таршишу71:10 Див. примітку до Пс. 47:8. й віддалених берегів платитимуть йому данину,"
  },
  {
    "id": 1123,
    "book": "psalms                                  ",
    "chapter": "71",
    "verse": "11",
    "text": "І вклоняться йому всі царі,"
  },
  {
    "id": 1124,
    "book": "psalms                                  ",
    "chapter": "71",
    "verse": "12",
    "text": "Бо врятує він бідного, коли той волатиме,"
  },
  {
    "id": 1125,
    "book": "psalms                                  ",
    "chapter": "71",
    "verse": "13",
    "text": "Він милість виявить убогому й бідняку"
  },
  {
    "id": 1126,
    "book": "psalms                                  ",
    "chapter": "71",
    "verse": "14",
    "text": "Викупить душі їхні з-під влади насильства,"
  },
  {
    "id": 1127,
    "book": "psalms                                  ",
    "chapter": "71",
    "verse": "15",
    "text": "Нехай він живе довго,"
  },
  {
    "id": 1128,
    "book": "psalms                                  ",
    "chapter": "71",
    "verse": "16",
    "text": "Нехай пшениці буде вдосталь на землі;"
  },
  {
    "id": 1129,
    "book": "psalms                                  ",
    "chapter": "71",
    "verse": "17",
    "text": "Нехай ім’я його перебуває вічно,"
  },
  {
    "id": 1130,
    "book": "psalms                                  ",
    "chapter": "71",
    "verse": "18",
    "text": "Благословенний Господь, Бог Ізраїля,"
  },
  {
    "id": 1131,
    "book": "psalms                                  ",
    "chapter": "71",
    "verse": "19",
    "text": "Благословенне ім’я слави Його повік,"
  },
  {
    "id": 1132,
    "book": "psalms                                  ",
    "chapter": "71",
    "verse": "20",
    "text": "Завершилися молитви Давида, сина Єссеєвого."
  }
]
