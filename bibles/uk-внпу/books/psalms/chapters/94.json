[
  {
    "id": 1578,
    "book": "psalms                                  ",
    "chapter": "94",
    "verse": "1",
    "text": "Прийдіть, заспіваємо радісно Господу,"
  },
  {
    "id": 1579,
    "book": "psalms                                  ",
    "chapter": "94",
    "verse": "2",
    "text": "Прийдемо перед обличчя Його з подякою,"
  },
  {
    "id": 1580,
    "book": "psalms                                  ",
    "chapter": "94",
    "verse": "3",
    "text": "Адже Господь – Бог великий"
  },
  {
    "id": 1581,
    "book": "psalms                                  ",
    "chapter": "94",
    "verse": "4",
    "text": "У руці Його глибини землі,"
  },
  {
    "id": 1582,
    "book": "psalms                                  ",
    "chapter": "94",
    "verse": "5",
    "text": "море – Його, Він створив його,"
  },
  {
    "id": 1583,
    "book": "psalms                                  ",
    "chapter": "94",
    "verse": "6",
    "text": "Прийдіть, поклонімося, впадемо долілиць,"
  },
  {
    "id": 1584,
    "book": "psalms                                  ",
    "chapter": "94",
    "verse": "7",
    "text": "бо Він – наш Бог, а ми – народ Його пасовища,"
  },
  {
    "id": 1585,
    "book": "psalms                                  ",
    "chapter": "94",
    "verse": "8",
    "text": "не зачерствійте серцями вашими, як у Мериві,"
  },
  {
    "id": 1586,
    "book": "psalms                                  ",
    "chapter": "94",
    "verse": "9",
    "text": "де спокушали Мене предки ваші,"
  },
  {
    "id": 1587,
    "book": "psalms                                  ",
    "chapter": "94",
    "verse": "10",
    "text": "Сорок років дратував Мене цей рід,"
  },
  {
    "id": 1588,
    "book": "psalms                                  ",
    "chapter": "94",
    "verse": "11",
    "text": "Тому присягнув Я у гніві Моєму:"
  }
]
