[
  {
    "id": 407,
    "book": "psalms                                  ",
    "chapter": "30",
    "verse": "1",
    "text": "Керівнику хору. Псалом Давидів."
  },
  {
    "id": 408,
    "book": "psalms                                  ",
    "chapter": "30",
    "verse": "2",
    "text": "На Тебе, я Господи, покладаю надію,"
  },
  {
    "id": 409,
    "book": "psalms                                  ",
    "chapter": "30",
    "verse": "3",
    "text": "Схили до мене вухо Твоє,"
  },
  {
    "id": 410,
    "book": "psalms                                  ",
    "chapter": "30",
    "verse": "4",
    "text": "Бо Ти моя скеля й твердиня моя;"
  },
  {
    "id": 411,
    "book": "psalms                                  ",
    "chapter": "30",
    "verse": "5",
    "text": "Витягни мене з тенет, які вони для мене таємно розставили,"
  },
  {
    "id": 412,
    "book": "psalms                                  ",
    "chapter": "30",
    "verse": "6",
    "text": "У руки Твої я ввіряю дух мій;"
  },
  {
    "id": 413,
    "book": "psalms                                  ",
    "chapter": "30",
    "verse": "7",
    "text": "Ненавиджу тих, що шанують марних ідолів;"
  },
  {
    "id": 414,
    "book": "psalms                                  ",
    "chapter": "30",
    "verse": "8",
    "text": "Веселитимусь і радітиму Твоєму милосердю,"
  },
  {
    "id": 415,
    "book": "psalms                                  ",
    "chapter": "30",
    "verse": "9",
    "text": "й не віддав мене в руки ворога мого на поталу,"
  },
  {
    "id": 416,
    "book": "psalms                                  ",
    "chapter": "30",
    "verse": "10",
    "text": "Помилуй мене, Господи, бо тісно мені,"
  },
  {
    "id": 417,
    "book": "psalms                                  ",
    "chapter": "30",
    "verse": "11",
    "text": "Бо життя моє згасає в журбі,"
  },
  {
    "id": 418,
    "book": "psalms                                  ",
    "chapter": "30",
    "verse": "12",
    "text": "Через усіх супротивників моїх"
  },
  {
    "id": 419,
    "book": "psalms                                  ",
    "chapter": "30",
    "verse": "13",
    "text": "Забутий я в серцях їхніх, немов померлий;"
  },
  {
    "id": 420,
    "book": "psalms                                  ",
    "chapter": "30",
    "verse": "14",
    "text": "Бо чую я наклепи від багатьох,"
  },
  {
    "id": 421,
    "book": "psalms                                  ",
    "chapter": "30",
    "verse": "15",
    "text": "Але я на Тебе надію покладаю, Господи!"
  },
  {
    "id": 422,
    "book": "psalms                                  ",
    "chapter": "30",
    "verse": "16",
    "text": "У Твоїй руці час мого життя;"
  },
  {
    "id": 423,
    "book": "psalms                                  ",
    "chapter": "30",
    "verse": "17",
    "text": "Нехай засяє обличчя Твоє над рабом Твоїм,"
  },
  {
    "id": 424,
    "book": "psalms                                  ",
    "chapter": "30",
    "verse": "18",
    "text": "Господи, нехай не буде мені соромно,"
  },
  {
    "id": 425,
    "book": "psalms                                  ",
    "chapter": "30",
    "verse": "19",
    "text": "Нехай оніміють вуста брехливі,"
  },
  {
    "id": 426,
    "book": "psalms                                  ",
    "chapter": "30",
    "verse": "20",
    "text": "Які ж великі Твої блага,"
  },
  {
    "id": 427,
    "book": "psalms                                  ",
    "chapter": "30",
    "verse": "21",
    "text": "Ти вкриваєш їх покровом Свого обличчя30:21 Або: присутності Своєї."
  },
  {
    "id": 428,
    "book": "psalms                                  ",
    "chapter": "30",
    "verse": "22",
    "text": "Благословенний Господь,"
  },
  {
    "id": 429,
    "book": "psalms                                  ",
    "chapter": "30",
    "verse": "23",
    "text": "Я ж сказав у тривозі моїй:"
  },
  {
    "id": 430,
    "book": "psalms                                  ",
    "chapter": "30",
    "verse": "24",
    "text": "Любіть Господа, усі вірні Його!"
  },
  {
    "id": 431,
    "book": "psalms                                  ",
    "chapter": "30",
    "verse": "25",
    "text": "Будьте мужніми й зміцніться серцем,"
  }
]
