[
  {
    "id": 722,
    "book": "psalms                                  ",
    "chapter": "47",
    "verse": "1",
    "text": "Пісня. Псалом синів Кореєвих."
  },
  {
    "id": 723,
    "book": "psalms                                  ",
    "chapter": "47",
    "verse": "2",
    "text": "Великий Господь і прославлений вельми"
  },
  {
    "id": 724,
    "book": "psalms                                  ",
    "chapter": "47",
    "verse": "3",
    "text": "Краса невимовна,"
  },
  {
    "id": 725,
    "book": "psalms                                  ",
    "chapter": "47",
    "verse": "4",
    "text": "Бог перебуває в її палацах,"
  },
  {
    "id": 726,
    "book": "psalms                                  ",
    "chapter": "47",
    "verse": "5",
    "text": "Ось царі зібралися,"
  },
  {
    "id": 727,
    "book": "psalms                                  ",
    "chapter": "47",
    "verse": "6",
    "text": "та, побачивши таку святість, здивувалися,"
  },
  {
    "id": 728,
    "book": "psalms                                  ",
    "chapter": "47",
    "verse": "7",
    "text": "Трепет охопив їх там,"
  },
  {
    "id": 729,
    "book": "psalms                                  ",
    "chapter": "47",
    "verse": "8",
    "text": "Східним вітром розбив Ти"
  },
  {
    "id": 730,
    "book": "psalms                                  ",
    "chapter": "47",
    "verse": "9",
    "text": "Про що ми чули раніше,"
  },
  {
    "id": 731,
    "book": "psalms                                  ",
    "chapter": "47",
    "verse": "10",
    "text": "Ми роздумували, Боже, про милість Твою"
  },
  {
    "id": 732,
    "book": "psalms                                  ",
    "chapter": "47",
    "verse": "11",
    "text": "Як ім’я Твоє, Боже, так і хвала Твоя –"
  },
  {
    "id": 733,
    "book": "psalms                                  ",
    "chapter": "47",
    "verse": "12",
    "text": "Радіє гора Сіон,"
  },
  {
    "id": 734,
    "book": "psalms                                  ",
    "chapter": "47",
    "verse": "13",
    "text": "Обійдіть навколо Сіон,"
  },
  {
    "id": 735,
    "book": "psalms                                  ",
    "chapter": "47",
    "verse": "14",
    "text": "уважно розгляньте його укріплення,"
  },
  {
    "id": 736,
    "book": "psalms                                  ",
    "chapter": "47",
    "verse": "15",
    "text": "Адже це – Бог, наш Бог на віки вічні!"
  }
]
