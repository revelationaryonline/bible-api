[
  {
    "id": 1731,
    "book": "psalms                                  ",
    "chapter": "104",
    "verse": "1",
    "text": "Славте Господа, кличте ім’я Його;"
  },
  {
    "id": 1732,
    "book": "psalms                                  ",
    "chapter": "104",
    "verse": "2",
    "text": "Співайте Йому, грайте для Нього,"
  },
  {
    "id": 1733,
    "book": "psalms                                  ",
    "chapter": "104",
    "verse": "3",
    "text": "хваліться іменем Його святим!"
  },
  {
    "id": 1734,
    "book": "psalms                                  ",
    "chapter": "104",
    "verse": "4",
    "text": "Прагніть Господа й сили Його,"
  },
  {
    "id": 1735,
    "book": "psalms                                  ",
    "chapter": "104",
    "verse": "5",
    "text": "Пам’ятайте про чудеса Його, які Він здійснив,"
  },
  {
    "id": 1736,
    "book": "psalms                                  ",
    "chapter": "104",
    "verse": "6",
    "text": "О нащадки Авраама, слуги Його,"
  },
  {
    "id": 1737,
    "book": "psalms                                  ",
    "chapter": "104",
    "verse": "7",
    "text": "Він – Господь, Бог наш;"
  },
  {
    "id": 1738,
    "book": "psalms                                  ",
    "chapter": "104",
    "verse": "8",
    "text": "Він вічно пам’ятає Завіт Свій,"
  },
  {
    "id": 1739,
    "book": "psalms                                  ",
    "chapter": "104",
    "verse": "9",
    "text": "Завіт, який Він уклав з Авраамом,"
  },
  {
    "id": 1740,
    "book": "psalms                                  ",
    "chapter": "104",
    "verse": "10",
    "text": "Він встановив його статутом для Якова,"
  },
  {
    "id": 1741,
    "book": "psalms                                  ",
    "chapter": "104",
    "verse": "11",
    "text": "кажучи: «Тобі віддам Я землю Ханаану"
  },
  {
    "id": 1742,
    "book": "psalms                                  ",
    "chapter": "104",
    "verse": "12",
    "text": "Коли вони були людом нечисленним,"
  },
  {
    "id": 1743,
    "book": "psalms                                  ",
    "chapter": "104",
    "verse": "13",
    "text": "то мандрували вони від народу до народу,"
  },
  {
    "id": 1744,
    "book": "psalms                                  ",
    "chapter": "104",
    "verse": "14",
    "text": "Він не дозволяв нікому їх гнобити"
  },
  {
    "id": 1745,
    "book": "psalms                                  ",
    "chapter": "104",
    "verse": "15",
    "text": "«Не чіпайте помазанців Моїх"
  },
  {
    "id": 1746,
    "book": "psalms                                  ",
    "chapter": "104",
    "verse": "16",
    "text": "Він накликав голод на землю,"
  },
  {
    "id": 1747,
    "book": "psalms                                  ",
    "chapter": "104",
    "verse": "17",
    "text": "Послав перед ними чоловіка –"
  },
  {
    "id": 1748,
    "book": "psalms                                  ",
    "chapter": "104",
    "verse": "18",
    "text": "Його ноги стисли кайданами,"
  },
  {
    "id": 1749,
    "book": "psalms                                  ",
    "chapter": "104",
    "verse": "19",
    "text": "до того часу, поки не здійснилося сказане Господом,"
  },
  {
    "id": 1750,
    "book": "psalms                                  ",
    "chapter": "104",
    "verse": "20",
    "text": "Послав цар слуг своїх і розв’язав його;"
  },
  {
    "id": 1751,
    "book": "psalms                                  ",
    "chapter": "104",
    "verse": "21",
    "text": "Він поставив його володарем над домом своїм"
  },
  {
    "id": 1752,
    "book": "psalms                                  ",
    "chapter": "104",
    "verse": "22",
    "text": "щоб він князів його міг стримувати104:22 Або: ув’язнити на свій розсуд міг. на свій розсуд"
  },
  {
    "id": 1753,
    "book": "psalms                                  ",
    "chapter": "104",
    "verse": "23",
    "text": "Тоді прийшов Ізраїль до Єгипту,"
  },
  {
    "id": 1754,
    "book": "psalms                                  ",
    "chapter": "104",
    "verse": "24",
    "text": "І дуже розмножив Бог народ Свій"
  },
  {
    "id": 1755,
    "book": "psalms                                  ",
    "chapter": "104",
    "verse": "25",
    "text": "чиї серця Він налаштував, щоб ненавиділи Його народ,"
  },
  {
    "id": 1756,
    "book": "psalms                                  ",
    "chapter": "104",
    "verse": "26",
    "text": "Він послав Мойсея, слугу Свого,"
  },
  {
    "id": 1757,
    "book": "psalms                                  ",
    "chapter": "104",
    "verse": "27",
    "text": "Вони з’явили знамення Його серед них"
  },
  {
    "id": 1758,
    "book": "psalms                                  ",
    "chapter": "104",
    "verse": "28",
    "text": "Він послав морок, і стало темно,"
  },
  {
    "id": 1759,
    "book": "psalms                                  ",
    "chapter": "104",
    "verse": "29",
    "text": "Він перетворив води їхні на кров"
  },
  {
    "id": 1760,
    "book": "psalms                                  ",
    "chapter": "104",
    "verse": "30",
    "text": "Закишіла земля їхня жабами,"
  },
  {
    "id": 1761,
    "book": "psalms                                  ",
    "chapter": "104",
    "verse": "31",
    "text": "Він сказав, і прийшли рої мух,"
  },
  {
    "id": 1762,
    "book": "psalms                                  ",
    "chapter": "104",
    "verse": "32",
    "text": "Він дав їм замість дощу град,"
  },
  {
    "id": 1763,
    "book": "psalms                                  ",
    "chapter": "104",
    "verse": "33",
    "text": "він побив у них виноград та смоковницю,"
  },
  {
    "id": 1764,
    "book": "psalms                                  ",
    "chapter": "104",
    "verse": "34",
    "text": "Сказав Він, і прийшла сарана і гусінь –"
  },
  {
    "id": 1765,
    "book": "psalms                                  ",
    "chapter": "104",
    "verse": "35",
    "text": "І з’їли вони всю траву в землі їхній,"
  },
  {
    "id": 1766,
    "book": "psalms                                  ",
    "chapter": "104",
    "verse": "36",
    "text": "Тоді вразив Він усіх первістків у землі їхній –"
  },
  {
    "id": 1767,
    "book": "psalms                                  ",
    "chapter": "104",
    "verse": "37",
    "text": "І вивів Він ізраїльтян зі сріблом і золотом,"
  },
  {
    "id": 1768,
    "book": "psalms                                  ",
    "chapter": "104",
    "verse": "38",
    "text": "Зрадів Єгипет, коли вони вийшли,"
  },
  {
    "id": 1769,
    "book": "psalms                                  ",
    "chapter": "104",
    "verse": "39",
    "text": "Розгорнув Бог хмару, як покривало, вдень,"
  },
  {
    "id": 1770,
    "book": "psalms                                  ",
    "chapter": "104",
    "verse": "40",
    "text": "Просив народ, і послав їм Господь перепілок"
  },
  {
    "id": 1771,
    "book": "psalms                                  ",
    "chapter": "104",
    "verse": "41",
    "text": "Відкрив Він скелю – і полилися води,"
  },
  {
    "id": 1772,
    "book": "psalms                                  ",
    "chapter": "104",
    "verse": "42",
    "text": "Бо згадав Він слово Своє святе,"
  },
  {
    "id": 1773,
    "book": "psalms                                  ",
    "chapter": "104",
    "verse": "43",
    "text": "І вивів Він народ Свій у радості,"
  },
  {
    "id": 1774,
    "book": "psalms                                  ",
    "chapter": "104",
    "verse": "44",
    "text": "Він дав їм землі народів,"
  },
  {
    "id": 1775,
    "book": "psalms                                  ",
    "chapter": "104",
    "verse": "45",
    "text": "щоб вони дотримувалися Його постанов"
  }
]
