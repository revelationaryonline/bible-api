[
  {
    "id": 867,
    "book": "psalms                                  ",
    "chapter": "56",
    "verse": "1",
    "text": "Керівнику хору. На мотив «Не згуби». Міхтам56:1 Див. Пс. 51:1. Давидів, коли він втік від Саула в печеру.56:1 Див. 1 Сам. 22:1-2; 24."
  },
  {
    "id": 868,
    "book": "psalms                                  ",
    "chapter": "56",
    "verse": "2",
    "text": "Помилуй мене, Боже, помилуй мене!"
  },
  {
    "id": 869,
    "book": "psalms                                  ",
    "chapter": "56",
    "verse": "3",
    "text": "Я кличу до Бога Всевишнього,"
  },
  {
    "id": 870,
    "book": "psalms                                  ",
    "chapter": "56",
    "verse": "4",
    "text": "Він пошле з небес і врятує мене,"
  },
  {
    "id": 871,
    "book": "psalms                                  ",
    "chapter": "56",
    "verse": "5",
    "text": "Душа моя – посеред левів;"
  },
  {
    "id": 872,
    "book": "psalms                                  ",
    "chapter": "56",
    "verse": "6",
    "text": "Піднімися понад небесами, Боже;"
  },
  {
    "id": 873,
    "book": "psalms                                  ",
    "chapter": "56",
    "verse": "7",
    "text": "Вони розкинули тенета стопам моїм;"
  },
  {
    "id": 874,
    "book": "psalms                                  ",
    "chapter": "56",
    "verse": "8",
    "text": "Серце моє непохитне, Боже, непохитне серце моє!"
  },
  {
    "id": 875,
    "book": "psalms                                  ",
    "chapter": "56",
    "verse": "9",
    "text": "Прокинься, славо моя!"
  },
  {
    "id": 876,
    "book": "psalms                                  ",
    "chapter": "56",
    "verse": "10",
    "text": "Прославлю Тебе серед народів, Владико,"
  },
  {
    "id": 877,
    "book": "psalms                                  ",
    "chapter": "56",
    "verse": "11",
    "text": "Бо велика аж до небес милість Твоя"
  },
  {
    "id": 878,
    "book": "psalms                                  ",
    "chapter": "56",
    "verse": "12",
    "text": "Піднімися понад небесами, Боже;"
  }
]
