[
  {
    "id": 4408,
    "book": "luke                                    ",
    "chapter": "3",
    "verse": "1",
    "text": "П’ятнадцятого року царювання Кесаря Тиберія, коли Понтій Пилат правив Юдеєю, Ірод був тетрархом Галілеї, його брат, Филип, був тетрархом земель Трахонії та Ітуреї, а Лісаній був тетрархом Авілінії,"
  },
  {
    "id": 4409,
    "book": "luke                                    ",
    "chapter": "3",
    "verse": "2",
    "text": "коли первосвященниками були Анна та Каяфа, було Слово Боже до Івана, сина Захарії, у пустелі."
  },
  {
    "id": 4410,
    "book": "luke                                    ",
    "chapter": "3",
    "verse": "3",
    "text": "Іван пройшов усю околицю Йордану й проповідував хрещення покаяння для прощення гріхів,"
  },
  {
    "id": 4411,
    "book": "luke                                    ",
    "chapter": "3",
    "verse": "4",
    "text": "як написано в книзі слів пророка Ісаї:"
  },
  {
    "id": 4412,
    "book": "luke                                    ",
    "chapter": "3",
    "verse": "5",
    "text": "Нехай кожен яр наповниться"
  },
  {
    "id": 4413,
    "book": "luke                                    ",
    "chapter": "3",
    "verse": "6",
    "text": "і всі люди побачать спасіння Боже“».3:6 Див. Іс. 40:3-5."
  },
  {
    "id": 4414,
    "book": "luke                                    ",
    "chapter": "3",
    "verse": "7",
    "text": "Іван казав так народові, що приходив хреститися в нього:"
  },
  {
    "id": 4415,
    "book": "luke                                    ",
    "chapter": "3",
    "verse": "8",
    "text": "Чиніть же плоди, достойні покаяння, і не думайте говорити в собі: «Наш батько – Авраам!» Бо кажу вам: Бог може з цього каміння створити дітей для Авраама!"
  },
  {
    "id": 4416,
    "book": "luke                                    ",
    "chapter": "3",
    "verse": "9",
    "text": "Уже й сокира лежить біля коріння дерев! Кожне дерево, яке не приносить доброго плоду, зрубають та вкидають у вогонь."
  },
  {
    "id": 4417,
    "book": "luke                                    ",
    "chapter": "3",
    "verse": "10",
    "text": "Люди питали його:"
  },
  {
    "id": 4418,
    "book": "luke                                    ",
    "chapter": "3",
    "verse": "11",
    "text": "У відповідь він казав:"
  },
  {
    "id": 4419,
    "book": "luke                                    ",
    "chapter": "3",
    "verse": "12",
    "text": "Прийшли й митники хреститися та спитали його:"
  },
  {
    "id": 4420,
    "book": "luke                                    ",
    "chapter": "3",
    "verse": "13",
    "text": "Він відповів:"
  },
  {
    "id": 4421,
    "book": "luke                                    ",
    "chapter": "3",
    "verse": "14",
    "text": "Воїни теж спитали його:"
  },
  {
    "id": 4422,
    "book": "luke                                    ",
    "chapter": "3",
    "verse": "15",
    "text": "Народ був в очікуванні, усі розмірковували у своїх серцях про Івана, чи не він Христос."
  },
  {
    "id": 4423,
    "book": "luke                                    ",
    "chapter": "3",
    "verse": "16",
    "text": "Іван, відповідаючи всім, сказав:"
  },
  {
    "id": 4424,
    "book": "luke                                    ",
    "chapter": "3",
    "verse": "17",
    "text": "У Його руці лопата, Він ретельно очистить Свій тік, збиратиме Свою пшеницю до житниці, а полову спалить у невгасимому вогні."
  },
  {
    "id": 4425,
    "book": "luke                                    ",
    "chapter": "3",
    "verse": "18",
    "text": "І багато іншого казав він, звіщаючи Добру Звістку народу."
  },
  {
    "id": 4426,
    "book": "luke                                    ",
    "chapter": "3",
    "verse": "19",
    "text": "Але коли він почав осуджувати тетрарха Ірода за Іродіаду, дружину його брата, а також за все зло, що він зробив,"
  },
  {
    "id": 4427,
    "book": "luke                                    ",
    "chapter": "3",
    "verse": "20",
    "text": "то Ірод до всього додав ще й те, що замкнув Івана до в’язниці."
  },
  {
    "id": 4428,
    "book": "luke                                    ",
    "chapter": "3",
    "verse": "21",
    "text": "І сталося, коли хрестився весь народ, і Ісус, охрестившись, молився, розкрилися небеса."
  },
  {
    "id": 4429,
    "book": "luke                                    ",
    "chapter": "3",
    "verse": "22",
    "text": "І Дух Святий зійшов на Нього в тілесному вигляді, як голуб, і голос із неба пролунав: «Ти Син Мій улюблений, Тебе Я вподобав!»3:22 Див. Пс. 2:7 та Іс. 42:1."
  },
  {
    "id": 4430,
    "book": "luke                                    ",
    "chapter": "3",
    "verse": "23",
    "text": "Ісус, починаючи служіння, був років тридцяти, і всі вважали Його сином Йосифа,"
  },
  {
    "id": 4431,
    "book": "luke                                    ",
    "chapter": "3",
    "verse": "24",
    "text": "сина Матата,"
  },
  {
    "id": 4432,
    "book": "luke                                    ",
    "chapter": "3",
    "verse": "25",
    "text": "сина Мататії, сина Амоса,"
  },
  {
    "id": 4433,
    "book": "luke                                    ",
    "chapter": "3",
    "verse": "26",
    "text": "сина Маата,"
  },
  {
    "id": 4434,
    "book": "luke                                    ",
    "chapter": "3",
    "verse": "27",
    "text": "сина Іоана, сина Риса,"
  },
  {
    "id": 4435,
    "book": "luke                                    ",
    "chapter": "3",
    "verse": "28",
    "text": "сина Мелхія,"
  },
  {
    "id": 4436,
    "book": "luke                                    ",
    "chapter": "3",
    "verse": "29",
    "text": "сина Ісуса, сина Еліезера,"
  },
  {
    "id": 4437,
    "book": "luke                                    ",
    "chapter": "3",
    "verse": "30",
    "text": "сина Симеона,"
  },
  {
    "id": 4438,
    "book": "luke                                    ",
    "chapter": "3",
    "verse": "31",
    "text": "сина Мелея, сина Менна,"
  },
  {
    "id": 4439,
    "book": "luke                                    ",
    "chapter": "3",
    "verse": "32",
    "text": "сина Єссея,"
  },
  {
    "id": 4440,
    "book": "luke                                    ",
    "chapter": "3",
    "verse": "33",
    "text": "сина Аммінадава,3:33 Деякі ранні рукописи містять слова: син Рама. сина Адміна,"
  },
  {
    "id": 4441,
    "book": "luke                                    ",
    "chapter": "3",
    "verse": "34",
    "text": "сина Якова, сина Ісаака,"
  },
  {
    "id": 4442,
    "book": "luke                                    ",
    "chapter": "3",
    "verse": "35",
    "text": "сина Серуха,"
  },
  {
    "id": 4443,
    "book": "luke                                    ",
    "chapter": "3",
    "verse": "36",
    "text": "сина Каїнама, сина Арфахада,"
  },
  {
    "id": 4444,
    "book": "luke                                    ",
    "chapter": "3",
    "verse": "37",
    "text": "сина Метусали,"
  },
  {
    "id": 4445,
