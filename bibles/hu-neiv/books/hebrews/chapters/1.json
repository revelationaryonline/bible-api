[
  {
    "id": 7655,
    "book": "hebrews                                 ",
    "chapter": "1",
    "verse": "1",
    "text": "Miután Isten régen sokszor és sokféleképpen szólt az atyáknak a próféták által, ez utolsó időkben szólott nekünk Fia által,"
  },
  {
    "id": 7656,
    "book": "hebrews                                 ",
    "chapter": "1",
    "verse": "2",
    "text": "akit mindennek örökösévé tett, aki által a világot is teremtette,"
  },
  {
    "id": 7657,
    "book": "hebrews                                 ",
    "chapter": "1",
    "verse": "3",
    "text": "aki az ő dicsőségének visszatükröződése, és az ő valóságának képmása, aki hatalma szavával fenntartja a mindenséget, aki minket bűneinktől megtisztított, a mennyei Felségnek jobbjára ült,"
  },
  {
    "id": 7658,
    "book": "hebrews                                 ",
    "chapter": "1",
    "verse": "4",
    "text": "annyival kiválóbb lévén az angyaloknál, amennyivel különb nevet örökölt azoknál."
  },
  {
    "id": 7659,
    "book": "hebrews                                 ",
    "chapter": "1",
    "verse": "5",
    "text": "Mert kinek mondta valaha is az angyalok közül:"
  },
  {
    "id": 7660,
    "book": "hebrews                                 ",
    "chapter": "1",
    "verse": "6",
    "text": "Amikor pedig behozza az ő elsőszülöttét a világba, így szól:"
  },
  {
    "id": 7661,
    "book": "hebrews                                 ",
    "chapter": "1",
    "verse": "7",
    "text": "Az angyalokról így szól:"
  },
  {
    "id": 7662,
    "book": "hebrews                                 ",
    "chapter": "1",
    "verse": "8",
    "text": "Ámde a Fiúról így:"
  },
  {
    "id": 7663,
    "book": "hebrews                                 ",
    "chapter": "1",
    "verse": "9",
    "text": "Szeretted az igazságot és gyűlölted a hamisságot, ezért felkent"
  },
  {
    "id": 7664,
    "book": "hebrews                                 ",
    "chapter": "1",
    "verse": "10",
    "text": "Uram, te kezdetben alapítottad a földet"
  },
  {
    "id": 7665,
    "book": "hebrews                                 ",
    "chapter": "1",
    "verse": "11",
    "text": "Azok elvesznek, de te megmaradsz,"
  },
  {
    "id": 7666,
    "book": "hebrews                                 ",
    "chapter": "1",
    "verse": "12",
    "text": "palásként összehajtod azokat,"
  },
  {
    "id": 7667,
    "book": "hebrews                                 ",
    "chapter": "1",
    "verse": "13",
    "text": "Melyik angyalnak mondta:"
  },
  {
    "id": 7668,
    "book": "hebrews                                 ",
    "chapter": "1",
    "verse": "14",
    "text": "Vajon ezek nem szolgáló lelkek-e mind, akik azokért küldettek szolgálatra, akik örökölni fogják az üdvösséget?"
  }
]