[
  {
    "id": 27778,
    "book": "isaiah                                  ",
    "chapter": "10",
    "verse": "1",
    "text": "Khốn cho những người làm luật bất công"
  },
  {
    "id": 27779,
    "book": "isaiah                                  ",
    "chapter": "10",
    "verse": "2",
    "text": "Họ tước đoạt công bằng của người nghèo,"
  },
  {
    "id": 27780,
    "book": "isaiah                                  ",
    "chapter": "10",
    "verse": "3",
    "text": "Các ngươi sẽ làm gì trong ngày Ta hình phạt,"
  },
  {
    "id": 27781,
    "book": "isaiah                                  ",
    "chapter": "10",
    "verse": "4",
    "text": "Các ngươi sẽ lom khom trong hàng tù nhân"
  },
  {
    "id": 27782,
    "book": "isaiah                                  ",
    "chapter": "10",
    "verse": "5",
    "text": "“Khốn cho A-sy-ri là cây roi của cơn giận Ta."
  },
  {
    "id": 27783,
    "book": "isaiah                                  ",
    "chapter": "10",
    "verse": "6",
    "text": "Ta sẽ sai A-sy-ri hình phạt nước vô đạo,"
  },
  {
    "id": 27784,
    "book": "isaiah                                  ",
    "chapter": "10",
    "verse": "7",
    "text": "Tuy nhiên, vua A-sy-ri sẽ không hiểu nó là dụng cụ của Ta;"
  },
  {
    "id": 27785,
    "book": "isaiah                                  ",
    "chapter": "10",
    "verse": "8",
    "text": "Nó sẽ nói:"
  },
  {
    "id": 27786,
    "book": "isaiah                                  ",
    "chapter": "10",
    "verse": "9",
    "text": "Chúng ta sẽ tiêu diệt Canh-nô như Cát-kê-mít."
  },
  {
    "id": 27787,
    "book": "isaiah                                  ",
    "chapter": "10",
    "verse": "10",
    "text": "Phải, chúng ta đã chiến thắng nhiều quốc gia,"
  },
  {
    "id": 27788,
    "book": "isaiah                                  ",
    "chapter": "10",
    "verse": "11",
    "text": "Vì thế, chúng ta sẽ đánh bại Giê-ru-sa-lem và thần tượng của nó,"
  },
  {
    "id": 27789,
    "book": "isaiah                                  ",
    "chapter": "10",
    "verse": "12",
    "text": "Sau khi Chúa dùng vua A-sy-ri để hoàn tất ý định của Ngài trên Núi Si-ôn và Giê-ru-sa-lem, Chúa sẽ trở lại chống nghịch vua A-sy-ri và hình phạt vua—vì vua đã kiêu căng và ngạo mạn."
  },
  {
    "id": 27790,
    "book": "isaiah                                  ",
    "chapter": "10",
    "verse": "13",
    "text": "Vua ấy đã khoác lác:"
  },
  {
    "id": 27791,
    "book": "isaiah                                  ",
    "chapter": "10",
    "verse": "14",
    "text": "Tay ta đã chiếm châu báu của chúng"
  },
  {
    "id": 27792,
    "book": "isaiah                                  ",
    "chapter": "10",
    "verse": "15",
    "text": "Nhưng cây rìu có thể khoác lác hơn người cầm rìu chăng?"
  },
  {
    "id": 27793,
    "book": "isaiah                                  ",
    "chapter": "10",
    "verse": "16",
    "text": "Vì thế, Chúa là Chúa Hằng Hữu Vạn Quân,"
  },
  {
    "id": 27794,
    "book": "isaiah                                  ",
    "chapter": "10",
    "verse": "17",
    "text": "Chúa, Nguồn Sáng của Ít-ra-ên, sẽ là lửa;"
  },
  {
    "id": 27795,
    "book": "isaiah                                  ",
    "chapter": "10",
    "verse": "18",
    "text": "Chúa Hằng Hữu sẽ hủy diệt vinh quang của A-sy-ri"
  },
  {
    "id": 27796,
    "book": "isaiah                                  ",
    "chapter": "10",
    "verse": "19",
    "text": "Tất cả vinh quang của rừng rậm,"
  },
  {
    "id": 27797,
    "book": "isaiah                                  ",
    "chapter": "10",
    "verse": "20",
    "text": "Trong ngày ấy, những người còn lại trong Ít-ra-ên,"
  },
  {
    "id": 27798,
    "book": "isaiah                                  ",
    "chapter": "10",
    "verse": "21",
    "text": "Đoàn dân sống sót sẽ trở lại;"
  },
  {
    "id": 27799,
    "book": "isaiah                                  ",
    "chapter": "10",
    "verse": "22",
    "text": "Nhưng dù người Ít-ra-ên đông như cát bờ biển,"
  },
  {
    "id": 27800,
    "book": "isaiah                                  ",
    "chapter": "10",
    "verse": "23",
    "text": "Phải, Chúa là Chúa Hằng Hữu Vạn Quân,"
  },
  {
    "id": 27801,
    "book": "isaiah                                  ",
    "chapter": "10",
    "verse": "24",
    "text": "Vì thế, đây là điều Chúa Hằng Hữu Vạn Quân phán: “Hỡi dân Ta tại Si-ôn, đừng sợ quân đội A-sy-ri khi chúng áp bức các con bằng roi và gậy như người Ai Cập ngày xưa."
  },
  {
    "id": 27802,
    "book": "isaiah                                  ",
    "chapter": "10",
    "verse": "25",
    "text": "Chỉ một thời gian ngắn, cơn giận Ta trên các con sẽ chấm dứt, và cơn thịnh nộ Ta sẽ nổi lên để hủy diệt chúng.”"
  },
  {
    "id": 27803,
    "book": "isaiah                                  ",
    "chapter": "10",
    "verse": "26",
    "text": "Chúa Hằng Hữu Vạn Quân sẽ đưa roi đánh chúng như Ngài đã đánh quân Ma-đi-an tại tảng đá Hô-rếp, và như Ngài đã đưa gậy lên để chôn vùi quân Ai Cập dưới lòng biển."
  },
  {
    "id": 27804,
    "book": "isaiah                                  ",
    "chapter": "10",
    "verse": "27",
    "text": "Trong ngày ấy, Chúa Hằng Hữu sẽ xức dầu cho dân Ngài,"
  },
  {
    "id": 27805,
    "book": "isaiah                                  ",
    "chapter": "10",
    "verse": "28",
    "text": "Kìa, quân đội A-sy-ri đã chiếm đóng Ai-gia."
  },
  {
    "id": 27806,
    "book": "isaiah                                  ",
    "chapter": "10",
    "verse": "29",
    "text": "Chúng vượt qua đèo"
  },
  {
    "id": 27807,
    "book": "isaiah                                  ",
    "chapter": "10",
    "verse": "30",
    "text": "Người Ga-lim hãy thét lên!"
  },
  {
    "id": 27808,
    "book": "isaiah                                  ",
    "chapter": "10",
    "verse": "31",
    "text": "Dân thành Mát-mê-na chạy trốn."
  },
  {
    "id": 27809,
    "book": "isaiah                                  ",
    "chapter": "10",
    "verse": "32",
    "text": "Nhưng ngày ấy chúng dừng tại Nóp."
  },
  {
    "id": 27810,
    "book": "isaiah                                  ",
    "chapter": "10",
    "verse": "33",
    "text": "Nhưng kìa! Chúa là Chúa Hằng Hữu Vạn Quân,"
  },
  {
    "id": 27811,
    "book": "isaiah                                  ",
    "chapter": "10",
    "verse": "34",
    "text": "Chúa sẽ dùng rìu đốn rừng rậm,"
  }
]