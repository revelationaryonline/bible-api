[
  {
    "id": 28145,
    "book": "isaiah                                  ",
    "chapter": "30",
    "verse": "1",
    "text": "Chúa Hằng Hữu phán: “Khốn cho con cái bội nghịch của Ta."
  },
  {
    "id": 28146,
    "book": "isaiah                                  ",
    "chapter": "30",
    "verse": "2",
    "text": "Vì không hỏi ý Ta,"
  },
  {
    "id": 28147,
    "book": "isaiah                                  ",
    "chapter": "30",
    "verse": "3",
    "text": "Nhưng bởi tin cậy Pha-ra-ôn, các ngươi sẽ bị sỉ nhục,"
  },
  {
    "id": 28148,
    "book": "isaiah                                  ",
    "chapter": "30",
    "verse": "4",
    "text": "Cho dù quyền lực hắn bao trùm tận Xô-an"
  },
  {
    "id": 28149,
    "book": "isaiah                                  ",
    "chapter": "30",
    "verse": "5",
    "text": "tất cả những ai tin cậy hắn sẽ bị xấu hổ."
  },
  {
    "id": 28150,
    "book": "isaiah                                  ",
    "chapter": "30",
    "verse": "6",
    "text": "Đây là lời tiên tri về loài thú tại Nê-ghép:"
  },
  {
    "id": 28151,
    "book": "isaiah                                  ",
    "chapter": "30",
    "verse": "7",
    "text": "Lời hứa của Ai Cập hoàn toàn vô ích!"
  },
  {
    "id": 28152,
    "book": "isaiah                                  ",
    "chapter": "30",
    "verse": "8",
    "text": "Bây giờ hãy đi và ghi lại những lời này."
  },
  {
    "id": 28153,
    "book": "isaiah                                  ",
    "chapter": "30",
    "verse": "9",
    "text": "rằng dân này là một dân tộc nổi loạn,"
  },
  {
    "id": 28154,
    "book": "isaiah                                  ",
    "chapter": "30",
    "verse": "10",
    "text": "Chúng nói với những người tiên kiến rằng:"
  },
  {
    "id": 28155,
    "book": "isaiah                                  ",
    "chapter": "30",
    "verse": "11",
    "text": "Hãy quên tất cả sầu khổ này."
  },
  {
    "id": 28156,
    "book": "isaiah                                  ",
    "chapter": "30",
    "verse": "12",
    "text": "Đây là lời Đấng Thánh của Ít-ra-ên dạy:"
  },
  {
    "id": 28157,
    "book": "isaiah                                  ",
    "chapter": "30",
    "verse": "13",
    "text": "nên thảm họa sẽ giáng trên người thình lình"
  },
  {
    "id": 28158,
    "book": "isaiah                                  ",
    "chapter": "30",
    "verse": "14",
    "text": "Các ngươi sẽ vỡ ra từng mảnh như đồ gốm bị đập—"
  },
  {
    "id": 28159,
    "book": "isaiah                                  ",
    "chapter": "30",
    "verse": "15",
    "text": "Đây là lời Chúa Hằng Hữu Chí Cao,"
  },
  {
    "id": 28160,
    "book": "isaiah                                  ",
    "chapter": "30",
    "verse": "16",
    "text": "Các ngươi nói: ‘Không, chúng tôi sẽ nhờ Ai Cập giúp đỡ."
  },
  {
    "id": 28161,
    "book": "isaiah                                  ",
    "chapter": "30",
    "verse": "17",
    "text": "Một người trong chúng sẽ đuổi theo nghìn người trong các ngươi."
  },
  {
    "id": 28162,
    "book": "isaiah                                  ",
    "chapter": "30",
    "verse": "18",
    "text": "Chúa Hằng Hữu vẫn chờ đợi các ngươi đến với Ngài"
  },
  {
    "id": 28163,
    "book": "isaiah                                  ",
    "chapter": "30",
    "verse": "19",
    "text": "Hỡi cư dân Si-ôn, là những người sống tại Giê-ru-sa-lem,"
  },
  {
    "id": 28164,
    "book": "isaiah                                  ",
    "chapter": "30",
    "verse": "20",
    "text": "Dù Chúa cho các ngươi ăn bánh bất hạnh"
  },
  {
    "id": 28165,
    "book": "isaiah                                  ",
    "chapter": "30",
    "verse": "21",
    "text": "Tai các ngươi sẽ nghe tiếng Ngài."
  },
  {
    "id": 28166,
    "book": "isaiah                                  ",
    "chapter": "30",
    "verse": "22",
    "text": "Rồi các ngươi sẽ tiêu hủy tất cả tượng thần bằng bạc"
  },
  {
    "id": 28167,
    "book": "isaiah                                  ",
    "chapter": "30",
    "verse": "23",
    "text": "Lúc ấy, Chúa Hằng Hữu sẽ ban mưa trên hạt giống các ngươi gieo. Các ngươi sẽ thu được rất nhiều hoa lợi và đồng cỏ các ngươi sẽ đầy những gia súc."
  },
  {
    "id": 28168,
    "book": "isaiah                                  ",
    "chapter": "30",
    "verse": "24",
    "text": "Bò và lừa kéo cày sẽ được ăn lúa tốt, còn trấu thóc bị gió thổi bay đi."
  },
  {
    "id": 28169,
    "book": "isaiah                                  ",
    "chapter": "30",
    "verse": "25",
    "text": "Trong ngày ấy, khi kẻ thù ngươi bị tàn sát và các tháp canh đổ xuống, thì những suối nước sẽ chảy trên mỗi núi cao, đồi cả."
  },
  {
    "id": 28170,
    "book": "isaiah                                  ",
    "chapter": "30",
    "verse": "26",
    "text": "Mặt trăng sẽ sáng như mặt trời, và mặt trời sẽ sáng gấp bảy lần—như ánh sáng của bảy ngày gộp lại! Đó là ngày Chúa chữa lành dân Ngài và buộc các vết thương Ngài đã gây cho họ."
  },
  {
    "id": 28171,
    "book": "isaiah                                  ",
    "chapter": "30",
    "verse": "27",
    "text": "Kìa! Chúa Hằng Hữu từ xa ngự đến"
  },
  {
    "id": 28172,
    "book": "isaiah                                  ",
    "chapter": "30",
    "verse": "28",
    "text": "Hơi thở nóng của Chúa như nước lụt"
  },
  {
    "id": 28173,
    "book": "isaiah                                  ",
    "chapter": "30",
    "verse": "29",
    "text": "Nhưng dân Chúa sẽ hát một bài ca vui mừng"
  },
  {
    "id": 28174,
    "book": "isaiah                                  ",
    "chapter": "30",
    "verse": "30",
    "text": "Chúa Hằng Hữu sẽ cất lên tiếng nói uy nghiêm của Ngài."
  },
  {
    "id": 28175,
    "book": "isaiah                                  ",
    "chapter": "30",
    "verse": "31",
    "text": "Nghe mệnh lệnh của Chúa Hằng Hữu, A-sy-ri sẽ tiêu tan."
  },
  {
    "id": 28176,
    "book": "isaiah                                  ",
    "chapter": "30",
    "verse": "32",
    "text": "Và như khi Chúa Hằng Hữu hình phạt chúng với cây gậy của Ngài,"
  },
  {
    "id": 28177,
    "book": "isaiah                                  ",
    "chapter": "30",
    "verse": "33",
    "text": "Tô-phết—là nơi thiêu đốt—"
  }
]