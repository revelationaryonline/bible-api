[
  {
    "id": 28542,
    "book": "isaiah                                  ",
    "chapter": "48",
    "verse": "1",
    "text": "“Hãy nghe Ta, hỡi nhà Gia-cốp,"
  },
  {
    "id": 28543,
    "book": "isaiah                                  ",
    "chapter": "48",
    "verse": "2",
    "text": "dù các con mang tên thành thánh"
  },
  {
    "id": 28544,
    "book": "isaiah                                  ",
    "chapter": "48",
    "verse": "3",
    "text": "Từ lâu Ta đã báo cho các ngươi những việc sẽ xảy ra."
  },
  {
    "id": 28545,
    "book": "isaiah                                  ",
    "chapter": "48",
    "verse": "4",
    "text": "Vì Ta biết các con cứng đầu và ngoan cố."
  },
  {
    "id": 28546,
    "book": "isaiah                                  ",
    "chapter": "48",
    "verse": "5",
    "text": "Đó là tại sao Ta đã bảo các con những việc sẽ xảy ra;"
  },
  {
    "id": 28547,
    "book": "isaiah                                  ",
    "chapter": "48",
    "verse": "6",
    "text": "Các con đã nghe Ta báo trước và đã thấy lời Ta ứng nghiệm,"
  },
  {
    "id": 28548,
    "book": "isaiah                                  ",
    "chapter": "48",
    "verse": "7",
    "text": "Những việc hoàn toàn mới, không phải từ thời xưa."
  },
  {
    "id": 28549,
    "book": "isaiah                                  ",
    "chapter": "48",
    "verse": "8",
    "text": "Phải, Ta sẽ cho các con biết những việc mới hoàn toàn,"
  },
  {
    "id": 28550,
    "book": "isaiah                                  ",
    "chapter": "48",
    "verse": "9",
    "text": "Tuy nhiên, vì mục đích và vì Danh cao trọng của Ta,"
  },
  {
    "id": 28551,
    "book": "isaiah                                  ",
    "chapter": "48",
    "verse": "10",
    "text": "Này, Ta thanh luyện con, nhưng không phải như luyện bạc."
  },
  {
    "id": 28552,
    "book": "isaiah                                  ",
    "chapter": "48",
    "verse": "11",
    "text": "Ta sẽ giải cứu con vì chính Ta—"
  },
  {
    "id": 28553,
    "book": "isaiah                                  ",
    "chapter": "48",
    "verse": "12",
    "text": "“Hãy nghe Ta, hỡi nhà Gia-cốp,"
  },
  {
    "id": 28554,
    "book": "isaiah                                  ",
    "chapter": "48",
    "verse": "13",
    "text": "Tay Ta đã đặt nền cho trái đất,"
  },
  {
    "id": 28555,
    "book": "isaiah                                  ",
    "chapter": "48",
    "verse": "14",
    "text": "Có thần nào của các ngươi từng nói việc này?"
  },
  {
    "id": 28556,
    "book": "isaiah                                  ",
    "chapter": "48",
    "verse": "15",
    "text": "“Ta đã báo trước: Chính Ta đã gọi Si-ru!"
  },
  {
    "id": 28557,
    "book": "isaiah                                  ",
    "chapter": "48",
    "verse": "16",
    "text": "Hãy đến gần Ta và nghe điều này."
  },
  {
    "id": 28558,
    "book": "isaiah                                  ",
    "chapter": "48",
    "verse": "17",
    "text": "Đây là điều Chúa Hằng Hữu—"
  },
  {
    "id": 28559,
    "book": "isaiah                                  ",
    "chapter": "48",
    "verse": "18",
    "text": "Ôi, ước gì các con lắng nghe các mệnh lệnh Ta!"
  },
  {
    "id": 28560,
    "book": "isaiah                                  ",
    "chapter": "48",
    "verse": "19",
    "text": "Dòng dõi con sẽ đông như cát bờ biển—"
  },
  {
    "id": 28561,
    "book": "isaiah                                  ",
    "chapter": "48",
    "verse": "20",
    "text": "Dù vậy, giờ đây các ngươi được tự do!"
  },
  {
    "id": 28562,
    "book": "isaiah                                  ",
    "chapter": "48",
    "verse": "21",
    "text": "Dân Chúa không còn khát"
  },
  {
    "id": 28563,
    "book": "isaiah                                  ",
    "chapter": "48",
    "verse": "22",
    "text": "Tuy nhiên, Chúa Hằng Hữu phán:"
  }
]