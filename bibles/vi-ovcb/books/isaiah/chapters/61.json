    "chapter": "61",
    "verse": "1",
    "text": "Thần của Chúa Hằng Hữu Chí Cao ngự trên ta,"
  },
  {
    "id": 28772,
    "book": "isaiah                                  ",
    "chapter": "61",
    "verse": "2",
