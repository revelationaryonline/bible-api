[
  {
    "id": 27911,
    "book": "isaiah                                  ",
    "chapter": "17",
    "verse": "1",
    "text": "Đây là lời tiên tri về Đa-mách:"
  },
  {
    "id": 27912,
    "book": "isaiah                                  ",
    "chapter": "17",
    "verse": "2",
    "text": "Các thành xứ A-rô-e sẽ hoang vắng."
  },
  {
    "id": 27913,
    "book": "isaiah                                  ",
    "chapter": "17",
    "verse": "3",
    "text": "Các đồn lũy của Ít-ra-ên cũng sẽ bị tàn phá,"
  },
  {
    "id": 27914,
    "book": "isaiah                                  ",
    "chapter": "17",
    "verse": "4",
    "text": "“Trong ngày ấy, vinh quang nhà Gia-cốp sẽ lịm dần;"
  },
  {
    "id": 27915,
    "book": "isaiah                                  ",
    "chapter": "17",
    "verse": "5",
    "text": "Cả vùng đất sẽ giống như một đồng lúa"
  },
  {
    "id": 27916,
    "book": "isaiah                                  ",
    "chapter": "17",
    "verse": "6",
    "text": "Chỉ còn vài người sống sót,"
  },
  {
    "id": 27917,
    "book": "isaiah                                  ",
    "chapter": "17",
    "verse": "7",
    "text": "Cuối cùng, chúng sẽ hướng về Đấng Tạo Hóa mình"
  },
  {
    "id": 27918,
    "book": "isaiah                                  ",
    "chapter": "17",
    "verse": "8",
    "text": "Chúng sẽ không còn cầu khẩn trước các tượng thần của chúng,"
  },
  {
    "id": 27919,
    "book": "isaiah                                  ",
    "chapter": "17",
    "verse": "9",
    "text": "Những thành kiên cố của chúng sẽ như rừng hoang,"
  },
  {
    "id": 27920,
    "book": "isaiah                                  ",
    "chapter": "17",
    "verse": "10",
    "text": "Tại sao? Vì ngươi đã quay lưng với Đức Chúa Trời là Đấng đã cứu chuộc ngươi."
  },
  {
    "id": 27921,
    "book": "isaiah                                  ",
    "chapter": "17",
    "verse": "11",
    "text": "Dù cây mọc lên trong ngày ngươi trồng nó;"
  },
  {
    "id": 27922,
    "book": "isaiah                                  ",
    "chapter": "17",
    "verse": "12",
    "text": "Hãy nghe! Tiếng gầm thét của đạo quân các nước"
  },
  {
    "id": 27923,
    "book": "isaiah                                  ",
    "chapter": "17",
    "verse": "13",
    "text": "Dù quân các nước tiến công như vũ bão, như sóng thần,"
  },
  {
    "id": 27924,
    "book": "isaiah                                  ",
    "chapter": "17",
    "verse": "14",
    "text": "Vào buổi tối Ít-ra-ên trông chờ trong khiếp sợ,"
  }
]