    "chapter": "56",
    "verse": "1",
    "text": "Đây là điều Chúa Hằng Hữu phán:"
  },
  {
    "id": 28682,
    "book": "isaiah                                  ",
    "chapter": "56",
    "verse": "2",
    "text": "Phước cho những ai"
  },
  {
    "id": 28683,
    "book": "isaiah                                  ",
    "chapter": "56",
    "verse": "3",
    "text": "“Người nước ngoài đã theo Chúa đừng nói:"
  },
  {
    "id": 28684,
    "book": "isaiah                                  ",
    "chapter": "56",
    "verse": "4",
    "text": "Vì đây là điều Chúa Hằng Hữu phán:"
  },
  {
    "id": 28685,
    "book": "isaiah                                  ",
    "chapter": "56",
    "verse": "5",
    "text": "Ta sẽ dành cho họ—trong các tường thành của nhà Ta—"
  },
  {
    "id": 28686,
    "book": "isaiah                                  ",
    "chapter": "56",
    "verse": "6",
    "text": "Ta cũng sẽ ban phước các dân tộc nước ngoài đã cam kết theo Chúa Hằng Hữu,"
  },
  {
    "id": 28687,
    "book": "isaiah                                  ",
    "chapter": "56",
    "verse": "7",
    "text": "Ta sẽ cho họ được đem lên núi thánh Giê-ru-sa-lem,"
  },
  {
    "id": 28688,
    "book": "isaiah                                  ",
    "chapter": "56",
    "verse": "8",
    "text": "Vì Chúa Hằng Hữu Chí Cao,"
  },
  {
    "id": 28689,
    "book": "isaiah                                  ",
    "chapter": "56",
    "verse": "9",
    "text": "Hãy đến, tất cả thú dữ ngoài đồng!"
  },
  {
    "id": 28690,
    "book": "isaiah                                  ",
    "chapter": "56",
    "verse": "10",
    "text": "Vì các lãnh đạo của dân Ta—"
  },
  {
    "id": 28691,
    "book": "isaiah                                  ",
    "chapter": "56",
    "verse": "11",
    "text": "Như một con chó tham lam, chúng không biết thỏa mãn."
  },
  {
    "id": 28692,
    "book": "isaiah                                  ",
    "chapter": "56",
    "verse": "12",
    "text": "Chúng rủ nhau: “Mời đến đây, uống rượu và dự tiệc."
