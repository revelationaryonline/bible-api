[
  {
    "id": 28187,
    "book": "isaiah                                  ",
    "chapter": "32",
    "verse": "1",
    "text": "Kìa, một vị vua công chính đang đến!"
  },
  {
    "id": 28188,
    "book": "isaiah                                  ",
    "chapter": "32",
    "verse": "2",
    "text": "Mỗi người sẽ như lều núp gió"
  },
  {
    "id": 28189,
    "book": "isaiah                                  ",
    "chapter": "32",
    "verse": "3",
    "text": "Lúc ấy, ai có mắt có thể trông thấy chân lý,"
  },
  {
    "id": 28190,
    "book": "isaiah                                  ",
    "chapter": "32",
    "verse": "4",
    "text": "Ngay cả trí của người khờ dại cũng sẽ hiểu biết."
  },
  {
    "id": 28191,
    "book": "isaiah                                  ",
    "chapter": "32",
    "verse": "5",
    "text": "Trong ngày ấy, người ngu dại bất tín không được coi là cao quý."
  },
  {
    "id": 28192,
    "book": "isaiah                                  ",
    "chapter": "32",
    "verse": "6",
    "text": "Vì người dại sẽ nói lời điên dại,"
  },
  {
    "id": 28193,
    "book": "isaiah                                  ",
    "chapter": "32",
    "verse": "7",
    "text": "Mánh khóe của bọn lừa đảo thật thâm độc."
  },
  {
    "id": 28194,
    "book": "isaiah                                  ",
    "chapter": "32",
    "verse": "8",
    "text": "Nhưng những người cao thượng hoạch định những việc cao thượng,"
  },
  {
    "id": 28195,
    "book": "isaiah                                  ",
    "chapter": "32",
    "verse": "9",
    "text": "Hãy nghe, hỡi những phụ nữ nhàn tản."
  },
  {
    "id": 28196,
    "book": "isaiah                                  ",
    "chapter": "32",
    "verse": "10",
    "text": "Trong thời gian ngắn—chỉ hơn một năm nữa—"
  },
  {
    "id": 28197,
    "book": "isaiah                                  ",
    "chapter": "32",
    "verse": "11",
    "text": "Hãy run sợ, hỡi các phụ nữ nhàn tản, vô tư lự;"
  },
  {
    "id": 28198,
    "book": "isaiah                                  ",
    "chapter": "32",
    "verse": "12",
    "text": "Các ngươi sẽ đấm ngực thương tiếc những trang trại dồi dào"
  },
  {
    "id": 28199,
    "book": "isaiah                                  ",
    "chapter": "32",
    "verse": "13",
    "text": "Vì đất của các ngươi sẽ đầy những gai gốc và bụi rậm."
  },
  {
    "id": 28200,
    "book": "isaiah                                  ",
    "chapter": "32",
    "verse": "14",
    "text": "Các cung điện và thành trì sẽ hoang vu"
  },
  {
    "id": 28201,
    "book": "isaiah                                  ",
    "chapter": "32",
    "verse": "15",
    "text": "cho đến khi Thần Linh từ trời đổ xuống trên chúng ta."
  },
  {
    "id": 28202,
    "book": "isaiah                                  ",
    "chapter": "32",
    "verse": "16",
    "text": "Bấy giờ sự phán xét sẽ cai trị nơi hoang mạc"
  },
  {
    "id": 28203,
    "book": "isaiah                                  ",
    "chapter": "32",
    "verse": "17",
    "text": "Kết quả của sự công chính là sự bình an."
  },
  {
    "id": 28204,
    "book": "isaiah                                  ",
    "chapter": "32",
    "verse": "18",
    "text": "Dân tôi sẽ ở nơi bình an, trong nhà yên tĩnh."
  },
  {
    "id": 28205,
    "book": "isaiah                                  ",
    "chapter": "32",
    "verse": "19",
    "text": "Dù nếu rừng rậm bị tàn phá"
  },
  {
    "id": 28206,
    "book": "isaiah                                  ",
    "chapter": "32",
    "verse": "20",
    "text": "Chúa Hằng Hữu sẽ ban phước lớn cho dân Ngài."
  }
