[
  {
    "id": 28379,
    "book": "isaiah                                  ",
    "chapter": "41",
    "verse": "1",
    "text": "“Hỡi các hải đảo! Hãy im lặng lắng nghe trước mặt Ta."
  },
  {
    "id": 28380,
    "book": "isaiah                                  ",
    "chapter": "41",
    "verse": "2",
    "text": "“Ai đã đánh thức vua từ phương đông,"
  },
  {
    "id": 28381,
    "book": "isaiah                                  ",
    "chapter": "41",
    "verse": "3",
    "text": "Người đánh đuổi chúng và bước đi cách an toàn,"
  },
  {
    "id": 28382,
    "book": "isaiah                                  ",
    "chapter": "41",
    "verse": "4",
    "text": "Ai đã làm những việc vĩ đại đó,"
  },
  {
    "id": 28383,
    "book": "isaiah                                  ",
    "chapter": "41",
    "verse": "5",
    "text": "Các hải đảo đã thấy và khiếp sợ."
  },
  {
    "id": 28384,
    "book": "isaiah                                  ",
    "chapter": "41",
    "verse": "6",
    "text": "Mỗi người giúp người khác can đảm,"
  },
  {
    "id": 28385,
    "book": "isaiah                                  ",
    "chapter": "41",
    "verse": "7",
    "text": "Thợ chạm khuyến khích thợ vàng,"
  },
  {
    "id": 28386,
    "book": "isaiah                                  ",
    "chapter": "41",
    "verse": "8",
    "text": "“Nhưng vì con, Ít-ra-ên đầy tớ Ta,"
  },
  {
    "id": 28387,
    "book": "isaiah                                  ",
    "chapter": "41",
    "verse": "9",
    "text": "Ta đã gọi các con trở lại từ tận cùng mặt đất."
  },
  {
    "id": 28388,
    "book": "isaiah                                  ",
    "chapter": "41",
    "verse": "10",
    "text": "Đừng sợ, vì Ta ở với con."
  },
  {
    "id": 28389,
    "book": "isaiah                                  ",
    "chapter": "41",
    "verse": "11",
    "text": "Kìa, mọi kẻ thách thức con sẽ hổ thẹn,"
  },
  {
    "id": 28390,
    "book": "isaiah                                  ",
    "chapter": "41",
    "verse": "12",
    "text": "Con sẽ tìm chúng là kẻ xâm chiếm con nhưng không thấy."
  },
  {
    "id": 28391,
    "book": "isaiah                                  ",
    "chapter": "41",
    "verse": "13",
    "text": "Vì Ta nắm giữ con trong tay phải Ta—"
  },
  {
    "id": 28392,
    "book": "isaiah                                  ",
    "chapter": "41",
    "verse": "14",
    "text": "Hỡi Gia-cốp, dù con bị xem là sâu bọ,"
  },
  {
    "id": 28393,
    "book": "isaiah                                  ",
    "chapter": "41",
    "verse": "15",
    "text": "Ta làm cho con thành cái bừa mới với răng sắc bén."
  },
  {
    "id": 28394,
    "book": "isaiah                                  ",
    "chapter": "41",
    "verse": "16",
    "text": "Con sẽ tung rải chúng trước gió"
  },
  {
    "id": 28395,
    "book": "isaiah                                  ",
    "chapter": "41",
    "verse": "17",
    "text": "“Khi người nghèo khổ và túng thiếu tìm nước uống không được,"
  },
  {
    "id": 28396,
    "book": "isaiah                                  ",
    "chapter": "41",
    "verse": "18",
    "text": "Ta sẽ mở cho họ các dòng sông trên vùng cao nguyên"
  },
  {
    "id": 28397,
    "book": "isaiah                                  ",
    "chapter": "41",
    "verse": "19",
    "text": "Ta sẽ trồng cây trong sa mạc cằn cỗi—"
  },
  {
    "id": 28398,
    "book": "isaiah                                  ",
    "chapter": "41",
    "verse": "20",
    "text": "Ta làm điều này để tất cả ai thấy phép lạ này"
  },
  {
    "id": 28399,
    "book": "isaiah                                  ",
    "chapter": "41",
    "verse": "21",
    "text": "Chúa Hằng Hữu phán:"
  },
  {
    "id": 28400,
    "book": "isaiah                                  ",
    "chapter": "41",
    "verse": "22",
    "text": "Hãy để cho chúng thuật lại các biến cố trong quá khứ"
  },
  {
    "id": 28401,
    "book": "isaiah                                  ",
    "chapter": "41",
    "verse": "23",
    "text": "Phải, hãy nói với chúng ta việc sẽ xảy ra trong những ngày tới."
  },
  {
    "id": 28402,
    "book": "isaiah                                  ",
    "chapter": "41",
    "verse": "24",
    "text": "Nhưng các ngươi đều vô dụng và công việc các ngươi đều vô ích."
  },
  {
    "id": 28403,
    "book": "isaiah                                  ",
    "chapter": "41",
    "verse": "25",
    "text": "Ta đã dấy lên một lãnh đạo đến từ phương bắc."
  },
  {
    "id": 28404,
    "book": "isaiah                                  ",
    "chapter": "41",
    "verse": "26",
    "text": "Ai đã nói những việc ấy từ ban đầu cho chúng ta biết?"
  },
  {
    "id": 28405,
    "book": "isaiah                                  ",
    "chapter": "41",
    "verse": "27",
    "text": "Chính Ta đã phán trước cùng Si-ôn rằng:"
  },
  {
    "id": 28406,
    "book": "isaiah                                  ",
    "chapter": "41",
    "verse": "28",
    "text": "Không một ai trong các thần của ngươi nói điều này."
  },
  {
    "id": 28407,
    "book": "isaiah                                  ",
    "chapter": "41",
    "verse": "29",
    "text": "Kìa, tất cả chúng đều ngu dại,"
  }
]