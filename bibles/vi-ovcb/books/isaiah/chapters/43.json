[
  {
    "id": 28433,
    "book": "isaiah                                  ",
    "chapter": "43",
    "verse": "1",
    "text": "Nhưng bây giờ, hỡi Gia-cốp, hãy lắng nghe Chúa Hằng Hữu, Đấng tạo dựng con."
  },
  {
    "id": 28434,
    "book": "isaiah                                  ",
    "chapter": "43",
    "verse": "2",
    "text": "Khi con vượt qua dòng nước sâu,"
  },
  {
    "id": 28435,
    "book": "isaiah                                  ",
    "chapter": "43",
    "verse": "3",
    "text": "Vì Ta là Chúa Hằng Hữu, Đức Chúa Trời của con,"
  },
  {
    "id": 28436,
    "book": "isaiah                                  ",
    "chapter": "43",
    "verse": "4",
    "text": "Ta dùng nhiều người đổi lấy con;"
  },
  {
    "id": 28437,
    "book": "isaiah                                  ",
    "chapter": "43",
    "verse": "5",
    "text": "Đừng sợ, vì Ta ở với con."
  },
  {
    "id": 28438,
    "book": "isaiah                                  ",
    "chapter": "43",
    "verse": "6",
    "text": "Ta sẽ bảo phương bắc và phương nam rằng:"
  },
  {
    "id": 28439,
    "book": "isaiah                                  ",
    "chapter": "43",
    "verse": "7",
    "text": "Hãy đưa tất cả ai công bố Ta là Đức Chúa Trời của họ trở về Ít-ra-ên,"
  },
  {
    "id": 28440,
    "book": "isaiah                                  ",
    "chapter": "43",
    "verse": "8",
    "text": "Hãy đem dân này ra, là dân có mắt nhưng mù,"
  },
  {
    "id": 28441,
    "book": "isaiah                                  ",
    "chapter": "43",
    "verse": "9",
    "text": "Hãy triệu tập các nước lại với nhau!"
  },
  {
    "id": 28442,
    "book": "isaiah                                  ",
    "chapter": "43",
    "verse": "10",
    "text": "Chúa Hằng Hữu phán: “Nhưng con là nhân chứng của Ta, hỡi Ít-ra-ên,"
  },
  {
    "id": 28443,
    "book": "isaiah                                  ",
    "chapter": "43",
    "verse": "11",
    "text": "Ta, chính Ta, là Chúa Hằng Hữu,"
  },
  {
    "id": 28444,
    "book": "isaiah                                  ",
    "chapter": "43",
    "verse": "12",
    "text": "Đầu tiên Ta báo trước việc giải thoát con,"
  },
  {
    "id": 28445,
    "book": "isaiah                                  ",
    "chapter": "43",
    "verse": "13",
    "text": "“Thật vậy, từ nghìn xưa, Ta đã là Đức Chúa Trời."
  },
  {
    "id": 28446,
    "book": "isaiah                                  ",
    "chapter": "43",
    "verse": "14",
    "text": "Đây là điều Chúa Hằng Hữu phán—Đấng Cứu Chuộc của con, Đấng Thánh của Ít-ra-ên:"
  },
  {
    "id": 28447,
    "book": "isaiah                                  ",
    "chapter": "43",
    "verse": "15",
    "text": "Ta là Chúa Hằng Hữu, Đấng Thánh của các con,"
  },
  {
    "id": 28448,
    "book": "isaiah                                  ",
    "chapter": "43",
    "verse": "16",
    "text": "Ta là Chúa Hằng Hữu, Đấng mở đường giữa đại dương"
  },
  {
    "id": 28449,
    "book": "isaiah                                  ",
    "chapter": "43",
    "verse": "17",
    "text": "Ta đã gọi đến đội quân Ai Cập"
  },
  {
    "id": 28450,
    "book": "isaiah                                  ",
    "chapter": "43",
    "verse": "18",
    "text": "Đừng nhớ lại quá khứ đen tối!"
  },
  {
    "id": 28451,
    "book": "isaiah                                  ",
    "chapter": "43",
    "verse": "19",
    "text": "Này, Ta sẽ làm một việc mới."
  },
  {
    "id": 28452,
    "book": "isaiah                                  ",
    "chapter": "43",
    "verse": "20",
    "text": "Các dã thú trong đồng sẽ cảm tạ Ta,"
  },
  {
    "id": 28453,
    "book": "isaiah                                  ",
    "chapter": "43",
    "verse": "21",
    "text": "Ta đã tạo nên Ít-ra-ên cho Ta,"
  },
  {
    "id": 28454,
    "book": "isaiah                                  ",
    "chapter": "43",
    "verse": "22",
    "text": "“Nhưng, hỡi nhà Gia-cốp, con không kêu cầu Ta."
  },
  {
    "id": 28455,
    "book": "isaiah                                  ",
    "chapter": "43",
    "verse": "23",
    "text": "Các con không dâng lên Ta chiên và dê làm tế lễ thiêu."
  },
  {
    "id": 28456,
    "book": "isaiah                                  ",
    "chapter": "43",
    "verse": "24",
    "text": "Các con không mang mùi hương cây xương bồ cho Ta,"
  },
  {
    "id": 28457,
    "book": "isaiah                                  ",
    "chapter": "43",
    "verse": "25",
    "text": "Ta—phải, chỉ một mình Ta—sẽ xóa tội lỗi của các con vì chính Ta"
  },
  {
    "id": 28458,
    "book": "isaiah                                  ",
    "chapter": "43",
    "verse": "26",
    "text": "Hãy cùng nhau ôn lại những việc đã qua,"
  },
  {
    "id": 28459,
    "book": "isaiah                                  ",
    "chapter": "43",
    "verse": "27",
    "text": "Từ lúc khởi đầu, tổ phụ các con đều đã phạm tội chống nghịch Ta;"
  },
  {
    "id": 28460,
    "book": "isaiah                                  ",
    "chapter": "43",
    "verse": "28",
    "text": "Đó là tại sao Ta sẽ làm nhục các thầy tế lễ của con;"
  }
]