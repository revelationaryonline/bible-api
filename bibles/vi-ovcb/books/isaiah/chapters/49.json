[
  {
    "id": 28564,
    "book": "isaiah                                  ",
    "chapter": "49",
    "verse": "1",
    "text": "Hãy nghe tôi, hỡi các hải đảo!"
  },
  {
    "id": 28565,
    "book": "isaiah                                  ",
    "chapter": "49",
    "verse": "2",
    "text": "Chúa khiến lời xét xử của tôi như gươm bén."
  },
  {
    "id": 28566,
    "book": "isaiah                                  ",
    "chapter": "49",
    "verse": "3",
    "text": "Chúa phán cùng tôi: “Con là đầy tớ Ta, Ít-ra-ên,"
  },
  {
    "id": 28567,
    "book": "isaiah                                  ",
    "chapter": "49",
    "verse": "4",
    "text": "Tôi thưa: “Nhưng công việc của con thật luống công!"
  },
  {
    "id": 28568,
    "book": "isaiah                                  ",
    "chapter": "49",
    "verse": "5",
    "text": "Bây giờ, Chúa Hằng Hữu phán—"
  },
  {
    "id": 28569,
    "book": "isaiah                                  ",
    "chapter": "49",
    "verse": "6",
    "text": "Chúa phán: “Những việc con làm còn lớn hơn việc đem người Ít-ra-ên về với Ta."
  },
  {
    "id": 28570,
    "book": "isaiah                                  ",
    "chapter": "49",
    "verse": "7",
    "text": "Chúa Hằng Hữu, Đấng Cứu Chuộc"
  },
  {
    "id": 28571,
    "book": "isaiah                                  ",
    "chapter": "49",
    "verse": "8",
    "text": "Đây là điều Chúa Hằng Hữu phán:"
  },
  {
    "id": 28572,
    "book": "isaiah                                  ",
    "chapter": "49",
    "verse": "9",
    "text": "Ta sẽ gọi các tù nhân:"
  },
  {
    "id": 28573,
    "book": "isaiah                                  ",
    "chapter": "49",
    "verse": "10",
    "text": "Họ sẽ không còn đói hay khát nữa."
  },
  {
    "id": 28574,
    "book": "isaiah                                  ",
    "chapter": "49",
    "verse": "11",
    "text": "Ta sẽ san bằng các núi cao để làm đường cho họ."
  },
  {
    "id": 28575,
    "book": "isaiah                                  ",
    "chapter": "49",
    "verse": "12",
    "text": "Kìa, dân Ta sẽ từ các xứ xa trở về,"
  },
  {
    "id": 28576,
    "book": "isaiah                                  ",
    "chapter": "49",
    "verse": "13",
    "text": "Hãy lên, hỡi các tầng trời!"
  },
  {
    "id": 28577,
    "book": "isaiah                                  ",
    "chapter": "49",
    "verse": "14",
    "text": "Tuy nhiên, Si-ôn vẫn nói: “Chúa Hằng Hữu đã bỏ mặc chúng tôi;"
  },
  {
    "id": 28578,
    "book": "isaiah                                  ",
    "chapter": "49",
    "verse": "15",
    "text": "“Không bao giờ! Lẽ nào mẹ có thể quên con mình còn đang cho bú?"
  },
  {
    "id": 28579,
    "book": "isaiah                                  ",
    "chapter": "49",
    "verse": "16",
    "text": "Này, Ta đã viết tên con trong lòng bàn tay Ta."
  },
  {
    "id": 28580,
    "book": "isaiah                                  ",
    "chapter": "49",
    "verse": "17",
    "text": "Chẳng bao lâu, con cháu con sẽ gấp rút trở về"
  },
  {
    "id": 28581,
    "book": "isaiah                                  ",
    "chapter": "49",
    "verse": "18",
    "text": "Hãy đưa mắt nhìn quanh,"
  },
  {
    "id": 28582,
    "book": "isaiah                                  ",
    "chapter": "49",
    "verse": "19",
    "text": "Ngay cả những nơi bị tàn phá nhất trong những vùng hoang vu,"
  },
  {
    "id": 28583,
    "book": "isaiah                                  ",
    "chapter": "49",
    "verse": "20",
    "text": "Những thế hệ được sinh ra trong thời gian lưu đày sẽ trở về và nói:"
  },
  {
    "id": 28584,
    "book": "isaiah                                  ",
    "chapter": "49",
    "verse": "21",
    "text": "Lúc ấy, con sẽ tự hỏi: ‘Ai đã sinh đàn con này cho tôi?"
  },
  {
    "id": 28585,
    "book": "isaiah                                  ",
    "chapter": "49",
    "verse": "22",
    "text": "Đây là điều Chúa Hằng Hữu Chí Cao phán:"
  },
  {
    "id": 28586,
    "book": "isaiah                                  ",
    "chapter": "49",
    "verse": "23",
    "text": "Các vua và các hoàng hậu sẽ phục vụ con"
  },
  {
    "id": 28587,
    "book": "isaiah                                  ",
    "chapter": "49",
    "verse": "24",
    "text": "Của cải bị những người mạnh cướp, ai giựt lại được?"
  },
  {
    "id": 28588,
    "book": "isaiah                                  ",
    "chapter": "49",
    "verse": "25",
    "text": "Nhưng Chúa Hằng Hữu phán:"
  },
  {
    "id": 28589,
    "book": "isaiah                                  ",
    "chapter": "49",
    "verse": "26",
    "text": "Ta sẽ nuôi kẻ thù con bằng chính thịt của nó."
  }
]