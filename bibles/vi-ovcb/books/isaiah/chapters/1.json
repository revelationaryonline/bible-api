[
  {
    "id": 27582,
    "book": "isaiah                                  ",
    "chapter": "1",
    "verse": "1",
    "text": "Đây là khải tượng về Giu-đa và Giê-ru-sa-lem mà Tiên tri Y-sai, con A-mốt, đã thấy trong đời các Vua Ô-xia, Giô-tham, A-cha, và Ê-xê-chia làm vua Giu-đa."
  },
  {
    "id": 27583,
    "book": "isaiah                                  ",
    "chapter": "1",
    "verse": "2",
    "text": "Các tầng trời, hãy nghe! Đất, hãy lắng tai!"
  },
  {
    "id": 27584,
    "book": "isaiah                                  ",
    "chapter": "1",
    "verse": "3",
    "text": "Bò còn biết chủ,"
  },
  {
    "id": 27585,
    "book": "isaiah                                  ",
    "chapter": "1",
    "verse": "4",
    "text": "Khốn cho một nước tội lỗi—"
  },
  {
    "id": 27586,
    "book": "isaiah                                  ",
    "chapter": "1",
    "verse": "5",
    "text": "Tại sao các ngươi cứ phạm tội để chịu roi vọt?"
  },
  {
    "id": 27587,
    "book": "isaiah                                  ",
    "chapter": "1",
    "verse": "6",
    "text": "Các ngươi bị thương tích từ đỉnh đầu xuống bàn chân—"
  },
  {
    "id": 27588,
    "book": "isaiah                                  ",
    "chapter": "1",
    "verse": "7",
    "text": "Đất nước bị tàn phá,"
  },
  {
    "id": 27589,
    "book": "isaiah                                  ",
    "chapter": "1",
    "verse": "8",
    "text": "Giê-ru-sa-lem xinh đẹp1:8 Ctd Con gái Si-ôn bị bỏ lại"
  },
  {
    "id": 27590,
    "book": "isaiah                                  ",
    "chapter": "1",
    "verse": "9",
    "text": "Nếu Chúa Hằng Hữu Vạn Quân"
  },
  {
    "id": 27591,
    "book": "isaiah                                  ",
    "chapter": "1",
    "verse": "10",
    "text": "Hãy lắng nghe lời Chúa Hằng Hữu,"
  },
  {
    "id": 27592,
    "book": "isaiah                                  ",
    "chapter": "1",
    "verse": "11",
    "text": "Chúa Hằng Hữu phán:"
  },
  {
    "id": 27593,
    "book": "isaiah                                  ",
    "chapter": "1",
    "verse": "12",
    "text": "Trong ngày ra mắt Ta,"
  },
  {
    "id": 27594,
    "book": "isaiah                                  ",
    "chapter": "1",
    "verse": "13",
    "text": "Đừng dâng tế lễ vô nghĩa cho Ta nữa;"
  },
  {
    "id": 27595,
    "book": "isaiah                                  ",
    "chapter": "1",
    "verse": "14",
    "text": "Linh hồn Ta ghét những ngày trăng mới và lễ hội của các ngươi."
  },
  {
    "id": 27596,
    "book": "isaiah                                  ",
    "chapter": "1",
    "verse": "15",
    "text": "Khi các ngươi chắp tay kêu xin, Ta sẽ chẳng nhìn."
  },
  {
    "id": 27597,
    "book": "isaiah                                  ",
    "chapter": "1",
    "verse": "16",
    "text": "Hãy rửa đi, hãy làm cho sạch!"
  },
  {
    "id": 27598,
    "book": "isaiah                                  ",
    "chapter": "1",
    "verse": "17",
    "text": "Hãy học làm lành."
  },
  {
    "id": 27599,
    "book": "isaiah                                  ",
    "chapter": "1",
    "verse": "18",
    "text": "Chúa Hằng Hữu phán:"
  },
  {
    "id": 27600,
    "book": "isaiah                                  ",
    "chapter": "1",
    "verse": "19",
    "text": "Nếu các ngươi sẵn lòng vâng lời,"
  },
  {
    "id": 27601,
    "book": "isaiah                                  ",
    "chapter": "1",
    "verse": "20",
    "text": "Nhưng nếu các ngươi ngoan cố và chống nghịch,"
  },
  {
    "id": 27602,
    "book": "isaiah                                  ",
    "chapter": "1",
    "verse": "21",
    "text": "Hãy nhìn Giê-ru-sa-lem,"
  },
  {
    "id": 27603,
    "book": "isaiah                                  ",
    "chapter": "1",
    "verse": "22",
    "text": "Xưa được quý như bạc,"
  },
  {
    "id": 27604,
    "book": "isaiah                                  ",
    "chapter": "1",
    "verse": "23",
    "text": "Những người lãnh đạo ngươi đều phản loạn,"
  },
  {
    "id": 27605,
    "book": "isaiah                                  ",
    "chapter": "1",
    "verse": "24",
    "text": "Vì thế, Chúa, là Chúa Hằng Hữu Vạn Quân,"
  },
  {
    "id": 27606,
    "book": "isaiah                                  ",
    "chapter": "1",
    "verse": "25",
    "text": "Ta sẽ ra tay đánh ngươi,"
  },
  {
    "id": 27607,
    "book": "isaiah                                  ",
    "chapter": "1",
    "verse": "26",
    "text": "Rồi Ta sẽ lập lại các phán quan"
  },
  {
    "id": 27608,
    "book": "isaiah                                  ",
    "chapter": "1",
    "verse": "27",
    "text": "Si-ôn sẽ được chuộc bằng công lý;"
  },
  {
    "id": 27609,
    "book": "isaiah                                  ",
    "chapter": "1",
    "verse": "28",
    "text": "Nhưng bọn phản loạn và tội nhân sẽ bị tàn diệt,"
  },
  {
    "id": 27610,
    "book": "isaiah                                  ",
    "chapter": "1",
    "verse": "29",
    "text": "Các ngươi sẽ bị xấu hổ vì những cây sồi"
  },
  {
    "id": 27611,
    "book": "isaiah                                  ",
    "chapter": "1",
    "verse": "30",
    "text": "Các ngươi sẽ như cây sồi lá tàn héo,"
  },
  {
    "id": 27612,
    "book": "isaiah                                  ",
    "chapter": "1",
    "verse": "31",
    "text": "Những người mạnh sẽ như vỏ khô,"
  }
