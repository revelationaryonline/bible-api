[
  {
    "id": 28023,
    "book": "isaiah                                  ",
    "chapter": "24",
    "verse": "1",
    "text": "Kìa! Chúa Hằng Hữu sẽ đảo lộn thế giới,"
  },
  {
    "id": 28024,
    "book": "isaiah                                  ",
    "chapter": "24",
    "verse": "2",
    "text": "Thầy tế lễ và dân chúng,"
  },
  {
    "id": 28025,
    "book": "isaiah                                  ",
    "chapter": "24",
    "verse": "3",
    "text": "Khắp đất sẽ hoàn toàn trống không và bị tước đoạt."
  },
  {
    "id": 28026,
    "book": "isaiah                                  ",
    "chapter": "24",
    "verse": "4",
    "text": "Đất phải than van và khô hạn,"
  },
  {
    "id": 28027,
    "book": "isaiah                                  ",
    "chapter": "24",
    "verse": "5",
    "text": "Đất chịu khổ bởi tội lỗi của loài người,"
  },
  {
    "id": 28028,
    "book": "isaiah                                  ",
    "chapter": "24",
    "verse": "6",
    "text": "Do đó, đất bị nguyền rủa."
  },
  {
    "id": 28029,
    "book": "isaiah                                  ",
    "chapter": "24",
    "verse": "7",
    "text": "Các cây nho bị mất mùa,"
  },
  {
    "id": 28030,
    "book": "isaiah                                  ",
    "chapter": "24",
    "verse": "8",
    "text": "Tiếng trống tưng bừng đã im bặt;"
  },
  {
    "id": 28031,
    "book": "isaiah                                  ",
    "chapter": "24",
    "verse": "9",
    "text": "Không còn vui hát và rượu chè;"
  },
  {
    "id": 28032,
    "book": "isaiah                                  ",
    "chapter": "24",
    "verse": "10",
    "text": "Thành đổ nát hoang vắng;"
  },
  {
    "id": 28033,
    "book": "isaiah                                  ",
    "chapter": "24",
    "verse": "11",
    "text": "Trong phố người kêu đòi rượu."
  },
  {
    "id": 28034,
    "book": "isaiah                                  ",
    "chapter": "24",
    "verse": "12",
    "text": "Thành chỉ còn lại cảnh điêu tàn;"
  },
  {
    "id": 28035,
    "book": "isaiah                                  ",
    "chapter": "24",
    "verse": "13",
    "text": "Cư dân trên đất sẽ cùng số phận—"
  },
  {
    "id": 28036,
    "book": "isaiah                                  ",
    "chapter": "24",
    "verse": "14",
    "text": "Nhưng những ai sống sót sẽ reo mừng hát ca."
  },
  {
    "id": 28037,
    "book": "isaiah                                  ",
    "chapter": "24",
    "verse": "15",
    "text": "Từ phương đông, họ dâng vinh quang lên Chúa Hằng Hữu."
  },
  {
    "id": 28038,
    "book": "isaiah                                  ",
    "chapter": "24",
    "verse": "16",
    "text": "Chúng tôi nghe bài hát ngợi tôn từ tận cùng mặt đất,"
  },
  {
    "id": 28039,
    "book": "isaiah                                  ",
    "chapter": "24",
    "verse": "17",
    "text": "Các dân tộc trên đất."
  },
  {
    "id": 28040,
    "book": "isaiah                                  ",
    "chapter": "24",
    "verse": "18",
    "text": "Ai trốn cảnh khủng khiếp sẽ bị rơi vào hố thẳm,"
  },
  {
    "id": 28041,
    "book": "isaiah                                  ",
    "chapter": "24",
    "verse": "19",
    "text": "Trái đất bị vỡ nát."
  },
  {
    "id": 28042,
    "book": "isaiah                                  ",
    "chapter": "24",
    "verse": "20",
    "text": "Đất lảo đảo như người say."
  },
  {
    "id": 28043,
    "book": "isaiah                                  ",
    "chapter": "24",
    "verse": "21",
    "text": "Trong ngày ấy, Chúa sẽ trừng phạt các thần trên trời cao"
  },
  {
    "id": 28044,
    "book": "isaiah                                  ",
    "chapter": "24",
    "verse": "22",
    "text": "Chúng sẽ bị vây bắt và bị xiềng như tù nhân."
  },
  {
    "id": 28045,
    "book": "isaiah                                  ",
    "chapter": "24",
    "verse": "23",
    "text": "Lúc ấy, mặt trăng sẽ khuyết,"
  }
]