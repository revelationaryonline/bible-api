  {
    "id": 28520,
    "book": "isaiah                                  ",
    "chapter": "46",
    "verse": "7",
    "text": "Chúng rước tượng trên vai khiêng đi,"
  },
  {
    "id": 28521,
    "book": "isaiah                                  ",
    "chapter": "46",
    "verse": "8",
    "text": "Đừng quên điều này! Hãy giữ nó trong trí!"
  },
  {
    "id": 28522,
    "book": "isaiah                                  ",
    "chapter": "46",
    "verse": "9",
    "text": "Hãy nhớ lại những điều Ta đã làm trong quá khứ."
