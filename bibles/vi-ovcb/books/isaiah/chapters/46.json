    "chapter": "46",
    "verse": "1",
    "text": "Bên và Nê-bô, là các thần của Ba-by-lôn,"
  },
  {
    "id": 28515,
    "book": "isaiah                                  ",
    "chapter": "46",
    "verse": "2",
    "text": "Cả hai đều cúi đầu gò lưng."
  },
  {
    "id": 28516,
    "book": "isaiah                                  ",
    "chapter": "46",
    "verse": "3",
    "text": "“Hãy lắng nghe, hỡi con cháu Gia-cốp,"
  },
  {
    "id": 28517,
    "book": "isaiah                                  ",
    "chapter": "46",
    "verse": "4",
    "text": "Ta sẽ là Đức Chúa Trời trọn đời các con—"
