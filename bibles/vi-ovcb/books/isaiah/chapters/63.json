  {
    "id": 28798,
    "book": "isaiah                                  ",
    "chapter": "63",
    "verse": "5",
    "text": "Ta ngạc nhiên khi thấy không ai dám đứng ra"
  },
  {
    "id": 28799,
    "book": "isaiah                                  ",
    "chapter": "63",
    "verse": "6",
    "text": "Trong cơn thịnh nộ, Ta nghiền nát các dân vô đạo"
  },
  {
    "id": 28800,
    "book": "isaiah                                  ",
    "chapter": "63",
    "verse": "7",
    "text": "Tôi sẽ nói đến lòng thương xót vô biên của Chúa Hằng Hữu."
  },
  {
    "id": 28801,
    "book": "isaiah                                  ",
    "chapter": "63",
    "verse": "8",
    "text": "Chúa phán: “Chúng là dân Ta."
  },
  {
    "id": 28802,
    "book": "isaiah                                  ",
    "chapter": "63",
    "verse": "9",
    "text": "Trong khi họ gặp khốn khổ, Chúa cũng gặp khốn khổ,"
  },
  {
    "id": 28803,
    "book": "isaiah                                  ",
    "chapter": "63",
    "verse": "10",
    "text": "Nhưng họ đã nổi loạn chống nghịch Chúa"
  },
  {
    "id": 28804,
    "book": "isaiah                                  ",
    "chapter": "63",
    "verse": "11",
    "text": "Lúc ấy, họ mới nhớ lại quá khứ,"
  },
  {
    "id": 28805,
    "book": "isaiah                                  ",
    "chapter": "63",
    "verse": "12",
    "text": "Đấng đã thể hiện quyền năng của Ngài"
  },
  {
    "id": 28806,
    "book": "isaiah                                  ",
    "chapter": "63",
    "verse": "13",
    "text": "Đấng đã dìu dắt họ đi qua đáy biển ở đâu?"
  },
  {
    "id": 28807,
    "book": "isaiah                                  ",
    "chapter": "63",
    "verse": "14",
    "text": "Như bầy gia súc được đi về thung lũng,"
  },
  {
    "id": 28808,
    "book": "isaiah                                  ",
    "chapter": "63",
    "verse": "15",
    "text": "Lạy Chúa Hằng Hữu, xin nhìn xuống từ trời;"
  },
  {
    "id": 28809,
    "book": "isaiah                                  ",
    "chapter": "63",
    "verse": "16",
    "text": "Thật, Chúa là Cha chúng con!"
  },
  {
    "id": 28810,
    "book": "isaiah                                  ",
    "chapter": "63",
    "verse": "17",
    "text": "Lạy Chúa Hằng Hữu, sao Chúa nỡ để chúng con tách xa đường lối Ngài?"
  },
  {
    "id": 28811,
    "book": "isaiah                                  ",
    "chapter": "63",
    "verse": "18",
    "text": "Dân thánh của Ngài mới sở nơi đền thánh này chưa bao lâu,"
