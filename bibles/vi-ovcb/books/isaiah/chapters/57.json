[
  {
    "id": 28693,
    "book": "isaiah                                  ",
    "chapter": "57",
    "verse": "1",
    "text": "Người công chính chết đi;"
  },
  {
    "id": 28694,
    "book": "isaiah                                  ",
    "chapter": "57",
    "verse": "2",
    "text": "Vì người sống ngay thẳng"
  },
  {
    "id": 28695,
    "book": "isaiah                                  ",
    "chapter": "57",
    "verse": "3",
    "text": "“Nhưng ngươi—hãy đến đây, các ngươi là con cháu của phù thủy,"
  },
  {
    "id": 28696,
    "book": "isaiah                                  ",
    "chapter": "57",
    "verse": "4",
    "text": "Các ngươi chế nhạo ai,"
  },
  {
    "id": 28697,
    "book": "isaiah                                  ",
    "chapter": "57",
    "verse": "5",
    "text": "Các ngươi sốt sắng thờ lạy thần tượng"
  },
  {
    "id": 28698,
    "book": "isaiah                                  ",
    "chapter": "57",
    "verse": "6",
    "text": "Thần tượng các ngươi là các tảng đá nhẵn bóng trong các thung lũng."
  },
  {
    "id": 28699,
    "book": "isaiah                                  ",
    "chapter": "57",
    "verse": "7",
    "text": "Các ngươi đã phạm tội gian dâm trên núi cao."
  },
  {
    "id": 28700,
    "book": "isaiah                                  ",
    "chapter": "57",
    "verse": "8",
    "text": "Các ngươi đặt một biểu tượng tà thần"
  },
  {
    "id": 28701,
    "book": "isaiah                                  ",
    "chapter": "57",
    "verse": "9",
    "text": "Các ngươi dâng dầu ô-liu cho thần Mô-lóc57:9 Ctd vua"
  },
  {
    "id": 28702,
    "book": "isaiah                                  ",
    "chapter": "57",
    "verse": "10",
    "text": "Dù phải cực nhọc đi xa mệt mỏi,"
  },
  {
    "id": 28703,
    "book": "isaiah                                  ",
    "chapter": "57",
    "verse": "11",
    "text": "Có phải các ngươi sợ những tà thần này?"
  },
  {
    "id": 28704,
    "book": "isaiah                                  ",
    "chapter": "57",
    "verse": "12",
    "text": "Bây giờ Ta sẽ phơi bày nếp sống thiện lành của các ngươi."
  },
  {
    "id": 28705,
    "book": "isaiah                                  ",
    "chapter": "57",
    "verse": "13",
    "text": "Để xem các thần tượng có thể cứu các ngươi"
  },
  {
    "id": 28706,
    "book": "isaiah                                  ",
    "chapter": "57",
    "verse": "14",
    "text": "Đức Chúa Trời phán: “Hãy sửa mới con đường!"
  },
  {
    "id": 28707,
    "book": "isaiah                                  ",
    "chapter": "57",
    "verse": "15",
    "text": "Đấng Cao Cả và Chí Tôn đang ngự trong cõi đời đời,"
  },
  {
    "id": 28708,
    "book": "isaiah                                  ",
    "chapter": "57",
    "verse": "16",
    "text": "Vì Ta không buộc tội luôn;"
  },
  {
    "id": 28709,
    "book": "isaiah                                  ",
    "chapter": "57",
    "verse": "17",
    "text": "Ta đã từng nổi giận,"
  },
  {
    "id": 28710,
    "book": "isaiah                                  ",
    "chapter": "57",
    "verse": "18",
    "text": "Ta đã thấy những gì chúng làm,"
  },
  {
    "id": 28711,
    "book": "isaiah                                  ",
    "chapter": "57",
    "verse": "19",
    "text": "đem lời ngợi tôn trên môi họ."
  },
  {
    "id": 28712,
    "book": "isaiah                                  ",
    "chapter": "57",
    "verse": "20",
    "text": "“Còn những ai ngoan cố khước từ Ta sẽ như biển động,"
  },
  {
    "id": 28713,
    "book": "isaiah                                  ",
    "chapter": "57",
    "verse": "21",
    "text": "Bọn gian tà chẳng bao giờ được bình an,”"
  }
