    "chapter": "45",
    "verse": "1",
    "text": "Đây là điều Chúa Hằng Hữu phán về Si-ru, người được Ngài xức dầu,"
  },
  {
    "id": 28490,
    "book": "isaiah                                  ",
    "chapter": "45",
    "verse": "2",
    "text": "Đây là điều Chúa Hằng Hữu phán:"
  },
  {
    "id": 28491,
    "book": "isaiah                                  ",
    "chapter": "45",
    "verse": "3",
    "text": "Ta sẽ cho con các kho tàng châu báu giấu trong hang sâu bí mật."
  },
  {
    "id": 28492,
    "book": "isaiah                                  ",
    "chapter": "45",
    "verse": "4",
    "text": "“Tại sao Ta gọi để làm việc này?"
  },
  {
    "id": 28493,
    "book": "isaiah                                  ",
    "chapter": "45",
    "verse": "5",
    "text": "Ta là Chúa Hằng Hữu;"
