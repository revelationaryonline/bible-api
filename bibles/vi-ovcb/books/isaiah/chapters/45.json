  {
    "id": 28512,
    "book": "isaiah                                  ",
    "chapter": "45",
    "verse": "24",
    "text": "Họ sẽ công bố:"
  },
  {
    "id": 28513,
    "book": "isaiah                                  ",
    "chapter": "45",
    "verse": "25",
    "text": "Trong Chúa Hằng Hữu, mọi thế hệ của Ít-ra-ên sẽ được xưng công chính,"
  }
]