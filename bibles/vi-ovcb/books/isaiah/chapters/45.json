  {
    "id": 28494,
    "book": "isaiah                                  ",
    "chapter": "45",
    "verse": "6",
    "text": "để khắp đất từ đông sang tây,"
  },
  {
    "id": 28495,
    "book": "isaiah                                  ",
    "chapter": "45",
    "verse": "7",
    "text": "Ta tạo ánh sáng và bóng tối."
  },
  {
    "id": 28496,
    "book": "isaiah                                  ",
    "chapter": "45",
    "verse": "8",
    "text": "“Hãy mở ra, hỡi các tầng trời,"
  },
  {
    "id": 28497,
    "book": "isaiah                                  ",
    "chapter": "45",
    "verse": "9",
    "text": "“Khốn cho những ai chống lại Đấng Sáng Tạo mình."
  },
  {
    "id": 28498,
    "book": "isaiah                                  ",
    "chapter": "45",
    "verse": "10",
    "text": "Khốn cho người dám hỏi cha mình:"
  },
  {
    "id": 28499,
    "book": "isaiah                                  ",
    "chapter": "45",
    "verse": "11",
    "text": "Đây là điều Chúa Hằng Hữu—"
  },
  {
    "id": 28500,
    "book": "isaiah                                  ",
    "chapter": "45",
    "verse": "12",
    "text": "Ta là Đấng đã làm nên trái đất"
  },
  {
    "id": 28501,
    "book": "isaiah                                  ",
    "chapter": "45",
    "verse": "13",
    "text": "Ta đã dấy Si-ru lên để thực hiện sự công chính,"
  },
  {
    "id": 28502,
    "book": "isaiah                                  ",
    "chapter": "45",
    "verse": "14",
    "text": "Đây là điều Chúa Hằng Hữu phán:"
  },
  {
    "id": 28503,
    "book": "isaiah                                  ",
    "chapter": "45",
    "verse": "15",
    "text": "Thật, thưa Đức Chúa Trời của Ít-ra-ên, Đấng Cứu Rỗi của chúng ta,"
  },
  {
    "id": 28504,
    "book": "isaiah                                  ",
    "chapter": "45",
    "verse": "16",
    "text": "Tất cả thợ chạm tượng đều bị ô nhục."
  },
  {
    "id": 28505,
    "book": "isaiah                                  ",
    "chapter": "45",
    "verse": "17",
    "text": "Nhưng Chúa Hằng Hữu sẽ cứu người Ít-ra-ên"
  },
  {
    "id": 28506,
    "book": "isaiah                                  ",
    "chapter": "45",
    "verse": "18",
    "text": "Vì Chúa Hằng Hữu là Đức Chúa Trời"
  },
  {
    "id": 28507,
    "book": "isaiah                                  ",
    "chapter": "45",
    "verse": "19",
    "text": "Ta công khai tuyên bố lời hứa cách mạnh mẽ."
  },
  {
    "id": 28508,
    "book": "isaiah                                  ",
    "chapter": "45",
    "verse": "20",
    "text": "“Hãy tụ họp lại và đến,"
  },
  {
    "id": 28509,
    "book": "isaiah                                  ",
    "chapter": "45",
    "verse": "21",
    "text": "Hãy cùng nhau bàn luận, hãy trình bày."
  },
  {
    "id": 28510,
    "book": "isaiah                                  ",
    "chapter": "45",
    "verse": "22",
