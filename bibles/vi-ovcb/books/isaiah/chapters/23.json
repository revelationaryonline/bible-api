[
  {
    "id": 28005,
    "book": "isaiah                                  ",
    "chapter": "23",
    "verse": "1",
    "text": "Đây là lời tiên tri về Ty-rơ:"
  },
  {
    "id": 28006,
    "book": "isaiah                                  ",
    "chapter": "23",
    "verse": "2",
    "text": "Hãy âm thầm khóc than hỡi cư dân miền biển"
  },
  {
    "id": 28007,
    "book": "isaiah                                  ",
    "chapter": "23",
    "verse": "3",
    "text": "vượt trên những vùng nước sâu."
  },
  {
    "id": 28008,
    "book": "isaiah                                  ",
    "chapter": "23",
    "verse": "4",
    "text": "Nhưng bây giờ ngươi đã khiến mình hổ thẹn, hỡi thành Si-đôn,"
  },
  {
    "id": 28009,
    "book": "isaiah                                  ",
    "chapter": "23",
    "verse": "5",
    "text": "Khi Ai Cập nghe tin từ Ty-rơ,"
  },
  {
    "id": 28010,
    "book": "isaiah                                  ",
    "chapter": "23",
    "verse": "6",
    "text": "Hãy gửi lời đến Ta-rê-si!"
  },
  {
    "id": 28011,
    "book": "isaiah                                  ",
    "chapter": "23",
    "verse": "7",
    "text": "Đây có phải từng là thành nhộn nhịp của ngươi không?"
  },
  {
    "id": 28012,
    "book": "isaiah                                  ",
    "chapter": "23",
    "verse": "8",
    "text": "Ai mang thảm họa này cho Ty-rơ,"
  },
  {
    "id": 28013,
    "book": "isaiah                                  ",
    "chapter": "23",
    "verse": "9",
    "text": "Chúa Hằng Hữu Vạn Quân đã dự định"
  },
  {
    "id": 28014,
    "book": "isaiah                                  ",
    "chapter": "23",
    "verse": "10",
    "text": "Hãy đến, hỡi người Ta-rê-si,"
  },
  {
    "id": 28015,
    "book": "isaiah                                  ",
    "chapter": "23",
    "verse": "11",
    "text": "Chúa Hằng Hữu đưa tay trên biển,"
  },
  {
    "id": 28016,
    "book": "isaiah                                  ",
    "chapter": "23",
    "verse": "12",
    "text": "Chúa phán: “Các ngươi chẳng bao giờ vui sướng nữa,"
  },
  {
    "id": 28017,
    "book": "isaiah                                  ",
    "chapter": "23",
    "verse": "13",
    "text": "Hãy nhìn vào đất Ba-by-lôn,23:13 Nt người Canh-đê"
  },
  {
    "id": 28018,
    "book": "isaiah                                  ",
    "chapter": "23",
    "verse": "14",
    "text": "Khóc lên đi, các thủy thủ trên tàu bè Ta-rê-si,"
  },
  {
    "id": 28019,
    "book": "isaiah                                  ",
    "chapter": "23",
    "verse": "15",
    "text": "Vì suốt bảy mươi năm, thời gian của một đời vua, Ty-rơ sẽ bị quên lãng. Nhưng sau đó, thành sẽ trở lại như bài ca của kỹ nữ:"
  },
  {
    "id": 28020,
    "book": "isaiah                                  ",
    "chapter": "23",
    "verse": "16",
    "text": "Hãy lấy đàn hạc và đi khắp thành"
  },
  {
    "id": 28021,
    "book": "isaiah                                  ",
    "chapter": "23",
    "verse": "17",
    "text": "Phải, sau bảy mươi năm đó, Chúa Hằng Hữu sẽ phục hồi Ty-rơ. Nhưng nó cũng không khác gì ngày trước. Nó sẽ trở lại thông dâm với tất cả vương quốc trên thế giới."
  },
  {
    "id": 28022,
    "book": "isaiah                                  ",
    "chapter": "23",
    "verse": "18",
    "text": "Tuy nhiên, lợi tức của nó sẽ biệt riêng cho Chúa Hằng Hữu. Của cải của nó sẽ không dành dụm được nhưng để cung cấp thực phẩm dồi dào và trang phục đẹp cho các thầy tế lễ của Chúa Hằng Hữu."
  }
]