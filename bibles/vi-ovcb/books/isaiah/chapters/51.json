[
  {
    "id": 28601,
    "book": "isaiah                                  ",
    "chapter": "51",
    "verse": "1",
    "text": "“Hãy nghe Ta, những ai hy vọng được giải thoát—"
  },
  {
    "id": 28602,
    "book": "isaiah                                  ",
    "chapter": "51",
    "verse": "2",
    "text": "Hãy nhìn xem Áp-ra-ham, tổ phụ con,"
  },
  {
    "id": 28603,
    "book": "isaiah                                  ",
    "chapter": "51",
    "verse": "3",
    "text": "Vì Chúa Hằng Hữu sẽ an ủi Si-ôn một lần nữa"
  },
  {
    "id": 28604,
    "book": "isaiah                                  ",
    "chapter": "51",
    "verse": "4",
    "text": "“Hãy nghe Ta, hỡi dân Ta."
  },
  {
    "id": 28605,
    "book": "isaiah                                  ",
    "chapter": "51",
    "verse": "5",
    "text": "Sự thương xót và công chính của Ta sẽ sớm đến."
  },
  {
    "id": 28606,
    "book": "isaiah                                  ",
    "chapter": "51",
    "verse": "6",
    "text": "Hãy nhìn lên bầu trời trên cao,"
  },
  {
    "id": 28607,
    "book": "isaiah                                  ",
    "chapter": "51",
    "verse": "7",
    "text": "Hãy nghe Ta, hỡi những người hiểu biết công lý"
  },
  {
    "id": 28608,
    "book": "isaiah                                  ",
    "chapter": "51",
    "verse": "8",
    "text": "Vì mối mọt sẽ ăn chúng như ăn chiếc áo mục."
  },
  {
    "id": 28609,
    "book": "isaiah                                  ",
    "chapter": "51",
    "verse": "9",
    "text": "Lạy Chúa Hằng Hữu! Xin thức dậy, thức dậy mặc lấy năng lực!"
  },
  {
    "id": 28610,
    "book": "isaiah                                  ",
    "chapter": "51",
    "verse": "10",
    "text": "Chẳng phải hôm nay, không phải Chúa"
  },
  {
    "id": 28611,
    "book": "isaiah                                  ",
    "chapter": "51",
    "verse": "11",
    "text": "Sẽ có ngày, những người được Chúa Hằng Hữu cứu chuộc sẽ trở về."
  },
  {
    "id": 28612,
    "book": "isaiah                                  ",
    "chapter": "51",
    "verse": "12",
    "text": "“Ta, phải chính Ta, là Đấng an ủi con."
  },
  {
    "id": 28613,
    "book": "isaiah                                  ",
    "chapter": "51",
    "verse": "13",
    "text": "Vậy mà con lại quên Chúa Hằng Hữu là Đấng Tạo Hóa,"
  },
  {
    "id": 28614,
    "book": "isaiah                                  ",
    "chapter": "51",
    "verse": "14",
    "text": "Chẳng bao lâu, tù binh và nô lệ sẽ được phóng thích!"
  },
  {
    "id": 28615,
    "book": "isaiah                                  ",
    "chapter": "51",
    "verse": "15",
    "text": "Vì Ta là Chúa Hằng Hữu, Đức Chúa Trời của con,"
  },
  {
    "id": 28616,
    "book": "isaiah                                  ",
    "chapter": "51",
    "verse": "16",
    "text": "Ta đã đặt các lời Ta trong miệng con"
  },
  {
    "id": 28617,
    "book": "isaiah                                  ",
    "chapter": "51",
    "verse": "17",
    "text": "Giê-ru-sa-lem, thức dậy, thức dậy đi!"
  },
  {
    "id": 28618,
    "book": "isaiah                                  ",
    "chapter": "51",
    "verse": "18",
    "text": "Trong các con trai mà Giê-ru-sa-lem đã sinh ra,"
  },
  {
    "id": 28619,
    "book": "isaiah                                  ",
    "chapter": "51",
    "verse": "19",
    "text": "Ngươi đã bị hai tai họa giáng trên ngươi:"
  },
  {
    "id": 28620,
    "book": "isaiah                                  ",
    "chapter": "51",
    "verse": "20",
    "text": "Vì con cái ngươi đã ngất xỉu và nằm la liệt trong các đường phố,"
  },
  {
    "id": 28621,
    "book": "isaiah                                  ",
    "chapter": "51",
    "verse": "21",
    "text": "Nhưng bây giờ hãy nghe điều này, hỡi người khốn khổ,"
  },
  {
    "id": 28622,
    "book": "isaiah                                  ",
    "chapter": "51",
    "verse": "22",
    "text": "Đây là điều Chúa Hằng Hữu Chí Cao,"
  },
  {
    "id": 28623,
    "book": "isaiah                                  ",
    "chapter": "51",
    "verse": "23",
    "text": "Thay vào đó, Ta sẽ cho người hành hạ ngươi uống chén thịnh nộ ấy,"
  }
]