    "chapter": "25",
    "verse": "1",
    "text": "Lạy Chúa Hằng Hữu, con sẽ tôn vinh Chúa và ca ngợi Danh Ngài,"
  },
  {
    "id": 28047,
    "book": "isaiah                                  ",
    "chapter": "25",
