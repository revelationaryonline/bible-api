[
  {
    "id": 27757,
    "book": "isaiah                                  ",
    "chapter": "9",
    "verse": "1",
    "text": "Tuy nhiên, thời kỳ tối tăm và tuyệt vọng sẽ không đến mãi mãi. Đất Sa-bu-luân và Nép-ta-li sẽ bị hạ xuống, nhưng trong tương lai, vùng Ga-li-lê của dân ngoại, nằm dọc theo đường giữa Giô-đan và biển, sẽ tràn đầy vinh quang."
  },
  {
    "id": 27758,
    "book": "isaiah                                  ",
    "chapter": "9",
    "verse": "2",
    "text": "Dân đi trong nơi tối tăm"
  },
  {
    "id": 27759,
    "book": "isaiah                                  ",
    "chapter": "9",
    "verse": "3",
    "text": "Chúa sẽ mở rộng bờ cõi Ít-ra-ên"
  },
  {
    "id": 27760,
    "book": "isaiah                                  ",
    "chapter": "9",
    "verse": "4",
    "text": "Vì Chúa đã đập tan ách đè nặng trên họ"
  },
  {
    "id": 27761,
    "book": "isaiah                                  ",
    "chapter": "9",
    "verse": "5",
    "text": "Mỗi đôi giày của chiến sĩ"
  },
  {
    "id": 27762,
    "book": "isaiah                                  ",
    "chapter": "9",
    "verse": "6",
    "text": "Vì một Hài Nhi sẽ được sinh cho chúng ta,"
  },
  {
    "id": 27763,
    "book": "isaiah                                  ",
    "chapter": "9",
    "verse": "7",
    "text": "Quyền cai trị và nền hòa bình của Người"
  },
  {
    "id": 27764,
    "book": "isaiah                                  ",
    "chapter": "9",
    "verse": "8",
    "text": "Chúa đã phán nghịch cùng Gia-cốp;"
  },
  {
    "id": 27765,
    "book": "isaiah                                  ",
    "chapter": "9",
    "verse": "9",
    "text": "Người Ít-ra-ên và người Sa-ma-ri,"
  },
  {
    "id": 27766,
    "book": "isaiah                                  ",
    "chapter": "9",
    "verse": "10",
    "text": "Họ nói: “Chúng ta sẽ thay gạch đã đổ nát bằng đá đẽo,"
  },
  {
    "id": 27767,
    "book": "isaiah                                  ",
    "chapter": "9",
    "verse": "11",
    "text": "Nhưng Chúa Hằng Hữu sẽ mang quân Rê-xin tấn công Ít-ra-ên"
  },
  {
    "id": 27768,
    "book": "isaiah                                  ",
    "chapter": "9",
    "verse": "12",
    "text": "Quân Sy-ri từ phía đông,"
  },
  {
    "id": 27769,
    "book": "isaiah                                  ",
    "chapter": "9",
    "verse": "13",
    "text": "Vì sau những trừng phạt này, dân chúng sẽ vẫn không ăn năn."
  },
  {
    "id": 27770,
    "book": "isaiah                                  ",
    "chapter": "9",
    "verse": "14",
    "text": "Vì thế, chỉ trong một ngày, Chúa Hằng Hữu sẽ cắt cả đầu lẫn đuôi,"
  },
  {
    "id": 27771,
    "book": "isaiah                                  ",
    "chapter": "9",
    "verse": "15",
    "text": "Những người lãnh đạo của Ít-ra-ên là đầu,"
  },
  {
    "id": 27772,
    "book": "isaiah                                  ",
    "chapter": "9",
    "verse": "16",
    "text": "Vì những người lãnh đạo đã lạc lối."
  },
  {
    "id": 27773,
    "book": "isaiah                                  ",
    "chapter": "9",
    "verse": "17",
    "text": "Đó là tại sao Chúa không ưa những thanh niên,"
  },
  {
    "id": 27774,
    "book": "isaiah                                  ",
    "chapter": "9",
    "verse": "18",
    "text": "Sự bạo tàn sẽ cháy lên như ngọn lửa."
  },
  {
    "id": 27775,
    "book": "isaiah                                  ",
    "chapter": "9",
    "verse": "19",
    "text": "Đất sẽ bị cháy đen bởi cơn thịnh nộ của Chúa Hằng Hữu Vạn Quân."
  },
  {
    "id": 27776,
    "book": "isaiah                                  ",
    "chapter": "9",
    "verse": "20",
    "text": "Họ sẽ cướp láng giềng bên phải mà vẫn còn đói."
  },
  {
    "id": 27777,
    "book": "isaiah                                  ",
    "chapter": "9",
    "verse": "21",
    "text": "Ma-na-se vồ xé Ép-ra-im,"
  }
