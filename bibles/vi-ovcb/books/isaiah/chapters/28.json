[
  {
    "id": 28092,
    "book": "isaiah                                  ",
    "chapter": "28",
    "verse": "1",
    "text": "Khốn cho thành kiêu ngạo Sa-ma-ri—"
  },
  {
    "id": 28093,
    "book": "isaiah                                  ",
    "chapter": "28",
    "verse": "2",
    "text": "Vì Chúa Hằng Hữu sẽ sai một người hùng mạnh chống lại nó."
  },
  {
    "id": 28094,
    "book": "isaiah                                  ",
    "chapter": "28",
    "verse": "3",
    "text": "Thành kiêu ngạo Sa-ma-ri—"
  },
  {
    "id": 28095,
    "book": "isaiah                                  ",
    "chapter": "28",
    "verse": "4",
    "text": "Nó ngồi trên đầu thung lũng phì nhiêu,"
  },
  {
    "id": 28096,
    "book": "isaiah                                  ",
    "chapter": "28",
    "verse": "5",
    "text": "Vào ngày ấy, chính Chúa Hằng Hữu Vạn Quân"
  },
  {
    "id": 28097,
    "book": "isaiah                                  ",
    "chapter": "28",
    "verse": "6",
    "text": "Chúa sẽ là thần công chính"
  },
  {
    "id": 28098,
    "book": "isaiah                                  ",
    "chapter": "28",
    "verse": "7",
    "text": "Bấy giờ, Ít-ra-ên bị dẫn dắt bởi bọn say sưa"
  },
  {
    "id": 28099,
    "book": "isaiah                                  ",
    "chapter": "28",
    "verse": "8",
    "text": "Trên bàn tiệc của họ phủ đầy thứ ói mửa;"
  },
  {
    "id": 28100,
    "book": "isaiah                                  ",
    "chapter": "28",
    "verse": "9",
    "text": "Chúng hỏi: “Chúa Hằng Hữu nghĩ chúng ta là ai?"
  },
  {
    "id": 28101,
    "book": "isaiah                                  ",
    "chapter": "28",
    "verse": "10",
    "text": "Ngài bảo chúng ta mọi thứ, cứ lặp đi lặp lại—"
  },
  {
    "id": 28102,
    "book": "isaiah                                  ",
    "chapter": "28",
    "verse": "11",
    "text": "Vì vậy, Đức Chúa Trời sẽ nói với dân Ngài"
  },
  {
    "id": 28103,
    "book": "isaiah                                  ",
    "chapter": "28",
    "verse": "12",
    "text": "Đức Chúa Trời đã phán với dân Ngài:"
  },
  {
    "id": 28104,
    "book": "isaiah                                  ",
    "chapter": "28",
    "verse": "13",
    "text": "Vì vậy, Chúa Hằng Hữu sẽ giải thích rõ ràng sứ điệp của Ngài cho họ lần nữa,"
  },
  {
    "id": 28105,
    "book": "isaiah                                  ",
    "chapter": "28",
    "verse": "14",
    "text": "Vì thế, hãy lắng nghe sứ điệp này từ Chúa Hằng Hữu,"
  },
  {
    "id": 28106,
    "book": "isaiah                                  ",
    "chapter": "28",
    "verse": "15",
    "text": "Các ngươi khoác lác: “Chúng tôi đã kết ước với sự chết"
  },
  {
    "id": 28107,
    "book": "isaiah                                  ",
    "chapter": "28",
    "verse": "16",
    "text": "Vì thế, đây là điều Chúa Hằng Hữu Chí Cao phán:"
  },
  {
    "id": 28108,
    "book": "isaiah                                  ",
    "chapter": "28",
    "verse": "17",
    "text": "Ta sẽ thử ngươi bằng thước đo công bình,"
  },
  {
    "id": 28109,
    "book": "isaiah                                  ",
    "chapter": "28",
    "verse": "18",
    "text": "Ta sẽ hủy bỏ kết ước của ngươi với sự chết,"
  },
  {
    "id": 28110,
    "book": "isaiah                                  ",
    "chapter": "28",
    "verse": "19",
    "text": "Một lần rồi một lần nữa lũ lụt sẽ đến,"
  },
  {
    "id": 28111,
    "book": "isaiah                                  ",
    "chapter": "28",
    "verse": "20",
    "text": "Giường ngươi làm ra quá ngắn không đủ nằm."
  },
  {
    "id": 28112,
    "book": "isaiah                                  ",
    "chapter": "28",
    "verse": "21",
    "text": "Chúa Hằng Hữu sẽ đến như khi Ngài nghịch cùng người Phi-li-tin tại Núi Ga-ri-xim"
  },
  {
    "id": 28113,
    "book": "isaiah                                  ",
    "chapter": "28",
    "verse": "22",
    "text": "Vì Chúa là Chúa Hằng Hữu Vạn Quân"
  },
  {
    "id": 28114,
    "book": "isaiah                                  ",
    "chapter": "28",
    "verse": "23",
    "text": "Hãy nghe tôi;"
  },
  {
    "id": 28115,
    "book": "isaiah                                  ",
    "chapter": "28",
    "verse": "24",
    "text": "Có phải một nhà nông luôn cày đất"
  },
  {
    "id": 28116,
    "book": "isaiah                                  ",
    "chapter": "28",
    "verse": "25",
    "text": "Khi làm mặt đất bằng phẳng,"
  },
  {
    "id": 28117,
    "book": "isaiah                                  ",
    "chapter": "28",
    "verse": "26",
    "text": "Người nông dân biết phải làm gì,"
  },
  {
    "id": 28118,
    "book": "isaiah                                  ",
    "chapter": "28",
    "verse": "27",
    "text": "Không ai dùng búa để đập thìa là đen;"
  },
  {
    "id": 28119,
    "book": "isaiah                                  ",
    "chapter": "28",
    "verse": "28",
    "text": "Hạt lúa được xay để làm bánh mì"
  },
  {
    "id": 28120,
    "book": "isaiah                                  ",
    "chapter": "28",
    "verse": "29",
    "text": "Chúa Hằng Hữu Vạn Quân là Giáo Sư kỳ diệu,"
  }
]