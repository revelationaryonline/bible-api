[
  {
    "id": 28408,
    "book": "isaiah                                  ",
    "chapter": "42",
    "verse": "1",
    "text": "“Đây là Đầy Tớ Ta, Người Ta phù hộ."
  },
  {
    "id": 28409,
    "book": "isaiah                                  ",
    "chapter": "42",
    "verse": "2",
    "text": "Người không kêu la"
  },
  {
    "id": 28410,
    "book": "isaiah                                  ",
    "chapter": "42",
    "verse": "3",
    "text": "Người sẽ chẳng bẻ cây sậy gần gãy"
  },
  {
    "id": 28411,
    "book": "isaiah                                  ",
    "chapter": "42",
    "verse": "4",
    "text": "Người sẽ không mệt mỏi hay ngã lòng"
  },
  {
    "id": 28412,
    "book": "isaiah                                  ",
    "chapter": "42",
    "verse": "5",
    "text": "Đức Chúa Trời, Chúa Hằng Hữu là Đấng sáng tạo và trải các tầng trời ra,"
  },
  {
    "id": 28413,
    "book": "isaiah                                  ",
    "chapter": "42",
    "verse": "6",
    "text": "“Ta, Chúa Hằng Hữu, đã gọi con vào sự công chính."
  },
  {
    "id": 28414,
    "book": "isaiah                                  ",
    "chapter": "42",
    "verse": "7",
    "text": "Con sẽ mở mắt những người mù."
  },
  {
    "id": 28415,
    "book": "isaiah                                  ",
    "chapter": "42",
    "verse": "8",
    "text": "Ta là Chúa Hằng Hữu; đó là Danh Ta!"
  },
  {
    "id": 28416,
    "book": "isaiah                                  ",
    "chapter": "42",
    "verse": "9",
    "text": "Tất cả lời tiên tri của Ta ngày trước đã xảy ra,"
  },
  {
    "id": 28417,
    "book": "isaiah                                  ",
    "chapter": "42",
    "verse": "10",
    "text": "Hãy hát một bài ca mới cho Chúa Hằng Hữu!"
  },
  {
    "id": 28418,
    "book": "isaiah                                  ",
    "chapter": "42",
    "verse": "11",
    "text": "Hãy cùng hòa nhịp, hỡi các thành hoang mạc;"
  },
  {
    "id": 28419,
    "book": "isaiah                                  ",
    "chapter": "42",
    "verse": "12",
    "text": "Hỡi cả trái đất hãy dâng vinh quang lên Chúa Hằng Hữu;"
  },
  {
    "id": 28420,
    "book": "isaiah                                  ",
    "chapter": "42",
    "verse": "13",
    "text": "Chúa Hằng Hữu sẽ ra đi như dũng tướng hùng mạnh,"
  },
  {
    "id": 28421,
    "book": "isaiah                                  ",
    "chapter": "42",
    "verse": "14",
    "text": "Chúa phán: “Ta đã im lặng từ lâu;"
  },
  {
    "id": 28422,
    "book": "isaiah                                  ",
    "chapter": "42",
    "verse": "15",
    "text": "Ta sẽ san bằng những ngọn núi và đồi"
  },
  {
    "id": 28423,
    "book": "isaiah                                  ",
    "chapter": "42",
    "verse": "16",
    "text": "Ta sẽ dẫn người Ít-ra-ên mù lòa đi trên đường mới,"
  },
  {
    "id": 28424,
    "book": "isaiah                                  ",
    "chapter": "42",
    "verse": "17",
    "text": "Còn những người tin cậy vào hình tượng,"
  },
  {
    "id": 28425,
    "book": "isaiah                                  ",
    "chapter": "42",
    "verse": "18",
    "text": "“Hãy lắng nghe, hỡi những người điếc!"
  },
  {
    "id": 28426,
    "book": "isaiah                                  ",
    "chapter": "42",
    "verse": "19",
    "text": "Ai mù như dân Ta, đầy tớ Ta?"
  },
  {
    "id": 28427,
    "book": "isaiah                                  ",
    "chapter": "42",
    "verse": "20",
    "text": "Ngươi thấy và nhận ra điều đúng"
  },
  {
    "id": 28428,
    "book": "isaiah                                  ",
    "chapter": "42",
    "verse": "21",
    "text": "Vì Chúa là Đấng Công Chính,"
  },
  {
    "id": 28429,
    "book": "isaiah                                  ",
    "chapter": "42",
    "verse": "22",
    "text": "Nhưng dân của Ngài đã bị cướp đoạt và bóc lột,"
  },
  {
    "id": 28430,
    "book": "isaiah                                  ",
    "chapter": "42",
    "verse": "23",
    "text": "Ai sẽ nghe những bài học này trong quá khứ"
  },
  {
    "id": 28431,
    "book": "isaiah                                  ",
    "chapter": "42",
    "verse": "24",
    "text": "Ai cho phép Ít-ra-ên bị cướp đoạt và đau đớn?"
  },
  {
    "id": 28432,
    "book": "isaiah                                  ",
    "chapter": "42",
    "verse": "25",
    "text": "Vì thế, Chúa đổ cơn đoán phạt42:25 Ctd sức nóng của cơn giận trên họ"
  }
]