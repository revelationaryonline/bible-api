[
  {
    "id": 27635,
    "book": "isaiah                                  ",
    "chapter": "3",
    "verse": "1",
    "text": "Chúa, Chúa Hằng Hữu Vạn Quân,"
  },
  {
    "id": 27636,
    "book": "isaiah                                  ",
    "chapter": "3",
    "verse": "2",
    "text": "tất cả anh hùng và chiến sĩ,"
  },
  {
    "id": 27637,
    "book": "isaiah                                  ",
    "chapter": "3",
    "verse": "3",
    "text": "quan chỉ huy quân đội và tướng lãnh,"
  },
  {
    "id": 27638,
    "book": "isaiah                                  ",
    "chapter": "3",
    "verse": "4",
    "text": "Ta sẽ khiến những bé trai lãnh đạo họ,"
  },
  {
    "id": 27639,
    "book": "isaiah                                  ",
    "chapter": "3",
    "verse": "5",
    "text": "Dân chúng áp bức nhau—"
  },
  {
    "id": 27640,
    "book": "isaiah                                  ",
    "chapter": "3",
    "verse": "6",
    "text": "Trong những ngày ấy, một người sẽ nói với anh em của mình:"
  },
  {
    "id": 27641,
    "book": "isaiah                                  ",
    "chapter": "3",
    "verse": "7",
    "text": "Nhưng người ấy đáp:"
  },
  {
    "id": 27642,
    "book": "isaiah                                  ",
    "chapter": "3",
    "verse": "8",
    "text": "Bởi Giê-ru-sa-lem sẽ chao đảo,"
  },
  {
    "id": 27643,
    "book": "isaiah                                  ",
    "chapter": "3",
    "verse": "9",
    "text": "Sắc mặt họ đủ làm chứng cớ buộc tội họ."
  },
  {
    "id": 27644,
    "book": "isaiah                                  ",
    "chapter": "3",
    "verse": "10",
    "text": "Hãy nói với những người tin kính rằng"
  },
  {
    "id": 27645,
    "book": "isaiah                                  ",
    "chapter": "3",
    "verse": "11",
    "text": "Nhưng khốn thay cho người gian ác,"
  },
  {
    "id": 27646,
    "book": "isaiah                                  ",
    "chapter": "3",
    "verse": "12",
    "text": "Dân ta bị bọn trẻ áp bức"
  },
  {
    "id": 27647,
    "book": "isaiah                                  ",
    "chapter": "3",
    "verse": "13",
    "text": "Chúa Hằng Hữu ngự tại tòa phán xét"
  },
  {
    "id": 27648,
    "book": "isaiah                                  ",
    "chapter": "3",
    "verse": "14",
    "text": "Chúa Hằng Hữu đến để xét xử các trưởng lão"
  },
  {
    "id": 27649,
    "book": "isaiah                                  ",
    "chapter": "3",
    "verse": "15",
    "text": "Sao các ngươi dám đàn áp dân Ta,"
  },
  {
    "id": 27650,
    "book": "isaiah                                  ",
    "chapter": "3",
    "verse": "16",
    "text": "Chúa Hằng Hữu phán:"
  },
  {
    "id": 27651,
    "book": "isaiah                                  ",
    "chapter": "3",
    "verse": "17",
    "text": "Vì thế, Chúa sẽ làm cho đầu họ đóng vảy"
  },
  {
    "id": 27652,
    "book": "isaiah                                  ",
    "chapter": "3",
    "verse": "18",
    "text": "Trong ngày phán xét"
  },
  {
    "id": 27653,
    "book": "isaiah                                  ",
    "chapter": "3",
    "verse": "19",
    "text": "hoa tai, xuyến, và khăn che mặt;"
  },
  {
    "id": 27654,
    "book": "isaiah                                  ",
    "chapter": "3",
    "verse": "20",
    "text": "khăn choàng, vòng đeo chân, khăn thắt lưng,"
  },
  {
    "id": 27655,
    "book": "isaiah                                  ",
    "chapter": "3",
    "verse": "21",
    "text": "nhẫn, ngọc quý,"
  },
  {
    "id": 27656,
    "book": "isaiah                                  ",
    "chapter": "3",
    "verse": "22",
    "text": "trang phục dạ tiệc, áo dài, áo choàng, và túi,"
  },
  {
    "id": 27657,
    "book": "isaiah                                  ",
    "chapter": "3",
    "verse": "23",
    "text": "gương soi, vải gai mịn,"
  },
  {
    "id": 27658,
    "book": "isaiah                                  ",
    "chapter": "3",
    "verse": "24",
    "text": "Thay vì tỏa mùi thơm, ngươi sẽ bị hôi thối."
  },
  {
    "id": 27659,
    "book": "isaiah                                  ",
    "chapter": "3",
    "verse": "25",
    "text": "Những đàn ông trong thành sẽ bị giết bởi gươm,"
  },
  {
    "id": 27660,
    "book": "isaiah                                  ",
    "chapter": "3",
    "verse": "26",
    "text": "Các cổng Si-ôn sẽ khóc lóc và kêu than."
  }
]