[
  {
    "id": 27856,
    "book": "isaiah                                  ",
    "chapter": "14",
    "verse": "1",
    "text": "Nhưng Chúa Hằng Hữu sẽ đoái thương nhà Gia-cốp. Một lần nữa, Chúa sẽ chọn Ít-ra-ên như tuyển dân của Ngài. Chúa sẽ cho họ được định cư tại quê hương mình. Nhiều ngoại kiều sẽ hiệp với nhà Ít-ra-ên."
  },
  {
    "id": 27857,
    "book": "isaiah                                  ",
    "chapter": "14",
    "verse": "2",
    "text": "Các nước trên thế giới sẽ giúp dân của Chúa Hằng Hữu hồi hương, và những ai đến sống trên đất họ sẽ phục vụ họ. Những ai đã bắt Ít-ra-ên làm tù binh sẽ bị bắt làm tù binh, và Ít-ra-ên sẽ thống trị những thù nghịch từng áp bức họ."
  },
  {
    "id": 27858,
    "book": "isaiah                                  ",
    "chapter": "14",
    "verse": "3",
    "text": "Trong ngày phước hạnh ấy, Chúa Hằng Hữu sẽ cho dân Ngài an nghỉ, không còn đau khổ, bối rối, và bị chủ nô đày đọa nữa,"
  },
  {
    "id": 27859,
    "book": "isaiah                                  ",
    "chapter": "14",
    "verse": "4",
    "text": "các con sẽ hát bài ca này về vua Ba-by-lôn:"
  },
  {
    "id": 27860,
    "book": "isaiah                                  ",
    "chapter": "14",
    "verse": "5",
    "text": "Vì Chúa Hằng Hữu đã bẻ cây gậy của kẻ ác,"
  },
  {
    "id": 27861,
    "book": "isaiah                                  ",
    "chapter": "14",
    "verse": "6",
    "text": "Là kẻ đã đánh đập các dân không ngừng,"
  },
  {
    "id": 27862,
    "book": "isaiah                                  ",
    "chapter": "14",
    "verse": "7",
    "text": "Nhưng cuối cùng thế giới đều nghỉ ngơi và an bình."
  },
  {
    "id": 27863,
    "book": "isaiah                                  ",
    "chapter": "14",
    "verse": "8",
    "text": "Cả đến các cây cao to nơi rừng xanh—"
  },
  {
    "id": 27864,
    "book": "isaiah                                  ",
    "chapter": "14",
    "verse": "9",
    "text": "Trong nơi của cõi chết xôn xao khi ngươi đến."
  },
  {
    "id": 27865,
    "book": "isaiah                                  ",
    "chapter": "14",
    "verse": "10",
    "text": "Tất cả đều hỏi ngươi:"
  },
  {
    "id": 27866,
    "book": "isaiah                                  ",
    "chapter": "14",
    "verse": "11",
    "text": "Sự hùng mạnh và quyền lực của ngươi đã bị chôn với ngươi."
  },
  {
    "id": 27867,
    "book": "isaiah                                  ",
    "chapter": "14",
    "verse": "12",
    "text": "Hỡi sao mai, con trai của rạng đông,"
  },
  {
    "id": 27868,
    "book": "isaiah                                  ",
    "chapter": "14",
    "verse": "13",
    "text": "Ngươi tự nhủ trong lòng:"
  },
  {
    "id": 27869,
    "book": "isaiah                                  ",
    "chapter": "14",
    "verse": "14",
    "text": "Ta sẽ lên cao hơn các đám mây"
  },
  {
    "id": 27870,
    "book": "isaiah                                  ",
    "chapter": "14",
    "verse": "15",
    "text": "Nhưng trái lại, ngươi sẽ bị đem xuống cõi chết,"
  },
  {
    "id": 27871,
    "book": "isaiah                                  ",
    "chapter": "14",
    "verse": "16",
    "text": "Những ai gặp sẽ nhìn ngươi chăm chú và hỏi:"
  },
  {
    "id": 27872,
    "book": "isaiah                                  ",
    "chapter": "14",
    "verse": "17",
    "text": "Có phải đây là kẻ đã tàn phá thế giới"
  },
  {
    "id": 27873,
    "book": "isaiah                                  ",
    "chapter": "14",
    "verse": "18",
    "text": "Tất cả vua chúa các nước đều được an táng"
  },
  {
    "id": 27874,
    "book": "isaiah                                  ",
    "chapter": "14",
    "verse": "19",
    "text": "nhưng ngươi sẽ bị ném khỏi mồ mả như một cành cây mục,"
  },
  {
    "id": 27875,
    "book": "isaiah                                  ",
    "chapter": "14",
    "verse": "20",
    "text": "Ngươi sẽ không được an táng với tổ tiên"
  },
  {
    "id": 27876,
    "book": "isaiah                                  ",
    "chapter": "14",
    "verse": "21",
    "text": "Hãy giết các con của chúng!"
  },
  {
    "id": 27877,
    "book": "isaiah                                  ",
    "chapter": "14",
    "verse": "22",
    "text": "Đây là điều Chúa Hằng Hữu Vạn Quân phán:"
  },
  {
    "id": 27878,
    "book": "isaiah                                  ",
    "chapter": "14",
    "verse": "23",
    "text": "“Ta sẽ khiến Ba-by-lôn thành nơi ở của cú vọ,"
  },
  {
    "id": 27879,
    "book": "isaiah                                  ",
    "chapter": "14",
    "verse": "24",
    "text": "Chúa Hằng Hữu Vạn Quân đã thề:"
  },
  {
    "id": 27880,
    "book": "isaiah                                  ",
    "chapter": "14",
    "verse": "25",
    "text": "Ta sẽ đánh tan quân A-sy-ri khi chúng vào Ít-ra-ên;"
  },
  {
    "id": 27881,
    "book": "isaiah                                  ",
    "chapter": "14",
    "verse": "26",
    "text": "Đây là chương trình Ta ấn định cho cả đất,"
  },
  {
    "id": 27882,
    "book": "isaiah                                  ",
    "chapter": "14",
    "verse": "27",
    "text": "Vì khi Chúa Hằng Hữu Vạn Quân đã phán—"
  },
  {
    "id": 27883,
    "book": "isaiah                                  ",
    "chapter": "14",
    "verse": "28",
    "text": "Lời tiên tri này đến với tôi vào năm Vua A-cha qua đời:"
  },
  {
    "id": 27884,
    "book": "isaiah                                  ",
    "chapter": "14",
    "verse": "29",
    "text": "Hỡi Phi-li-tin! Đừng reo mừng"
  },
  {
    "id": 27885,
    "book": "isaiah                                  ",
    "chapter": "14",
    "verse": "30",
    "text": "Ta sẽ nuôi người nghèo trong đồng cỏ của Ta;"
  },
  {
    "id": 27886,
    "book": "isaiah                                  ",
    "chapter": "14",
    "verse": "31",
    "text": "Hãy than van nơi cổng! Hãy kêu khóc trong các thành!"
  },
  {
    "id": 27887,
    "book": "isaiah                                  ",
    "chapter": "14",
    "verse": "32",
    "text": "Chúng tôi phải nói gì với người Phi-li-tin? Hãy bảo chúng:"
  }
]