[
  {
    "id": 28207,
    "book": "isaiah                                  ",
    "chapter": "33",
    "verse": "1",
    "text": "Khốn cho ngươi là người A-sy-ri, ngươi hủy diệt người khác"
  },
  {
    "id": 28208,
    "book": "isaiah                                  ",
    "chapter": "33",
    "verse": "2",
    "text": "Nhưng lạy Chúa Hằng Hữu, xin thương xót chúng con"
  },
  {
    "id": 28209,
    "book": "isaiah                                  ",
    "chapter": "33",
    "verse": "3",
    "text": "Quân thù bỏ chạy khi vừa nghe tiếng Chúa."
  },
  {
    "id": 28210,
    "book": "isaiah                                  ",
    "chapter": "33",
    "verse": "4",
    "text": "Như sâu bọ và cào cào hủy phá ruộng và dây nho,"
  },
  {
    "id": 28211,
    "book": "isaiah                                  ",
    "chapter": "33",
    "verse": "5",
    "text": "Chúa Hằng Hữu được tôn cao và Ngài ngự trên các tầng trời,"
  },
  {
    "id": 28212,
    "book": "isaiah                                  ",
    "chapter": "33",
    "verse": "6",
    "text": "Trong ngày ấy Chúa sẽ là nền tảng vững chắc cho các ngươi,"
  },
  {
    "id": 28213,
    "book": "isaiah                                  ",
    "chapter": "33",
    "verse": "7",
    "text": "Nhưng này, các dũng sĩ kêu than ngoài đường phố."
  },
  {
    "id": 28214,
    "book": "isaiah                                  ",
    "chapter": "33",
    "verse": "8",
    "text": "Đường sá vắng tanh;"
  },
  {
    "id": 28215,
    "book": "isaiah                                  ",
    "chapter": "33",
    "verse": "9",
    "text": "Đất Ít-ra-ên thở than sầu thảm."
  },
  {
    "id": 28216,
    "book": "isaiah                                  ",
    "chapter": "33",
    "verse": "10",
    "text": "Nhưng Chúa Hằng Hữu phán: “Bây giờ Ta sẽ đứng dậy!"
  },
  {
    "id": 28217,
    "book": "isaiah                                  ",
    "chapter": "33",
    "verse": "11",
    "text": "Các ngươi, A-sy-ri không sinh sản gì, chỉ toàn cỏ khô và rơm rạ."
  },
  {
    "id": 28218,
    "book": "isaiah                                  ",
    "chapter": "33",
    "verse": "12",
    "text": "Dân của ngươi sẽ bị thiêu cháy hoàn toàn,"
  },
  {
    "id": 28219,
    "book": "isaiah                                  ",
    "chapter": "33",
    "verse": "13",
    "text": "Các dân tộc ở xa, hãy nghe rõ các việc Ta làm!"
  },
  {
    "id": 28220,
    "book": "isaiah                                  ",
    "chapter": "33",
    "verse": "14",
    "text": "Các tội nhân ở Giê-ru-sa-lem đều run rẩy kinh hãi."
  },
  {
    "id": 28221,
    "book": "isaiah                                  ",
    "chapter": "33",
    "verse": "15",
    "text": "Những ai sống ngay thẳng và công bằng,"
  },
  {
    "id": 28222,
    "book": "isaiah                                  ",
    "chapter": "33",
    "verse": "16",
    "text": "những người này sẽ ngự ở trên cao."
  },
  {
    "id": 28223,
    "book": "isaiah                                  ",
    "chapter": "33",
    "verse": "17",
    "text": "Mắt các ngươi sẽ thấy vua trong oai nghi,"
  },
  {
    "id": 28224,
    "book": "isaiah                                  ",
    "chapter": "33",
    "verse": "18",
    "text": "Các ngươi sẽ suy ngẫm về thời gian khủng khiếp và hỏi:"
  },
  {
    "id": 28225,
    "book": "isaiah                                  ",
    "chapter": "33",
    "verse": "19",
    "text": "Các ngươi sẽ không còn thấy dân hung tợn, dữ dằn"
  },
  {
    "id": 28226,
    "book": "isaiah                                  ",
    "chapter": "33",
    "verse": "20",
    "text": "Thay vào đó, các ngươi sẽ thấy Si-ôn là nơi tổ chức lễ hội trọng thể."
  },
  {
    "id": 28227,
    "book": "isaiah                                  ",
    "chapter": "33",
    "verse": "21",
    "text": "Chúa Hằng Hữu sẽ là Đấng Oai Nghi của chúng ta."
  },
  {
    "id": 28228,
    "book": "isaiah                                  ",
    "chapter": "33",
    "verse": "22",
    "text": "Vì Chúa Hằng Hữu là Thẩm Phán của chúng ta,"
  },
  {
    "id": 28229,
    "book": "isaiah                                  ",
    "chapter": "33",
    "verse": "23",
    "text": "Dây buộc chiến thuyền của kẻ thù đã tuột"
  },
  {
    "id": 28230,
    "book": "isaiah                                  ",
    "chapter": "33",
    "verse": "24",
    "text": "Người Ít-ra-ên sẽ không còn nói:"
  }
]