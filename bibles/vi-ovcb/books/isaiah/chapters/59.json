[
  {
    "id": 28728,
    "book": "isaiah                                  ",
    "chapter": "59",
    "verse": "1",
    "text": "Này! Tay Chúa Hằng Hữu không phải yếu đuối mà không cứu được,"
  },
  {
    "id": 28729,
    "book": "isaiah                                  ",
    "chapter": "59",
    "verse": "2",
    "text": "Nhưng tội lỗi ngươi đã phân cách ngươi khỏi Đức Chúa Trời."
  },
  {
    "id": 28730,
    "book": "isaiah                                  ",
    "chapter": "59",
    "verse": "3",
    "text": "Bàn tay ngươi là tay của kẻ giết người,"
  },
  {
    "id": 28731,
    "book": "isaiah                                  ",
    "chapter": "59",
    "verse": "4",
    "text": "Không còn ai quan tâm về công lý và sự chân thật."
  },
  {
    "id": 28732,
    "book": "isaiah                                  ",
    "chapter": "59",
    "verse": "5",
    "text": "Chúng nó ấp trứng rắn, dệt màng nhện."
  },
  {
    "id": 28733,
    "book": "isaiah                                  ",
    "chapter": "59",
    "verse": "6",
    "text": "Màng dệt chúng không thể làm trang phục,"
  },
  {
    "id": 28734,
    "book": "isaiah                                  ",
    "chapter": "59",
    "verse": "7",
    "text": "Chúng nhanh chân chạy vào đường tội ác,"
  },
  {
    "id": 28735,
    "book": "isaiah                                  ",
    "chapter": "59",
    "verse": "8",
    "text": "Chúng không biết tìm bình an nơi đâu"
  },
  {
    "id": 28736,
    "book": "isaiah                                  ",
    "chapter": "59",
    "verse": "9",
    "text": "Vì thế, không có công lý giữa chúng ta"
  },
  {
    "id": 28737,
    "book": "isaiah                                  ",
    "chapter": "59",
    "verse": "10",
    "text": "Chúng ta sờ soạng như người mù mò theo tường,"
  },
  {
    "id": 28738,
    "book": "isaiah                                  ",
    "chapter": "59",
    "verse": "11",
    "text": "Chúng ta gầm gừ như gấu đói;"
  },
  {
    "id": 28739,
    "book": "isaiah                                  ",
    "chapter": "59",
    "verse": "12",
    "text": "Vì tội lỗi của chúng ta phạm quá nhiều trước mặt Đức Chúa Trời"
  },
  {
    "id": 28740,
    "book": "isaiah                                  ",
    "chapter": "59",
    "verse": "13",
    "text": "Chúng ta biết mình đã phản nghịch và khước từ Chúa Hằng Hữu."
  },
  {
    "id": 28741,
    "book": "isaiah                                  ",
    "chapter": "59",
    "verse": "14",
    "text": "Tòa án của chúng ta đẩy lui công chính,"
  },
  {
    "id": 28742,
    "book": "isaiah                                  ",
    "chapter": "59",
    "verse": "15",
    "text": "Phải, chân lý không còn nữa,"
  },
  {
    "id": 28743,
    "book": "isaiah                                  ",
    "chapter": "59",
    "verse": "16",
    "text": "Chúa ngạc nhiên khi thấy không ai dám đứng ra"
  },
  {
    "id": 28744,
    "book": "isaiah                                  ",
    "chapter": "59",
    "verse": "17",
    "text": "Chúa khoác lên mình áo giáp công chính,"
  },
  {
    "id": 28745,
    "book": "isaiah                                  ",
    "chapter": "59",
    "verse": "18",
    "text": "Chúa sẽ báo trả mỗi người tùy theo việc chúng làm."
  },
  {
    "id": 28746,
    "book": "isaiah                                  ",
    "chapter": "59",
    "verse": "19",
    "text": "Từ phương tây, người ta sẽ kính sợ Danh Chúa Hằng Hữu;"
  },
  {
    "id": 28747,
    "book": "isaiah                                  ",
    "chapter": "59",
    "verse": "20",
    "text": "“Đấng Cứu Chuộc sẽ đến Si-ôn"
  },
  {
    "id": 28748,
    "book": "isaiah                                  ",
    "chapter": "59",
    "verse": "21",
    "text": "Chúa Hằng Hữu phán: “Đây là giao ước Ta lập với họ, Thần Ta đang ở trên các con, lời Ta đã đặt vào lưỡi59:21 Nt miệng các con sẽ mãi mãi tồn tại trên môi miệng các con và môi miệng con cháu, chắt chít của các con, từ bây giờ cho đến đời đời. Ta, Chúa Hằng Hữu, đã phán!”"
  }
]