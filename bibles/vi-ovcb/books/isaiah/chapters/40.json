[
  {
    "id": 28348,
    "book": "isaiah                                  ",
    "chapter": "40",
    "verse": "1",
    "text": "Đức Chúa Trời của các ngươi phán:"
  },
  {
    "id": 28349,
    "book": "isaiah                                  ",
    "chapter": "40",
    "verse": "2",
    "text": "Hãy nói với Giê-ru-sa-lem cách dịu dàng."
  },
  {
    "id": 28350,
    "book": "isaiah                                  ",
    "chapter": "40",
    "verse": "3",
    "text": "Hãy lắng nghe! Có tiếng ai gọi lớn:"
  },
  {
    "id": 28351,
    "book": "isaiah                                  ",
    "chapter": "40",
    "verse": "4",
    "text": "Hãy lấp cho đầy các thung lũng,"
  },
  {
    "id": 28352,
    "book": "isaiah                                  ",
    "chapter": "40",
    "verse": "5",
    "text": "Lúc ấy, vinh quang Chúa Hằng Hữu sẽ hiện ra"
  },
  {
    "id": 28353,
    "book": "isaiah                                  ",
    "chapter": "40",
    "verse": "6",
    "text": "Có tiếng gọi: “Hãy kêu lên!”"
  },
  {
    "id": 28354,
    "book": "isaiah                                  ",
    "chapter": "40",
    "verse": "7",
    "text": "Cỏ khô héo và hoa úa tàn"
  },
  {
    "id": 28355,
    "book": "isaiah                                  ",
    "chapter": "40",
    "verse": "8",
    "text": "Cỏ khô héo và hoa úa tàn,"
  },
  {
    "id": 28356,
    "book": "isaiah                                  ",
    "chapter": "40",
    "verse": "9",
    "text": "Hỡi Si-ôn, là sứ giả báo tin mừng,"
  },
  {
    "id": 28357,
    "book": "isaiah                                  ",
    "chapter": "40",
    "verse": "10",
    "text": "Phải, Chúa Hằng Hữu Chí Cao đang đến trong quyền năng."
  },
  {
    "id": 28358,
    "book": "isaiah                                  ",
    "chapter": "40",
    "verse": "11",
    "text": "Chúa sẽ chăn bầy Ngài như người chăn."
  },
  {
    "id": 28359,
    "book": "isaiah                                  ",
    "chapter": "40",
    "verse": "12",
    "text": "Ai đã lường nước biển với lòng bàn tay?"
  },
  {
    "id": 28360,
    "book": "isaiah                                  ",
    "chapter": "40",
    "verse": "13",
    "text": "Ai có thể khuyên bảo Thần của Chúa Hằng Hữu?"
  },
  {
    "id": 28361,
    "book": "isaiah                                  ",
    "chapter": "40",
    "verse": "14",
    "text": "Chúa Hằng Hữu có bao giờ cần ý kiến của ai chăng?"
  },
  {
    "id": 28362,
    "book": "isaiah                                  ",
    "chapter": "40",
    "verse": "15",
    "text": "Không, vì tất cả dân tộc trên thế giới"
  },
  {
    "id": 28363,
    "book": "isaiah                                  ",
    "chapter": "40",
    "verse": "16",
    "text": "Tất cả gỗ trong rừng Li-ban"
  },
  {
    "id": 28364,
    "book": "isaiah                                  ",
    "chapter": "40",
    "verse": "17",
    "text": "Mọi dân tộc trên thế giới đều vô nghĩa với Chúa."
  },
  {
    "id": 28365,
    "book": "isaiah                                  ",
    "chapter": "40",
    "verse": "18",
    "text": "Các ngươi so sánh Đức Chúa Trời với ai?"
  },
  {
    "id": 28366,
    "book": "isaiah                                  ",
    "chapter": "40",
    "verse": "19",
    "text": "Có thể so sánh Ngài với tượng thần bằng đất,"
  },
  {
    "id": 28367,
    "book": "isaiah                                  ",
    "chapter": "40",
    "verse": "20",
    "text": "Hay nếu người nghèo không có tiền thuê đúc tượng,"
  },
  {
    "id": 28368,
    "book": "isaiah                                  ",
    "chapter": "40",
    "verse": "21",
    "text": "Các ngươi không nghe? Các ngươi không hiểu sao?"
  },
  {
    "id": 28369,
    "book": "isaiah                                  ",
    "chapter": "40",
    "verse": "22",
    "text": "Đức Chúa Trời ngự trên vòm trời."
  },
  {
    "id": 28370,
    "book": "isaiah                                  ",
    "chapter": "40",
    "verse": "23",
    "text": "Ngài làm cho quan quyền trở thành vô hiệu"
  },
  {
    "id": 28371,
    "book": "isaiah                                  ",
    "chapter": "40",
    "verse": "24",
    "text": "Chúng giống như cây mới mọc, chưa đâm rễ,"
  },
  {
    "id": 28372,
    "book": "isaiah                                  ",
    "chapter": "40",
    "verse": "25",
    "text": "Đấng Thánh hỏi: “Vậy, các con ví sánh Ta với ai?"
  },
  {
    "id": 28373,
    "book": "isaiah                                  ",
    "chapter": "40",
    "verse": "26",
    "text": "Hãy ngước mắt nhìn các tầng trời."
  },
  {
    "id": 28374,
    "book": "isaiah                                  ",
    "chapter": "40",
    "verse": "27",
    "text": "Hỡi Gia-cốp, sao ngươi nói Chúa Hằng Hữu không lưu tâm đến hoạn nạn ngươi?"
  },
  {
    "id": 28375,
    "book": "isaiah                                  ",
    "chapter": "40",
    "verse": "28",
    "text": "Có phải các ngươi chưa bao giờ nghe?"
  },
  {
    "id": 28376,
    "book": "isaiah                                  ",
    "chapter": "40",
    "verse": "29",
    "text": "Ngài ban năng lực cho người bất lực,"
  },
  {
    "id": 28377,
    "book": "isaiah                                  ",
    "chapter": "40",
    "verse": "30",
    "text": "Dù thiếu niên sẽ trở nên yếu đuối và mệt nhọc,"
  },
  {
    "id": 28378,
    "book": "isaiah                                  ",
    "chapter": "40",
    "verse": "31",
    "text": "Nhưng tin cậy Chúa Hằng Hữu thì sẽ được sức mới."
  }
]