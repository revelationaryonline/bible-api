[
  {
    "id": 28668,
    "book": "isaiah                                  ",
    "chapter": "55",
    "verse": "1",
    "text": "“Có ai đang khát?"
  },
  {
    "id": 28669,
    "book": "isaiah                                  ",
    "chapter": "55",
    "verse": "2",
    "text": "Sao phải chi tiền cho thực phẩm không làm các con mạnh?"
  },
  {
    "id": 28670,
    "book": "isaiah                                  ",
    "chapter": "55",
    "verse": "3",
    "text": "Hãy đến gần và mở rộng đôi tai của các con."
  },
  {
    "id": 28671,
    "book": "isaiah                                  ",
    "chapter": "55",
    "verse": "4",
    "text": "Nhìn xem, Ta đã dùng người để bày tỏ quyền năng của Ta giữa các dân tộc."
  },
  {
    "id": 28672,
    "book": "isaiah                                  ",
    "chapter": "55",
    "verse": "5",
    "text": "Ta cũng sẽ ra lệnh các quốc gia mà con không quen biết,"
  },
  {
    "id": 28673,
    "book": "isaiah                                  ",
    "chapter": "55",
    "verse": "6",
    "text": "Hãy tìm kiếm Chúa Hằng Hữu đương khi còn cơ hội gặp."
  },
  {
    "id": 28674,
    "book": "isaiah                                  ",
    "chapter": "55",
    "verse": "7",
    "text": "Hãy bỏ những việc gian ác,"
  },
  {
    "id": 28675,
    "book": "isaiah                                  ",
    "chapter": "55",
    "verse": "8",
    "text": "Chúa Hằng Hữu phán: “Ý tưởng Ta khác hẳn ý tưởng các con."
  },
  {
    "id": 28676,
    "book": "isaiah                                  ",
    "chapter": "55",
    "verse": "9",
    "text": "Vì như các trời cao hơn đất bao nhiêu,"
  },
  {
    "id": 28677,
    "book": "isaiah                                  ",
    "chapter": "55",
    "verse": "10",
    "text": "Như mưa và tuyết rơi từ trời xuống,"
  },
  {
    "id": 28678,
    "book": "isaiah                                  ",
    "chapter": "55",
    "verse": "11",
    "text": "Thì lời của Ta cũng vậy,"
  },
  {
    "id": 28679,
    "book": "isaiah                                  ",
    "chapter": "55",
    "verse": "12",
