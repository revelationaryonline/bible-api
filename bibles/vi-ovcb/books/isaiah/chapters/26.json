[
  {
    "id": 28058,
    "book": "isaiah                                  ",
    "chapter": "26",
    "verse": "1",
    "text": "Trong ngày ấy, mọi người trong đất Giu-đa sẽ hát bài ca này:"
  },
  {
    "id": 28059,
    "book": "isaiah                                  ",
    "chapter": "26",
    "verse": "2",
    "text": "Hãy mở các cổng thành cho những ai công chính"
  },
  {
    "id": 28060,
    "book": "isaiah                                  ",
    "chapter": "26",
    "verse": "3",
    "text": "Chúa sẽ bảo vệ an bình toàn vẹn"
  },
  {
    "id": 28061,
    "book": "isaiah                                  ",
    "chapter": "26",
    "verse": "4",
    "text": "Hãy tin cậy Chúa Hằng Hữu mãi mãi"
  },
  {
    "id": 28062,
    "book": "isaiah                                  ",
    "chapter": "26",
    "verse": "5",
    "text": "Chúa hạ thấp những kẻ cao ngạo"
  },
  {
    "id": 28063,
    "book": "isaiah                                  ",
    "chapter": "26",
    "verse": "6",
    "text": "Người nghèo và người bị áp bức sẽ chà đạp nó dưới chân,"
  },
  {
    "id": 28064,
    "book": "isaiah                                  ",
    "chapter": "26",
    "verse": "7",
    "text": "Đường của người công chính"
  },
  {
    "id": 28065,
    "book": "isaiah                                  ",
    "chapter": "26",
    "verse": "8",
    "text": "Vâng, thưa Chúa Hằng Hữu,"
  },
  {
    "id": 28066,
    "book": "isaiah                                  ",
    "chapter": "26",
    "verse": "9",
    "text": "Ban đêm tâm hồn con khao khát Ngài;"
  },
  {
    "id": 28067,
    "book": "isaiah                                  ",
    "chapter": "26",
    "verse": "10",
    "text": "Sự nhân từ Ngài cho người ác,"
  },
  {
    "id": 28068,
    "book": "isaiah                                  ",
    "chapter": "26",
    "verse": "11",
    "text": "Lạy Chúa Hằng Hữu, tay Ngài đã đưa cao mà chúng vẫn không thấy."
  },
  {
    "id": 28069,
    "book": "isaiah                                  ",
    "chapter": "26",
    "verse": "12",
    "text": "Lạy Chúa Hằng Hữu, Chúa sẽ cho chúng con hưởng thái bình;"
  },
  {
    "id": 28070,
    "book": "isaiah                                  ",
    "chapter": "26",
    "verse": "13",
    "text": "Chúa Hằng Hữu, là Đức Chúa Trời chúng con,"
  },
  {
    "id": 28071,
    "book": "isaiah                                  ",
    "chapter": "26",
    "verse": "14",
    "text": "Những người mà chúng con phục vụ trước đây đã chết và không còn nữa."
  },
  {
    "id": 28072,
    "book": "isaiah                                  ",
    "chapter": "26",
    "verse": "15",
    "text": "Lạy Chúa Hằng Hữu, Ngài đã khiến vương quốc chúng con vĩ đại;"
  },
  {
    "id": 28073,
    "book": "isaiah                                  ",
    "chapter": "26",
    "verse": "16",
    "text": "Lạy Chúa Hằng Hữu, trong cảnh hoạn nạn chúng con đã tìm kiếm Chúa."
  },
  {
    "id": 28074,
    "book": "isaiah                                  ",
    "chapter": "26",
    "verse": "17",
    "text": "Như đàn bà thai nghén quằn quại"
  },
  {
    "id": 28075,
    "book": "isaiah                                  ",
    "chapter": "26",
    "verse": "18",
    "text": "Chúng con cũng thai nghén,"
  },
  {
    "id": 28076,
    "book": "isaiah                                  ",
    "chapter": "26",
    "verse": "19",
    "text": "Nhưng những người chết trong Chúa Hằng Hữu sẽ sống;"
  },
  {
    "id": 28077,
    "book": "isaiah                                  ",
    "chapter": "26",
    "verse": "20",
    "text": "Hỡi dân Ta, hãy về nhà và đóng cửa lại!"
  },
  {
    "id": 28078,
    "book": "isaiah                                  ",
    "chapter": "26",
    "verse": "21",
    "text": "Kìa! Chúa Hằng Hữu đang từ trời ngự xuống"
  }
]