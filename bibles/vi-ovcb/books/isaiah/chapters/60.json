[
  {
    "id": 28749,
    "book": "isaiah                                  ",
    "chapter": "60",
    "verse": "1",
    "text": "“Hãy vùng dậy, Giê-ru-sa-lem! Hãy chiếu sáng cho mọi người nhìn thấy."
  },
  {
    "id": 28750,
    "book": "isaiah                                  ",
    "chapter": "60",
    "verse": "2",
    "text": "Bóng tối dày đặc đang bao trùm các dân tộc trên đất,"
  },
  {
    "id": 28751,
    "book": "isaiah                                  ",
    "chapter": "60",
    "verse": "3",
    "text": "Các dân tộc sẽ tìm đến ánh sáng ngươi;"
  },
  {
    "id": 28752,
    "book": "isaiah                                  ",
    "chapter": "60",
    "verse": "4",
    "text": "Hãy ngước mắt nhìn quanh, vì mọi người đang kéo về với ngươi!"
  },
  {
    "id": 28753,
    "book": "isaiah                                  ",
    "chapter": "60",
    "verse": "5",
    "text": "Mắt ngươi sẽ rạng rỡ,"
  },
  {
    "id": 28754,
    "book": "isaiah                                  ",
    "chapter": "60",
    "verse": "6",
    "text": "Đoàn lạc đà đông đảo sẽ kéo đến với ngươi,"
  },
  {
    "id": 28755,
    "book": "isaiah                                  ",
    "chapter": "60",
    "verse": "7",
    "text": "Các bầy vật xứ Kê-đa cũng sẽ về tay ngươi,"
  },
  {
    "id": 28756,
    "book": "isaiah                                  ",
    "chapter": "60",
    "verse": "8",
    "text": "Ta thấy ai đang bay như mây về Ít-ra-ên,"
  },
  {
    "id": 28757,
    "book": "isaiah                                  ",
    "chapter": "60",
    "verse": "9",
    "text": "Họ xuống tàu từ tận cùng trái đất,"
  },
  {
    "id": 28758,
    "book": "isaiah                                  ",
    "chapter": "60",
    "verse": "10",
    "text": "Người nước ngoài sẽ xây lại các tường lũy ngươi,"
  },
  {
    "id": 28759,
    "book": "isaiah                                  ",
    "chapter": "60",
    "verse": "11",
    "text": "Các cửa thành ngươi sẽ mở cả ngày đêm"
  },
  {
    "id": 28760,
    "book": "isaiah                                  ",
    "chapter": "60",
    "verse": "12",
    "text": "Những dân tộc nào không phục vụ ngươi"
  },
  {
    "id": 28761,
    "book": "isaiah                                  ",
    "chapter": "60",
    "verse": "13",
    "text": "Vinh quang của Li-ban thuộc về ngươi—"
  },
  {
    "id": 28762,
    "book": "isaiah                                  ",
    "chapter": "60",
    "verse": "14",
    "text": "Dòng dõi những người áp bức ngươi"
  },
  {
    "id": 28763,
    "book": "isaiah                                  ",
    "chapter": "60",
    "verse": "15",
    "text": "Xứ sở ngươi không còn bị khinh miệt và ghét bỏ"
  },
  {
    "id": 28764,
    "book": "isaiah                                  ",
    "chapter": "60",
    "verse": "16",
    "text": "Các vua quyền lực và các quốc gia hùng cường"
  },
  {
    "id": 28765,
    "book": "isaiah                                  ",
    "chapter": "60",
    "verse": "17",
    "text": "Ta sẽ cho ngươi vàng thay đồng,"
  },
  {
    "id": 28766,
    "book": "isaiah                                  ",
    "chapter": "60",
    "verse": "18",
    "text": "Đất nước ngươi sẽ không còn nghe chuyện áp bức, hung tàn;"
  },
  {
    "id": 28767,
    "book": "isaiah                                  ",
    "chapter": "60",
    "verse": "19",
    "text": "Ban ngày, ngươi sẽ không cần ánh sáng mặt trời,"
  },
  {
    "id": 28768,
    "book": "isaiah                                  ",
    "chapter": "60",
    "verse": "20",
    "text": "Mặt trời ngươi sẽ không lặn nữa;"
  },
  {
    "id": 28769,
    "book": "isaiah                                  ",
    "chapter": "60",
    "verse": "21",
    "text": "Tất cả dân ngươi sẽ là người công chính."
  },
  {
    "id": 28770,
    "book": "isaiah                                  ",
    "chapter": "60",
    "verse": "22",
    "text": "Một gia đình nhỏ bé nhất cũng sẽ sinh ra cả nghìn con cháu,"
  }
]