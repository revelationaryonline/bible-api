[
  {
    "id": 28651,
    "book": "isaiah                                  ",
    "chapter": "54",
    "verse": "1",
    "text": "“Hãy hát xướng, hỡi phụ nữ hiếm muộn,"
  },
  {
    "id": 28652,
    "book": "isaiah                                  ",
    "chapter": "54",
    "verse": "2",
    "text": "“Hãy nới rộng lều; căng trại rộng thêm, đừng giới hạn."
  },
  {
    "id": 28653,
    "book": "isaiah                                  ",
    "chapter": "54",
    "verse": "3",
    "text": "Vì bờ cõi ngươi sẽ phát triển cả bên trái lẫn bên phải."
  },
  {
    "id": 28654,
    "book": "isaiah                                  ",
    "chapter": "54",
    "verse": "4",
    "text": "Chớ sợ; ngươi không còn bị nhục nữa."
  },
  {
    "id": 28655,
    "book": "isaiah                                  ",
    "chapter": "54",
    "verse": "5",
    "text": "Vì Đấng Tạo Hóa ngươi sẽ là chồng ngươi;"
  },
  {
    "id": 28656,
    "book": "isaiah                                  ",
    "chapter": "54",
    "verse": "6",
    "text": "Vì Chúa Hằng Hữu đã gọi ngươi về từ sầu khổ—"
  },
  {
    "id": 28657,
    "book": "isaiah                                  ",
    "chapter": "54",
    "verse": "7",
    "text": "“Ta chỉ bỏ ngươi trong chốc lát,"
  },
  {
    "id": 28658,
    "book": "isaiah                                  ",
    "chapter": "54",
    "verse": "8",
    "text": "Trong lúc giận, Ta xây mặt không nhìn ngươi."
  },
  {
    "id": 28659,
    "book": "isaiah                                  ",
    "chapter": "54",
    "verse": "9",
    "text": "“Như thời Nô-ê, Ta đã thề"
  },
  {
    "id": 28660,
    "book": "isaiah                                  ",
    "chapter": "54",
    "verse": "10",
    "text": "Dù cho núi có thể dời"
  },
  {
    "id": 28661,
    "book": "isaiah                                  ",
    "chapter": "54",
    "verse": "11",
    "text": "“Hỡi những người đang ưu phiền sầu khổ,"
  },
  {
    "id": 28662,
    "book": "isaiah                                  ",
    "chapter": "54",
    "verse": "12",
    "text": "Ta sẽ xây các tháp ngươi bằng hồng ngọc,"
  },
  {
    "id": 28663,
    "book": "isaiah                                  ",
    "chapter": "54",
    "verse": "13",
    "text": "Ta sẽ dạy dỗ tất cả con cái ngươi,"
  },
  {
    "id": 28664,
    "book": "isaiah                                  ",
    "chapter": "54",
    "verse": "14",
    "text": "Ngươi sẽ được vững lập trong sự công chính và công bằng."
  },
  {
    "id": 28665,
    "book": "isaiah                                  ",
    "chapter": "54",
    "verse": "15",
    "text": "Nếu quốc gia nào tiến đánh ngươi,"
  },
  {
    "id": 28666,
    "book": "isaiah                                  ",
    "chapter": "54",
    "verse": "16",
    "text": "Này! Ta đã tạo ra thợ rèn,"
