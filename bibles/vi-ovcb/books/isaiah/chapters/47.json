[
  {
    "id": 28527,
    "book": "isaiah                                  ",
    "chapter": "47",
    "verse": "1",
    "text": "“Hãy xuống đây, hỡi trinh nữ Ba-by-lôn, và ngồi trong tro bụi."
  },
  {
    "id": 28528,
    "book": "isaiah                                  ",
    "chapter": "47",
    "verse": "2",
    "text": "Hãy lấy cối hạng nặng và xay bột."
  },
  {
    "id": 28529,
    "book": "isaiah                                  ",
    "chapter": "47",
    "verse": "3",
    "text": "Các ngươi sẽ trần truồng và nhục nhã."
  },
  {
    "id": 28530,
    "book": "isaiah                                  ",
    "chapter": "47",
    "verse": "4",
    "text": "Đấng Cứu Chuộc chúng ta, Danh Ngài là Chúa Hằng Hữu Vạn Quân,"
  },
  {
    "id": 28531,
    "book": "isaiah                                  ",
    "chapter": "47",
    "verse": "5",
    "text": "“Hỡi Ba-by-lôn xinh đẹp, hãy ngồi nơi tối tăm và im lặng."
  },
  {
    "id": 28532,
    "book": "isaiah                                  ",
    "chapter": "47",
    "verse": "6",
    "text": "Vì Ta giận dân Ta đã chọn,"
  },
  {
    "id": 28533,
    "book": "isaiah                                  ",
    "chapter": "47",
    "verse": "7",
    "text": "Ngươi tự bảo: ‘Ta sẽ cai trị mãi mãi như nữ hoàng của thế gian!’"
  },
  {
    "id": 28534,
    "book": "isaiah                                  ",
    "chapter": "47",
    "verse": "8",
    "text": "Nghe đây, dân tộc thích hưởng lạc,"
  },
  {
    "id": 28535,
    "book": "isaiah                                  ",
    "chapter": "47",
    "verse": "9",
    "text": "Nhưng cả hai điều này sẽ giáng trên ngươi trong phút chốc:"
  },
  {
    "id": 28536,
    "book": "isaiah                                  ",
    "chapter": "47",
    "verse": "10",
    "text": "Ngươi yên tâm trong tội ác của mình."
  },
  {
    "id": 28537,
    "book": "isaiah                                  ",
    "chapter": "47",
    "verse": "11",
    "text": "Vì thế, thảm họa sẽ ập đến ngươi,"
  },
  {
    "id": 28538,
    "book": "isaiah                                  ",
    "chapter": "47",
    "verse": "12",
    "text": "Bấy giờ ngươi sẽ dùng những bùa mê tà thuật!"
  },
  {
    "id": 28539,
    "book": "isaiah                                  ",
    "chapter": "47",
    "verse": "13",
    "text": "Những lời cố vấn khiến ngươi mệt mỏi."
  },
  {
    "id": 28540,
    "book": "isaiah                                  ",
    "chapter": "47",
    "verse": "14",
    "text": "Nhưng chúng sẽ như rơm rạ trong lửa thiêu;"
  },
  {
    "id": 28541,
    "book": "isaiah                                  ",
    "chapter": "47",
    "verse": "15",
    "text": "Tất cả chúng là bạn bè của ngươi,"
  }
]