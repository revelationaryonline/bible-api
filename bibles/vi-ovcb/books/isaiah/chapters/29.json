[
  {
    "id": 28121,
    "book": "isaiah                                  ",
    "chapter": "29",
    "verse": "1",
    "text": "“Khốn cho A-ri-ên, Thành của Vua Đa-vít."
  },
  {
    "id": 28122,
    "book": "isaiah                                  ",
    "chapter": "29",
    "verse": "2",
    "text": "Nhưng Ta sẽ giáng tai họa trên ngươi,"
  },
  {
    "id": 28123,
    "book": "isaiah                                  ",
    "chapter": "29",
    "verse": "3",
    "text": "Ta sẽ chống nghịch ngươi,"
  },
  {
    "id": 28124,
    "book": "isaiah                                  ",
    "chapter": "29",
    "verse": "4",
    "text": "Từ nơi đất sâu, ngươi sẽ nói;"
  },
  {
    "id": 28125,
    "book": "isaiah                                  ",
    "chapter": "29",
    "verse": "5",
    "text": "Nhưng bất chợt, bao kẻ thù ngươi sẽ bị nghiền nát"
  },
  {
    "id": 28126,
    "book": "isaiah                                  ",
    "chapter": "29",
    "verse": "6",
    "text": "Ta, Chúa Hằng Hữu Vạn Quân sẽ ra tay"
  },
  {
    "id": 28127,
    "book": "isaiah                                  ",
    "chapter": "29",
    "verse": "7",
    "text": "Tất cả quân đội các nước vây đánh nghịch cùng Giê-ru-sa-lem"
  },
  {
    "id": 28128,
    "book": "isaiah                                  ",
    "chapter": "29",
    "verse": "8",
    "text": "Như người đói nằm mơ thấy được ăn"
  },
  {
    "id": 28129,
    "book": "isaiah                                  ",
    "chapter": "29",
    "verse": "9",
    "text": "Ngươi ngạc nhiên và hoài nghi sao?"
  },
  {
    "id": 28130,
    "book": "isaiah                                  ",
    "chapter": "29",
    "verse": "10",
    "text": "Vì Chúa Hằng Hữu đã làm cho ngươi ngủ mê."
  },
  {
    "id": 28131,
    "book": "isaiah                                  ",
    "chapter": "29",
    "verse": "11",
    "text": "Tất cả sự kiện về tương lai trong khải tượng này không khác gì những lời nói đã bị niêm phong trong sách. Khi ngươi đưa sách cho người biết đọc, họ sẽ nói: “Chúng tôi không đọc được vì sách đã niêm phong.”"
  },
  {
    "id": 28132,
    "book": "isaiah                                  ",
    "chapter": "29",
    "verse": "12",
    "text": "Khi ngươi đưa sách cho người không biết đọc, họ sẽ nói: “Chúng tôi không biết đọc.”"
  },
  {
    "id": 28133,
    "book": "isaiah                                  ",
    "chapter": "29",
    "verse": "13",
    "text": "Vậy, Chúa phán: “Những người này nói họ thuộc về Ta."
  },
  {
    "id": 28134,
    "book": "isaiah                                  ",
    "chapter": "29",
    "verse": "14",
    "text": "Nên một lần nữa, Ta sẽ làm cho chúng ngỡ ngàng,"
  },
  {
    "id": 28135,
    "book": "isaiah                                  ",
    "chapter": "29",
    "verse": "15",
    "text": "Khốn cho những người tìm cách che giấu ý đồ khỏi Chúa Hằng Hữu,"
  },
  {
    "id": 28136,
    "book": "isaiah                                  ",
    "chapter": "29",
    "verse": "16",
    "text": "Sao các ngươi có thể dại dột như thế?"
  },
  {
    "id": 28137,
    "book": "isaiah                                  ",
    "chapter": "29",
    "verse": "17",
    "text": "Chẳng bao lâu nữa,"
  },
  {
    "id": 28138,
    "book": "isaiah                                  ",
    "chapter": "29",
    "verse": "18",
    "text": "Trong ngày ấy, người điếc sẽ nghe đọc lời trong sách,"
  },
  {
    "id": 28139,
    "book": "isaiah                                  ",
    "chapter": "29",
    "verse": "19",
    "text": "Người nhu mì sẽ ca mừng trong Chúa Hằng Hữu."
  },
  {
    "id": 28140,
    "book": "isaiah                                  ",
    "chapter": "29",
    "verse": "20",
    "text": "Bọn tàn bạo sẽ tiêu tan,"
  },
  {
    "id": 28141,
    "book": "isaiah                                  ",
    "chapter": "29",
    "verse": "21",
    "text": "Những ai kết án người vô tội"
  },
  {
    "id": 28142,
    "book": "isaiah                                  ",
    "chapter": "29",
    "verse": "22",
    "text": "Đó là tại sao Chúa Hằng Hữu, Đấng cứu chuộc Áp-ra-ham, đã nói với người Ít-ra-ên rằng:"
  },
  {
    "id": 28143,
    "book": "isaiah                                  ",
    "chapter": "29",
    "verse": "23",
    "text": "Vì khi chúng thấy nhiều con cái mình,"
  },
  {
    "id": 28144,
    "book": "isaiah                                  ",
    "chapter": "29",
    "verse": "24",
    "text": "Những ai có tâm linh lầm lạc sẽ hiểu biết,"
  }
]