[
  {
    "id": 27613,
    "book": "isaiah                                  ",
    "chapter": "2",
    "verse": "1",
    "text": "Đây là khải tượng mà Y-sai, con trai A-mốt, đã thấy về Giu-đa và Giê-ru-sa-lem:"
  },
  {
    "id": 27614,
    "book": "isaiah                                  ",
    "chapter": "2",
    "verse": "2",
    "text": "Trong những ngày cuối cùng,"
  },
  {
    "id": 27615,
    "book": "isaiah                                  ",
    "chapter": "2",
    "verse": "3",
    "text": "Nhiều dân tộc sẽ đến và nói:"
  },
  {
    "id": 27616,
    "book": "isaiah                                  ",
    "chapter": "2",
    "verse": "4",
    "text": "Chúa Hằng Hữu sẽ phán xét giữa các nước"
  },
  {
    "id": 27617,
    "book": "isaiah                                  ",
    "chapter": "2",
    "verse": "5",
    "text": "Hãy đến, hỡi con cháu Gia-cốp,"
  },
  {
    "id": 27618,
    "book": "isaiah                                  ",
    "chapter": "2",
    "verse": "6",
    "text": "Vì Chúa Hằng Hữu đã bỏ dân Ngài,"
  },
  {
    "id": 27619,
    "book": "isaiah                                  ",
    "chapter": "2",
    "verse": "7",
    "text": "Ít-ra-ên đầy dẫy bạc và vàng;"
  },
  {
    "id": 27620,
    "book": "isaiah                                  ",
    "chapter": "2",
    "verse": "8",
    "text": "Đất họ đầy thần tượng;"
  },
  {
    "id": 27621,
    "book": "isaiah                                  ",
    "chapter": "2",
    "verse": "9",
    "text": "Vậy bây giờ, họ sẽ cúi xuống,"
  },
  {
    "id": 27622,
    "book": "isaiah                                  ",
    "chapter": "2",
    "verse": "10",
    "text": "Hãy chui vào trong hang đá."
  },
  {
    "id": 27623,
    "book": "isaiah                                  ",
    "chapter": "2",
    "verse": "11",
    "text": "Sự tự cao của loài người sẽ hạ xuống,"
  },
  {
    "id": 27624,
    "book": "isaiah                                  ",
    "chapter": "2",
    "verse": "12",
    "text": "Vì Chúa Hằng Hữu Vạn Quân"
  },
  {
    "id": 27625,
    "book": "isaiah                                  ",
    "chapter": "2",
    "verse": "13",
    "text": "Chúa sẽ hạ các cây bá hương cao lớn trên Li-ban"
  },
  {
    "id": 27626,
    "book": "isaiah                                  ",
    "chapter": "2",
    "verse": "14",
    "text": "Chúa sẽ san bằng các ngọn núi cao"
  },
  {
    "id": 27627,
    "book": "isaiah                                  ",
    "chapter": "2",
    "verse": "15",
    "text": "Chúa sẽ làm đổ sụp các ngọn tháp cao"
  },
  {
    "id": 27628,
    "book": "isaiah                                  ",
    "chapter": "2",
    "verse": "16",
    "text": "Chúa sẽ tàn phá tất cả tàu thuyền Ta-rê-si"
  },
  {
    "id": 27629,
    "book": "isaiah                                  ",
    "chapter": "2",
    "verse": "17",
    "text": "Sự tự cao của loài người sẽ hạ xuống,"
  },
  {
    "id": 27630,
    "book": "isaiah                                  ",
    "chapter": "2",
    "verse": "18",
    "text": "Mọi thần tượng sẽ hoàn toàn biến mất."
  },
  {
    "id": 27631,
    "book": "isaiah                                  ",
    "chapter": "2",
    "verse": "19",
    "text": "Khi Chúa Hằng Hữu đứng lên"
