[
  {
    "id": 27834,
    "book": "isaiah                                  ",
    "chapter": "13",
    "verse": "1",
    "text": "Y-sai, con A-mốt nhận được sứ điệp về sự suy vong của Ba-by-lôn:"
  },
  {
    "id": 27835,
    "book": "isaiah                                  ",
    "chapter": "13",
    "verse": "2",
    "text": "“Hãy dựng trụ cờ trên đỉnh núi trọi."
  },
  {
    "id": 27836,
    "book": "isaiah                                  ",
    "chapter": "13",
    "verse": "3",
    "text": "Ta, Chúa Hằng Hữu, đã dành riêng những chiến sĩ cho nhiệm vụ này."
  },
  {
    "id": 27837,
    "book": "isaiah                                  ",
    "chapter": "13",
    "verse": "4",
    "text": "Hãy nghe tiếng ồn ào trên các núi!"
  },
  {
    "id": 27838,
    "book": "isaiah                                  ",
    "chapter": "13",
    "verse": "5",
    "text": "Chúng kéo đến từ những nước xa xôi,"
  },
  {
    "id": 27839,
    "book": "isaiah                                  ",
    "chapter": "13",
    "verse": "6",
    "text": "Hãy than khóc, vì ngày của Chúa Hằng Hữu gần đến—"
  },
  {
    "id": 27840,
    "book": "isaiah                                  ",
    "chapter": "13",
    "verse": "7",
    "text": "Vì thế, mọi tay đều yếu đuối."
  },
  {
    "id": 27841,
    "book": "isaiah                                  ",
    "chapter": "13",
    "verse": "8",
    "text": "và người ta đều kinh hoàng."
  },
  {
    "id": 27842,
    "book": "isaiah                                  ",
    "chapter": "13",
    "verse": "9",
    "text": "Nhìn kìa, ngày của Chúa Hằng Hữu đang đến—"
  },
  {
    "id": 27843,
    "book": "isaiah                                  ",
    "chapter": "13",
    "verse": "10",
    "text": "Các khoảng trời sẽ tối đen trên họ;"
  },
  {
    "id": 27844,
    "book": "isaiah                                  ",
    "chapter": "13",
    "verse": "11",
    "text": "“Ta, Chúa Hằng Hữu, sẽ hình phạt thế giới vì gian ác"
  },
  {
    "id": 27845,
    "book": "isaiah                                  ",
    "chapter": "13",
    "verse": "12",
    "text": "Ta sẽ khiến số người sống sót hiếm hơn vàng—"
  },
  {
    "id": 27846,
    "book": "isaiah                                  ",
    "chapter": "13",
    "verse": "13",
    "text": "Ta sẽ làm các tầng trời rúng động."
  },
  {
    "id": 27847,
    "book": "isaiah                                  ",
    "chapter": "13",
    "verse": "14",
    "text": "Mỗi người tại Ba-by-lôn sẽ chạy như hươu bị đuổi,"
  },
  {
    "id": 27848,
    "book": "isaiah                                  ",
    "chapter": "13",
    "verse": "15",
    "text": "Ai bị quân thù bắt được sẽ bị đâm,"
  },
  {
    "id": 27849,
    "book": "isaiah                                  ",
    "chapter": "13",
    "verse": "16",
    "text": "Con cái họ sẽ bị đánh chết trước mắt họ."
  },
  {
    "id": 27850,
    "book": "isaiah                                  ",
    "chapter": "13",
    "verse": "17",
    "text": "“Này, Ta sẽ khiến người Mê-đi chống lại Ba-by-lôn."
  },
  {
    "id": 27851,
    "book": "isaiah                                  ",
    "chapter": "13",
    "verse": "18",
    "text": "Cung tên chúng sẽ đập nát người trai trẻ."
  },
  {
    "id": 27852,
    "book": "isaiah                                  ",
    "chapter": "13",
    "verse": "19",
    "text": "Ba-by-lôn, viên ngọc của các vương quốc,"
  },
  {
    "id": 27853,
    "book": "isaiah                                  ",
    "chapter": "13",
    "verse": "20",
    "text": "Ba-by-lôn sẽ không bao giờ còn dân cư nữa."
  },
  {
    "id": 27854,
    "book": "isaiah                                  ",
    "chapter": "13",
    "verse": "21",
    "text": "Thú dữ của hoang mạc sẽ ở trong thành đổ nát,"
  },
  {
    "id": 27855,
    "book": "isaiah                                  ",
    "chapter": "13",
    "verse": "22",
    "text": "Lang sói sẽ tru trong thành trì,"
  }
]