[
  {
    "id": 27667,
    "book": "isaiah                                  ",
    "chapter": "5",
    "verse": "1",
    "text": "Bấy giờ, tôi sẽ hát cho Người yêu quý của tôi"
  },
  {
    "id": 27668,
    "book": "isaiah                                  ",
    "chapter": "5",
    "verse": "2",
    "text": "Người đào xới, lượm sạch đá sỏi,"
  },
  {
    "id": 27669,
    "book": "isaiah                                  ",
    "chapter": "5",
    "verse": "3",
    "text": "Hỡi cư dân ở Giê-ru-sa-lem và Giu-đa,"
  },
  {
    "id": 27670,
    "book": "isaiah                                  ",
    "chapter": "5",
    "verse": "4",
    "text": "Còn điều nào Ta phải làm thêm cho vườn nho của Ta"
  },
  {
    "id": 27671,
    "book": "isaiah                                  ",
    "chapter": "5",
    "verse": "5",
    "text": "Này Ta cho biết ngươi biết điều Ta định làm cho vườn nho của Ta:"
  },
  {
    "id": 27672,
    "book": "isaiah                                  ",
    "chapter": "5",
    "verse": "6",
    "text": "Ta sẽ không cuốc xới,"
  },
  {
    "id": 27673,
    "book": "isaiah                                  ",
    "chapter": "5",
    "verse": "7",
    "text": "Vì dân tộc Ít-ra-ên là vườn nho của Chúa Hằng Hữu Vạn Quân."
  },
  {
    "id": 27674,
    "book": "isaiah                                  ",
    "chapter": "5",
    "verse": "8",
    "text": "Khốn cho các ngươi là những người mua hết nhà này đến nhà khác,"
  },
  {
    "id": 27675,
    "book": "isaiah                                  ",
    "chapter": "5",
    "verse": "9",
    "text": "Nhưng tôi nghe Chúa Hằng Hữu Vạn Quân thề phán:"
  },
  {
    "id": 27676,
    "book": "isaiah                                  ",
    "chapter": "5",
    "verse": "10",
    "text": "Mười mẫu vườn nho sẽ không sản xuất"
  },
  {
    "id": 27677,
    "book": "isaiah                                  ",
    "chapter": "5",
    "verse": "11",
    "text": "Khốn cho những ai dậy từ sáng sớm tìm rượu"
  },
  {
    "id": 27678,
    "book": "isaiah                                  ",
    "chapter": "5",
    "verse": "12",
    "text": "Tiệc tùng của chúng có đầy rượu và âm nhạc—"
  },
  {
    "id": 27679,
    "book": "isaiah                                  ",
    "chapter": "5",
    "verse": "13",
    "text": "Cho nên, dân Ta sẽ bị lưu đày biệt xứ"
  },
  {
    "id": 27680,
    "book": "isaiah                                  ",
    "chapter": "5",
    "verse": "14",
    "text": "Vì thế, âm phủ liếm môi thèm khát,"
  },
  {
    "id": 27681,
    "book": "isaiah                                  ",
    "chapter": "5",
    "verse": "15",
    "text": "Loài người sẽ bị tiêu diệt, và dân chúng bị hạ thấp;"
  },
  {
    "id": 27682,
    "book": "isaiah                                  ",
    "chapter": "5",
    "verse": "16",
    "text": "Nhưng Chúa Hằng Hữu Vạn Quân"
  },
  {
    "id": 27683,
    "book": "isaiah                                  ",
    "chapter": "5",
    "verse": "17",
    "text": "Trong những ngày ấy, các chiên sẽ tìm những đồng cỏ tốt,"
  },
  {
    "id": 27684,
    "book": "isaiah                                  ",
    "chapter": "5",
    "verse": "18",
    "text": "Khốn cho người kéo tội lỗi bằng dây gian dối,"
  },
  {
    "id": 27685,
    "book": "isaiah                                  ",
    "chapter": "5",
    "verse": "19",
    "text": "Chúng còn dám thách thức Đức Chúa Trời và nói:"
  },
  {
    "id": 27686,
    "book": "isaiah                                  ",
    "chapter": "5",
    "verse": "20",
    "text": "Khốn cho những người gọi"
  },
  {
    "id": 27687,
    "book": "isaiah                                  ",
    "chapter": "5",
    "verse": "21",
    "text": "Khốn cho những người tự cho mình là khôn ngoan"
  },
  {
    "id": 27688,
    "book": "isaiah                                  ",
    "chapter": "5",
    "verse": "22",
    "text": "Khốn cho những người tự cho mình là anh hùng uống rượu"
  },
  {
    "id": 27689,
    "book": "isaiah                                  ",
    "chapter": "5",
    "verse": "23",
    "text": "Chúng nhận của hối lộ rồi tha người gian ác,"
  },
  {
    "id": 27690,
    "book": "isaiah                                  ",
    "chapter": "5",
    "verse": "24",
    "text": "Vì thế, như ngọn lửa thiêu đốt rơm rạ"
  },
  {
    "id": 27691,
    "book": "isaiah                                  ",
    "chapter": "5",
    "verse": "25",
    "text": "Đó là tại sao cơn thịnh nộ của Chúa Hằng Hữu"
  },
  {
    "id": 27692,
    "book": "isaiah                                  ",
    "chapter": "5",
    "verse": "26",
    "text": "Chúa sẽ ra dấu cho các nước xa xôi"
  },
  {
    "id": 27693,
    "book": "isaiah                                  ",
    "chapter": "5",
    "verse": "27",
    "text": "Chúng sẽ không mệt nhọc hay vấp ngã."
  },
  {
    "id": 27694,
    "book": "isaiah                                  ",
    "chapter": "5",
    "verse": "28",
    "text": "Mũi tên của chúng bén nhọn"
  },
  {
    "id": 27695,
    "book": "isaiah                                  ",
    "chapter": "5",
    "verse": "29",
    "text": "Chúng kêu gầm như sư tử,"
  },
  {
    "id": 27696,
    "book": "isaiah                                  ",
    "chapter": "5",
    "verse": "30",
    "text": "Chúng sẽ gầm thét"
  }
]