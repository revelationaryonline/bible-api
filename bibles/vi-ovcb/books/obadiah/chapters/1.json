[
  {
    "id": 28874,
    "book": "obadiah                                 ",
    "chapter": "1",
    "verse": "1",
    "text": "Đây là khải tượng của Chúa Hằng Hữu Chí Cao hiển lộ cho Áp-đia thấy về xứ Ê-đôm."
  },
  {
    "id": 28875,
    "book": "obadiah                                 ",
    "chapter": "1",
    "verse": "2",
    "text": "Chúa Hằng Hữu phán về Ê-đôm:"
  },
  {
    "id": 28876,
    "book": "obadiah                                 ",
    "chapter": "1",
    "verse": "3",
    "text": "Vì kiêu ngạo nên ngươi đã tự lừa dối mình"
  },
  {
    "id": 28877,
    "book": "obadiah                                 ",
    "chapter": "1",
    "verse": "4",
    "text": "Dù ngươi bay cao như đại bàng"
  },
  {
    "id": 28878,
    "book": "obadiah                                 ",
    "chapter": "1",
    "verse": "5",
    "text": "“Dù bọn trộm cướp xông vào giữa đêm và cướp bóc ngươi,"
  },
  {
    "id": 28879,
    "book": "obadiah                                 ",
    "chapter": "1",
    "verse": "6",
    "text": "Mọi góc xó và ngõ ngách của Ê-sau"
  },
  {
    "id": 28880,
    "book": "obadiah                                 ",
    "chapter": "1",
    "verse": "7",
    "text": "Tất cả nước đồng minh ngươi sẽ phản bội ngươi."
  },
  {
    "id": 28881,
    "book": "obadiah                                 ",
    "chapter": "1",
    "verse": "8",
    "text": "Trong ngày ấy, sẽ không một người khôn ngoan nào"
  },
  {
    "id": 28882,
    "book": "obadiah                                 ",
    "chapter": "1",
    "verse": "9",
    "text": "Các dũng sĩ can trường của Thê-man"
  },
  {
    "id": 28883,
    "book": "obadiah                                 ",
    "chapter": "1",
    "verse": "10",
    "text": "“Vì ngươi đã đối xử tàn bạo"
  },
  {
    "id": 28884,
    "book": "obadiah                                 ",
    "chapter": "1",
    "verse": "11",
    "text": "Khi họ bị quân địch xâm lăng,"
  },
  {
    "id": 28885,
    "book": "obadiah                                 ",
    "chapter": "1",
    "verse": "12",
    "text": "Lẽ ra, ngươi không nên nhìn hả hê"
  },
  {
    "id": 28886,
    "book": "obadiah                                 ",
    "chapter": "1",
    "verse": "13",
    "text": "Lẽ ra, ngươi không nên tước đoạt đất của Ít-ra-ên"
  },
  {
    "id": 28887,
    "book": "obadiah                                 ",
    "chapter": "1",
    "verse": "14",
    "text": "Lẽ ra, ngươi đừng chặn các thông lộ"
  },
  {
    "id": 28888,
    "book": "obadiah                                 ",
    "chapter": "1",
    "verse": "15",
    "text": "“Ngày đã gần kề khi Ta, Chúa Hằng Hữu,"
  },
  {
    "id": 28889,
    "book": "obadiah                                 ",
    "chapter": "1",
    "verse": "16",
    "text": "Ngươi đã nhai nuốt dân Ta"
  },
  {
    "id": 28890,
    "book": "obadiah                                 ",
    "chapter": "1",
    "verse": "17",
    "text": "Nhưng Núi Si-ôn sẽ là nơi trú ẩn cho người chạy trốn;"
  },
  {
    "id": 28891,
    "book": "obadiah                                 ",
    "chapter": "1",
    "verse": "18",
    "text": "Nhà Gia-cốp sẽ thành đám lửa"
  },
  {
    "id": 28892,
    "book": "obadiah                                 ",
    "chapter": "1",
    "verse": "19",
    "text": "Dân Ta đang sống tại Nê-ghép"
  },
  {
    "id": 28893,
    "book": "obadiah                                 ",
    "chapter": "1",
    "verse": "20",
    "text": "Những người bị lưu đày của Ít-ra-ên sẽ trở về vùng đất của họ"
  },
  {
    "id": 28894,
    "book": "obadiah                                 ",
    "chapter": "1",
    "verse": "21",
    "text": "Những người được giải cứu sẽ lên Núi Si-ôn trong Giê-ru-sa-lem"
  }
]