[
  {
    "id": 13493,
    "book": "joel                                    ",
    "chapter": "2",
    "verse": "1",
    "text": "Hãy thổi kèn trong Si-ôn!"
  },
  {
    "id": 13494,
    "book": "joel                                    ",
    "chapter": "2",
    "verse": "2",
    "text": "Đó là ngày tối tăm mù mịt,"
  },
  {
    "id": 13495,
    "book": "joel                                    ",
    "chapter": "2",
    "verse": "3",
    "text": "Lửa cháy ở phía trước chúng,"
  },
  {
    "id": 13496,
    "book": "joel                                    ",
    "chapter": "2",
    "verse": "4",
    "text": "Chúng giống như ngựa;"
  },
  {
    "id": 13497,
    "book": "joel                                    ",
    "chapter": "2",
    "verse": "5",
    "text": "Hãy xem chúng nhảy qua các ngọn núi."
  },
  {
    "id": 13498,
    "book": "joel                                    ",
    "chapter": "2",
    "verse": "6",
    "text": "Nhìn thấy chúng, các nước đều lo sợ;"
  },
  {
    "id": 13499,
    "book": "joel                                    ",
    "chapter": "2",
    "verse": "7",
    "text": "Chúng tấn công như dũng sĩ"
  },
  {
    "id": 13500,
    "book": "joel                                    ",
    "chapter": "2",
    "verse": "8",
    "text": "Chúng không bao giờ giẫm chân lên nhau;"
  },
  {
    "id": 13501,
    "book": "joel                                    ",
    "chapter": "2",
    "verse": "9",
    "text": "Chúng tràn ngập cả thành phố"
  },
  {
    "id": 13502,
    "book": "joel                                    ",
    "chapter": "2",
    "verse": "10",
    "text": "Đất rúng động khi chúng tiến lên,"
  },
  {
    "id": 13503,
    "book": "joel                                    ",
    "chapter": "2",
    "verse": "11",
    "text": "Chúa Hằng Hữu đứng trước đạo quân."
  },
  {
    "id": 13504,
    "book": "joel                                    ",
    "chapter": "2",
    "verse": "12",
    "text": "Đây là điều Chúa Hằng Hữu phán:"
  },
  {
    "id": 13505,
    "book": "joel                                    ",
    "chapter": "2",
    "verse": "13",
    "text": "Đừng xé áo các con vì đau buồn,"
  },
  {
    "id": 13506,
    "book": "joel                                    ",
    "chapter": "2",
    "verse": "14",
    "text": "Ai biết được? Có lẽ Chúa sẽ gia hạn cho các con,"
  },
  {
    "id": 13507,
    "book": "joel                                    ",
    "chapter": "2",
    "verse": "15",
    "text": "Hãy thổi kèn khắp Si-ôn!"
  },
  {
    "id": 13508,
    "book": "joel                                    ",
    "chapter": "2",
    "verse": "16",
    "text": "Hãy triệu tập toàn dân—"
  },
  {
    "id": 13509,
    "book": "joel                                    ",
    "chapter": "2",
    "verse": "17",
    "text": "Hãy để các thầy tế lễ, những người phục vụ trước Chúa Hằng Hữu,"
  },
  {
    "id": 13510,
    "book": "joel                                    ",
    "chapter": "2",
    "verse": "18",
    "text": "Rồi Chúa Hằng Hữu tỏ lòng thương xót dân Ngài"
  },
  {
    "id": 13511,
    "book": "joel                                    ",
    "chapter": "2",
    "verse": "19",
    "text": "Chúa Hằng Hữu sẽ đáp lời:"
  },
  {
    "id": 13512,
    "book": "joel                                    ",
    "chapter": "2",
    "verse": "20",
    "text": "Ta sẽ xua tan đạo quân từ phương bắc."
  },
  {
    "id": 13513,
    "book": "joel                                    ",
    "chapter": "2",
    "verse": "21",
    "text": "Đừng sợ hãi, dân ta ơi."
  },
  {
    "id": 13514,
    "book": "joel                                    ",
    "chapter": "2",
    "verse": "22",
    "text": "Đừng sợ hãi, hỡi các loài thú trên đồng,"
  },
  {
    "id": 13515,
    "book": "joel                                    ",
    "chapter": "2",
    "verse": "23",
    "text": "Hãy hân hoan, hỡi cư dân Giê-ru-sa-lem!"
  },
  {
    "id": 13516,
    "book": "joel                                    ",
    "chapter": "2",
    "verse": "24",
    "text": "Sân đạp lúa sẽ đầy ngập lúa mì,"
  },
  {
    "id": 13517,
    "book": "joel                                    ",
    "chapter": "2",
    "verse": "25",
    "text": "Chúa Hằng Hữu phán: “Ta sẽ đền bù cho các con những gì các con bị mất"
  },
  {
    "id": 13518,
    "book": "joel                                    ",
    "chapter": "2",
    "verse": "26",
    "text": "Một lần nữa các con sẽ lại được thực phẩm dồi dào dư dật,"
  },
  {
    "id": 13519,
    "book": "joel                                    ",
    "chapter": "2",
    "verse": "27",
    "text": "Khi đó, các con sẽ nhìn biết Ta đang ngự trị giữa Ít-ra-ên, dân Ta,"
  },
  {
    "id": 13520,
    "book": "joel                                    ",
    "chapter": "2",
    "verse": "28",
    "text": "“Kế đến, sau khi làm xong những việc này,"
  },
  {
    "id": 13521,
    "book": "joel                                    ",
    "chapter": "2",
    "verse": "29",
    "text": "Trong những ngày ấy, Ta sẽ đổ Thần Ta"
  },
  {
    "id": 13522,
    "book": "joel                                    ",
    "chapter": "2",
    "verse": "30",
    "text": "Ta sẽ tạo những việc kỳ diệu trên trời cũng như dưới đất—"
  },
  {
    "id": 13523,
    "book": "joel                                    ",
    "chapter": "2",
    "verse": "31",
    "text": "Mặt trời sẽ trở nên tối đen,"
  },
  {
    "id": 13524,
    "book": "joel                                    ",
    "chapter": "2",
    "verse": "32",
    "text": "Nhưng những ai cầu khẩn Danh Chúa Hằng Hữu đều sẽ được cứu,"
  }
]