    "book": "joel                                    ",
    "chapter": "1",
    "verse": "13",
    "text": "Hãy mặc áo bao gai và kêu khóc, hỡi các thầy tế lễ!"
  },
  {
    "id": 13486,
    "book": "joel                                    ",
    "chapter": "1",
    "verse": "14",
    "text": "Hãy công bố1:14 Nt thánh hóa hoặc biệt riêng ngày kiêng ăn;"
