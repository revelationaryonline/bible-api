[
  {
    "id": 13473,
    "book": "joel                                    ",
    "chapter": "1",
    "verse": "1",
    "text": "Chúa Hằng Hữu ban sứ điệp này cho Giô-ên, con trai của Phê-thu-ên."
  },
  {
    "id": 13474,
    "book": "joel                                    ",
    "chapter": "1",
    "verse": "2",
    "text": "Nghe đây, hỡi các lãnh đạo của toàn dân."
  },
  {
    "id": 13475,
    "book": "joel                                    ",
    "chapter": "1",
    "verse": "3",
    "text": "Hãy thuật lại cho con cháu các ngươi,"
  },
  {
    "id": 13476,
    "book": "joel                                    ",
    "chapter": "1",
    "verse": "4",
    "text": "Sau khi sâu keo cắn phá mùa màng"
