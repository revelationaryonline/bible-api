  {
    "id": 13483,
    "book": "joel                                    ",
    "chapter": "1",
    "verse": "11",
    "text": "Hãy tuyệt vọng, hỡi tất cả nông gia!"
  },
  {
    "id": 13484,
    "book": "joel                                    ",
    "chapter": "1",
    "verse": "12",
    "text": "Các dây nho đã khô,"
