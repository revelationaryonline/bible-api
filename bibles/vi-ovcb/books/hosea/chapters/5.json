[
  {
    "id": 30548,
    "book": "hosea                                   ",
    "chapter": "5",
    "verse": "1",
    "text": "“Hãy nghe đây, hỡi các thầy tế lễ."
  },
  {
    "id": 30549,
    "book": "hosea                                   ",
    "chapter": "5",
    "verse": "2",
    "text": "Những kẻ phản loạn đã chìm sâu trong sự tàn sát,"
  },
  {
    "id": 30550,
    "book": "hosea                                   ",
    "chapter": "5",
    "verse": "3",
    "text": "Ta biết rõ ngươi, hỡi Ép-ra-im."
  },
  {
    "id": 30551,
    "book": "hosea                                   ",
    "chapter": "5",
    "verse": "4",
    "text": "Công việc ác của ngươi ngăn trở ngươi trở về với Đức Chúa Trời mình."
  },
  {
    "id": 30552,
    "book": "hosea                                   ",
    "chapter": "5",
    "verse": "5",
    "text": "Sự kiêu ngạo của Ít-ra-ên đã tố cáo nó;"
  },
  {
    "id": 30553,
    "book": "hosea                                   ",
    "chapter": "5",
    "verse": "6",
    "text": "Khi chúng đến với bầy bò, bầy chiên"
  },
  {
    "id": 30554,
    "book": "hosea                                   ",
    "chapter": "5",
    "verse": "7",
    "text": "Chúng đã phản bội Chúa Hằng Hữu,"
  },
  {
    "id": 30555,
    "book": "hosea                                   ",
    "chapter": "5",
    "verse": "8",
    "text": "Hãy báo động ở Ghi-bê-a!"
  },
  {
    "id": 30556,
    "book": "hosea                                   ",
    "chapter": "5",
    "verse": "9",
    "text": "Có một điều chắc chắn cho Ép-ra-im:"
  },
  {
    "id": 30557,
    "book": "hosea                                   ",
    "chapter": "5",
    "verse": "10",
    "text": "Các nhà lãnh đạo Giu-đa dời mộc giới để cướp đất."
  },
  {
    "id": 30558,
    "book": "hosea                                   ",
    "chapter": "5",
    "verse": "11",
    "text": "Ép-ra-im sẽ bị đánh tan và nghiền nát trong ngày Ta xử đoán"
  },
  {
    "id": 30559,
    "book": "hosea                                   ",
    "chapter": "5",
    "verse": "12",
    "text": "Ta sẽ diệt Ít-ra-ên như mối mọt cắn lông chiên."
  },
  {
    "id": 30560,
    "book": "hosea                                   ",
    "chapter": "5",
    "verse": "13",
    "text": "Khi Ép-ra-im và Giu-đa thấy mình bệnh thế nào,"
  },
  {
    "id": 30561,
    "book": "hosea                                   ",
    "chapter": "5",
    "verse": "14",
    "text": "Ta sẽ là sư tử cho Ép-ra-im,"
  },
  {
    "id": 30562,
    "book": "hosea                                   ",
    "chapter": "5",
    "verse": "15",
    "text": "Ta sẽ quay về nơi Ta ngự"
  }
]