    "id": 30539,
    "book": "hosea                                   ",
    "chapter": "4",
    "verse": "11",
    "text": "để chạy theo các thần khác."
  },
  {
    "id": 30540,
    "book": "hosea                                   ",
    "chapter": "4",
    "verse": "12",
    "text": "Chúng cầu vấn thần tượng bằng gỗ!"
  },
  {
    "id": 30541,
    "book": "hosea                                   ",
    "chapter": "4",
    "verse": "13",
    "text": "Chúng dâng sinh tế trên các ngọn núi."
  },
  {
    "id": 30542,
    "book": "hosea                                   ",
    "chapter": "4",
    "verse": "14",
    "text": "Nhưng tại sao Ta không phạt chúng"
  },
  {
    "id": 30543,
    "book": "hosea                                   ",
    "chapter": "4",
    "verse": "15",
    "text": "Dù ngươi, Ít-ra-ên, là gái mãi dâm,"
  },
  {
    "id": 30544,
    "book": "hosea                                   ",
    "chapter": "4",
    "verse": "16",
    "text": "Ít-ra-ên ngoan cố"
  },
  {
    "id": 30545,
    "book": "hosea                                   ",
    "chapter": "4",
    "verse": "17",
    "text": "Hãy bỏ mặc Ép-ra-im cô độc,"
  },
  {
