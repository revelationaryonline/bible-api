[
  {
    "id": 30529,
    "book": "hosea                                   ",
    "chapter": "4",
    "verse": "1",
    "text": "Hỡi dân tộc Ít-ra-ên, hãy nghe lời Chúa Hằng Hữu phán dạy!"
  },
  {
    "id": 30530,
    "book": "hosea                                   ",
    "chapter": "4",
    "verse": "2",
    "text": "Các ngươi thề hứa rồi thất hứa;"
  },
  {
    "id": 30531,
    "book": "hosea                                   ",
    "chapter": "4",
    "verse": "3",
    "text": "Vì thế đất đai than khóc,"
  },
  {
    "id": 30532,
    "book": "hosea                                   ",
    "chapter": "4",
    "verse": "4",
    "text": "Dù vậy, đừng tranh chấp với ai,"
