    "book": "hosea                                   ",
    "chapter": "4",
    "verse": "8",
    "text": "Khi dân chúng dâng tế lễ chuộc tội thì các thầy tế lễ nhận được tiền công."
  },
  {
    "id": 30537,
    "book": "hosea                                   ",
    "chapter": "4",
    "verse": "9",
    "text": "‘Các thầy tế lễ làm gì, thì dân chúng cũng làm như vậy.’"
  },
  {
    "id": 30538,
    "book": "hosea                                   ",
    "chapter": "4",
    "verse": "10",
    "text": "Chúng sẽ ăn nhưng không no."
  },
