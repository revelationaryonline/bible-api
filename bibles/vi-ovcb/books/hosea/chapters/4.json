    "book": "hosea                                   ",
    "chapter": "4",
    "verse": "18",
    "text": "Khi những kẻ cai trị Ít-ra-ên uống say sưa,"
  },
  {
    "id": 30547,
    "book": "hosea                                   ",
    "chapter": "4",
