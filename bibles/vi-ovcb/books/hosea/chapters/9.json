[
  {
    "id": 30604,
    "book": "hosea                                   ",
    "chapter": "9",
    "verse": "1",
    "text": "Hỡi Ít-ra-ên,"
  },
  {
    "id": 30605,
    "book": "hosea                                   ",
    "chapter": "9",
    "verse": "2",
    "text": "Vậy bây giờ những mùa thu hoạch sẽ không đủ nuôi ngươi."
  },
  {
    "id": 30606,
    "book": "hosea                                   ",
    "chapter": "9",
    "verse": "3",
    "text": "Ngươi sẽ không còn ở trong đất của Chúa Hằng Hữu,"
  },
  {
    "id": 30607,
    "book": "hosea                                   ",
    "chapter": "9",
    "verse": "4",
    "text": "Ngươi sẽ không còn dâng lễ quán cho Chúa Hằng Hữu."
  },
  {
    "id": 30608,
    "book": "hosea                                   ",
    "chapter": "9",
    "verse": "5",
    "text": "Ngươi sẽ làm gì trong những ngày lễ?"
  },
  {
    "id": 30609,
    "book": "hosea                                   ",
    "chapter": "9",
    "verse": "6",
    "text": "Vì nếu ngươi chạy trốn sự tàn phá từ A-sy-ri,"
  },
  {
    "id": 30610,
    "book": "hosea                                   ",
    "chapter": "9",
    "verse": "7",
    "text": "Ngày thăm phạt Ít-ra-ên đã đến;"
  },
  {
    "id": 30611,
    "book": "hosea                                   ",
    "chapter": "9",
    "verse": "8",
    "text": "Các tiên tri là người canh giữ Ép-ra-im cho Đức Chúa Trời của tôi,"
  },
  {
    "id": 30612,
    "book": "hosea                                   ",
    "chapter": "9",
    "verse": "9",
    "text": "Dân tôi làm những điều thối nát đồi bại"
  },
  {
    "id": 30613,
    "book": "hosea                                   ",
    "chapter": "9",
    "verse": "10",
    "text": "Chúa Hằng Hữu phán: “Hỡi Ít-ra-ên, khi Ta bắt gặp ngươi,"
  },
  {
    "id": 30614,
    "book": "hosea                                   ",
    "chapter": "9",
    "verse": "11",
    "text": "Vinh quang Ép-ra-im như chim tung cánh bay xa,"
  },
  {
    "id": 30615,
    "book": "hosea                                   ",
    "chapter": "9",
    "verse": "12",
    "text": "Dù nếu ngươi có con đang lớn,"
  },
  {
    "id": 30616,
    "book": "hosea                                   ",
    "chapter": "9",
    "verse": "13",
    "text": "Ta đã nhìn Ép-ra-im được trồng như cây Ty-rơ tốt đẹp."
  },
  {
    "id": 30617,
    "book": "hosea                                   ",
    "chapter": "9",
    "verse": "14",
    "text": "Lạy Chúa Hằng Hữu, con có thể cầu xin gì cho dân Ngài?"
  },
  {
    "id": 30618,
    "book": "hosea                                   ",
    "chapter": "9",
    "verse": "15",
    "text": "Chúa Hằng Hữu phán: “Tất cả tội ác chúng bắt đầu tại Ghinh-ganh;"
  },
  {
    "id": 30619,
    "book": "hosea                                   ",
    "chapter": "9",
    "verse": "16",
    "text": "Người Ép-ra-im bị đánh đổ."
  },
  {
    "id": 30620,
    "book": "hosea                                   ",
    "chapter": "9",
    "verse": "17",
    "text": "Đức Chúa Trời tôi sẽ loại bỏ người Ít-ra-ên"
  }
]