[
  {
    "id": 30501,
    "book": "hosea                                   ",
    "chapter": "2",
    "verse": "1",
    "text": "“Trong ngày đó, Ta sẽ gọi các anh em ngươi là Am-mi—‘dân Ta.’ Và Ta sẽ gọi chị em ngươi là Ra-ha-ma—‘Người Ta thương.’”"
  },
  {
    "id": 30502,
    "book": "hosea                                   ",
    "chapter": "2",
    "verse": "2",
    "text": "“Nhưng bây giờ hãy buộc tội Ít-ra-ên—mẹ các ngươi—"
  },
  {
    "id": 30503,
    "book": "hosea                                   ",
    "chapter": "2",
    "verse": "3",
    "text": "Nếu không, Ta sẽ lột nó trần truồng"
  },
  {
    "id": 30504,
    "book": "hosea                                   ",
    "chapter": "2",
    "verse": "4",
    "text": "Ta cũng chẳng còn thương xót con cái nó,"
  },
  {
    "id": 30505,
    "book": "hosea                                   ",
    "chapter": "2",
    "verse": "5",
    "text": "Mẹ chúng là gái mãi dâm vô liêm sỉ"
  },
  {
    "id": 30506,
    "book": "hosea                                   ",
    "chapter": "2",
    "verse": "6",
    "text": "Vì thế, Ta sẽ dùng gai gốc chận đường nó."
  },
  {
    "id": 30507,
    "book": "hosea                                   ",
    "chapter": "2",
    "verse": "7",
    "text": "Khi nó chạy theo các tình nhân,"
  },
  {
    "id": 30508,
    "book": "hosea                                   ",
    "chapter": "2",
    "verse": "8",
    "text": "Nó không biết rằng chính Ta đã cung cấp cho nó mọi thứ—"
  },
  {
    "id": 30509,
    "book": "hosea                                   ",
    "chapter": "2",
    "verse": "9",
    "text": "Vậy bây giờ, Ta sẽ lấy lại mùa lúa chín và rượu mới"
  },
  {
    "id": 30510,
    "book": "hosea                                   ",
    "chapter": "2",
    "verse": "10",
    "text": "Ta sẽ phơi bày sự xấu hổ nó nơi công cộng"
  },
  {
    "id": 30511,
    "book": "hosea                                   ",
    "chapter": "2",
    "verse": "11",
    "text": "Ta sẽ chấm dứt những lễ hội hằng năm,"
  },
  {
    "id": 30512,
    "book": "hosea                                   ",
    "chapter": "2",
    "verse": "12",
    "text": "Ta sẽ phá các cây nho và cây vả"
  },
  {
    "id": 30513,
    "book": "hosea                                   ",
    "chapter": "2",
    "verse": "13",
    "text": "Ta sẽ hình phạt nó về những ngày"
  },
  {
    "id": 30514,
    "book": "hosea                                   ",
    "chapter": "2",
    "verse": "14",
    "text": "“Vậy nên Ta sẽ thu phục nó một lần nữa."
  },
  {
    "id": 30515,
    "book": "hosea                                   ",
    "chapter": "2",
    "verse": "15",
    "text": "Ta sẽ trao cho nó các vườn nho,"
  },
  {
    "id": 30516,
    "book": "hosea                                   ",
    "chapter": "2",
    "verse": "16",
    "text": "Chúa Hằng Hữu phán: “Khi ngày ấy đến,"
  },
  {
    "id": 30517,
    "book": "hosea                                   ",
    "chapter": "2",
    "verse": "17",
    "text": "Hỡi Ít-ra-ên, Ta sẽ quét sạch những tên của thần Ba-anh khỏi môi miệng ngươi,"
  },
  {
    "id": 30518,
    "book": "hosea                                   ",
    "chapter": "2",
    "verse": "18",
    "text": "Vào ngày ấy, Ta sẽ lập giao ước"
  },
  {
    "id": 30519,
    "book": "hosea                                   ",
    "chapter": "2",
    "verse": "19",
    "text": "Ta sẽ cưới ngươi cho Ta đời đời,"
  },
  {
    "id": 30520,
    "book": "hosea                                   ",
    "chapter": "2",
    "verse": "20",
    "text": "Ta sẽ thành tín với ngươi và khiến ngươi thuộc về Ta,"
  },
  {
    "id": 30521,
    "book": "hosea                                   ",
    "chapter": "2",
    "verse": "21",
    "text": "Chúa Hằng Hữu phán:"
  },
  {
    "id": 30522,
    "book": "hosea                                   ",
    "chapter": "2",
    "verse": "22",
    "text": "Rồi đất sẽ đáp lời cho cơn khát"
  },
  {
    "id": 30523,
    "book": "hosea                                   ",
    "chapter": "2",
    "verse": "23",
    "text": "Lúc ấy, Ta sẽ gieo trồng mùa Ít-ra-ên"
  }
]