[
  {
    "id": 2597,
    "book": "firstChronicles                         ",
    "chapter": "8",
    "verse": "1",
    "text": "Con trưởng của Bên-gia-min là Bê-la, thứ hai là Ách-bên, thứ ba là A-ha-ra,"
  },
  {
    "id": 2598,
    "book": "firstChronicles                         ",
    "chapter": "8",
    "verse": "2",
    "text": "thứ tư là Nô-ha, và thứ năm là Ra-pha."
  },
  {
    "id": 2599,
    "book": "firstChronicles                         ",
    "chapter": "8",
    "verse": "3",
    "text": "Các con Bê-la là Át-đa, Ghê-ra, A-bi-hút,"
  },
  {
    "id": 2600,
    "book": "firstChronicles                         ",
    "chapter": "8",
    "verse": "4",
    "text": "A-bi-sua, Na-a-man, A-hô-a,"
  },
  {
    "id": 2601,
    "book": "firstChronicles                         ",
    "chapter": "8",
    "verse": "5",
    "text": "Ghê-ra, Sê-phu-phan, và Hu-ram."
  },
  {
    "id": 2602,
    "book": "firstChronicles                         ",
    "chapter": "8",
    "verse": "6",
    "text": "Các con của Ê-hút đều làm trưởng họ trong gia đình Ghê-ba, nhưng về sau, họ bị bắt đày sang Ma-na-hát."
  },
  {
    "id": 2603,
    "book": "firstChronicles                         ",
    "chapter": "8",
    "verse": "7",
    "text": "Các con của A-bi-hút là Na-a-man, A-hi-gia, và Ghê-ra (còn gọi là Hê-lam) là cha của U-xa và A-hi-hút."
  },
  {
    "id": 2604,
    "book": "firstChronicles                         ",
    "chapter": "8",
    "verse": "8",
    "text": "Còn một người nữa là Sa-ha-ra-im, có vợ con ở trong xứ Mô-áp. Sau khi ly dị hai vợ là Hu-sim và Ba-ra, ông cưới Hô-đe và sinh được"
  },
  {
    "id": 2605,
    "book": "firstChronicles                         ",
    "chapter": "8",
    "verse": "9",
    "text": "Giô-báp, Xi-bia, Mê-sa, Manh-cam,"
  },
  {
    "id": 2606,
    "book": "firstChronicles                         ",
    "chapter": "8",
    "verse": "10",
    "text": "Giê-út, Sô-kia, và Mít-ma. Các con của Sa-ha-ra-im đều làm trưởng họ."
  },
  {
    "id": 2607,
    "book": "firstChronicles                         ",
    "chapter": "8",
    "verse": "11",
    "text": "Bà Hu-sim cũng đã sinh được A-hi-túp và Ên-ba-anh."
  },
  {
    "id": 2608,
    "book": "firstChronicles                         ",
    "chapter": "8",
    "verse": "12",
    "text": "Các con Ên-ba-anh là Ê-be, Mi-sê-am, Sê-mết (người xây thành Ô-nô, Lót và các thôn ấp phụ cận),"
  },
  {
    "id": 2609,
    "book": "firstChronicles                         ",
    "chapter": "8",
    "verse": "13",
    "text": "Bê-ri-a, và Sê-ma. Hai người này làm trưởng họ trong cộng đồng A-gia-lôn và có công đánh đuổi thổ dân ở đất Gát."
  },
  {
    "id": 2610,
    "book": "firstChronicles                         ",
    "chapter": "8",
    "verse": "14",
    "text": "Các con trai của Bê-ri-a là A-hi-ô, Sa-sác, Giê-rê-mốt,"
  },
  {
    "id": 2611,
    "book": "firstChronicles                         ",
    "chapter": "8",
    "verse": "15",
    "text": "Xê-ba-đia, A-rát, Ê-đe,"
  },
  {
    "id": 2612,
    "book": "firstChronicles                         ",
    "chapter": "8",
    "verse": "16",
    "text": "Mi-ca-ên, Dít-pha, và Giô-ha."
  },
  {
    "id": 2613,
    "book": "firstChronicles                         ",
    "chapter": "8",
    "verse": "17",
    "text": "Các con Ên-ba-anh là Xê-ba-đia, Mê-su-lam, Hi-ki, Hê-be,"
  },
  {
    "id": 2614,
    "book": "firstChronicles                         ",
    "chapter": "8",
    "verse": "18",
    "text": "Gít-mê-rai, Gít-lia, và Giô-báp."
  },
  {
    "id": 2615,
    "book": "firstChronicles                         ",
    "chapter": "8",
    "verse": "19",
    "text": "Các con Si-mê-i là Gia-kim, Xiếc-ri, Xáp-đi,"
  },
  {
    "id": 2616,
    "book": "firstChronicles                         ",
    "chapter": "8",
    "verse": "20",
    "text": "Ê-li-ê-nai, Xi-lê-thai, Ê-li-ên,"
  },
  {
    "id": 2617,
    "book": "firstChronicles                         ",
    "chapter": "8",
    "verse": "21",
    "text": "A-đa-gia, Bê-ra-gia, và Sim-rát."
  },
  {
    "id": 2618,
    "book": "firstChronicles                         ",
    "chapter": "8",
    "verse": "22",
    "text": "Các con Sa-sác là Gít-ban, Ê-be, Ê-li-ên,"
  },
  {
    "id": 2619,
    "book": "firstChronicles                         ",
    "chapter": "8",
    "verse": "23",
    "text": "Áp-đôn, Xiếc-ri, Ha-nan,"
  },
  {
    "id": 2620,
    "book": "firstChronicles                         ",
    "chapter": "8",
    "verse": "24",
    "text": "Ha-na-nia, Ê-lam, An-tô-ti-gia,"
  },
  {
    "id": 2621,
    "book": "firstChronicles                         ",
    "chapter": "8",
    "verse": "25",
    "text": "Gíp-đê-gia, và Phê-nu-ên."
  },
  {
    "id": 2622,
    "book": "firstChronicles                         ",
    "chapter": "8",
    "verse": "26",
    "text": "Các con Giê-rô-ham là Sam-sê-rai, Sê-ha-ria, A-tha-li-a,"
  },
  {
    "id": 2623,
    "book": "firstChronicles                         ",
    "chapter": "8",
    "verse": "27",
    "text": "Gia-rê-sia, Ê-li, và Xiếc-ri."
  },
  {
    "id": 2624,
    "book": "firstChronicles                         ",
    "chapter": "8",
    "verse": "28",
    "text": "Họ là người đứng đầu dòng tộc; tất cả đều được ghi vào sổ gia phả, và họ sống tại Giê-ru-sa-lem."
  },
  {
    "id": 2625,
    "book": "firstChronicles                         ",
    "chapter": "8",
    "verse": "29",
    "text": "Giê-i-ên (ông tổ của dân thành Ga-ba-ôn) có vợ là bà Ma-a-ca,"
  },
  {
    "id": 2626,
    "book": "firstChronicles                         ",
    "chapter": "8",
    "verse": "30",
    "text": "và các con: Áp-đôn (con trưởng), Xu-rơ, Kích, Ba-anh, Na-đáp,"
  },
  {
    "id": 2627,
    "book": "firstChronicles                         ",
    "chapter": "8",
    "verse": "31",
    "text": "Ghê-đô, A-hi-ô, Xê-ke,"
  },
  {
    "id": 2628,
    "book": "firstChronicles                         ",
    "chapter": "8",
    "verse": "32",
    "text": "và Mích-lô là cha Si-mê-a. Các gia đình này ở cạnh nhau gần Giê-ru-sa-lem."
  },
  {
    "id": 2629,
    "book": "firstChronicles                         ",
    "chapter": "8",
    "verse": "33",
    "text": "Nê-rơ sinh Kích; Kích sinh Sau-lơ."
  },
  {
    "id": 2630,
    "book": "firstChronicles                         ",
    "chapter": "8",
    "verse": "34",
    "text": "Giô-na-than sinh Mi-ri Ba-anh."
  },
  {
    "id": 2631,
    "book": "firstChronicles                         ",
    "chapter": "8",
    "verse": "35",
    "text": "Các con Mi-ca là Phi-thôn, Mê-léc, Ta-rê-a, và A-cha."
  },
  {
    "id": 2632,
    "book": "firstChronicles                         ",
    "chapter": "8",
    "verse": "36",
    "text": "A-cha sinh Giê-hô-a-đa."
  },
  {
    "id": 2633,
    "book": "firstChronicles                         ",
    "chapter": "8",
    "verse": "37",
    "text": "Một-sa sinh Bi-nê-a."
  },
  {
    "id": 2634,
    "book": "firstChronicles                         ",
    "chapter": "8",
    "verse": "38",
    "text": "A-xên có sáu con: A-ri-kham, Bốc-ru, Ích-ma-ên, Sê-a-ria, Ô-ba-đia, và Ha-nan."
  },
  {
    "id": 2635,
    "book": "firstChronicles                         ",
    "chapter": "8",
    "verse": "39",
    "text": "Ê-sết, em A-xên, có các con sau đây: U-lam con trưởng, Giê-úc thứ hai, và Ê-li-phê-lết thứ ba."
  },
  {
    "id": 2636,
    "book": "firstChronicles                         ",
    "chapter": "8",
    "verse": "40",
    "text": "Các con của U-lam đều là những chiến sĩ anh dũng, có tài bắn cung. Tổng số con và cháu nội của họ là 150 người."
  }
]