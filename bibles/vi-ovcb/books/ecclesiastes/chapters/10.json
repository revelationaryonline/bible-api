  {
    "id": 26073,
    "book": "ecclesiastes                            ",
    "chapter": "10",
    "verse": "6",
    "text": "khi họ cất nhắc người ngu dại lên chức vụ cao, và người có nhiều khả năng phải giữ địa vị thấp kém."
  },
  {
    "id": 26074,
    "book": "ecclesiastes                            ",
    "chapter": "10",
    "verse": "7",
    "text": "Tôi còn thấy cảnh đầy tớ đi ngựa như các hoàng tử—và hoàng tử lại đi bộ như đầy tớ!"
  },
  {
    "id": 26075,
    "book": "ecclesiastes                            ",
    "chapter": "10",
    "verse": "8",
    "text": "Ai đào hố phải sa xuống hố."
  },
  {
    "id": 26076,
    "book": "ecclesiastes                            ",
    "chapter": "10",
    "verse": "9",
    "text": "Người lăn đá bị đá đè."
  },
  {
    "id": 26077,
    "book": "ecclesiastes                            ",
    "chapter": "10",
    "verse": "10",
    "text": "Dùng một cái rìu cùn sẽ phí nhiều sức,"
