[
  {
    "id": 19166,
    "book": "solomon                                 ",
    "chapter": "2",
    "verse": "1",
    "text": "Em là hoa thủy tiên nở rộ trên Cánh Đồng Sa-rôn,"
  },
  {
    "id": 19167,
    "book": "solomon                                 ",
    "chapter": "2",
    "verse": "2",
    "text": "Em yêu dấu của anh giữa vòng các thiếu nữ"
  },
  {
    "id": 19168,
    "book": "solomon                                 ",
    "chapter": "2",
    "verse": "3",
    "text": "Người yêu của em giữa các chàng trai khác"
  },
  {
    "id": 19169,
    "book": "solomon                                 ",
    "chapter": "2",
    "verse": "4",
    "text": "Chàng đưa em vào phòng yến tiệc;"
  },
  {
    "id": 19170,
    "book": "solomon                                 ",
    "chapter": "2",
    "verse": "5",
    "text": "Hãy thêm sức cho em bằng những bánh nho,"
  },
  {
    "id": 19171,
    "book": "solomon                                 ",
    "chapter": "2",
    "verse": "6",
    "text": "Tay trái chàng kê dưới đầu em,"
  },
  {
    "id": 19172,
    "book": "solomon                                 ",
    "chapter": "2",
    "verse": "7",
    "text": "Hãy hứa với tôi, hỡi người nữ Giê-ru-sa-lem,"
  },
  {
    "id": 19173,
    "book": "solomon                                 ",
    "chapter": "2",
    "verse": "8",
    "text": "Này, em nghe tiếng chân người yêu đang đến!"
  },
  {
    "id": 19174,
    "book": "solomon                                 ",
    "chapter": "2",
    "verse": "9",
    "text": "Người yêu em như linh dương thoăn thoắt"
  },
  {
    "id": 19175,
    "book": "solomon                                 ",
    "chapter": "2",
    "verse": "10",
    "text": "Người yêu em nói với em rằng:"
  },
  {
    "id": 19176,
    "book": "solomon                                 ",
    "chapter": "2",
    "verse": "11",
    "text": "Ô kìa, mùa đông đã trôi qua,"
  },
  {
    "id": 19177,
    "book": "solomon                                 ",
    "chapter": "2",
    "verse": "12",
    "text": "Những cánh hoa đang nở rộ khắp đất,"
  },
  {
    "id": 19178,
    "book": "solomon                                 ",
    "chapter": "2",
    "verse": "13",
    "text": "Những cây vả đã bắt đầu ra trái,"
  },
  {
    "id": 19179,
    "book": "solomon                                 ",
    "chapter": "2",
    "verse": "14",
    "text": "Bồ câu của anh đang ẩn mình trong đá,"
  },
  {
    "id": 19180,
    "book": "solomon                                 ",
    "chapter": "2",
    "verse": "15",
    "text": "Hãy bắt tất cả chồn, những con chồn nhỏ kia,"
  },
  {
    "id": 19181,
    "book": "solomon                                 ",
    "chapter": "2",
    "verse": "16",
    "text": "Người yêu của em thuộc riêng em, và em là của chàng."
  },
  {
    "id": 19182,
    "book": "solomon                                 ",
    "chapter": "2",
    "verse": "17",
    "text": "Trước khi gió mai hiu hiu thổi"
  }
]