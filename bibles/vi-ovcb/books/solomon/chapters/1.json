[
  {
    "id": 19149,
    "book": "solomon                                 ",
    "chapter": "1",
    "verse": "1",
    "text": "Đây là bài ca trong các bài ca của Sa-lô-môn, tuyệt vời hơn bất cứ bài ca nào khác."
  },
  {
    "id": 19150,
    "book": "solomon                                 ",
    "chapter": "1",
    "verse": "2",
    "text": "Hãy hôn em và hôn em lần nữa,"
  },
  {
    "id": 19151,
    "book": "solomon                                 ",
    "chapter": "1",
    "verse": "3",
    "text": "Mùi thơm chàng ngào ngạt quyến rũ;"
  },
  {
    "id": 19152,
    "book": "solomon                                 ",
    "chapter": "1",
    "verse": "4",
    "text": "Xin cho em theo chàng; nào, chúng ta cùng chạy!"
  },
  {
    "id": 19153,
    "book": "solomon                                 ",
    "chapter": "1",
    "verse": "5",
    "text": "Da em đen nhưng rất đẹp xinh,"
  },
  {
    "id": 19154,
    "book": "solomon                                 ",
    "chapter": "1",
    "verse": "6",
    "text": "Đừng cứ nhìn em vì làn da đen—"
  },
  {
    "id": 19155,
    "book": "solomon                                 ",
    "chapter": "1",
    "verse": "7",
    "text": "Xin hãy nói với em, người em yêu mến, hôm nay chàng chăn bầy nơi đâu?"
  },
  {
    "id": 19156,
    "book": "solomon                                 ",
    "chapter": "1",
    "verse": "8",
    "text": "Hỡi người đẹp nhất trong các thiếu nữ, nếu em không biết,"
  },
  {
    "id": 19157,
    "book": "solomon                                 ",
    "chapter": "1",
    "verse": "9",
    "text": "Em thật lý thú, em yêu dấu của anh,"
  },
  {
    "id": 19158,
    "book": "solomon                                 ",
    "chapter": "1",
    "verse": "10",
    "text": "Đôi má em đáng yêu làm sao;"
  },
  {
    "id": 19159,
    "book": "solomon                                 ",
    "chapter": "1",
    "verse": "11",
    "text": "Chúng tôi sẽ làm cho em hoa tai bằng vàng"
  },
  {
    "id": 19160,
    "book": "solomon                                 ",
    "chapter": "1",
    "verse": "12",
    "text": "Khi vua đang nằm dài trên ghế,"
  },
  {
    "id": 19161,
    "book": "solomon                                 ",
    "chapter": "1",
    "verse": "13",
    "text": "Người yêu em như bó hoa một dược"
  },
  {
    "id": 19162,
    "book": "solomon                                 ",
    "chapter": "1",
    "verse": "14",
    "text": "Chàng như chùm hoa phụng tiên,"
  },
  {
    "id": 19163,
    "book": "solomon                                 ",
    "chapter": "1",
    "verse": "15",
    "text": "Em quá đẹp, em yêu dấu của anh,"
  },
  {
    "id": 19164,
    "book": "solomon                                 ",
    "chapter": "1",
    "verse": "16",
    "text": "Chàng đẹp biết bao, hỡi người em yêu,"
  },
  {
    "id": 19165,
    "book": "solomon                                 ",
    "chapter": "1",
    "verse": "17",
