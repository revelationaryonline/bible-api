  {
    "id": 19201,
    "book": "solomon                                 ",
    "chapter": "4",
    "verse": "8",
    "text": "Hãy cùng anh rời khỏi Li-ban, cô dâu của anh ơi."
  },
  {
    "id": 19202,
    "book": "solomon                                 ",
    "chapter": "4",
    "verse": "9",
    "text": "Em đã bắt lấy hồn anh,"
  },
  {
    "id": 19203,
    "book": "solomon                                 ",
    "chapter": "4",
    "verse": "10",
    "text": "Tình yêu của em thắm thiết nồng nàn,"
  },
  {
    "id": 19204,
    "book": "solomon                                 ",
    "chapter": "4",
    "verse": "11",
    "text": "Cô dâu của anh ơi, môi em ngọt như mật hoa,"
  },
  {
    "id": 19205,
    "book": "solomon                                 ",
    "chapter": "4",
    "verse": "12",
    "text": "Em là vườn kín của riêng anh, em gái anh, cô dâu của anh ơi,"
  },
  {
    "id": 19206,
    "book": "solomon                                 ",
    "chapter": "4",
    "verse": "13",
    "text": "Tay chân em tựa vườn thạch lựu ngọt ngon"
  },
  {
    "id": 19207,
    "book": "solomon                                 ",
