[
  {
    "id": 19252,
    "book": "solomon                                 ",
    "chapter": "8",
    "verse": "1",
    "text": "Ôi, ước gì chàng là anh trai của em,"
  },
  {
    "id": 19253,
    "book": "solomon                                 ",
    "chapter": "8",
    "verse": "2",
    "text": "Em có thể đưa chàng về nhà mẹ em,"
  },
  {
    "id": 19254,
    "book": "solomon                                 ",
    "chapter": "8",
    "verse": "3",
    "text": "Tay trái chàng kê dưới đầu em,"
  },
  {
    "id": 19255,
    "book": "solomon                                 ",
    "chapter": "8",
    "verse": "4",
    "text": "Hãy hứa với em, hỡi các thiếu nữ Giê-ru-sa-lem,"
  },
  {
    "id": 19256,
    "book": "solomon                                 ",
    "chapter": "8",
    "verse": "5",
    "text": "Ai từ hoang mạc đến"
  },
  {
    "id": 19257,
    "book": "solomon                                 ",
    "chapter": "8",
    "verse": "6",
    "text": "Xin đặt em như chiếc ấn trong lòng chàng,"
  },
  {
    "id": 19258,
    "book": "solomon                                 ",
    "chapter": "8",
    "verse": "7",
    "text": "Bao nhiêu nước cũng không thể làm nguội lạnh tình yêu,"
  },
  {
    "id": 19259,
    "book": "solomon                                 ",
    "chapter": "8",
    "verse": "8",
    "text": "Chúng tôi có người em gái nhỏ"
  },
  {
    "id": 19260,
    "book": "solomon                                 ",
    "chapter": "8",
    "verse": "9",
    "text": "Nếu em là trinh nữ, như bức tường,"
  },
  {
    "id": 19261,
    "book": "solomon                                 ",
    "chapter": "8",
    "verse": "10",
    "text": "Em là trinh nữ, như bức tường;"
  },
  {
    "id": 19262,
    "book": "solomon                                 ",
    "chapter": "8",
    "verse": "11",
    "text": "Sa-lô-môn có vườn nho tại Ba-anh Ha-môn,"
  },
  {
    "id": 19263,
    "book": "solomon                                 ",
    "chapter": "8",
    "verse": "12",
    "text": "Nhưng vườn nho của em không phải để bán,"
  },
  {
    "id": 19264,
    "book": "solomon                                 ",
    "chapter": "8",
    "verse": "13",
    "text": "Ôi em yêu dấu, cứ ở trong vườn,"
  },
  {
    "id": 19265,
    "book": "solomon                                 ",
    "chapter": "8",
    "verse": "14",
    "text": "Nhanh lên anh, người yêu của em ơi! Như linh dương"
  }
]