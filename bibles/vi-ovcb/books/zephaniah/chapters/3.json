[
  {
    "id": 31077,
    "book": "zephaniah                               ",
    "chapter": "3",
    "verse": "1",
    "text": "Khốn cho Giê-ru-sa-lem,"
  },
  {
    "id": 31078,
    "book": "zephaniah                               ",
    "chapter": "3",
    "verse": "2",
    "text": "Nó khước từ không nghe tiếng gọi,"
  },
  {
    "id": 31079,
    "book": "zephaniah                               ",
    "chapter": "3",
    "verse": "3",
    "text": "Những lãnh đạo nó giống như sư tử gầm thét."
  },
  {
    "id": 31080,
    "book": "zephaniah                               ",
    "chapter": "3",
    "verse": "4",
    "text": "Các tiên tri nó kiêu căng, phản trắc."
  },
  {
    "id": 31081,
    "book": "zephaniah                               ",
    "chapter": "3",
    "verse": "5",
    "text": "Chúa Hằng Hữu công chính đang ngự giữa đất nước nó,"
  },
  {
    "id": 31082,
    "book": "zephaniah                               ",
    "chapter": "3",
    "verse": "6",
    "text": "Chúa Hằng Hữu phán: “Ta đã tiêu diệt nhiều nước,"
  },
  {
    "id": 31083,
    "book": "zephaniah                               ",
    "chapter": "3",
    "verse": "7",
    "text": "Ta nghĩ: ‘Chắc hẳn ngươi sẽ kính sợ Ta."
  },
  {
    "id": 31084,
    "book": "zephaniah                               ",
    "chapter": "3",
    "verse": "8",
    "text": "Vì thế, Chúa Hằng Hữu phán:"
  },
  {
    "id": 31085,
    "book": "zephaniah                               ",
    "chapter": "3",
    "verse": "9",
    "text": "Lúc ấy, Ta sẽ thánh hóa môi miệng các dân tộc,3:9 Ctd các nước"
  },
  {
    "id": 31086,
    "book": "zephaniah                               ",
    "chapter": "3",
    "verse": "10",
    "text": "Những người thờ phượng Ta"
  },
  {
    "id": 31087,
    "book": "zephaniah                               ",
    "chapter": "3",
    "verse": "11",
    "text": "Ngày ấy, ngươi sẽ không còn hổ thẹn"
  },
  {
    "id": 31088,
    "book": "zephaniah                               ",
    "chapter": "3",
    "verse": "12",
    "text": "Ta cũng sẽ để lại giữa ngươi một dân nghèo nàn yếu đuối,"
  },
  {
    "id": 31089,
    "book": "zephaniah                               ",
    "chapter": "3",
    "verse": "13",
    "text": "Người Ít-ra-ên còn sót lại sẽ không làm ác;"
  },
  {
    "id": 31090,
    "book": "zephaniah                               ",
    "chapter": "3",
    "verse": "14",
    "text": "Con gái Si-ôn, hãy hớn hở;"
  },
  {
    "id": 31091,
    "book": "zephaniah                               ",
    "chapter": "3",
    "verse": "15",
    "text": "Chúa Hằng Hữu đã ân xá các ngươi"
  },
  {
    "id": 31092,
    "book": "zephaniah                               ",
    "chapter": "3",
    "verse": "16",
    "text": "Ngày ấy, có tiếng phán bảo Giê-ru-sa-lem:"
  },
  {
    "id": 31093,
    "book": "zephaniah                               ",
    "chapter": "3",
    "verse": "17",
    "text": "Vì Chúa Hằng Hữu, Đức Chúa Trời của ngươi,"
  },
  {
    "id": 31094,
    "book": "zephaniah                               ",
    "chapter": "3",
    "verse": "18",
    "text": "Ta sẽ tập họp những người đang than khóc"
  },
  {
    "id": 31095,
    "book": "zephaniah                               ",
    "chapter": "3",
    "verse": "19",
    "text": "Khi ấy, Ta sẽ có biện pháp3:19 Nt sẽ điều đình với những người áp bức ngươi."
  },
  {
    "id": 31096,
    "book": "zephaniah                               ",
    "chapter": "3",
    "verse": "20",
    "text": "Khi ấy, Ta sẽ đem ngươi trở về,"
  }
]
