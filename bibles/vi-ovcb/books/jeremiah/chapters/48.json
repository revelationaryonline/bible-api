[
  {
    "id": 11467,
    "book": "jeremiah                                ",
    "chapter": "48",
    "verse": "1",
    "text": "Sứ điệp này phán về Mô-áp. Đây là điều Chúa Hằng Hữu Vạn Quân, Đức Chúa Trời của Ít-ra-ên, phán:"
  },
  {
    "id": 11468,
    "book": "jeremiah                                ",
    "chapter": "48",
    "verse": "2",
    "text": "Danh tiếng của Mô-áp không còn nữa,"
  },
  {
    "id": 11469,
    "book": "jeremiah                                ",
    "chapter": "48",
    "verse": "3",
    "text": "Hãy nghe tiếng kêu khóc từ Hô-rô-na-im,"
  },
  {
    "id": 11470,
    "book": "jeremiah                                ",
    "chapter": "48",
    "verse": "4",
    "text": "Mô-áp bị tiêu diệt."
  },
  {
    "id": 11471,
    "book": "jeremiah                                ",
    "chapter": "48",
    "verse": "5",
    "text": "Trên đường lên Lu-hít,"
  },
  {
    "id": 11472,
    "book": "jeremiah                                ",
    "chapter": "48",
    "verse": "6",
    "text": "Hãy trốn chạy vì mạng sống mình!"
  },
  {
    "id": 11473,
    "book": "jeremiah                                ",
    "chapter": "48",
    "verse": "7",
    "text": "Vì các ngươi ỷ lại nơi của cải và thành tích,"
  },
  {
    "id": 11474,
    "book": "jeremiah                                ",
    "chapter": "48",
    "verse": "8",
    "text": "Tất cả thành sẽ bị hủy diệt,"
  },
  {
    "id": 11475,
    "book": "jeremiah                                ",
    "chapter": "48",
    "verse": "9",
    "text": "Ước gì người Mô-áp mọc cánh"
  },
  {
    "id": 11476,
    "book": "jeremiah                                ",
    "chapter": "48",
    "verse": "10",
    "text": "Khốn cho người làm việc Chúa cách giả dối,"
  },
  {
    "id": 11477,
    "book": "jeremiah                                ",
    "chapter": "48",
    "verse": "11",
    "text": "Từ khởi đầu lịch sử, Mô-áp đã sống trong an nhàn,"
  },
  {
    "id": 11478,
    "book": "jeremiah                                ",
    "chapter": "48",
    "verse": "12",
    "text": "Chúa Hằng Hữu phán: “Nhưng sắp đến kỳ"
  },
  {
    "id": 11479,
    "book": "jeremiah                                ",
    "chapter": "48",
    "verse": "13",
    "text": "Lúc ấy, người Mô-áp mới hổ thẹn về thần Kê-mốt,"
  },
  {
    "id": 11480,
    "book": "jeremiah                                ",
    "chapter": "48",
    "verse": "14",
    "text": "Sao các ngươi còn khoác lác: ‘Chúng ta là những anh hùng,"
  },
  {
    "id": 11481,
    "book": "jeremiah                                ",
    "chapter": "48",
    "verse": "15",
    "text": "Nhưng bây giờ Mô-áp và các thành nó sẽ bị hủy diệt."
  },
  {
    "id": 11482,
    "book": "jeremiah                                ",
    "chapter": "48",
    "verse": "16",
    "text": "“Tai họa sắp đổ xuống Mô-áp;"
  },
  {
    "id": 11483,
    "book": "jeremiah                                ",
    "chapter": "48",
    "verse": "17",
    "text": "Các dân tộc lân bang của Mô-áp,"
  },
  {
    "id": 11484,
    "book": "jeremiah                                ",
    "chapter": "48",
    "verse": "18",
    "text": "Hãy rời vinh quang của ngươi"
  },
  {
    "id": 11485,
    "book": "jeremiah                                ",
    "chapter": "48",
    "verse": "19",
    "text": "Hỡi dân cư A-rô-e,"
  },
  {
    "id": 11486,
    "book": "jeremiah                                ",
    "chapter": "48",
    "verse": "20",
    "text": "Và đáp rằng:"
  },
  {
    "id": 11487,
    "book": "jeremiah                                ",
    "chapter": "48",
    "verse": "21",
    "text": "Sự trừng phạt giáng xuống khắp vùng bình nguyên—"
  },
  {
    "id": 11488,
    "book": "jeremiah                                ",
    "chapter": "48",
    "verse": "22",
    "text": "Đi-bôn, Nê-bô, và Bết Đíp-la-tha-im,"
  },
  {
    "id": 11489,
    "book": "jeremiah                                ",
    "chapter": "48",
    "verse": "23",
    "text": "Ki-ri-a-ta-im, Bết Ga-mun, và Bết Mê-ôn,"
  },
  {
    "id": 11490,
    "book": "jeremiah                                ",
    "chapter": "48",
    "verse": "24",
    "text": "Kê-ri-giốt và Bốt-ra—"
  },
  {
    "id": 11491,
    "book": "jeremiah                                ",
    "chapter": "48",
    "verse": "25",
    "text": "Chúa Hằng Hữu phán: “Sức mạnh của Mô-áp đã kết thúc."
  },
  {
    "id": 11492,
    "book": "jeremiah                                ",
    "chapter": "48",
    "verse": "26",
    "text": "Hãy làm cho Mô-áp say"
  },
  {
    "id": 11493,
    "book": "jeremiah                                ",
    "chapter": "48",
    "verse": "27",
    "text": "Có phải ngươi đã chế giễu Ít-ra-ên?"
  },
  {
    "id": 11494,
    "book": "jeremiah                                ",
    "chapter": "48",
    "verse": "28",
    "text": "Hỡi cư dân Mô-áp,"
  },
  {
    "id": 11495,
    "book": "jeremiah                                ",
    "chapter": "48",
    "verse": "29",
    "text": "Chúng ta đã nghe nói rằng Mô-áp rất kiêu căng,"
  },
  {
    "id": 11496,
    "book": "jeremiah                                ",
    "chapter": "48",
    "verse": "30",
    "text": "Chúa Hằng Hữu phán: “Ta biết Mô-áp thật xấc xược"
  },
  {
    "id": 11497,
    "book": "jeremiah                                ",
    "chapter": "48",
    "verse": "31",
    "text": "Vì thế, Ta than van cho Mô-áp;"
  },
  {
    "id": 11498,
    "book": "jeremiah                                ",
    "chapter": "48",
    "verse": "32",
    "text": "Hỡi cây nho ở Síp-ma,"
  },
  {
    "id": 11499,
    "book": "jeremiah                                ",
    "chapter": "48",
    "verse": "33",
    "text": "Sự hoan hỉ và vui mừng đã biến mất khỏi cánh đồng phì nhiêu của xứ Mô-áp."
  },
  {
    "id": 11500,
    "book": "jeremiah                                ",
    "chapter": "48",
    "verse": "34",
    "text": "Nhưng là tiếng kêu la kinh hoàng từ Hết-bôn cho đến tận Ê-lê-a-lê và Gia-hát; từ Xoa đến tận Hô-rô-na-im và Ê-lát Sê-li-sia. Ngay cả nước Nim-rim cũng khô cạn.”"
  },
  {
    "id": 11501,
    "book": "jeremiah                                ",
    "chapter": "48",
    "verse": "35",
    "text": "Chúa Hằng Hữu phán: “Ta sẽ chấm dứt sự cúng tế tại những nơi cao và việc dâng hương cho các thần tượng tại Mô-áp."
  },
  {
    "id": 11502,
    "book": "jeremiah                                ",
    "chapter": "48",
    "verse": "36",
    "text": "Lòng Ta than khóc Mô-áp và Kiệt Ha-rê-sết như tiếng sáo buồn thảm, vì tài nguyên chúng tích trữ đã mất hết rồi."
  },
  {
    "id": 11503,
    "book": "jeremiah                                ",
    "chapter": "48",
    "verse": "37",
    "text": "Dân chúng cạo trọc đầu và râu mình trong than khóc. Chúng chém tay mình và lưng thắt bao gai."
  },
  {
    "id": 11504,
    "book": "jeremiah                                ",
    "chapter": "48",
    "verse": "38",
    "text": "Khắp các đường phố Mô-áp, trên các sân thượng đều vang tiếng khóc lóc, than van. Vì Ta đã đập tan Mô-áp như cái bình cũ kỹ, vô dụng."
  },
  {
    "id": 11505,
    "book": "jeremiah                                ",
    "chapter": "48",
    "verse": "39",
    "text": "Hãy nghe tiếng đập vỡ! Hãy nghe tiếng khóc than! Hãy xem cảnh sỉ nhục của Mô-áp. Nó trở nên đề tài chế giễu, là biểu tượng sụp đổ cho các dân tộc lân bang.”"
  },
  {
    "id": 11506,
    "book": "jeremiah                                ",
    "chapter": "48",
    "verse": "40",
    "text": "Đây là điều Chúa Hằng Hữu phán:"
  },
  {
    "id": 11507,
    "book": "jeremiah                                ",
    "chapter": "48",
    "verse": "41",
    "text": "Các thành của nó sẽ bị chiếm đóng,"
  },
  {
    "id": 11508,
    "book": "jeremiah                                ",
    "chapter": "48",
    "verse": "42",
    "text": "Mô-áp sẽ không còn là một nước nữa,"
  },
  {
    "id": 11509,
    "book": "jeremiah                                ",
    "chapter": "48",
    "verse": "43",
    "text": "Chúa Hằng Hữu phán: “Hỡi Mô-áp!"
  },
  {
    "id": 11510,
    "book": "jeremiah                                ",
    "chapter": "48",
    "verse": "44",
    "text": "Ai trốn sẽ mắc vào cạm bẫy,"
  },
  {
    "id": 11511,
    "book": "jeremiah                                ",
    "chapter": "48",
    "verse": "45",
    "text": "Những người chạy trốn đến Hết-bôn,"
  },
  {
    "id": 11512,
    "book": "jeremiah                                ",
    "chapter": "48",
    "verse": "46",
    "text": "Hỡi Mô-áp, người ta than khóc cho ngươi!"
  },
  {
    "id": 11513,
    "book": "jeremiah                                ",
    "chapter": "48",
    "verse": "47",
    "text": "“Nhưng Ta sẽ phục hồi sự thịnh vượng của Mô-áp"
  }
]