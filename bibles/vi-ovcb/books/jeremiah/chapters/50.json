[
  {
    "id": 11553,
    "book": "jeremiah                                ",
    "chapter": "50",
    "verse": "1",
    "text": "Chúa Hằng Hữu ban sứ điệp này cho Tiên tri Giê-rê-mi về Ba-by-lôn và xứ của người Ba-by-lôn."
  },
  {
    "id": 11554,
    "book": "jeremiah                                ",
    "chapter": "50",
    "verse": "2",
    "text": "Đây là điều Chúa Hằng Hữu phán:"
  },
  {
    "id": 11555,
    "book": "jeremiah                                ",
    "chapter": "50",
    "verse": "3",
    "text": "Vì một nước từ phương bắc sẽ tấn công"
  },
  {
    "id": 11556,
    "book": "jeremiah                                ",
    "chapter": "50",
    "verse": "4",
    "text": "Chúa Hằng Hữu phán:"
  },
  {
    "id": 11557,
    "book": "jeremiah                                ",
    "chapter": "50",
    "verse": "5",
    "text": "Họ sẽ hỏi đường về Si-ôn"
  },
  {
    "id": 11558,
    "book": "jeremiah                                ",
    "chapter": "50",
    "verse": "6",
    "text": "Dân Ta như đàn chiên thất lạc."
  },
  {
    "id": 11559,
    "book": "jeremiah                                ",
    "chapter": "50",
    "verse": "7",
    "text": "Ai gặp chúng cũng ăn nuốt chúng."
  },
  {
    "id": 11560,
    "book": "jeremiah                                ",
    "chapter": "50",
    "verse": "8",
    "text": "Nhưng bây giờ, hãy trốn ra khỏi Ba-by-lôn!"
  },
  {
    "id": 11561,
    "book": "jeremiah                                ",
    "chapter": "50",
    "verse": "9",
    "text": "Vì kìa, Ta dấy binh"
  },
  {
    "id": 11562,
    "book": "jeremiah                                ",
    "chapter": "50",
    "verse": "10",
    "text": "Canh-đê sẽ bị cướp phá"
  },
  {
    "id": 11563,
    "book": "jeremiah                                ",
    "chapter": "50",
    "verse": "11",
    "text": "“Các ngươi vui mừng và hớn hở"
  },
  {
    "id": 11564,
    "book": "jeremiah                                ",
    "chapter": "50",
    "verse": "12",
    "text": "Mẹ các ngươi sẽ bị chôn vùi"
  },
  {
    "id": 11565,
    "book": "jeremiah                                ",
    "chapter": "50",
    "verse": "13",
    "text": "Vì cơn thịnh nộ của Chúa Hằng Hữu,"
  },
  {
    "id": 11566,
    "book": "jeremiah                                ",
    "chapter": "50",
    "verse": "14",
    "text": "Phải, hãy chuẩn bị tấn cống Ba-by-lôn,"
  },
  {
    "id": 11567,
    "book": "jeremiah                                ",
    "chapter": "50",
    "verse": "15",
    "text": "Hãy reo hò và thét lên từ mọi phía."
  },
  {
    "id": 11568,
    "book": "jeremiah                                ",
    "chapter": "50",
    "verse": "16",
    "text": "Hãy lấy khỏi Ba-by-lôn tất cả ai gieo giống;"
  },
  {
    "id": 11569,
    "book": "jeremiah                                ",
    "chapter": "50",
    "verse": "17",
    "text": "“Ít-ra-ên như đàn chiên"
  },
  {
    "id": 11570,
    "book": "jeremiah                                ",
    "chapter": "50",
    "verse": "18",
    "text": "Vì thế, đây là điều Chúa Hằng Hữu Vạn Quân,"
  },
  {
    "id": 11571,
    "book": "jeremiah                                ",
    "chapter": "50",
    "verse": "19",
    "text": "Ta sẽ đem Ít-ra-ên trở về quê hương,"
  },
  {
    "id": 11572,
    "book": "jeremiah                                ",
    "chapter": "50",
    "verse": "20",
    "text": "Chúa Hằng Hữu phán: “Trong thời kỳ đó,"
  },
  {
    "id": 11573,
    "book": "jeremiah                                ",
    "chapter": "50",
    "verse": "21",
    "text": "“Hỡi các chiến sĩ, hãy tấn công Mê-ra-tha-im50:21 Phía nam Ba-by-lôn"
  },
  {
    "id": 11574,
    "book": "jeremiah                                ",
    "chapter": "50",
    "verse": "22",
    "text": "“Có tiếng reo hò xung phong"
  },
  {
    "id": 11575,
    "book": "jeremiah                                ",
    "chapter": "50",
    "verse": "23",
    "text": "Ba-by-lôn, cây búa đáng sợ nhất thế giới,"
  },
  {
    "id": 11576,
    "book": "jeremiah                                ",
    "chapter": "50",
    "verse": "24",
    "text": "Hỡi Ba-by-lôn, Ta đã xếp đặt cho ngươi bị sập bẫy."
  },
  {
    "id": 11577,
    "book": "jeremiah                                ",
    "chapter": "50",
    "verse": "25",
    "text": "Chúa đã mở kho và phân phát khí giới"
  },
  {
    "id": 11578,
    "book": "jeremiah                                ",
    "chapter": "50",
    "verse": "26",
    "text": "Phải, từ các xứ xa xôi, hãy kéo đến tấn công nó."
  },
  {
    "id": 11579,
    "book": "jeremiah                                ",
    "chapter": "50",
    "verse": "27",
    "text": "Hãy tiêu diệt cả bầy nghé nó—"
  },
  {
    "id": 11580,
    "book": "jeremiah                                ",
    "chapter": "50",
    "verse": "28",
    "text": "Hãy nghe những người trốn thoát từ Ba-by-lôn,"
  },
  {
    "id": 11581,
    "book": "jeremiah                                ",
    "chapter": "50",
    "verse": "29",
    "text": "Hãy tập họp các xạ thủ đến Ba-by-lôn."
  },
  {
    "id": 11582,
    "book": "jeremiah                                ",
    "chapter": "50",
    "verse": "30",
    "text": "Các trai tráng của nó sẽ ngã chết trong các đường phố."
  },
  {
    "id": 11583,
    "book": "jeremiah                                ",
    "chapter": "50",
    "verse": "31",
    "text": "“Này, Ta chống lại ngươi, hỡi dân tộc kiêu căng,”"
  },
  {
    "id": 11584,
    "book": "jeremiah                                ",
    "chapter": "50",
    "verse": "32",
    "text": "Hỡi xứ kiêu ngạo, ngươi sẽ vấp té và ngã quỵ,"
  },
  {
    "id": 11585,
    "book": "jeremiah                                ",
    "chapter": "50",
    "verse": "33",
    "text": "Đây là điều Chúa Hằng Hữu Vạn Quân phán:"
  },
  {
    "id": 11586,
    "book": "jeremiah                                ",
    "chapter": "50",
    "verse": "34",
    "text": "Nhưng Đấng Cứu Chuộc chúng thật là mạnh mẽ."
  },
  {
    "id": 11587,
    "book": "jeremiah                                ",
    "chapter": "50",
    "verse": "35",
    "text": "Lưỡi kiếm hủy diệt sẽ đâm chém người Ba-by-lôn,”"
  },
  {
    "id": 11588,
    "book": "jeremiah                                ",
    "chapter": "50",
    "verse": "36",
    "text": "Gươm sẽ diệt người mưu trí của nó"
  },
  {
    "id": 11589,
    "book": "jeremiah                                ",
    "chapter": "50",
    "verse": "37",
    "text": "Gươm sẽ đánh tan các đoàn kỵ mã, chiến xa,"
  },
  {
    "id": 11590,
    "book": "jeremiah                                ",
    "chapter": "50",
    "verse": "38",
    "text": "Gươm cũng sẽ diệt nguồn nước uống của nó,"
  },
  {
    "id": 11591,
    "book": "jeremiah                                ",
    "chapter": "50",
    "verse": "39",
    "text": "Vì thế, Ba-by-lôn sẽ sớm biến thành chỗ ở cho thú hoang và linh cẩu."
  },
  {
    "id": 11592,
    "book": "jeremiah                                ",
    "chapter": "50",
    "verse": "40",
    "text": "Ta sẽ tiêu diệt Ba-by-lôn như Sô-đôm, Gô-mô-rơ,"
  },
  {
    "id": 11593,
    "book": "jeremiah                                ",
    "chapter": "50",
    "verse": "41",
    "text": "Kìa! Quân đông đảo từ phương bắc kéo xuống."
  },
  {
    "id": 11594,
    "book": "jeremiah                                ",
    "chapter": "50",
    "verse": "42",
    "text": "Tất cả đều trang bị đầy đủ cung và giáo."
  },
  {
    "id": 11595,
    "book": "jeremiah                                ",
    "chapter": "50",
    "verse": "43",
    "text": "Nghe tin báo về quân thù,"
  },
  {
    "id": 11596,
    "book": "jeremiah                                ",
    "chapter": "50",
    "verse": "44",
    "text": "Ta sẽ đến như sư tử trong rừng rậm Giô-đan,"
  },
  {
    "id": 11597,
    "book": "jeremiah                                ",
    "chapter": "50",
    "verse": "45",
    "text": "Hãy nghe kế hoạch Chúa ấn định để tiêu diệt Ba-by-lôn"
  },
  {
    "id": 11598,
    "book": "jeremiah                                ",
    "chapter": "50",
    "verse": "46",
    "text": "Cả mặt đất sẽ rúng động kêu là: “Ba-by-lôn sụp đổ!”"
  }
]