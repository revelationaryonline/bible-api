[
  {
    "id": 10445,
    "book": "jeremiah                                ",
    "chapter": "5",
    "verse": "1",
    "text": "Chúa Hằng Hữu phán: “Hãy lùng khắp các đường phố Giê-ru-sa-lem,"
  },
  {
    "id": 10446,
    "book": "jeremiah                                ",
    "chapter": "5",
    "verse": "2",
    "text": "Nhưng dù chúng thề:"
  },
  {
    "id": 10447,
    "book": "jeremiah                                ",
    "chapter": "5",
    "verse": "3",
    "text": "Lạy Chúa Hằng Hữu, mắt Chúa lưu ý đến người chân thật."
  },
  {
    "id": 10448,
    "book": "jeremiah                                ",
    "chapter": "5",
    "verse": "4",
    "text": "Rồi tôi nói: “Chúng ta có thể trông mong gì từ người nghèo?"
  },
  {
    "id": 10449,
    "book": "jeremiah                                ",
    "chapter": "5",
    "verse": "5",
    "text": "Vậy tôi sẽ đến và nói với các lãnh đạo của họ."
  },
  {
    "id": 10450,
    "book": "jeremiah                                ",
    "chapter": "5",
    "verse": "6",
    "text": "Vậy bây giờ, sư tử sẽ ra khỏi rừng để tấn công họ;"
  },
  {
    "id": 10451,
    "book": "jeremiah                                ",
    "chapter": "5",
    "verse": "7",
    "text": "“Làm sao Ta có thể ân xá cho ngươi?"
  },
  {
    "id": 10452,
    "book": "jeremiah                                ",
    "chapter": "5",
    "verse": "8",
    "text": "Chúng chạy lung như ngựa béo động tình buổi sáng,"
  },
  {
    "id": 10453,
    "book": "jeremiah                                ",
    "chapter": "5",
    "verse": "9",
    "text": "Chúa Hằng Hữu hỏi: “Liệu Ta không đoán phạt tội ác đó sao?"
  },
  {
    "id": 10454,
    "book": "jeremiah                                ",
    "chapter": "5",
    "verse": "10",
    "text": "Hãy xuống từng luống nho và chặt phá,"
  },
  {
    "id": 10455,
    "book": "jeremiah                                ",
    "chapter": "5",
    "verse": "11",
    "text": "Vì nhà Ít-ra-ên và nhà Giu-đa"
  },
  {
    "id": 10456,
    "book": "jeremiah                                ",
    "chapter": "5",
    "verse": "12",
    "text": "Chúng đã dối gạt Chúa Hằng Hữu"
  },
  {
    "id": 10457,
    "book": "jeremiah                                ",
    "chapter": "5",
    "verse": "13",
    "text": "Các tiên tri của Đức Chúa Trời chỉ biết bịa chuyện"
  },
  {
    "id": 10458,
    "book": "jeremiah                                ",
    "chapter": "5",
    "verse": "14",
    "text": "Vì thế, Chúa Hằng Hữu, Đức Chúa Trời Vạn Quân phán:"
  },
  {
    "id": 10459,
    "book": "jeremiah                                ",
    "chapter": "5",
    "verse": "15",
    "text": "Ôi Ít-ra-ên, Ta sẽ đem một đất nước từ xa đến xâm lăng ngươi,”"
  },
  {
    "id": 10460,
    "book": "jeremiah                                ",
    "chapter": "5",
    "verse": "16",
    "text": "Khí giới của chúng giết hại thật nhiều;"
  },
  {
    "id": 10461,
    "book": "jeremiah                                ",
    "chapter": "5",
    "verse": "17",
    "text": "Chúng sẽ ăn hết mùa màng của ngươi;"
  },
  {
    "id": 10462,
    "book": "jeremiah                                ",
    "chapter": "5",
    "verse": "18",
    "text": "Chúa Hằng Hữu phán: “Dù sao, trong ngày đoán phạt, Ta sẽ không tuyệt diệt các ngươi."
  },
  {
    "id": 10463,
    "book": "jeremiah                                ",
    "chapter": "5",
    "verse": "19",
    "text": "Một khi dân chúng thắc mắc: ‘Tại sao Chúa Hằng Hữu, Đức Chúa Trời chúng ta, phạt chúng ta quá nặng thế này?’ Con hãy đáp: ‘Các người đã từ khước Chúa và thờ lạy các thần tượng nước ngoài trên quê hương mình. Giờ đây, các người sẽ phải phục dịch các dân tộc nước ngoài trên đất không phải của các người.’”"
  },
  {
    "id": 10464,
    "book": "jeremiah                                ",
    "chapter": "5",
    "verse": "20",
    "text": "“Hãy tuyên cáo cho nhà Gia-cốp,"
  },
  {
    "id": 10465,
    "book": "jeremiah                                ",
    "chapter": "5",
    "verse": "21",
    "text": "Này, dân tộc ngu dại u mê,"
  },
  {
    "id": 10466,
    "book": "jeremiah                                ",
    "chapter": "5",
    "verse": "22",
    "text": "Ngươi không kính sợ Ta sao?"
  },
  {
    "id": 10467,
    "book": "jeremiah                                ",
    "chapter": "5",
    "verse": "23",
    "text": "Nhưng dân Ta có lòng ương ngạnh và phản loạn."
  },
  {
    "id": 10468,
    "book": "jeremiah                                ",
    "chapter": "5",
    "verse": "24",
    "text": "Họ chẳng bao giờ tự bảo trong lòng:"
  },
  {
    "id": 10469,
    "book": "jeremiah                                ",
    "chapter": "5",
    "verse": "25",
    "text": "Gian ác ngươi đã tước đoạt phước hạnh tuyệt diệu của ngươi."
  },
  {
    "id": 10470,
    "book": "jeremiah                                ",
    "chapter": "5",
    "verse": "26",
    "text": "Giữa dân Ta có những kẻ ác,"
  },
  {
    "id": 10471,
    "book": "jeremiah                                ",
    "chapter": "5",
    "verse": "27",
    "text": "Nhà chúng đầy những âm mưu lừa bịp,"
  },
  {
    "id": 10472,
    "book": "jeremiah                                ",
    "chapter": "5",
    "verse": "28",
    "text": "Chúng mập mạp và đẫy đà,"
  },
  {
    "id": 10473,
    "book": "jeremiah                                ",
    "chapter": "5",
    "verse": "29",
    "text": "Chúa Hằng Hữu phán: “Lẽ nào Ta không báo ứng tội ác ấy?"
  },
  {
    "id": 10474,
    "book": "jeremiah                                ",
    "chapter": "5",
    "verse": "30",
    "text": "Một biến cố khủng khiếp"
  },
  {
    "id": 10475,
    "book": "jeremiah                                ",
    "chapter": "5",
    "verse": "31",
    "text": "Các tiên tri rao giảng những sứ điệp giả dối,"
  }
]