[
  {
    "id": 10476,
    "book": "jeremiah                                ",
    "chapter": "6",
    "verse": "1",
    "text": "“Hãy trốn chạy vì mạng sống, hỡi người Bên-gia-min!"
  },
  {
    "id": 10477,
    "book": "jeremiah                                ",
    "chapter": "6",
    "verse": "2",
    "text": "Ôi con gái Si-ôn, ngươi là con gái đẹp đẽ và yêu kiều của Ta—"
  },
  {
    "id": 10478,
    "book": "jeremiah                                ",
    "chapter": "6",
    "verse": "3",
    "text": "Quân thù sẽ đến chung quanh ngươi, như người chăn cắm trại chung quanh thành."
  },
  {
    "id": 10479,
    "book": "jeremiah                                ",
    "chapter": "6",
    "verse": "4",
    "text": "Chúng la to: ‘Hãy chuẩn bị chiến đấu!"
  },
  {
    "id": 10480,
    "book": "jeremiah                                ",
    "chapter": "6",
    "verse": "5",
    "text": "‘Hãy đứng lên, tấn công trong đêm tối,"
  },
  {
    "id": 10481,
    "book": "jeremiah                                ",
    "chapter": "6",
    "verse": "6",
    "text": "Đây là điều Chúa Hằng Hữu Vạn Quân phán:"
  },
  {
    "id": 10482,
    "book": "jeremiah                                ",
    "chapter": "6",
    "verse": "7",
    "text": "Các tội ác của nó như hồ chứa đầy tràn nước ra.6:7 Nt như hồ chứa nước giữ cho nước tươi mát thể nào, nó cũng giữ sự gian ác nó cho tươi mới thể ấy"
  },
  {
    "id": 10483,
    "book": "jeremiah                                ",
    "chapter": "6",
    "verse": "8",
    "text": "Hỡi Giê-ru-sa-lem! Hãy nghe lời khuyên dạy,"
  },
  {
    "id": 10484,
    "book": "jeremiah                                ",
    "chapter": "6",
    "verse": "9",
    "text": "Đây là điều Chúa Hằng Hữu Vạn Quân phán:"
  },
  {
    "id": 10485,
    "book": "jeremiah                                ",
    "chapter": "6",
    "verse": "10",
    "text": "Tôi sẽ cảnh cáo ai?"
  },
  {
    "id": 10486,
    "book": "jeremiah                                ",
    "chapter": "6",
    "verse": "11",
    "text": "Vậy bây giờ, lòng tôi đầy tràn cơn giận của Chúa Hằng Hữu."
  },
  {
    "id": 10487,
    "book": "jeremiah                                ",
    "chapter": "6",
    "verse": "12",
    "text": "Nhà cửa của họ sẽ giao cho quân thù,"
  },
  {
    "id": 10488,
    "book": "jeremiah                                ",
    "chapter": "6",
    "verse": "13",
    "text": "“Từ người hèn mọn đến người cao trọng,"
  },
  {
    "id": 10489,
    "book": "jeremiah                                ",
    "chapter": "6",
    "verse": "14",
    "text": "Chúng chữa trị cẩu thả"
  },
  {
    "id": 10490,
    "book": "jeremiah                                ",
    "chapter": "6",
    "verse": "15",
    "text": "Lẽ nào chúng không xấu hổ về những hành động ghê tởm của mình?"
  },
  {
    "id": 10491,
    "book": "jeremiah                                ",
    "chapter": "6",
    "verse": "16",
    "text": "Đây là điều Chúa Hằng Hữu phán:"
  },
  {
    "id": 10492,
    "book": "jeremiah                                ",
    "chapter": "6",
    "verse": "17",
    "text": "Ta cũng đặt người canh coi sóc các ngươi và dặn bảo:"
  },
  {
    "id": 10493,
    "book": "jeremiah                                ",
    "chapter": "6",
    "verse": "18",
    "text": "Vì thế, các dân tộc, hãy nghe."
  },
  {
    "id": 10494,
    "book": "jeremiah                                ",
    "chapter": "6",
    "verse": "19",
    "text": "Khắp đất, hãy nghe!"
  },
  {
    "id": 10495,
    "book": "jeremiah                                ",
    "chapter": "6",
    "verse": "20",
    "text": "Thật vô dụng khi các ngươi dâng lên Ta trầm hương từ Sê-ba."
  },
  {
    "id": 10496,
    "book": "jeremiah                                ",
    "chapter": "6",
    "verse": "21",
    "text": "Vậy Chúa Hằng Hữu phán:"
  },
  {
    "id": 10497,
    "book": "jeremiah                                ",
    "chapter": "6",
    "verse": "22",
    "text": "Đây là điều Chúa Hằng Hữu phán:"
  },
  {
    "id": 10498,
    "book": "jeremiah                                ",
    "chapter": "6",
    "verse": "23",
    "text": "Quân đội chúng được trang bị cung tên và gươm giáo."
  },
  {
    "id": 10499,
    "book": "jeremiah                                ",
    "chapter": "6",
    "verse": "24",
    "text": "Vừa nghe tin báo về đội quân ấy,"
  },
  {
    "id": 10500,
    "book": "jeremiah                                ",
    "chapter": "6",
    "verse": "25",
    "text": "Đừng ra ngoài đồng ruộng!"
  },
  {
    "id": 10501,
    "book": "jeremiah                                ",
    "chapter": "6",
    "verse": "26",
    "text": "Dân tôi ơi, hãy mặc áo tang"
  },
  {
    "id": 10502,
    "book": "jeremiah                                ",
    "chapter": "6",
    "verse": "27",
    "text": "“Giê-rê-mi ơi, Ta đã đặt con lên làm người thử nghiệm"
  },
  {
    "id": 10503,
    "book": "jeremiah                                ",
    "chapter": "6",
    "verse": "28",
    "text": "Chúng đều phản loạn với Ta,"
  },
  {
    "id": 10504,
    "book": "jeremiah                                ",
    "chapter": "6",
    "verse": "29",
    "text": "Dưới ngọn lửa thổi phừng dữ dội"
  },
  {
    "id": 10505,
    "book": "jeremiah                                ",
    "chapter": "6",
    "verse": "30",
    "text": "Ta sẽ gọi dân này là ‘Bạc Phế Thải,’"
  }
]