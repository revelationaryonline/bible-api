[
  {
    "id": 10588,
    "book": "jeremiah                                ",
    "chapter": "10",
    "verse": "1",
    "text": "Hỡi nhà Ít-ra-ên! Hãy nghe lời Chúa Hằng Hữu phán dạy."
  },
  {
    "id": 10589,
    "book": "jeremiah                                ",
    "chapter": "10",
    "verse": "2",
    "text": "Đây là điều Chúa Hằng Hữu phán:"
  },
  {
    "id": 10590,
    "book": "jeremiah                                ",
    "chapter": "10",
    "verse": "3",
    "text": "Vì thói tục của chúng là hư không và dại dột."
  },
  {
    "id": 10591,
    "book": "jeremiah                                ",
    "chapter": "10",
    "verse": "4",
    "text": "Chúng giát tượng bằng vàng và bạc"
  },
  {
    "id": 10592,
    "book": "jeremiah                                ",
    "chapter": "10",
    "verse": "5",
    "text": "Thần của chúng như"
  },
  {
    "id": 10593,
    "book": "jeremiah                                ",
    "chapter": "10",
    "verse": "6",
    "text": "Lạy Chúa Hằng Hữu, chẳng có thần nào giống như Chúa!"
  },
  {
    "id": 10594,
    "book": "jeremiah                                ",
    "chapter": "10",
    "verse": "7",
    "text": "Chúa là Vua của các nước, ai mà không sợ Ngài?"
  },
  {
    "id": 10595,
    "book": "jeremiah                                ",
    "chapter": "10",
    "verse": "8",
    "text": "Người thờ thần tượng là u mê và khờ dại."
  },
  {
    "id": 10596,
    "book": "jeremiah                                ",
    "chapter": "10",
    "verse": "9",
    "text": "Chúng mang bạc lát mỏng mua từ Ta-rê-si"
  },
  {
    "id": 10597,
    "book": "jeremiah                                ",
    "chapter": "10",
    "verse": "10",
    "text": "Nhưng Chúa Hằng Hữu là Đức Chúa Trời chân thật."
  },
  {
    "id": 10598,
    "book": "jeremiah                                ",
    "chapter": "10",
    "verse": "11",
    "text": "Hãy nói với những người thờ thần tượng rằng: “Các thần tượng không làm nên trời, cũng không làm nên đất đều sẽ bị diệt vong, không còn trên mặt đất và dưới bầu trời.”"
  },
  {
    "id": 10599,
    "book": "jeremiah                                ",
    "chapter": "10",
    "verse": "12",
    "text": "Nhưng Đức Chúa Trời sáng tạo địa cầu bởi quyền năng"
  },
  {
    "id": 10600,
    "book": "jeremiah                                ",
    "chapter": "10",
    "verse": "13",
    "text": "Khi Chúa phán liền có tiếng sấm vang,"
  },
  {
    "id": 10601,
    "book": "jeremiah                                ",
    "chapter": "10",
    "verse": "14",
    "text": "Mọi người đều vô tri, vô giác, không một chút khôn ngoan!"
  },
  {
    "id": 10602,
    "book": "jeremiah                                ",
    "chapter": "10",
    "verse": "15",
    "text": "Tượng không có giá trị; là vật bị chế giễu!"
  },
  {
    "id": 10603,
    "book": "jeremiah                                ",
    "chapter": "10",
    "verse": "16",
    "text": "Nhưng Đức Chúa Trời của Gia-cốp không phải là tượng!"
  },
  {
    "id": 10604,
    "book": "jeremiah                                ",
    "chapter": "10",
    "verse": "17",
    "text": "Hãy thu thập của cải và rời khỏi nơi này;"
  },
  {
    "id": 10605,
    "book": "jeremiah                                ",
    "chapter": "10",
    "verse": "18",
    "text": "Vì đây là điều Chúa Hằng Hữu phán:"
  },
  {
    "id": 10606,
    "book": "jeremiah                                ",
    "chapter": "10",
    "verse": "19",
    "text": "Vết thương của tôi trầm trọng"
  },
  {
    "id": 10607,
    "book": "jeremiah                                ",
    "chapter": "10",
    "verse": "20",
    "text": "Trại tôi bị tàn phá,"
  },
  {
    "id": 10608,
    "book": "jeremiah                                ",
    "chapter": "10",
    "verse": "21",
    "text": "Những người chăn dân tôi đã đánh mất tri giác."
  },
  {
    "id": 10609,
    "book": "jeremiah                                ",
    "chapter": "10",
    "verse": "22",
    "text": "Này! Có tiếng ầm ầm dữ dội của đội quân hùng mạnh"
  },
  {
    "id": 10610,
    "book": "jeremiah                                ",
    "chapter": "10",
    "verse": "23",
    "text": "Con biết, lạy Chúa Hằng Hữu, đời sống chúng con không là của chúng con."
  },
  {
    "id": 10611,
    "book": "jeremiah                                ",
    "chapter": "10",
    "verse": "24",
    "text": "Lạy Chúa Hằng Hữu, xin sửa dạy con; nhưng xin Chúa nhẹ tay."
  },
  {
    "id": 10612,
    "book": "jeremiah                                ",
    "chapter": "10",
    "verse": "25",
    "text": "Xin đổ cơn đoán phạt trên các dân tộc khước từ Chúa—"
  }
]