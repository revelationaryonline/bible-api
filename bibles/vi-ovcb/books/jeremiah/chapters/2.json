[
  {
    "id": 10352,
    "book": "jeremiah                                ",
    "chapter": "2",
    "verse": "1",
    "text": "Chúa Hằng Hữu ban cho tôi một sứ điệp khác. Ngài phán:"
  },
  {
    "id": 10353,
    "book": "jeremiah                                ",
    "chapter": "2",
    "verse": "2",
    "text": "“Hãy đi và nói lớn sứ điệp này cho Giê-ru-sa-lem. Đây là điều Chúa Hằng Hữu phán:"
  },
  {
    "id": 10354,
    "book": "jeremiah                                ",
    "chapter": "2",
    "verse": "3",
    "text": "Trong những ngày đó, Ít-ra-ên là dân thánh của Chúa Hằng Hữu,"
  },
  {
    "id": 10355,
    "book": "jeremiah                                ",
    "chapter": "2",
    "verse": "4",
    "text": "Hãy lắng nghe lời của Chúa Hằng Hữu, hỡi dòng họ Gia-cốp—tất cả đại tộc của Ít-ra-ên!"
  },
  {
    "id": 10356,
    "book": "jeremiah                                ",
    "chapter": "2",
    "verse": "5",
    "text": "Đây là lời của Chúa Hằng Hữu phán:"
  },
  {
    "id": 10357,
    "book": "jeremiah                                ",
    "chapter": "2",
    "verse": "6",
    "text": "Chúng không hỏi: ‘Chúa Hằng Hữu ở đâu,"
  },
  {
    "id": 10358,
    "book": "jeremiah                                ",
    "chapter": "2",
    "verse": "7",
    "text": "Khi Ta đưa các ngươi vào vùng đất phì nhiêu đầy hoa quả,"
  },
  {
    "id": 10359,
    "book": "jeremiah                                ",
    "chapter": "2",
    "verse": "8",
    "text": "Các thầy tế lễ không còn hỏi:"
  },
  {
    "id": 10360,
    "book": "jeremiah                                ",
    "chapter": "2",
    "verse": "9",
    "text": "Vì thế, Ta sẽ tiếp tục buộc tội các ngươi,”"
  },
  {
    "id": 10361,
    "book": "jeremiah                                ",
    "chapter": "2",
    "verse": "10",
    "text": "Hãy đi hướng tây và nhìn đất Kít-tim;"
  },
  {
    "id": 10362,
    "book": "jeremiah                                ",
    "chapter": "2",
    "verse": "11",
    "text": "Có dân tộc nào thay đổi thần dễ dàng như các ngươi"
  },
  {
    "id": 10363,
    "book": "jeremiah                                ",
    "chapter": "2",
    "verse": "12",
    "text": "Các tầng trời đã sửng sốt về một việc như thế"
  },
  {
    "id": 10364,
    "book": "jeremiah                                ",
    "chapter": "2",
    "verse": "13",
    "text": "“Vì dân Ta đã phạm hai tội nặng:"
  },
  {
    "id": 10365,
    "book": "jeremiah                                ",
    "chapter": "2",
    "verse": "14",
    "text": "“Tại sao Ít-ra-ên trở thành nô lệ?"
  },
  {
    "id": 10366,
    "book": "jeremiah                                ",
    "chapter": "2",
    "verse": "15",
    "text": "Sư tử gầm rống vang dậy chống lại nó,"
  },
  {
    "id": 10367,
    "book": "jeremiah                                ",
    "chapter": "2",
    "verse": "16",
    "text": "Người Ai Cập, diễu hành từ thành Nốp và Tác-pha-nết,"
  },
  {
    "id": 10368,
    "book": "jeremiah                                ",
    "chapter": "2",
    "verse": "17",
    "text": "Ngươi đã rước lấy tai họa đó"
  },
  {
    "id": 10369,
    "book": "jeremiah                                ",
    "chapter": "2",
    "verse": "18",
    "text": "Các ngươi được lợi gì khi liên minh với Ai Cập"
  },
  {
    "id": 10370,
    "book": "jeremiah                                ",
    "chapter": "2",
    "verse": "19",
    "text": "Sự gian ác ngươi sẽ trừng phạt ngươi."
  },
  {
    "id": 10371,
    "book": "jeremiah                                ",
    "chapter": "2",
    "verse": "20",
    "text": "Từ lâu, ngươi đã tự bẻ ách áp bức ngươi"
  },
  {
    "id": 10372,
    "book": "jeremiah                                ",
    "chapter": "2",
    "verse": "21",
    "text": "Nhưng Ta là Đấng đã trồng ngươi,"
  },
  {
    "id": 10373,
    "book": "jeremiah                                ",
    "chapter": "2",
    "verse": "22",
    "text": "Không có xà phòng hay thuốc tẩy nào có thể làm ngươi sạch."
  },
  {
    "id": 10374,
    "book": "jeremiah                                ",
    "chapter": "2",
    "verse": "23",
    "text": "“Ngươi dám nói: ‘Tôi đâu bị ô uế!"
  },
  {
    "id": 10375,
    "book": "jeremiah                                ",
    "chapter": "2",
    "verse": "24",
    "text": "Ngươi như lừa rừng quen sống giữa đồng hoang,"
  },
  {
    "id": 10376,
    "book": "jeremiah                                ",
    "chapter": "2",
    "verse": "25",
    "text": "Khi nào ngươi sẽ ngừng chạy?"
  },
  {
    "id": 10377,
    "book": "jeremiah                                ",
    "chapter": "2",
    "verse": "26",
    "text": "Ít-ra-ên như kẻ trộm"
  },
  {
    "id": 10378,
    "book": "jeremiah                                ",
    "chapter": "2",
    "verse": "27",
    "text": "Chúng thưa với các tượng chạm bằng gỗ rằng:"
  },
  {
    "id": 10379,
    "book": "jeremiah                                ",
    "chapter": "2",
    "verse": "28",
    "text": "Sao không kêu cầu các thần mà các ngươi đã tạo ra?"
  },
  {
    "id": 10380,
    "book": "jeremiah                                ",
    "chapter": "2",
    "verse": "29",
    "text": "Ngươi còn khiếu nại gì nữa?"
  },
  {
    "id": 10381,
    "book": "jeremiah                                ",
    "chapter": "2",
    "verse": "30",
    "text": "“Ta đã hình phạt con cháu ngươi,"
  },
  {
    "id": 10382,
    "book": "jeremiah                                ",
    "chapter": "2",
    "verse": "31",
    "text": "Ôi dân Ta, hãy lắng nghe lời Chúa Hằng Hữu phán dạy!"
  },
  {
    "id": 10383,
    "book": "jeremiah                                ",
    "chapter": "2",
    "verse": "32",
    "text": "Có thiếu nữ nào quên đồ trang sức của mình không?"
  },
  {
    "id": 10384,
    "book": "jeremiah                                ",
    "chapter": "2",
    "verse": "33",
    "text": "“Ngươi đã quá khéo léo trong việc tìm kiếm yêu đương,"
  },
  {
    "id": 10385,
    "book": "jeremiah                                ",
    "chapter": "2",
    "verse": "34",
    "text": "Nơi vạt áo ngươi cũng đã vấy máu của người vô tội và người nghèo,"
  },
  {
    "id": 10386,
    "book": "jeremiah                                ",
    "chapter": "2",
    "verse": "35",
    "text": "Tuy thế, ngươi vẫn nói:"
  },
  {
    "id": 10387,
    "book": "jeremiah                                ",
    "chapter": "2",
    "verse": "36",
    "text": "Đầu tiên chỗ này, rồi đến chỗ kia—"
  },
  {
    "id": 10388,
    "book": "jeremiah                                ",
    "chapter": "2",
    "verse": "37",
    "text": "Trong nỗi tuyệt vọng, ngươi sẽ bị dẫn đi đày"
  }
]