[
  {
    "id": 10702,
    "book": "jeremiah                                ",
    "chapter": "15",
    "verse": "1",
    "text": "Chúa Hằng Hữu phán bảo tôi: “Dù Môi-se và Sa-mu-ên đứng trước mặt Ta nài xin cho dân này, Ta cũng không hướng về dân này nữa. Hãy đuổi chúng đi khuất mắt Ta!"
  },
  {
    "id": 10703,
    "book": "jeremiah                                ",
    "chapter": "15",
    "verse": "2",
    "text": "Nếu chúng hỏi con: ‘Chúng tôi phải đi đâu?’ Hãy nói với chúng rằng: ‘Đây là điều Chúa Hằng Hữu phán:"
  },
  {
    "id": 10704,
    "book": "jeremiah                                ",
    "chapter": "15",
    "verse": "3",
    "text": "Chúa Hằng Hữu phán: “Ta sẽ giáng trên chúng bốn tai họa: Gươm sát hại, chó xé xác,15:3 Nt kéo đi chim trời rỉa thịt, và thú rừng cắn nuốt những gì còn lại."
  },
  {
    "id": 10705,
    "book": "jeremiah                                ",
    "chapter": "15",
    "verse": "4",
    "text": "Vì việc làm gian ác của Ma-na-se, con Ê-xê-chia, vua Giu-đa, đã phạm tại Giê-ru-sa-lem, nên Ta sẽ làm cho chúng trở thành ghê tởm đối với các vương quốc trên đất."
  },
  {
    "id": 10706,
    "book": "jeremiah                                ",
    "chapter": "15",
    "verse": "5",
    "text": "Giê-ru-sa-lem, ai sẽ thương xót ngươi?"
  },
  {
    "id": 10707,
    "book": "jeremiah                                ",
    "chapter": "15",
    "verse": "6",
    "text": "Ngươi đã khước từ Ta"
  },
  {
    "id": 10708,
    "book": "jeremiah                                ",
    "chapter": "15",
    "verse": "7",
    "text": "Ta sẽ quạt chúng nó như quạt lúa tại các cổng thành"
  },
  {
    "id": 10709,
    "book": "jeremiah                                ",
    "chapter": "15",
    "verse": "8",
    "text": "Khi đó, sẽ có nhiều góa phụ,"
  },
  {
    "id": 10710,
    "book": "jeremiah                                ",
    "chapter": "15",
    "verse": "9",
    "text": "Người mẹ có bảy đứa con kiệt sức như gần trút hơi;"
  },
  {
    "id": 10711,
    "book": "jeremiah                                ",
    "chapter": "15",
    "verse": "10",
    "text": "Rồi tôi nói:"
