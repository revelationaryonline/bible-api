[
  {
    "id": 11054,
    "book": "jeremiah                                ",
    "chapter": "30",
    "verse": "1",
    "text": "Chúa Hằng Hữu ban một sứ điệp khác cho Giê-rê-mi. Chúa phán:"
  },
  {
    "id": 11055,
    "book": "jeremiah                                ",
    "chapter": "30",
    "verse": "2",
    "text": "“Đây là điều Chúa Hằng Hữu, Đức Chúa Trời của Ít-ra-ên, phán: Hãy ghi chép để lưu giữ mọi lời Ta đã phán dạy con, Giê-rê-mi."
  },
  {
    "id": 11056,
    "book": "jeremiah                                ",
    "chapter": "30",
    "verse": "3",
    "text": "Vì kỳ hạn đang đến, khi ấy Ta sẽ phục hưng dân Ta, cả Ít-ra-ên và Giu-đa. Ta sẽ cho họ hồi hương, cho họ lấy lại quyền sở hữu đất mà Ta đã ban cho tổ phụ họ, và họ sẽ an cư lạc nghiệp trên đất nước này. Ta, Chúa Hằng Hữu, đã phán vậy!”"
  },
  {
    "id": 11057,
    "book": "jeremiah                                ",
    "chapter": "30",
    "verse": "4",
    "text": "Đây là sứ điệp Chúa Hằng Hữu ban, liên quan đến Ít-ra-ên và Giu-đa."
  },
  {
    "id": 11058,
    "book": "jeremiah                                ",
    "chapter": "30",
    "verse": "5",
    "text": "Đây là điều Chúa Hằng Hữu phán:"
  },
  {
    "id": 11059,
    "book": "jeremiah                                ",
    "chapter": "30",
    "verse": "6",
    "text": "Để Ta đặt câu hỏi này:"
  },
  {
    "id": 11060,
    "book": "jeremiah                                ",
    "chapter": "30",
    "verse": "7",
    "text": "Không có ngày nào khủng khiếp như vậy."
  },
  {
    "id": 11061,
    "book": "jeremiah                                ",
    "chapter": "30",
    "verse": "8",
    "text": "Chúa Hằng Hữu Vạn Quân phán:"
  },
  {
    "id": 11062,
    "book": "jeremiah                                ",
    "chapter": "30",
    "verse": "9",
    "text": "Vì dân Ta sẽ phục vụ Chúa Hằng Hữu, Đức Chúa Trời của họ"
  },
  {
    "id": 11063,
    "book": "jeremiah                                ",
    "chapter": "30",
    "verse": "10",
    "text": "Vậy nên đừng sợ hãi, hỡi Gia-cốp, đầy tớ Ta;"
  },
  {
    "id": 11064,
    "book": "jeremiah                                ",
    "chapter": "30",
    "verse": "11",
    "text": "Vì Ta ở với các con luôn và sẽ cứu các con,”"
  },
  {
    "id": 11065,
    "book": "jeremiah                                ",
    "chapter": "30",
    "verse": "12",
    "text": "Đây là điều Chúa Hằng Hữu phán:"
  },
  {
    "id": 11066,
    "book": "jeremiah                                ",
    "chapter": "30",
    "verse": "13",
    "text": "Không ai cứu giúp các con"
  },
  {
    "id": 11067,
    "book": "jeremiah                                ",
    "chapter": "30",
    "verse": "14",
    "text": "Tất cả người yêu—đồng minh của các con—đều bỏ các con"
  },
  {
    "id": 11068,
    "book": "jeremiah                                ",
    "chapter": "30",
    "verse": "15",
    "text": "Tại sao các con kêu la vì hình phạt mình—"
  },
  {
    "id": 11069,
    "book": "jeremiah                                ",
    "chapter": "30",
    "verse": "16",
    "text": "Nhưng tất cả những ai ăn nuốt các con thì chính họ sẽ bị ăn nuốt,"
  },
  {
    "id": 11070,
    "book": "jeremiah                                ",
    "chapter": "30",
    "verse": "17",
    "text": "Ta sẽ phục hồi sức khỏe các con"
  },
  {
    "id": 11071,
    "book": "jeremiah                                ",
    "chapter": "30",
    "verse": "18",
    "text": "Đây là điều Chúa Hằng Hữu phán:"
  },
  {
    "id": 11072,
    "book": "jeremiah                                ",
    "chapter": "30",
    "verse": "19",
    "text": "Nơi đó, sẽ vang lên lời vui mừng và bài ca cảm tạ,"
  },
  {
    "id": 11073,
    "book": "jeremiah                                ",
    "chapter": "30",
    "verse": "20",
    "text": "Dòng dõi họ sẽ cường thịnh như thuở xưa."
  },
  {
    "id": 11074,
    "book": "jeremiah                                ",
    "chapter": "30",
    "verse": "21",
    "text": "Họ sẽ có người cai trị của riêng họ một lần nữa,"
  },
  {
    "id": 11075,
    "book": "jeremiah                                ",
    "chapter": "30",
    "verse": "22",
    "text": "Các con sẽ làm dân Ta,"
  },
  {
    "id": 11076,
    "book": "jeremiah                                ",
    "chapter": "30",
    "verse": "23",
    "text": "Kìa! Cơn giận của Chúa Hằng Hữu phừng lên như bão tố,"
  },
  {
    "id": 11077,
    "book": "jeremiah                                ",
    "chapter": "30",
    "verse": "24",
    "text": "Cơn thịnh nộ của Chúa Hằng Hữu sẽ không nguôi"
  }
]