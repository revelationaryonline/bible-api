[
  {
    "id": 11514,
    "book": "jeremiah                                ",
    "chapter": "49",
    "verse": "1",
    "text": "Sứ điệp tiên tri về người Am-môn. Đây là điều Chúa Hằng Hữu phán:"
  },
  {
    "id": 11515,
    "book": "jeremiah                                ",
    "chapter": "49",
    "verse": "2",
    "text": "Chúa Hằng Hữu phán: “Vì thế, sẽ có ngày,"
  },
  {
    "id": 11516,
    "book": "jeremiah                                ",
    "chapter": "49",
    "verse": "3",
    "text": "“Hãy khóc than, hỡi Hết-bôn,"
  },
  {
    "id": 11517,
    "book": "jeremiah                                ",
    "chapter": "49",
    "verse": "4",
    "text": "Ngươi tự hào về các thung lũng màu mỡ,"
  },
  {
    "id": 11518,
    "book": "jeremiah                                ",
    "chapter": "49",
    "verse": "5",
    "text": "Nhưng này! Ta sẽ đổ sự kinh hoàng trên ngươi,”"
  },
  {
    "id": 11519,
    "book": "jeremiah                                ",
    "chapter": "49",
    "verse": "6",
    "text": "Nhưng Ta sẽ phục hồi sự thịnh vượng cho Am-môn"
  },
  {
    "id": 11520,
    "book": "jeremiah                                ",
    "chapter": "49",
    "verse": "7",
    "text": "Sứ điệp này tiên tri về Ê-đôm. Đây là điều Chúa Hằng Hữu Vạn Quân phán:"
  },
  {
    "id": 11521,
    "book": "jeremiah                                ",
    "chapter": "49",
    "verse": "8",
    "text": "Hãy quay lưng và trốn chạy!"
  },
  {
    "id": 11522,
    "book": "jeremiah                                ",
    "chapter": "49",
    "verse": "9",
    "text": "Những người hái nho"
  },
  {
    "id": 11523,
    "book": "jeremiah                                ",
    "chapter": "49",
    "verse": "10",
    "text": "Nhưng Ta sẽ lột trần xứ Ê-đôm,"
  },
  {
    "id": 11524,
    "book": "jeremiah                                ",
    "chapter": "49",
    "verse": "11",
    "text": "Nhưng Ta sẽ bảo vệ các cô nhi còn lại trong vòng các ngươi."
  },
  {
    "id": 11525,
    "book": "jeremiah                                ",
    "chapter": "49",
    "verse": "12",
    "text": "Đây là điều Chúa Hằng Hữu phán: “Nếu những người vô tội đã phải chịu đau khổ, thì các ngươi phải chịu bao nhiêu! Các ngươi sẽ thoát khỏi hình phạt chăng! Các ngươi buộc phải uống chén đoán phạt này!”"
  },
  {
    "id": 11526,
    "book": "jeremiah                                ",
    "chapter": "49",
    "verse": "13",
    "text": "Chúa Hằng Hữu phán: “Vì Ta đã nhân danh Ta thề rằng Bốt-ra sẽ trở thành nơi ghê tởm và gò đống đổ nát; nó sẽ bị chế giễu và nguyền rủa. Các thành và làng mạc của nó sẽ điêu tàn vĩnh viễn.”"
  },
  {
    "id": 11527,
    "book": "jeremiah                                ",
    "chapter": "49",
    "verse": "14",
    "text": "Tôi nghe sứ điệp này từ Chúa Hằng Hữu"
  },
  {
    "id": 11528,
    "book": "jeremiah                                ",
    "chapter": "49",
    "verse": "15",
    "text": "Chúa Hằng Hữu phán với Ê-đôm:"
  },
  {
    "id": 11529,
    "book": "jeremiah                                ",
    "chapter": "49",
    "verse": "16",
    "text": "Các ngươi đã tự lừa dối"
  },
  {
    "id": 11530,
    "book": "jeremiah                                ",
    "chapter": "49",
    "verse": "17",
    "text": "“Ê-đôm sẽ trở nên vật ghê tởm."
  },
  {
    "id": 11531,
    "book": "jeremiah                                ",
    "chapter": "49",
    "verse": "18",
    "text": "Các thành của các ngươi sẽ hoang vắng như Sô-đôm và Gô-mô-rơ,"
  },
  {
    "id": 11532,
    "book": "jeremiah                                ",
    "chapter": "49",
    "verse": "19",
    "text": "Ta sẽ đến như sư tử từ rừng rậm Giô-đan,"
  },
  {
    "id": 11533,
    "book": "jeremiah                                ",
    "chapter": "49",
    "verse": "20",
    "text": "Hãy nghe kế hoạch của Chúa Hằng Hữu chống lại Ê-đôm"
  },
  {
    "id": 11534,
    "book": "jeremiah                                ",
    "chapter": "49",
    "verse": "21",
    "text": "Mặt đất rúng động khi nghe Ê-đôm sụp đổ,"
  },
  {
    "id": 11535,
    "book": "jeremiah                                ",
    "chapter": "49",
    "verse": "22",
    "text": "Kìa! Kẻ thù sẽ đến nhanh như đại bàng,"
  },
  {
    "id": 11536,
    "book": "jeremiah                                ",
    "chapter": "49",
    "verse": "23",
    "text": "Sứ điệp này tiên tri về Đa-mách. Đây là điều Chúa Hằng Hữu phán:"
  },
  {
    "id": 11537,
    "book": "jeremiah                                ",
    "chapter": "49",
    "verse": "24",
    "text": "Đa-mách trở nên yếu ớt,"
  },
  {
    "id": 11538,
    "book": "jeremiah                                ",
    "chapter": "49",
    "verse": "25",
    "text": "Thành danh tiếng đó, thành vui mừng đó,"
  },
  {
    "id": 11539,
    "book": "jeremiah                                ",
    "chapter": "49",
    "verse": "26",
    "text": "Các thanh niên ngươi ngã chết đầy đường phố."
  },
  {
    "id": 11540,
    "book": "jeremiah                                ",
    "chapter": "49",
    "verse": "27",
    "text": "“Ta sẽ nhóm một ngọn lửa trong tường lũy Đa-mách"
  },
  {
    "id": 11541,
    "book": "jeremiah                                ",
    "chapter": "49",
    "verse": "28",
    "text": "Đây là sứ điệp tiên tri về Kê-đa và vương quốc Hát-so, sẽ bị Vua Nê-bu-cát-nết-sa, nước Ba-by-lôn, tấn công. Đây là điều Chúa Hằng Hữu phán:"
  },
  {
    "id": 11542,
    "book": "jeremiah                                ",
    "chapter": "49",
    "verse": "29",
    "text": "Các trại và bầy gia súc của chúng sẽ bị chiếm đoạt,"
  },
  {
    "id": 11543,
    "book": "jeremiah                                ",
    "chapter": "49",
    "verse": "30",
    "text": "Chúa Hằng Hữu phán: “Hỡi cư dân Hát-so,"
  },
  {
    "id": 11544,
    "book": "jeremiah                                ",
    "chapter": "49",
    "verse": "31",
    "text": "Chúa Hằng Hữu phán:"
  },
  {
    "id": 11545,
    "book": "jeremiah                                ",
    "chapter": "49",
    "verse": "32",
    "text": "Các lạc đà và bầy gia súc của chúng sẽ là của ngươi."
  },
  {
    "id": 11546,
    "book": "jeremiah                                ",
    "chapter": "49",
    "verse": "33",
    "text": "“Hát-so sẽ trở thành hang chó rừng,"
  },
  {
    "id": 11547,
    "book": "jeremiah                                ",
    "chapter": "49",
    "verse": "34",
    "text": "Sứ điệp của Chúa Hằng Hữu ban cho Tiên tri Giê-rê-mi về Ê-lam khi Vua Sê-đê-kia, nước Giu-đa, mới lên ngôi trị vì."
  },
  {
    "id": 11548,
    "book": "jeremiah                                ",
    "chapter": "49",
    "verse": "35",
    "text": "Đây là điều Chúa Hằng Hữu Vạn Quân phán:"
  },
  {
    "id": 11549,
    "book": "jeremiah                                ",
    "chapter": "49",
    "verse": "36",
    "text": "Ta sẽ mang quân thù từ mọi nơi đến,"
  },
  {
    "id": 11550,
    "book": "jeremiah                                ",
    "chapter": "49",
    "verse": "37",
    "text": "Chính Ta sẽ đến cùng quân thù của Ê-lam để phân tán nó."
  },
  {
    "id": 11551,
    "book": "jeremiah                                ",
    "chapter": "49",
    "verse": "38",
    "text": "Chúa Hằng Hữu phán: “Ta sẽ đặt ngôi Ta trên Ê-lam"
  },
  {
    "id": 11552,
    "book": "jeremiah                                ",
    "chapter": "49",
    "verse": "39",
    "text": "Nhưng Ta sẽ phục hồi sự thịnh vượng của Ê-lam"
  }
]