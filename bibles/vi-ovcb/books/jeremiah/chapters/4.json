[
  {
    "id": 10414,
    "book": "jeremiah                                ",
    "chapter": "4",
    "verse": "1",
    "text": "Chúa Hằng Hữu kêu gọi: “Ít-ra-ên ơi,"
  },
  {
    "id": 10415,
    "book": "jeremiah                                ",
    "chapter": "4",
    "verse": "2",
    "text": "Và khi ngươi thề trong Danh Ta, ngươi nói:"
  },
  {
    "id": 10416,
    "book": "jeremiah                                ",
    "chapter": "4",
    "verse": "3",
    "text": "Đây là điều Chúa Hằng Hữu phán bảo người Giu-đa và Giê-ru-sa-lem:"
  },
  {
    "id": 10417,
    "book": "jeremiah                                ",
    "chapter": "4",
    "verse": "4",
    "text": "Hỡi cư dân Giu-đa và Giê-ru-sa-lem,"
  },
  {
    "id": 10418,
    "book": "jeremiah                                ",
    "chapter": "4",
    "verse": "5",
    "text": "Hãy tuyên cáo trong xứ Giu-đa và Giê-ru-sa-lem!"
  },
  {
    "id": 10419,
    "book": "jeremiah                                ",
    "chapter": "4",
    "verse": "6",
    "text": "Hãy dựng cờ báo hiệu hướng về Si-ôn:"
  },
  {
    "id": 10420,
    "book": "jeremiah                                ",
    "chapter": "4",
    "verse": "7",
    "text": "Một sư tử hiên ngang đã ra từ hang động,"
  },
  {
    "id": 10421,
    "book": "jeremiah                                ",
    "chapter": "4",
    "verse": "8",
    "text": "Hãy mặc áo tang tiếc thương,"
  },
  {
    "id": 10422,
    "book": "jeremiah                                ",
    "chapter": "4",
    "verse": "9",
    "text": "Chúa Hằng Hữu phán: “Trong ngày ấy,"
  },
  {
    "id": 10423,
    "book": "jeremiah                                ",
    "chapter": "4",
    "verse": "10",
    "text": "Tôi liền thưa: “Lạy Chúa Hằng Hữu Chí Cao,"
  },
  {
    "id": 10424,
    "book": "jeremiah                                ",
    "chapter": "4",
    "verse": "11",
    "text": "Khi đến kỳ, Chúa Hằng Hữu sẽ nói với cư dân Giê-ru-sa-lem:"
  },
  {
    "id": 10425,
    "book": "jeremiah                                ",
    "chapter": "4",
    "verse": "12",
    "text": "Đó là ngọn gió mạnh Ta sai đến!"
  },
  {
    "id": 10426,
    "book": "jeremiah                                ",
    "chapter": "4",
    "verse": "13",
    "text": "Kẻ thù chúng ta sẽ xông đến như mây cuồn cuộn!"
  },
  {
    "id": 10427,
    "book": "jeremiah                                ",
    "chapter": "4",
    "verse": "14",
    "text": "Giê-ru-sa-lem ơi! Hãy rửa lòng ngươi cho sạch gian ác,"
  },
  {
    "id": 10428,
    "book": "jeremiah                                ",
    "chapter": "4",
    "verse": "15",
    "text": "Sự hủy diệt ngươi đã được loan báo"
  },
  {
    "id": 10429,
    "book": "jeremiah                                ",
    "chapter": "4",
    "verse": "16",
    "text": "“Hãy cảnh báo các nước chung quanh"
  },
  {
    "id": 10430,
    "book": "jeremiah                                ",
    "chapter": "4",
    "verse": "17",
    "text": "Chúng vây chặt Giê-ru-sa-lem như người canh giữ ruộng,"
  },
  {
    "id": 10431,
    "book": "jeremiah                                ",
    "chapter": "4",
    "verse": "18",
    "text": "“Nếp sống4:18 Nt đường lối và việc ác ngươi là nguyên nhân của các tai họa này."
  },
  {
    "id": 10432,
    "book": "jeremiah                                ",
    "chapter": "4",
    "verse": "19",
    "text": "Ôi, lòng dạ tôi, lòng dạ tôi—tôi quằn quại trong cơn đau!"
  },
  {
    "id": 10433,
    "book": "jeremiah                                ",
    "chapter": "4",
    "verse": "20",
    "text": "Cơn sóng hủy diệt đang cuồn cuộn trên khắp đất,"
  },
  {
    "id": 10434,
    "book": "jeremiah                                ",
    "chapter": "4",
    "verse": "21",
    "text": "Tôi còn phải thấy cảnh chiến tranh tàn phá"
  },
  {
    "id": 10435,
    "book": "jeremiah                                ",
    "chapter": "4",
    "verse": "22",
    "text": "“Dân Ta thật là điên dại,"
  },
  {
    "id": 10436,
    "book": "jeremiah                                ",
    "chapter": "4",
    "verse": "23",
    "text": "Tôi quan sát trên đất, nó trống rỗng và không có hình thể."
  },
  {
    "id": 10437,
    "book": "jeremiah                                ",
    "chapter": "4",
    "verse": "24",
    "text": "Tôi nhìn lên các rặng núi cao và đồi,"
  },
  {
    "id": 10438,
    "book": "jeremiah                                ",
    "chapter": "4",
    "verse": "25",
    "text": "Tôi nhìn quanh, chẳng còn một bóng người."
  },
  {
    "id": 10439,
    "book": "jeremiah                                ",
    "chapter": "4",
    "verse": "26",
    "text": "Tôi nhìn, ruộng tốt biến thành hoang mạc."
  },
  {
    "id": 10440,
    "book": "jeremiah                                ",
    "chapter": "4",
    "verse": "27",
    "text": "Đây là điều Chúa Hằng Hữu phán:"
  },
  {
    "id": 10441,
    "book": "jeremiah                                ",
    "chapter": "4",
    "verse": "28",
    "text": "Khắp đất sẽ khóc than,"
  },
  {
    "id": 10442,
    "book": "jeremiah                                ",
    "chapter": "4",
    "verse": "29",
    "text": "Tất cả dân chúng đều khiếp sợ chạy trốn"
  },
  {
    "id": 10443,
    "book": "jeremiah                                ",
    "chapter": "4",
    "verse": "30",
    "text": "Các ngươi đang làm gì,"
  },
  {
    "id": 10444,
    "book": "jeremiah                                ",
    "chapter": "4",
    "verse": "31",
    "text": "Tôi nghe tiếng khóc la, như người đàn bà trong cơn chuyển bụng,"
  }
]