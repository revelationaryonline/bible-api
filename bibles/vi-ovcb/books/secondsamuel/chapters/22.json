[
  {
    "id": 5048,
    "book": "secondSamuel                            ",
    "chapter": "22",
    "verse": "1",
    "text": "Đa-vít hát bài ca sau đây để ca tụng Chúa Hằng Hữu đã giải cứu mình khỏi tay quân thù:"
  },
  {
    "id": 5049,
    "book": "secondSamuel                            ",
    "chapter": "22",
    "verse": "2",
    "text": "“Chúa Hằng Hữu là vầng đá và đồn lũy tôi, Đấng giải cứu tôi;"
  },
  {
    "id": 5050,
    "book": "secondSamuel                            ",
    "chapter": "22",
    "verse": "3",
    "text": "Chúa Hằng Hữu là vầng đá tôi, nơi tôi được bảo vệ."
  },
  {
    "id": 5051,
    "book": "secondSamuel                            ",
    "chapter": "22",
    "verse": "4",
    "text": "Tôi sẽ cầu xin với Chúa Hằng Hữu,"
  },
  {
    "id": 5052,
    "book": "secondSamuel                            ",
    "chapter": "22",
    "verse": "5",
    "text": "Lưới tử vong giăng mắc quanh tôi:"
  },
  {
    "id": 5053,
    "book": "secondSamuel                            ",
    "chapter": "22",
    "verse": "6",
    "text": "Âm phủ thắt chặt dây oan nghiệt;"
  },
  {
    "id": 5054,
    "book": "secondSamuel                            ",
    "chapter": "22",
    "verse": "7",
    "text": "Trong lúc hiểm nguy, tôi gọi Chân Thần;"
  },
  {
    "id": 5055,
    "book": "secondSamuel                            ",
    "chapter": "22",
    "verse": "8",
    "text": "Núi rung chuyển, lung lay."
  },
  {
    "id": 5056,
    "book": "secondSamuel                            ",
    "chapter": "22",
    "verse": "9",
    "text": "Khói bay từ mũi Chúa;"
  },
  {
    "id": 5057,
    "book": "secondSamuel                            ",
    "chapter": "22",
    "verse": "10",
    "text": "Chúa xé các tầng trời và ngự xuống;"
  },
  {
    "id": 5058,
    "book": "secondSamuel                            ",
    "chapter": "22",
    "verse": "11",
    "text": "Chúa cưỡi thiên thần22:11 Nt cherub hộ giá"
  },
  {
    "id": 5059,
    "book": "secondSamuel                            ",
    "chapter": "22",
    "verse": "12",
    "text": "Ngài dùng bóng tối của nước mưa và mây đen mù mịt,"
  },
  {
    "id": 5060,
    "book": "secondSamuel                            ",
    "chapter": "22",
    "verse": "13",
    "text": "Từ hào quang rực rỡ trên mặt Ngài,"
  },
  {
    "id": 5061,
    "book": "secondSamuel                            ",
    "chapter": "22",
    "verse": "14",
    "text": "Ngài cho sấm sét rền trời;"
  },
  {
    "id": 5062,
    "book": "secondSamuel                            ",
    "chapter": "22",
    "verse": "15",
    "text": "Chúa bắn tên, quân thù tán loạn;"
  },
  {
    "id": 5063,
    "book": "secondSamuel                            ",
    "chapter": "22",
    "verse": "16",
    "text": "Chúa Hằng Hữu quở to,"
  },
  {
    "id": 5064,
    "book": "secondSamuel                            ",
    "chapter": "22",
    "verse": "17",
    "text": "Chúa xuống từ trời cao;"
  },
  {
    "id": 5065,
    "book": "secondSamuel                            ",
    "chapter": "22",
    "verse": "18",
    "text": "Thoát kẻ thù kiêu ngạo,"
  },
  {
    "id": 5066,
    "book": "secondSamuel                            ",
    "chapter": "22",
    "verse": "19",
    "text": "Chúng tấn công con trong ngày gian truân,"
  },
  {
    "id": 5067,
    "book": "secondSamuel                            ",
    "chapter": "22",
    "verse": "20",
    "text": "Chúa đem tôi vào chỗ an toàn;"
  },
  {
    "id": 5068,
    "book": "secondSamuel                            ",
    "chapter": "22",
    "verse": "21",
    "text": "Chúa thưởng tôi với đức công bằng;22:21 Ctd công chính"
  },
  {
    "id": 5069,
    "book": "secondSamuel                            ",
    "chapter": "22",
    "verse": "22",
    "text": "Tôi tuân hành điều răn Chúa dạy;"
  },
  {
    "id": 5070,
    "book": "secondSamuel                            ",
    "chapter": "22",
    "verse": "23",
    "text": "Luật pháp Ngài gần tôi mãi mãi;"
  },
  {
    "id": 5071,
    "book": "secondSamuel                            ",
    "chapter": "22",
    "verse": "24",
    "text": "Trước mặt Đức Chúa Trời, tôi chẳng gì đáng trách;"
  },
  {
    "id": 5072,
    "book": "secondSamuel                            ",
    "chapter": "22",
    "verse": "25",
    "text": "Chúa luôn tưởng thưởng người ngay."
  },
  {
    "id": 5073,
    "book": "secondSamuel                            ",
    "chapter": "22",
    "verse": "26",
    "text": "Chúa thành tín đối với ai trung tín,"
  },
  {
    "id": 5074,
    "book": "secondSamuel                            ",
    "chapter": "22",
    "verse": "27",
    "text": "Chúa ban phước cho người thánh sạch,"
  },
  {
    "id": 5075,
    "book": "secondSamuel                            ",
    "chapter": "22",
    "verse": "28",
    "text": "Chúa cứu vớt nhân dân khốn khổ,"
  },
  {
    "id": 5076,
    "book": "secondSamuel                            ",
    "chapter": "22",
    "verse": "29",
    "text": "Chúa Hằng Hữu thắp đèn tôi sáng."
  },
  {
    "id": 5077,
    "book": "secondSamuel                            ",
    "chapter": "22",
    "verse": "30",
    "text": "Nhờ sức Chúa, tôi dẹp tan quân địch;"
  },
  {
    "id": 5078,
    "book": "secondSamuel                            ",
    "chapter": "22",
    "verse": "31",
    "text": "Đức Chúa Trời thật muôn phần hoàn hảo."
  },
  {
    "id": 5079,
    "book": "secondSamuel                            ",
    "chapter": "22",
    "verse": "32",
    "text": "Ngoài Chúa ra, chẳng có Chân Thần."
  },
  {
    "id": 5080,
    "book": "secondSamuel                            ",
    "chapter": "22",
    "verse": "33",
    "text": "Chúa trang bị cho tôi năng lực,"
  },
  {
    "id": 5081,
    "book": "secondSamuel                            ",
    "chapter": "22",
    "verse": "34",
    "text": "Chân tôi bước vững vàng lanh lẹ,"
  },
  {
    "id": 5082,
    "book": "secondSamuel                            ",
    "chapter": "22",
    "verse": "35",
    "text": "Chúa luyện tay tôi sành chinh chiến,"
  },
  {
    "id": 5083,
    "book": "secondSamuel                            ",
    "chapter": "22",
    "verse": "36",
    "text": "Chúa trao tôi tấm khiên cứu rỗi;"
  },
  {
    "id": 5084,
    "book": "secondSamuel                            ",
    "chapter": "22",
    "verse": "37",
    "text": "Trước chân tôi, mở một con đường."
  },
  {
    "id": 5085,
    "book": "secondSamuel                            ",
    "chapter": "22",
    "verse": "38",
    "text": "Tôi đuổi theo, bắt kịp quân thù;"
  },
  {
    "id": 5086,
    "book": "secondSamuel                            ",
    "chapter": "22",
    "verse": "39",
    "text": "Tôi thấy chúng chết nằm la liệt,"
  },
  {
    "id": 5087,
    "book": "secondSamuel                            ",
    "chapter": "22",
    "verse": "40",
    "text": "Chúa trang bị con sức mạnh cho chiến trận,"
  },
  {
    "id": 5088,
    "book": "secondSamuel                            ",
    "chapter": "22",
    "verse": "41",
    "text": "Chúa khiến địch quay lưng trốn chạy."
  },
  {
    "id": 5089,
    "book": "secondSamuel                            ",
    "chapter": "22",
    "verse": "42",
    "text": "Chúng van xin, không ai tiếp cứu."
  },
  {
    "id": 5090,
    "book": "secondSamuel                            ",
    "chapter": "22",
    "verse": "43",
    "text": "Tôi nghiền chúng ra như cám bụi;"
  },
  {
    "id": 5091,
    "book": "secondSamuel                            ",
    "chapter": "22",
    "verse": "44",
    "text": "Chúa cứu con khỏi sự công kích của con người,"
  },
  {
    "id": 5092,
    "book": "secondSamuel                            ",
    "chapter": "22",
    "verse": "45",
    "text": "Tôi ra lệnh, chúng theo răm rắp;"
  },
  {
    "id": 5093,
    "book": "secondSamuel                            ",
    "chapter": "22",
    "verse": "46",
    "text": "Chúng mất hết tinh thần, sức lực"
  },
  {
    "id": 5094,
    "book": "secondSamuel                            ",
    "chapter": "22",
    "verse": "47",
    "text": "Chúa Hằng Hữu trường tồn bất biến!"
  },
  {
    "id": 5095,
    "book": "secondSamuel                            ",
    "chapter": "22",
    "verse": "48",
    "text": "Chúa công minh báo oán ban ơn;22:48 Ctd thêm: Bọn xâm lăng đến ngày tận diệt"
  },
  {
    "id": 5096,
    "book": "secondSamuel                            ",
    "chapter": "22",
    "verse": "49",
    "text": "Cứu thoát tôi hỏi tay quân địch,"
  },
  {
    "id": 5097,
    "book": "secondSamuel                            ",
    "chapter": "22",
    "verse": "50",
    "text": "Vì thế nên, tôi hằng ca ngợi,"
  },
  {
    "id": 5098,
    "book": "secondSamuel                            ",
    "chapter": "22",
    "verse": "51",
    "text": "Với người Ngài chọn, Chúa khoan nhân."
  }
]