[
  {
    "id": 22752,
    "book": "genesis                                 ",
    "chapter": "49",
    "verse": "1",
    "text": "Gia-cốp bảo các con trai hội họp lại để nghe ông nói trước việc tương lai của họ:"
  },
  {
    "id": 22753,
    "book": "genesis                                 ",
    "chapter": "49",
    "verse": "2",
    "text": "“Các con trai Gia-cốp, hãy họp lại đây;"
  },
  {
    "id": 22754,
    "book": "genesis                                 ",
    "chapter": "49",
    "verse": "3",
    "text": "Con trưởng nam Ru-bên,"
  },
  {
    "id": 22755,
    "book": "genesis                                 ",
    "chapter": "49",
    "verse": "4",
    "text": "Nhưng con bồng bột như thủy triều,"
  },
  {
    "id": 22756,
    "book": "genesis                                 ",
    "chapter": "49",
    "verse": "5",
    "text": "Hai anh em Si-mê-ôn và Lê-vi;"
  },
  {
    "id": 22757,
    "book": "genesis                                 ",
    "chapter": "49",
    "verse": "6",
    "text": "Linh hồn ta! Hãy tránh xa chúng nó;"
  },
  {
    "id": 22758,
    "book": "genesis                                 ",
    "chapter": "49",
    "verse": "7",
    "text": "Cơn giận chúng nó bị nguyền rủa;"
  },
  {
    "id": 22759,
    "book": "genesis                                 ",
    "chapter": "49",
    "verse": "8",
    "text": "Giu-đa! Con được các anh em ca tụng."
  },
  {
    "id": 22760,
    "book": "genesis                                 ",
    "chapter": "49",
    "verse": "9",
    "text": "Sư tử tơ Giu-đa là chúa động."
  },
  {
    "id": 22761,
    "book": "genesis                                 ",
    "chapter": "49",
    "verse": "10",
    "text": "Cây quyền trượng chẳng xa lìa Giu-đa,"
  },
  {
    "id": 22762,
    "book": "genesis                                 ",
    "chapter": "49",
    "verse": "11",
    "text": "Con sẽ buộc lừa vào cành nho,"
  },
  {
    "id": 22763,
    "book": "genesis                                 ",
    "chapter": "49",
    "verse": "12",
    "text": "Mắt con đậm màu rượu đỏ,"
  },
  {
    "id": 22764,
    "book": "genesis                                 ",
    "chapter": "49",
    "verse": "13",
    "text": "Sa-bu-luân sẽ sống tại bờ biển,"
  },
  {
    "id": 22765,
    "book": "genesis                                 ",
    "chapter": "49",
    "verse": "14",
    "text": "Y-sa-ca là con lừa lực lưỡng,"
  },
  {
    "id": 22766,
    "book": "genesis                                 ",
    "chapter": "49",
    "verse": "15",
    "text": "Đến nơi49:15 Nt thấy một nơi nghỉ tốt đẹp liền tận hưởng,"
  },
  {
    "id": 22767,
    "book": "genesis                                 ",
    "chapter": "49",
    "verse": "16",
    "text": "Đan sẽ xử đoán dân mình,"
  },
  {
    "id": 22768,
    "book": "genesis                                 ",
    "chapter": "49",
    "verse": "17",
    "text": "Đan là con rắn độc bên đường"
  },
  {
    "id": 22769,
    "book": "genesis                                 ",
    "chapter": "49",
    "verse": "18",
    "text": "Lạy Chúa Hằng Hữu!"
  },
  {
    "id": 22770,
    "book": "genesis                                 ",
    "chapter": "49",
    "verse": "19",
    "text": "Gát sẽ bị quân thù đột kích,"
  },
  {
    "id": 22771,
    "book": "genesis                                 ",
    "chapter": "49",
    "verse": "20",
    "text": "A-se sản xuất nhiều thức ăn ngon,"
  },
  {
    "id": 22772,
    "book": "genesis                                 ",
    "chapter": "49",
    "verse": "21",
    "text": "Nép-ta-li là nai cái thong dong,"
  },
  {
    "id": 22773,
    "book": "genesis                                 ",
    "chapter": "49",
    "verse": "22",
    "text": "Giô-sép là một cây sai trái,"
  },
  {
    "id": 22774,
    "book": "genesis                                 ",
    "chapter": "49",
    "verse": "23",
    "text": "Bị cung tên kẻ thù dọa ngăm,"
  },
  {
    "id": 22775,
    "book": "genesis                                 ",
    "chapter": "49",
    "verse": "24",
    "text": "Nhưng nhờ Chúa Toàn Năng của Gia-cốp,"
  },
  {
    "id": 22776,
    "book": "genesis                                 ",
    "chapter": "49",
    "verse": "25",
    "text": "Đức Chúa Trời của cha sẽ giúp đỡ;"
  },
  {
    "id": 22777,
    "book": "genesis                                 ",
    "chapter": "49",
    "verse": "26",
    "text": "Phước lành cha chúc cho con"
  },
  {
    "id": 22778,
    "book": "genesis                                 ",
    "chapter": "49",
    "verse": "27",
    "text": "Bên-gia-min là chó sói săn mồi,"
  },
  {
    "id": 22779,
    "book": "genesis                                 ",
    "chapter": "49",
    "verse": "28",
    "text": "Đó là mười hai đại tộc Ít-ra-ên và lời chúc cho mười hai con trai của ông, mỗi người một lời chúc riêng biệt."
  },
  {
    "id": 22780,
    "book": "genesis                                 ",
    "chapter": "49",
    "verse": "29",
    "text": "Rồi Gia-cốp dặn bảo họ: “Cha sắp qua đời. Các con hãy chôn cha nơi phần mộ tổ tiên, trong hang đá ở cánh đồng của Ép-rôn, người Hê-tít."
  },
  {
    "id": 22781,
    "book": "genesis                                 ",
    "chapter": "49",
    "verse": "30",
    "text": "Đây là hang đá trong núi của cánh đồng Mạc-bê-la, gần Mam-rê, xứ Ca-na-an, mà Áp-ra-ham đã mua của Ép-rôn người Hê-tít, để làm nghĩa trang."
  },
  {
    "id": 22782,
    "book": "genesis                                 ",
    "chapter": "49",
    "verse": "31",
    "text": "Người ta đã an táng Áp-ra-ham và Sa-ra, Y-sác, và Rê-bê-ca, và cha cũng đã chôn Lê-a tại đó."
  },
  {
    "id": 22783,
    "book": "genesis                                 ",
    "chapter": "49",
    "verse": "32",
    "text": "Cánh đồng và hang núi ấy do con cháu Hê-tít bán lại.”"
  },
  {
    "id": 22784,
    "book": "genesis                                 ",
    "chapter": "49",
    "verse": "33",
    "text": "Gia-cốp dứt lời, nằm xuống giường, và nhắm mắt tắt hơi."
  }
]