[
  {
    "id": 29163,
    "book": "ezekiel                                 ",
    "chapter": "7",
    "verse": "1",
    "text": "Chúa Hằng Hữu phán cùng tôi sứ điệp này:"
  },
  {
    "id": 29164,
    "book": "ezekiel                                 ",
    "chapter": "7",
    "verse": "2",
    "text": "“Hỡi con người, đây là điều Chúa Hằng Hữu Chí Cao phán về đất Ít-ra-ên:"
  },
  {
    "id": 29165,
    "book": "ezekiel                                 ",
    "chapter": "7",
    "verse": "3",
    "text": "Hy vọng không còn tồn tại,"
  },
  {
    "id": 29166,
    "book": "ezekiel                                 ",
    "chapter": "7",
    "verse": "4",
    "text": "Ta sẽ quay mặt và chẳng chút tiếc thương."
  },
  {
    "id": 29167,
    "book": "ezekiel                                 ",
    "chapter": "7",
    "verse": "5",
    "text": "Chúa Hằng Hữu Chí Cao phán:"
  },
  {
    "id": 29168,
    "book": "ezekiel                                 ",
    "chapter": "7",
    "verse": "6",
    "text": "Hồi kết cuộc đã đến."
  },
  {
    "id": 29169,
    "book": "ezekiel                                 ",
    "chapter": "7",
    "verse": "7",
    "text": "Hỡi cư dân Ít-ra-ên, ngày tai họa của ngươi đã đến."
  },
  {
    "id": 29170,
    "book": "ezekiel                                 ",
    "chapter": "7",
    "verse": "8",
    "text": "Ta sẽ sớm đổ cơn giận Ta lên ngươi,"
  },
  {
    "id": 29171,
    "book": "ezekiel                                 ",
    "chapter": "7",
    "verse": "9",
    "text": "Ta sẽ quay mặt khỏi ngươi chẳng chút xót thương."
  },
  {
    "id": 29172,
    "book": "ezekiel                                 ",
    "chapter": "7",
    "verse": "10",
    "text": "Ngày phán xét đã tới,"
  },
  {
    "id": 29173,
    "book": "ezekiel                                 ",
    "chapter": "7",
    "verse": "11",
    "text": "Sự cường bạo dâng cao"
  },
  {
    "id": 29174,
    "book": "ezekiel                                 ",
    "chapter": "7",
    "verse": "12",
    "text": "Phải, giờ đã tới;"
  },
  {
    "id": 29175,
    "book": "ezekiel                                 ",
    "chapter": "7",
    "verse": "13",
    "text": "Dù nếu người bán mong sống sót,"
  },
  {
    "id": 29176,
    "book": "ezekiel                                 ",
    "chapter": "7",
    "verse": "14",
    "text": "“Tiếng thổi kèn động viên quân đội Ít-ra-ên,"
  },
  {
    "id": 29177,
    "book": "ezekiel                                 ",
    "chapter": "7",
    "verse": "15",
    "text": "Chiến tranh bên ngoài thành,"
  },
  {
    "id": 29178,
    "book": "ezekiel                                 ",
    "chapter": "7",
    "verse": "16",
    "text": "Người nào trốn được lên núi"
  },
  {
    "id": 29179,
    "book": "ezekiel                                 ",
    "chapter": "7",
    "verse": "17",
    "text": "Mọi bàn tay đều trở nên yếu đuối,"
  },
  {
    "id": 29180,
    "book": "ezekiel                                 ",
    "chapter": "7",
    "verse": "18",
    "text": "Chúng sẽ mặc áo tang;"
  },
  {
    "id": 29181,
    "book": "ezekiel                                 ",
    "chapter": "7",
    "verse": "19",
    "text": "Chúng ném bạc ngoài đường,"
  },
  {
    "id": 29182,
    "book": "ezekiel                                 ",
    "chapter": "7",
    "verse": "20",
    "text": "Chúng hãnh diện về những đồ trang sức lộng lẫy đẹp đẽ"
  },
  {
    "id": 29183,
    "book": "ezekiel                                 ",
    "chapter": "7",
    "verse": "21",
    "text": "Ta sẽ ban cho người nước ngoài"
  },
  {
    "id": 29184,
    "book": "ezekiel                                 ",
    "chapter": "7",
    "verse": "22",
    "text": "Ta sẽ xây mặt khỏi chúng,"
  },
  {
    "id": 29185,
    "book": "ezekiel                                 ",
    "chapter": "7",
    "verse": "23",
    "text": "Hãy chuẩn bị xiềng xích,"
  },
  {
    "id": 29186,
    "book": "ezekiel                                 ",
    "chapter": "7",
    "verse": "24",
    "text": "Ta sẽ đem những kẻ xấu xa nhất từ nước ngoài"
  },
  {
    "id": 29187,
    "book": "ezekiel                                 ",
    "chapter": "7",
    "verse": "25",
    "text": "Sự kinh hoàng và run sợ sẽ tràn ngập trên dân Ta."
  },
  {
    "id": 29188,
    "book": "ezekiel                                 ",
    "chapter": "7",
    "verse": "26",
    "text": "Tai ương dồn dập;"
  },
  {
    "id": 29189,
    "book": "ezekiel                                 ",
    "chapter": "7",
    "verse": "27",
    "text": "Vua và các quan tướng sẽ bơ vơ,"
  }
]