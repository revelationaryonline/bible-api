[
  {
    "id": 25386,
    "book": "judges                                  ",
    "chapter": "5",
    "verse": "1",
    "text": "Trong ngày ấy, Đê-bô-ra và Ba-rác, con A-bi-nô-am hát bài này:"
  },
  {
    "id": 25387,
    "book": "judges                                  ",
    "chapter": "5",
    "verse": "2",
    "text": "“Hãy ngợi ca Chúa Hằng Hữu!"
  },
  {
    "id": 25388,
    "book": "judges                                  ",
    "chapter": "5",
    "verse": "3",
    "text": "Hỡi các vua, hãy nghe!"
  },
  {
    "id": 25389,
    "book": "judges                                  ",
    "chapter": "5",
    "verse": "4",
    "text": "Lạy Chúa Hằng Hữu, khi Ngài từ Sê-i-rơ5:4 Nt Seir (xứ Ê-đôm) đi ra"
  },
  {
    "id": 25390,
    "book": "judges                                  ",
    "chapter": "5",
    "verse": "5",
    "text": "Các núi rúng động trước mặt Chúa Hằng Hữu,"
  },
  {
    "id": 25391,
    "book": "judges                                  ",
    "chapter": "5",
    "verse": "6",
    "text": "Trong những ngày của Sam-ga, con trai A-nát,"
  },
  {
    "id": 25392,
    "book": "judges                                  ",
    "chapter": "5",
    "verse": "7",
    "text": "Chỉ còn vài người sót lại trong các làng mạc Ít-ra-ên,"
  },
  {
    "id": 25393,
    "book": "judges                                  ",
    "chapter": "5",
    "verse": "8",
    "text": "Khi Ít-ra-ên chọn các thần mới,"
  },
  {
    "id": 25394,
    "book": "judges                                  ",
    "chapter": "5",
    "verse": "9",
    "text": "Tôi hòa lòng với các tướng lãnh của Ít-ra-ên,"
  },
  {
    "id": 25395,
    "book": "judges                                  ",
    "chapter": "5",
    "verse": "10",
    "text": "Hãy suy ngẫm việc này, hỡi những người cưỡi lừa trắng,"
  },
  {
    "id": 25396,
    "book": "judges                                  ",
    "chapter": "5",
    "verse": "11",
    "text": "Hãy lắng nghe các nhạc công trong làng mạc"
  },
  {
    "id": 25397,
    "book": "judges                                  ",
    "chapter": "5",
    "verse": "12",
    "text": "Hãy tỉnh thức, hỡi Đê-bô-ra, hãy tỉnh thức!"
  },
  {
    "id": 25398,
    "book": "judges                                  ",
    "chapter": "5",
    "verse": "13",
    "text": "Bấy giờ, vài người từ Ta-bô đi xuống với các thủ lĩnh."
  },
  {
    "id": 25399,
    "book": "judges                                  ",
    "chapter": "5",
    "verse": "14",
    "text": "Họ kéo đến từ Ép-ra-im—"
  },
  {
    "id": 25400,
    "book": "judges                                  ",
    "chapter": "5",
    "verse": "15",
    "text": "Các hoàng tử Y-sa-ca đều theo Đê-bô-ra và Ba-rác."
  },
  {
    "id": 25401,
    "book": "judges                                  ",
    "chapter": "5",
    "verse": "16",
    "text": "Tại sao anh nán lại bên chuồng chiên—"
  },
  {
    "id": 25402,
    "book": "judges                                  ",
    "chapter": "5",
    "verse": "17",
    "text": "Ga-la-át đã ở phía đông sông Giô-đan."
  },
  {
    "id": 25403,
    "book": "judges                                  ",
    "chapter": "5",
    "verse": "18",
    "text": "Nhưng Sa-bu-luân đã liều thân,"
  },
  {
    "id": 25404,
    "book": "judges                                  ",
    "chapter": "5",
    "verse": "19",
    "text": "Các vua Ca-na-an kéo đến tấn công,"
  },
  {
    "id": 25405,
    "book": "judges                                  ",
    "chapter": "5",
    "verse": "20",
    "text": "Các ngôi sao từ trời tham chiến"
  },
  {
    "id": 25406,
    "book": "judges                                  ",
    "chapter": "5",
    "verse": "21",
    "text": "Sông Ki-sôn cuốn trôi quân thù,"
  },
  {
    "id": 25407,
    "book": "judges                                  ",
    "chapter": "5",
    "verse": "22",
    "text": "Bấy giờ, tiếng vó ngựa giẫm đạp mặt đất"
  },
  {
    "id": 25408,
    "book": "judges                                  ",
    "chapter": "5",
    "verse": "23",
    "text": "Sứ giả của Chúa Hằng Hữu truyền: ‘Hãy nguyền rủa Mê-rô;"
  },
  {
    "id": 25409,
    "book": "judges                                  ",
    "chapter": "5",
    "verse": "24",
    "text": "Nguyện cho Gia-ên, vợ Hê-be, người Kê-nít"
  },
  {
    "id": 25410,
    "book": "judges                                  ",
    "chapter": "5",
    "verse": "25",
    "text": "Si-sê-ra xin nước,"
  },
  {
    "id": 25411,
    "book": "judges                                  ",
    "chapter": "5",
    "verse": "26",
    "text": "Tay trái nàng nắm cây cọc lều,"
  },
  {
    "id": 25412,
    "book": "judges                                  ",
    "chapter": "5",
    "verse": "27",
    "text": "Hắn ngã gục,"
  },
  {
    "id": 25413,
    "book": "judges                                  ",
    "chapter": "5",
    "verse": "28",
    "text": "Mẹ của Si-sê-ra nhìn qua cửa sổ."
  },
  {
    "id": 25414,
    "book": "judges                                  ",
    "chapter": "5",
    "verse": "29",
    "text": "Những nàng hầu khôn ngoan trả lời,"
  },
  {
    "id": 25415,
    "book": "judges                                  ",
    "chapter": "5",
    "verse": "30",
    "text": "‘Chẳng phải họ đang chia chiến lợi phẩm hay sao?"
  },
  {
    "id": 25416,
    "book": "judges                                  ",
    "chapter": "5",
    "verse": "31",
    "text": "Lạy Chúa Hằng Hữu, nguyện mọi kẻ thù của Ngài bị diệt như Si-sê-ra!"
  }
]