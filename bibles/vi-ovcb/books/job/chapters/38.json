[
  {
    "id": 12621,
    "book": "job                                     ",
    "chapter": "38",
    "verse": "1",
    "text": "Rồi giữa cơn bão tố, Chúa Hằng Hữu đáp lời Gióp:"
  },
  {
    "id": 12622,
    "book": "job                                     ",
    "chapter": "38",
    "verse": "2",
    "text": "“Ngươi là ai mà dám dùng lời vô ý thức"
  },
  {
    "id": 12623,
    "book": "job                                     ",
    "chapter": "38",
    "verse": "3",
    "text": "Hãy nai nịt như dũng sĩ,"
  },
  {
    "id": 12624,
    "book": "job                                     ",
    "chapter": "38",
    "verse": "4",
    "text": "Con ở đâu khi Ta đặt móng nền quả đất?"
  },
  {
    "id": 12625,
    "book": "job                                     ",
    "chapter": "38",
    "verse": "5",
    "text": "Ai đã định kích thước địa cầu"
  },
  {
    "id": 12626,
    "book": "job                                     ",
    "chapter": "38",
    "verse": "6",
    "text": "Nền địa cầu tựa trên gì,"
  },
  {
    "id": 12627,
    "book": "job                                     ",
    "chapter": "38",
    "verse": "7",
    "text": "trong lúc các sao mai hợp ca"
  },
  {
    "id": 12628,
    "book": "job                                     ",
    "chapter": "38",
    "verse": "8",
    "text": "Ai đặt cửa để khóa các đại dương"
  },
  {
    "id": 12629,
    "book": "job                                     ",
    "chapter": "38",
    "verse": "9",
    "text": "và Ta dùng mây làm áo dài cho chúng,"
  },
  {
    "id": 12630,
    "book": "job                                     ",
    "chapter": "38",
    "verse": "10",
    "text": "Ta đặt ranh giới cho các đại dương"
  },
  {
    "id": 12631,
    "book": "job                                     ",
    "chapter": "38",
    "verse": "11",
    "text": "Ta phán: ‘Đây là giới hạn, không đi xa hơn nữa."
  },
  {
    "id": 12632,
    "book": "job                                     ",
    "chapter": "38",
    "verse": "12",
    "text": "Có bao giờ con ra lệnh cho ban mai xuất hiện"
  },
  {
    "id": 12633,
    "book": "job                                     ",
    "chapter": "38",
    "verse": "13",
    "text": "Có bao giờ con bảo ánh dương trải ra đến tận cuối chân trời,"
  },
  {
    "id": 12634,
    "book": "job                                     ",
    "chapter": "38",
    "verse": "14",
    "text": "Khi ánh sáng đến gần,"
  },
  {
    "id": 12635,
    "book": "job                                     ",
    "chapter": "38",
    "verse": "15",
    "text": "Ánh sáng tố cáo hành tung bọn gian tà,"
  },
  {
    "id": 12636,
    "book": "job                                     ",
    "chapter": "38",
    "verse": "16",
    "text": "Có khi nào con tìm đến tận nguồn biển cả?"
  },
  {
    "id": 12637,
    "book": "job                                     ",
    "chapter": "38",
    "verse": "17",
    "text": "Con có biết cổng âm phủ ở đâu?"
  },
  {
    "id": 12638,
    "book": "job                                     ",
    "chapter": "38",
    "verse": "18",
    "text": "Con có nhận thức khoảng rộng của quả đất?"
  },
  {
    "id": 12639,
    "book": "job                                     ",
    "chapter": "38",
    "verse": "19",
    "text": "Con có biết cội nguồn ánh sáng,"
  },
  {
    "id": 12640,
    "book": "job                                     ",
    "chapter": "38",
    "verse": "20",
    "text": "Con có thể đem nó trở về nhà không?"
  },
  {
    "id": 12641,
    "book": "job                                     ",
    "chapter": "38",
    "verse": "21",
    "text": "Dĩ nhiên con biết tất cả điều này!"
  },
  {
    "id": 12642,
    "book": "job                                     ",
    "chapter": "38",
    "verse": "22",
    "text": "Con có vào được kho chứa tuyết"
  },
  {
    "id": 12643,
    "book": "job                                     ",
    "chapter": "38",
    "verse": "23",
    "text": "(Ta dành nó như vũ khí cho thời loạn,"
  },
  {
    "id": 12644,
    "book": "job                                     ",
    "chapter": "38",
    "verse": "24",
    "text": "Đường nào dẫn đến nơi tỏa ra ánh sáng?"
  },
  {
    "id": 12645,
    "book": "job                                     ",
    "chapter": "38",
    "verse": "25",
    "text": "Ai đào kênh cho mưa lũ?"
  },
  {
    "id": 12646,
    "book": "job                                     ",
    "chapter": "38",
    "verse": "26",
    "text": "Ai khiến mưa tưới tràn đất khô khan,"
  },
  {
    "id": 12647,
    "book": "job                                     ",
    "chapter": "38",
    "verse": "27",
    "text": "Ai cho đất tiêu sơ thấm nhuần mưa móc,"
  },
  {
    "id": 12648,
    "book": "job                                     ",
    "chapter": "38",
    "verse": "28",
    "text": "Phải chăng mưa có cha?"
  },
  {
    "id": 12649,
    "book": "job                                     ",
    "chapter": "38",
    "verse": "29",
    "text": "Ai là mẹ nước đá?"
  },
  {
    "id": 12650,
    "book": "job                                     ",
    "chapter": "38",
    "verse": "30",
    "text": "Nước đông cứng như đá tảng,"
  },
  {
    "id": 12651,
    "book": "job                                     ",
    "chapter": "38",
    "verse": "31",
    "text": "Con có thể di chuyển các vì sao—"
  },
  {
    "id": 12652,
    "book": "job                                     ",
    "chapter": "38",
    "verse": "32",
    "text": "Con có thể khiến các quần tinh di chuyển theo mùa38:32 Ctd con có thể đem các tinh tú ra cho đúng thì tiết không? không"
  },
  {
    "id": 12653,
    "book": "job                                     ",
    "chapter": "38",
    "verse": "33",
    "text": "Con có biết các định luật của trời?"
  },
  {
    "id": 12654,
    "book": "job                                     ",
    "chapter": "38",
    "verse": "34",
    "text": "Con có thể gọi mây"
  },
  {
    "id": 12655,
    "book": "job                                     ",
    "chapter": "38",
    "verse": "35",
    "text": "Con có quyền truyền bảo sấm sét,"
  },
  {
    "id": 12656,
    "book": "job                                     ",
    "chapter": "38",
    "verse": "36",
    "text": "Ai đặt sự khôn ngoan trong tâm hồn"
  },
  {
    "id": 12657,
    "book": "job                                     ",
    "chapter": "38",
    "verse": "37",
    "text": "Ai đủ trí khôn để đếm các cụm mây?"
  },
  {
    "id": 12658,
    "book": "job                                     ",
    "chapter": "38",
    "verse": "38",
    "text": "khi bụi kết cứng lại,"
  },
  {
    "id": 12659,
    "book": "job                                     ",
    "chapter": "38",
    "verse": "39",
    "text": "Con có thể đi săn mồi cho sư tử,"
  },
  {
    "id": 12660,
    "book": "job                                     ",
    "chapter": "38",
    "verse": "40",
    "text": "khi chúng nằm trong hang động"
  },
  {
    "id": 12661,
    "book": "job                                     ",
    "chapter": "38",
    "verse": "41",
    "text": "Ai cung cấp lương thực nuôi đàn quạ,"
  }
]