[
  {
    "id": 12478,
    "book": "job                                     ",
    "chapter": "33",
    "verse": "1",
    "text": "“Vậy, xin lắng nghe lời tôi, thưa ông Gióp;"
  },
  {
    "id": 12479,
    "book": "job                                     ",
    "chapter": "33",
    "verse": "2",
    "text": "Bây giờ, tôi đã bắt đầu nói,"
  },
  {
    "id": 12480,
    "book": "job                                     ",
    "chapter": "33",
    "verse": "3",
    "text": "Tôi xin nói với tất cả lời chân thành;"
  },
  {
    "id": 12481,
    "book": "job                                     ",
    "chapter": "33",
    "verse": "4",
    "text": "Vì Thần Linh Đức Chúa Trời tạo dựng tôi,"
  },
  {
    "id": 12482,
    "book": "job                                     ",
    "chapter": "33",
    "verse": "5",
    "text": "Nếu có thể, xin anh vui lòng giải đáp;"
  },
  {
    "id": 12483,
    "book": "job                                     ",
    "chapter": "33",
    "verse": "6",
    "text": "Đây, anh và tôi đều thuộc về Đức Chúa Trời.33:6 Ctd Kìa, trước mặt Đức Chúa Trời, tôi cũng như ông: tôi cũng được dựng nên bằng đất sét (ML)"
  },
  {
    "id": 12484,
    "book": "job                                     ",
    "chapter": "33",
    "verse": "7",
    "text": "Vậy anh không cần phải sợ hãi tôi."
  },
  {
    "id": 12485,
    "book": "job                                     ",
    "chapter": "33",
    "verse": "8",
    "text": "Hẳn nhiên anh đã nói rõ ràng,"
  },
  {
    "id": 12486,
    "book": "job                                     ",
    "chapter": "33",
    "verse": "9",
    "text": "Anh nói: ‘Tôi là người trong sạch; tôi không có tội;"
  },
  {
    "id": 12487,
    "book": "job                                     ",
    "chapter": "33",
    "verse": "10",
    "text": "Tuy nhiên, Đức Chúa Trời tìm dịp tố cáo tôi,"
  },
  {
    "id": 12488,
    "book": "job                                     ",
    "chapter": "33",
    "verse": "11",
    "text": "Chúa đặt hai chân tôi vào cùm,"
  },
  {
    "id": 12489,
    "book": "job                                     ",
    "chapter": "33",
    "verse": "12",
    "text": "Nhưng ông đã sai, và tôi sẽ cho anh biết tại sao."
  },
  {
    "id": 12490,
    "book": "job                                     ",
    "chapter": "33",
    "verse": "13",
    "text": "Tại sao anh mang lý lẽ chống nghịch Chúa?"
  },
  {
    "id": 12491,
    "book": "job                                     ",
    "chapter": "33",
    "verse": "14",
    "text": "Vì Đức Chúa Trời vẫn phán dạy nhiều lần nhiều cách,"
  },
  {
    "id": 12492,
    "book": "job                                     ",
    "chapter": "33",
    "verse": "15",
    "text": "Chúa phán trong giấc mơ, trong khải tượng ban đêm,"
  },
  {
    "id": 12493,
    "book": "job                                     ",
    "chapter": "33",
    "verse": "16",
    "text": "Chúa thì thầm vào tai họ"
  },
  {
    "id": 12494,
    "book": "job                                     ",
    "chapter": "33",
    "verse": "17",
    "text": "Ngài khiến người quay lưng khỏi điều ác;"
  },
  {
    "id": 12495,
    "book": "job                                     ",
    "chapter": "33",
    "verse": "18",
    "text": "Ngài cứu người khỏi huyệt mộ,"
  },
  {
    "id": 12496,
    "book": "job                                     ",
    "chapter": "33",
    "verse": "19",
    "text": "Đức Chúa Trời sửa trị con người bằng nỗi đau trên giường bệnh,"
  },
  {
    "id": 12497,
    "book": "job                                     ",
    "chapter": "33",
    "verse": "20",
    "text": "Làm cho người ngao ngán thức ăn,"
  },
  {
    "id": 12498,
    "book": "job                                     ",
    "chapter": "33",
    "verse": "21",
    "text": "Thân thể ngày càng suy nhược,"
  },
  {
    "id": 12499,
    "book": "job                                     ",
    "chapter": "33",
    "verse": "22",
    "text": "Linh hồn đã đến cửa âm phủ;"
  },
  {
    "id": 12500,
    "book": "job                                     ",
    "chapter": "33",
    "verse": "23",
    "text": "Nhưng nếu có một thiên sứ từ trời xuất hiện—"
  },
  {
    "id": 12501,
    "book": "job                                     ",
    "chapter": "33",
    "verse": "24",
    "text": "thương xót người và nói:"
  },
  {
    "id": 12502,
    "book": "job                                     ",
    "chapter": "33",
    "verse": "25",
    "text": "Rồi thân thể người lại mịn màng như con trẻ,"
  },
  {
    "id": 12503,
    "book": "job                                     ",
    "chapter": "33",
    "verse": "26",
    "text": "Người sẽ cầu khẩn với Đức Chúa Trời,"
  },
  {
    "id": 12504,
    "book": "job                                     ",
    "chapter": "33",
    "verse": "27",
    "text": "Người sẽ ra trước mặt mọi người và nói:"
  },
  {
    "id": 12505,
    "book": "job                                     ",
    "chapter": "33",
    "verse": "28",
    "text": "Đức Chúa Trời cứu chuộc linh hồn tôi khỏi âm phủ"
  },
  {
    "id": 12506,
    "book": "job                                     ",
    "chapter": "33",
    "verse": "29",
    "text": "Đúng vậy, Đức Chúa Trời làm những việc này"
  },
  {
    "id": 12507,
    "book": "job                                     ",
    "chapter": "33",
    "verse": "30",
    "text": "Chúa giải cứu họ khỏi diệt vong"
  },
  {
    "id": 12508,
    "book": "job                                     ",
    "chapter": "33",
    "verse": "31",
    "text": "Xin để ý, thưa Gióp, xin lắng nghe tôi,"
  },
  {
    "id": 12509,
    "book": "job                                     ",
    "chapter": "33",
    "verse": "32",
    "text": "Nếu vẫn còn lý lẽ, xin anh cứ đưa ra,"
  },
  {
    "id": 12510,
    "book": "job                                     ",
    "chapter": "33",
    "verse": "33",
    "text": "Nhưng nếu không, xin lắng nghe tôi."
  }
]