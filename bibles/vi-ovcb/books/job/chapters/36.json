[
  {
    "id": 12564,
    "book": "job                                     ",
    "chapter": "36",
    "verse": "1",
    "text": "Ê-li-hu lại tiếp lời:"
  },
  {
    "id": 12565,
    "book": "job                                     ",
    "chapter": "36",
    "verse": "2",
    "text": "“Xin hãy kiên nhẫn, tôi sẽ tỏ cho anh sự thật."
  },
  {
    "id": 12566,
    "book": "job                                     ",
    "chapter": "36",
    "verse": "3",
    "text": "Tôi sẽ vận dụng mọi nguồn tri thức"
  },
  {
    "id": 12567,
    "book": "job                                     ",
    "chapter": "36",
    "verse": "4",
    "text": "Tôi chỉ dùng những lời chân thật,"
  },
  {
    "id": 12568,
    "book": "job                                     ",
    "chapter": "36",
    "verse": "5",
    "text": "Đức Chúa Trời thật quyền năng, Ngài không khinh bỉ một ai!"
  },
  {
    "id": 12569,
    "book": "job                                     ",
    "chapter": "36",
    "verse": "6",
    "text": "Ngài không bảo trì mạng sống kẻ ác,"
  },
  {
    "id": 12570,
    "book": "job                                     ",
    "chapter": "36",
    "verse": "7",
    "text": "Chúa chăm sóc những người công chính,"
  },
  {
    "id": 12571,
    "book": "job                                     ",
    "chapter": "36",
    "verse": "8",
    "text": "Nếu có ai mắc vòng tù tội"
  },
  {
    "id": 12572,
    "book": "job                                     ",
    "chapter": "36",
    "verse": "9",
    "text": "Ngài chỉ cho họ biết lý do,"
  },
  {
    "id": 12573,
    "book": "job                                     ",
    "chapter": "36",
    "verse": "10",
    "text": "Họ được Chúa quan tâm,"
  },
  {
    "id": 12574,
    "book": "job                                     ",
    "chapter": "36",
    "verse": "11",
    "text": "Nếu biết lắng nghe và đầu phục Đức Chúa Trời,"
  },
  {
    "id": 12575,
    "book": "job                                     ",
    "chapter": "36",
    "verse": "12",
    "text": "Nhưng nếu cứ khước từ, ngoan cố,"
  },
  {
    "id": 12576,
    "book": "job                                     ",
    "chapter": "36",
    "verse": "13",
    "text": "Lòng vô đạo tích trữ cơn thịnh nộ."
  },
  {
    "id": 12577,
    "book": "job                                     ",
    "chapter": "36",
    "verse": "14",
    "text": "Giữa chừng xuân, họ ra người thiên cổ,"
  },
  {
    "id": 12578,
    "book": "job                                     ",
    "chapter": "36",
    "verse": "15",
    "text": "Nhưng Chúa dùng tai ách cứu người gặp nạn."
  },
  {
    "id": 12579,
    "book": "job                                     ",
    "chapter": "36",
    "verse": "16",
    "text": "Đức Chúa Trời đưa anh ra khỏi nơi nguy hiểm, thưa anh Gióp,"
  },
  {
    "id": 12580,
    "book": "job                                     ",
    "chapter": "36",
    "verse": "17",
    "text": "Nhưng anh cứ biện luận điêu ngoa."
  },
  {
    "id": 12581,
    "book": "job                                     ",
    "chapter": "36",
    "verse": "18",
    "text": "Xin thận trọng, đừng để bị giàu sang lôi cuốn"
  },
  {
    "id": 12582,
    "book": "job                                     ",
    "chapter": "36",
    "verse": "19",
    "text": "Liệu tất cả của cải"
  },
  {
    "id": 12583,
    "book": "job                                     ",
    "chapter": "36",
    "verse": "20",
    "text": "Đừng mong ước đêm tối,"
  },
  {
    "id": 12584,
    "book": "job                                     ",
    "chapter": "36",
    "verse": "21",
    "text": "Xin coi chừng! Đừng tẻ bước vào đường gian ác,"
  },
  {
    "id": 12585,
    "book": "job                                     ",
    "chapter": "36",
    "verse": "22",
    "text": "“Kìa, quyền năng Đức Chúa Trời thật cao cả."
  },
  {
    "id": 12586,
    "book": "job                                     ",
    "chapter": "36",
    "verse": "23",
    "text": "Ai dám chỉ bảo Chúa phải làm gì,"
  },
  {
    "id": 12587,
    "book": "job                                     ",
    "chapter": "36",
    "verse": "24",
    "text": "Hãy nhớ tôn cao công việc quyền năng Ngài,"
  },
  {
    "id": 12588,
    "book": "job                                     ",
    "chapter": "36",
    "verse": "25",
    "text": "Mọi người đã nhìn thấy những việc này,"
  },
  {
    "id": 12589,
    "book": "job                                     ",
    "chapter": "36",
    "verse": "26",
    "text": "Kìa, Đức Chúa Trời vĩ đại hơn sự hiểu biết của chúng ta."
  },
  {
    "id": 12590,
    "book": "job                                     ",
    "chapter": "36",
    "verse": "27",
    "text": "Chúa hút các giọt nước lên trời,"
  },
  {
    "id": 12591,
    "book": "job                                     ",
    "chapter": "36",
    "verse": "28",
    "text": "Các chòm mây tuôn đổ những cơn mưa,"
  },
  {
    "id": 12592,
    "book": "job                                     ",
    "chapter": "36",
    "verse": "29",
    "text": "Ai hiểu được mây bủa giăng trên bầu trời như thế nào,"
  },
  {
    "id": 12593,
    "book": "job                                     ",
    "chapter": "36",
    "verse": "30",
    "text": "Chúa trải rộng các lằn chớp nhoáng,"
  },
  {
    "id": 12594,
    "book": "job                                     ",
    "chapter": "36",
    "verse": "31",
    "text": "Đó là cách Chúa quản trị các nước,"
  },
  {
    "id": 12595,
    "book": "job                                     ",
    "chapter": "36",
    "verse": "32",
    "text": "Tay Ngài phát ra sấm chớp"
  },
  {
    "id": 12596,
    "book": "job                                     ",
    "chapter": "36",
    "verse": "33",
    "text": "Tiếng sấm rền báo tin giông bão đến;"
  }
]