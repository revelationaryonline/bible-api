[
  {
    "id": 12548,
    "book": "job                                     ",
    "chapter": "35",
    "verse": "1",
    "text": "Ê-li-hu tiếp lời:"
  },
  {
    "id": 12549,
    "book": "job                                     ",
    "chapter": "35",
    "verse": "2",
    "text": "“Có phải anh nghĩ mình đúng khi nói rằng:"
  },
  {
    "id": 12550,
    "book": "job                                     ",
    "chapter": "35",
    "verse": "3",
    "text": "Anh thắc mắc: ‘Tôi được lợi gì?"
  },
  {
    "id": 12551,
    "book": "job                                     ",
    "chapter": "35",
    "verse": "4",
    "text": "Tôi xin trình bày cho anh biết"
  },
  {
    "id": 12552,
    "book": "job                                     ",
    "chapter": "35",
    "verse": "5",
    "text": "Xin ngước mặt lên trời, nhìn cho rõ,"
  },
  {
    "id": 12553,
    "book": "job                                     ",
    "chapter": "35",
    "verse": "6",
    "text": "Nếu anh phạm tội, có hại gì cho Đức Chúa Trời không?"
  },
  {
    "id": 12554,
    "book": "job                                     ",
    "chapter": "35",
    "verse": "7",
    "text": "Nếu anh sống công chính, thì đó có phải là tặng phẩm dâng Chúa?"
  },
  {
    "id": 12555,
    "book": "job                                     ",
    "chapter": "35",
    "verse": "8",
    "text": "Không, tội ác anh chỉ có thể hại người,"
  },
  {
    "id": 12556,
    "book": "job                                     ",
    "chapter": "35",
    "verse": "9",
    "text": "Loài người kêu ca khi bị áp bức quá nhiều."
  },
  {
    "id": 12557,
    "book": "job                                     ",
    "chapter": "35",
    "verse": "10",
    "text": "Nhưng không ai hỏi: ‘Đức Chúa Trời, Đấng tạo nên tôi,"
  },
  {
    "id": 12558,
    "book": "job                                     ",
    "chapter": "35",
    "verse": "11",
    "text": "Đấng khiến tôi thông minh hơn loài thú,"
  },
  {
    "id": 12559,
    "book": "job                                     ",
    "chapter": "35",
    "verse": "12",
    "text": "Khi họ kêu cứu, Đức Chúa Trời không đáp lại"
  },
  {
    "id": 12560,
    "book": "job                                     ",
    "chapter": "35",
    "verse": "13",
    "text": "Đức Chúa Trời không nghe lời cầu nguyện hư không"
  },
  {
    "id": 12561,
    "book": "job                                     ",
    "chapter": "35",
    "verse": "14",
    "text": "Thế mà anh dám nói anh không thấy Chúa,"
  },
  {
    "id": 12562,
    "book": "job                                     ",
    "chapter": "35",
    "verse": "15",
    "text": "Nhưng nay Chúa chưa nổi giận mà đoán phạt,"
  },
  {
    "id": 12563,
    "book": "job                                     ",
    "chapter": "35",
    "verse": "16",
    "text": "Nhưng anh cứ luôn miệng nói lời vô nghĩa, thưa anh Gióp."
  }
]