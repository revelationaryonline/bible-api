[
  {
    "id": 12692,
    "book": "job                                     ",
    "chapter": "40",
    "verse": "1",
    "text": "Chúa Hằng Hữu phán bảo Gióp:"
  },
  {
    "id": 12693,
    "book": "job                                     ",
    "chapter": "40",
    "verse": "2",
    "text": "“Phải chăng con vẫn muốn đấu lý với Đấng Toàn Năng?"
  },
  {
    "id": 12694,
    "book": "job                                     ",
    "chapter": "40",
    "verse": "3",
    "text": "Bấy giờ, Gióp kính cẩn thưa với Chúa Hằng Hữu:"
  },
  {
    "id": 12695,
    "book": "job                                     ",
    "chapter": "40",
    "verse": "4",
    "text": "“Con chẳng ra gì—làm sao con có thể tìm được lời đối đáp?"
  },
  {
    "id": 12696,
    "book": "job                                     ",
    "chapter": "40",
    "verse": "5",
    "text": "Con đã nói quá nhiều lời rồi."
  },
  {
    "id": 12697,
    "book": "job                                     ",
    "chapter": "40",
    "verse": "6",
    "text": "Lúc ấy, Chúa Hằng Hữu phán bảo Gióp trong cơn lốc:"
  },
  {
    "id": 12698,
    "book": "job                                     ",
    "chapter": "40",
    "verse": "7",
    "text": "“Con hãy nai nịt gọn gàng như dũng sĩ40:7 Nt như một người"
  },
  {
    "id": 12699,
    "book": "job                                     ",
    "chapter": "40",
    "verse": "8",
    "text": "Con dám phủ nhận công lý Ta,"
  },
  {
    "id": 12700,
    "book": "job                                     ",
    "chapter": "40",
    "verse": "9",
    "text": "Có phải con mạnh như Đức Chúa Trời?"
  },
  {
    "id": 12701,
    "book": "job                                     ",
    "chapter": "40",
    "verse": "10",
    "text": "Hãy trang sức bằng vinh quang và huy hoàng,"
  },
  {
    "id": 12702,
    "book": "job                                     ",
    "chapter": "40",
    "verse": "11",
    "text": "Hãy cho nộ khí con bùng nổ."
  },
  {
    "id": 12703,
    "book": "job                                     ",
    "chapter": "40",
    "verse": "12",
    "text": "Hãy nhận dạng và hạ nhục những kẻ kiêu căng;"
  },
  {
    "id": 12704,
    "book": "job                                     ",
    "chapter": "40",
    "verse": "13",
    "text": "Chôn vùi chúng xuống bùn đen."
  },
  {
    "id": 12705,
    "book": "job                                     ",
    "chapter": "40",
    "verse": "14",
    "text": "Lúc ấy, Ta sẽ khen ngợi con,"
  },
  {
    "id": 12706,
    "book": "job                                     ",
    "chapter": "40",
    "verse": "15",
    "text": "Con hãy nhìn con tê giác,40:15 Có người dịch ra là trâu nước"
  },
  {
    "id": 12707,
    "book": "job                                     ",
    "chapter": "40",
    "verse": "16",
    "text": "Hãy xem sức mạnh nó dồn vào hai hông"
  },
  {
    "id": 12708,
    "book": "job                                     ",
    "chapter": "40",
    "verse": "17",
    "text": "Nó quật đuôi mạnh như cây bá hương."
  },
  {
    "id": 12709,
    "book": "job                                     ",
    "chapter": "40",
    "verse": "18",
    "text": "Xương nó mạnh như ống đồng."
  },
  {
    "id": 12710,
    "book": "job                                     ",
    "chapter": "40",
    "verse": "19",
    "text": "Nó là tạo vật hàng đầu của tay Đức Chúa Trời,"
  },
  {
    "id": 12711,
    "book": "job                                     ",
    "chapter": "40",
    "verse": "20",
    "text": "Các núi đồi cung cấp lương thực cho nó,"
  },
  {
    "id": 12712,
    "book": "job                                     ",
    "chapter": "40",
    "verse": "21",
    "text": "Nó nằm nấp dưới hoa sen,"
  },
  {
    "id": 12713,
    "book": "job                                     ",
    "chapter": "40",
    "verse": "22",
    "text": "Lùm sen rậm rạp phủ bóng che,"
  },
  {
    "id": 12714,
    "book": "job                                     ",
    "chapter": "40",
    "verse": "23",
    "text": "Nó không bối rối bởi nước lụt dâng lên,"
  },
  {
    "id": 12715,
    "book": "job                                     ",
    "chapter": "40",
    "verse": "24",
    "text": "Không ai có thể dùng lưỡi câu mà bắt được,"
  }
]