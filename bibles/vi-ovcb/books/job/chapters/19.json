[
  {
    "id": 12125,
    "book": "job                                     ",
    "chapter": "19",
    "verse": "1",
    "text": "Gióp đáp:"
  },
  {
    "id": 12126,
    "book": "job                                     ",
    "chapter": "19",
    "verse": "2",
    "text": "“Các anh dày vò tôi cho đến bao giờ?"
  },
  {
    "id": 12127,
    "book": "job                                     ",
    "chapter": "19",
    "verse": "3",
    "text": "Đã mười lần các anh sỉ nhục tôi."
  },
  {
    "id": 12128,
    "book": "job                                     ",
    "chapter": "19",
    "verse": "4",
    "text": "Dù thật tôi có tội,"
  },
  {
    "id": 12129,
    "book": "job                                     ",
    "chapter": "19",
    "verse": "5",
    "text": "Các anh nghĩ các anh hơn tôi,"
  },
  {
    "id": 12130,
    "book": "job                                     ",
    "chapter": "19",
    "verse": "6",
    "text": "Xin biết rằng chính Đức Chúa Trời đánh hạ tôi,"
  },
  {
    "id": 12131,
    "book": "job                                     ",
    "chapter": "19",
    "verse": "7",
    "text": "Tôi kêu khóc: ‘Cứu tôi!’ nhưng chẳng ai thèm đáp."
  },
  {
    "id": 12132,
    "book": "job                                     ",
    "chapter": "19",
    "verse": "8",
    "text": "Đức Chúa Trời dựng rào ngăn chặn tôi tiến bước."
  },
  {
    "id": 12133,
    "book": "job                                     ",
    "chapter": "19",
    "verse": "9",
    "text": "Vinh quang tôi, Chúa tước đoạt,"
  },
  {
    "id": 12134,
    "book": "job                                     ",
    "chapter": "19",
    "verse": "10",
    "text": "Chúa nghiền tôi tứ phía, làm tôi ra điêu tàn."
  },
  {
    "id": 12135,
    "book": "job                                     ",
    "chapter": "19",
    "verse": "11",
    "text": "Lửa thịnh nộ Chúa bùng cháy;"
  },
  {
    "id": 12136,
    "book": "job                                     ",
    "chapter": "19",
    "verse": "12",
    "text": "Đại binh Chúa ùn ùn kéo tới."
  },
  {
    "id": 12137,
    "book": "job                                     ",
    "chapter": "19",
    "verse": "13",
    "text": "Do Chúa khiến, anh em đều xa lánh,"
  },
  {
    "id": 12138,
    "book": "job                                     ",
    "chapter": "19",
    "verse": "14",
    "text": "Gia đình tôi bỏ rơi không thèm ngó,"
  },
  {
    "id": 12139,
    "book": "job                                     ",
    "chapter": "19",
    "verse": "15",
    "text": "Đầy tớ nam lẫn nữ kể tôi là khách lạ."
  },
  {
    "id": 12140,
    "book": "job                                     ",
    "chapter": "19",
    "verse": "16",
    "text": "Tôi gọi đầy tớ mình, nó không đến;"
  },
  {
    "id": 12141,
    "book": "job                                     ",
    "chapter": "19",
    "verse": "17",
    "text": "Hơi thở tôi, vợ tôi không chịu nổi."
  },
  {
    "id": 12142,
    "book": "job                                     ",
    "chapter": "19",
    "verse": "18",
    "text": "Cả bọn trẻ con cũng khinh tôi."
  },
  {
    "id": 12143,
    "book": "job                                     ",
    "chapter": "19",
    "verse": "19",
    "text": "Các bạn thân đều gớm ghiếc tôi,"
  },
  {
    "id": 12144,
    "book": "job                                     ",
    "chapter": "19",
    "verse": "20",
    "text": "Thân thể tôi chỉ còn da bọc xương,"
  },
  {
    "id": 12145,
    "book": "job                                     ",
    "chapter": "19",
    "verse": "21",
    "text": "Hãy thương xót tôi, các bạn ơi, xin thương xót,"
  },
  {
    "id": 12146,
    "book": "job                                     ",
    "chapter": "19",
    "verse": "22",
    "text": "Sao các anh săn đuổi tôi như Đức Chúa Trời?"
  },
  {
    "id": 12147,
    "book": "job                                     ",
    "chapter": "19",
    "verse": "23",
    "text": "Ôi, ước gì các lời tôi được ghi lại"
  },
  {
    "id": 12148,
    "book": "job                                     ",
    "chapter": "19",
    "verse": "24",
    "text": "được chạm với bút bằng sắt, bằng chì,"
  },
  {
    "id": 12149,
    "book": "job                                     ",
    "chapter": "19",
    "verse": "25",
    "text": "Vì tôi biết Đấng Cứu Chuộc tôi vẫn sống,"
  },
  {
    "id": 12150,
    "book": "job                                     ",
    "chapter": "19",
    "verse": "26",
    "text": "Mặc dù thân thể tôi rữa nát,"
  },
  {
    "id": 12151,
    "book": "job                                     ",
    "chapter": "19",
    "verse": "27",
    "text": "Chính tôi sẽ thấy Ngài."
  },
  {
    "id": 12152,
    "book": "job                                     ",
    "chapter": "19",
    "verse": "28",
    "text": "Sao các anh dám hành hạ tôi,"
  },
  {
    "id": 12153,
    "book": "job                                     ",
    "chapter": "19",
    "verse": "29",
    "text": "Các anh hãy coi chừng lưỡi gươm,"
  }
]