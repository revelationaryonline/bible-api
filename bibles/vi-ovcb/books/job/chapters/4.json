[
  {
    "id": 11758,
    "book": "job                                     ",
    "chapter": "4",
    "verse": "1",
    "text": "Ê-li-pha, người Thê-man, đáp lời Gióp:"
  },
  {
    "id": 11759,
    "book": "job                                     ",
    "chapter": "4",
    "verse": "2",
    "text": "“Anh có thể kiên nhẫn để nghe tôi nói vài lời chứ?"
  },
  {
    "id": 11760,
    "book": "job                                     ",
    "chapter": "4",
    "verse": "3",
    "text": "Bấy lâu nay anh từng khuyên dạy nhiều người;"
  },
  {
    "id": 11761,
    "book": "job                                     ",
    "chapter": "4",
    "verse": "4",
    "text": "Lời anh nói đã nâng đỡ người bị vấp ngã;"
  },
  {
    "id": 11762,
    "book": "job                                     ",
    "chapter": "4",
    "verse": "5",
    "text": "Nhưng nay khi tai họa xảy ra, anh đã nản lòng."
  },
  {
    "id": 11763,
    "book": "job                                     ",
    "chapter": "4",
    "verse": "6",
    "text": "Chẳng phải lòng kính sợ Đức Chúa Trời giúp anh tự tin sao?"
  },
  {
    "id": 11764,
    "book": "job                                     ",
    "chapter": "4",
    "verse": "7",
    "text": "Hãy dừng lại và suy nghĩ! Có người vô tội nào bị chết mất không?"
  },
  {
    "id": 11765,
    "book": "job                                     ",
    "chapter": "4",
    "verse": "8",
    "text": "Theo như tôi thấy chỉ những ai trồng tai họa"
  },
  {
    "id": 11766,
    "book": "job                                     ",
    "chapter": "4",
    "verse": "9",
    "text": "Họ tiêu tan trước hơi thở của Đức Chúa Trời."
  },
  {
    "id": 11767,
    "book": "job                                     ",
    "chapter": "4",
    "verse": "10",
    "text": "Tiếng gầm thét hung hăng của sư tử im bặt,"
  },
  {
    "id": 11768,
    "book": "job                                     ",
    "chapter": "4",
    "verse": "11",
    "text": "Sư tử hung mạnh sẽ chết vì thiếu mồi,"
  },
  {
    "id": 11769,
    "book": "job                                     ",
    "chapter": "4",
    "verse": "12",
    "text": "Một sự thật đến với tôi trong bí mật,"
  },
  {
    "id": 11770,
    "book": "job                                     ",
    "chapter": "4",
    "verse": "13",
    "text": "Nó đến với tôi trong khải tượng lo âu lúc đêm khuya"
  },
  {
    "id": 11771,
    "book": "job                                     ",
    "chapter": "4",
    "verse": "14",
    "text": "Nỗi sợ hãi kềm chặt tôi,"
  },
  {
    "id": 11772,
    "book": "job                                     ",
    "chapter": "4",
    "verse": "15",
    "text": "Có một vị thần đi ngang qua mặt tôi,"
  },
  {
    "id": 11773,
    "book": "job                                     ",
    "chapter": "4",
    "verse": "16",
    "text": "Thần dừng lại, nhưng tôi không thấy rõ dạng hình."
  },
  {
    "id": 11774,
    "book": "job                                     ",
    "chapter": "4",
    "verse": "17",
    "text": "‘Người phàm có thể công chính trước mặt Đức Chúa Trời chăng?"
  },
  {
    "id": 11775,
    "book": "job                                     ",
    "chapter": "4",
    "verse": "18",
    "text": "Nếu Đức Chúa Trời không tin tưởng các thiên sứ của Ngài,"
  },
  {
    "id": 11776,
    "book": "job                                     ",
    "chapter": "4",
    "verse": "19",
    "text": "thì làm sao Ngài tin được vào loài người vốn được tạo nên bằng đất sét!"
  },
  {
    "id": 11777,
    "book": "job                                     ",
    "chapter": "4",
    "verse": "20",
    "text": "Họ sống buổi rạng đông và chết mất lúc hoàng hôn,"
  },
  {
    "id": 11778,
    "book": "job                                     ",
    "chapter": "4",
    "verse": "21",
    "text": "Dây lều của họ bị kéo đứt và lều sụp xuống,"
  }
]