[
  {
    "id": 12066,
    "book": "job                                     ",
    "chapter": "16",
    "verse": "1",
    "text": "Gióp đáp rằng:"
  },
  {
    "id": 12067,
    "book": "job                                     ",
    "chapter": "16",
    "verse": "2",
    "text": "“Tôi đã nghe những lời này trước đó."
  },
  {
    "id": 12068,
    "book": "job                                     ",
    "chapter": "16",
    "verse": "3",
    "text": "Lời vô bổ đến chừng nào mới dứt?"
  },
  {
    "id": 12069,
    "book": "job                                     ",
    "chapter": "16",
    "verse": "4",
    "text": "Tôi cũng nói như vậy nếu các anh ở trong hoàn cảnh của tôi."
  },
  {
    "id": 12070,
    "book": "job                                     ",
    "chapter": "16",
    "verse": "5",
    "text": "Nhưng nếu là tôi, tôi sẽ nói lời khích lệ các anh."
  },
  {
    "id": 12071,
    "book": "job                                     ",
    "chapter": "16",
    "verse": "6",
    "text": "Dù lên tiếng, khổ đau tôi nào thuyên giảm,"
  },
  {
    "id": 12072,
    "book": "job                                     ",
    "chapter": "16",
    "verse": "7",
    "text": "Nhưng tay Đức Chúa Trời khiến thân tôi mòn mỏi,"
  },
  {
    "id": 12073,
    "book": "job                                     ",
    "chapter": "16",
    "verse": "8",
    "text": "Để chứng tỏ tôi có tội, Chúa làm da tôi nhăn, thân tôi gầy."
  },
  {
    "id": 12074,
    "book": "job                                     ",
    "chapter": "16",
    "verse": "9",
    "text": "Đức Chúa Trời ghét tôi và giận dữ xé tôi từng phần."
  },
  {
    "id": 12075,
    "book": "job                                     ",
    "chapter": "16",
    "verse": "10",
    "text": "Người ta chế giễu và cười nhạo tôi."
  },
  {
    "id": 12076,
    "book": "job                                     ",
    "chapter": "16",
    "verse": "11",
    "text": "Đức Chúa Trời giải nạp tôi cho người tội lỗi."
  },
  {
    "id": 12077,
    "book": "job                                     ",
    "chapter": "16",
    "verse": "12",
    "text": "Tôi đang yên vui bỗng bị Ngài vùi dập,"
  },
  {
    "id": 12078,
    "book": "job                                     ",
    "chapter": "16",
    "verse": "13",
    "text": "các xạ thủ Ngài vây quanh tôi."
  },
  {
    "id": 12079,
    "book": "job                                     ",
    "chapter": "16",
    "verse": "14",
    "text": "Chúa liên tiếp gây bao thương tích,"
  },
  {
    "id": 12080,
    "book": "job                                     ",
    "chapter": "16",
    "verse": "15",
    "text": "Tôi mặc áo vải gai để tỏ bày sầu khổ."
  },
  {
    "id": 12081,
    "book": "job                                     ",
    "chapter": "16",
    "verse": "16",
    "text": "Mắt tôi đỏ bừng vì khóc lóc;"
  },
  {
    "id": 12082,
    "book": "job                                     ",
    "chapter": "16",
    "verse": "17",
    "text": "Dù tôi không làm điều gì sai trái,"
  },
  {
    "id": 12083,
    "book": "job                                     ",
    "chapter": "16",
    "verse": "18",
    "text": "Hỡi đất, đừng che lấp máu tôi."
  },
  {
    "id": 12084,
    "book": "job                                     ",
    "chapter": "16",
    "verse": "19",
    "text": "Dù bây giờ Đấng làm chứng cho tôi ở trên trời."
  },
  {
    "id": 12085,
    "book": "job                                     ",
    "chapter": "16",
    "verse": "20",
    "text": "Khi bạn bè thân yêu chế nhạo tôi,"
  },
  {
    "id": 12086,
    "book": "job                                     ",
    "chapter": "16",
    "verse": "21",
    "text": "Tôi cần một người biện hộ giữa Đức Chúa Trời và tôi,"
  },
  {
    "id": 12087,
    "book": "job                                     ",
    "chapter": "16",
    "verse": "22",
    "text": "Vì chẳng bao lâu tôi sẽ đi con đường,"
  }
]