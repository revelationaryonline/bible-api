[
  {
    "id": 11879,
    "book": "job                                     ",
    "chapter": "9",
    "verse": "1",
    "text": "Bấy giờ Gióp trả lời:"
  },
  {
    "id": 11880,
    "book": "job                                     ",
    "chapter": "9",
    "verse": "2",
    "text": "“Phải, tôi biết mọi điều này là đúng."
  },
  {
    "id": 11881,
    "book": "job                                     ",
    "chapter": "9",
    "verse": "3",
    "text": "Nếu có ai muốn tranh luận với Đức Chúa Trời,"
  },
  {
    "id": 11882,
    "book": "job                                     ",
    "chapter": "9",
    "verse": "4",
    "text": "Vì Đức Chúa Trời khôn ngoan và mạnh mẽ vô cùng."
  },
  {
    "id": 11883,
    "book": "job                                     ",
    "chapter": "9",
    "verse": "5",
    "text": "Chúa dời núi, núi không hay biết,"
  },
  {
    "id": 11884,
    "book": "job                                     ",
    "chapter": "9",
    "verse": "6",
    "text": "Chính tay Chúa làm rung chuyển đất,"
  },
  {
    "id": 11885,
    "book": "job                                     ",
    "chapter": "9",
    "verse": "7",
    "text": "Nếu Chúa ra lệnh, mặt trời sẽ không mọc"
  },
  {
    "id": 11886,
    "book": "job                                     ",
    "chapter": "9",
    "verse": "8",
    "text": "Chỉ một mình Chúa giăng trải các tầng trời"
  },
  {
    "id": 11887,
    "book": "job                                     ",
    "chapter": "9",
    "verse": "9",
    "text": "Ngài tạo dựng tất cả vì sao—sao Bắc Đẩu và sao Thiên Lang,"
  },
  {
    "id": 11888,
    "book": "job                                     ",
    "chapter": "9",
    "verse": "10",
    "text": "Chúa làm những việc vĩ đại, không sao hiểu thấu."
  },
  {
    "id": 11889,
    "book": "job                                     ",
    "chapter": "9",
    "verse": "11",
    "text": "Chúa đến gần, tôi không thể thấy."
  },
  {
    "id": 11890,
    "book": "job                                     ",
    "chapter": "9",
    "verse": "12",
    "text": "Nếu Chúa bắt ai phải chết, ai dám ngăn lại?"
  },
  {
    "id": 11891,
    "book": "job                                     ",
    "chapter": "9",
    "verse": "13",
    "text": "Vì Đức Chúa Trời không ngừng cơn thịnh nộ."
  },
  {
    "id": 11892,
    "book": "job                                     ",
    "chapter": "9",
    "verse": "14",
    "text": "Vậy tôi là ai mà dám đối đáp cùng Đức Chúa Trời"
  },
  {
    "id": 11893,
    "book": "job                                     ",
    "chapter": "9",
    "verse": "15",
    "text": "Nếu tôi đúng, tôi cũng không dám nói."
  },
  {
    "id": 11894,
    "book": "job                                     ",
    "chapter": "9",
    "verse": "16",
    "text": "Dù nếu tôi cầu xin và được Chúa đáp lời,"
  },
  {
    "id": 11895,
    "book": "job                                     ",
    "chapter": "9",
    "verse": "17",
    "text": "Vì Ngài diệt tôi trong bão tố"
  },
  {
    "id": 11896,
    "book": "job                                     ",
    "chapter": "9",
    "verse": "18",
    "text": "Ngài không cho tôi kịp lấy lại hơi thở,"
  },
  {
    "id": 11897,
    "book": "job                                     ",
    "chapter": "9",
    "verse": "19",
    "text": "Nếu hỏi về năng lực, Ngài là Đấng mạnh mẽ."
  },
  {
    "id": 11898,
    "book": "job                                     ",
    "chapter": "9",
    "verse": "20",
    "text": "Dù tôi vô tội, chính miệng tôi sẽ lên án tôi có tội."
  },
  {
    "id": 11899,
    "book": "job                                     ",
    "chapter": "9",
    "verse": "21",
    "text": "Dù tôi vô tội,"
  },
  {
    "id": 11900,
    "book": "job                                     ",
    "chapter": "9",
    "verse": "22",
    "text": "Người vô tội hay người gian ác, tất cả đều như nhau trước mặt Đức Chúa Trời."
  },
  {
    "id": 11901,
    "book": "job                                     ",
    "chapter": "9",
    "verse": "23",
    "text": "Khi tai họa quét ngang,"
  },
  {
    "id": 11902,
    "book": "job                                     ",
    "chapter": "9",
    "verse": "24",
    "text": "Khi đất nước rơi vào tay kẻ ác,"
  },
  {
    "id": 11903,
    "book": "job                                     ",
    "chapter": "9",
    "verse": "25",
    "text": "Ngày đời con qua mau hơn người chạy."
  },
  {
    "id": 11904,
    "book": "job                                     ",
    "chapter": "9",
    "verse": "26",
    "text": "Nó lướt nhanh như thuyền nan,"
  },
  {
    "id": 11905,
    "book": "job                                     ",
    "chapter": "9",
    "verse": "27",
    "text": "Nếu con quyết định không than phiền trách móc,"
  },
  {
    "id": 11906,
    "book": "job                                     ",
    "chapter": "9",
    "verse": "28",
    "text": "con cũng phải nhận thêm nhiều đau khổ,"
  },
  {
    "id": 11907,
    "book": "job                                     ",
    "chapter": "9",
    "verse": "29",
    "text": "Con sẽ bị kết án."
  },
  {
    "id": 11908,
    "book": "job                                     ",
    "chapter": "9",
    "verse": "30",
    "text": "Ngay cả nếu con tắm trong tuyết"
  },
  {
    "id": 11909,
    "book": "job                                     ",
    "chapter": "9",
    "verse": "31",
    "text": "thì Chúa cũng dìm con xuống hố bùn,"
  },
  {
    "id": 11910,
    "book": "job                                     ",
    "chapter": "9",
    "verse": "32",
    "text": "Đức Chúa Trời đâu phải là loài người như con,"
  },
  {
    "id": 11911,
    "book": "job                                     ",
    "chapter": "9",
    "verse": "33",
    "text": "Ước gì có người trung gian giữa Chúa với con,"
  },
  {
    "id": 11912,
    "book": "job                                     ",
    "chapter": "9",
    "verse": "34",
    "text": "Người trung gian có thể can ngăn Đức Chúa Trời thôi đánh con,"
  },
  {
    "id": 11913,
    "book": "job                                     ",
    "chapter": "9",
    "verse": "35",
    "text": "Bấy giờ con có thể thưa chuyện với Ngài không sợ sệt,"
  }
]