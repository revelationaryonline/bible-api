[
  {
    "id": 12360,
    "book": "job                                     ",
    "chapter": "29",
    "verse": "1",
    "text": "Gióp tiếp lời:"
  },
  {
    "id": 12361,
    "book": "job                                     ",
    "chapter": "29",
    "verse": "2",
    "text": "“Ước gì tôi được trở về những ngày tháng trước,"
  },
  {
    "id": 12362,
    "book": "job                                     ",
    "chapter": "29",
    "verse": "3",
    "text": "khi ngọn đèn Chúa còn soi sáng trên đầu tôi"
  },
  {
    "id": 12363,
    "book": "job                                     ",
    "chapter": "29",
    "verse": "4",
    "text": "Khi tôi còn tráng kiện29:4 Ctd trong ngày gặt hái"
  },
  {
    "id": 12364,
    "book": "job                                     ",
    "chapter": "29",
    "verse": "5",
    "text": "Khi Đấng Toàn Năng còn ở với tôi,"
  },
  {
    "id": 12365,
    "book": "job                                     ",
    "chapter": "29",
    "verse": "6",
    "text": "Khi lối tôi đi ngập kem sữa,"
  },
  {
    "id": 12366,
    "book": "job                                     ",
    "chapter": "29",
    "verse": "7",
    "text": "Thời ấy, khi tôi ra cổng thành"
  },
  {
    "id": 12367,
    "book": "job                                     ",
    "chapter": "29",
    "verse": "8",
    "text": "Người trẻ tuổi đứng sang một bên khi thấy tôi,"
  },
  {
    "id": 12368,
    "book": "job                                     ",
    "chapter": "29",
    "verse": "9",
    "text": "Các hoàng tử đứng lên im tiếng,"
  },
  {
    "id": 12369,
    "book": "job                                     ",
    "chapter": "29",
    "verse": "10",
    "text": "Các quan chức cao của thành đứng yên lặng,"
  },
  {
    "id": 12370,
    "book": "job                                     ",
    "chapter": "29",
    "verse": "11",
    "text": "Ai nghe tôi nói đều khen ngợi,"
  },
  {
    "id": 12371,
    "book": "job                                     ",
    "chapter": "29",
    "verse": "12",
    "text": "Vì tôi giải cứu người nghèo khổ khi họ cần đến,"
  },
  {
    "id": 12372,
    "book": "job                                     ",
    "chapter": "29",
    "verse": "13",
    "text": "Những người đang hấp hối cũng chúc tụng tôi."
  },
  {
    "id": 12373,
    "book": "job                                     ",
    "chapter": "29",
    "verse": "14",
    "text": "Mọi thứ tôi làm là chân thật."
  },
  {
    "id": 12374,
    "book": "job                                     ",
    "chapter": "29",
    "verse": "15",
    "text": "Tôi là mắt cho người mù"
  },
  {
    "id": 12375,
    "book": "job                                     ",
    "chapter": "29",
    "verse": "16",
    "text": "Tôi là cha của người nghèo khó,"
  },
  {
    "id": 12376,
    "book": "job                                     ",
    "chapter": "29",
    "verse": "17",
    "text": "Tôi bẻ nanh vuốt bọn gian manh vô đạo"
  },
  {
    "id": 12377,
    "book": "job                                     ",
    "chapter": "29",
    "verse": "18",
    "text": "Tôi tự bảo: ‘Chắc tôi sẽ được chết trong nhà tôi,"
  },
  {
    "id": 12378,
    "book": "job                                     ",
    "chapter": "29",
    "verse": "19",
    "text": "Vì tôi như rễ sẽ ăn ra cho đến dòng nước,"
  },
  {
    "id": 12379,
    "book": "job                                     ",
    "chapter": "29",
    "verse": "20",
    "text": "Vinh quang tôi sẽ mãi sáng chói trong tôi,"
  },
  {
    "id": 12380,
    "book": "job                                     ",
    "chapter": "29",
    "verse": "21",
    "text": "Mọi người lắng tai nghe ý kiến tôi."
  },
  {
    "id": 12381,
    "book": "job                                     ",
    "chapter": "29",
    "verse": "22",
    "text": "Sau khi tôi nói, họ không còn gì để thêm,"
  },
  {
    "id": 12382,
    "book": "job                                     ",
    "chapter": "29",
    "verse": "23",
    "text": "Họ mong tôi nói như người ta đợi mưa."
  },
  {
    "id": 12383,
    "book": "job                                     ",
    "chapter": "29",
    "verse": "24",
    "text": "Khi họ nản lòng tôi cười với họ."
  },
  {
    "id": 12384,
    "book": "job                                     ",
    "chapter": "29",
    "verse": "25",
    "text": "Như một thủ lãnh, tôi chỉ dẫn điều họ phải làm."
  }
]