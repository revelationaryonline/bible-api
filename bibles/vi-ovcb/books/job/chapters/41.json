[
  {
    "id": 12716,
    "book": "job                                     ",
    "chapter": "41",
    "verse": "1",
    "text": "“Con có thể bắt Lê-vi-a-than41:1 Đây là con quái vật trong truyền thuyết phương Đông  bằng móc câu"
  },
  {
    "id": 12717,
    "book": "job                                     ",
    "chapter": "41",
    "verse": "2",
    "text": "Con có thể dùng dây bện bằng sậy mà xâu mũi,"
  },
  {
    "id": 12718,
    "book": "job                                     ",
    "chapter": "41",
    "verse": "3",
    "text": "Lẽ nào nó sẽ không xin con thương xót"
  },
  {
    "id": 12719,
    "book": "job                                     ",
    "chapter": "41",
    "verse": "4",
    "text": "Nó có bằng lòng lập giao ước với con,"
  },
  {
    "id": 12720,
    "book": "job                                     ",
    "chapter": "41",
    "verse": "5",
    "text": "Con có dám chơi với nó như loài chim,"
  },
  {
    "id": 12721,
    "book": "job                                     ",
    "chapter": "41",
    "verse": "6",
    "text": "Bạn bè con có mặc cả với nhau mua bán nó,"
  },
  {
    "id": 12722,
    "book": "job                                     ",
    "chapter": "41",
    "verse": "7",
    "text": "Con có thể lấy sắt có ngạnh cắm đầy mình nó,"
  },
  {
    "id": 12723,
    "book": "job                                     ",
    "chapter": "41",
    "verse": "8",
    "text": "Nếu con thử nắm lấy nó,"
  },
  {
    "id": 12724,
    "book": "job                                     ",
    "chapter": "41",
    "verse": "9",
    "text": "Kìa trước mặt nó, hy vọng liền tan biến."
  },
  {
    "id": 12725,
    "book": "job                                     ",
    "chapter": "41",
    "verse": "10",
    "text": "Không có ai dám trêu chọc thủy quái,"
  },
  {
    "id": 12726,
    "book": "job                                     ",
    "chapter": "41",
    "verse": "11",
    "text": "Ai cho Ta vay mượn để đòi Ta hoàn trả?"
  },
  {
    "id": 12727,
    "book": "job                                     ",
    "chapter": "41",
    "verse": "12",
    "text": "Ta phải nhắc đến sức mạnh nó,"
  },
  {
    "id": 12728,
    "book": "job                                     ",
    "chapter": "41",
    "verse": "13",
    "text": "Ai dám thử lột bộ da nó,"
  },
  {
    "id": 12729,
    "book": "job                                     ",
    "chapter": "41",
    "verse": "14",
    "text": "Ai dám cạy miệng nó ra?"
  },
  {
    "id": 12730,
    "book": "job                                     ",
    "chapter": "41",
    "verse": "15",
    "text": "Vảy trên lưng nó sắp lớp giống một hàng khiên,"
  },
  {
    "id": 12731,
    "book": "job                                     ",
    "chapter": "41",
    "verse": "16",
    "text": "Chúng khớp chặt với nhau,"
  },
  {
    "id": 12732,
    "book": "job                                     ",
    "chapter": "41",
    "verse": "17",
    "text": "Chúng kết dính vào nhau, bám sát lấy nhau."
  },
  {
    "id": 12733,
    "book": "job                                     ",
    "chapter": "41",
    "verse": "18",
    "text": "Nó nhảy mũi, lóe ra tia sáng!"
  },
  {
    "id": 12734,
    "book": "job                                     ",
    "chapter": "41",
    "verse": "19",
    "text": "Miệng nó phun ngọn lửa cháy như đuốc;"
  },
  {
    "id": 12735,
    "book": "job                                     ",
    "chapter": "41",
    "verse": "20",
    "text": "Khói xông lên nghi ngút từ lỗ mũi,"
  },
  {
    "id": 12736,
    "book": "job                                     ",
    "chapter": "41",
    "verse": "21",
    "text": "Hơi thở nó nhóm lửa cho than cháy rực,"
  },
  {
    "id": 12737,
    "book": "job                                     ",
    "chapter": "41",
    "verse": "22",
    "text": "Cổ nó chứa đầy năng lực,"
  },
  {
    "id": 12738,
    "book": "job                                     ",
    "chapter": "41",
    "verse": "23",
    "text": "Các bắp thịt nó cứng và chắc nịch,"
  },
  {
    "id": 12739,
    "book": "job                                     ",
    "chapter": "41",
    "verse": "24",
    "text": "Quả tim nó cứng như đá,"
  },
  {
    "id": 12740,
    "book": "job                                     ",
    "chapter": "41",
    "verse": "25",
    "text": "Khi nó đứng dậy, dũng sĩ liền khiếp đảm,"
  },
  {
    "id": 12741,
    "book": "job                                     ",
    "chapter": "41",
    "verse": "26",
    "text": "Không kiếm nào có thể chém đứt,"
  },
  {
    "id": 12742,
    "book": "job                                     ",
    "chapter": "41",
    "verse": "27",
    "text": "Cây sắt trở thành cọng rơm"
  },
  {
    "id": 12743,
    "book": "job                                     ",
    "chapter": "41",
    "verse": "28",
    "text": "Trước cung tên nó không hề chạy trốn."
  },
  {
    "id": 12744,
    "book": "job                                     ",
    "chapter": "41",
    "verse": "29",
    "text": "Còn phi tiêu nó coi như cỏ rác"
  },
  {
    "id": 12745,
    "book": "job                                     ",
    "chapter": "41",
    "verse": "30",
    "text": "Vảy bụng nó nhọn bén như mảnh sành."
  },
  {
    "id": 12746,
    "book": "job                                     ",
    "chapter": "41",
    "verse": "31",
    "text": "Nó khuấy động vực thẳm như nồi nước sôi sục."
  },
  {
    "id": 12747,
    "book": "job                                     ",
    "chapter": "41",
    "verse": "32",
    "text": "Nó đi qua còn để lại hào quang,"
  },
  {
    "id": 12748,
    "book": "job                                     ",
    "chapter": "41",
    "verse": "33",
    "text": "Khắp địa cầu, không sinh vật nào sánh kịp,"
  },
  {
    "id": 12749,
    "book": "job                                     ",
    "chapter": "41",
    "verse": "34",
    "text": "Nó khinh dể những giống thú cao lớn."
  }
]