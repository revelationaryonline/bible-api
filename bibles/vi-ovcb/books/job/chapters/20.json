[
  {
    "id": 12154,
    "book": "job                                     ",
    "chapter": "20",
    "verse": "1",
    "text": "Sô-pha, người Na-a-ma, đáp:"
  },
  {
    "id": 12155,
    "book": "job                                     ",
    "chapter": "20",
    "verse": "2",
    "text": "“Tôi phải trả lời"
  },
  {
    "id": 12156,
    "book": "job                                     ",
    "chapter": "20",
    "verse": "3",
    "text": "Tôi đã nghe lời trách móc sỉ nhục tôi,"
  },
  {
    "id": 12157,
    "book": "job                                     ",
    "chapter": "20",
    "verse": "4",
    "text": "Anh có biết: Từ thuở khai thiên lập địa"
  },
  {
    "id": 12158,
    "book": "job                                     ",
    "chapter": "20",
    "verse": "5",
    "text": "kẻ ác dù có hân hoan chỉ tạm thời,"
  },
  {
    "id": 12159,
    "book": "job                                     ",
    "chapter": "20",
    "verse": "6",
    "text": "Dù kiêu hãnh của nó lên đến tận trời"
  },
  {
    "id": 12160,
    "book": "job                                     ",
    "chapter": "20",
    "verse": "7",
    "text": "nó cũng sẽ bị tiêu diệt đời đời,"
  },
  {
    "id": 12161,
    "book": "job                                     ",
    "chapter": "20",
    "verse": "8",
    "text": "Nó tiêu tan như giấc mơ."
  },
  {
    "id": 12162,
    "book": "job                                     ",
    "chapter": "20",
    "verse": "9",
    "text": "Vừa thấy đó, nó liền mất hút."
  },
  {
    "id": 12163,
    "book": "job                                     ",
    "chapter": "20",
    "verse": "10",
    "text": "Con cái nó sẽ xin ân huệ từ người nghèo khổ,"
  },
  {
    "id": 12164,
    "book": "job                                     ",
    "chapter": "20",
    "verse": "11",
    "text": "Xương cốt nó đầy sinh lực thanh xuân,"
  },
  {
    "id": 12165,
    "book": "job                                     ",
    "chapter": "20",
    "verse": "12",
    "text": "Dù miệng nó cho tội ác là ngọt bùi,"
  },
  {
    "id": 12166,
    "book": "job                                     ",
    "chapter": "20",
    "verse": "13",
    "text": "Dẫu nó cưu mang tội ác, không lìa bỏ,"
  },
  {
    "id": 12167,
    "book": "job                                     ",
    "chapter": "20",
    "verse": "14",
    "text": "Thức ăn nó nuốt vào bụng sẽ sình thối,"
  },
  {
    "id": 12168,
    "book": "job                                     ",
    "chapter": "20",
    "verse": "15",
    "text": "Nó nuốt của cải vào rồi phải mửa ra."
  },
  {
    "id": 12169,
    "book": "job                                     ",
    "chapter": "20",
    "verse": "16",
    "text": "Nó sẽ mút nọc độc rắn hổ."
  },
  {
    "id": 12170,
    "book": "job                                     ",
    "chapter": "20",
    "verse": "17",
    "text": "Nó chẳng bao giờ được thấy các dòng sông dầu ô-liu"
  },
  {
    "id": 12171,
    "book": "job                                     ",
    "chapter": "20",
    "verse": "18",
    "text": "Những gì nó bon chen kiếm được phải trả lại."
  },
  {
    "id": 12172,
    "book": "job                                     ",
    "chapter": "20",
    "verse": "19",
    "text": "Vì nó áp bức và bỏ bê người nghèo khổ."
  },
  {
    "id": 12173,
    "book": "job                                     ",
    "chapter": "20",
    "verse": "20",
    "text": "Nó luôn tham lam và không bao giờ thấy đủ."
  },
  {
    "id": 12174,
    "book": "job                                     ",
    "chapter": "20",
    "verse": "21",
    "text": "Chẳng thứ gì còn sót lại khi nó đã ăn."
  },
  {
    "id": 12175,
    "book": "job                                     ",
    "chapter": "20",
    "verse": "22",
    "text": "Đang dư dật, nó bỗng ra túng ngặt"
  },
  {
    "id": 12176,
    "book": "job                                     ",
    "chapter": "20",
    "verse": "23",
    "text": "Đức Chúa Trời trút lên nó cơn thịnh nộ."
  },
  {
    "id": 12177,
    "book": "job                                     ",
    "chapter": "20",
    "verse": "24",
    "text": "Dù nó thoát khỏi gươm giáo sắt,"
  },
  {
    "id": 12178,
    "book": "job                                     ",
    "chapter": "20",
    "verse": "25",
    "text": "Khi rút mũi tên ra khỏi người nó,"
  },
  {
    "id": 12179,
    "book": "job                                     ",
    "chapter": "20",
    "verse": "26",
    "text": "Tối tăm mờ mịt rình rập tài sản nó."
  },
  {
    "id": 12180,
    "book": "job                                     ",
    "chapter": "20",
    "verse": "27",
    "text": "Tội ác nó các tầng trời tố giác,"
  },
  {
    "id": 12181,
    "book": "job                                     ",
    "chapter": "20",
    "verse": "28",
    "text": "Một cơn lũ cuốn trôi nhà nó với của cải."
  },
  {
    "id": 12182,
    "book": "job                                     ",
    "chapter": "20",
    "verse": "29",
    "text": "Số phận ấy Đức Chúa Trời đã dành cho kẻ ác."
  }
]