[
  {
    "id": 12662,
    "book": "job                                     ",
    "chapter": "39",
    "verse": "1",
    "text": "“Con có biết mùa nào dê rừng sinh nở?"
  },
  {
    "id": 12663,
    "book": "job                                     ",
    "chapter": "39",
    "verse": "2",
    "text": "Con có biết chúng mang thai mấy tháng?"
  },
  {
    "id": 12664,
    "book": "job                                     ",
    "chapter": "39",
    "verse": "3",
    "text": "Rồi chúng cúi mình sinh đàn con nhỏ,"
  },
  {
    "id": 12665,
    "book": "job                                     ",
    "chapter": "39",
    "verse": "4",
    "text": "Đàn con lớn lên giữa đồng hoang,"
  },
  {
    "id": 12666,
    "book": "job                                     ",
    "chapter": "39",
    "verse": "5",
    "text": "Ai cho lừa rừng được tự do?"
  },
  {
    "id": 12667,
    "book": "job                                     ",
    "chapter": "39",
    "verse": "6",
    "text": "Ta ban cho nó hoang mạc làm nhà;"
  },
  {
    "id": 12668,
    "book": "job                                     ",
    "chapter": "39",
    "verse": "7",
    "text": "Ồn ào đô thị nó cười chê,"
  },
  {
    "id": 12669,
    "book": "job                                     ",
    "chapter": "39",
    "verse": "8",
    "text": "Các ngọn núi nó coi là đồng cỏ,"
  },
  {
    "id": 12670,
    "book": "job                                     ",
    "chapter": "39",
    "verse": "9",
    "text": "Bò rừng có bao giờ phục vụ con?"
  },
  {
    "id": 12671,
    "book": "job                                     ",
    "chapter": "39",
    "verse": "10",
    "text": "Bò rừng có chịu cho con cột vào cày không?"
  },
  {
    "id": 12672,
    "book": "job                                     ",
    "chapter": "39",
    "verse": "11",
    "text": "Mặc dù sức nó mạnh, nhưng con có tin cậy không?"
  },
  {
    "id": 12673,
    "book": "job                                     ",
    "chapter": "39",
    "verse": "12",
    "text": "Con có tin rằng nó sẽ trở lại,"
  },
  {
    "id": 12674,
    "book": "job                                     ",
    "chapter": "39",
    "verse": "13",
    "text": "Đà điểu đập cánh oai hùng,"
  },
  {
    "id": 12675,
    "book": "job                                     ",
    "chapter": "39",
    "verse": "14",
    "text": "Vì nó bỏ mặc trứng mình dưới đất,"
  },
  {
    "id": 12676,
    "book": "job                                     ",
    "chapter": "39",
    "verse": "15",
    "text": "Nó không lo lắng có một bàn chân có thể đạp trúng"
  },
  {
    "id": 12677,
    "book": "job                                     ",
    "chapter": "39",
    "verse": "16",
    "text": "Đà điểu thật tàn nhẫn với đàn con,"
  },
  {
    "id": 12678,
    "book": "job                                     ",
    "chapter": "39",
    "verse": "17",
    "text": "Vì Đức Chúa Trời tước đi sự khôn ngoan của nó."
  },
  {
    "id": 12679,
    "book": "job                                     ",
    "chapter": "39",
    "verse": "18",
    "text": "Nhưng bất cứ khi nào nó phóng chạy,"
  },
  {
    "id": 12680,
    "book": "job                                     ",
    "chapter": "39",
    "verse": "19",
    "text": "Con có ban sức mạnh cho ngựa,"
  },
  {
    "id": 12681,
    "book": "job                                     ",
    "chapter": "39",
    "verse": "20",
    "text": "Con có khiến nó nhảy như châu chấu không?"
  },
  {
    "id": 12682,
    "book": "job                                     ",
    "chapter": "39",
    "verse": "21",
    "text": "Vó ngựa xoáy sâu trong đất và tự hào về sức mạnh"
  },
  {
    "id": 12683,
    "book": "job                                     ",
    "chapter": "39",
    "verse": "22",
    "text": "Nó coi thường đe dọa, bất chấp hiểm nguy."
  },
  {
    "id": 12684,
    "book": "job                                     ",
    "chapter": "39",
    "verse": "23",
    "text": "Phía trên nó, bao tên kêu lách tách,"
  },
  {
    "id": 12685,
    "book": "job                                     ",
    "chapter": "39",
    "verse": "24",
    "text": "Nó hầm hầm dậm nát đất như điên"
  },
  {
    "id": 12686,
    "book": "job                                     ",
    "chapter": "39",
    "verse": "25",
    "text": "Nó hí vang khi nghe tiếng thổi kèn."
  },
  {
    "id": 12687,
    "book": "job                                     ",
    "chapter": "39",
    "verse": "26",
    "text": "Có phải nhờ khôn ngoan của con mà diều hâu bay vút lên"
  },
  {
    "id": 12688,
    "book": "job                                     ",
    "chapter": "39",
    "verse": "27",
    "text": "Phải chăng con ra lệnh cho đại bàng,"
  },
  {
    "id": 12689,
    "book": "job                                     ",
    "chapter": "39",
    "verse": "28",
    "text": "Dùng vầng đá làm nơi cư ngụ,"
  },
  {
    "id": 12690,
    "book": "job                                     ",
    "chapter": "39",
    "verse": "29",
    "text": "Từ trên ấy, nó rình mồi săn bắt,"
  },
  {
    "id": 12691,
    "book": "job                                     ",
    "chapter": "39",
    "verse": "30",
    "text": "Đàn con nó cũng quen hút máu."
  }
]