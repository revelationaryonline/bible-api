[
  {
    "id": 12416,
    "book": "job                                     ",
    "chapter": "31",
    "verse": "1",
    "text": "“Tôi đã lập giao ước với mắt tôi,"
  },
  {
    "id": 12417,
    "book": "job                                     ",
    "chapter": "31",
    "verse": "2",
    "text": "Đức Chúa Trời trên trời cao ban gì cho chúng ta?"
  },
  {
    "id": 12418,
    "book": "job                                     ",
    "chapter": "31",
    "verse": "3",
    "text": "Há chẳng phải là họa cho kẻ gian tà"
  },
  {
    "id": 12419,
    "book": "job                                     ",
    "chapter": "31",
    "verse": "4",
    "text": "Chẳng lẽ Chúa không thấy mọi việc tôi làm"
  },
  {
    "id": 12420,
    "book": "job                                     ",
    "chapter": "31",
    "verse": "5",
    "text": "Tôi có dối trá ai"
  },
  {
    "id": 12421,
    "book": "job                                     ",
    "chapter": "31",
    "verse": "6",
    "text": "Xin Đức Chúa Trời đem tôi cân trên bàn cân công bằng,"
  },
  {
    "id": 12422,
    "book": "job                                     ",
    "chapter": "31",
    "verse": "7",
    "text": "Nếu tôi tẻ tách đường lối Chúa,"
  },
  {
    "id": 12423,
    "book": "job                                     ",
    "chapter": "31",
    "verse": "8",
    "text": "nguyện người khác gặt hái hết hoa lợi tôi gieo."
  },
  {
    "id": 12424,
    "book": "job                                     ",
    "chapter": "31",
    "verse": "9",
    "text": "Nếu lòng tôi còn bị phụ nữ mê hoặc,"
  },
  {
    "id": 12425,
    "book": "job                                     ",
    "chapter": "31",
    "verse": "10",
    "text": "thì nguyện vợ tôi thuộc về người khác;"
  },
  {
    "id": 12426,
    "book": "job                                     ",
    "chapter": "31",
    "verse": "11",
    "text": "Vì dục tình là một điều sỉ nhục,"
  },
  {
    "id": 12427,
    "book": "job                                     ",
    "chapter": "31",
    "verse": "12",
    "text": "Nó là lửa đốt cháy mọi lối địa ngục."
  },
  {
    "id": 12428,
    "book": "job                                     ",
    "chapter": "31",
    "verse": "13",
    "text": "Nếu tôi khinh thường quyền của tôi trai tớ gái,"
  },
  {
    "id": 12429,
    "book": "job                                     ",
    "chapter": "31",
    "verse": "14",
    "text": "làm sao tôi còn dám đối mặt Đức Chúa Trời?"
  },
  {
    "id": 12430,
    "book": "job                                     ",
    "chapter": "31",
    "verse": "15",
    "text": "Vì Đức Chúa Trời dựng nên tôi và đầy tớ tôi."
  },
  {
    "id": 12431,
    "book": "job                                     ",
    "chapter": "31",
    "verse": "16",
    "text": "Tôi có từ khước giúp đỡ người nghèo,"
  },
  {
    "id": 12432,
    "book": "job                                     ",
    "chapter": "31",
    "verse": "17",
    "text": "Tôi có dành ăn một mình"
  },
  {
    "id": 12433,
    "book": "job                                     ",
    "chapter": "31",
    "verse": "18",
    "text": "Không, từ thuở thiếu niên, tôi đã chăm sóc các cô nhi như một người cha,"
  },
  {
    "id": 12434,
    "book": "job                                     ",
    "chapter": "31",
    "verse": "19",
    "text": "Bất cứ khi nào tôi thấy người vô gia cư không quần áo,"
  },
  {
    "id": 12435,
    "book": "job                                     ",
    "chapter": "31",
    "verse": "20",
    "text": "chẳng lẽ họ không chúc phước cho tôi,"
  },
  {
    "id": 12436,
    "book": "job                                     ",
    "chapter": "31",
    "verse": "21",
    "text": "Nếu tôi đưa tay hại các cô nhi,"
  },
  {
    "id": 12437,
    "book": "job                                     ",
    "chapter": "31",
    "verse": "22",
    "text": "nguyện vai tôi lìa khỏi thân!"
  },
  {
    "id": 12438,
    "book": "job                                     ",
    "chapter": "31",
    "verse": "23",
    "text": "Thà bị tật nguyền như thế còn hơn bị Đức Chúa Trời phạt."
  },
  {
    "id": 12439,
    "book": "job                                     ",
    "chapter": "31",
    "verse": "24",
    "text": "Tôi để lòng tin cậy nơi bạc tiền,"
  },
  {
    "id": 12440,
    "book": "job                                     ",
    "chapter": "31",
    "verse": "25",
    "text": "Có phải tôi hân hoan vì nhiều của cải,"
  },
  {
    "id": 12441,
    "book": "job                                     ",
    "chapter": "31",
    "verse": "26",
    "text": "Chẳng phải tôi thấy ánh mặt trời trên cao,"
  },
  {
    "id": 12442,
    "book": "job                                     ",
    "chapter": "31",
    "verse": "27",
    "text": "mà hồn tôi bị mê hoặc"
  },
  {
    "id": 12443,
    "book": "job                                     ",
    "chapter": "31",
    "verse": "28",
    "text": "Nếu vậy, thì tội tôi đáng bị tòa xét xử,"
  },
  {
    "id": 12444,
    "book": "job                                     ",
    "chapter": "31",
    "verse": "29",
    "text": "Tôi có vui mừng khi thấy kẻ thù bị lâm nạn,"
  },
  {
    "id": 12445,
    "book": "job                                     ",
    "chapter": "31",
    "verse": "30",
    "text": "Không, tôi không cho phép miệng tôi hành tội bất cứ ai"
  },
  {
    "id": 12446,
    "book": "job                                     ",
    "chapter": "31",
    "verse": "31",
    "text": "Đầy tớ tôi chẳng bao giờ nói:"
  },
  {
    "id": 12447,
    "book": "job                                     ",
    "chapter": "31",
    "verse": "32",
    "text": "Tôi chưa bao giờ quay lưng với người xa lạ"
  },
  {
    "id": 12448,
    "book": "job                                     ",
    "chapter": "31",
    "verse": "33",
    "text": "Tôi có che giấu tội mình như người khác làm,"
  },
  {
    "id": 12449,
    "book": "job                                     ",
    "chapter": "31",
    "verse": "34",
    "text": "Chẳng lẽ tôi phải sợ hãi đám đông,"
  },
  {
    "id": 12450,
    "book": "job                                     ",
    "chapter": "31",
    "verse": "35",
    "text": "Ước gì có ai chịu lắng nghe tôi!"
  },
  {
    "id": 12451,
    "book": "job                                     ",
    "chapter": "31",
    "verse": "36",
    "text": "Nếu được thế, tôi sẽ xin đeo cáo trạng ấy trên vai."
  },
  {
    "id": 12452,
    "book": "job                                     ",
    "chapter": "31",
    "verse": "37",
    "text": "Tôi sẽ xin khai với Chúa những việc tôi đã làm."
  },
  {
    "id": 12453,
    "book": "job                                     ",
    "chapter": "31",
    "verse": "38",
    "text": "Nếu đất vườn tôi lên tiếng tố cáo"
  },
  {
    "id": 12454,
    "book": "job                                     ",
    "chapter": "31",
    "verse": "39",
    "text": "hay nếu tôi đã cướp đoạt hoa lợi"
  },
  {
    "id": 12455,
    "book": "job                                     ",
    "chapter": "31",
    "verse": "40",
    "text": "thì xin cho gai gốc mọc lên thay cho lúa mì"
  }
]