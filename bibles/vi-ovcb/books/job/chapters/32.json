[
  {
    "id": 12456,
    "book": "job                                     ",
    "chapter": "32",
    "verse": "1",
    "text": "Lúc ấy, ba bạn của Gióp không còn luận cứ nào để bài bác Gióp, vì ông cho mình là người công chính."
  },
  {
    "id": 12457,
    "book": "job                                     ",
    "chapter": "32",
    "verse": "2",
    "text": "Nhưng Ê-li-hu, con Ba-ra-kê-ên, người Bu-xi, dòng họ Ram, giận Gióp. Ông giận vì Gióp không nhận mình có tội và Đức Chúa Trời hình phạt ông là đúng."
  },
  {
    "id": 12458,
    "book": "job                                     ",
    "chapter": "32",
    "verse": "3",
    "text": "Ê-li-hu cũng giận ba bạn của Gióp, vì họ không có khả năng để trả lời những lý lẽ của Gióp."
  },
  {
    "id": 12459,
    "book": "job                                     ",
    "chapter": "32",
    "verse": "4",
    "text": "Ê-li-hu phải đợi đến phiên mình đối đáp với Gióp vì những người kia lớn tuổi hơn ông."
  },
  {
    "id": 12460,
    "book": "job                                     ",
    "chapter": "32",
    "verse": "5",
    "text": "Nhưng khi ông thấy họ không biết trả lời thế nào nữa thì ông nổi giận."
  },
  {
    "id": 12461,
    "book": "job                                     ",
    "chapter": "32",
    "verse": "6",
    "text": "Ê-li-hu, con trai Ba-ra-kê-ên, người Bu-xi, nói:"
  },
  {
    "id": 12462,
    "book": "job                                     ",
    "chapter": "32",
    "verse": "7",
    "text": "Tôi vẫn tự bảo: ‘Hãy nghe các vị cao niên nói,"
  },
  {
    "id": 12463,
    "book": "job                                     ",
    "chapter": "32",
    "verse": "8",
    "text": "Nhưng thật ra, chính tâm linh con người,"
  },
  {
    "id": 12464,
    "book": "job                                     ",
    "chapter": "32",
    "verse": "9",
    "text": "Người lớn tuổi chưa chắc đã khôn."
  },
  {
    "id": 12465,
    "book": "job                                     ",
    "chapter": "32",
    "verse": "10",
    "text": "Vậy nên, xin hãy lắng nghe tôi,"
  },
  {
    "id": 12466,
    "book": "job                                     ",
    "chapter": "32",
    "verse": "11",
    "text": "Kìa, tôi vẫn chờ đợi suốt thời gian,"
  },
  {
    "id": 12467,
    "book": "job                                     ",
    "chapter": "32",
    "verse": "12",
    "text": "Vâng, tôi đã chú tâm lắng nghe,"
  },
  {
    "id": 12468,
    "book": "job                                     ",
    "chapter": "32",
    "verse": "13",
    "text": "Xin đừng nói với tôi: ‘Ông ấy cũng khôn ngoan như chúng ta."
