[
  {
    "id": 11956,
    "book": "job                                     ",
    "chapter": "12",
    "verse": "1",
    "text": "Rồi Gióp đáp lời:"
  },
  {
    "id": 11957,
    "book": "job                                     ",
    "chapter": "12",
    "verse": "2",
    "text": "“Anh cho rằng mình biết mọi thứ, có phải không?"
  },
  {
    "id": 11958,
    "book": "job                                     ",
    "chapter": "12",
    "verse": "3",
    "text": "Nhưng tôi cũng biết như các anh—"
  },
  {
    "id": 11959,
    "book": "job                                     ",
    "chapter": "12",
    "verse": "4",
    "text": "Bạn bè của tôi nhạo cười tôi,"
  },
  {
    "id": 11960,
    "book": "job                                     ",
    "chapter": "12",
    "verse": "5",
    "text": "Người nhàn hạ chế giễu người bạc phước,"
  },
  {
    "id": 11961,
    "book": "job                                     ",
    "chapter": "12",
    "verse": "6",
    "text": "Còn kẻ trộm cướp được hưng thịnh,"
  },
  {
    "id": 11962,
    "book": "job                                     ",
    "chapter": "12",
    "verse": "7",
    "text": "Hãy hỏi loài thú, và chúng sẽ dạy anh."
  },
  {
    "id": 11963,
    "book": "job                                     ",
    "chapter": "12",
    "verse": "8",
    "text": "Hãy hỏi đất, và đất sẽ hướng dẫn."
  },
  {
    "id": 11964,
    "book": "job                                     ",
    "chapter": "12",
    "verse": "9",
    "text": "Vì tất cả chúng đều biết rằng"
  },
  {
    "id": 11965,
    "book": "job                                     ",
    "chapter": "12",
    "verse": "10",
    "text": "Vì hồn mọi sinh vật trong tay Chúa,"
  },
  {
    "id": 11966,
    "book": "job                                     ",
    "chapter": "12",
    "verse": "11",
    "text": "Tai biết phân biệt lời nói"
  },
  {
    "id": 11967,
    "book": "job                                     ",
    "chapter": "12",
    "verse": "12",
    "text": "Già cả thêm khôn ngoan,"
  },
  {
    "id": 11968,
    "book": "job                                     ",
    "chapter": "12",
    "verse": "13",
    "text": "Nhưng khôn ngoan thật và sức mạnh thuộc về Đức Chúa Trời;"
  },
  {
    "id": 11969,
    "book": "job                                     ",
    "chapter": "12",
    "verse": "14",
    "text": "Chúa đã phá hủy thì không ai xây lại được."
  },
  {
    "id": 11970,
    "book": "job                                     ",
    "chapter": "12",
    "verse": "15",
    "text": "Nếu Chúa cầm giữ mưa, đất đai liền khô hạn."
  },
  {
    "id": 11971,
    "book": "job                                     ",
    "chapter": "12",
    "verse": "16",
    "text": "Phải, sức mạnh và sự khôn ngoan thuộc về Chúa;"
  },
  {
    "id": 11972,
    "book": "job                                     ",
    "chapter": "12",
    "verse": "17",
    "text": "Chúa khiến các mưu sĩ đi chân đất;"
  },
  {
    "id": 11973,
    "book": "job                                     ",
    "chapter": "12",
    "verse": "18",
    "text": "Chúa tháo bỏ áo bào của các vua."
  },
  {
    "id": 11974,
    "book": "job                                     ",
    "chapter": "12",
    "verse": "19",
    "text": "Chúa dẫn các thầy tế lễ đi khỏi, tước mọi địa vị;"
  },
  {
    "id": 11975,
    "book": "job                                     ",
    "chapter": "12",
    "verse": "20",
    "text": "Chúa khiến kẻ cố vấn đáng tin cậy im lặng,"
  },
  {
    "id": 11976,
    "book": "job                                     ",
    "chapter": "12",
    "verse": "21",
    "text": "Chúa giáng điều sỉ nhục trên người cao sang quý tộc,"
  },
  {
    "id": 11977,
    "book": "job                                     ",
    "chapter": "12",
    "verse": "22",
    "text": "Chúa đem việc tối tăm ra ánh sáng;"
  },
  {
    "id": 11978,
    "book": "job                                     ",
    "chapter": "12",
    "verse": "23",
    "text": "Chúa gây dựng các dân tộc, rồi Ngài hủy diệt họ."
  },
  {
    "id": 11979,
    "book": "job                                     ",
    "chapter": "12",
    "verse": "24",
    "text": "Chúa tước đoạt sự hiểu biết của các vua"
  },
  {
    "id": 11980,
    "book": "job                                     ",
    "chapter": "12",
    "verse": "25",
    "text": "Họ quờ quạng trong bóng tối không ánh sáng."
  }
]