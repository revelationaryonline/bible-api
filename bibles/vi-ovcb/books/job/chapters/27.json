  {
    "id": 12315,
    "book": "job                                     ",
    "chapter": "27",
    "verse": "7",
    "text": "Ước gì thù nghịch tôi giống như kẻ gian ác,"
  },
  {
    "id": 12316,
    "book": "job                                     ",
    "chapter": "27",
    "verse": "8",
    "text": "Kẻ vô đạo còn hy vọng gì"
  },
  {
    "id": 12317,
    "book": "job                                     ",
    "chapter": "27",
    "verse": "9",
    "text": "Đức Chúa Trời có nghe tiếng nó kêu to"
