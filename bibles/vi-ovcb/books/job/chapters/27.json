  {
    "id": 12320,
    "book": "job                                     ",
    "chapter": "27",
    "verse": "12",
    "text": "Nhưng những điều ấy các anh đều biết cả,"
  },
  {
    "id": 12321,
    "book": "job                                     ",
    "chapter": "27",
    "verse": "13",
    "text": "Đây là số phận Đức Chúa Trời dành cho người gian tà;"
