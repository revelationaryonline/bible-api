    "text": "Gióp tiếp tục biện luận:"
  },
  {
    "id": 12310,
    "book": "job                                     ",
    "chapter": "27",
    "verse": "2",
    "text": "“Thật như Đức Chúa Trời Hằng Sống, Đấng tước lấy công chính tôi,"
  },
  {
    "id": 12311,
    "book": "job                                     ",
    "chapter": "27",
    "verse": "3",
