  {
    "id": 12312,
    "book": "job                                     ",
    "chapter": "27",
    "verse": "4",
    "text": "môi miệng tôi sẽ không nói lời nào gian ác,"
  },
  {
    "id": 12313,
    "book": "job                                     ",
    "chapter": "27",
    "verse": "5",
    "text": "Hẳn tôi không thể nào cho các anh là phải;"
