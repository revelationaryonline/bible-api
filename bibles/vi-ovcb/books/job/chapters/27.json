  {
    "id": 12322,
    "book": "job                                     ",
    "chapter": "27",
    "verse": "14",
    "text": "Dù nó có đông con cái,"
  },
  {
    "id": 12323,
    "book": "job                                     ",
    "chapter": "27",
    "verse": "15",
    "text": "Những đứa sống sót cũng chết vì bệnh tật,"
  },
  {
    "id": 12324,
    "book": "job                                     ",
    "chapter": "27",
    "verse": "16",
    "text": "Kẻ ác gom góp bạc tiền như núi,"
  },
  {
    "id": 12325,
    "book": "job                                     ",
    "chapter": "27",
    "verse": "17",
    "text": "Nhưng người công chính sẽ mặc quần áo,"
