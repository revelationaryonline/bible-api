[
  {
    "id": 12183,
    "book": "job                                     ",
    "chapter": "21",
    "verse": "1",
    "text": "Gióp đáp lại:"
  },
  {
    "id": 12184,
    "book": "job                                     ",
    "chapter": "21",
    "verse": "2",
    "text": "“Xin lắng nghe những gì tôi nói."
  },
  {
    "id": 12185,
    "book": "job                                     ",
    "chapter": "21",
    "verse": "3",
    "text": "Xin nhẫn nại, để nghe tôi thổ lộ."
  },
  {
    "id": 12186,
    "book": "job                                     ",
    "chapter": "21",
    "verse": "4",
    "text": "Thật ra, tôi đâu có phiền trách loài người."
  },
  {
    "id": 12187,
    "book": "job                                     ",
    "chapter": "21",
    "verse": "5",
    "text": "Xin các anh quay mặt nhìn tôi."
  },
  {
    "id": 12188,
    "book": "job                                     ",
    "chapter": "21",
    "verse": "6",
    "text": "Chính tôi cũng sợ hãi khi nhìn bản thân."
  },
  {
    "id": 12189,
    "book": "job                                     ",
    "chapter": "21",
    "verse": "7",
    "text": "Tại sao bọn gian ác sống lâu,"
  },
  {
    "id": 12190,
    "book": "job                                     ",
    "chapter": "21",
    "verse": "8",
    "text": "Chính mắt chúng được chứng kiến rõ ràng,"
  },
  {
    "id": 12191,
    "book": "job                                     ",
    "chapter": "21",
    "verse": "9",
    "text": "Nhà cửa chúng an ninh, không có gì phải sợ,"
  },
  {
    "id": 12192,
    "book": "job                                     ",
    "chapter": "21",
    "verse": "10",
    "text": "Bò đực chúng tăng gia, không mất mát."
  },
  {
    "id": 12193,
    "book": "job                                     ",
    "chapter": "21",
    "verse": "11",
    "text": "Chúng đưa đàn con ra như bầy chiên."
  },
  {
    "id": 12194,
    "book": "job                                     ",
    "chapter": "21",
    "verse": "12",
    "text": "Chúng ca hát theo tiếng trống và tiếng đàn hạc."
  },
  {
    "id": 12195,
    "book": "job                                     ",
    "chapter": "21",
    "verse": "13",
    "text": "Chúng sống những ngày giàu sang thịnh vượng,"
  },
  {
    "id": 12196,
    "book": "job                                     ",
    "chapter": "21",
    "verse": "14",
    "text": "Chúng dám nói với Đức Chúa Trời: ‘Xin hãy lìa xa."
  },
  {
    "id": 12197,
    "book": "job                                     ",
    "chapter": "21",
    "verse": "15",
    "text": "Đấng Toàn Năng là ai mà chúng tôi phải vâng phục?"
  },
  {
    "id": 12198,
    "book": "job                                     ",
    "chapter": "21",
    "verse": "16",
    "text": "(Chúng nghĩ sự hưng thịnh đang nằm trong tay chúng,"
  },
  {
    "id": 12199,
    "book": "job                                     ",
    "chapter": "21",
    "verse": "17",
    "text": "Dường như ánh sáng của kẻ ác chưa bao giờ tắt."
  },
  {
    "id": 12200,
    "book": "job                                     ",
    "chapter": "21",
    "verse": "18",
    "text": "Chúng chẳng bị cuốn theo chiều gió như rơm rác sao?"
  },
  {
    "id": 12201,
    "book": "job                                     ",
    "chapter": "21",
    "verse": "19",
    "text": "Các anh bảo: ‘Đức Chúa Trời sẽ phạt con cái chúng về sau?’"
  },
  {
    "id": 12202,
    "book": "job                                     ",
    "chapter": "21",
    "verse": "20",
    "text": "Xin cho chúng chứng kiến cảnh diệt vong."
  },
  {
    "id": 12203,
    "book": "job                                     ",
    "chapter": "21",
    "verse": "21",
    "text": "Vì một khi đã xuôi tay nhắm mắt,"
  },
  {
    "id": 12204,
    "book": "job                                     ",
    "chapter": "21",
    "verse": "22",
    "text": "Nhưng ai dám lên mặt dạy khôn Đức Chúa Trời,"
  },
  {
    "id": 12205,
    "book": "job                                     ",
    "chapter": "21",
    "verse": "23",
    "text": "Có người chết khi đang sung sức,"
  },
  {
    "id": 12206,
    "book": "job                                     ",
    "chapter": "21",
    "verse": "24",
    "text": "lúc thân thể còn tráng kiện,"
  },
  {
    "id": 12207,
    "book": "job                                     ",
    "chapter": "21",
    "verse": "25",
    "text": "Người khác lại qua đời trong đắng cay,"
  },
  {
    "id": 12208,
    "book": "job                                     ",
    "chapter": "21",
    "verse": "26",
    "text": "Lòng đất lạnh cả hai cùng nằm xuống,"
  },
  {
    "id": 12209,
    "book": "job                                     ",
    "chapter": "21",
    "verse": "27",
    "text": "Này, tôi biết rõ các anh đang nghĩ gì."
  },
  {
    "id": 12210,
    "book": "job                                     ",
    "chapter": "21",
    "verse": "28",
    "text": "Các anh bảo tôi bọn cường hào ác bá,"
  },
  {
    "id": 12211,
    "book": "job                                     ",
    "chapter": "21",
    "verse": "29",
    "text": "Nhưng sao không hỏi những người chung quanh,"
  },
  {
    "id": 12212,
    "book": "job                                     ",
    "chapter": "21",
    "verse": "30",
    "text": "Kẻ ác thường được tai qua nạn khỏi"
  },
  {
    "id": 12213,
    "book": "job                                     ",
    "chapter": "21",
    "verse": "31",
    "text": "Chẳng ai đem việc ác nó ra nguyền rủa"
  },
  {
    "id": 12214,
    "book": "job                                     ",
    "chapter": "21",
    "verse": "32",
    "text": "Khi chết, nó được an táng linh đình,"
  },
  {
    "id": 12215,
    "book": "job                                     ",
    "chapter": "21",
    "verse": "33",
    "text": "Kẻ ác vẫn được mồ yên mả đẹp."
  },
  {
    "id": 12216,
    "book": "job                                     ",
    "chapter": "21",
    "verse": "34",
    "text": "Vậy, sao các anh còn phí công an ủi tôi?"
  }
]