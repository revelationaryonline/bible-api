[
  {
    "id": 11779,
    "book": "job                                     ",
    "chapter": "5",
    "verse": "1",
    "text": "“Hãy kêu khóc xin giúp, xem có ai sẽ trả lời anh không?"
  },
  {
    "id": 11780,
    "book": "job                                     ",
    "chapter": "5",
    "verse": "2",
    "text": "Chắc chắn sự oán giận sẽ hủy diệt người dại,"
  },
  {
    "id": 11781,
    "book": "job                                     ",
    "chapter": "5",
    "verse": "3",
    "text": "Tôi đã thấy người dại được thành công trong chốc lác,"
  },
  {
    "id": 11782,
    "book": "job                                     ",
    "chapter": "5",
    "verse": "4",
    "text": "Con cái họ bị ruồng bỏ không ai giúp;"
  },
  {
    "id": 11783,
    "book": "job                                     ",
    "chapter": "5",
    "verse": "5",
    "text": "Người đói ăn mùa màng của họ,"
  },
  {
    "id": 11784,
    "book": "job                                     ",
    "chapter": "5",
    "verse": "6",
    "text": "Vì sự gian tà không ra từ cát bụi,"
  },
  {
    "id": 11785,
    "book": "job                                     ",
    "chapter": "5",
    "verse": "7",
    "text": "Người ra đời để chịu khổ,"
  },
  {
    "id": 11786,
    "book": "job                                     ",
    "chapter": "5",
    "verse": "8",
    "text": "Nếu là tôi, tôi sẽ kêu cầu Đức Chúa Trời,"
  },
  {
    "id": 11787,
    "book": "job                                     ",
    "chapter": "5",
    "verse": "9",
    "text": "Chúa làm việc lớn ai lường được."
  },
  {
    "id": 11788,
    "book": "job                                     ",
    "chapter": "5",
    "verse": "10",
    "text": "Ngài ban mưa cho đất"
  },
  {
    "id": 11789,
    "book": "job                                     ",
    "chapter": "5",
    "verse": "11",
    "text": "Ngài cất nhắc người thấp kém"
  },
  {
    "id": 11790,
    "book": "job                                     ",
    "chapter": "5",
    "verse": "12",
    "text": "Chúa phá tan mưu người xảo trá"
  },
  {
    "id": 11791,
    "book": "job                                     ",
    "chapter": "5",
    "verse": "13",
    "text": "Ngài bắt kẻ khôn ngoan trong mưu chước mình,"
  },
  {
    "id": 11792,
    "book": "job                                     ",
    "chapter": "5",
    "verse": "14",
    "text": "Chúng gặp bóng tối giữa ban ngày,"
  },
  {
    "id": 11793,
    "book": "job                                     ",
    "chapter": "5",
    "verse": "15",
    "text": "Chúa cứu người nghèo khổ khỏi lời sắc bén mạnh mẽ,"
  },
  {
    "id": 11794,
    "book": "job                                     ",
    "chapter": "5",
    "verse": "16",
    "text": "Nên người khổ nẩy sinh hy vọng,"
  },
  {
    "id": 11795,
    "book": "job                                     ",
    "chapter": "5",
    "verse": "17",
    "text": "Phước cho người được Đức Chúa Trời khuyên dạy!"
  },
  {
    "id": 11796,
    "book": "job                                     ",
    "chapter": "5",
    "verse": "18",
    "text": "Vì Ngài gây thương tích, rồi Ngài lại băng bó,"
  },
  {
    "id": 11797,
    "book": "job                                     ",
    "chapter": "5",
    "verse": "19",
    "text": "Ngài sẽ ra tay giải cứu anh khỏi sáu cơn hoạn nạn;"
  },
  {
    "id": 11798,
    "book": "job                                     ",
    "chapter": "5",
    "verse": "20",
    "text": "Gặp nạn đói, Ngài cứu anh khỏi chết,"
  },
  {
    "id": 11799,
    "book": "job                                     ",
    "chapter": "5",
    "verse": "21",
    "text": "Bị vu oan nhưng chẳng nao núng,"
  },
  {
    "id": 11800,
    "book": "job                                     ",
    "chapter": "5",
    "verse": "22",
    "text": "Anh cười trong lúc hoang tàn và đói kém;"
  },
  {
    "id": 11801,
    "book": "job                                     ",
    "chapter": "5",
    "verse": "23",
    "text": "Anh kết ước với đá ngoài đồng,"
  },
  {
    "id": 11802,
    "book": "job                                     ",
    "chapter": "5",
    "verse": "24",
    "text": "Anh sẽ thấy nhà anh bình an vô sự."
  },
  {
    "id": 11803,
    "book": "job                                     ",
    "chapter": "5",
    "verse": "25",
    "text": "Anh sẽ có rất nhiều con cái;"
  },
  {
    "id": 11804,
    "book": "job                                     ",
    "chapter": "5",
    "verse": "26",
    "text": "Anh sẽ vào phần mộ lúc tuổi cao,"
  },
  {
    "id": 11805,
    "book": "job                                     ",
    "chapter": "5",
    "verse": "27",
    "text": "Chúng tôi tìm hiểu như thế và thấy hoàn toàn đúng."
  }
]