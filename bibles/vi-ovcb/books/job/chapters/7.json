[
  {
    "id": 11836,
    "book": "job                                     ",
    "chapter": "7",
    "verse": "1",
    "text": "“Có phải loài người phục dịch gian khổ?"
  },
  {
    "id": 11837,
    "book": "job                                     ",
    "chapter": "7",
    "verse": "2",
    "text": "như người làm công ngóng chờ đêm tối,"
  },
  {
    "id": 11838,
    "book": "job                                     ",
    "chapter": "7",
    "verse": "3",
    "text": "Tôi cũng vậy, chỉ được những tháng ngày vô nghĩa,"
  },
  {
    "id": 11839,
    "book": "job                                     ",
    "chapter": "7",
    "verse": "4",
    "text": "Nằm dài trên giường, tôi nghĩ: ‘Khi nào trời sẽ sáng?’"
  },
  {
    "id": 11840,
    "book": "job                                     ",
    "chapter": "7",
    "verse": "5",
    "text": "Thân tôi phủ đầy bọ giòi và đất bụi."
  },
  {
    "id": 11841,
    "book": "job                                     ",
    "chapter": "7",
    "verse": "6",
    "text": "“Ngày của con bay nhanh hơn thoi đưa."
  },
  {
    "id": 11842,
    "book": "job                                     ",
    "chapter": "7",
    "verse": "7",
    "text": "Lạy Đức Chúa Trời, xin nhớ đời con chỉ là hơi thở,"
  },
  {
    "id": 11843,
    "book": "job                                     ",
    "chapter": "7",
    "verse": "8",
    "text": "Chúa nhìn con bây giờ, nhưng sẽ không bao lâu nữa,"
  },
  {
    "id": 11844,
    "book": "job                                     ",
    "chapter": "7",
    "verse": "9",
    "text": "Như mây tan và tiêu mất thể nào,"
  },
  {
    "id": 11845,
    "book": "job                                     ",
    "chapter": "7",
    "verse": "10",
    "text": "Họ sẽ rời xa nhà mình mãi mãi—"
  },
  {
    "id": 11846,
    "book": "job                                     ",
    "chapter": "7",
    "verse": "11",
    "text": "Vì thế nên, con sẽ không nín lặng."
  },
  {
    "id": 11847,
    "book": "job                                     ",
    "chapter": "7",
    "verse": "12",
    "text": "Có phải con là quái vật trong biển,"
  },
  {
    "id": 11848,
    "book": "job                                     ",
    "chapter": "7",
    "verse": "13",
    "text": "Con nghĩ: ‘Giường con sẽ an ủi con,"
  },
  {
    "id": 11849,
    "book": "job                                     ",
    "chapter": "7",
    "verse": "14",
    "text": "nhưng khi Chúa làm tan vỡ giấc chiêm bao,"
  },
  {
    "id": 11850,
    "book": "job                                     ",
    "chapter": "7",
    "verse": "15",
    "text": "Đến nỗi con thà bị nghẹt thở—"
  },
  {
    "id": 11851,
    "book": "job                                     ",
    "chapter": "7",
    "verse": "16",
    "text": "Con chán ghét cuộc sống con và không muốn sống nữa."
  },
  {
    "id": 11852,
    "book": "job                                     ",
    "chapter": "7",
    "verse": "17",
    "text": "Loài người là chi mà Chúa xem quan trọng,"
  },
  {
    "id": 11853,
    "book": "job                                     ",
    "chapter": "7",
    "verse": "18",
    "text": "Cứ mỗi sáng, Chúa đem tra vấn"
  },
  {
    "id": 11854,
    "book": "job                                     ",
    "chapter": "7",
    "verse": "19",
    "text": "Tại sao Chúa không buông tha con,"
  },
  {
    "id": 11855,
    "book": "job                                     ",
    "chapter": "7",
    "verse": "20",
    "text": "Nếu con phạm tội, thì tội ấy đối với Chúa là gì,"
  },
  {
    "id": 11856,
    "book": "job                                     ",
    "chapter": "7",
    "verse": "21",
    "text": "Tại sao Chúa không tha thứ tội con"
  }
]