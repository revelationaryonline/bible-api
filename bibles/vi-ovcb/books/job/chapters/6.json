[
  {
    "id": 11806,
    "book": "job                                     ",
    "chapter": "6",
    "verse": "1",
    "text": "Rồi Gióp đáp lại rằng:"
  },
  {
    "id": 11807,
    "book": "job                                     ",
    "chapter": "6",
    "verse": "2",
    "text": "“Ước gì nỗi khổ này đem đo lường được"
  },
  {
    "id": 11808,
    "book": "job                                     ",
    "chapter": "6",
    "verse": "3",
    "text": "hẳn chúng sẽ nặng hơn cát biển."
  },
  {
    "id": 11809,
    "book": "job                                     ",
    "chapter": "6",
    "verse": "4",
    "text": "Mũi tên Đấng Toàn Năng bắn hạ tôi,"
  },
  {
    "id": 11810,
    "book": "job                                     ",
    "chapter": "6",
    "verse": "5",
    "text": "Tôi không có quyền phàn nàn chăng?"
  },
  {
    "id": 11811,
    "book": "job                                     ",
    "chapter": "6",
    "verse": "6",
    "text": "Có ai không than phiền khi thức ăn nhạt nhẽo?"
  },
  {
    "id": 11812,
    "book": "job                                     ",
    "chapter": "6",
    "verse": "7",
    "text": "Tôi không muốn đụng đến thức ăn;"
  },
  {
    "id": 11813,
    "book": "job                                     ",
    "chapter": "6",
    "verse": "8",
    "text": "Ôi ước chi tôi được dâng lời thỉnh nguyện,"
  },
  {
    "id": 11814,
    "book": "job                                     ",
    "chapter": "6",
    "verse": "9",
    "text": "Tôi ước gì được Ngài nghiền nát."
  },
  {
    "id": 11815,
    "book": "job                                     ",
    "chapter": "6",
    "verse": "10",
    "text": "Ít nhất tôi cũng được vui thỏa trong việc này:"
  },
  {
    "id": 11816,
    "book": "job                                     ",
    "chapter": "6",
    "verse": "11",
    "text": "Nhưng tôi không còn sức chịu đựng."
  },
  {
    "id": 11817,
    "book": "job                                     ",
    "chapter": "6",
    "verse": "12",
    "text": "Có phải tôi có sức của đá?"
  },
  {
    "id": 11818,
    "book": "job                                     ",
    "chapter": "6",
    "verse": "13",
    "text": "Không, tôi hoàn toàn bất lực,"
  },
  {
    "id": 11819,
    "book": "job                                     ",
    "chapter": "6",
    "verse": "14",
    "text": "Người tuyệt vọng cần bạn bè thương xót,"
  },
  {
    "id": 11820,
    "book": "job                                     ",
    "chapter": "6",
    "verse": "15",
    "text": "Anh em tôi ơi, anh thay đổi thất thường như dòng suối"
  },
  {
    "id": 11821,
    "book": "job                                     ",
    "chapter": "6",
    "verse": "16",
    "text": "khi nước dâng lên vì đá chảy và tuyết tan."
  },
  {
    "id": 11822,
    "book": "job                                     ",
    "chapter": "6",
    "verse": "17",
    "text": "Nhưng khi mùa nắng hạn đến, nước sẽ không còn."
  },
  {
    "id": 11823,
    "book": "job                                     ",
    "chapter": "6",
    "verse": "18",
    "text": "Đoàn bộ hành rẽ đường tìm nước,"
  },
  {
    "id": 11824,
    "book": "job                                     ",
    "chapter": "6",
    "verse": "19",
    "text": "Khách bộ hành Thê-ma đi tìm nước;"
  },
  {
    "id": 11825,
    "book": "job                                     ",
    "chapter": "6",
    "verse": "20",
    "text": "Họ trông mong nhưng lại thất vọng."
  },
  {
    "id": 11826,
    "book": "job                                     ",
    "chapter": "6",
    "verse": "21",
    "text": "Nay các anh cũng chẳng giúp gì tôi."
  },
  {
    "id": 11827,
    "book": "job                                     ",
    "chapter": "6",
    "verse": "22",
    "text": "Nhưng tại sao? Có bao giờ tôi hỏi xin anh cung cấp nhu cầu?"
  },
  {
    "id": 11828,
    "book": "job                                     ",
    "chapter": "6",
    "verse": "23",
    "text": "Tôi có nhờ anh cứu tôi khỏi tay kẻ thù,"
  },
  {
    "id": 11829,
    "book": "job                                     ",
    "chapter": "6",
    "verse": "24",
    "text": "Hãy chỉ dạy, tôi sẽ im lặng lắng nghe,"
  },
  {
    "id": 11830,
    "book": "job                                     ",
    "chapter": "6",
    "verse": "25",
    "text": "Tôi vốn biết lời thành thật nhiều khi gây đau đớn,"
  },
  {
    "id": 11831,
    "book": "job                                     ",
    "chapter": "6",
    "verse": "26",
    "text": "Có phải anh chê trách lời tôi nói,"
  },
  {
    "id": 11832,
    "book": "job                                     ",
    "chapter": "6",
    "verse": "27",
    "text": "Thật sự các anh như đã rút thăm chia chác với người mồ côi,"
  },
  {
    "id": 11833,
    "book": "job                                     ",
    "chapter": "6",
    "verse": "28",
    "text": "Hãy nhìn tôi!"
  },
  {
    "id": 11834,
    "book": "job                                     ",
    "chapter": "6",
    "verse": "29",
    "text": "Xin đừng cho rằng do tội của tôi,"
  },
  {
    "id": 11835,
    "book": "job                                     ",
    "chapter": "6",
    "verse": "30",
    "text": "Anh nghĩ rằng tôi nói dối sao?"
  }
]