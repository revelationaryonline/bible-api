[
  {
    "id": 12511,
    "book": "job                                     ",
    "chapter": "34",
    "verse": "1",
    "text": "Ê-li-hu tiếp lời:"
  },
  {
    "id": 12512,
    "book": "job                                     ",
    "chapter": "34",
    "verse": "2",
    "text": "“Xin lắng nghe tôi, hỡi những người khôn ngoan."
  },
  {
    "id": 12513,
    "book": "job                                     ",
    "chapter": "34",
    "verse": "3",
    "text": "Gióp nói: ‘Tai thử lời nó nghe"
  },
  {
    "id": 12514,
    "book": "job                                     ",
    "chapter": "34",
    "verse": "4",
    "text": "Vậy chúng ta hãy cùng nhận thức điều nào phải,"
  },
  {
    "id": 12515,
    "book": "job                                     ",
    "chapter": "34",
    "verse": "5",
    "text": "Vì Gióp đã nói: ‘Tôi vô tội,"
  },
  {
    "id": 12516,
    "book": "job                                     ",
    "chapter": "34",
    "verse": "6",
    "text": "Tôi vô tội, nhưng họ cho tôi là dối trá."
  },
  {
    "id": 12517,
    "book": "job                                     ",
    "chapter": "34",
    "verse": "7",
    "text": "Hãy nói với tôi, có ai giống như Gióp,"
  },
  {
    "id": 12518,
    "book": "job                                     ",
    "chapter": "34",
    "verse": "8",
    "text": "Anh ấy chọn làm bạn với kẻ gian."
  },
  {
    "id": 12519,
    "book": "job                                     ",
    "chapter": "34",
    "verse": "9",
    "text": "Anh ấy còn cho rằng: ‘Tại sao phải tốn thời gian"
  },
  {
    "id": 12520,
    "book": "job                                     ",
    "chapter": "34",
    "verse": "10",
    "text": "Xin lắng nghe tôi, thưa những người thông hiểu."
  },
  {
    "id": 12521,
    "book": "job                                     ",
    "chapter": "34",
    "verse": "11",
    "text": "Chúa thưởng phạt loài người tùy công việc họ làm."
  },
  {
    "id": 12522,
    "book": "job                                     ",
    "chapter": "34",
    "verse": "12",
    "text": "Thật Đức Chúa Trời không làm điều sai."
  },
  {
    "id": 12523,
    "book": "job                                     ",
    "chapter": "34",
    "verse": "13",
    "text": "Ai ủy quyền cho Ngài quản trị địa cầu?"
  },
  {
    "id": 12524,
    "book": "job                                     ",
    "chapter": "34",
    "verse": "14",
    "text": "Nếu Đức Chúa Trời lấy lại Thần Linh Ngài"
  },
  {
    "id": 12525,
    "book": "job                                     ",
    "chapter": "34",
    "verse": "15",
    "text": "thì chúng sinh đều chết chung nhau"
  },
  {
    "id": 12526,
    "book": "job                                     ",
    "chapter": "34",
    "verse": "16",
    "text": "Xin hãy nghe, nếu anh là người khôn ngoan."
  },
  {
    "id": 12527,
    "book": "job                                     ",
    "chapter": "34",
    "verse": "17",
    "text": "Đức Chúa Trời có thể thống trị nếu Ngài ghét công lý không?"
  },
  {
    "id": 12528,
    "book": "job                                     ",
    "chapter": "34",
    "verse": "18",
    "text": "Vì có ai nói với vua: ‘Ông là kẻ ác,’"
  },
  {
    "id": 12529,
    "book": "job                                     ",
    "chapter": "34",
    "verse": "19",
    "text": "Huống chi Chúa không nể vì vua chúa,"
  },
  {
    "id": 12530,
    "book": "job                                     ",
    "chapter": "34",
    "verse": "20",
    "text": "Trong khoảnh khắc, họ chết."
  },
  {
    "id": 12531,
    "book": "job                                     ",
    "chapter": "34",
    "verse": "21",
    "text": "Vì Đức Chúa Trời xem xét cách sống của loài người;"
  },
  {
    "id": 12532,
    "book": "job                                     ",
    "chapter": "34",
    "verse": "22",
    "text": "Dù bóng tối mù mịt"
  },
  {
    "id": 12533,
    "book": "job                                     ",
    "chapter": "34",
    "verse": "23",
    "text": "Không cần chờ đợi lâu,"
  },
  {
    "id": 12534,
    "book": "job                                     ",
    "chapter": "34",
    "verse": "24",
    "text": "Chúa dùng sức mạnh đập tan người quyền thế, không cần tra hỏi,"
  },
  {
    "id": 12535,
    "book": "job                                     ",
    "chapter": "34",
    "verse": "25",
    "text": "Chúa biết rõ việc họ làm,"
  },
  {
    "id": 12536,
    "book": "job                                     ",
    "chapter": "34",
    "verse": "26",
    "text": "Chúa kéo họ xuống vì họ làm ác,"
  },
  {
    "id": 12537,
    "book": "job                                     ",
    "chapter": "34",
    "verse": "27",
    "text": "Vì họ trở mặt quay lưng với Chúa."
  },
  {
    "id": 12538,
    "book": "job                                     ",
    "chapter": "34",
    "verse": "28",
    "text": "Họ khiến người nghèo khó khóc than thấu tận Đức Chúa Trời."
  },
  {
    "id": 12539,
    "book": "job                                     ",
    "chapter": "34",
    "verse": "29",
    "text": "Nhưng khi Chúa im lặng,"
  },
  {
    "id": 12540,
    "book": "job                                     ",
    "chapter": "34",
    "verse": "30",
    "text": "Chúa ngăn kẻ vô đạo cầm quyền,"
  },
  {
    "id": 12541,
    "book": "job                                     ",
    "chapter": "34",
    "verse": "31",
    "text": "Tại sao con người không thưa với Đức Chúa Trời rằng:"
  },
  {
    "id": 12542,
    "book": "job                                     ",
    "chapter": "34",
    "verse": "32",
    "text": "Hay ‘Con không biết con đã làm điều ác—xin cho con biết."
  },
  {
    "id": 12543,
    "book": "job                                     ",
    "chapter": "34",
    "verse": "33",
    "text": "Có phải Đức Chúa Trời thưởng phạt theo điều kiện của anh không?"
  },
  {
    "id": 12544,
    "book": "job                                     ",
    "chapter": "34",
    "verse": "34",
    "text": "Những người thông sáng sẽ nói với tôi,"
  },
  {
    "id": 12545,
    "book": "job                                     ",
    "chapter": "34",
    "verse": "35",
    "text": "‘Gióp đã nói lời vô ý thức;"
  },
  {
    "id": 12546,
    "book": "job                                     ",
    "chapter": "34",
    "verse": "36",
    "text": "Nguyện Gióp bị thử thách đến cùng"
  },
  {
    "id": 12547,
    "book": "job                                     ",
    "chapter": "34",
    "verse": "37",
    "text": "Đã phạm tội, anh còn phản loạn;"
  }
]