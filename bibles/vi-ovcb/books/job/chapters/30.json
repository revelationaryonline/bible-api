[
  {
    "id": 12385,
    "book": "job                                     ",
    "chapter": "30",
    "verse": "1",
    "text": "“Thế mà bây giờ người trẻ hơn tôi dám khinh nhạo tôi,"
  },
  {
    "id": 12386,
    "book": "job                                     ",
    "chapter": "30",
    "verse": "2",
    "text": "Nhưng họ có giúp ích gì cho tôi đâu—"
  },
  {
    "id": 12387,
    "book": "job                                     ",
    "chapter": "30",
    "verse": "3",
    "text": "Họ gầy đét vì đói khát"
  },
  {
    "id": 12388,
    "book": "job                                     ",
    "chapter": "30",
    "verse": "4",
    "text": "Họ ăn cả rễ lẫn lá"
  },
  {
    "id": 12389,
    "book": "job                                     ",
    "chapter": "30",
    "verse": "5",
    "text": "Họ bị gạt khỏi xã hội loài người,"
  },
  {
    "id": 12390,
    "book": "job                                     ",
    "chapter": "30",
    "verse": "6",
    "text": "Họ bị dồn vào khe núi hãi hùng,"
  },
  {
    "id": 12391,
    "book": "job                                     ",
    "chapter": "30",
    "verse": "7",
    "text": "Họ kêu la như thú giữa các bụi cây,"
  },
  {
    "id": 12392,
    "book": "job                                     ",
    "chapter": "30",
    "verse": "8",
    "text": "Họ là cặn bã xã hội,"
  },
  {
    "id": 12393,
    "book": "job                                     ",
    "chapter": "30",
    "verse": "9",
    "text": "Thế mà nay họ đặt vè giễu cợt!"
  },
  {
    "id": 12394,
    "book": "job                                     ",
    "chapter": "30",
    "verse": "10",
    "text": "Họ khinh miệt tôi, tránh né tôi,"
  },
  {
    "id": 12395,
    "book": "job                                     ",
    "chapter": "30",
    "verse": "11",
    "text": "Vì Đức Chúa Trời tước khí giới 30:11 Ctd tháo dây cung tôi."
  },
  {
    "id": 12396,
    "book": "job                                     ",
    "chapter": "30",
    "verse": "12",
    "text": "Bên phải tôi, một đám tạp dân xuất hiện."
  },
  {
    "id": 12397,
    "book": "job                                     ",
    "chapter": "30",
    "verse": "13",
    "text": "Họ phá hoại con đường tôi đi,"
  },
  {
    "id": 12398,
    "book": "job                                     ",
    "chapter": "30",
    "verse": "14",
    "text": "Họ kéo ùa vào từ mọi ngõ ngách."
  },
  {
    "id": 12399,
    "book": "job                                     ",
    "chapter": "30",
    "verse": "15",
    "text": "Bây giờ, tôi sống trong cơn khủng khiếp."
  },
  {
    "id": 12400,
    "book": "job                                     ",
    "chapter": "30",
    "verse": "16",
    "text": "Và bây giờ đời sống tôi tan chảy."
  },
  {
    "id": 12401,
    "book": "job                                     ",
    "chapter": "30",
    "verse": "17",
    "text": "Những đêm trường đầy dẫy đau thương,"
  },
  {
    "id": 12402,
    "book": "job                                     ",
    "chapter": "30",
    "verse": "18",
    "text": "Với đôi tay mạnh mẽ, Đức Chúa Trời nắm áo tôi."
  },
  {
    "id": 12403,
    "book": "job                                     ",
    "chapter": "30",
    "verse": "19",
    "text": "Chúa đã quăng tôi xuống bùn đen."
  },
  {
    "id": 12404,
    "book": "job                                     ",
    "chapter": "30",
    "verse": "20",
    "text": "Lạy Đức Chúa Trời, con kêu cầu, nhưng Ngài không đáp lại."
  },
  {
    "id": 12405,
    "book": "job                                     ",
    "chapter": "30",
    "verse": "21",
    "text": "Chúa trở thành tàn nhẫn với con."
  },
  {
    "id": 12406,
    "book": "job                                     ",
    "chapter": "30",
    "verse": "22",
    "text": "Chúa bốc con lên trước ngọn gió"
  },
  {
    "id": 12407,
    "book": "job                                     ",
    "chapter": "30",
    "verse": "23",
    "text": "Vì con biết Chúa sắp đưa con vào cõi chết—"
  },
  {
    "id": 12408,
    "book": "job                                     ",
    "chapter": "30",
    "verse": "24",
    "text": "Thật không ai có thể trở mặt chống người nghèo thiếu"
  },
  {
    "id": 12409,
    "book": "job                                     ",
    "chapter": "30",
    "verse": "25",
    "text": "Có phải tôi từng khóc vì người khốn khổ?"
  },
  {
    "id": 12410,
    "book": "job                                     ",
    "chapter": "30",
    "verse": "26",
    "text": "Thế mà khi mong phước, tôi chỉ gặp họa."
  },
  {
    "id": 12411,
    "book": "job                                     ",
    "chapter": "30",
    "verse": "27",
    "text": "Lòng dạ tôi sùng sục không chịu lặng yên."
  },
  {
    "id": 12412,
    "book": "job                                     ",
    "chapter": "30",
    "verse": "28",
    "text": "Tôi bước đi trong tăm tối, không ánh mặt trời."
  },
  {
    "id": 12413,
    "book": "job                                     ",
    "chapter": "30",
    "verse": "29",
    "text": "Thay vào đó, tôi trở thành anh em của chó rừng"
  },
  {
    "id": 12414,
    "book": "job                                     ",
    "chapter": "30",
    "verse": "30",
    "text": "Da tôi đen cháy và bong ra,"
  },
  {
    "id": 12415,
    "book": "job                                     ",
    "chapter": "30",
    "verse": "31",
    "text": "Tiếng đàn hạc tôi trở giọng bi ai,"
  }
]