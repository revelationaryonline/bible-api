[
  {
    "id": 11914,
    "book": "job                                     ",
    "chapter": "10",
    "verse": "1",
    "text": "Tôi đã chán ghét cuộc đời tôi."
  },
  {
    "id": 11915,
    "book": "job                                     ",
    "chapter": "10",
    "verse": "2",
    "text": "Tôi sẽ thưa với Đức Chúa Trời: “Xin đừng lên án con—"
  },
  {
    "id": 11916,
    "book": "job                                     ",
    "chapter": "10",
    "verse": "3",
    "text": "Chúa có vui không khi Ngài đàn áp con?"
  },
  {
    "id": 11917,
    "book": "job                                     ",
    "chapter": "10",
    "verse": "4",
    "text": "Không lẽ Chúa nhìn bằng con mắt của loài người?"
  },
  {
    "id": 11918,
    "book": "job                                     ",
    "chapter": "10",
    "verse": "5",
    "text": "Phải chăng đời Chúa chỉ dài bằng đời chúng con?"
  },
  {
    "id": 11919,
    "book": "job                                     ",
    "chapter": "10",
    "verse": "6",
    "text": "nên Ngài nhanh chóng truy tội ác con,"
  },
  {
    "id": 11920,
    "book": "job                                     ",
    "chapter": "10",
    "verse": "7",
    "text": "Cho dù Chúa biết con vô tội,"
  },
  {
    "id": 11921,
    "book": "job                                     ",
    "chapter": "10",
    "verse": "8",
    "text": "Chúa đã nắn con với đôi tay Ngài; Chúa tạo ra con,"
  },
  {
    "id": 11922,
    "book": "job                                     ",
    "chapter": "10",
    "verse": "9",
    "text": "Xin Chúa nhớ rằng Ngài đã tạo con từ bụi đất—"
  },
  {
    "id": 11923,
    "book": "job                                     ",
    "chapter": "10",
    "verse": "10",
    "text": "Chúa đã chỉ dẫn sự thai nghén con"
  },
  {
    "id": 11924,
    "book": "job                                     ",
    "chapter": "10",
    "verse": "11",
    "text": "Chúa đã bọc con bằng da và thịt,"
  },
  {
    "id": 11925,
    "book": "job                                     ",
    "chapter": "10",
    "verse": "12",
    "text": "Chúa cho con mạng sống và tình thương của Ngài."
  },
  {
    "id": 11926,
    "book": "job                                     ",
    "chapter": "10",
    "verse": "13",
    "text": "Tuy vậy, Chúa đã giấu những điều này trong lòng—"
  },
  {
    "id": 11927,
    "book": "job                                     ",
    "chapter": "10",
    "verse": "14",
    "text": "là để trông chừng con, nếu con phạm tội,"
  },
  {
    "id": 11928,
    "book": "job                                     ",
    "chapter": "10",
    "verse": "15",
    "text": "Nếu con làm ác, thật khốn cho con;"
  },
  {
    "id": 11929,
    "book": "job                                     ",
    "chapter": "10",
    "verse": "16",
    "text": "Nếu con đứng lên, Chúa sẽ vồ con như sư tử"
  },
  {
    "id": 11930,
    "book": "job                                     ",
    "chapter": "10",
    "verse": "17",
    "text": "Một lần rồi một lần nữa, Chúa đưa bằng chứng chống lại con."
  },
  {
    "id": 11931,
    "book": "job                                     ",
    "chapter": "10",
    "verse": "18",
    "text": "Vậy sao Chúa để con lọt lòng mẹ?"
  },
  {
    "id": 11932,
    "book": "job                                     ",
    "chapter": "10",
    "verse": "19",
    "text": "Được vậy con đã khỏi sống trên đời,"
  },
  {
    "id": 11933,
    "book": "job                                     ",
    "chapter": "10",
    "verse": "20",
    "text": "Con chỉ còn vài ngày còn lại, xin để con yên,"
  },
  {
    "id": 11934,
    "book": "job                                     ",
    "chapter": "10",
    "verse": "21",
    "text": "Trước khi con rời khỏi—không bao giờ trở lại—"
  },
  {
    "id": 11935,
    "book": "job                                     ",
    "chapter": "10",
    "verse": "22",
    "text": "Đó là cõi mịt mù như nửa đêm,"
  }
]