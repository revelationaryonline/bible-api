[
  {
    "id": 12217,
    "book": "job                                     ",
    "chapter": "22",
    "verse": "1",
    "text": "Ê-li-pha, người Thê-man lên tiếng:"
  },
  {
    "id": 12218,
    "book": "job                                     ",
    "chapter": "22",
    "verse": "2",
    "text": "“Con người có ích gì cho Đức Chúa Trời không?"
  },
  {
    "id": 12219,
    "book": "job                                     ",
    "chapter": "22",
    "verse": "3",
    "text": "Có ích gì cho Đấng Toàn Năng nếu anh sống công chính?"
  },
  {
    "id": 12220,
    "book": "job                                     ",
    "chapter": "22",
    "verse": "4",
    "text": "Có phải vì anh thiện hảo nên Ngài phạt anh"
  },
  {
    "id": 12221,
    "book": "job                                     ",
    "chapter": "22",
    "verse": "5",
    "text": "Không, nhưng chính vì anh gian ác!"
  },
  {
    "id": 12222,
    "book": "job                                     ",
    "chapter": "22",
    "verse": "6",
    "text": "Anh cho bạn bè mượn tiền"
  },
  {
    "id": 12223,
    "book": "job                                     ",
    "chapter": "22",
    "verse": "7",
    "text": "Anh từ chối cho nước người đang khát,"
  },
  {
    "id": 12224,
    "book": "job                                     ",
    "chapter": "22",
    "verse": "8",
    "text": "Còn người quyền thế được sở hữu đất đai"
  },
  {
    "id": 12225,
    "book": "job                                     ",
    "chapter": "22",
    "verse": "9",
    "text": "Người góa bụa anh đuổi đi tay trắng,"
  },
  {
    "id": 12226,
    "book": "job                                     ",
    "chapter": "22",
    "verse": "10",
    "text": "Vì thế, chung quanh anh có đầy cạm bẫy"
  },
  {
    "id": 12227,
    "book": "job                                     ",
    "chapter": "22",
    "verse": "11",
    "text": "Tăm tối phủ bao nên mắt anh không thấy,"
  },
  {
    "id": 12228,
    "book": "job                                     ",
    "chapter": "22",
    "verse": "12",
    "text": "Đức Chúa Trời vô cùng oai vệ—cao hơn các tầng trời,"
  },
  {
    "id": 12229,
    "book": "job                                     ",
    "chapter": "22",
    "verse": "13",
    "text": "Nhưng anh đáp: ‘Vì vậy mà Đức Chúa Trời không thấy những việc tôi làm!"
  },
  {
    "id": 12230,
    "book": "job                                     ",
    "chapter": "22",
    "verse": "14",
    "text": "Mây đen bao phủ quanh Ngài nên Ngài chẳng thấy chúng ta."
  },
  {
    "id": 12231,
    "book": "job                                     ",
    "chapter": "22",
    "verse": "15",
    "text": "Anh sẽ tiếp tục theo lề lối cũ"
  },
  {
    "id": 12232,
    "book": "job                                     ",
    "chapter": "22",
    "verse": "16",
    "text": "Chúng đều bị tống khứ trước kỳ hạn,"
  },
  {
    "id": 12233,
    "book": "job                                     ",
    "chapter": "22",
    "verse": "17",
    "text": "Chúng nói với Đức Chúa Trời: ‘Hãy bỏ mặc chúng tôi!"
  },
  {
    "id": 12234,
    "book": "job                                     ",
    "chapter": "22",
    "verse": "18",
    "text": "Thế mà Chúa vẫn cho nhà chúng đầy vật tốt,"
  },
  {
    "id": 12235,
    "book": "job                                     ",
    "chapter": "22",
    "verse": "19",
    "text": "Người công chính vui mừng khi kẻ ác bị phạt,"
  },
  {
    "id": 12236,
    "book": "job                                     ",
    "chapter": "22",
    "verse": "20",
    "text": "Họ sẽ nói: ‘Hãy xem kẻ thù nghịch ta bị quét sạch."
  },
  {
    "id": 12237,
    "book": "job                                     ",
    "chapter": "22",
    "verse": "21",
    "text": "Hãy quy phục Đức Chúa Trời, và anh sẽ được bình an;"
  },
  {
    "id": 12238,
    "book": "job                                     ",
    "chapter": "22",
    "verse": "22",
    "text": "Hãy lắng nghe luật miệng Ngài tuyên phán,"
  },
  {
    "id": 12239,
    "book": "job                                     ",
    "chapter": "22",
    "verse": "23",
    "text": "Nếu anh trở về với Đấng Toàn Năng, anh sẽ được phục hồi—"
  },
  {
    "id": 12240,
    "book": "job                                     ",
    "chapter": "22",
    "verse": "24",
    "text": "Nếu anh chịu ném bảo vật xuống cát bụi"
  },
  {
    "id": 12241,
    "book": "job                                     ",
    "chapter": "22",
    "verse": "25",
    "text": "thì Đấng Toàn Năng sẽ thành kho báu của anh."
  },
  {
    "id": 12242,
    "book": "job                                     ",
    "chapter": "22",
    "verse": "26",
    "text": "Trong Đấng Toàn Năng, anh được niềm vui sướng vô biên,"
  },
  {
    "id": 12243,
    "book": "job                                     ",
    "chapter": "22",
    "verse": "27",
    "text": "Khi ấy, anh cầu xin Chúa mới nhậm lời,"
  },
  {
    "id": 12244,
    "book": "job                                     ",
    "chapter": "22",
    "verse": "28",
    "text": "Khi ấy, anh ước gì được nấy,"
  },
  {
    "id": 12245,
    "book": "job                                     ",
    "chapter": "22",
    "verse": "29",
    "text": "Nếu có người gặp hoạn nạn, anh nói: ‘Xin giúp họ,’"
  },
  {
    "id": 12246,
    "book": "job                                     ",
    "chapter": "22",
    "verse": "30",
    "text": "Dù kẻ có tội cũng sẽ được cứu;"
  }
]