[
  {
    "id": 11857,
    "book": "job                                     ",
    "chapter": "8",
    "verse": "1",
    "text": "Kế đến, Binh-đát, người Su-a, trả lời Gióp:"
  },
  {
    "id": 11858,
    "book": "job                                     ",
    "chapter": "8",
    "verse": "2",
    "text": "“Anh nói mãi những điều ấy cho đến khi nào?"
  },
  {
    "id": 11859,
    "book": "job                                     ",
    "chapter": "8",
    "verse": "3",
    "text": "Có khi nào Đức Chúa Trời bẻ cong công lý?"
  },
  {
    "id": 11860,
    "book": "job                                     ",
    "chapter": "8",
    "verse": "4",
    "text": "Con cái anh chắc đã phạm tội với Chúa,"
  },
  {
    "id": 11861,
    "book": "job                                     ",
    "chapter": "8",
    "verse": "5",
    "text": "Nhưng nếu anh kêu cầu Đức Chúa Trời"
  },
  {
    "id": 11862,
    "book": "job                                     ",
    "chapter": "8",
    "verse": "6",
    "text": "nếu anh trong sạch và sống ngay lành,"
  },
  {
    "id": 11863,
    "book": "job                                     ",
    "chapter": "8",
    "verse": "7",
    "text": "Dù mới đầu chẳng có bao nhiêu,"
  },
  {
    "id": 11864,
    "book": "job                                     ",
    "chapter": "8",
    "verse": "8",
    "text": "Hãy hỏi các thế hệ đi trước."
  },
  {
    "id": 11865,
    "book": "job                                     ",
    "chapter": "8",
    "verse": "9",
    "text": "Vì chúng ta mới ra đời hôm qua nên chẳng biết chi."
  },
  {
    "id": 11866,
    "book": "job                                     ",
    "chapter": "8",
    "verse": "10",
    "text": "Nhưng những người đến trước chúng ta sẽ dạy dỗ anh."
  },
  {
    "id": 11867,
    "book": "job                                     ",
    "chapter": "8",
    "verse": "11",
    "text": "Có thể nào cây cói giấy mọc nơi không đầm lầy?"
  },
  {
    "id": 11868,
    "book": "job                                     ",
    "chapter": "8",
    "verse": "12",
    "text": "Trong khi chúng vẫn còn xanh tươi, chưa bị cắt bỏ,"
  },
  {
    "id": 11869,
    "book": "job                                     ",
    "chapter": "8",
    "verse": "13",
    "text": "Số phận người quên Đức Chúa Trời cũng thế,"
  },
  {
    "id": 11870,
    "book": "job                                     ",
    "chapter": "8",
    "verse": "14",
    "text": "Những điều họ tin tưởng thật mong manh."
  },
  {
    "id": 11871,
    "book": "job                                     ",
    "chapter": "8",
    "verse": "15",
    "text": "Họ níu lấy nhà mình, nhưng nó không vững."
  },
  {
    "id": 11872,
    "book": "job                                     ",
    "chapter": "8",
    "verse": "16",
    "text": "Người vô thần như cây xanh tốt trong nắng ấm,"
  },
  {
    "id": 11873,
    "book": "job                                     ",
    "chapter": "8",
    "verse": "17",
    "text": "Rễ cây ăn sâu quanh đống đá;"
  },
  {
    "id": 11874,
    "book": "job                                     ",
    "chapter": "8",
    "verse": "18",
    "text": "Nhưng khi cây bị nhổ lên,"
  },
  {
    "id": 11875,
    "book": "job                                     ",
    "chapter": "8",
    "verse": "19",
    "text": "Đó là luật chung của muôn loài,"
  },
  {
    "id": 11876,
    "book": "job                                     ",
    "chapter": "8",
    "verse": "20",
    "text": "Nhưng kìa, Đức Chúa Trời chẳng bỏ người ngay lành,"
  },
  {
    "id": 11877,
    "book": "job                                     ",
    "chapter": "8",
    "verse": "21",
    "text": "Chúa sẽ cho miệng anh đầy tiếng cười"
  },
  {
    "id": 11878,
    "book": "job                                     ",
    "chapter": "8",
    "verse": "22",
    "text": "Những ai ghét anh sẽ hổ thẹn cúi đầu,"
  }
]