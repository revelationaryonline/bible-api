[
  {
    "id": 11732,
    "book": "job                                     ",
    "chapter": "3",
    "verse": "1",
    "text": "Cuối cùng Gióp cũng mở miệng, và ông nguyền rủa ngày sinh của mình."
  },
  {
    "id": 11733,
    "book": "job                                     ",
    "chapter": "3",
    "verse": "2",
    "text": "Ông nói:"
  },
  {
    "id": 11734,
    "book": "job                                     ",
    "chapter": "3",
    "verse": "3",
    "text": "“Ước gì ngày sinh của ta tan mất đi,"
  },
  {
    "id": 11735,
    "book": "job                                     ",
    "chapter": "3",
    "verse": "4",
    "text": "Nguyện ngày ấy là ngày tăm tối."
  },
  {
    "id": 11736,
    "book": "job                                     ",
    "chapter": "3",
    "verse": "5",
    "text": "Nguyện bóng tối và tử vong chuộc ngày ấy lại."
  },
  {
    "id": 11737,
    "book": "job                                     ",
    "chapter": "3",
    "verse": "6",
    "text": "Nguyện đêm ấy bị lấy ra khỏi lịch,"
  },
  {
    "id": 11738,
    "book": "job                                     ",
    "chapter": "3",
    "verse": "7",
    "text": "Nguyện đêm ấy ra hoang vu tẻ lạnh;"
  },
  {
    "id": 11739,
    "book": "job                                     ",
    "chapter": "3",
    "verse": "8",
    "text": "Nguyện những ai hay báng bổ—"
  },
  {
    "id": 11740,
    "book": "job                                     ",
    "chapter": "3",
    "verse": "9",
    "text": "Nguyện những sao mai cứ tối tăm mãi."
  },
  {
    "id": 11741,
    "book": "job                                     ",
    "chapter": "3",
    "verse": "10",
    "text": "Ngày đáng nguyền rủa cho mẹ hoài thai"
  },
  {
    "id": 11742,
    "book": "job                                     ",
    "chapter": "3",
    "verse": "11",
    "text": "Sao tôi không chết đi khi sinh ra?"
  },
  {
    "id": 11743,
    "book": "job                                     ",
    "chapter": "3",
    "verse": "12",
    "text": "Sao tôi được nằm trên lòng của mẹ tôi?"
  },
  {
    "id": 11744,
    "book": "job                                     ",
    "chapter": "3",
    "verse": "13",
    "text": "Nếu tôi chết khi sinh, thì nay tôi được bình yên."
  },
  {
    "id": 11745,
    "book": "job                                     ",
    "chapter": "3",
    "verse": "14",
    "text": "Tôi có thể an nghỉ với các vua và các vương hầu thế gian,"
  },
  {
    "id": 11746,
    "book": "job                                     ",
    "chapter": "3",
    "verse": "15",
    "text": "Tôi có thể an nghỉ với các hoàng tử có đầy vàng,"
  },
  {
    "id": 11747,
    "book": "job                                     ",
    "chapter": "3",
    "verse": "16",
    "text": "Sao tôi không được chôn như đứa trẻ sơ sinh,"
  },
  {
    "id": 11748,
    "book": "job                                     ",
    "chapter": "3",
    "verse": "17",
    "text": "Vì trong cõi chết, kẻ ác thôi gây phiền muộn,"
  },
  {
    "id": 11749,
    "book": "job                                     ",
    "chapter": "3",
    "verse": "18",
    "text": "Ngay cả tù nhân cũng được thảnh thơi trong cõi chết,"
  },
  {
    "id": 11750,
    "book": "job                                     ",
    "chapter": "3",
    "verse": "19",
    "text": "Người giàu và người nghèo đều ở đó,"
  },
  {
    "id": 11751,
    "book": "job                                     ",
    "chapter": "3",
    "verse": "20",
    "text": "Ôi, tại sao ban ánh sáng cho người khốn khổ,"
  },
  {
    "id": 11752,
    "book": "job                                     ",
    "chapter": "3",
    "verse": "21",
    "text": "Họ trông mong chết, nhưng cái chết không đến."
  },
  {
    "id": 11753,
    "book": "job                                     ",
    "chapter": "3",
    "verse": "22",
    "text": "Lòng tràn đầy mừng vui khi cuối cùng được chết,"
  },
  {
    "id": 11754,
    "book": "job                                     ",
    "chapter": "3",
    "verse": "23",
    "text": "Sao ban sự sống cho người không có tương lai,"
  },
  {
    "id": 11755,
    "book": "job                                     ",
    "chapter": "3",
    "verse": "24",
    "text": "Tôi không thể ăn được vì than thở;"
  },
  {
    "id": 11756,
    "book": "job                                     ",
    "chapter": "3",
    "verse": "25",
    "text": "Những gì tôi sợ đã phủ lên tôi."
  },
  {
    "id": 11757,
    "book": "job                                     ",
    "chapter": "3",
    "verse": "26",
    "text": "Tôi không có bình an, không yên tịnh."
  }
]