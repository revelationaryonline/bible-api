[
  {
    "id": 12031,
    "book": "job                                     ",
    "chapter": "15",
    "verse": "1",
    "text": "Rồi Ê-li-pha, người xứ Thê-man đáp:"
  },
  {
    "id": 12032,
    "book": "job                                     ",
    "chapter": "15",
    "verse": "2",
    "text": "“Người khôn ngoan không đối đáp vu vơ!"
  },
  {
    "id": 12033,
    "book": "job                                     ",
    "chapter": "15",
    "verse": "3",
    "text": "Người khôn không lập luận vô bổ."
  },
  {
    "id": 12034,
    "book": "job                                     ",
    "chapter": "15",
    "verse": "4",
    "text": "Lẽ nào anh không sợ Đức Chúa Trời,"
  },
  {
    "id": 12035,
    "book": "job                                     ",
    "chapter": "15",
    "verse": "5",
    "text": "Tội lỗi anh dạy miệng anh nói."
  },
  {
    "id": 12036,
    "book": "job                                     ",
    "chapter": "15",
    "verse": "6",
    "text": "Miệng anh lên án anh, không phải tôi."
  },
  {
    "id": 12037,
    "book": "job                                     ",
    "chapter": "15",
    "verse": "7",
    "text": "Phải chăng anh là người sinh ra đầu tiên?"
  },
  {
    "id": 12038,
    "book": "job                                     ",
    "chapter": "15",
    "verse": "8",
    "text": "Có phải anh nghe được cuộc luận bàn của Đức Chúa Trời?"
  },
  {
    "id": 12039,
    "book": "job                                     ",
    "chapter": "15",
    "verse": "9",
    "text": "Có gì anh biết mà chúng tôi không rõ?"
  },
  {
    "id": 12040,
    "book": "job                                     ",
    "chapter": "15",
    "verse": "10",
    "text": "Giữa chúng ta có người cao tuổi, có người tóc bạc,"
  },
  {
    "id": 12041,
    "book": "job                                     ",
    "chapter": "15",
    "verse": "11",
    "text": "Lời an ủi của Đức Chúa Trời quá ít cho anh sao?"
  },
  {
    "id": 12042,
    "book": "job                                     ",
    "chapter": "15",
    "verse": "12",
    "text": "Vì sao lòng anh bấn loạn?"
  },
  {
    "id": 12043,
    "book": "job                                     ",
    "chapter": "15",
    "verse": "13",
    "text": "đến nỗi anh chống lại Đức Chúa Trời"
  },
  {
    "id": 12044,
    "book": "job                                     ",
    "chapter": "15",
    "verse": "14",
    "text": "Có thể nào loài người được kể là thanh sạch?"
  },
  {
    "id": 12045,
    "book": "job                                     ",
    "chapter": "15",
    "verse": "15",
    "text": "Này! Đức Chúa Trời không tin cậy dù là thiên sứ."
  },
  {
    "id": 12046,
    "book": "job                                     ",
    "chapter": "15",
    "verse": "16",
    "text": "Huống chi con người thối nát và tội lỗi"
  },
  {
    "id": 12047,
    "book": "job                                     ",
    "chapter": "15",
    "verse": "17",
    "text": "Nếu anh có nghe thì tôi mới trình bày."
  },
  {
    "id": 12048,
    "book": "job                                     ",
    "chapter": "15",
    "verse": "18",
    "text": "Cũng là điều các hiền triết đã xác nhận"
  },
  {
    "id": 12049,
    "book": "job                                     ",
    "chapter": "15",
    "verse": "19",
    "text": "từ những người được ban cho đất"
  },
  {
    "id": 12050,
    "book": "job                                     ",
    "chapter": "15",
    "verse": "20",
    "text": "Vì kẻ gian ác suốt đời luôn sầu khổ."
  },
  {
    "id": 12051,
    "book": "job                                     ",
    "chapter": "15",
    "verse": "21",
    "text": "Tai thường nghe những tiếng dữ dằn,"
  },
  {
    "id": 12052,
    "book": "job                                     ",
    "chapter": "15",
    "verse": "22",
    "text": "Chúng không dám đi vào nơi tăm tối"
  },
  {
    "id": 12053,
    "book": "job                                     ",
    "chapter": "15",
    "verse": "23",
    "text": "Chúng chạy lang thang và nói: ‘Tôi tìm bánh ở đâu?’"
  },
  {
    "id": 12054,
    "book": "job                                     ",
    "chapter": "15",
    "verse": "24",
    "text": "Ngày đen tối làm chúng hoảng kinh."
  },
  {
    "id": 12055,
    "book": "job                                     ",
    "chapter": "15",
    "verse": "25",
    "text": "Vì chúng đã đưa tay ra chống Đức Chúa Trời,"
  },
  {
    "id": 12056,
    "book": "job                                     ",
    "chapter": "15",
    "verse": "26",
    "text": "Nắm chặt chiếc khiên cứng cáp,"
  },
  {
    "id": 12057,
    "book": "job                                     ",
    "chapter": "15",
    "verse": "27",
    "text": "Che phủ mặt mình bằng lớp mỡ;"
  },
  {
    "id": 12058,
    "book": "job                                     ",
    "chapter": "15",
    "verse": "28",
    "text": "Nhưng thành chúng sẽ bị đổ nát."
  },
  {
    "id": 12059,
    "book": "job                                     ",
    "chapter": "15",
    "verse": "29",
    "text": "Dù có của, cũng không bền giữ,"
  },
  {
    "id": 12060,
    "book": "job                                     ",
    "chapter": "15",
    "verse": "30",
    "text": "Chúng sẽ chẳng hề thoát được cảnh tối tăm."
  },
  {
    "id": 12061,
    "book": "job                                     ",
    "chapter": "15",
    "verse": "31",
    "text": "Đừng lừa dối mình bằng sự tin cậy vào điều hư ảo,"
  },
  {
    "id": 12062,
    "book": "job                                     ",
    "chapter": "15",
    "verse": "32",
    "text": "Như cây sẽ bị đốn xuống trước kỳ hạn;"
  },
  {
    "id": 12063,
    "book": "job                                     ",
    "chapter": "15",
    "verse": "33",
    "text": "Chúng sẽ như cây nho rụng trái non,"
  },
  {
    "id": 12064,
    "book": "job                                     ",
    "chapter": "15",
    "verse": "34",
    "text": "Vì kẻ vô đạo không có hậu tự."
  },
  {
    "id": 12065,
    "book": "job                                     ",
    "chapter": "15",
    "verse": "35",
    "text": "Chúng cưu mang tội ác và sinh điều tàn bạo,"
  }
]