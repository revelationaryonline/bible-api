[
  {
    "id": 12597,
    "book": "job                                     ",
    "chapter": "37",
    "verse": "1",
    "text": "“Tim tôi run rẩy trước cảnh tượng uy nghiêm."
  },
  {
    "id": 12598,
    "book": "job                                     ",
    "chapter": "37",
    "verse": "2",
    "text": "Hãy lắng nghe tiếng Đức Chúa Trời vang rền như sấm,"
