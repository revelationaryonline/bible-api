[
  {
    "id": 24371,
    "book": "psalms                                  ",
    "chapter": "99",
    "verse": "1",
    "text": "Chúa Hằng Hữu là Vua!"
  },
  {
    "id": 24372,
    "book": "psalms                                  ",
    "chapter": "99",
    "verse": "2",
    "text": "Giữa Si-ôn, Chúa Hằng Hữu oai nghi,"
  },
  {
    "id": 24373,
    "book": "psalms                                  ",
    "chapter": "99",
    "verse": "3",
    "text": "Hãy ngợi tôn sự vĩ đại và Danh đáng sợ của Ngài."
  },
  {
    "id": 24374,
    "book": "psalms                                  ",
    "chapter": "99",
    "verse": "4",
    "text": "Vua rất uy dũng, Đấng yêu công lý,"
  },
  {
    "id": 24375,
    "book": "psalms                                  ",
    "chapter": "99",
    "verse": "5",
    "text": "Hãy tán dương Chúa Hằng Hữu, Đức Chúa Trời chúng ta!"
  },
  {
    "id": 24376,
    "book": "psalms                                  ",
    "chapter": "99",
    "verse": "6",
    "text": "Môi-se và A-rôn ở giữa các thầy tế lễ của Chúa;"
  },
  {
    "id": 24377,
    "book": "psalms                                  ",
    "chapter": "99",
    "verse": "7",
    "text": "Từ trụ mây Chúa phán với Ít-ra-ên,"
  },
  {
    "id": 24378,
    "book": "psalms                                  ",
    "chapter": "99",
    "verse": "8",
    "text": "Chúa Hằng Hữu, Đức Chúa Trời chúng con đã đáp lời họ."
  },
  {
    "id": 24379,
    "book": "psalms                                  ",
    "chapter": "99",
    "verse": "9",
    "text": "Hãy suy tôn Chúa Hằng Hữu, Đức Chúa Trời chúng ta,"
  }
]