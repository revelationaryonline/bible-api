[
  {
    "id": 24393,
    "book": "psalms                                  ",
    "chapter": "102",
    "verse": "1",
    "text": "Lạy Chúa Hằng Hữu, xin nghe con cầu nguyện!"
  },
  {
    "id": 24394,
    "book": "psalms                                  ",
    "chapter": "102",
    "verse": "2",
    "text": "Xin đừng ngoảnh mặt"
  },
  {
    "id": 24395,
    "book": "psalms                                  ",
    "chapter": "102",
    "verse": "3",
    "text": "Ngày tháng đời con tan như khói,"
  },
  {
    "id": 24396,
    "book": "psalms                                  ",
    "chapter": "102",
    "verse": "4",
    "text": "Lòng con đau đớn héo mòn như cỏ,"
  },
  {
    "id": 24397,
    "book": "psalms                                  ",
    "chapter": "102",
    "verse": "5",
    "text": "Vì con rên siết mãi,"
  },
  {
    "id": 24398,
    "book": "psalms                                  ",
    "chapter": "102",
    "verse": "6",
    "text": "Con như chim cú nơi hoang mạc,"
  },
  {
    "id": 24399,
    "book": "psalms                                  ",
    "chapter": "102",
    "verse": "7",
    "text": "Con mất ngủ, suốt đêm trằn trọc,"
  },
  {
    "id": 24400,
    "book": "psalms                                  ",
    "chapter": "102",
    "verse": "8",
    "text": "Bao kẻ thù chẳng ngớt lời sỉ nhục."
  },
  {
    "id": 24401,
    "book": "psalms                                  ",
    "chapter": "102",
    "verse": "9",
    "text": "Thay vì bánh, con nuốt tro tàn."
  },
  {
    "id": 24402,
    "book": "psalms                                  ",
    "chapter": "102",
    "verse": "10",
    "text": "vì Chúa đã nổi cơn giận."
  },
  {
    "id": 24403,
    "book": "psalms                                  ",
    "chapter": "102",
    "verse": "11",
    "text": "Ngày tháng đời con như bóng xế chiều."
  },
  {
    "id": 24404,
    "book": "psalms                                  ",
    "chapter": "102",
    "verse": "12",
    "text": "Nhưng Chúa Hằng Hữu vẫn bất diệt trường tồn."
  },
  {
    "id": 24405,
    "book": "psalms                                  ",
    "chapter": "102",
    "verse": "13",
    "text": "Chúa sẽ trỗi dậy, thương xót Si-ôn—"
  },
  {
    "id": 24406,
    "book": "psalms                                  ",
    "chapter": "102",
    "verse": "14",
    "text": "Vì người của Chúa mến yêu từng tảng đá nó,"
  },
  {
    "id": 24407,
    "book": "psalms                                  ",
    "chapter": "102",
    "verse": "15",
    "text": "Các dân tộc trần gian sẽ sợ trước Chúa Hằng Hữu."
  },
  {
    "id": 24408,
    "book": "psalms                                  ",
    "chapter": "102",
    "verse": "16",
    "text": "Vì Chúa Hằng Hữu sẽ tái thiết Si-ôn,"
  },
  {
    "id": 24409,
    "book": "psalms                                  ",
    "chapter": "102",
    "verse": "17",
    "text": "Chúa quay lại, nghe người khốn cùng cầu khẩn."
  },
  {
    "id": 24410,
    "book": "psalms                                  ",
    "chapter": "102",
    "verse": "18",
    "text": "Sự kiện này sẽ được ghi cho hậu thế,"
  },
  {
    "id": 24411,
    "book": "psalms                                  ",
    "chapter": "102",
    "verse": "19",
    "text": "Từ nơi thánh trên trời"
  },
  {
    "id": 24412,
    "book": "psalms                                  ",
    "chapter": "102",
    "verse": "20",
    "text": "để tai nghe lời tù nhân than thở,"
  },
  {
    "id": 24413,
    "book": "psalms                                  ",
    "chapter": "102",
    "verse": "21",
    "text": "Như thế, người ta sẽ tuyên xưng Danh Chúa tại Si-ôn,"
  },
  {
    "id": 24414,
    "book": "psalms                                  ",
    "chapter": "102",
    "verse": "22",
    "text": "khi muôn dân muôn nước tập họp"
  },
  {
    "id": 24415,
    "book": "psalms                                  ",
    "chapter": "102",
    "verse": "23",
    "text": "Sức lực con, Chúa giảm giữa dòng đời,"
  },
  {
    "id": 24416,
    "book": "psalms                                  ",
    "chapter": "102",
    "verse": "24",
    "text": "Nhưng con thưa: “Lạy Đức Chúa Trời, Đấng sống đời đời,"
  },
  {
    "id": 24417,
    "book": "psalms                                  ",
    "chapter": "102",
    "verse": "25",
    "text": "Từ vạn cổ, Chúa đặt nền quả đất,"
  },
  {
    "id": 24418,
    "book": "psalms                                  ",
    "chapter": "102",
    "verse": "26",
    "text": "Trời đất sẽ tiêu tan nhưng Chúa hằng còn."
  },
  {
    "id": 24419,
    "book": "psalms                                  ",
    "chapter": "102",
    "verse": "27",
    "text": "Nhưng Chúa vẫn là Chúa Hằng Hữu,"
  },
  {
    "id": 24420,
    "book": "psalms                                  ",
    "chapter": "102",
    "verse": "28",
    "text": "Con cháu của đầy tớ Chúa"
  }
]