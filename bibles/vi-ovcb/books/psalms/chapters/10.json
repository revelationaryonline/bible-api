[
  {
    "id": 22913,
    "book": "psalms                                  ",
    "chapter": "10",
    "verse": "1",
    "text": "Chúa Hằng Hữu, Ngài ở tận nơi đâu?"
  },
  {
    "id": 22914,
    "book": "psalms                                  ",
    "chapter": "10",
    "verse": "2",
    "text": "Vì kiêu ngạo, người ác hăm hở đuổi theo người bị hại."
  },
  {
    "id": 22915,
    "book": "psalms                                  ",
    "chapter": "10",
    "verse": "3",
    "text": "Bọn người ác khoe khoang về dục vọng;"
  },
  {
    "id": 22916,
    "book": "psalms                                  ",
    "chapter": "10",
    "verse": "4",
    "text": "Người ác kiêu ngạo không tìm kiếm Đức Chúa Trời."
  },
  {
    "id": 22917,
    "book": "psalms                                  ",
    "chapter": "10",
    "verse": "5",
    "text": "Vì đường lối họ thành công luôn."
  },
  {
    "id": 22918,
    "book": "psalms                                  ",
    "chapter": "10",
    "verse": "6",
    "text": "Họ tự nhủ: “Chẳng bao giờ ta bị chao đảo!"
  },
  {
    "id": 22919,
    "book": "psalms                                  ",
    "chapter": "10",
    "verse": "7",
    "text": "Miệng đầy lời chửi rủa, dối trá, và đe dọa."
  },
  {
    "id": 22920,
    "book": "psalms                                  ",
    "chapter": "10",
    "verse": "8",
    "text": "Họ rình rập nơi thôn làng,"
  },
  {
    "id": 22921,
    "book": "psalms                                  ",
    "chapter": "10",
    "verse": "9",
    "text": "Họ nằm yên như sư tử ngụy trang,"
  },
  {
    "id": 22922,
    "book": "psalms                                  ",
    "chapter": "10",
    "verse": "10",
    "text": "Các nạn nhân cô thế bị chà nát;"
  },
  {
    "id": 22923,
    "book": "psalms                                  ",
    "chapter": "10",
    "verse": "11",
    "text": "Người ác nhủ thầm: “Chúa chẳng xem việc chúng ta đâu!"
  },
  {
    "id": 22924,
    "book": "psalms                                  ",
    "chapter": "10",
    "verse": "12",
    "text": "Chúa Hằng Hữu, xin trỗi dậy!"
  },
  {
    "id": 22925,
    "book": "psalms                                  ",
    "chapter": "10",
    "verse": "13",
    "text": "Sao để cho ác nhân phỉ báng Đức Chúa Trời?"
  },
  {
    "id": 22926,
    "book": "psalms                                  ",
    "chapter": "10",
    "verse": "14",
    "text": "Nhưng lạy Chúa, Chúa thấy rõ những khó khăn sầu khổ."
  },
  {
    "id": 22927,
    "book": "psalms                                  ",
    "chapter": "10",
    "verse": "15",
    "text": "Xin bẻ gãy cánh tay người độc hại và gian ác!"
  },
  {
    "id": 22928,
    "book": "psalms                                  ",
    "chapter": "10",
    "verse": "16",
    "text": "Chúa Hằng Hữu là Vua muôn đời!"
  },
  {
    "id": 22929,
    "book": "psalms                                  ",
    "chapter": "10",
    "verse": "17",
    "text": "Chúa Hằng Hữu đã nghe ước nguyện người khốn khổ."
  },
  {
    "id": 22930,
    "book": "psalms                                  ",
    "chapter": "10",
    "verse": "18",
    "text": "Ngài bênh vực người bị áp bức và mồ côi,"
  }
]