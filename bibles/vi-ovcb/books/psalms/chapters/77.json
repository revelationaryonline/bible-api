[
  {
    "id": 23965,
    "book": "psalms                                  ",
    "chapter": "77",
    "verse": "1",
    "text": "Con kêu cầu Đức Chúa Trời; phải, con kêu la."
  },
  {
    "id": 23966,
    "book": "psalms                                  ",
    "chapter": "77",
    "verse": "2",
    "text": "Khi lâm cảnh nguy nan,"
  },
  {
    "id": 23967,
    "book": "psalms                                  ",
    "chapter": "77",
    "verse": "3",
    "text": "Khi nghĩ đến Đức Chúa Trời, và con rên rỉ,"
  },
  {
    "id": 23968,
    "book": "psalms                                  ",
    "chapter": "77",
    "verse": "4",
    "text": "Chúa khiến con thức thâu đêm."
  },
  {
    "id": 23969,
    "book": "psalms                                  ",
    "chapter": "77",
    "verse": "5",
    "text": "Con nghĩ đến những ngày dĩ vãng,"
  },
  {
    "id": 23970,
    "book": "psalms                                  ",
    "chapter": "77",
    "verse": "6",
    "text": "suốt đêm con nhớ lại các bài hát."
  },
  {
    "id": 23971,
    "book": "psalms                                  ",
    "chapter": "77",
    "verse": "7",
    "text": "Chúng con sẽ bị Ngài loại bỏ mãi sao?"
  },
  {
    "id": 23972,
    "book": "psalms                                  ",
    "chapter": "77",
    "verse": "8",
    "text": "Phải chăng tình thương không dời đổi của Ngài đã biến mất?"
  },
  {
    "id": 23973,
    "book": "psalms                                  ",
    "chapter": "77",
    "verse": "9",
    "text": "Hay Đức Chúa Trời đã quên ban ân phước?"
  },
  {
    "id": 23974,
    "book": "psalms                                  ",
    "chapter": "77",
    "verse": "10",
    "text": "Rồi con nói: “Đây là số phận của con;"
  },
  {
    "id": 23975,
    "book": "psalms                                  ",
    "chapter": "77",
    "verse": "11",
    "text": "Nhưng rồi con nhắc lại các công việc Chúa, lạy Chúa Hằng Hữu;"
  },
  {
    "id": 23976,
    "book": "psalms                                  ",
    "chapter": "77",
    "verse": "12",
    "text": "Con sẽ suy nghiệm về tất cả kỳ công."
  },
  {
    "id": 23977,
    "book": "psalms                                  ",
    "chapter": "77",
    "verse": "13",
    "text": "Lạy Đức Chúa Trời, những việc Chúa làm đều thánh khiết."
  },
  {
    "id": 23978,
    "book": "psalms                                  ",
    "chapter": "77",
    "verse": "14",
    "text": "Chúa là Đức Chúa Trời vĩ đại diệu kỳ!"
  },
  {
    "id": 23979,
    "book": "psalms                                  ",
    "chapter": "77",
    "verse": "15",
    "text": "Với cánh tay mạnh mẽ, Chúa cứu chuộc dân Ngài,"
  },
  {
    "id": 23980,
    "book": "psalms                                  ",
    "chapter": "77",
    "verse": "16",
    "text": "Khi thấy Chúa, lạy Đức Chúa Trời,"
  },
  {
    "id": 23981,
    "book": "psalms                                  ",
    "chapter": "77",
    "verse": "17",
    "text": "Các áng mây vội vã trút cơn mưa;"
  },
  {
    "id": 23982,
    "book": "psalms                                  ",
    "chapter": "77",
    "verse": "18",
    "text": "Sấm nổi ầm ầm trong gió trốt;"
  },
  {
    "id": 23983,
    "book": "psalms                                  ",
    "chapter": "77",
    "verse": "19",
    "text": "Con đường Chúa ngang qua biển cả,"
  },
  {
    "id": 23984,
    "book": "psalms                                  ",
    "chapter": "77",
    "verse": "20",
    "text": "Chúa dẫn dắt dân Ngài như đàn chiên,"
  }
]