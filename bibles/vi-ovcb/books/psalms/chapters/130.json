    "chapter": "130",
    "verse": "1",
    "text": "Từ vực thẳm, lạy Chúa Hằng Hữu,"
  },
  {
    "id": 25013,
    "book": "psalms                                  ",
    "chapter": "130",
    "verse": "2",
    "text": "Xin lắng tai nghe, lạy Chúa."
  },
  {
    "id": 25014,
    "book": "psalms                                  ",
    "chapter": "130",
    "verse": "3",
    "text": "Lạy Chúa Hằng Hữu, nếu Ngài ghi nhớ tội ác chúng con,"
