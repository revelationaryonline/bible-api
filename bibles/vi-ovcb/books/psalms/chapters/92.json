[
  {
    "id": 24283,
    "book": "psalms                                  ",
    "chapter": "92",
    "verse": "1",
    "text": "Còn gì hơn cảm tạ Chúa Hằng Hữu,"
  },
  {
    "id": 24284,
    "book": "psalms                                  ",
    "chapter": "92",
    "verse": "2",
    "text": "Công bố lòng nhân ái Ngài khi trời vừa sáng,"
  },
  {
    "id": 24285,
    "book": "psalms                                  ",
    "chapter": "92",
    "verse": "3",
    "text": "với đàn hạc, tiếng tơ thánh thót,"
  },
  {
    "id": 24286,
    "book": "psalms                                  ",
    "chapter": "92",
    "verse": "4",
    "text": "Lạy Chúa Hằng Hữu, lòng con hớn hở vì việc Chúa làm cho con!"
  },
  {
    "id": 24287,
    "book": "psalms                                  ",
    "chapter": "92",
    "verse": "5",
    "text": "Lạy Chúa Hằng Hữu, công việc Ngài quá vĩ đại!"
  },
  {
    "id": 24288,
    "book": "psalms                                  ",
    "chapter": "92",
    "verse": "6",
    "text": "Người điên dại không sao biết được,"
  },
  {
    "id": 24289,
    "book": "psalms                                  ",
    "chapter": "92",
    "verse": "7",
    "text": "Người ác có khi tràn lan như cỏ dại,"
  },
  {
    "id": 24290,
    "book": "psalms                                  ",
    "chapter": "92",
    "verse": "8",
    "text": "Nhưng chỉ Ngài, lạy Chúa Hằng Hữu, vẫn cầm quyền tối cao đời đời."
  },
  {
    "id": 24291,
    "book": "psalms                                  ",
    "chapter": "92",
    "verse": "9",
    "text": "Chúng con biết kẻ thù Ngài, Chúa Hằng Hữu, sẽ hư vong;"
  },
  {
    "id": 24292,
    "book": "psalms                                  ",
    "chapter": "92",
    "verse": "10",
    "text": "Chúa thêm sức cho con mạnh như bò rừng."
  },
  {
    "id": 24293,
    "book": "psalms                                  ",
    "chapter": "92",
    "verse": "11",
    "text": "Mắt con đã chứng kiến cảnh quân thù bại trận;"
  },
  {
    "id": 24294,
    "book": "psalms                                  ",
    "chapter": "92",
    "verse": "12",
    "text": "Người công chính sẽ mọc lên như cây chà là,"
  },
  {
    "id": 24295,
    "book": "psalms                                  ",
    "chapter": "92",
    "verse": "13",
    "text": "Vì người được trồng trong nhà Chúa Hằng Hữu."
  },
  {
    "id": 24296,
    "book": "psalms                                  ",
    "chapter": "92",
    "verse": "14",
    "text": "Ngay cả khi đến tuổi già vẫn luôn sai trái;"
  },
  {
    "id": 24297,
    "book": "psalms                                  ",
    "chapter": "92",
    "verse": "15",
    "text": "Người sẽ công bố: “Chúa Hằng Hữu là công chính!"
  }
]