[
  {
    "id": 24303,
    "book": "psalms                                  ",
    "chapter": "94",
    "verse": "1",
    "text": "Lạy Chúa Hằng Hữu, Đức Chúa Trời báo ứng,"
  },
  {
    "id": 24304,
    "book": "psalms                                  ",
    "chapter": "94",
    "verse": "2",
    "text": "Xin trỗi dậy, lạy Thẩm Phán Tối Cao của thế gian."
  },
  {
    "id": 24305,
    "book": "psalms                                  ",
    "chapter": "94",
    "verse": "3",
    "text": "Bao lâu, lạy Chúa Hằng Hữu?"
  },
  {
    "id": 24306,
    "book": "psalms                                  ",
    "chapter": "94",
    "verse": "4",
    "text": "Họ tuôn ra những lời xấc xược đến khi nào?"
  },
  {
    "id": 24307,
    "book": "psalms                                  ",
    "chapter": "94",
    "verse": "5",
    "text": "Lạy Chúa Hằng Hữu, họ giẫm nát dân Chúa,"
  },
  {
    "id": 24308,
    "book": "psalms                                  ",
    "chapter": "94",
    "verse": "6",
    "text": "Họ giết quả phụ và kiều dân,"
  },
  {
    "id": 24309,
    "book": "psalms                                  ",
    "chapter": "94",
    "verse": "7",
    "text": "Rồi tự nhủ: “Chúa Hằng Hữu có thấy đâu,"
  },
  {
    "id": 24310,
    "book": "psalms                                  ",
    "chapter": "94",
    "verse": "8",
    "text": "Kẻ hung ác, hãy nghe đây và mở trí!94:8 Ctd hãy hiểu biết"
  },
  {
    "id": 24311,
    "book": "psalms                                  ",
    "chapter": "94",
    "verse": "9",
    "text": "Đấng sáng tạo ra tai, chẳng lẽ không nghe?"
  },
  {
    "id": 24312,
    "book": "psalms                                  ",
    "chapter": "94",
    "verse": "10",
    "text": "Đấng đoán phạt muôn dân, lẽ nào không trừng trị?"
  },
  {
    "id": 24313,
    "book": "psalms                                  ",
    "chapter": "94",
    "verse": "11",
    "text": "Chúa Hằng Hữu biết tư tưởng thầm kín của con người;"
  },
  {
    "id": 24314,
    "book": "psalms                                  ",
    "chapter": "94",
    "verse": "12",
    "text": "Lạy Chúa Hằng Hữu, phước cho người được Ngài sửa dạy,"
  },
  {
    "id": 24315,
    "book": "psalms                                  ",
    "chapter": "94",
    "verse": "13",
    "text": "Ngài cho họ nghỉ ngơi sau những ngày hoạn nạn,"
  },
  {
    "id": 24316,
    "book": "psalms                                  ",
    "chapter": "94",
    "verse": "14",
    "text": "Chúa Hằng Hữu không hề quên dân Chúa;"
  },
  {
    "id": 24317,
    "book": "psalms                                  ",
    "chapter": "94",
    "verse": "15",
    "text": "Vì công lý sẽ trở lại với người công chính,"
  },
  {
    "id": 24318,
    "book": "psalms                                  ",
    "chapter": "94",
    "verse": "16",
    "text": "Ai sẽ bảo vệ tôi khỏi tay bọn gian ác?"
  },
  {
    "id": 24319,
    "book": "psalms                                  ",
    "chapter": "94",
    "verse": "17",
    "text": "Nếu Chúa Hằng Hữu không giúp tôi,"
  },
  {
    "id": 24320,
    "book": "psalms                                  ",
    "chapter": "94",
    "verse": "18",
    "text": "Khi tôi kêu: “Con trượt ngã!”"
  },
  {
    "id": 24321,
    "book": "psalms                                  ",
    "chapter": "94",
    "verse": "19",
    "text": "Khi lòng tôi trăm mối ngổn ngang,"
  },
  {
    "id": 24322,
    "book": "psalms                                  ",
    "chapter": "94",
    "verse": "20",
    "text": "Có thể nào Chúa liên kết với các lãnh đạo bất chính—"
  },
  {
    "id": 24323,
    "book": "psalms                                  ",
    "chapter": "94",
    "verse": "21",
    "text": "Họ liên minh ám hại người công chính,"
  },
  {
    "id": 24324,
    "book": "psalms                                  ",
    "chapter": "94",
    "verse": "22",
    "text": "Nhưng Chúa Hằng Hữu là đồn lũy tôi;"
  },
  {
    "id": 24325,
    "book": "psalms                                  ",
    "chapter": "94",
    "verse": "23",
    "text": "Đức Chúa Trời sẽ báo trả công việc ác họ làm."
  }
]