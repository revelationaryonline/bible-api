[
  {
    "id": 25257,
    "book": "psalms                                  ",
    "chapter": "149",
    "verse": "1",
    "text": "Tán dương Chúa Hằng Hữu!"
  },
  {
    "id": 25258,
    "book": "psalms                                  ",
    "chapter": "149",
    "verse": "2",
    "text": "Ít-ra-ên hoan hỉ nơi Đấng Sáng Tạo mình."
  },
  {
    "id": 25259,
    "book": "psalms                                  ",
    "chapter": "149",
    "verse": "3",
    "text": "Họ chúc tụng Danh Chúa bằng vũ điệu,"
  },
  {
    "id": 25260,
    "book": "psalms                                  ",
    "chapter": "149",
    "verse": "4",
    "text": "Vì Chúa Hằng Hữu hài lòng con dân Ngài;"
  },
  {
    "id": 25261,
    "book": "psalms                                  ",
    "chapter": "149",
    "verse": "5",
    "text": "Người tin kính vui mừng, vinh dự."
  },
  {
    "id": 25262,
    "book": "psalms                                  ",
    "chapter": "149",
    "verse": "6",
    "text": "Hãy dùng môi miệng tung hô Đức Chúa Trời,"
  },
  {
    "id": 25263,
    "book": "psalms                                  ",
    "chapter": "149",
    "verse": "7",
    "text": "để báo thù các nước"
  },
  {
    "id": 25264,
    "book": "psalms                                  ",
    "chapter": "149",
    "verse": "8",
    "text": "dùng xích trói các vua"
  },
  {
    "id": 25265,
    "book": "psalms                                  ",
    "chapter": "149",
    "verse": "9",
    "text": "thi hành bản án đã được ghi."
  }
