  {
    "id": 22965,
    "book": "psalms                                  ",
    "chapter": "16",
    "verse": "2",
    "text": "Con từng thưa với Chúa Hằng Hữu:"
  },
  {
    "id": 22966,
    "book": "psalms                                  ",
    "chapter": "16",
    "verse": "3",
    "text": "Còn các người thánh trên đất,"
  },
  {
    "id": 22967,
    "book": "psalms                                  ",
    "chapter": "16",
    "verse": "4",
    "text": "Còn những người thờ phượng tà thần,"
  },
  {
    "id": 22968,
    "book": "psalms                                  ",
    "chapter": "16",
    "verse": "5",
    "text": "Chúa Hằng Hữu là phần thưởng16:5 Nt cái chén và cơ nghiệp của con."
  },
  {
    "id": 22969,
    "book": "psalms                                  ",
    "chapter": "16",
    "verse": "6",
    "text": "Phần đất Ngài ban cho con là nơi tốt đẹp."
  },
  {
    "id": 22970,
    "book": "psalms                                  ",
    "chapter": "16",
    "verse": "7",
    "text": "Con ca ngợi Chúa Hằng Hữu, Đấng khuyên bảo con;"
  },
  {
    "id": 22971,
    "book": "psalms                                  ",
    "chapter": "16",
    "verse": "8",
    "text": "Con hằng để Chúa Hằng Hữu trước mặt con."
  },
  {
    "id": 22972,
    "book": "psalms                                  ",
    "chapter": "16",
    "verse": "9",
    "text": "Vì thế lòng vui vẻ, hồn mừng rỡ."
  },
  {
    "id": 22973,
    "book": "psalms                                  ",
    "chapter": "16",
    "verse": "10",
    "text": "Vì Chúa không bỏ linh hồn con trong âm phủ"
  },
  {
    "id": 22974,
    "book": "psalms                                  ",
    "chapter": "16",
    "verse": "11",
    "text": "Chúa sẽ chỉ cho con, con đường sự sống,"
  }
