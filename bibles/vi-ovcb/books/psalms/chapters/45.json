[
  {
    "id": 23469,
    "book": "psalms                                  ",
    "chapter": "45",
    "verse": "1",
    "text": "Tâm hồn ta xúc động với lời hay ý đẹp,"
  },
  {
    "id": 23470,
    "book": "psalms                                  ",
    "chapter": "45",
    "verse": "2",
    "text": "Vua là người cao quý nhất,"
  },
  {
    "id": 23471,
    "book": "psalms                                  ",
    "chapter": "45",
    "verse": "3",
    "text": "Ôi đấng anh hùng! Xin đeo gươm báu,"
  },
  {
    "id": 23472,
    "book": "psalms                                  ",
    "chapter": "45",
    "verse": "4",
    "text": "Trong uy nghi chiến thắng, cưỡi xe lướt tới,"
  },
  {
    "id": 23473,
    "book": "psalms                                  ",
    "chapter": "45",
    "verse": "5",
    "text": "Mũi tên vua nhọn bén, hãy xuyên vào tim các vua quân nghịch,45:5 Nt kẻ thù của vua"
  },
  {
    "id": 23474,
    "book": "psalms                                  ",
    "chapter": "45",
    "verse": "6",
    "text": "Lạy Chúa, ngôi nước vua bền vững đời đời,"
  },
  {
    "id": 23475,
    "book": "psalms                                  ",
    "chapter": "45",
    "verse": "7",
    "text": "Vua yêu chuộng công bằng, ghét gian ác."
  },
  {
    "id": 23476,
    "book": "psalms                                  ",
    "chapter": "45",
    "verse": "8",
    "text": "Áo vua ngào ngạt một dược, lô hội, và nhục quế.45:8 Nt thêm: một dược, lô hội và nhục quế"
  },
  {
    "id": 23477,
    "book": "psalms                                  ",
    "chapter": "45",
    "verse": "9",
    "text": "Các công chúa đứng trong hàng tôn quý.45:9 Ctd danh dự"
  },
  {
    "id": 23478,
    "book": "psalms                                  ",
    "chapter": "45",
    "verse": "10",
    "text": "Hỡi quý nương, hãy nghe lời thỉnh giáo."
  },
  {
    "id": 23479,
    "book": "psalms                                  ",
    "chapter": "45",
    "verse": "11",
    "text": "Vua ái mộ nhan sắc nàng;"
  },
  {
    "id": 23480,
    "book": "psalms                                  ",
    "chapter": "45",
    "verse": "12",
    "text": "Quý nương Ty-rơ sẽ cung hiến lễ vật cho con."
  },
  {
    "id": 23481,
    "book": "psalms                                  ",
    "chapter": "45",
    "verse": "13",
    "text": "Công nương vinh hạnh tuyệt vời trong cung điện,"
  },
  {
    "id": 23482,
    "book": "psalms                                  ",
    "chapter": "45",
    "verse": "14",
    "text": "Trong y phục gấm vóc triều kiến vua,"
  },
  {
    "id": 23483,
    "book": "psalms                                  ",
    "chapter": "45",
    "verse": "15",
    "text": "Đoàn mỹ nữ vào cung điện"
  },
  {
    "id": 23484,
    "book": "psalms                                  ",
    "chapter": "45",
    "verse": "16",
    "text": "Các hoàng nam thay thế các tổ phụ."
  },
  {
    "id": 23485,
    "book": "psalms                                  ",
    "chapter": "45",
    "verse": "17",
    "text": "Tôi sẽ làm cho hậu thế ghi nhớ danh tiếng vua."
  }
]