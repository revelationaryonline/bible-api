[
  {
    "id": 24627,
    "book": "psalms                                  ",
    "chapter": "109",
    "verse": "1",
    "text": "Lạy Đức Chúa Trời, Đấng con ca tụng,"
  },
  {
    "id": 24628,
    "book": "psalms                                  ",
    "chapter": "109",
    "verse": "2",
    "text": "vì bọn ác và quân lừa đảo đang chống lại con,"
  },
  {
    "id": 24629,
    "book": "psalms                                  ",
    "chapter": "109",
    "verse": "3",
    "text": "Phủ đầu con với những câu thù hận,"
  },
  {
    "id": 24630,
    "book": "psalms                                  ",
    "chapter": "109",
    "verse": "4",
    "text": "Họ vu cáo con dù con thương yêu họ"
  },
  {
    "id": 24631,
    "book": "psalms                                  ",
    "chapter": "109",
    "verse": "5",
    "text": "Họ luôn luôn lấy ác báo thiện,"
  },
  {
    "id": 24632,
    "book": "psalms                                  ",
    "chapter": "109",
    "verse": "6",
    "text": "Xin Chúa đặt người bạo ngược xét xử họ."
  },
  {
    "id": 24633,
    "book": "psalms                                  ",
    "chapter": "109",
    "verse": "7",
    "text": "Trước vành móng ngựa, họ bị kết án,"
  },
  {
    "id": 24634,
    "book": "psalms                                  ",
    "chapter": "109",
    "verse": "8",
    "text": "Cuộc đời họ bị rút ngắn lại;"
  },
  {
    "id": 24635,
    "book": "psalms                                  ",
    "chapter": "109",
    "verse": "9",
    "text": "Con cái họ trở thành côi cút,"
  },
  {
    "id": 24636,
    "book": "psalms                                  ",
    "chapter": "109",
    "verse": "10",
    "text": "Dòng dõi109:10 Nt con cái họ lang thang khất thực,"
  },
  {
    "id": 24637,
    "book": "psalms                                  ",
    "chapter": "109",
    "verse": "11",
    "text": "Bọn chủ nợ cướp mất tài sản,"
  },
  {
    "id": 24638,
    "book": "psalms                                  ",
    "chapter": "109",
    "verse": "12",
    "text": "Không còn ai tỏ chút lòng thương xót;"
  },
  {
    "id": 24639,
    "book": "psalms                                  ",
    "chapter": "109",
    "verse": "13",
    "text": "Con cái họ bị tuyệt tự."
  },
  {
    "id": 24640,
    "book": "psalms                                  ",
    "chapter": "109",
    "verse": "14",
    "text": "Nguyện Chúa Hằng Hữu không bao giờ quên tội ác cha ông họ;"
  },
  {
    "id": 24641,
    "book": "psalms                                  ",
    "chapter": "109",
    "verse": "15",
    "text": "Nguyện Chúa Hằng Hữu luôn nhớ tội lỗi họ,"
  },
  {
    "id": 24642,
    "book": "psalms                                  ",
    "chapter": "109",
    "verse": "16",
    "text": "Vì họ chẳng bao giờ thương xót ai,"
  },
  {
    "id": 24643,
    "book": "psalms                                  ",
    "chapter": "109",
    "verse": "17",
    "text": "Họ thích chửi rủa người khác;"
  },
  {
    "id": 24644,
    "book": "psalms                                  ",
    "chapter": "109",
    "verse": "18",
    "text": "Chúng lấy nguyền rủa phủ thân mình như mặc áo,"
  },
  {
    "id": 24645,
    "book": "psalms                                  ",
    "chapter": "109",
    "verse": "19",
    "text": "Nguyện lời nguyền rủa như chiếc áo bao bọc họ,"
  },
  {
    "id": 24646,
    "book": "psalms                                  ",
    "chapter": "109",
    "verse": "20",
    "text": "Nguyện quân thù bị Chúa Hằng Hữu báo trả xứng đáng"
  },
  {
    "id": 24647,
    "book": "psalms                                  ",
    "chapter": "109",
    "verse": "21",
    "text": "Nhưng, Lạy Chúa Hằng Hữu Chí Cao, xin can thiệp,"
  },
  {
    "id": 24648,
    "book": "psalms                                  ",
    "chapter": "109",
    "verse": "22",
    "text": "Vì con khốn khổ và nghèo thiếu,"
  },
  {
    "id": 24649,
    "book": "psalms                                  ",
    "chapter": "109",
    "verse": "23",
    "text": "Đời con qua nhanh như chiếc bóng chiều tà;"
  },
  {
    "id": 24650,
    "book": "psalms                                  ",
    "chapter": "109",
    "verse": "24",
    "text": "Con đói khát nên đầu gối rã rời,"
  },
  {
    "id": 24651,
    "book": "psalms                                  ",
    "chapter": "109",
    "verse": "25",
    "text": "Con trở thành biểu tượng con người thất bại,"
  },
  {
    "id": 24652,
    "book": "psalms                                  ",
    "chapter": "109",
    "verse": "26",
    "text": "Lạy Chúa Hằng Hữu, Đức Chúa Trời con, xin ra tay cứu giúp!"
  },
  {
    "id": 24653,
    "book": "psalms                                  ",
    "chapter": "109",
    "verse": "27",
    "text": "Xin cho họ biết bàn tay Chúa,"
  },
  {
    "id": 24654,
    "book": "psalms                                  ",
    "chapter": "109",
    "verse": "28",
    "text": "Dù họ nguyền rủa thế nào con cũng chịu,"
  },
  {
    "id": 24655,
    "book": "psalms                                  ",
    "chapter": "109",
    "verse": "29",
    "text": "Nguyện bọn người cáo gian bị ô danh;"
  },
  {
    "id": 24656,
    "book": "psalms                                  ",
    "chapter": "109",
    "verse": "30",
    "text": "Con sẽ reo mừng cảm tạ Chúa Hằng Hữu,"
  },
  {
    "id": 24657,
    "book": "psalms                                  ",
    "chapter": "109",
    "verse": "31",
    "text": "Vì Chúa luôn đứng bên người nghèo khổ,"
  }
]