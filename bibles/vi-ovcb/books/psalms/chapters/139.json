[
  {
    "id": 25111,
    "book": "psalms                                  ",
    "chapter": "139",
    "verse": "1",
    "text": "Chúa Hằng Hữu ôi, Ngài đã tra xét lòng con"
  },
  {
    "id": 25112,
    "book": "psalms                                  ",
    "chapter": "139",
    "verse": "2",
    "text": "Chúa biết khi con ngồi hay đứng."
  },
  {
    "id": 25113,
    "book": "psalms                                  ",
    "chapter": "139",
    "verse": "3",
    "text": "Chúa nhìn thấy lối con đi,"
  },
  {
    "id": 25114,
    "book": "psalms                                  ",
    "chapter": "139",
    "verse": "4",
    "text": "Lời con nói chưa ra khỏi miệng"
  },
  {
    "id": 25115,
    "book": "psalms                                  ",
    "chapter": "139",
    "verse": "5",
    "text": "Chúa che chở phía sau phía trước."
  },
  {
    "id": 25116,
    "book": "psalms                                  ",
    "chapter": "139",
    "verse": "6",
    "text": "Tri thức của Ngài, con vô cùng kinh ngạc,"
  },
  {
    "id": 25117,
    "book": "psalms                                  ",
    "chapter": "139",
    "verse": "7",
    "text": "Con sẽ đi đâu cho xa Thần Chúa!"
  },
  {
    "id": 25118,
    "book": "psalms                                  ",
    "chapter": "139",
    "verse": "8",
    "text": "Nếu con lên trời, Chúa ngự tại đó;"
  },
  {
    "id": 25119,
    "book": "psalms                                  ",
    "chapter": "139",
    "verse": "9",
    "text": "Nếu con chắp cánh hừng đông,"
  },
  {
    "id": 25120,
    "book": "psalms                                  ",
    "chapter": "139",
    "verse": "10",
    "text": "Chúa cũng đưa tay ra dẫn dắt,"
  },
  {
    "id": 25121,
    "book": "psalms                                  ",
    "chapter": "139",
    "verse": "11",
    "text": "Con có thể xin bóng tối che giấu con"
  },
  {
    "id": 25122,
    "book": "psalms                                  ",
    "chapter": "139",
    "verse": "12",
    "text": "nhưng dù trong bóng tối, con cũng không thể giấu con khỏi Ngài."
  },
  {
    "id": 25123,
    "book": "psalms                                  ",
    "chapter": "139",
    "verse": "13",
    "text": "Chúa tạo nên tâm thần con,"
  },
  {
    "id": 25124,
    "book": "psalms                                  ",
    "chapter": "139",
    "verse": "14",
    "text": "Cảm tạ Chúa đã tạo nên con đáng sợ và lạ lùng!"
  },
  {
    "id": 25125,
    "book": "psalms                                  ",
    "chapter": "139",
    "verse": "15",
    "text": "Xương cốt hình hài con không giấu Chúa được,"
  },
  {
    "id": 25126,
    "book": "psalms                                  ",
    "chapter": "139",
    "verse": "16",
    "text": "Mắt Chúa đã thấy con trước khi con sinh ra."
  },
  {
    "id": 25127,
    "book": "psalms                                  ",
    "chapter": "139",
    "verse": "17",
    "text": "Lạy Đức Chúa Trời, đối với con, tư tưởng của Chúa thật quý báu."
  },
  {
    "id": 25128,
    "book": "psalms                                  ",
    "chapter": "139",
    "verse": "18",
    "text": "Con miên man đếm không xuể,"
  },
  {
    "id": 25129,
    "book": "psalms                                  ",
    "chapter": "139",
    "verse": "19",
    "text": "Lạy Đức Chúa Trời, hẳn Chúa sẽ giết người gian ác!"
  },
  {
    "id": 25130,
    "book": "psalms                                  ",
    "chapter": "139",
    "verse": "20",
    "text": "Lời quỷ quyệt, họ nhắc đến Chúa;"
  },
  {
    "id": 25131,
    "book": "psalms                                  ",
    "chapter": "139",
    "verse": "21",
    "text": "Chúa Hằng Hữu ôi, lẽ nào con không ghét người ghét Chúa?"
  },
  {
    "id": 25132,
    "book": "psalms                                  ",
    "chapter": "139",
    "verse": "22",
    "text": "Con ghét họ thậm tệ,"
  },
  {
    "id": 25133,
    "book": "psalms                                  ",
    "chapter": "139",
    "verse": "23",
    "text": "Lạy Đức Chúa Trời, xin dò xét và biết lòng con;"
  },
  {
    "id": 25134,
    "book": "psalms                                  ",
    "chapter": "139",
    "verse": "24",
    "text": "Xem lòng con có đường lối nào tà ác,"
  }
]