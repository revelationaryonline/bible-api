[
  {
    "id": 24156,
    "book": "psalms                                  ",
    "chapter": "86",
    "verse": "1",
    "text": "Lạy Chúa Hằng Hữu, xin nghiêng tai nghe lời con cầu nguyện;"
  },
  {
    "id": 24157,
    "book": "psalms                                  ",
    "chapter": "86",
    "verse": "2",
    "text": "Xin bảo vệ mạng sống con, vì con được biệt riêng cho Chúa."
  },
  {
    "id": 24158,
    "book": "psalms                                  ",
    "chapter": "86",
    "verse": "3",
    "text": "Lạy Chúa Hằng Hữu, xin thương xót con,"
  },
  {
    "id": 24159,
    "book": "psalms                                  ",
    "chapter": "86",
    "verse": "4",
    "text": "Xin cho lòng con vui vẻ, lạy Chúa,"
  },
  {
    "id": 24160,
    "book": "psalms                                  ",
    "chapter": "86",
    "verse": "5",
    "text": "Lạy Chúa, Ngài là thiện hảo và sẵn sàng tha thứ,"
  },
  {
    "id": 24161,
    "book": "psalms                                  ",
    "chapter": "86",
    "verse": "6",
    "text": "Xin lắng tai, nghe con cầu nguyện, lạy Chúa Hằng Hữu;"
  },
  {
    "id": 24162,
    "book": "psalms                                  ",
    "chapter": "86",
    "verse": "7",
    "text": "Trong ngày gian khổ, con kêu cầu"
  },
  {
    "id": 24163,
    "book": "psalms                                  ",
    "chapter": "86",
    "verse": "8",
    "text": "Lạy Chúa, không có thần nào giống Chúa."
  },
  {
    "id": 24164,
    "book": "psalms                                  ",
    "chapter": "86",
    "verse": "9",
    "text": "Tất cả dân tộc Chúa tạo dựng"
  },
  {
    "id": 24165,
    "book": "psalms                                  ",
    "chapter": "86",
    "verse": "10",
    "text": "Vì Chúa vĩ đại và làm những việc kỳ diệu."
  },
  {
    "id": 24166,
    "book": "psalms                                  ",
    "chapter": "86",
    "verse": "11",
    "text": "Lạy Chúa Hằng Hữu, xin dạy con đường lối Chúa,"
  },
  {
    "id": 24167,
    "book": "psalms                                  ",
    "chapter": "86",
    "verse": "12",
    "text": "Lạy Chúa, Đức Chúa Trời con, con hết lòng cảm tạ Chúa."
  },
  {
    "id": 24168,
    "book": "psalms                                  ",
    "chapter": "86",
    "verse": "13",
    "text": "vì lòng nhân ái Chúa dành cho quá lớn."
  },
  {
    "id": 24169,
    "book": "psalms                                  ",
    "chapter": "86",
    "verse": "14",
    "text": "Lạy Đức Chúa Trời, bọn kiêu ngạo nổi lên;"
  },
  {
    "id": 24170,
    "book": "psalms                                  ",
    "chapter": "86",
    "verse": "15",
    "text": "Nhưng Ngài là Chúa,"
  },
  {
    "id": 24171,
    "book": "psalms                                  ",
    "chapter": "86",
    "verse": "16",
    "text": "Xin nhìn xuống và thương xót con."
  },
  {
    "id": 24172,
    "book": "psalms                                  ",
    "chapter": "86",
    "verse": "17",
    "text": "Xin cho con dấu hiệu phước lành."
  }
]