    "text": "Lạy Chúa Hằng Hữu Vạn Quân,"
  },
  {
    "id": 24132,
    "book": "psalms                                  ",
    "chapter": "84",
    "verse": "2",
    "text": "Linh hồn con mong ước héo hon"
  },
  {
    "id": 24133,
    "book": "psalms                                  ",
    "chapter": "84",
    "verse": "3",
    "text": "Lạy Chúa Hằng Hữu Vạn Quân, Vua và Đức Chúa Trời của con!"
  },
  {
    "id": 24134,
    "book": "psalms                                  ",
    "chapter": "84",
    "verse": "4",
    "text": "Phước hạnh thay cho ai được ở trong nhà Chúa,"
  },
  {
    "id": 24135,
    "book": "psalms                                  ",
    "chapter": "84",
    "verse": "5",
    "text": "Phước cho ai có sức mạnh từ nơi Chúa Hằng Hữu,"
  },
  {
    "id": 24136,
    "book": "psalms                                  ",
    "chapter": "84",
    "verse": "6",
    "text": "Khi đi qua Thung Lũng Khóc Lóc,"
  },
  {
    "id": 24137,
    "book": "psalms                                  ",
    "chapter": "84",
    "verse": "7",
    "text": "Họ càng đi sức lực càng gia tăng,"
  },
  {
    "id": 24138,
    "book": "psalms                                  ",
    "chapter": "84",
    "verse": "8",
    "text": "Lạy Chúa Hằng Hữu, Đức Chúa Trời Vạn Quân, xin rủ nghe lời con cầu nguyện."
  },
  {
    "id": 24139,
    "book": "psalms                                  ",
    "chapter": "84",
    "verse": "9",
    "text": "Lạy Đức Chúa Trời, là tấm khiên che chở."
  },
  {
    "id": 24140,
    "book": "psalms                                  ",
    "chapter": "84",
    "verse": "10",
    "text": "Một ngày trong sân hành lang Chúa,"
  },
  {
    "id": 24141,
    "book": "psalms                                  ",
    "chapter": "84",
    "verse": "11",
    "text": "Vì Chúa Hằng Hữu, Đức Chúa Trời là mặt trời và khiên thuẫn."
  },
