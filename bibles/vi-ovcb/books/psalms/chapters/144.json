[
  {
    "id": 25177,
    "book": "psalms                                  ",
    "chapter": "144",
    "verse": "1",
    "text": "Chúc tụng Chúa Hằng Hữu, Vầng Đá của con."
  },
  {
    "id": 25178,
    "book": "psalms                                  ",
    "chapter": "144",
    "verse": "2",
    "text": "Chúa là Đấng Nhân Từ và là đồn lũy,"
  },
  {
    "id": 25179,
    "book": "psalms                                  ",
    "chapter": "144",
    "verse": "3",
    "text": "Lạy Chúa Hằng Hữu, loài người là gì mà Chúa lưu ý,"
  },
  {
    "id": 25180,
    "book": "psalms                                  ",
    "chapter": "144",
    "verse": "4",
    "text": "Loài người khác nào hơi thở,"
  },
  {
    "id": 25181,
    "book": "psalms                                  ",
    "chapter": "144",
    "verse": "5",
    "text": "Lạy Chúa Hằng Hữu, xin hạ thấp màn trời và bước xuống."
  },
  {
    "id": 25182,
    "book": "psalms                                  ",
    "chapter": "144",
    "verse": "6",
    "text": "Xin phát chớp nhoáng cho quân thù tan vỡ!"
  },
  {
    "id": 25183,
    "book": "psalms                                  ",
    "chapter": "144",
    "verse": "7",
    "text": "Từ trời cao, xin đưa tay cứu con;"
  },
  {
    "id": 25184,
    "book": "psalms                                  ",
    "chapter": "144",
    "verse": "8",
    "text": "Miệng họ đầy lời dối gian;"
  },
  {
    "id": 25185,
    "book": "psalms                                  ",
    "chapter": "144",
    "verse": "9",
    "text": "Lạy Đức Chúa Trời, con sẽ hát bài ca mới cho Chúa!"
  },
  {
    "id": 25186,
    "book": "psalms                                  ",
    "chapter": "144",
    "verse": "10",
    "text": "Chúa đã cứu các vua!"
  },
  {
    "id": 25187,
    "book": "psalms                                  ",
    "chapter": "144",
    "verse": "11",
    "text": "Xin cứu con!"
  },
  {
    "id": 25188,
    "book": "psalms                                  ",
    "chapter": "144",
    "verse": "12",
    "text": "Nguyện con trai chúng con sẽ như cây non phát triển mạnh mẽ,"
  },
  {
    "id": 25189,
    "book": "psalms                                  ",
    "chapter": "144",
    "verse": "13",
    "text": "Nguyện các kho vựa chúng con sẽ đầy tràn"
  },
  {
    "id": 25190,
    "book": "psalms                                  ",
    "chapter": "144",
    "verse": "14",
    "text": "và nguyện đàn bò chúng con sinh sôi nẩy nở."
  },
  {
    "id": 25191,
    "book": "psalms                                  ",
    "chapter": "144",
    "verse": "15",
    "text": "Phước cho dân tộc sống như thế!"
  }
]