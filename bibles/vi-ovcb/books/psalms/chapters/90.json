[
  {
    "id": 24250,
    "book": "psalms                                  ",
    "chapter": "90",
    "verse": "1",
    "text": "Lạy Chúa, từ thế hệ này sang thế hệ khác,"
  },
  {
    "id": 24251,
    "book": "psalms                                  ",
    "chapter": "90",
    "verse": "2",
    "text": "Trước khi núi non chưa sinh ra,"
  },
  {
    "id": 24252,
    "book": "psalms                                  ",
    "chapter": "90",
    "verse": "3",
    "text": "Chúa khiến con người trở về cát bụi, và Ngài truyền:"
  },
  {
    "id": 24253,
    "book": "psalms                                  ",
    "chapter": "90",
    "verse": "4",
    "text": "Vì một nghìn năm đối với Chúa như một ngày vừa đi qua,"
  },
  {
    "id": 24254,
    "book": "psalms                                  ",
    "chapter": "90",
    "verse": "5",
    "text": "Chúa đưa loài người trôi vào giấc ngủ tử vong."
  },
  {
    "id": 24255,
    "book": "psalms                                  ",
    "chapter": "90",
    "verse": "6",
    "text": "Dù sáng nở hoa và tốt tươi,"
  },
  {
    "id": 24256,
    "book": "psalms                                  ",
    "chapter": "90",
    "verse": "7",
    "text": "Chúng con tiêu hao vì cơn giận của Chúa;"
  },
  {
    "id": 24257,
    "book": "psalms                                  ",
    "chapter": "90",
    "verse": "8",
    "text": "Chúa vạch trần tội ác chúng con ra trước mặt Chúa—"
  },
  {
    "id": 24258,
    "book": "psalms                                  ",
    "chapter": "90",
    "verse": "9",
    "text": "Ngày chúng con trôi qua theo dòng thịnh nộ,"
  },
  {
    "id": 24259,
    "book": "psalms                                  ",
    "chapter": "90",
    "verse": "10",
    "text": "Tuổi tác chúng con may mắn thì được bảy mươi!"
  },
  {
    "id": 24260,
    "book": "psalms                                  ",
    "chapter": "90",
    "verse": "11",
    "text": "Ai biết được cơn giận Chúa mạnh đến đâu?"
  },
  {
    "id": 24261,
    "book": "psalms                                  ",
    "chapter": "90",
    "verse": "12",
    "text": "Xin Chúa dạy chúng con biết đếm các ngày chúng con,"
  },
  {
    "id": 24262,
    "book": "psalms                                  ",
    "chapter": "90",
    "verse": "13",
    "text": "Lạy Chúa Hằng Hữu, xin vui lòng trở lại!"
  },
  {
    "id": 24263,
    "book": "psalms                                  ",
    "chapter": "90",
    "verse": "14",
    "text": "Vừa sáng, xin cho chúng con thỏa nguyện với lòng nhân từ Chúa,"
  },
  {
    "id": 24264,
    "book": "psalms                                  ",
    "chapter": "90",
    "verse": "15",
    "text": "Xin Chúa cho chúng con hưởng được số ngày vui mừng!"
  },
  {
    "id": 24265,
    "book": "psalms                                  ",
    "chapter": "90",
    "verse": "16",
    "text": "Nguyện công việc Chúa được giãi bày cho các đầy tớ Chúa;"
  },
  {
    "id": 24266,
    "book": "psalms                                  ",
    "chapter": "90",
    "verse": "17",
    "text": "Nguyện ân sủng Chúa, Đức Chúa Trời chúng con, đổ trên chúng con,"
  }
]