[
  {
    "id": 23662,
    "book": "psalms                                  ",
    "chapter": "59",
    "verse": "1",
    "text": "Lạy Đức Chúa Trời, xin giải thoát con khỏi tay quân thù nghịch."
  },
  {
    "id": 23663,
    "book": "psalms                                  ",
    "chapter": "59",
    "verse": "2",
    "text": "Xin cứu con khỏi phường gian ngoa;"
  },
  {
    "id": 23664,
    "book": "psalms                                  ",
    "chapter": "59",
    "verse": "3",
    "text": "Lạy Chúa Hằng Hữu, họ phục kích, rình rập,"
  },
  {
    "id": 23665,
    "book": "psalms                                  ",
    "chapter": "59",
    "verse": "4",
    "text": "Con không làm gì sai trái,"
  },
  {
    "id": 23666,
    "book": "psalms                                  ",
    "chapter": "59",
    "verse": "5",
    "text": "Lạy Chúa Hằng Hữu, Đức Chúa Trời Vạn Quân, Đức Chúa Trời của Ít-ra-ên,"
  },
  {
    "id": 23667,
    "book": "psalms                                  ",
    "chapter": "59",
    "verse": "6",
    "text": "Đến tối, họ quay lại,"
  },
  {
    "id": 23668,
    "book": "psalms                                  ",
    "chapter": "59",
    "verse": "7",
    "text": "Miệng chửi rủa như gươm giáo;"
  },
  {
    "id": 23669,
    "book": "psalms                                  ",
    "chapter": "59",
    "verse": "8",
    "text": "Nhưng Chúa Hằng Hữu nhạo cười chúng."
  },
  {
    "id": 23670,
    "book": "psalms                                  ",
    "chapter": "59",
    "verse": "9",
    "text": "Chúa là sức mạnh con; con trông đợi Ngài giải cứu,"
  },
  {
    "id": 23671,
    "book": "psalms                                  ",
    "chapter": "59",
    "verse": "10",
    "text": "Đức Chúa Trời đón con vào vòng tay từ ái,"
  },
  {
    "id": 23672,
    "book": "psalms                                  ",
    "chapter": "59",
    "verse": "11",
    "text": "Xin đừng giết họ vội, e dân con quên bài học;"
  },
  {
    "id": 23673,
    "book": "psalms                                  ",
    "chapter": "59",
    "verse": "12",
    "text": "Tội của môi miệng chúng nó,"
  },
  {
    "id": 23674,
    "book": "psalms                                  ",
    "chapter": "59",
    "verse": "13",
    "text": "Xin hủy phá trong cơn thịnh nộ!"
  },
  {
    "id": 23675,
    "book": "psalms                                  ",
    "chapter": "59",
    "verse": "14",
    "text": "Đến tối, họ quay lại,"
  },
  {
    "id": 23676,
    "book": "psalms                                  ",
    "chapter": "59",
    "verse": "15",
    "text": "Chúng sục sạo tìm mồi đây đó,"
  },
  {
    "id": 23677,
    "book": "psalms                                  ",
    "chapter": "59",
    "verse": "16",
    "text": "Nhưng con sẽ ca ngợi sức mạnh Chúa."
  },
  {
    "id": 23678,
    "book": "psalms                                  ",
    "chapter": "59",
    "verse": "17",
    "text": "Lạy Đấng Sức Mạnh của con, con ca ngợi Ngài,"
  }
]