[
  {
    "id": 25165,
    "book": "psalms                                  ",
    "chapter": "143",
    "verse": "1",
    "text": "Xin nghe con cầu nguyện, lạy Chúa Hằng Hữu;"
  },
  {
    "id": 25166,
    "book": "psalms                                  ",
    "chapter": "143",
    "verse": "2",
    "text": "Xin đừng phán xét đầy tớ Chúa,"
  },
  {
    "id": 25167,
    "book": "psalms                                  ",
    "chapter": "143",
    "verse": "3",
    "text": "Kẻ thù con săn đuổi con."
  },
  {
    "id": 25168,
    "book": "psalms                                  ",
    "chapter": "143",
    "verse": "4",
    "text": "Tinh thần con nao núng;"
  },
  {
    "id": 25169,
    "book": "psalms                                  ",
    "chapter": "143",
    "verse": "5",
    "text": "Con nhớ những ngày xa xưa."
  },
  {
    "id": 25170,
    "book": "psalms                                  ",
    "chapter": "143",
    "verse": "6",
    "text": "Con đưa tay hướng về Chúa nguyện cầu."
  },
  {
    "id": 25171,
    "book": "psalms                                  ",
    "chapter": "143",
    "verse": "7",
    "text": "Xin mau đến, lạy Chúa Hằng Hữu, xin đáp lời con,"
  },
  {
    "id": 25172,
    "book": "psalms                                  ",
    "chapter": "143",
    "verse": "8",
    "text": "Buổi sáng, xin cho con nghe giọng nhân từ Chúa,"
  },
  {
    "id": 25173,
    "book": "psalms                                  ",
    "chapter": "143",
    "verse": "9",
    "text": "Xin Chúa Hằng Hữu giải thoát con khỏi kẻ thù;"
  },
  {
    "id": 25174,
    "book": "psalms                                  ",
    "chapter": "143",
    "verse": "10",
    "text": "Xin dạy con làm theo ý Chúa,"
  },
  {
    "id": 25175,
    "book": "psalms                                  ",
    "chapter": "143",
    "verse": "11",
    "text": "Vì Danh Chúa Hằng Hữu, xin cho con sống."
  },
  {
    "id": 25176,
    "book": "psalms                                  ",
    "chapter": "143",
    "verse": "12",
    "text": "Do lòng nhân từ, xin giết sạch kẻ thù,"
  }
]