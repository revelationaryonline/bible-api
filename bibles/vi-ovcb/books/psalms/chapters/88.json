[
  {
    "id": 24180,
    "book": "psalms                                  ",
    "chapter": "88",
    "verse": "1",
    "text": "Lạy Chúa Hằng Hữu, Đức Chúa Trời của sự cứu rỗi con,"
  },
  {
    "id": 24181,
    "book": "psalms                                  ",
    "chapter": "88",
    "verse": "2",
    "text": "Xin nghe lời con cầu nguyện,"
  },
  {
    "id": 24182,
    "book": "psalms                                  ",
    "chapter": "88",
    "verse": "3",
    "text": "Vì linh hồn con tràn đầy khổ đau,"
  },
  {
    "id": 24183,
    "book": "psalms                                  ",
    "chapter": "88",
    "verse": "4",
    "text": "Con bị xem như người thiệt mạng,88:4 Nt người xuống vực sâu"
  },
  {
    "id": 24184,
    "book": "psalms                                  ",
    "chapter": "88",
    "verse": "5",
    "text": "Họ để con giữa những người chết,"
  },
  {
    "id": 24185,
    "book": "psalms                                  ",
    "chapter": "88",
    "verse": "6",
    "text": "Chúa đã đặt con vào đáy mộ,"
  },
  {
    "id": 24186,
    "book": "psalms                                  ",
    "chapter": "88",
    "verse": "7",
    "text": "Cơn thịnh nộ Chúa đè ép con;"
  },
  {
    "id": 24187,
    "book": "psalms                                  ",
    "chapter": "88",
    "verse": "8",
    "text": "Chúa khiến bạn bè con xa lánh,"
  },
  {
    "id": 24188,
    "book": "psalms                                  ",
    "chapter": "88",
    "verse": "9",
    "text": "Mắt con mờ đi vì khổ nạn."
  },
  {
    "id": 24189,
    "book": "psalms                                  ",
    "chapter": "88",
    "verse": "10",
    "text": "Chúa có làm phép mầu cho người chết sao?"
  },
  {
    "id": 24190,
    "book": "psalms                                  ",
    "chapter": "88",
    "verse": "11",
    "text": "Ai truyền bá nhân ái Chúa dưới mộ?"
  },
  {
    "id": 24191,
    "book": "psalms                                  ",
    "chapter": "88",
    "verse": "12",
    "text": "Cõi u minh sao biết việc diệu kỳ?"
  },
  {
    "id": 24192,
    "book": "psalms                                  ",
    "chapter": "88",
    "verse": "13",
    "text": "Lạy Chúa Hằng Hữu, con kêu xin Ngài."
  },
  {
    "id": 24193,
    "book": "psalms                                  ",
    "chapter": "88",
    "verse": "14",
    "text": "Chúa Hằng Hữu ơi, sao Ngài từ bỏ con?"
  },
  {
    "id": 24194,
    "book": "psalms                                  ",
    "chapter": "88",
    "verse": "15",
    "text": "Từ tuổi thanh xuân, con đã bị hoạn nạn hiểm nghèo."
  },
  {
    "id": 24195,
    "book": "psalms                                  ",
    "chapter": "88",
    "verse": "16",
    "text": "Thịnh nộ Chúa như sóng cồn vùi dập,"
  },
  {
    "id": 24196,
    "book": "psalms                                  ",
    "chapter": "88",
    "verse": "17",
    "text": "Chúng nó bao phủ con hằng ngày."
  },
  {
    "id": 24197,
    "book": "psalms                                  ",
    "chapter": "88",
    "verse": "18",
    "text": "Chúa khiến người yêu và bạn hữu tránh né con."
  }
]