[
  {
    "id": 24614,
    "book": "psalms                                  ",
    "chapter": "108",
    "verse": "1",
    "text": "Lạy Đức Chúa Trời, lòng con vững chắc;108:1 Ctd lòng con sẵn sàng"
  },
  {
    "id": 24615,
    "book": "psalms                                  ",
    "chapter": "108",
    "verse": "2",
    "text": "Hãy bừng tỉnh, hỡi đàn lia và đàn hạc!"
  },
  {
    "id": 24616,
    "book": "psalms                                  ",
    "chapter": "108",
    "verse": "3",
    "text": "Con sẽ cảm tạ Chúa trong các dân tộc."
  },
  {
    "id": 24617,
    "book": "psalms                                  ",
    "chapter": "108",
    "verse": "4",
    "text": "Vì đức nhân ái Chúa lớn hơn bầu trời."
  },
  {
    "id": 24618,
    "book": "psalms                                  ",
    "chapter": "108",
    "verse": "5",
    "text": "Hãy tán dương Ngài lên tận các tầng trời cao."
  },
  {
    "id": 24619,
    "book": "psalms                                  ",
    "chapter": "108",
    "verse": "6",
    "text": "Xin giải cứu người Chúa thương yêu."
  },
  {
    "id": 24620,
    "book": "psalms                                  ",
    "chapter": "108",
    "verse": "7",
    "text": "Đức Chúa Trời đã phán trong nơi thánh:"
  },
  {
    "id": 24621,
    "book": "psalms                                  ",
    "chapter": "108",
    "verse": "8",
    "text": "Ga-la-át là của Ta,"
  },
  {
    "id": 24622,
    "book": "psalms                                  ",
    "chapter": "108",
    "verse": "9",
    "text": "Nhưng Mô-áp, bồn rửa Ta, sẽ trở nên đầy tớ Ta,"
  },
  {
    "id": 24623,
    "book": "psalms                                  ",
    "chapter": "108",
    "verse": "10",
    "text": "Ai sẽ đưa con đến thành chiến đấu?"
  },
  {
    "id": 24624,
    "book": "psalms                                  ",
    "chapter": "108",
    "verse": "11",
    "text": "Lạy Đức Chúa Trời, chẳng phải Ngài đã từ bỏ chúng con sao?"
  },
  {
    "id": 24625,
    "book": "psalms                                  ",
    "chapter": "108",
    "verse": "12",
    "text": "Ôi, xin giúp chúng con chống lại kẻ thù của chúng con,"
  },
  {
    "id": 24626,
    "book": "psalms                                  ",
    "chapter": "108",
    "verse": "13",
    "text": "Nhờ sức Đức Chúa Trời, chúng con đấu tranh anh dũng,"
  }
]