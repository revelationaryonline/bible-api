  {
    "id": 22987,
    "book": "psalms                                  ",
    "chapter": "17",
    "verse": "13",
    "text": "Chúa ôi, xin trỗi dậy, đón và đánh hạ chúng!"
  },
  {
    "id": 22988,
    "book": "psalms                                  ",
    "chapter": "17",
    "verse": "14",
