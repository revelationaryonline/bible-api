    "verse": "2",
    "text": "Xin chính Chúa minh oan cho con,"
  },
  {
    "id": 22977,
    "book": "psalms                                  ",
    "chapter": "17",
    "verse": "3",
    "text": "Dù Chúa dò xét lòng con"
