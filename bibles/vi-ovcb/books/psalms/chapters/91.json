[
  {
    "id": 24267,
    "book": "psalms                                  ",
    "chapter": "91",
    "verse": "1",
    "text": "Ai trú ẩn nơi bí mật của Đấng Chí Cao"
  },
  {
    "id": 24268,
    "book": "psalms                                  ",
    "chapter": "91",
    "verse": "2",
    "text": "Đây là điều con công bố về Chúa Hằng Hữu:"
  },
  {
    "id": 24269,
    "book": "psalms                                  ",
    "chapter": "91",
    "verse": "3",
    "text": "Vì Chúa sẽ giải thoát ngươi khỏi cạm bẫy"
  },
  {
    "id": 24270,
    "book": "psalms                                  ",
    "chapter": "91",
    "verse": "4",
    "text": "Chúa phủ lông cánh Ngài che cho ngươi."
  },
  {
    "id": 24271,
    "book": "psalms                                  ",
    "chapter": "91",
    "verse": "5",
    "text": "Ngươi sẽ không sợ sự khủng khiếp ban đêm,"
  },
  {
    "id": 24272,
    "book": "psalms                                  ",
    "chapter": "91",
    "verse": "6",
    "text": "Hoặc khiếp sợ bệnh dịch lây lan trong bóng tối,"
  },
  {
    "id": 24273,
    "book": "psalms                                  ",
    "chapter": "91",
    "verse": "7",
    "text": "Hàng nghìn người sẽ ngã gục bên ngươi,"
  },
  {
    "id": 24274,
    "book": "psalms                                  ",
    "chapter": "91",
    "verse": "8",
    "text": "Ngươi chỉ cần quan sát,"
  },
  {
    "id": 24275,
    "book": "psalms                                  ",
    "chapter": "91",
    "verse": "9",
    "text": "Nếu ngươi đã nhờ Chúa Hằng Hữu làm nơi ẩn trú,"
  },
  {
    "id": 24276,
    "book": "psalms                                  ",
    "chapter": "91",
    "verse": "10",
    "text": "thì tai họa chẳng đến với ngươi,"
  },
  {
    "id": 24277,
    "book": "psalms                                  ",
    "chapter": "91",
    "verse": "11",
    "text": "Vì Chúa sẽ truyền lệnh cho các thiên sứ"
  },
  {
    "id": 24278,
    "book": "psalms                                  ",
    "chapter": "91",
    "verse": "12",
    "text": "Thiên sứ sẽ nâng ngươi trên bàn tay,"
  },
  {
    "id": 24279,
    "book": "psalms                                  ",
    "chapter": "91",
    "verse": "13",
    "text": "Ngươi sẽ đạp chân lên sư tử và rắn hổ;"
  },
  {
    "id": 24280,
    "book": "psalms                                  ",
    "chapter": "91",
    "verse": "14",
    "text": "Chúa Hằng Hữu phán: “Ta sẽ giải cứu những ai yêu kính Ta"
  },
  {
    "id": 24281,
    "book": "psalms                                  ",
    "chapter": "91",
    "verse": "15",
    "text": "Khi họ kêu cầu Ta, Ta sẽ đáp lời;"
  },
  {
    "id": 24282,
    "book": "psalms                                  ",
    "chapter": "91",
    "verse": "16",
    "text": "Ta sẽ cho người mãn nguyện sống lâu,"
  }
]