[
  {
    "id": 23892,
    "book": "psalms                                  ",
    "chapter": "73",
    "verse": "1",
    "text": "Đức Chúa Trời thật nhân từ với Ít-ra-ên,"
  },
  {
    "id": 23893,
    "book": "psalms                                  ",
    "chapter": "73",
    "verse": "2",
    "text": "Nhưng riêng con, gần như đã mất niềm tin."
  },
  {
    "id": 23894,
    "book": "psalms                                  ",
    "chapter": "73",
    "verse": "3",
    "text": "Vì con ganh tị người kiêu ngạo,"
  },
  {
    "id": 23895,
    "book": "psalms                                  ",
    "chapter": "73",
    "verse": "4",
    "text": "Lúc chết, họ không đau đớn;"
  },
  {
    "id": 23896,
    "book": "psalms                                  ",
    "chapter": "73",
    "verse": "5",
    "text": "Họ không bị hoạn nạn như người khác;"
  },
  {
    "id": 23897,
    "book": "psalms                                  ",
    "chapter": "73",
    "verse": "6",
    "text": "Vì thế họ lấy kiêu ngạo làm vòng đeo cổ,"
  },
  {
    "id": 23898,
    "book": "psalms                                  ",
    "chapter": "73",
    "verse": "7",
    "text": "Tâm trí đầy mưu sâu kế độc,"
  },
  {
    "id": 23899,
    "book": "psalms                                  ",
    "chapter": "73",
    "verse": "8",
    "text": "Họ nhạo cười, chế giễu thâm độc;"
  },
  {
    "id": 23900,
    "book": "psalms                                  ",
    "chapter": "73",
    "verse": "9",
    "text": "Miệng khoác lác chống nghịch các tầng trời,"
  },
  {
    "id": 23901,
    "book": "psalms                                  ",
    "chapter": "73",
    "verse": "10",
    "text": "Thậm chí dân Chúa cũng về hùa,"
  },
  {
    "id": 23902,
    "book": "psalms                                  ",
    "chapter": "73",
    "verse": "11",
    "text": "Họ bảo nhau: “Đức Chúa Trời không biết đâu?"
  },
  {
    "id": 23903,
    "book": "psalms                                  ",
    "chapter": "73",
    "verse": "12",
    "text": "Những người ác bình an vô sự—"
  },
  {
    "id": 23904,
    "book": "psalms                                  ",
    "chapter": "73",
    "verse": "13",
    "text": "Có phải con đã luyện tâm hồn tinh khiết cách vô ích?"
  },
  {
    "id": 23905,
    "book": "psalms                                  ",
    "chapter": "73",
    "verse": "14",
    "text": "Con không được gì, chỉ suốt ngày gian nan;"
  },
  {
    "id": 23906,
    "book": "psalms                                  ",
    "chapter": "73",
    "verse": "15",
    "text": "Nếu con cứ than phiền trách móc,"
  },
  {
    "id": 23907,
    "book": "psalms                                  ",
    "chapter": "73",
    "verse": "16",
    "text": "Con cúi đầu suy nghiệm sâu xa."
  },
  {
    "id": 23908,
    "book": "psalms                                  ",
    "chapter": "73",
    "verse": "17",
    "text": "Cho đến khi con đi vào nơi thánh,"
  },
  {
    "id": 23909,
    "book": "psalms                                  ",
    "chapter": "73",
    "verse": "18",
    "text": "Thật Chúa đặt họ đứng nơi trơn trợt,"
  },
  {
    "id": 23910,
    "book": "psalms                                  ",
    "chapter": "73",
    "verse": "19",
    "text": "Trong khoảnh khắc, họ bị hủy diệt,"
  },
  {
    "id": 23911,
    "book": "psalms                                  ",
    "chapter": "73",
    "verse": "20",
    "text": "Lạy Chúa, Ngài khinh dể những ý tưởng khờ dại của họ73:20 Nt khinh chê hình dạng họ"
  },
  {
    "id": 23912,
    "book": "psalms                                  ",
    "chapter": "73",
    "verse": "21",
    "text": "Khi lòng con đau buồn,"
  },
  {
    "id": 23913,
    "book": "psalms                                  ",
    "chapter": "73",
    "verse": "22",
    "text": "Con trở nên ngu si, dốt nát—"
  },
  {
    "id": 23914,
    "book": "psalms                                  ",
    "chapter": "73",
    "verse": "23",
    "text": "Nhưng con vẫn luôn thuộc về Chúa;"
  },
  {
    "id": 23915,
    "book": "psalms                                  ",
    "chapter": "73",
    "verse": "24",
    "text": "Chúa dạy bằng lời huấn thị,"
  },
  {
    "id": 23916,
    "book": "psalms                                  ",
    "chapter": "73",
    "verse": "25",
    "text": "Trên trời, con không có ai ngoài Chúa."
  },
  {
    "id": 23917,
    "book": "psalms                                  ",
    "chapter": "73",
    "verse": "26",
    "text": "Thân xác và tâm hồn con tàn tạ,"
  },
  {
    "id": 23918,
    "book": "psalms                                  ",
    "chapter": "73",
    "verse": "27",
    "text": "Những ai cách xa Chúa sẽ hư vong,"
  },
  {
    "id": 23919,
    "book": "psalms                                  ",
    "chapter": "73",
    "verse": "28",
    "text": "Nhưng riêng con, được gần Đức Chúa Trời thật phước hạnh thay!"
  }
]