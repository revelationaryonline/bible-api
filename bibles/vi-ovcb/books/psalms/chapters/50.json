[
  {
    "id": 23540,
    "book": "psalms                                  ",
    "chapter": "50",
    "verse": "1",
    "text": "Chúa Hằng Hữu, Đấng Toàn Năng, là Đức Chúa Trời,"
  },
  {
    "id": 23541,
    "book": "psalms                                  ",
    "chapter": "50",
    "verse": "2",
    "text": "Từ Núi Si-ôn, kinh thành đẹp đẽ tuyệt vời,"
  },
  {
    "id": 23542,
    "book": "psalms                                  ",
    "chapter": "50",
    "verse": "3",
    "text": "Đức Chúa Trời chúng ta quang lâm,"
  },
  {
    "id": 23543,
    "book": "psalms                                  ",
    "chapter": "50",
    "verse": "4",
    "text": "Ngài bảo trời đất làm nhân chứng"
  },
  {
    "id": 23544,
    "book": "psalms                                  ",
    "chapter": "50",
    "verse": "5",
    "text": "Ngài ra lệnh triệu tập đoàn dân thánh,"
  },
  {
    "id": 23545,
    "book": "psalms                                  ",
    "chapter": "50",
    "verse": "6",
    "text": "Trời xanh thẳm tuyên rao Ngài công chính,"
  },
  {
    "id": 23546,
    "book": "psalms                                  ",
    "chapter": "50",
    "verse": "7",
    "text": "“Hỡi dân Ta, lắng nghe lời Ta nói."
  },
  {
    "id": 23547,
    "book": "psalms                                  ",
    "chapter": "50",
    "verse": "8",
    "text": "Ta không trách các ngươi vì tế lễ,"
  },
  {
    "id": 23548,
    "book": "psalms                                  ",
    "chapter": "50",
    "verse": "9",
    "text": "Nhưng Ta không cần bò giữa trại,"
  },
  {
    "id": 23549,
    "book": "psalms                                  ",
    "chapter": "50",
    "verse": "10",
    "text": "Vì tất cả thú rừng thuộc về Ta,"
  },
  {
    "id": 23550,
    "book": "psalms                                  ",
    "chapter": "50",
    "verse": "11",
    "text": "Ta quen biết từng con chim trên các núi,"
  },
  {
    "id": 23551,
    "book": "psalms                                  ",
    "chapter": "50",
    "verse": "12",
    "text": "Nếu Ta đói, cũng không cần cho ngươi biết,"
  },
  {
    "id": 23552,
    "book": "psalms                                  ",
    "chapter": "50",
    "verse": "13",
    "text": "Ta há ăn thịt bò tế lễ chăng?"
  },
  {
    "id": 23553,
    "book": "psalms                                  ",
    "chapter": "50",
    "verse": "14",
    "text": "Hãy dâng lời tạ ơn làm tế lễ lên Đức Chúa Trời,"
  },
  {
    "id": 23554,
    "book": "psalms                                  ",
    "chapter": "50",
    "verse": "15",
    "text": "Hãy kêu cầu Ta trong lúc gian truân,"
  },
  {
    "id": 23555,
    "book": "psalms                                  ",
    "chapter": "50",
    "verse": "16",
    "text": "Nhưng Đức Chúa Trời trách những người gian ác:"
  },
  {
    "id": 23556,
    "book": "psalms                                  ",
    "chapter": "50",
    "verse": "17",
    "text": "Ngươi vốn ghét thi hành mệnh lệnh,"
  },
  {
    "id": 23557,
    "book": "psalms                                  ",
    "chapter": "50",
    "verse": "18",
    "text": "Thấy kẻ trộm, ngươi tán thành hành động của chúng,"
  },
  {
    "id": 23558,
    "book": "psalms                                  ",
    "chapter": "50",
    "verse": "19",
    "text": "Miệng ngươi tuôn những lời ác độc,"
  },
  {
    "id": 23559,
    "book": "psalms                                  ",
    "chapter": "50",
    "verse": "20",
    "text": "Đặt chuyện cáo gian em ruột,"
  },
  {
    "id": 23560,
    "book": "psalms                                  ",
    "chapter": "50",
    "verse": "21",
    "text": "Ngươi tác hại người khi Ta thinh lặng;50:21 Nt đấy là những công việc ngươi làm"
  },
  {
    "id": 23561,
    "book": "psalms                                  ",
    "chapter": "50",
    "verse": "22",
    "text": "Bọn người quên Chúa nên lưu ý,"
  },
  {
    "id": 23562,
    "book": "psalms                                  ",
    "chapter": "50",
    "verse": "23",
    "text": "Ai dâng lời cảm tạ làm tế lễ là tôn kính Ta."
  }
]