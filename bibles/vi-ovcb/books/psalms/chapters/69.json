[
  {
    "id": 23807,
    "book": "psalms                                  ",
    "chapter": "69",
    "verse": "1",
    "text": "Lạy Đức Chúa Trời, xin ra tay cứu vớt,"
  },
  {
    "id": 23808,
    "book": "psalms                                  ",
    "chapter": "69",
    "verse": "2",
    "text": "Con bị lún trong bùn sâu;"
  },
  {
    "id": 23809,
    "book": "psalms                                  ",
    "chapter": "69",
    "verse": "3",
    "text": "Con khản tiếng vì kêu van,"
  },
  {
    "id": 23810,
    "book": "psalms                                  ",
    "chapter": "69",
    "verse": "4",
    "text": "Người ghét con vô lý"
  },
  {
    "id": 23811,
    "book": "psalms                                  ",
    "chapter": "69",
    "verse": "5",
    "text": "Lạy Đức Chúa Trời, Chúa biết con khờ dại;"
  },
  {
    "id": 23812,
    "book": "psalms                                  ",
    "chapter": "69",
    "verse": "6",
    "text": "Xin đừng để người trông đợi Chúa phải xấu hổ vì con,"
  },
  {
    "id": 23813,
    "book": "psalms                                  ",
    "chapter": "69",
    "verse": "7",
    "text": "Vì Chúa, con bị người đời khinh bỉ;"
  },
  {
    "id": 23814,
    "book": "psalms                                  ",
    "chapter": "69",
    "verse": "8",
    "text": "Ngay cả anh em ruột cũng giả bộ không biết con,"
  },
  {
    "id": 23815,
    "book": "psalms                                  ",
    "chapter": "69",
    "verse": "9",
    "text": "Lòng sốt sắng về nhà Chúa nung nấu con,"
  },
  {
    "id": 23816,
    "book": "psalms                                  ",
    "chapter": "69",
    "verse": "10",
    "text": "Khi con khóc lóc nhịn ăn,"
  },
  {
    "id": 23817,
    "book": "psalms                                  ",
    "chapter": "69",
    "verse": "11",
    "text": "Khi con mặc áo gai với lòng thống hối,"
  },
  {
    "id": 23818,
    "book": "psalms                                  ",
    "chapter": "69",
    "verse": "12",
    "text": "Bọn ngồi ở cửa thành đem con ra giễu cợt,"
  },
  {
    "id": 23819,
    "book": "psalms                                  ",
    "chapter": "69",
    "verse": "13",
    "text": "Nhưng con chỉ biết cầu xin Chúa Hằng Hữu,"
  },
  {
    "id": 23820,
    "book": "psalms                                  ",
    "chapter": "69",
    "verse": "14",
    "text": "Xin vớt con khỏi vũng lầy;"
  },
  {
    "id": 23821,
    "book": "psalms                                  ",
    "chapter": "69",
    "verse": "15",
    "text": "Xin đừng để nước lũ phủ lấp con,"
  },
  {
    "id": 23822,
    "book": "psalms                                  ",
    "chapter": "69",
    "verse": "16",
    "text": "Lạy Chúa Hằng Hữu, xin đáp lời con"
  },
  {
    "id": 23823,
    "book": "psalms                                  ",
    "chapter": "69",
    "verse": "17",
    "text": "Xin đừng ngoảnh mặt khỏi đầy tớ Chúa;"
  },
  {
    "id": 23824,
    "book": "psalms                                  ",
    "chapter": "69",
    "verse": "18",
    "text": "Xin lại gần và đưa tay giải cứu,"
  },
  {
    "id": 23825,
    "book": "psalms                                  ",
    "chapter": "69",
    "verse": "19",
    "text": "Chúa biết con phải hổ thẹn, bị khinh khi, và nhục nhã."
  },
  {
    "id": 23826,
    "book": "psalms                                  ",
    "chapter": "69",
    "verse": "20",
    "text": "Họ khinh miệt đập lòng con tan nát,"
  },
  {
    "id": 23827,
    "book": "psalms                                  ",
    "chapter": "69",
    "verse": "21",
    "text": "Họ trộn mật độc cho con ăn69:21 Nt thức ăn của con"
  },
  {
    "id": 23828,
    "book": "psalms                                  ",
    "chapter": "69",
    "verse": "22",
    "text": "Nguyện bàn tiệc trước mặt họ thành cái bẫy,"
  },
  {
    "id": 23829,
    "book": "psalms                                  ",
    "chapter": "69",
    "verse": "23",
    "text": "Nguyện mắt họ tối đen không thấy được,"
  },
  {
    "id": 23830,
    "book": "psalms                                  ",
    "chapter": "69",
    "verse": "24",
    "text": "Xin Chúa trút trên họ cơn giận,"
  },
  {
    "id": 23831,
    "book": "psalms                                  ",
    "chapter": "69",
    "verse": "25",
    "text": "Nguyện nơi họ ở trở thành hoang địa,"
  },
  {
    "id": 23832,
    "book": "psalms                                  ",
    "chapter": "69",
    "verse": "26",
    "text": "Vì họ bức hại người bị Chúa trừng trị;69:26 Nt người bị Chúa gây thương tích"
  },
  {
    "id": 23833,
    "book": "psalms                                  ",
    "chapter": "69",
    "verse": "27",
    "text": "Xin buộc cho họ tội này đến tội khác,"
  },
  {
    "id": 23834,
    "book": "psalms                                  ",
    "chapter": "69",
    "verse": "28",
    "text": "Trong Sách Sự Sống, tên họ bị bôi xóa,"
  },
  {
    "id": 23835,
    "book": "psalms                                  ",
    "chapter": "69",
    "verse": "29",
    "text": "Con đang đau ê ẩm và kiệt sức,"
  },
  {
    "id": 23836,
    "book": "psalms                                  ",
    "chapter": "69",
    "verse": "30",
    "text": "Lấy lời thánh ca, con ngợi khen Đức Chúa Trời,"
  },
  {
    "id": 23837,
    "book": "psalms                                  ",
    "chapter": "69",
    "verse": "31",
    "text": "Hành động ấy vui lòng Chúa Hằng Hữu, hơn tế lễ bằng bò,"
  },
  {
    "id": 23838,
    "book": "psalms                                  ",
    "chapter": "69",
    "verse": "32",
    "text": "Người khiêm tốn sẽ thấy công việc của Đức Chúa Trời và vui mừng."
  },
  {
    "id": 23839,
    "book": "psalms                                  ",
    "chapter": "69",
    "verse": "33",
    "text": "Vì Chúa Hằng Hữu nhậm lời người thiếu thốn;"
  },
  {
    "id": 23840,
    "book": "psalms                                  ",
    "chapter": "69",
    "verse": "34",
    "text": "Hỡi trời và đất, hãy ca tụng Chúa,"
  },
  {
    "id": 23841,
    "book": "psalms                                  ",
    "chapter": "69",
    "verse": "35",
    "text": "Vì Đức Chúa Trời sẽ giải cứu Si-ôn,"
  },
  {
    "id": 23842,
    "book": "psalms                                  ",
    "chapter": "69",
    "verse": "36",
    "text": "Dòng dõi của những ai vâng phục Chúa sẽ hưởng được đất,"
  }
]