[
  {
    "id": 23123,
    "book": "psalms                                  ",
    "chapter": "25",
    "verse": "1",
    "text": "Lạy Chúa Hằng Hữu, linh hồn con hướng về Chúa."
  },
  {
    "id": 23124,
    "book": "psalms                                  ",
    "chapter": "25",
    "verse": "2",
    "text": "Đức Chúa Trời ôi, con tin cậy Ngài luôn!"
  },
  {
    "id": 23125,
    "book": "psalms                                  ",
    "chapter": "25",
    "verse": "3",
    "text": "Không ai hy vọng nơi Chúa mà bị hổ thẹn,"
  },
  {
    "id": 23126,
    "book": "psalms                                  ",
    "chapter": "25",
    "verse": "4",
    "text": "Xin chỉ cho con đường lối, lạy Chúa Hằng Hữu;"
  },
  {
    "id": 23127,
    "book": "psalms                                  ",
    "chapter": "25",
    "verse": "5",
    "text": "Xin dẫn con đi vào chân lý và khuyên bảo con,"
  },
  {
    "id": 23128,
    "book": "psalms                                  ",
    "chapter": "25",
    "verse": "6",
    "text": "Xin nhớ lại, ôi Chúa Hằng Hữu, đức nhân từ thương xót của Ngài,"
  },
  {
    "id": 23129,
    "book": "psalms                                  ",
    "chapter": "25",
    "verse": "7",
    "text": "Xin đừng nhớ hành vi nổi loạn của con thời tuổi trẻ."
  },
  {
    "id": 23130,
    "book": "psalms                                  ",
    "chapter": "25",
    "verse": "8",
    "text": "Chúa Hằng Hữu thiện lành và chính trực;"
  },
  {
    "id": 23131,
    "book": "psalms                                  ",
    "chapter": "25",
    "verse": "9",
    "text": "Dẫn người khiêm cung theo chân lý,"
  },
  {
    "id": 23132,
    "book": "psalms                                  ",
    "chapter": "25",
    "verse": "10",
    "text": "Đường lối Chúa Hằng Hữu là nhân từ chân thật"
  },
  {
    "id": 23133,
    "book": "psalms                                  ",
    "chapter": "25",
    "verse": "11",
    "text": "Ôi Chúa Hằng Hữu, vì Danh Ngài,"
  },
  {
    "id": 23134,
    "book": "psalms                                  ",
    "chapter": "25",
    "verse": "12",
    "text": "Ai là người kính sợ Chúa Hằng Hữu?"
  },
  {
    "id": 23135,
    "book": "psalms                                  ",
    "chapter": "25",
    "verse": "13",
    "text": "Người sẽ sống đời mình trong hưng thịnh."
  },
  {
    "id": 23136,
    "book": "psalms                                  ",
    "chapter": "25",
    "verse": "14",
    "text": "Chúa Hằng Hữu là bạn của người tin kính."
  },
  {
    "id": 23137,
    "book": "psalms                                  ",
    "chapter": "25",
    "verse": "15",
    "text": "Mắt con mòn mỏi trông Chúa Hằng Hữu đến,"
  },
  {
    "id": 23138,
    "book": "psalms                                  ",
    "chapter": "25",
    "verse": "16",
    "text": "Xin xót thương, trở lại với con,"
  },
  {
    "id": 23139,
    "book": "psalms                                  ",
    "chapter": "25",
    "verse": "17",
    "text": "Nỗi đau thương sao gia tăng mãi."
  },
  {
    "id": 23140,
    "book": "psalms                                  ",
    "chapter": "25",
    "verse": "18",
    "text": "Xin Chúa xem cảnh lầm than, khốn khó."
  },
  {
    "id": 23141,
    "book": "psalms                                  ",
    "chapter": "25",
    "verse": "19",
    "text": "Quân thù nghịch gia tăng gấp bội"
  },
  {
    "id": 23142,
    "book": "psalms                                  ",
    "chapter": "25",
    "verse": "20",
    "text": "Xin bảo vệ con! Xin gìn giữ linh hồn con!"
  },
  {
    "id": 23143,
    "book": "psalms                                  ",
    "chapter": "25",
    "verse": "21",
    "text": "Xin Ngài bảo vệ con trong nếp sống,"
  },
  {
    "id": 23144,
    "book": "psalms                                  ",
    "chapter": "25",
    "verse": "22",
    "text": "Lạy Đức Chúa Trời, xin cứu chuộc Ít-ra-ên,"
  }
]