[
  {
    "id": 23203,
    "book": "psalms                                  ",
    "chapter": "31",
    "verse": "1",
    "text": "Chúa Hằng Hữu ôi, con nương tựa nơi Ngài;"
  },
  {
    "id": 23204,
    "book": "psalms                                  ",
    "chapter": "31",
    "verse": "2",
    "text": "Xin lắng tai nghe con cầu nguyện;"
  },
  {
    "id": 23205,
    "book": "psalms                                  ",
    "chapter": "31",
    "verse": "3",
    "text": "Vì Chúa là vầng đá và đồn lũy con."
  },
  {
    "id": 23206,
    "book": "psalms                                  ",
    "chapter": "31",
    "verse": "4",
    "text": "Xin gỡ con khỏi lưới chúng giăng,"
  },
  {
    "id": 23207,
    "book": "psalms                                  ",
    "chapter": "31",
    "verse": "5",
    "text": "Con xin giao thác linh hồn trong tay Chúa."
  },
  {
    "id": 23208,
    "book": "psalms                                  ",
    "chapter": "31",
    "verse": "6",
    "text": "Con ghét người thờ thần tượng hư ảo,"
  },
  {
    "id": 23209,
    "book": "psalms                                  ",
    "chapter": "31",
    "verse": "7",
    "text": "Con sẽ hân hoan vui mừng trong tình yêu của Chúa,"
  },
  {
    "id": 23210,
    "book": "psalms                                  ",
    "chapter": "31",
    "verse": "8",
    "text": "Chúa không giao nạp con vào tay kẻ địch,"
  },
  {
    "id": 23211,
    "book": "psalms                                  ",
    "chapter": "31",
    "verse": "9",
    "text": "Xin thương xót, lạy Chúa Hằng Hữu, vì con khốn đốn."
  },
  {
    "id": 23212,
    "book": "psalms                                  ",
    "chapter": "31",
    "verse": "10",
    "text": "Đời con tiêu hao trong thống khổ,"
  },
  {
    "id": 23213,
    "book": "psalms                                  ",
    "chapter": "31",
    "verse": "11",
    "text": "Với kẻ thù, con chỉ là sỉ nhục,"
  },
  {
    "id": 23214,
    "book": "psalms                                  ",
    "chapter": "31",
    "verse": "12",
    "text": "Con bị quên như người đã chết,"
  },
  {
    "id": 23215,
    "book": "psalms                                  ",
    "chapter": "31",
    "verse": "13",
    "text": "Con nghe nhiều kẻ thù phỉ báng,"
  },
  {
    "id": 23216,
    "book": "psalms                                  ",
    "chapter": "31",
    "verse": "14",
    "text": "Chúa Hằng Hữu ôi, lòng con tin cậy Chúa."
  },
  {
    "id": 23217,
    "book": "psalms                                  ",
    "chapter": "31",
    "verse": "15",
    "text": "Tương lai con ở trong tay Chúa."
  },
  {
    "id": 23218,
    "book": "psalms                                  ",
    "chapter": "31",
    "verse": "16",
    "text": "Xin Thiên nhan sáng soi đầy tớ Chúa."
  },
  {
    "id": 23219,
    "book": "psalms                                  ",
    "chapter": "31",
    "verse": "17",
    "text": "Lạy Chúa Hằng Hữu, xin đừng để con bị hổ thẹn,"
  },
  {
    "id": 23220,
    "book": "psalms                                  ",
    "chapter": "31",
    "verse": "18",
    "text": "Cho câm nín đôi môi dối trá—"
  },
  {
    "id": 23221,
    "book": "psalms                                  ",
    "chapter": "31",
    "verse": "19",
    "text": "Thật lớn thay tình thương của Chúa,"
  },
  {
    "id": 23222,
    "book": "psalms                                  ",
    "chapter": "31",
    "verse": "20",
    "text": "Chúa giấu họ vào nơi kín đáo,"
  },
  {
    "id": 23223,
    "book": "psalms                                  ",
    "chapter": "31",
    "verse": "21",
    "text": "Đáng chúc tụng Chúa Hằng Hữu,"
  },
  {
    "id": 23224,
    "book": "psalms                                  ",
    "chapter": "31",
    "verse": "22",
    "text": "Lúc thiếu suy xét, con đã nói:"
  },
  {
    "id": 23225,
    "book": "psalms                                  ",
    "chapter": "31",
    "verse": "23",
    "text": "Các người thánh, hãy yêu mến Chúa Hằng Hữu!"
  },
  {
    "id": 23226,
    "book": "psalms                                  ",
    "chapter": "31",
    "verse": "24",
    "text": "Hỡi tất cả những người trông cậy Chúa Hằng Hữu!"
  }
]