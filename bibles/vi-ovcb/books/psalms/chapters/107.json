[
  {
    "id": 24571,
    "book": "psalms                                  ",
    "chapter": "107",
    "verse": "1",
    "text": "Hãy cảm tạ Chúa Hằng Hữu, vì Ngài là thiện!"
  },
  {
    "id": 24572,
    "book": "psalms                                  ",
    "chapter": "107",
    "verse": "2",
    "text": "Có phải Chúa Hằng Hữu đã cứu không? Hãy nói lớn!"
  },
  {
    "id": 24573,
    "book": "psalms                                  ",
    "chapter": "107",
    "verse": "3",
    "text": "Chúa đã hội họp dân lưu đày từ các nước,"
  },
  {
    "id": 24574,
    "book": "psalms                                  ",
    "chapter": "107",
    "verse": "4",
    "text": "Họ lưu lạc giữa hoang mạc hoang vu,"
  },
  {
    "id": 24575,
    "book": "psalms                                  ",
    "chapter": "107",
    "verse": "5",
    "text": "Đói và khát,"
  },
  {
    "id": 24576,
    "book": "psalms                                  ",
    "chapter": "107",
    "verse": "6",
    "text": "Lúc gian nan, họ kêu cầu: “Lạy Chúa Hằng Hữu, xin cứu giúp!”"
  },
  {
    "id": 24577,
    "book": "psalms                                  ",
    "chapter": "107",
    "verse": "7",
    "text": "Chúa dẫn họ theo đường ngay thẳng,"
  },
  {
    "id": 24578,
    "book": "psalms                                  ",
    "chapter": "107",
    "verse": "8",
    "text": "Nguyện con người ngợi tôn Chúa Hằng Hữu vì tình yêu quá lớn của Ngài,"
  },
  {
    "id": 24579,
    "book": "psalms                                  ",
    "chapter": "107",
    "verse": "9",
    "text": "Chúa thỏa mãn tâm hồn khao khát"
  },
  {
    "id": 24580,
    "book": "psalms                                  ",
    "chapter": "107",
    "verse": "10",
    "text": "Có người đang ngồi trong bóng tối tử vong,"
  },
  {
    "id": 24581,
    "book": "psalms                                  ",
    "chapter": "107",
    "verse": "11",
    "text": "Họ từng nổi loạn chống đối lời Đức Chúa Trời,"
  },
  {
    "id": 24582,
    "book": "psalms                                  ",
    "chapter": "107",
    "verse": "12",
    "text": "Nên Ngài dùng gian khổ để kỷ luật họ,"
  },
  {
    "id": 24583,
    "book": "psalms                                  ",
    "chapter": "107",
    "verse": "13",
    "text": "“Lạy Chúa Hằng Hữu, xin cứu giúp!” Họ kêu cầu trong lúc gian nan,"
  },
  {
    "id": 24584,
    "book": "psalms                                  ",
    "chapter": "107",
    "verse": "14",
    "text": "Đem họ thoát vùng bóng tối tử vong;"
  },
  {
    "id": 24585,
    "book": "psalms                                  ",
    "chapter": "107",
    "verse": "15",
    "text": "Nguyện con người ngợi tôn Chúa Hằng Hữu vì tình yêu quá lớn của Ngài,"
  },
  {
    "id": 24586,
    "book": "psalms                                  ",
    "chapter": "107",
    "verse": "16",
    "text": "Vì Ngài bẻ gông, xiềng bằng đồng,"
  },
  {
    "id": 24587,
    "book": "psalms                                  ",
    "chapter": "107",
    "verse": "17",
    "text": "Người dại dột theo đường tội lỗi,"
  },
  {
    "id": 24588,
    "book": "psalms                                  ",
    "chapter": "107",
    "verse": "18",
    "text": "Họ không thiết ăn uống,"
  },
  {
    "id": 24589,
    "book": "psalms                                  ",
    "chapter": "107",
    "verse": "19",
    "text": "Bấy giờ trong lúc nguy khốn, họ kêu cầu Chúa,"
  },
  {
    "id": 24590,
    "book": "psalms                                  ",
    "chapter": "107",
    "verse": "20",
    "text": "Ngài ra lệnh chữa lành bệnh tật,"
  },
  {
    "id": 24591,
    "book": "psalms                                  ",
    "chapter": "107",
    "verse": "21",
    "text": "Nguyện con người ngợi tôn Chúa Hằng Hữu vì tình yêu quá lớn của Ngài"
  },
  {
    "id": 24592,
    "book": "psalms                                  ",
    "chapter": "107",
    "verse": "22",
    "text": "Nguyện họ dâng tế lễ tạ ơn"
  },
  {
    "id": 24593,
    "book": "psalms                                  ",
    "chapter": "107",
    "verse": "23",
    "text": "Những ai làm ăn trên biển,"
  },
  {
    "id": 24594,
    "book": "psalms                                  ",
    "chapter": "107",
    "verse": "24",
    "text": "Đều nhận ra năng quyền Chúa Hằng Hữu,"
  },
  {
    "id": 24595,
    "book": "psalms                                  ",
    "chapter": "107",
    "verse": "25",
    "text": "Ngài truyền lệnh nổi cơn gió bão,"
  },
  {
    "id": 24596,
    "book": "psalms                                  ",
    "chapter": "107",
    "verse": "26",
    "text": "Nâng tàu lên cao tận trời xanh,"
  },
  {
    "id": 24597,
    "book": "psalms                                  ",
    "chapter": "107",
    "verse": "27",
    "text": "Như người say quay cuồng lảo đảo,"
  },
  {
    "id": 24598,
    "book": "psalms                                  ",
    "chapter": "107",
    "verse": "28",
    "text": "Trong lúc gian nan họ kêu cầu:"
  },
  {
    "id": 24599,
    "book": "psalms                                  ",
    "chapter": "107",
    "verse": "29",
    "text": "Ban lệnh trên gió nước đại dương,"
  },
  {
    "id": 24600,
    "book": "psalms                                  ",
    "chapter": "107",
    "verse": "30",
    "text": "Họ vui mừng vì tai qua nạn khỏi,"
  },
  {
    "id": 24601,
    "book": "psalms                                  ",
    "chapter": "107",
    "verse": "31",
    "text": "Nguyện con người ngợi tôn Chúa Hằng Hữu vì tình yêu quá lớn của Ngài,"
  },
  {
    "id": 24602,
    "book": "psalms                                  ",
    "chapter": "107",
    "verse": "32",
    "text": "Hãy vinh danh Chúa cùng hội chúng,"
  },
  {
    "id": 24603,
    "book": "psalms                                  ",
    "chapter": "107",
    "verse": "33",
    "text": "Chúa biến sông xanh thành hoang mạc,"
  },
  {
    "id": 24604,
    "book": "psalms                                  ",
    "chapter": "107",
    "verse": "34",
    "text": "Do lòng gian dối của cư dân,"
  },
  {
    "id": 24605,
    "book": "psalms                                  ",
    "chapter": "107",
    "verse": "35",
    "text": "Nhưng, Chúa cũng biến hoang mạc thành hồ ao,"
  },
  {
    "id": 24606,
    "book": "psalms                                  ",
    "chapter": "107",
    "verse": "36",
    "text": "Ngài đem người đói đến cư trú tại đó"
  },
  {
    "id": 24607,
    "book": "psalms                                  ",
    "chapter": "107",
    "verse": "37",
    "text": "Họ gieo giống trong ruộng và trồng nho,"
  },
  {
    "id": 24608,
    "book": "psalms                                  ",
    "chapter": "107",
    "verse": "38",
    "text": "Chúa ban phước cho họ biết bao!"
  },
  {
    "id": 24609,
    "book": "psalms                                  ",
    "chapter": "107",
    "verse": "39",
    "text": "Khi họ bị suy giảm dân số và sa sút,"
  },
  {
    "id": 24610,
    "book": "psalms                                  ",
    "chapter": "107",
    "verse": "40",
    "text": "Chúa Hằng Hữu đổ sự khinh miệt trên các vua chúa,"
  },
  {
    "id": 24611,
    "book": "psalms                                  ",
    "chapter": "107",
    "verse": "41",
    "text": "Nhưng Ngài giải cứu người nghèo khổ khỏi hoạn nạn"
  },
  {
    "id": 24612,
    "book": "psalms                                  ",
    "chapter": "107",
    "verse": "42",
    "text": "Những người công chính sẽ thấy điều này và vui mừng,"
  },
  {
    "id": 24613,
    "book": "psalms                                  ",
    "chapter": "107",
    "verse": "43",
    "text": "Nguyện người khôn ngoan ghi nhận việc này,"
  }
]