[
  {
    "id": 24443,
    "book": "psalms                                  ",
    "chapter": "104",
    "verse": "1",
    "text": "Hồn ta hỡi, hãy dâng tiếng ca ngợi Chúa Hằng Hữu."
  },
  {
    "id": 24444,
    "book": "psalms                                  ",
    "chapter": "104",
    "verse": "2",
    "text": "Ánh sáng bọc quanh Ngài như chiếc áo."
  },
  {
    "id": 24445,
    "book": "psalms                                  ",
    "chapter": "104",
    "verse": "3",
    "text": "đặt các xà ngang của lâu đài Ngài trên nước,"
  },
  {
    "id": 24446,
    "book": "psalms                                  ",
    "chapter": "104",
    "verse": "4",
    "text": "Ngài sai gió ra đi làm sứ giả104:4 Ctd Đấng làm cho thiên sứ Ngài như các thiên thần"
  },
  {
    "id": 24447,
    "book": "psalms                                  ",
    "chapter": "104",
    "verse": "5",
    "text": "Chúa đặt vững trụ nền trái đất"
  },
  {
    "id": 24448,
    "book": "psalms                                  ",
    "chapter": "104",
    "verse": "6",
    "text": "Chúa phủ mặt đất bằng vực thẳm,104:6 Nt thêm: như chiếc áo"
  },
  {
    "id": 24449,
    "book": "psalms                                  ",
    "chapter": "104",
    "verse": "7",
    "text": "Nghe Chúa quở nước liền chạy trốn;"
  },
  {
    "id": 24450,
    "book": "psalms                                  ",
    "chapter": "104",
    "verse": "8",
    "text": "Nước phủ ngập trên núi cao, tràn vào thung lũng,"
  },
  {
    "id": 24451,
    "book": "psalms                                  ",
    "chapter": "104",
    "verse": "9",
    "text": "Chúa đặt ranh giới cho nước,"
  },
  {
    "id": 24452,
    "book": "psalms                                  ",
    "chapter": "104",
    "verse": "10",
    "text": "Chúa làm suối tuôn trào trong thung lũng,"
  },
  {
    "id": 24453,
    "book": "psalms                                  ",
    "chapter": "104",
    "verse": "11",
    "text": "Suối, sông cung cấp nước ngọt104:11 Ctd nước uống cho thú đồng,"
  },
  {
    "id": 24454,
    "book": "psalms                                  ",
    "chapter": "104",
    "verse": "12",
    "text": "Chim chóc quần tụ quanh bờ suối"
  },
  {
    "id": 24455,
    "book": "psalms                                  ",
    "chapter": "104",
    "verse": "13",
    "text": "Từ lầu cao, Chúa cho mưa khắp núi,"
  },
  {
    "id": 24456,
    "book": "psalms                                  ",
    "chapter": "104",
    "verse": "14",
    "text": "Chúa khiến cỏ mọc lên nuôi gia súc,"
  },
  {
    "id": 24457,
    "book": "psalms                                  ",
    "chapter": "104",
    "verse": "15",
    "text": "ban rượu làm phấn chấn tâm hồn,"
  },
  {
    "id": 24458,
    "book": "psalms                                  ",
    "chapter": "104",
    "verse": "16",
    "text": "Cây cối của Chúa Hằng Hữu được dầm thấm nước—"
  },
  {
    "id": 24459,
    "book": "psalms                                  ",
    "chapter": "104",
    "verse": "17",
    "text": "Nơi có chim làm tổ,"
  },
  {
    "id": 24460,
    "book": "psalms                                  ",
    "chapter": "104",
    "verse": "18",
    "text": "Các ngọn núi cao dành cho dê rừng"
  },
  {
    "id": 24461,
    "book": "psalms                                  ",
    "chapter": "104",
    "verse": "19",
    "text": "Chúa dùng mặt trăng phân định bốn mùa,"
  },
  {
    "id": 24462,
    "book": "psalms                                  ",
    "chapter": "104",
    "verse": "20",
    "text": "Tay Chúa kéo bức màn đêm xuống,"
  },
  {
    "id": 24463,
    "book": "psalms                                  ",
    "chapter": "104",
    "verse": "21",
    "text": "Sư tử tơ gầm thét đuổi theo mồi,"
  },
  {
    "id": 24464,
    "book": "psalms                                  ",
    "chapter": "104",
    "verse": "22",
    "text": "Bình minh chiếu rực, thú rừng lui,"
  },
  {
    "id": 24465,
    "book": "psalms                                  ",
    "chapter": "104",
    "verse": "23",
    "text": "Loài người đi ra đồng canh tác,"
  },
  {
    "id": 24466,
    "book": "psalms                                  ",
    "chapter": "104",
    "verse": "24",
    "text": "Lạy Chúa Hằng Hữu, công việc Chúa vô biên, huyền diệu!"
  },
  {
    "id": 24467,
    "book": "psalms                                  ",
    "chapter": "104",
    "verse": "25",
    "text": "Lòng đại dương sâu rộng mênh mông,"
  },
  {
    "id": 24468,
    "book": "psalms                                  ",
    "chapter": "104",
    "verse": "26",
    "text": "Tàu bè qua lại,"
  },
  {
    "id": 24469,
    "book": "psalms                                  ",
    "chapter": "104",
    "verse": "27",
    "text": "Vạn vật sống đều do tay Chúa,"
  },
  {
    "id": 24470,
    "book": "psalms                                  ",
    "chapter": "104",
    "verse": "28",
    "text": "Chúa phân phối, chúng liền ăn uống"
  },
  {
    "id": 24471,
    "book": "psalms                                  ",
    "chapter": "104",
    "verse": "29",
    "text": "Chúa ngoảnh mặt, chúng đều sợ hãi."
  },
  {
    "id": 24472,
    "book": "psalms                                  ",
    "chapter": "104",
    "verse": "30",
    "text": "Khi Chúa truyền sinh khí, sự sống được dựng nên,"
  },
  {
    "id": 24473,
    "book": "psalms                                  ",
    "chapter": "104",
    "verse": "31",
    "text": "Vinh quang Chúa sáng rực đời đời!"
  },
  {
    "id": 24474,
    "book": "psalms                                  ",
    "chapter": "104",
    "verse": "32",
    "text": "Chúa nhìn địa cầu, đất liền rung chuyển;"
  },
  {
    "id": 24475,
    "book": "psalms                                  ",
    "chapter": "104",
    "verse": "33",
    "text": "Con sẽ ca ngợi Chúa suốt đời con."
  },
  {
    "id": 24476,
    "book": "psalms                                  ",
    "chapter": "104",
    "verse": "34",
    "text": "Nguyện mọi suy nghĩ con vui lòng Chúa,"
  },
  {
    "id": 24477,
    "book": "psalms                                  ",
    "chapter": "104",
    "verse": "35",
    "text": "Ước gì bọn tội ác bị tiêu diệt khỏi đất;"
  }
]