[
  {
    "id": 25148,
    "book": "psalms                                  ",
    "chapter": "141",
    "verse": "1",
    "text": "Lạy Chúa Hằng Hữu, con kêu cầu Ngài. Xin mau đến!"
  },
  {
    "id": 25149,
    "book": "psalms                                  ",
    "chapter": "141",
    "verse": "2",
    "text": "Xin cho lời cầu nguyện con bay đến Ngài như khói hương,"
  },
  {
    "id": 25150,
    "book": "psalms                                  ",
    "chapter": "141",
    "verse": "3",
    "text": "Xin canh chừng miệng con, lạy Chúa Hằng Hữu,"
  },
  {
    "id": 25151,
    "book": "psalms                                  ",
    "chapter": "141",
    "verse": "4",
    "text": "Xin đừng cho lòng con hướng về điều xấu,"
  },
  {
    "id": 25152,
    "book": "psalms                                  ",
    "chapter": "141",
    "verse": "5",
    "text": "Xin cho người công chính đánh con!"
  },
  {
    "id": 25153,
    "book": "psalms                                  ",
    "chapter": "141",
    "verse": "6",
    "text": "Khi các phán quan của họ bị ném vào tảng đá,"
  },
  {
    "id": 25154,
    "book": "psalms                                  ",
    "chapter": "141",
    "verse": "7",
    "text": "Khi người ta cày đất,"
  },
  {
    "id": 25155,
    "book": "psalms                                  ",
    "chapter": "141",
    "verse": "8",
    "text": "Con hướng mắt về Ngài, lạy Chúa Hằng Hữu Chí Cao."
  },
  {
    "id": 25156,
    "book": "psalms                                  ",
    "chapter": "141",
    "verse": "9",
    "text": "Xin giữ con khỏi sa bẫy họ gài,"
  },
  {
    "id": 25157,
    "book": "psalms                                  ",
    "chapter": "141",
    "verse": "10",
    "text": "Xin cho người ác mắc vào lưới họ đã giăng,"
  }
]