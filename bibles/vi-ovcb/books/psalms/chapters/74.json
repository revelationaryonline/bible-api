[
  {
    "id": 23920,
    "book": "psalms                                  ",
    "chapter": "74",
    "verse": "1",
    "text": "Lạy Đức Chúa Trời, tại sao Chúa ruồng rẫy chúng con?"
  },
  {
    "id": 23921,
    "book": "psalms                                  ",
    "chapter": "74",
    "verse": "2",
    "text": "Xin nhớ lại dân mà Chúa đã chọn từ xưa,"
  },
  {
    "id": 23922,
    "book": "psalms                                  ",
    "chapter": "74",
    "verse": "3",
    "text": "Xin Chúa quang lâm thị sát cảnh điêu tàn;"
  },
  {
    "id": 23923,
    "book": "psalms                                  ",
    "chapter": "74",
    "verse": "4",
    "text": "Quân thù gào thét giữa nơi Chúa gặp gỡ chúng con;"
  },
  {
    "id": 23924,
    "book": "psalms                                  ",
    "chapter": "74",
    "verse": "5",
    "text": "Họ tung hoành như người tiều phu triệt hạ"
  },
  {
    "id": 23925,
    "book": "psalms                                  ",
    "chapter": "74",
    "verse": "6",
    "text": "Chúng phá nát những đồ chạm trổ"
  },
  {
    "id": 23926,
    "book": "psalms                                  ",
    "chapter": "74",
    "verse": "7",
    "text": "Họ châm lửa đốt nơi thánh Chúa."
  },
  {
    "id": 23927,
    "book": "psalms                                  ",
    "chapter": "74",
    "verse": "8",
    "text": "Họ bảo: “Bọn ta sẽ diệt phá mọi thứ!”"
  },
  {
    "id": 23928,
    "book": "psalms                                  ",
    "chapter": "74",
    "verse": "9",
    "text": "Chúng con không còn thấy những dấu lạ."
  },
  {
    "id": 23929,
    "book": "psalms                                  ",
    "chapter": "74",
    "verse": "10",
    "text": "Lạy Đức Chúa Trời, quân thù còn chế giễu đến bao giờ?"
  },
  {
    "id": 23930,
    "book": "psalms                                  ",
    "chapter": "74",
    "verse": "11",
    "text": "Sao Chúa cầm giữ sức mạnh trong tay phải?"
  },
  {
    "id": 23931,
    "book": "psalms                                  ",
    "chapter": "74",
    "verse": "12",
    "text": "Chúa, Đức Chúa Trời, là Vua của tôi từ nghìn xưa,"
  },
  {
    "id": 23932,
    "book": "psalms                                  ",
    "chapter": "74",
    "verse": "13",
    "text": "Dùng sức mạnh rạch biển ra,"
  },
  {
    "id": 23933,
    "book": "psalms                                  ",
    "chapter": "74",
    "verse": "14",
    "text": "Chúa chà nát đầu thủy quái Lê-vi-a-than,"
  },
  {
    "id": 23934,
    "book": "psalms                                  ",
    "chapter": "74",
    "verse": "15",
    "text": "Chúa chẻ núi, tạo dòng suối ngọt,"
  },
  {
    "id": 23935,
    "book": "psalms                                  ",
    "chapter": "74",
    "verse": "16",
    "text": "Cả ngày lẫn đêm đều thuộc về Chúa;"
  },
  {
    "id": 23936,
    "book": "psalms                                  ",
    "chapter": "74",
    "verse": "17",
    "text": "Quy định giới hạn địa cầu,"
  },
  {
    "id": 23937,
    "book": "psalms                                  ",
    "chapter": "74",
    "verse": "18",
    "text": "Lạy Chúa Hằng Hữu, xin nhớ lại lời quân thù chế nhạo."
  },
  {
    "id": 23938,
    "book": "psalms                                  ",
    "chapter": "74",
    "verse": "19",
    "text": "Xin đừng để dã thú hủy diệt bồ câu của Ngài."
  },
  {
    "id": 23939,
    "book": "psalms                                  ",
    "chapter": "74",
    "verse": "20",
    "text": "Xin nhớ đến giao ước Ngài hứa,"
  },
  {
    "id": 23940,
    "book": "psalms                                  ",
    "chapter": "74",
    "verse": "21",
    "text": "Xin đừng để người bị áp bức phải hổ nhục quay về."
  },
  {
    "id": 23941,
    "book": "psalms                                  ",
    "chapter": "74",
    "verse": "22",
    "text": "Lạy Đức Chúa Trời, xin vùng dậy, bênh vực chính nghĩa Ngài."
  },
  {
    "id": 23942,
    "book": "psalms                                  ",
    "chapter": "74",
    "verse": "23",
    "text": "Xin đừng quên tiếng la hét của quân thù,"
  }
]