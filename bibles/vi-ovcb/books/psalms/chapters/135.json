[
  {
    "id": 25047,
    "book": "psalms                                  ",
    "chapter": "135",
    "verse": "1",
    "text": "Ngợi tôn Chúa Hằng Hữu!"
  },
  {
    "id": 25048,
    "book": "psalms                                  ",
    "chapter": "135",
    "verse": "2",
    "text": "là những người phục vụ trong nhà Chúa Hằng Hữu,"
  },
  {
    "id": 25049,
    "book": "psalms                                  ",
    "chapter": "135",
    "verse": "3",
    "text": "Hãy ca ngợi Chúa Hằng Hữu, vì Chúa Hằng Hữu là toàn thiện;"
  },
  {
    "id": 25050,
    "book": "psalms                                  ",
    "chapter": "135",
    "verse": "4",
    "text": "Chúa Hằng Hữu đã chọn Gia-cốp,"
  },
  {
    "id": 25051,
    "book": "psalms                                  ",
    "chapter": "135",
    "verse": "5",
    "text": "Tôi biết Chúa Hằng Hữu vĩ đại—"
  },
  {
    "id": 25052,
    "book": "psalms                                  ",
    "chapter": "135",
    "verse": "6",
    "text": "Việc đẹp ý Chúa Hằng Hữu, Ngài đều thực hiện,"
  },
  {
    "id": 25053,
    "book": "psalms                                  ",
    "chapter": "135",
    "verse": "7",
    "text": "Chúa dẫn hơi nước bay lên từ địa cực."
  },
  {
    "id": 25054,
    "book": "psalms                                  ",
    "chapter": "135",
    "verse": "8",
    "text": "Chúa đánh giết con đầu lòng Ai Cập,"
  },
  {
    "id": 25055,
    "book": "psalms                                  ",
    "chapter": "135",
    "verse": "9",
    "text": "Làm nhiều phép lạ, diệu kỳ trong xứ Ai Cập,"
  },
  {
    "id": 25056,
    "book": "psalms                                  ",
    "chapter": "135",
    "verse": "10",
    "text": "Ngài đánh hạ các dân tộc lớn"
  },
  {
    "id": 25057,
    "book": "psalms                                  ",
    "chapter": "135",
    "verse": "11",
    "text": "Si-hôn, vua người A-mô-rít,"
  },
  {
    "id": 25058,
    "book": "psalms                                  ",
    "chapter": "135",
    "verse": "12",
    "text": "Ngài ban xứ họ cho Ít-ra-ên,"
  },
  {
    "id": 25059,
    "book": "psalms                                  ",
    "chapter": "135",
    "verse": "13",
    "text": "Lạy Chúa Hằng Hữu, Danh Ngài luôn tồn tại,"
  },
  {
    "id": 25060,
    "book": "psalms                                  ",
    "chapter": "135",
    "verse": "14",
    "text": "Chúa Hằng Hữu sẽ xét xử dân Ngài,"
  },
  {
    "id": 25061,
    "book": "psalms                                  ",
    "chapter": "135",
    "verse": "15",
    "text": "Thần tượng các dân tộc bằng vàng và bạc,"
  },
  {
    "id": 25062,
    "book": "psalms                                  ",
    "chapter": "135",
    "verse": "16",
    "text": "Tượng ấy có miệng nhưng không nói,"
  },
  {
    "id": 25063,
    "book": "psalms                                  ",
    "chapter": "135",
    "verse": "17",
    "text": "Có tai nhưng nào biết nghe,"
  },
  {
    "id": 25064,
    "book": "psalms                                  ",
    "chapter": "135",
    "verse": "18",
    "text": "Người tạo thần tượng và người tin tưởng hắn,"
  },
  {
    "id": 25065,
    "book": "psalms                                  ",
    "chapter": "135",
    "verse": "19",
    "text": "Hỡi Ít-ra-ên hãy chúc tụng Chúa Hằng Hữu!"
  },
  {
    "id": 25066,
    "book": "psalms                                  ",
    "chapter": "135",
    "verse": "20",
    "text": "Hỡi nhà Lê-vi, hãy tán dương Chúa Hằng Hữu!"
  },
  {
    "id": 25067,
    "book": "psalms                                  ",
    "chapter": "135",
    "verse": "21",
    "text": "Chúc tụng Chúa Hằng Hữu từ Si-ôn,"
  }
]