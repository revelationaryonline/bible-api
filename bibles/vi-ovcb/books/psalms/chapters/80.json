[
  {
    "id": 24070,
    "book": "psalms                                  ",
    "chapter": "80",
    "verse": "1",
    "text": "Xin lắng nghe, lạy Đấng chăn giữ Ít-ra-ên,"
  },
  {
    "id": 24071,
    "book": "psalms                                  ",
    "chapter": "80",
    "verse": "2",
    "text": "trước mặt Ép-ra-im, Bên-gia-min, và Ma-na-se."
  },
  {
    "id": 24072,
    "book": "psalms                                  ",
    "chapter": "80",
    "verse": "3",
    "text": "Lạy Đức Chúa Trời, xin phục hưng dân Chúa."
  },
  {
    "id": 24073,
    "book": "psalms                                  ",
    "chapter": "80",
    "verse": "4",
    "text": "Lạy Chúa Hằng Hữu, Đức Chúa Trời Vạn Quân,"
  },
  {
    "id": 24074,
    "book": "psalms                                  ",
    "chapter": "80",
    "verse": "5",
    "text": "Chúa nuôi chúng con bằng than khóc"
  },
  {
    "id": 24075,
    "book": "psalms                                  ",
    "chapter": "80",
    "verse": "6",
    "text": "Ngài khiến chúng con thành đề tài chế giễu cho các nước lân bang."
  },
  {
    "id": 24076,
    "book": "psalms                                  ",
    "chapter": "80",
    "verse": "7",
    "text": "Lạy Đức Chúa Trời Vạn Quân, xin phục hưng dân Chúa."
  },
  {
    "id": 24077,
    "book": "psalms                                  ",
    "chapter": "80",
    "verse": "8",
    "text": "Chúa đã mang chúng con ra từ Ai Cập như cây nho;"
  },
  {
    "id": 24078,
    "book": "psalms                                  ",
    "chapter": "80",
    "verse": "9",
    "text": "Chúa đào đất, khai quang rừng núi,"
  },
  {
    "id": 24079,
    "book": "psalms                                  ",
    "chapter": "80",
    "verse": "10",
    "text": "Các núi cao được tàng nho che phủ;"
  },
  {
    "id": 24080,
    "book": "psalms                                  ",
    "chapter": "80",
    "verse": "11",
    "text": "Cành nó vươn ra đến phía tây của biển,"
  },
  {
    "id": 24081,
    "book": "psalms                                  ",
    "chapter": "80",
    "verse": "12",
    "text": "Nhưng bây giờ, tại sao Chúa phá vỡ tường rào,"
  },
  {
    "id": 24082,
    "book": "psalms                                  ",
    "chapter": "80",
    "verse": "13",
    "text": "Heo rừng phá phách vườn nho"
  },
  {
    "id": 24083,
    "book": "psalms                                  ",
    "chapter": "80",
    "verse": "14",
    "text": "Lạy Đức Chúa Trời Vạn Quân, xin quay lại."
  },
  {
    "id": 24084,
    "book": "psalms                                  ",
    "chapter": "80",
    "verse": "15",
    "text": "do chính tay Chúa đã vun trồng,"
  },
  {
    "id": 24085,
    "book": "psalms                                  ",
    "chapter": "80",
    "verse": "16",
    "text": "Nay đã bị kẻ thù đốn chặt, rồi thiêu đốt trong lửa."
  },
  {
    "id": 24086,
    "book": "psalms                                  ",
    "chapter": "80",
    "verse": "17",
    "text": "Xin đặt tay lên người bên phải Chúa,"
  },
  {
    "id": 24087,
    "book": "psalms                                  ",
    "chapter": "80",
    "verse": "18",
    "text": "Vậy, chúng con sẽ chẳng bao giờ rời bỏ Chúa."
  },
  {
    "id": 24088,
    "book": "psalms                                  ",
    "chapter": "80",
    "verse": "19",
    "text": "Lạy Chúa Hằng Hữu, Đức Chúa Trời Vạn Quân, xin phục hưng dân Chúa."
  }
]