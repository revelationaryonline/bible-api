[
  {
    "id": 23985,
    "book": "psalms                                  ",
    "chapter": "78",
    "verse": "1",
    "text": "Dân ta hỡi, hãy nghe lời ta dạy."
  },
  {
    "id": 23986,
    "book": "psalms                                  ",
    "chapter": "78",
    "verse": "2",
    "text": "vì ta sẽ nói về các ẩn dụ."
  },
  {
    "id": 23987,
    "book": "psalms                                  ",
    "chapter": "78",
    "verse": "3",
    "text": "những bài học dân ta đã nghe biết,"
  },
  {
    "id": 23988,
    "book": "psalms                                  ",
    "chapter": "78",
    "verse": "4",
    "text": "Chúng ta sẽ không giấu sự thật này với con cháu;"
  },
  {
    "id": 23989,
    "book": "psalms                                  ",
    "chapter": "78",
    "verse": "5",
    "text": "Chúa ban hành luật pháp cho Gia-cốp;"
  },
  {
    "id": 23990,
    "book": "psalms                                  ",
    "chapter": "78",
    "verse": "6",
    "text": "để các thế hệ mai sau biết đến—"
  },
  {
    "id": 23991,
    "book": "psalms                                  ",
    "chapter": "78",
    "verse": "7",
    "text": "Theo cách ấy, mọi thế hệ sẽ tin cậy Đức Chúa Trời,"
  },
  {
    "id": 23992,
    "book": "psalms                                  ",
    "chapter": "78",
    "verse": "8",
    "text": "Để họ sẽ không như tổ tiên họ—"
  },
  {
    "id": 23993,
    "book": "psalms                                  ",
    "chapter": "78",
    "verse": "9",
    "text": "Các lính chiến Ép-ra-im trang bị cung tên,"
  },
  {
    "id": 23994,
    "book": "psalms                                  ",
    "chapter": "78",
    "verse": "10",
    "text": "Họ không giữ giao ước với Đức Chúa Trời"
  },
  {
    "id": 23995,
    "book": "psalms                                  ",
    "chapter": "78",
    "verse": "11",
    "text": "Họ đã quên các công việc Ngài làm—"
  },
  {
    "id": 23996,
    "book": "psalms                                  ",
    "chapter": "78",
    "verse": "12",
    "text": "những phép lạ Ngài đã làm cho tổ phụ họ,"
  },
  {
    "id": 23997,
    "book": "psalms                                  ",
    "chapter": "78",
    "verse": "13",
    "text": "Chúa rạch đôi biển cả, dẫn họ đi qua,"
  },
  {
    "id": 23998,
    "book": "psalms                                  ",
    "chapter": "78",
    "verse": "14",
    "text": "Ban ngày, Chúa dìu dắt họ qua trụ mây,"
  },
  {
    "id": 23999,
    "book": "psalms                                  ",
    "chapter": "78",
    "verse": "15",
    "text": "Chúa chẻ vầng đá giữa hoang mạc,"
  },
  {
    "id": 24000,
    "book": "psalms                                  ",
    "chapter": "78",
    "verse": "16",
    "text": "Chúa cho suối phun ra từ tảng đá,"
  },
  {
    "id": 24001,
    "book": "psalms                                  ",
    "chapter": "78",
    "verse": "17",
    "text": "Nhưng họ tiếp tục phạm tội cùng Chúa,"
  },
  {
    "id": 24002,
    "book": "psalms                                  ",
    "chapter": "78",
    "verse": "18",
    "text": "Lòng ngang bướng, họ cố tình thử Đức Chúa Trời,"
  },
  {
    "id": 24003,
    "book": "psalms                                  ",
    "chapter": "78",
    "verse": "19",
    "text": "Họ nói nghịch, thách thức Đức Chúa Trời rằng:"
  },
  {
    "id": 24004,
    "book": "psalms                                  ",
    "chapter": "78",
    "verse": "20",
    "text": "Phải, Chúa có thể đập vầng đá cho nước trào tuôn"
  },
  {
    "id": 24005,
    "book": "psalms                                  ",
    "chapter": "78",
    "verse": "21",
    "text": "Chúa Hằng Hữu nghe lời ấy liền nổi giận,"
  },
  {
    "id": 24006,
    "book": "psalms                                  ",
    "chapter": "78",
    "verse": "22",
    "text": "vì họ không đặt niềm tin nơi Đức Chúa Trời,"
  },
  {
    "id": 24007,
    "book": "psalms                                  ",
    "chapter": "78",
    "verse": "23",
    "text": "Nhưng Chúa ra lệnh bầu trời mở ra,"
  },
  {
    "id": 24008,
    "book": "psalms                                  ",
    "chapter": "78",
    "verse": "24",
    "text": "Chúa ban mưa ma-na xuống cho họ ăn."
  },
  {
    "id": 24009,
    "book": "psalms                                  ",
    "chapter": "78",
    "verse": "25",
    "text": "Họ được ăn thực phẩm thiên thần!"
  },
  {
    "id": 24010,
    "book": "psalms                                  ",
    "chapter": "78",
    "verse": "26",
    "text": "Chúa cũng cho gió đông thổi tới,"
  },
  {
    "id": 24011,
    "book": "psalms                                  ",
    "chapter": "78",
    "verse": "27",
    "text": "Đem chim cút xuống cho dân,"
  },
  {
    "id": 24012,
    "book": "psalms                                  ",
    "chapter": "78",
    "verse": "28",
    "text": "Đàn chim sà xuống giữa trại quân,"
  },
  {
    "id": 24013,
    "book": "psalms                                  ",
    "chapter": "78",
    "verse": "29",
    "text": "Dân ăn uống thỏa thuê."
  },
  {
    "id": 24014,
    "book": "psalms                                  ",
    "chapter": "78",
    "verse": "30",
    "text": "Nhưng trước khi họ thỏa mãn ham mê,"
  },
  {
    "id": 24015,
    "book": "psalms                                  ",
    "chapter": "78",
    "verse": "31",
    "text": "thì cơn thịnh nộ Đức Chúa Trời nổi lên,"
  },
  {
    "id": 24016,
    "book": "psalms                                  ",
    "chapter": "78",
    "verse": "32",
    "text": "Thế mà họ vẫn cứ phạm tội."
  },
  {
    "id": 24017,
    "book": "psalms                                  ",
    "chapter": "78",
    "verse": "33",
    "text": "Nên Chúa làm ngày của họ sút giảm,"
  },
  {
    "id": 24018,
    "book": "psalms                                  ",
    "chapter": "78",
    "verse": "34",
    "text": "Cho đến khi bị Đức Chúa Trời hình phạt,"
  },
  {
    "id": 24019,
    "book": "psalms                                  ",
    "chapter": "78",
    "verse": "35",
    "text": "Rồi họ nhớ Đức Chúa Trời là Vầng Đá,"
  },
  {
    "id": 24020,
    "book": "psalms                                  ",
    "chapter": "78",
    "verse": "36",
    "text": "Nhưng họ mở miệng nịnh hót Chúa;"
  },
  {
    "id": 24021,
    "book": "psalms                                  ",
    "chapter": "78",
    "verse": "37",
    "text": "Lòng họ chẳng ngay thật với Chúa,"
  },
  {
    "id": 24022,
    "book": "psalms                                  ",
    "chapter": "78",
    "verse": "38",
    "text": "Nhưng Chúa vẫn thương xót và tha thứ tội họ"
  },
  {
    "id": 24023,
    "book": "psalms                                  ",
    "chapter": "78",
    "verse": "39",
    "text": "Vì Chúa nhớ rằng họ là người phàm,"
  },
  {
    "id": 24024,
    "book": "psalms                                  ",
    "chapter": "78",
    "verse": "40",
    "text": "Ôi, bao lần họ nổi loạn trong hoang mạc,"
  },
  {
    "id": 24025,
    "book": "psalms                                  ",
    "chapter": "78",
    "verse": "41",
    "text": "Họ dại dột thử sự nhẫn nại của Đức Chúa Trời,"
  },
  {
    "id": 24026,
    "book": "psalms                                  ",
    "chapter": "78",
    "verse": "42",
    "text": "Họ quên bàn tay quyền năng Chúa,"
  },
  {
    "id": 24027,
    "book": "psalms                                  ",
    "chapter": "78",
    "verse": "43",
    "text": "Họ đã quên Chúa làm các phép lạ ở Ai Cập,"
  },
  {
    "id": 24028,
    "book": "psalms                                  ",
    "chapter": "78",
    "verse": "44",
    "text": "Ngài đã biến nước sông ra máu"
  },
  {
    "id": 24029,
    "book": "psalms                                  ",
    "chapter": "78",
    "verse": "45",
    "text": "Chúa sai vô số ruồi nhặng cắn họ,"
  },
  {
    "id": 24030,
    "book": "psalms                                  ",
    "chapter": "78",
    "verse": "46",
    "text": "Chúa bỏ mùa màng họ cho sâu cắn;"
  },
  {
    "id": 24031,
    "book": "psalms                                  ",
    "chapter": "78",
    "verse": "47",
    "text": "Chúa phá vườn nho bằng mưa đá"
  },
  {
    "id": 24032,
    "book": "psalms                                  ",
    "chapter": "78",
    "verse": "48",
    "text": "Ngài để mưa đá giết hại bầy súc vật,"
  },
  {
    "id": 24033,
    "book": "psalms                                  ",
    "chapter": "78",
    "verse": "49",
    "text": "Chúa đổ trút trên họ cơn giận—"
  },
  {
    "id": 24034,
    "book": "psalms                                  ",
    "chapter": "78",
    "verse": "50",
    "text": "Chúa mở đường cho cơn giận Ngài;"
  },
  {
    "id": 24035,
    "book": "psalms                                  ",
    "chapter": "78",
    "verse": "51",
    "text": "Chúa đánh hạ các trưởng nam Ai Cập,"
  },
  {
    "id": 24036,
    "book": "psalms                                  ",
    "chapter": "78",
    "verse": "52",
    "text": "Nhưng Chúa hướng dẫn dân Ngài như đàn chiên,"
  },
  {
    "id": 24037,
    "book": "psalms                                  ",
    "chapter": "78",
    "verse": "53",
    "text": "Chúa phù trì, bảo vệ nên họ không sợ gì;"
  },
  {
    "id": 24038,
    "book": "psalms                                  ",
    "chapter": "78",
    "verse": "54",
    "text": "Chúa đưa họ vào bờ cõi thánh,"
  },
  {
    "id": 24039,
    "book": "psalms                                  ",
    "chapter": "78",
    "verse": "55",
    "text": "Chúa đuổi các sắc dân trong xứ;"
  },
  {
    "id": 24040,
    "book": "psalms                                  ",
    "chapter": "78",
    "verse": "56",
    "text": "Nhưng họ lại nổi loạn, thử Đức Chúa Trời Chí Cao."
  },
  {
    "id": 24041,
    "book": "psalms                                  ",
    "chapter": "78",
    "verse": "57",
    "text": "Họ phản bội, tráo trở như tổ phụ."
  },
  {
    "id": 24042,
    "book": "psalms                                  ",
    "chapter": "78",
    "verse": "58",
    "text": "Họ xây đền miếu, chọc giận Đức Chúa Trời;"
  },
  {
    "id": 24043,
    "book": "psalms                                  ",
    "chapter": "78",
    "verse": "59",
    "text": "Trước những việc chướng tai gai mắt,"
  },
  {
    "id": 24044,
    "book": "psalms                                  ",
    "chapter": "78",
    "verse": "60",
    "text": "Chúa lìa bỏ nơi ngự Ngài ở Si-lô,"
  },
  {
    "id": 24045,
    "book": "psalms                                  ",
    "chapter": "78",
    "verse": "61",
    "text": "Chúa cho phép quân thù chiếm Hòm Giao Ước;"
  },
  {
    "id": 24046,
    "book": "psalms                                  ",
    "chapter": "78",
    "verse": "62",
    "text": "Chúa để cho dân Ngài bị quân thù chém giết,"
  },
  {
    "id": 24047,
    "book": "psalms                                  ",
    "chapter": "78",
    "verse": "63",
    "text": "Những trai trẻ của họ bị lửa thiêu đốt,"
  },
  {
    "id": 24048,
    "book": "psalms                                  ",
    "chapter": "78",
    "verse": "64",
    "text": "Các thầy tế lễ bị gươm đâm,"
  },
  {
    "id": 24049,
    "book": "psalms                                  ",
    "chapter": "78",
    "verse": "65",
    "text": "Thế rồi như người ngủ, Chúa thức dậy,"
  },
  {
    "id": 24050,
    "book": "psalms                                  ",
    "chapter": "78",
    "verse": "66",
    "text": "Ngài đánh bật quân thù ra khỏi bờ cõi,"
  },
  {
    "id": 24051,
    "book": "psalms                                  ",
    "chapter": "78",
    "verse": "67",
    "text": "Nhưng Chúa khước từ dòng dõi Giô-sép;"
  },
  {
    "id": 24052,
    "book": "psalms                                  ",
    "chapter": "78",
    "verse": "68",
    "text": "Nhưng Ngài chọn đại tộc Giu-đa"
  },
  {
    "id": 24053,
    "book": "psalms                                  ",
    "chapter": "78",
    "verse": "69",
    "text": "Chúa xây cất nơi thánh Ngài trên núi cao,"
  },
  {
    "id": 24054,
    "book": "psalms                                  ",
    "chapter": "78",
    "verse": "70",
    "text": "Chúa chọn Đa-vít làm đầy tớ,"
  },
  {
    "id": 24055,
    "book": "psalms                                  ",
    "chapter": "78",
    "verse": "71",
    "text": "Ngài đem ông ra khỏi nơi bầy chiên được chăm sóc,"
  },
  {
    "id": 24056,
    "book": "psalms                                  ",
    "chapter": "78",
    "verse": "72",
    "text": "Ông chăn giữ dân cách thanh liêm, chính trực"
  }
]