[
  {
    "id": 22845,
    "book": "psalms                                  ",
    "chapter": "5",
    "verse": "1",
    "text": "Lạy Chúa, xin nghiêng tai nghe tiếng con,"
  },
  {
    "id": 22846,
    "book": "psalms                                  ",
    "chapter": "5",
    "verse": "2",
    "text": "Xin nghe con kêu xin cứu giúp, lạy Vua của con và Đức Chúa Trời của con,"
  },
  {
    "id": 22847,
    "book": "psalms                                  ",
    "chapter": "5",
    "verse": "3",
    "text": "Xin nghe tiếng con vào buổi sáng, lạy Chúa Hằng Hữu."
  },
  {
    "id": 22848,
    "book": "psalms                                  ",
    "chapter": "5",
    "verse": "4",
    "text": "Ôi Đức Chúa Trời, Chúa không ưa việc gian ác;"
  },
  {
    "id": 22849,
    "book": "psalms                                  ",
    "chapter": "5",
    "verse": "5",
    "text": "Người kiêu ngạo chẳng đứng nổi trước mặt Chúa,"
  },
  {
    "id": 22850,
    "book": "psalms                                  ",
    "chapter": "5",
    "verse": "6",
    "text": "Chúa diệt trừ người điêu ngoa dối trá."
  },
  {
    "id": 22851,
    "book": "psalms                                  ",
    "chapter": "5",
    "verse": "7",
    "text": "Về phần con, nhờ thiên ân vô hạn, sẽ được vào nhà Chúa;"
  },
  {
    "id": 22852,
    "book": "psalms                                  ",
    "chapter": "5",
    "verse": "8",
    "text": "Xin dẫn con theo đường công chính, lạy Chúa Hằng Hữu,"
  },
  {
    "id": 22853,
    "book": "psalms                                  ",
    "chapter": "5",
    "verse": "9",
    "text": "Lời nói họ không thể nào tin được."
  },
  {
    "id": 22854,
    "book": "psalms                                  ",
    "chapter": "5",
    "verse": "10",
    "text": "Ôi Đức Chúa Trời, xin tuyên án họ có tội."
  },
  {
    "id": 22855,
    "book": "psalms                                  ",
    "chapter": "5",
    "verse": "11",
    "text": "Nhưng những ai nương mình trong Chúa;"
  },
  {
    "id": 22856,
    "book": "psalms                                  ",
    "chapter": "5",
    "verse": "12",
    "text": "Vì Chúa ban phước cho người tin kính, lạy Chúa Hằng Hữu;"
  }
]