[
  {
    "id": 23711,
    "book": "psalms                                  ",
    "chapter": "63",
    "verse": "1",
    "text": "Lạy Đức Chúa Trời, là Đức Chúa Trời của con;"
  },
  {
    "id": 23712,
    "book": "psalms                                  ",
    "chapter": "63",
    "verse": "2",
    "text": "Nên con nhìn lên nơi thánh Ngài,"
  },
  {
    "id": 23713,
    "book": "psalms                                  ",
    "chapter": "63",
    "verse": "3",
    "text": "Vì lòng nhân từ Chúa quý hơn mạng sống;"
  },
  {
    "id": 23714,
    "book": "psalms                                  ",
    "chapter": "63",
    "verse": "4",
    "text": "Con sẽ chúc tụng Chúa suốt đời con,"
  },
  {
    "id": 23715,
    "book": "psalms                                  ",
    "chapter": "63",
    "verse": "5",
    "text": "Linh hồn con thỏa mãn như ăn miếng ngon.63:5 Nt tủy và mỡ"
  },
  {
    "id": 23716,
    "book": "psalms                                  ",
    "chapter": "63",
    "verse": "6",
    "text": "Nằm trên giường, con nhớ đến Chúa,"
  },
  {
    "id": 23717,
    "book": "psalms                                  ",
    "chapter": "63",
    "verse": "7",
    "text": "Vì Chúa phù hộ con,"
  },
  {
    "id": 23718,
    "book": "psalms                                  ",
    "chapter": "63",
    "verse": "8",
    "text": "Linh hồn con bấu víu Chúa;"
  },
  {
    "id": 23719,
    "book": "psalms                                  ",
    "chapter": "63",
    "verse": "9",
    "text": "Những người tìm kế tiêu diệt con sẽ tiêu tan."
  },
  {
    "id": 23720,
    "book": "psalms                                  ",
    "chapter": "63",
    "verse": "10",
    "text": "Họ sẽ bị giáo đâm gươm chém,"
  },
  {
    "id": 23721,
    "book": "psalms                                  ",
    "chapter": "63",
    "verse": "11",
    "text": "Nhưng vua sẽ vui mừng trong Đức Chúa Trời."
  }
]