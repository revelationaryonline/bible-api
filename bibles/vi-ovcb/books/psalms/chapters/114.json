    "book": "psalms                                  ",
    "chapter": "114",
    "verse": "1",
    "text": "Khi Ít-ra-ên rời khỏi Ai Cập—"
  },
  {
    "id": 24695,
    "book": "psalms                                  ",
    "chapter": "114",
    "verse": "2",
    "text": "đất Giu-đa biến thành nơi thánh Đức Chúa Trời,"
  },
  {
    "id": 24696,
    "book": "psalms                                  ",
    "chapter": "114",
    "verse": "3",
    "text": "Biển chợt thấy, liền chạy trốn!"
  },
  {
    "id": 24697,
    "book": "psalms                                  ",
    "chapter": "114",
    "verse": "4",
    "text": "Núi cao run rẩy chạy như dê,"
  },
  {
    "id": 24698,
    "book": "psalms                                  ",
    "chapter": "114",
    "verse": "5",
    "text": "Biển Đỏ, vì sao ngươi chạy trốn"
