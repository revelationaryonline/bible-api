[
  {
    "id": 23651,
    "book": "psalms                                  ",
    "chapter": "58",
    "verse": "1",
    "text": "Các giới cầm quyền cũng nói chuyện công lý sao?"
  },
  {
    "id": 23652,
    "book": "psalms                                  ",
    "chapter": "58",
    "verse": "2",
    "text": "Không! Lòng các ông chỉ tính chuyện bất công."
  },
  {
    "id": 23653,
    "book": "psalms                                  ",
    "chapter": "58",
    "verse": "3",
    "text": "Người ác vừa sinh ra đã lầm lạc,"
  },
  {
    "id": 23654,
    "book": "psalms                                  ",
    "chapter": "58",
    "verse": "4",
    "text": "Họ phun nọc độc như rắn,"
  },
  {
    "id": 23655,
    "book": "psalms                                  ",
    "chapter": "58",
    "verse": "5",
    "text": "phớt lờ tiếng người dụ rắn,"
  },
  {
    "id": 23656,
    "book": "psalms                                  ",
    "chapter": "58",
    "verse": "6",
    "text": "Xin bẻ răng loài rắn độc, lạy Đức Chúa Trời!"
  },
  {
    "id": 23657,
    "book": "psalms                                  ",
    "chapter": "58",
    "verse": "7",
    "text": "Xin cho họ tan ra như nước chảy."
  },
  {
    "id": 23658,
    "book": "psalms                                  ",
    "chapter": "58",
    "verse": "8",
    "text": "Như con sên rỉ nước tan dần,"
  },
  {
    "id": 23659,
    "book": "psalms                                  ",
    "chapter": "58",
    "verse": "9",
    "text": "Đức Chúa Trời sẽ quét sạch họ đi, cả già lẫn trẻ,"
  },
  {
    "id": 23660,
    "book": "psalms                                  ",
    "chapter": "58",
    "verse": "10",
    "text": "Người công chính vui mừng khi được báo thù."
  },
  {
    "id": 23661,
    "book": "psalms                                  ",
    "chapter": "58",
    "verse": "11",
    "text": "Khi ấy người ta sẽ nói:58:11 Nt sẽ nói lên"
  }
