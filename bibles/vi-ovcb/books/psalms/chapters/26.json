[
  {
    "id": 23145,
    "book": "psalms                                  ",
    "chapter": "26",
    "verse": "1",
    "text": "Chúa Hằng Hữu ôi, bào chữa cho con,"
  },
  {
    "id": 23146,
    "book": "psalms                                  ",
    "chapter": "26",
    "verse": "2",
    "text": "Chúa Hằng Hữu ôi, xin tra xét và thử thách con,"
  },
  {
    "id": 23147,
    "book": "psalms                                  ",
    "chapter": "26",
    "verse": "3",
    "text": "Vì con ngưỡng mộ đức nhân từ Chúa,"
  },
  {
    "id": 23148,
    "book": "psalms                                  ",
    "chapter": "26",
    "verse": "4",
    "text": "Con không hòa mình với người dối trá,"
  },
  {
    "id": 23149,
    "book": "psalms                                  ",
    "chapter": "26",
    "verse": "5",
    "text": "Con thù ghét phường ác nhân,"
  },
  {
    "id": 23150,
    "book": "psalms                                  ",
    "chapter": "26",
    "verse": "6",
    "text": "Con sẽ rửa tay, tỏ lòng trong sạch."
  },
  {
    "id": 23151,
    "book": "psalms                                  ",
    "chapter": "26",
    "verse": "7",
    "text": "và lớn tiếng cảm tạ Ngài,"
  },
  {
    "id": 23152,
    "book": "psalms                                  ",
    "chapter": "26",
    "verse": "8",
    "text": "Chúa Hằng Hữu ôi, con yêu mến đền thánh Chúa,"
  },
  {
    "id": 23153,
    "book": "psalms                                  ",
    "chapter": "26",
    "verse": "9",
    "text": "Xin đừng cất mạng con cùng với bọn người ác."
  },
  {
    "id": 23154,
    "book": "psalms                                  ",
    "chapter": "26",
    "verse": "10",
    "text": "Bàn tay họ bẩn thỉu nhuốc nhơ,"
  },
  {
    "id": 23155,
    "book": "psalms                                  ",
    "chapter": "26",
    "verse": "11",
    "text": "Còn con sẽ sống liêm khiết trong sạch."
  },
  {
    "id": 23156,
    "book": "psalms                                  ",
    "chapter": "26",
    "verse": "12",
    "text": "Nơi đất bằng, chân con đứng vững vàng,"
  }
