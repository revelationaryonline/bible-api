[
  {
    "id": 23063,
    "book": "psalms                                  ",
    "chapter": "21",
    "verse": "1",
    "text": "Lạy Chúa Hằng Hữu, vua vui mừng nhờ năng lực Chúa,"
  },
  {
    "id": 23064,
    "book": "psalms                                  ",
    "chapter": "21",
    "verse": "2",
    "text": "Chúa ban điều lòng người mơ ước,"
  },
  {
    "id": 23065,
    "book": "psalms                                  ",
    "chapter": "21",
    "verse": "3",
    "text": "Chúa đãi người thật dồi dào hạnh phước,"
  },
  {
    "id": 23066,
    "book": "psalms                                  ",
    "chapter": "21",
    "verse": "4",
    "text": "Người cầu xin được sống dài lâu,"
  },
  {
    "id": 23067,
    "book": "psalms                                  ",
    "chapter": "21",
    "verse": "5",
    "text": "Nhờ chiến thắng Chúa ban,"
  },
  {
    "id": 23068,
    "book": "psalms                                  ",
    "chapter": "21",
    "verse": "6",
    "text": "Ngài tặng người những ơn phước vĩnh hằng,"
  },
  {
    "id": 23069,
    "book": "psalms                                  ",
    "chapter": "21",
    "verse": "7",
    "text": "Vì vua đặt niềm tin nơi Chúa Hằng Hữu,"
  },
  {
    "id": 23070,
    "book": "psalms                                  ",
    "chapter": "21",
    "verse": "8",
    "text": "Chúa sẽ ra tay tìm bắt kẻ thù."
  },
  {
    "id": 23071,
    "book": "psalms                                  ",
    "chapter": "21",
    "verse": "9",
    "text": "Chúa xuất hiện, sẽ khiến họ như lò lửa,"
  },
  {
    "id": 23072,
    "book": "psalms                                  ",
    "chapter": "21",
    "verse": "10",
    "text": "Con cháu họ tuyệt diệt khỏi mặt đất,"
  },
  {
    "id": 23073,
    "book": "psalms                                  ",
    "chapter": "21",
    "verse": "11",
    "text": "Chống đối Chúa, họ mưu toan ác kế,"
  },
  {
    "id": 23074,
    "book": "psalms                                  ",
    "chapter": "21",
    "verse": "12",
    "text": "Chúa sẽ khiến họ quay lưng chạy trốn,"
  },
  {
    "id": 23075,
    "book": "psalms                                  ",
    "chapter": "21",
    "verse": "13",
    "text": "Nguyện Chúa Hằng Hữu được tán dương về năng lực của Ngài."
  }
]