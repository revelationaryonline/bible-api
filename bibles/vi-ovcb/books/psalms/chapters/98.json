[
  {
    "id": 24362,
    "book": "psalms                                  ",
    "chapter": "98",
    "verse": "1",
    "text": "Hãy dâng lên Chúa Hằng Hữu một bài ca mới,"
  },
  {
    "id": 24363,
    "book": "psalms                                  ",
    "chapter": "98",
    "verse": "2",
    "text": "Chúa Hằng Hữu cho thấy ơn cứu rỗi,"
  },
  {
    "id": 24364,
    "book": "psalms                                  ",
    "chapter": "98",
    "verse": "3",
    "text": "Chúa nhớ lại lòng nhân từ và đức thành tín với Ít-ra-ên."
  },
  {
    "id": 24365,
    "book": "psalms                                  ",
    "chapter": "98",
    "verse": "4",
    "text": "Hỡi nhân loại, hãy reo mừng cho Chúa Hằng Hữu;"
  },
  {
    "id": 24366,
    "book": "psalms                                  ",
    "chapter": "98",
    "verse": "5",
    "text": "Đàn hạc réo rắt mừng Chúa Hằng Hữu,"
  },
  {
    "id": 24367,
    "book": "psalms                                  ",
    "chapter": "98",
    "verse": "6",
    "text": "với kèn đồng cùng tiếng tù và trầm bổng."
  },
  {
    "id": 24368,
    "book": "psalms                                  ",
    "chapter": "98",
    "verse": "7",
    "text": "Biển và sinh vật trong biển hãy ca tụng Chúa!"
  },
  {
    "id": 24369,
    "book": "psalms                                  ",
    "chapter": "98",
    "verse": "8",
    "text": "Sông và suối hãy vỗ tay tán thưởng!"
  },
  {
    "id": 24370,
    "book": "psalms                                  ",
    "chapter": "98",
    "verse": "9",
    "text": "trước mặt Chúa Hằng Hữu."
  }
]