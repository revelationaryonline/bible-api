[
  {
    "id": 23362,
    "book": "psalms                                  ",
    "chapter": "38",
    "verse": "1",
    "text": "Lạy Chúa Hằng Hữu, xin đừng quở trách con trong cơn giận,"
  },
  {
    "id": 23363,
    "book": "psalms                                  ",
    "chapter": "38",
    "verse": "2",
    "text": "Mũi tên Chúa bắn sâu vào thịt,"
  },
  {
    "id": 23364,
    "book": "psalms                                  ",
    "chapter": "38",
    "verse": "3",
    "text": "Vì Chúa giận, thân con yếu ớt;"
  },
  {
    "id": 23365,
    "book": "psalms                                  ",
    "chapter": "38",
    "verse": "4",
    "text": "Tội ác con ngập đầu—"
  },
  {
    "id": 23366,
    "book": "psalms                                  ",
    "chapter": "38",
    "verse": "5",
    "text": "Vết thương lòng lở loét thối tha,"
  },
  {
    "id": 23367,
    "book": "psalms                                  ",
    "chapter": "38",
    "verse": "6",
    "text": "Con cúi mặt khom mình trong tủi nhục."
  },
  {
    "id": 23368,
    "book": "psalms                                  ",
    "chapter": "38",
    "verse": "7",
    "text": "Đòn vọt, lưng con đau như bỏng,"
  },
  {
    "id": 23369,
    "book": "psalms                                  ",
    "chapter": "38",
    "verse": "8",
    "text": "Con gập người, kiệt lực, nhược suy."
  },
  {
    "id": 23370,
    "book": "psalms                                  ",
    "chapter": "38",
    "verse": "9",
    "text": "Chúa Hằng Hữu ôi, Chúa biết mọi điều con ao ước;"
  },
  {
    "id": 23371,
    "book": "psalms                                  ",
    "chapter": "38",
    "verse": "10",
    "text": "Tim đập dồn, sức tàn lực kiệt,"
  },
  {
    "id": 23372,
    "book": "psalms                                  ",
    "chapter": "38",
    "verse": "11",
    "text": "Bạn hữu, thân sơ đều lảng tránh."
  },
  {
    "id": 23373,
    "book": "psalms                                  ",
    "chapter": "38",
    "verse": "12",
    "text": "Người săn mạng lo chăng bẫy lưới."
  },
  {
    "id": 23374,
    "book": "psalms                                  ",
    "chapter": "38",
    "verse": "13",
    "text": "Con như người điếc, chẳng nghe, chẳng biết,"
  },
  {
    "id": 23375,
    "book": "psalms                                  ",
    "chapter": "38",
    "verse": "14",
    "text": "Phải, con như người điếc chẳng nghe,"
  },
  {
    "id": 23376,
    "book": "psalms                                  ",
    "chapter": "38",
    "verse": "15",
    "text": "Lạy Chúa Hằng Hữu, con đang trông đợi."
  },
  {
    "id": 23377,
    "book": "psalms                                  ",
    "chapter": "38",
    "verse": "16",
    "text": "Con cầu nguyện: “Xin đừng để kẻ thù con hả hê"
  },
  {
    "id": 23378,
    "book": "psalms                                  ",
    "chapter": "38",
    "verse": "17",
    "text": "Con kiệt lực, chân không đứng vững,"
  },
  {
    "id": 23379,
    "book": "psalms                                  ",
    "chapter": "38",
    "verse": "18",
    "text": "Con xưng ra tội lỗi con;"
  },
  {
    "id": 23380,
    "book": "psalms                                  ",
    "chapter": "38",
    "verse": "19",
    "text": "Quân thù đông vây bọc trong ngoài,"
  },
  {
    "id": 23381,
    "book": "psalms                                  ",
    "chapter": "38",
    "verse": "20",
    "text": "Họ lấy điều dữ trả điều lành cho con,"
  },
  {
    "id": 23382,
    "book": "psalms                                  ",
    "chapter": "38",
    "verse": "21",
    "text": "Lạy Chúa Hằng Hữu, xin chớ bỏ rơi con."
  },
  {
    "id": 23383,
    "book": "psalms                                  ",
    "chapter": "38",
    "verse": "22",
    "text": "Xin mau cứu giúp con,"
  }
]