[
  {
    "id": 23604,
    "book": "psalms                                  ",
    "chapter": "55",
    "verse": "1",
    "text": "Lạy Đức Chúa Trời, xin lắng nghe con cầu nguyện."
  },
  {
    "id": 23605,
    "book": "psalms                                  ",
    "chapter": "55",
    "verse": "2",
    "text": "Xin Chúa nghe và đáp lời con,"
  },
  {
    "id": 23606,
    "book": "psalms                                  ",
    "chapter": "55",
    "verse": "3",
    "text": "Khi nghe tiếng quân thù,"
  },
  {
    "id": 23607,
    "book": "psalms                                  ",
    "chapter": "55",
    "verse": "4",
    "text": "Lòng con đau xót, hoang mang,"
  },
  {
    "id": 23608,
    "book": "psalms                                  ",
    "chapter": "55",
    "verse": "5",
    "text": "Con khiếp sợ và run rẩy,"
  },
  {
    "id": 23609,
    "book": "psalms                                  ",
    "chapter": "55",
    "verse": "6",
    "text": "Ước gì con có đôi cánh như bồ câu;"
  },
  {
    "id": 23610,
    "book": "psalms                                  ",
    "chapter": "55",
    "verse": "7",
    "text": "Để chạy thoát đi xa,"
  },
  {
    "id": 23611,
    "book": "psalms                                  ",
    "chapter": "55",
    "verse": "8",
    "text": "Con vội vàng tìm nơi ẩn náu—"
  },
  {
    "id": 23612,
    "book": "psalms                                  ",
    "chapter": "55",
    "verse": "9",
    "text": "Lạy Chúa, xin khiến chúng hoang mang, cho ngôn ngữ bất đồng,"
  },
  {
    "id": 23613,
    "book": "psalms                                  ",
    "chapter": "55",
    "verse": "10",
    "text": "Ngày đêm, họ lảng vảng quanh thành,55:10 Nt trên tường thành"
  },
  {
    "id": 23614,
    "book": "psalms                                  ",
    "chapter": "55",
    "verse": "11",
    "text": "Tai ương, áp bức, hủy hoại khắp nơi,"
  },
  {
    "id": 23615,
    "book": "psalms                                  ",
    "chapter": "55",
    "verse": "12",
    "text": "Giá tôi bị quân thù thách đố—"
  },
  {
    "id": 23616,
    "book": "psalms                                  ",
    "chapter": "55",
    "verse": "13",
    "text": "Nhưng người hại tôi chính là bạn thân,"
  },
  {
    "id": 23617,
    "book": "psalms                                  ",
    "chapter": "55",
    "verse": "14",
    "text": "Họ đã cùng tôi thân mật chuyện trò,"
  },
  {
    "id": 23618,
    "book": "psalms                                  ",
    "chapter": "55",
    "verse": "15",
    "text": "Xin sự chết thình lình đến trên họ;"
  },
  {
    "id": 23619,
    "book": "psalms                                  ",
    "chapter": "55",
    "verse": "16",
    "text": "Nhưng con kêu cứu Đức Chúa Trời,"
  },
  {
    "id": 23620,
    "book": "psalms                                  ",
    "chapter": "55",
    "verse": "17",
    "text": "Cả sáng, tối, lẫn trưa,"
  },
  {
    "id": 23621,
    "book": "psalms                                  ",
    "chapter": "55",
    "verse": "18",
    "text": "Chúa giải cứu con và giữ con an toàn"
  },
  {
    "id": 23622,
    "book": "psalms                                  ",
    "chapter": "55",
    "verse": "19",
    "text": "Đức Chúa Trời, Đấng cai trị vĩnh viễn,"
  },
  {
    "id": 23623,
    "book": "psalms                                  ",
    "chapter": "55",
    "verse": "20",
    "text": "Bạn thân con phản bội bạn bè;"
  },
  {
    "id": 23624,
    "book": "psalms                                  ",
    "chapter": "55",
    "verse": "21",
    "text": "Ngoài miệng nói toàn lời êm ái,55:21 Nt miệng trơn hơn bơ"
  },
  {
    "id": 23625,
    "book": "psalms                                  ",
    "chapter": "55",
    "verse": "22",
    "text": "Hãy trao gánh nặng mình cho Chúa Hằng Hữu,"
  },
  {
    "id": 23626,
    "book": "psalms                                  ",
    "chapter": "55",
    "verse": "23",
    "text": "Nhưng lạy Đức Chúa Trời, xin cho bọn người gian ác rơi xuống hố hủy diệt."
  }
]