[
  {
    "id": 24326,
    "book": "psalms                                  ",
    "chapter": "95",
    "verse": "1",
    "text": "Hãy đến cùng ngợi tôn Chúa Hằng Hữu!"
  },
  {
    "id": 24327,
    "book": "psalms                                  ",
    "chapter": "95",
    "verse": "2",
    "text": "Hãy đến trước mặt Chúa với lời cảm tạ."
  },
  {
    "id": 24328,
    "book": "psalms                                  ",
    "chapter": "95",
    "verse": "3",
    "text": "Vì Chúa Hằng Hữu là Đức Chúa Trời vĩ đại,"
  },
  {
    "id": 24329,
    "book": "psalms                                  ",
    "chapter": "95",
    "verse": "4",
    "text": "Các vực thẳm đều nằm trong tay Chúa,"
  },
  {
    "id": 24330,
    "book": "psalms                                  ",
    "chapter": "95",
    "verse": "5",
    "text": "Ngài sáng tạo và thống trị các đại dương."
  },
  {
    "id": 24331,
    "book": "psalms                                  ",
    "chapter": "95",
    "verse": "6",
    "text": "Hãy cùng đến cúi đầu thờ phượng Chúa"
  },
  {
    "id": 24332,
    "book": "psalms                                  ",
    "chapter": "95",
    "verse": "7",
    "text": "vì Ngài là Đức Chúa Trời chúng ta."
  },
  {
    "id": 24333,
    "book": "psalms                                  ",
    "chapter": "95",
    "verse": "8",
    "text": "Chúa Hằng Hữu phán: “Chớ cứng lòng như Ít-ra-ên tại Mê-ri-ba,"
  },
  {
    "id": 24334,
    "book": "psalms                                  ",
    "chapter": "95",
    "verse": "9",
    "text": "Vì tại đó tổ phụ ngươi thử thách và khiêu khích Ta,"
  },
  {
    "id": 24335,
    "book": "psalms                                  ",
    "chapter": "95",
    "verse": "10",
    "text": "Suốt bốn mươi năm, Ta kinh tởm họ, và Ta đã phán:"
  },
  {
    "id": 24336,
    "book": "psalms                                  ",
    "chapter": "95",
    "verse": "11",
    "text": "Nên Ta đã thề trong cơn thịnh nộ:"
  }
