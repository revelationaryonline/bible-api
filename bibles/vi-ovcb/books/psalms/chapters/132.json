[
  {
    "id": 25023,
    "book": "psalms                                  ",
    "chapter": "132",
    "verse": "1",
    "text": "Lạy Chúa Hằng Hữu, xin nhớ đến Đa-vít"
  },
  {
    "id": 25024,
    "book": "psalms                                  ",
    "chapter": "132",
    "verse": "2",
    "text": "Người đã thề với Chúa Hằng Hữu."
  },
  {
    "id": 25025,
    "book": "psalms                                  ",
    "chapter": "132",
    "verse": "3",
    "text": "“Con sẽ chẳng vào nhà;"
  },
  {
    "id": 25026,
    "book": "psalms                                  ",
    "chapter": "132",
    "verse": "4",
    "text": "Không để cho mắt ngủ,"
  },
  {
    "id": 25027,
    "book": "psalms                                  ",
    "chapter": "132",
    "verse": "5",
    "text": "cho đến khi tìm được chỗ cho Chúa Hằng Hữu ngự,"
  },
  {
    "id": 25028,
    "book": "psalms                                  ",
    "chapter": "132",
    "verse": "6",
    "text": "Chúng con nghe Hòm Giao Ước ở Ép-ra-ta,"
  },
  {
    "id": 25029,
    "book": "psalms                                  ",
    "chapter": "132",
    "verse": "7",
    "text": "Chúng con sẽ vào nơi Chúa Hằng Hữu ngự;"
  },
  {
    "id": 25030,
    "book": "psalms                                  ",
    "chapter": "132",
    "verse": "8",
    "text": "Lạy Chúa Hằng Hữu! Xin vào nơi an nghỉ Ngài,"
  },
  {
    "id": 25031,
    "book": "psalms                                  ",
    "chapter": "132",
    "verse": "9",
    "text": "Nguyện các thầy tế lễ được khoác áo công chính;"
  },
  {
    "id": 25032,
    "book": "psalms                                  ",
    "chapter": "132",
    "verse": "10",
    "text": "Vì Đa-vít, đầy tớ Chúa,"
  },
  {
    "id": 25033,
    "book": "psalms                                  ",
    "chapter": "132",
    "verse": "11",
    "text": "Chúa Hằng Hữu đã thề với Đa-vít,"
  },
  {
    "id": 25034,
    "book": "psalms                                  ",
    "chapter": "132",
    "verse": "12",
    "text": "Nếu con cháu con vâng giữ giao ước Ta"
  },
  {
    "id": 25035,
    "book": "psalms                                  ",
    "chapter": "132",
    "verse": "13",
    "text": "Vì Chúa Hằng Hữu đã chọn Si-ôn;"
  },
  {
    "id": 25036,
    "book": "psalms                                  ",
    "chapter": "132",
    "verse": "14",
    "text": "Chúa phán: “Đây vĩnh viễn sẽ là nhà Ta,"
  },
  {
    "id": 25037,
    "book": "psalms                                  ",
    "chapter": "132",
    "verse": "15",
    "text": "Ta cho Si-ôn dồi dào thực phẩm;"
  },
  {
    "id": 25038,
    "book": "psalms                                  ",
    "chapter": "132",
    "verse": "16",
    "text": "Ta sẽ cho thầy tế lễ mặc áo cứu rỗi;"
  },
  {
    "id": 25039,
    "book": "psalms                                  ",
    "chapter": "132",
    "verse": "17",
    "text": "Ta sẽ cho sừng Đa-vít vươn lên mạnh;"
  },
  {
    "id": 25040,
    "book": "psalms                                  ",
    "chapter": "132",
    "verse": "18",
    "text": "Ta sẽ cho kẻ thù người áo xống bị nhơ nhuốc,"
  }
]