[
  {
    "id": 24173,
    "book": "psalms                                  ",
    "chapter": "87",
    "verse": "1",
    "text": "Chúa Hằng Hữu xây nền móng Ngài"
  },
  {
    "id": 24174,
    "book": "psalms                                  ",
    "chapter": "87",
    "verse": "2",
    "text": "Chúa mến chuộng thành Si-ôn,"
  },
  {
    "id": 24175,
    "book": "psalms                                  ",
    "chapter": "87",
    "verse": "3",
    "text": "Ôi thành trì của Đức Chúa Trời"
  },
  {
    "id": 24176,
    "book": "psalms                                  ",
    "chapter": "87",
    "verse": "4",
    "text": "Ta sẽ nói đến Ra-háp và Ba-by-lôn là những nơi biết Ta—"
  },
  {
    "id": 24177,
    "book": "psalms                                  ",
    "chapter": "87",
    "verse": "5",
    "text": "Phải người ta sẽ nói về Si-ôn rằng:"
  },
  {
    "id": 24178,
    "book": "psalms                                  ",
    "chapter": "87",
    "verse": "6",
    "text": "Khi Chúa Hằng Hữu kiểm kê dân số, sẽ ghi rõ:"
  },
  {
    "id": 24179,
    "book": "psalms                                  ",
    "chapter": "87",
    "verse": "7",
    "text": "Người ta sẽ thổi sáo và hát mừng:"
  }
]