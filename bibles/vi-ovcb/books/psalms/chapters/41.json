[
  {
    "id": 23414,
    "book": "psalms                                  ",
    "chapter": "41",
    "verse": "1",
    "text": "Phước cho ai giúp người khốn khó!"
  },
  {
    "id": 23415,
    "book": "psalms                                  ",
    "chapter": "41",
    "verse": "2",
    "text": "Chúa Hằng Hữu bảo vệ họ"
  },
  {
    "id": 23416,
    "book": "psalms                                  ",
    "chapter": "41",
    "verse": "3",
    "text": "Lúc ốm đau có Chúa Hằng Hữu giữ gìn,"
  },
  {
    "id": 23417,
    "book": "psalms                                  ",
    "chapter": "41",
    "verse": "4",
    "text": "Tôi kêu xin: “Lạy Chúa Hằng Hữu, xin thương xót."
  },
  {
    "id": 23418,
    "book": "psalms                                  ",
    "chapter": "41",
    "verse": "5",
    "text": "Kẻ thù tôi nói những lời độc địa về tôi."
  },
  {
    "id": 23419,
    "book": "psalms                                  ",
    "chapter": "41",
    "verse": "6",
    "text": "Người thăm hỏi dùng lời dịu ngọt,"
  },
  {
    "id": 23420,
    "book": "psalms                                  ",
    "chapter": "41",
    "verse": "7",
    "text": "Bọn ghét tôi xì xào bàn tán,"
  },
  {
    "id": 23421,
    "book": "psalms                                  ",
    "chapter": "41",
    "verse": "8",
    "text": "Họ nói: “Nó nhiễm ác tật rồi;"
  },
  {
    "id": 23422,
    "book": "psalms                                  ",
    "chapter": "41",
    "verse": "9",
    "text": "Bạn chí thân, từng chia mẩu bánh,"
  },
  {
    "id": 23423,
    "book": "psalms                                  ",
    "chapter": "41",
    "verse": "10",
    "text": "Chúa Hằng Hữu ôi, xin thương xót."
  },
  {
    "id": 23424,
    "book": "psalms                                  ",
    "chapter": "41",
    "verse": "11",
    "text": "Thấy kẻ địch không thắng hơn con,"
  },
  {
    "id": 23425,
    "book": "psalms                                  ",
    "chapter": "41",
    "verse": "12",
    "text": "Chúa hộ trì con vì con vô tội,"
  },
  {
    "id": 23426,
    "book": "psalms                                  ",
    "chapter": "41",
    "verse": "13",
    "text": "Chúc tụng Chúa Hằng Hữu, Đức Chúa Trời của Ít-ra-ên,"
  }
]