[
  {
    "id": 23443,
    "book": "psalms                                  ",
    "chapter": "44",
    "verse": "1",
    "text": "Lạy Chúa, tai chúng con đã nghe lời tổ phụ kể,"
  },
  {
    "id": 23444,
    "book": "psalms                                  ",
    "chapter": "44",
    "verse": "2",
    "text": "Tay Chúa đánh đuổi nhiều dân tộc,"
  },
  {
    "id": 23445,
    "book": "psalms                                  ",
    "chapter": "44",
    "verse": "3",
    "text": "Họ không nhờ gươm chiếm đất,"
  },
  {
    "id": 23446,
    "book": "psalms                                  ",
    "chapter": "44",
    "verse": "4",
    "text": "Lạy Chúa là Vua Cao Cả,"
  },
  {
    "id": 23447,
    "book": "psalms                                  ",
    "chapter": "44",
    "verse": "5",
    "text": "Nhờ sức Chúa chúng con đẩy lui quân địch xâm lăng."
  },
  {
    "id": 23448,
    "book": "psalms                                  ",
    "chapter": "44",
    "verse": "6",
    "text": "Con không ỷ lại nơi cung đồng, tên sắt,"
  },
  {
    "id": 23449,
    "book": "psalms                                  ",
    "chapter": "44",
    "verse": "7",
    "text": "Nhưng Chúa giúp chúng con đánh bại kẻ thù,"
  },
  {
    "id": 23450,
    "book": "psalms                                  ",
    "chapter": "44",
    "verse": "8",
    "text": "Chúng con mãi mãi tự hào về Chúa,"
  },
  {
    "id": 23451,
    "book": "psalms                                  ",
    "chapter": "44",
    "verse": "9",
    "text": "Nhưng ngày nay Chúa khước từ, và hạ nhục chúng con,"
  },
  {
    "id": 23452,
    "book": "psalms                                  ",
    "chapter": "44",
    "verse": "10",
    "text": "Để chúng con lùi bước trước quân thù,"
  },
  {
    "id": 23453,
    "book": "psalms                                  ",
    "chapter": "44",
    "verse": "11",
    "text": "Chúa bỏ mặc chúng con cho bị vồ xé như chiên,"
  },
  {
    "id": 23454,
    "book": "psalms                                  ",
    "chapter": "44",
    "verse": "12",
    "text": "Chúa bán dân Ngài rẻ như bèo bọt,"
  },
  {
    "id": 23455,
    "book": "psalms                                  ",
    "chapter": "44",
    "verse": "13",
    "text": "Chúa khiến lân bang có cớ phỉ nhổ chúng con,"
  },
  {
    "id": 23456,
    "book": "psalms                                  ",
    "chapter": "44",
    "verse": "14",
    "text": "Chúa khiến chúng con bị châm biếm giữa các nước,"
  },
  {
    "id": 23457,
    "book": "psalms                                  ",
    "chapter": "44",
    "verse": "15",
    "text": "Suốt ngày dài con mang tủi hổ,"
  },
  {
    "id": 23458,
    "book": "psalms                                  ",
    "chapter": "44",
    "verse": "16",
    "text": "Vẳng bên tai, lời sỉ nhục, mắng la,"
  },
  {
    "id": 23459,
    "book": "psalms                                  ",
    "chapter": "44",
    "verse": "17",
    "text": "Dù chúng con tín trung cùng giao ước,"
  },
  {
    "id": 23460,
    "book": "psalms                                  ",
    "chapter": "44",
    "verse": "18",
    "text": "Lòng chúng con không hề dời đổi,"
  },
  {
    "id": 23461,
    "book": "psalms                                  ",
    "chapter": "44",
    "verse": "19",
    "text": "Dù bị Ngài đánh tan nơi tử địa,44:19 Nt nơi ở của loài quái vật, hoặc hang chó rừng"
  },
  {
    "id": 23462,
    "book": "psalms                                  ",
    "chapter": "44",
    "verse": "20",
    "text": "Nếu chúng con quên Danh Thánh Chúa,"
  },
  {
    "id": 23463,
    "book": "psalms                                  ",
    "chapter": "44",
    "verse": "21",
    "text": "hẳn Đức Chúa Trời đã khám phá ra lập tức,"
  },
  {
    "id": 23464,
    "book": "psalms                                  ",
    "chapter": "44",
    "verse": "22",
    "text": "Vì Chúa, mạng sống chúng tôi bị đe dọa suốt ngày; chúng tôi chẳng khác gì bầy chiên tại lò thịt."
  },
  {
    "id": 23465,
    "book": "psalms                                  ",
    "chapter": "44",
    "verse": "23",
    "text": "Lạy Chúa, lẽ nào Ngài ngủ?"
  },
  {
    "id": 23466,
    "book": "psalms                                  ",
    "chapter": "44",
    "verse": "24",
    "text": "Sao Chúa đành che mặt giấu tay,"
  },
  {
    "id": 23467,
    "book": "psalms                                  ",
    "chapter": "44",
    "verse": "25",
    "text": "Chúng con bị hạ xuống hàng cát bụi,"
  },
  {
    "id": 23468,
    "book": "psalms                                  ",
    "chapter": "44",
    "verse": "26",
    "text": "Xin Chúa vùng dậy, ra tay tiếp cứu,"
  }
]