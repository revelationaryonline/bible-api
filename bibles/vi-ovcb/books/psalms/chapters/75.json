  {
    "id": 23944,
    "book": "psalms                                  ",
    "chapter": "75",
    "verse": "2",
    "text": "Đức Chúa Trời phán: “Ta chọn thời gian đã định,"
  },
  {
    "id": 23945,
    "book": "psalms                                  ",
    "chapter": "75",
    "verse": "3",
    "text": "Khi địa cầu và nhân loại rúng động,"
  },
  {
    "id": 23946,
    "book": "psalms                                  ",
    "chapter": "75",
    "verse": "4",
    "text": "Ta cảnh báo người kiêu ngạo: ‘Đừng khoe khoang nữa!’"
  },
  {
    "id": 23947,
    "book": "psalms                                  ",
    "chapter": "75",
    "verse": "5",
    "text": "Đừng dùng sừng chống lại các tầng trời,"
  },
  {
    "id": 23948,
    "book": "psalms                                  ",
    "chapter": "75",
    "verse": "6",
    "text": "Vì không một ai trên đất—từ đông hay tây"
  },
  {
    "id": 23949,
    "book": "psalms                                  ",
    "chapter": "75",
    "verse": "7",
    "text": "Chỉ có Đức Chúa Trời, Đấng phán xét,75:7 Ctd nhưng do Thượng Đế, là Đấng xét xử"
  },
  {
    "id": 23950,
    "book": "psalms                                  ",
    "chapter": "75",
    "verse": "8",
    "text": "Vì Chúa Hằng Hữu cầm ly trong tay mình,"
  },
  {
    "id": 23951,
    "book": "psalms                                  ",
    "chapter": "75",
    "verse": "9",
    "text": "Nhưng riêng con, con sẽ luôn kể lại sự việc Đức Chúa Trời thực hiện;"
