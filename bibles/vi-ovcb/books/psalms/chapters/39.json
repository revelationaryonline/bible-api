[
  {
    "id": 23384,
    "book": "psalms                                  ",
    "chapter": "39",
    "verse": "1",
    "text": "Tôi tự nhủ: “Tôi sẽ cố giữ gìn nếp sống,"
  },
  {
    "id": 23385,
    "book": "psalms                                  ",
    "chapter": "39",
    "verse": "2",
    "text": "Nhưng khi tôi âm thầm, câm nín—"
  },
  {
    "id": 23386,
    "book": "psalms                                  ",
    "chapter": "39",
    "verse": "3",
    "text": "Lòng bồn chồn nóng nảy,"
  },
  {
    "id": 23387,
    "book": "psalms                                  ",
    "chapter": "39",
    "verse": "4",
    "text": "“Chúa Hằng Hữu ôi, xin cho con biết hồi chung kết."
  },
  {
    "id": 23388,
    "book": "psalms                                  ",
    "chapter": "39",
    "verse": "5",
    "text": "Đời con dài lắm độ gang tay,"
  },
  {
    "id": 23389,
    "book": "psalms                                  ",
    "chapter": "39",
    "verse": "6",
    "text": "Chúng con chập chờn như chiếc bóng,"
  },
  {
    "id": 23390,
    "book": "psalms                                  ",
    "chapter": "39",
    "verse": "7",
    "text": "Lạy Chúa, có ai đáng cho con hy vọng?"
  },
  {
    "id": 23391,
    "book": "psalms                                  ",
    "chapter": "39",
    "verse": "8",
    "text": "Xin cứu con khỏi mọi điều vi phạm."
  },
  {
    "id": 23392,
    "book": "psalms                                  ",
    "chapter": "39",
    "verse": "9",
    "text": "Miệng con vẫn khép chặt, lặng yên."
  },
  {
    "id": 23393,
    "book": "psalms                                  ",
    "chapter": "39",
    "verse": "10",
    "text": "Xin Chúa thương, ngừng tay đánh phạt!"
  },
  {
    "id": 23394,
    "book": "psalms                                  ",
    "chapter": "39",
    "verse": "11",
    "text": "Khi Chúa quở trách trừng phạt ai vì tội lỗi,"
  },
  {
    "id": 23395,
    "book": "psalms                                  ",
    "chapter": "39",
    "verse": "12",
    "text": "Chúa Hằng Hữu ôi, xin nghe lời con khẩn nguyện!"
  },
  {
    "id": 23396,
    "book": "psalms                                  ",
    "chapter": "39",
    "verse": "13",
    "text": "Xin Chúa tha tội để con phấn khởi, vui tươi"
  }
]