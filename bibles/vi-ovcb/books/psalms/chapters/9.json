[
  {
    "id": 22893,
    "book": "psalms                                  ",
    "chapter": "9",
    "verse": "1",
    "text": "Lạy Chúa Hằng Hữu, con sẽ hết lòng tôn vinh Chúa"
  },
  {
    "id": 22894,
    "book": "psalms                                  ",
    "chapter": "9",
    "verse": "2",
    "text": "Trong Chúa, con rạng rỡ vui mừng."
  },
  {
    "id": 22895,
    "book": "psalms                                  ",
    "chapter": "9",
    "verse": "3",
    "text": "Khi kẻ thù con quay lại"
  },
  {
    "id": 22896,
    "book": "psalms                                  ",
    "chapter": "9",
    "verse": "4",
    "text": "Vì Chúa đã bênh vực quyền lợi chính đáng của con;"
  },
  {
    "id": 22897,
    "book": "psalms                                  ",
    "chapter": "9",
    "verse": "5",
    "text": "Chúa khiển trách các dân tộc và hủy diệt người ác;"
  },
  {
    "id": 22898,
    "book": "psalms                                  ",
    "chapter": "9",
    "verse": "6",
    "text": "Kẻ thù con mãi mãi điêu linh;"
  },
  {
    "id": 22899,
    "book": "psalms                                  ",
    "chapter": "9",
    "verse": "7",
    "text": "Nhưng Chúa Hằng Hữu cai trị muôn đời,"
  },
  {
    "id": 22900,
    "book": "psalms                                  ",
    "chapter": "9",
    "verse": "8",
    "text": "Chúa phân xử cả thế gian cách công minh,"
  },
  {
    "id": 22901,
    "book": "psalms                                  ",
    "chapter": "9",
    "verse": "9",
    "text": "Chúa Hằng Hữu là nơi nương cho người bị áp bức,"
  },
  {
    "id": 22902,
    "book": "psalms                                  ",
    "chapter": "9",
    "verse": "10",
    "text": "Ai biết Danh Chúa sẽ tin cậy Ngài,"
  },
  {
    "id": 22903,
    "book": "psalms                                  ",
    "chapter": "9",
    "verse": "11",
    "text": "Hãy ca ngợi Chúa Hằng Hữu, Đấng trị vì tại Si-ôn."
  },
  {
    "id": 22904,
    "book": "psalms                                  ",
    "chapter": "9",
    "verse": "12",
    "text": "Vì Đấng báo thù huyết chăm sóc người đau thương."
  },
  {
    "id": 22905,
    "book": "psalms                                  ",
    "chapter": "9",
    "verse": "13",
    "text": "Lạy Chúa Hằng Hữu, xin thương xót con."
  },
  {
    "id": 22906,
    "book": "psalms                                  ",
    "chapter": "9",
    "verse": "14",
    "text": "Để tại các cổng thành9:14 Nt cổng con gái Si-ôn của dân Chúa,"
  },
  {
    "id": 22907,
    "book": "psalms                                  ",
    "chapter": "9",
    "verse": "15",
    "text": "Các dân rơi ngay vào hầm hố họ đã đào."
  },
  {
    "id": 22908,
    "book": "psalms                                  ",
    "chapter": "9",
    "verse": "16",
    "text": "Công lý Chúa làm Danh Ngài sáng tỏ."
  },
  {
    "id": 22909,
    "book": "psalms                                  ",
    "chapter": "9",
    "verse": "17",
    "text": "Người tội ác sẽ bị lùa vào âm phủ."
  },
  {
    "id": 22910,
    "book": "psalms                                  ",
    "chapter": "9",
    "verse": "18",
    "text": "Nhưng người khốn khó sẽ chẳng mãi bị bỏ quên;"
  },
  {
    "id": 22911,
    "book": "psalms                                  ",
    "chapter": "9",
    "verse": "19",
    "text": "Xin trỗi dậy, lạy Chúa Hằng Hữu!"
  },
  {
    "id": 22912,
    "book": "psalms                                  ",
    "chapter": "9",
    "verse": "20",
    "text": "Xin khiến họ khiếp sợ, ôi Chúa Hằng Hữu."
  }
]