    "chapter": "14",
    "verse": "1",
    "text": "Người ngu dại tự nhủ:"
  },
  {
    "id": 22953,
    "book": "psalms                                  ",
    "chapter": "14",
    "verse": "2",
    "text": "Chúa Hằng Hữu từ trời nhìn xuống loài người"
