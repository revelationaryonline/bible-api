[
  {
    "id": 24770,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "1",
    "text": "Hạnh phước thay con người toàn hảo119:1 Nt toàn hảo trong đường lối"
  },
  {
    "id": 24771,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "2",
    "text": "Hạnh phước thay những người vâng lệnh119:2 Ctd không lầm lỗi"
  },
  {
    "id": 24772,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "3",
    "text": "Họ không làm những điều bất nghĩa"
  },
  {
    "id": 24773,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "4",
    "text": "Chúa đã cho ban hành thánh luật,"
  },
  {
    "id": 24774,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "5",
    "text": "Con muốn sống một đời kiên định,"
  },
  {
    "id": 24775,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "6",
    "text": "Nên con chẳng bao giờ hổ thẹn,"
  },
  {
    "id": 24776,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "7",
    "text": "Ca ngợi Chúa với lòng ngay thật,"
  },
  {
    "id": 24777,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "8",
    "text": "Con sẽ luôn vâng giữ giới luật."
  },
  {
    "id": 24778,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "9",
    "text": "Người trẻ tuổi làm sao giữ lòng trong sạch?"
  },
  {
    "id": 24779,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "10",
    "text": "Với nhiệt tâm, con tìm kiếm Chúa—"
  },
  {
    "id": 24780,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "11",
    "text": "Con giấu kỹ lời Chúa trong lòng con,"
  },
  {
    "id": 24781,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "12",
    "text": "Chúc tụng Chúa, ôi Chúa Hằng Hữu;"
  },
  {
    "id": 24782,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "13",
    "text": "Con xin lấy môi miệng thuật lại"
  },
  {
    "id": 24783,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "14",
    "text": "Luôn vui mừng vì lời Chúa phán,"
  },
  {
    "id": 24784,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "15",
    "text": "Con suy nghiệm nguyên tắc Chúa,"
  },
  {
    "id": 24785,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "16",
    "text": "Luật lệ Chúa làm con vui thỏa,"
  },
  {
    "id": 24786,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "17",
    "text": "Xin ban ơn cho đầy tớ Chúa,"
  },
  {
    "id": 24787,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "18",
    "text": "Xin Chúa mở mắt cho con nhìn thấy,"
  },
  {
    "id": 24788,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "19",
    "text": "Con là khách lữ hành trên đất."
  },
  {
    "id": 24789,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "20",
    "text": "Tâm hồn con khao khát"
  },
  {
    "id": 24790,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "21",
    "text": "Chúa quở trách những người kiêu ngạo;119:21 Nt người kiêu ngạo, người đáng rủa"
  },
  {
    "id": 24791,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "22",
    "text": "Xin cho sỉ nhục và khinh nhạo xa con,"
  },
  {
    "id": 24792,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "23",
    "text": "Dù vua chúa họp nhau chống đối con,119:23 Ctd hội họp bàn luận chống đối con"
  },
  {
    "id": 24793,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "24",
    "text": "Chứng ngôn Chúa làm con vui sướng;"
  },
  {
    "id": 24794,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "25",
    "text": "Con bị chìm sâu trong bụi đất,"
  },
  {
    "id": 24795,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "26",
    "text": "Con kể lể bước đường lưu lạc"
  },
  {
    "id": 24796,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "27",
    "text": "Xin cho con hiểu mệnh lệnh của Chúa,"
  },
  {
    "id": 24797,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "28",
    "text": "Tâm hồn con chán nản với ưu sầu;"
  },
  {
    "id": 24798,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "29",
    "text": "Đưa con tránh xa con đường lừa dối;"
  },
  {
    "id": 24799,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "30",
    "text": "Con đã chọn con đường chân lý;"
  },
  {
    "id": 24800,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "31",
    "text": "Lạy Chúa Hằng Hữu, con bám chặt mối giềng, cương lĩnh,"
  },
  {
    "id": 24801,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "32",
    "text": "Một khi được Chúa khai tâm,"
  },
  {
    "id": 24802,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "33",
    "text": "Lạy Chúa Hằng Hữu, xin dạy con đường lối Chúa;"
  },
  {
    "id": 24803,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "34",
    "text": "Xin cho con tri thức để con vâng phục luật lệ Chúa;"
  },
  {
    "id": 24804,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "35",
    "text": "Xin dắt con trên đường điều răn của Chúa,119:35 Nt đường điều răn"
  },
  {
    "id": 24805,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "36",
    "text": "Xin cho lòng con yêu chuộng chứng ngôn,"
  },
  {
    "id": 24806,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "37",
    "text": "Xin cho mắt đừng chăm những việc vô nghĩa,"
  },
  {
    "id": 24807,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "38",
    "text": "Xin hoàn thành lời hứa Chúa cho con,"
  },
  {
    "id": 24808,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "39",
    "text": "Cho con thoát sỉ nhục con lo ngại;"
  },
  {
    "id": 24809,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "40",
    "text": "Con hằng mong mỏi mệnh lệnh Chúa!"
  },
  {
    "id": 24810,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "41",
    "text": "Lạy Chúa Hằng Hữu, nguyện tình yêu Ngài đến với con,"
  },
  {
    "id": 24811,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "42",
    "text": "Khi ấy, con có thể đáp lời bọn người sỉ nhục con,"
  },
  {
    "id": 24812,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "43",
    "text": "Xin đừng rút lời chân thật khỏi miệng con,"
  },
  {
    "id": 24813,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "44",
    "text": "Con luôn vâng giữ luật lệ Chúa cho đến đời đời vô cùng."
  },
  {
    "id": 24814,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "45",
    "text": "Nên sẽ bước đi tự do,"
  },
  {
    "id": 24815,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "46",
    "text": "Con sẽ công bố thánh lệnh cho các vua,"
  },
  {
    "id": 24816,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "47",
    "text": "Con vui thích vâng theo lệnh Chúa!"
  },
  {
    "id": 24817,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "48",
    "text": "Con tôn kính, mến yêu mệnh lệnh Chúa."
  },
  {
    "id": 24818,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "49",
    "text": "Xin Chúa nhớ lời hứa cùng đầy tớ Chúa,"
  },
  {
    "id": 24819,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "50",
    "text": "Giữa khổ đau, con được an ủi;"
  },
  {
    "id": 24820,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "51",
    "text": "Người kiêu ngạo không ngớt chế giễu,"
  },
  {
    "id": 24821,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "52",
    "text": "Con nhớ lời phán của Chúa từ xưa;"
  },
  {
    "id": 24822,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "53",
    "text": "Thấy người ác phế bỏ luật Thánh,"
  },
  {
    "id": 24823,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "54",
    "text": "Luật lệ Chúa là bài ca của con,"
  },
  {
    "id": 24824,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "55",
    "text": "Đêm thanh vắng, con luôn nhớ Chúa Hằng Hữu,"
  },
  {
    "id": 24825,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "56",
    "text": "Con đã tìm được hạnh phước;"
  },
  {
    "id": 24826,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "57",
    "text": "Chúa Hằng Hữu là cơ nghiệp con!"
  },
  {
    "id": 24827,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "58",
    "text": "Con hết lòng nài xin ơn Ngài ban phước."
  },
  {
    "id": 24828,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "59",
    "text": "Con tự xét hành vi cử chỉ,"
  },
  {
    "id": 24829,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "60",
    "text": "Con chẳng muốn trì hoãn,"
  },
  {
    "id": 24830,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "61",
    "text": "Dù bọn gian ác trói con bằng dây"
  },
  {
    "id": 24831,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "62",
    "text": "Đêm khuya thanh vắng con bừng tỉnh,"
  },
  {
    "id": 24832,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "63",
    "text": "Con kết bạn với người kính sợ Chúa—"
  },
  {
    "id": 24833,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "64",
    "text": "Cả địa cầu ngập tràn tình thương Chúa Hằng Hữu;"
  },
  {
    "id": 24834,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "65",
    "text": "Chúa đã hậu đãi đầy tớ Chúa,"
  },
  {
    "id": 24835,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "66",
    "text": "Xin dạy con hiểu biết và phán đoán,"
  },
  {
    "id": 24836,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "67",
    "text": "Trước khi hoạn nạn con thường lạc lối;"
  },
  {
    "id": 24837,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "68",
    "text": "Chúa nhân lành chuyên làm việc thiện;"
  },
  {
    "id": 24838,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "69",
    "text": "Người vô đạo thêu dệt lời vu cáo,"
  },
  {
    "id": 24839,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "70",
    "text": "Lòng ác họ chai lì và vô cảm,"
  },
  {
    "id": 24840,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "71",
    "text": "Hoạn nạn trở thành lợi ích cho con,"
  },
  {
    "id": 24841,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "72",
    "text": "Luật pháp Chúa dạy119:72 Nt từ miệng Chúa thật là bảo vật,"
  },
  {
    "id": 24842,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "73",
    "text": "Tay Chúa đã tạo dựng, uốn nắn con."
  },
  {
    "id": 24843,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "74",
    "text": "Nguyện những người kính sợ Chúa vui mừng khi thấy con,"
  },
  {
    "id": 24844,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "75",
    "text": "Lạy Chúa, phán quyết Ngài thật đúng,"
  },
  {
    "id": 24845,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "76",
    "text": "Cúi xin Chúa từ ái an ủi con,"
  },
  {
    "id": 24846,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "77",
    "text": "Xin Chúa thương cho con được sống,"
  },
  {
    "id": 24847,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "78",
    "text": "Nguyện người kiêu căng phải hổ thẹn vì họ vô cớ tráo trở lừa gạt con;"
  },
  {
    "id": 24848,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "79",
    "text": "Xin cho những người kính sợ Chúa,"
  },
  {
    "id": 24849,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "80",
    "text": "Xin giúp con yêu mến mệnh lệnh Chúa,"
  },
  {
    "id": 24850,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "81",
    "text": "Linh hồn con mòn mỏi chờ giải cứu,"
  },
  {
    "id": 24851,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "82",
    "text": "Mắt con mờ đi vì trông đợi lời hứa.119:82 Ctd trông đợi lời Chúa"
  },
  {
    "id": 24852,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "83",
    "text": "Dù con như bầu da119:83 Bầu đựng rượu bằng da đóng khói bếp,"
  },
  {
    "id": 24853,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "84",
    "text": "Con phải chờ đợi đến bao giờ?"
  },
  {
    "id": 24854,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "85",
    "text": "Bọn kiêu ngạo đào hầm hại con,"
  },
  {
    "id": 24855,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "86",
    "text": "Toàn bộ điều răn Chúa đều đáng tin cậy."
  },
  {
    "id": 24856,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "87",
    "text": "Con gần mất mạng về tay họ,"
  },
  {
    "id": 24857,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "88",
    "text": "Xin bảo toàn mạng sống con theo lòng nhân từ Chúa,"
  },
  {
    "id": 24858,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "89",
    "text": "Lạy Chúa Hằng Hữu, lời Ngài vững lập trên trời,"
  },
  {
    "id": 24859,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "90",
    "text": "Lòng thành tín Chúa trải qua bao thế hệ,"
  },
  {
    "id": 24860,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "91",
    "text": "Theo luật Ngài, chúng tồn tại đến ngày nay,"
  },
  {
    "id": 24861,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "92",
    "text": "Nếu con không yêu thích luật lệ Chúa,"
  },
  {
    "id": 24862,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "93",
    "text": "Con chẳng bao giờ quên lời Chúa dạy,"
  },
  {
    "id": 24863,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "94",
    "text": "Con thuộc về Chúa; xin giải cứu con!"
  },
  {
    "id": 24864,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "95",
    "text": "Bọn gian tà rình chờ tiêu diệt con,"
  },
  {
    "id": 24865,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "96",
    "text": "Những gì gọi là trọn vẹn cũng có giới hạn,"
  },
  {
    "id": 24866,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "97",
    "text": "Con yêu mến lời Chúa biết bao!"
  },
  {
    "id": 24867,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "98",
    "text": "Mệnh lệnh Chúa làm cho con khôn hơn kẻ nghịch,"
  },
  {
    "id": 24868,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "99",
    "text": "Phải, nhờ chiêm nghiệm lời Chúa,"
  },
  {
    "id": 24869,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "100",
    "text": "Con hiểu biết hơn bậc lão thành;"
  },
  {
    "id": 24870,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "101",
    "text": "Con giữ chân không bước vào đường ác,"
  },
  {
    "id": 24871,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "102",
    "text": "Nhờ Chúa răn dạy con chu đáo,"
  },
  {
    "id": 24872,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "103",
    "text": "Lời Chúa ngọt ngào trong miệng con;"
  },
  {
    "id": 24873,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "104",
    "text": "Nhờ lời Chúa, con thành người thông sáng,"
  },
  {
    "id": 24874,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "105",
    "text": "Lời Chúa là đèn soi bước chân con,"
  },
  {
    "id": 24875,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "106",
    "text": "Con đã thề nguyền và xác nhận rằng:"
  },
  {
    "id": 24876,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "107",
    "text": "Con đau khổ nhiều trong hoạn nạn;"
  },
  {
    "id": 24877,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "108",
    "text": "Cúi xin Chúa Hằng Hữu nghe lời chúc tụng,"
  },
  {
    "id": 24878,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "109",
    "text": "Mạng sống con hằng bị đe dọa,"
  },
  {
    "id": 24879,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "110",
    "text": "Bọn ác độc gài bẫy sập con,"
  },
  {
    "id": 24880,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "111",
    "text": "Chứng ngôn Chúa là gia sản muôn đời;"
  },
  {
    "id": 24881,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "112",
    "text": "Con quyết tâm thực thi mệnh lệnh Chúa,"
  },
  {
    "id": 24882,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "113",
    "text": "Những người hai lòng thật đáng ghét,"
  },
  {
    "id": 24883,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "114",
    "text": "Chúa là nơi trú ẩn và cái khiên của con;"
  },
  {
    "id": 24884,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "115",
    "text": "Người ác hiểm, hãy tránh xa ta,"
  },
  {
    "id": 24885,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "116",
    "text": "Xin lời Chúa cho con được sống!"
  },
  {
    "id": 24886,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "117",
    "text": "Xin Chúa nâng đỡ, con sẽ được giải cứu;"
  },
  {
    "id": 24887,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "118",
    "text": "Chúa từ khước những ai tách xa mệnh lệnh Chúa."
  },
  {
    "id": 24888,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "119",
    "text": "Chúa quét sạch người ác trên trần gian như rác;"
  },
  {
    "id": 24889,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "120",
    "text": "Con run rẩy trong sự kính sợ Chúa;"
  },
  {
    "id": 24890,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "121",
    "text": "Con làm điều công bằng thiện hảo,"
  },
  {
    "id": 24891,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "122",
    "text": "Xin đưa tay phù trì đầy tớ Chúa."
  },
  {
    "id": 24892,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "123",
    "text": "Con đợi ngày Chúa đến giải vây,"
  },
  {
    "id": 24893,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "124",
    "text": "Xin lấy lòng nhân từ hà hải,"
  },
  {
    "id": 24894,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "125",
    "text": "Xin cho đầy tớ Ngài sáng suốt,"
  },
  {
    "id": 24895,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "126",
    "text": "Lạy Chúa Hằng Hữu, đã đến lúc Ngài ra tay hành động,"
  },
  {
    "id": 24896,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "127",
    "text": "Thật, con yêu quý điều răn của Chúa,"
  },
  {
    "id": 24897,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "128",
    "text": "Tất cả nguyên tắc của Chúa là công chính."
  },
  {
    "id": 24898,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "129",
    "text": "Chứng ngôn Chúa diệu kỳ phong phú."
  },
  {
    "id": 24899,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "130",
    "text": "Lối vào lời Chúa đem ánh sáng,"
  },
  {
    "id": 24900,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "131",
    "text": "Con mở miệng, sẵn sàng uống cạn,"
  },
  {
    "id": 24901,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "132",
    "text": "Xin đoái nhìn, rủ lòng thương xót,"
  },
  {
    "id": 24902,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "133",
    "text": "Cho con bước theo lời Chúa,"
  },
  {
    "id": 24903,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "134",
    "text": "Xin giải thoát con khỏi người áp bức;"
  },
  {
    "id": 24904,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "135",
    "text": "Xin chiếu sáng mặt Ngài trên con;"
  },
  {
    "id": 24905,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "136",
    "text": "Mắt con tuôn lệ như dòng thác"
  },
  {
    "id": 24906,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "137",
    "text": "Lạy Chúa Hằng Hữu, Đấng công chính"
  },
  {
    "id": 24907,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "138",
    "text": "Chứng ngôn Ngài trung thực, công bằng,"
  },
  {
    "id": 24908,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "139",
    "text": "Lòng nhiệt thành nung đốt tâm can,"
  },
  {
    "id": 24909,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "140",
    "text": "Lời của Chúa vô cùng tinh luyện;"
  },
  {
    "id": 24910,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "141",
    "text": "Thân phận con đáng khinh, hèn kém,"
  },
  {
    "id": 24911,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "142",
    "text": "Đức công chính Ngài còn mãi mãi,"
  },
  {
    "id": 24912,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "143",
    "text": "Con gặp cảnh hoang mang rối loạn,"
  },
  {
    "id": 24913,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "144",
    "text": "Luật pháp Chúa công minh vĩnh cửu;"
  },
  {
    "id": 24914,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "145",
    "text": "Con hết lòng kêu lên Chúa, lạy Chúa Hằng Hữu!"
  },
  {
    "id": 24915,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "146",
    "text": "Con kêu cứu, Chúa ơi, xin giải thoát,"
  },
  {
    "id": 24916,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "147",
    "text": "Dậy trước hừng đông, con cầu cứu,"
  },
  {
    "id": 24917,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "148",
    "text": "Mắt con không chớp giữa canh khuya,"
  },
  {
    "id": 24918,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "149",
    "text": "Lạy Chúa Hằng Hữu, xin nghe con tùy lượng nhân từ Chúa;"
  },
  {
    "id": 24919,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "150",
    "text": "Người vô đạo đến gần xông hãm;"
  },
  {
    "id": 24920,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "151",
    "text": "Chúa Hằng Hữu ơi, xin Ngài ở bên con,"
  },
  {
    "id": 24921,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "152",
    "text": "Từ xa xưa, con biết qua chứng ước Chúa,"
  },
  {
    "id": 24922,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "153",
    "text": "Xin nhìn con trong vòng hoạn nạn,"
  },
  {
    "id": 24923,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "154",
    "text": "Xin biện hộ và đưa tay cứu độ!"
  },
  {
    "id": 24924,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "155",
    "text": "Bọn gian tà đi xa nguồn cứu rỗi,"
  },
  {
    "id": 24925,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "156",
    "text": "Lòng từ ái Chúa vô cùng vĩ đại;"
  },
  {
    "id": 24926,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "157",
    "text": "Bọn thù nghịch, đông như kiến cỏ,"
  },
  {
    "id": 24927,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "158",
    "text": "Con đau xót nhìn người gian ác,"
  },
  {
    "id": 24928,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "159",
    "text": "Chúa nhìn thấy lòng con yêu mến mệnh lệnh Ngài."
  },
  {
    "id": 24929,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "160",
    "text": "Từ khởi thủy, lời Ngài luôn chân thật;"
  },
  {
    "id": 24930,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "161",
    "text": "Quan quyền bức hại con vô cớ,"
  },
  {
    "id": 24931,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "162",
    "text": "Con vui thích trong lời Chúa,"
  },
  {
    "id": 24932,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "163",
    "text": "Con ghét tởm những điều dối trá,"
  },
  {
    "id": 24933,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "164",
    "text": "Mỗi ngày con ca tụng Chúa bảy lần,"
  },
  {
    "id": 24934,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "165",
    "text": "Người yêu luật Chúa được thái an,"
  },
  {
    "id": 24935,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "166",
    "text": "Lạy Chúa Hằng Hữu, con hy vọng Ngài giải cứu,"
  },
  {
    "id": 24936,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "167",
    "text": "Con vâng theo luật Chúa,"
  },
  {
    "id": 24937,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "168",
    "text": "Chúa thấy rõ suốt đường con tiến bước,"
  },
  {
    "id": 24938,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "169",
    "text": "Lạy Chúa Hằng Hữu, xin lắng nghe tiếng con kêu cầu;"
  },
  {
    "id": 24939,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "170",
    "text": "Nguyện lời nài xin bay đến tai Ngài;"
  },
  {
    "id": 24940,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "171",
    "text": "Môi miệng con tuôn lời ca ngợi,"
  },
  {
    "id": 24941,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "172",
    "text": "Lưỡi con cũng tuyên rao lời Chúa,"
  },
  {
    "id": 24942,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "173",
    "text": "Xin đưa tay nâng đỡ phù trì,"
  },
  {
    "id": 24943,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "174",
    "text": "Lạy Chúa Hằng Hữu, con trông đợi Ngài giải cứu,"
  },
  {
    "id": 24944,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "175",
    "text": "Xin cho con được sống để con hết lòng ngợi tôn Chúa,"
  },
  {
    "id": 24945,
    "book": "psalms                                  ",
    "chapter": "119",
    "verse": "176",
    "text": "Con lang thang như chiên lạc lối;"
  }
]