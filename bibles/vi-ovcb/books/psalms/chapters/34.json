[
  {
    "id": 23260,
    "book": "psalms                                  ",
    "chapter": "34",
    "verse": "1",
    "text": "Tôi luôn luôn chúc tụng Chúa Hằng Hữu,"
  },
  {
    "id": 23261,
    "book": "psalms                                  ",
    "chapter": "34",
    "verse": "2",
    "text": "Tôi sẽ khoe mọi ân lành của Chúa Hằng Hữu;"
  },
  {
    "id": 23262,
    "book": "psalms                                  ",
    "chapter": "34",
    "verse": "3",
    "text": "Hãy cùng tôi tôn vinh Chúa Hằng Hữu;"
  },
  {
    "id": 23263,
    "book": "psalms                                  ",
    "chapter": "34",
    "verse": "4",
    "text": "Tôi tìm kiếm Chúa Hằng Hữu và Ngài đáp ứng."
  },
  {
    "id": 23264,
    "book": "psalms                                  ",
    "chapter": "34",
    "verse": "5",
    "text": "Ai ngửa trông nơi Chúa được Ngài chiếu sáng,"
  },
  {
    "id": 23265,
    "book": "psalms                                  ",
    "chapter": "34",
    "verse": "6",
    "text": "Người cùng khổ này kêu xin, và Chúa Hằng Hữu lắng nghe,"
  },
  {
    "id": 23266,
    "book": "psalms                                  ",
    "chapter": "34",
    "verse": "7",
    "text": "Vì thiên sứ của Chúa Hằng Hữu là người canh giữ;"
  },
  {
    "id": 23267,
    "book": "psalms                                  ",
    "chapter": "34",
    "verse": "8",
    "text": "Hãy nếm thử cho biết Chúa Hằng Hữu là thiện lành."
  },
  {
    "id": 23268,
    "book": "psalms                                  ",
    "chapter": "34",
    "verse": "9",
    "text": "Các người thánh, hãy kính sợ Chúa Hằng Hữu,"
  },
  {
    "id": 23269,
    "book": "psalms                                  ",
    "chapter": "34",
    "verse": "10",
    "text": "Dù sư tử tơ có khi thiếu thốn và đói,"
  },
  {
    "id": 23270,
    "book": "psalms                                  ",
    "chapter": "34",
    "verse": "11",
    "text": "Các con, hãy đến nghe ta,"
  },
  {
    "id": 23271,
    "book": "psalms                                  ",
    "chapter": "34",
    "verse": "12",
    "text": "Có ai là người yêu thích cuộc đời,"
  },
  {
    "id": 23272,
    "book": "psalms                                  ",
    "chapter": "34",
    "verse": "13",
    "text": "Phải giữ miệng lưỡi mình,"
  },
  {
    "id": 23273,
    "book": "psalms                                  ",
    "chapter": "34",
    "verse": "14",
    "text": "Phải tránh xa điều ác và làm việc lành."
  },
  {
    "id": 23274,
    "book": "psalms                                  ",
    "chapter": "34",
    "verse": "15",
    "text": "Vì mắt Chúa Hằng Hữu nhìn người công chính;"
  },
  {
    "id": 23275,
    "book": "psalms                                  ",
    "chapter": "34",
    "verse": "16",
    "text": "Chúa Hằng Hữu đối nghịch người ác;"
  },
  {
    "id": 23276,
    "book": "psalms                                  ",
    "chapter": "34",
    "verse": "17",
    "text": "Người công chính kêu xin, Chúa lắng nghe."
  },
  {
    "id": 23277,
    "book": "psalms                                  ",
    "chapter": "34",
    "verse": "18",
    "text": "Chúa Hằng Hữu ở gần người có lòng tan vỡ;"
  },
  {
    "id": 23278,
    "book": "psalms                                  ",
    "chapter": "34",
    "verse": "19",
    "text": "Người công chính gặp nhiều tai nạn,"
  },
  {
    "id": 23279,
    "book": "psalms                                  ",
    "chapter": "34",
    "verse": "20",
    "text": "Chúa Hằng Hữu giữ gìn xương cốt người công chính;"
  },
  {
    "id": 23280,
    "book": "psalms                                  ",
    "chapter": "34",
    "verse": "21",
    "text": "Tai ương đến tiêu diệt người ác,"
  },
  {
    "id": 23281,
    "book": "psalms                                  ",
    "chapter": "34",
    "verse": "22",
    "text": "Nhưng Chúa Hằng Hữu chuộc người phục vụ Chúa."
  }
]