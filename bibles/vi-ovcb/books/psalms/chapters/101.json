    "chapter": "101",
    "verse": "1",
    "text": "Con sẽ ca ngợi sự nhân từ và đức công chính Ngài, lạy Chúa Hằng Hữu."
  },
  {
    "id": 24386,
    "book": "psalms                                  ",
    "chapter": "101",
    "verse": "2",
    "text": "Con sẽ sống cẩn thận theo con đường thiện hảo."
  },
  {
    "id": 24387,
    "book": "psalms                                  ",
    "chapter": "101",
    "verse": "3",
    "text": "Mắt con sẽ không"
  },
  {
    "id": 24388,
    "book": "psalms                                  ",
    "chapter": "101",
    "verse": "4",
    "text": "Con sẽ loại trừ lòng hư hoại"
