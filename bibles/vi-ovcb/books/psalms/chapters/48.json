[
  {
    "id": 23506,
    "book": "psalms                                  ",
    "chapter": "48",
    "verse": "1",
    "text": "Chúa Hằng Hữu thật vĩ đại,"
  },
  {
    "id": 23507,
    "book": "psalms                                  ",
    "chapter": "48",
    "verse": "2",
    "text": "Núi thánh cao ngất, đẹp đẽ;"
  },
  {
    "id": 23508,
    "book": "psalms                                  ",
    "chapter": "48",
    "verse": "3",
    "text": "Chính Đức Chúa Trời ngự trong các thành lũy,"
  },
  {
    "id": 23509,
    "book": "psalms                                  ",
    "chapter": "48",
    "verse": "4",
    "text": "Kìa, các vua liên minh họp lại,"
  },
  {
    "id": 23510,
    "book": "psalms                                  ",
    "chapter": "48",
    "verse": "5",
    "text": "Nhưng họ sửng sốt, đứng nhìn,"
  },
  {
    "id": 23511,
    "book": "psalms                                  ",
    "chapter": "48",
    "verse": "6",
    "text": "Tại đó, chúng run rẩy rụng rời,"
  },
  {
    "id": 23512,
    "book": "psalms                                  ",
    "chapter": "48",
    "verse": "7",
    "text": "Chúa đánh tan họ, như các chiến thuyền Ta-rê-si"
  },
  {
    "id": 23513,
    "book": "psalms                                  ",
    "chapter": "48",
    "verse": "8",
    "text": "Những điều chúng tôi nghe về vinh quang của thành,"
  },
  {
    "id": 23514,
    "book": "psalms                                  ",
    "chapter": "48",
    "verse": "9",
    "text": "Lạy Đức Chúa Trời, trong Đền Thờ Ngài,"
  },
  {
    "id": 23515,
    "book": "psalms                                  ",
    "chapter": "48",
    "verse": "10",
    "text": "Lạy Đức Chúa Trời, như Danh Ngài,"
  },
  {
    "id": 23516,
    "book": "psalms                                  ",
    "chapter": "48",
    "verse": "11",
    "text": "Núi Si-ôn, hãy hớn hở."
  },
  {
    "id": 23517,
    "book": "psalms                                  ",
    "chapter": "48",
    "verse": "12",
    "text": "Hãy đi đến và dạo quanh Si-ôn."
  },
  {
    "id": 23518,
    "book": "psalms                                  ",
    "chapter": "48",
    "verse": "13",
    "text": "Hãy nhìn kỹ các thành lũy phòng vệ,"
  },
  {
    "id": 23519,
    "book": "psalms                                  ",
    "chapter": "48",
    "verse": "14",
    "text": "Chúa là Đức Chúa Trời của chúng tôi mãi mãi,"
  }
]