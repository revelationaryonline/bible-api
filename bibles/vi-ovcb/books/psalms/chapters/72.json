[
  {
    "id": 23872,
    "book": "psalms                                  ",
    "chapter": "72",
    "verse": "1",
    "text": "Lạy Đức Chúa Trời, xin ban cho vua công lý của Chúa,"
  },
  {
    "id": 23873,
    "book": "psalms                                  ",
    "chapter": "72",
    "verse": "2",
    "text": "Để vua xét dân cách công bằng,"
  },
  {
    "id": 23874,
    "book": "psalms                                  ",
    "chapter": "72",
    "verse": "3",
    "text": "Nguyện núi đồi cũng phải thắm tươi,"
  },
  {
    "id": 23875,
    "book": "psalms                                  ",
    "chapter": "72",
    "verse": "4",
    "text": "Vua minh oan cho những ai khốn cùng,"
  },
  {
    "id": 23876,
    "book": "psalms                                  ",
    "chapter": "72",
    "verse": "5",
    "text": "Nguyện khi nào còn mặt trời, mặt trăng,"
  },
  {
    "id": 23877,
    "book": "psalms                                  ",
    "chapter": "72",
    "verse": "6",
    "text": "Nguyện ơn mưa móc của nhà vua,"
  },
  {
    "id": 23878,
    "book": "psalms                                  ",
    "chapter": "72",
    "verse": "7",
    "text": "Nguyện dưới triều vua, người công chính hưng thịnh"
  },
  {
    "id": 23879,
    "book": "psalms                                  ",
    "chapter": "72",
    "verse": "8",
    "text": "Vua cai trị từ biển đông đến biển tây,"
  },
  {
    "id": 23880,
    "book": "psalms                                  ",
    "chapter": "72",
    "verse": "9",
    "text": "Dân du mục sẽ vái chào trong hoang mạc"
  },
  {
    "id": 23881,
    "book": "psalms                                  ",
    "chapter": "72",
    "verse": "10",
    "text": "Vua Ta-rê-si và các hải đảo sẽ cống hiến lễ vật cho vua,"
  },
  {
    "id": 23882,
    "book": "psalms                                  ",
    "chapter": "72",
    "verse": "11",
    "text": "Tất cả vua chúa sẽ quỳ lạy,"
  },
  {
    "id": 23883,
    "book": "psalms                                  ",
    "chapter": "72",
    "verse": "12",
    "text": "Vì vua sẽ giải cứu người cùng túng"
  },
  {
    "id": 23884,
    "book": "psalms                                  ",
    "chapter": "72",
    "verse": "13",
    "text": "Vua sẽ thương xót người cùng cực,"
  },
  {
    "id": 23885,
    "book": "psalms                                  ",
    "chapter": "72",
    "verse": "14",
    "text": "Vua sẽ cứu chuộc họ khỏi bạo quyền áp bức,"
  },
  {
    "id": 23886,
    "book": "psalms                                  ",
    "chapter": "72",
    "verse": "15",
    "text": "Nguyện vua được trường thọ!"
  },
  {
    "id": 23887,
    "book": "psalms                                  ",
    "chapter": "72",
    "verse": "16",
    "text": "Nguyện ngũ cốc tràn đầy khắp đất,"
  },
  {
    "id": 23888,
    "book": "psalms                                  ",
    "chapter": "72",
    "verse": "17",
    "text": "Nguyện vua sẽ được lưu danh mãi mãi;"
  },
  {
    "id": 23889,
    "book": "psalms                                  ",
    "chapter": "72",
    "verse": "18",
    "text": "Hãy ngợi tôn Đức Chúa Trời Hằng Hữu, Đức Chúa Trời của Ít-ra-ên,"
  },
  {
    "id": 23890,
    "book": "psalms                                  ",
    "chapter": "72",
    "verse": "19",
    "text": "Hãy chúc tụng Danh vinh quang Ngài mãi!"
  },
  {
    "id": 23891,
    "book": "psalms                                  ",
    "chapter": "72",
    "verse": "20",
    "text": "(Đến đây kết thúc lời cầu nguyện của Đa-vít, con trai Gie-sê)."
  }
]