[
  {
    "id": 23076,
    "book": "psalms                                  ",
    "chapter": "22",
    "verse": "1",
    "text": "Đức Chúa Trời ôi, Đức Chúa Trời ôi, sao Ngài đành bỏ con?"
  },
  {
    "id": 23077,
    "book": "psalms                                  ",
    "chapter": "22",
    "verse": "2",
    "text": "Đức Chúa Trời con ôi, con kêu cứu mỗi ngày Ngài không đáp."
  },
  {
    "id": 23078,
    "book": "psalms                                  ",
    "chapter": "22",
    "verse": "3",
    "text": "Chúa vẫn ở trên ngôi,"
  },
  {
    "id": 23079,
    "book": "psalms                                  ",
    "chapter": "22",
    "verse": "4",
    "text": "Các tổ phụ ngày xưa tin tưởng Chúa."
  },
  {
    "id": 23080,
    "book": "psalms                                  ",
    "chapter": "22",
    "verse": "5",
    "text": "Họ kêu xin liền được Ngài cứu giúp."
  },
  {
    "id": 23081,
    "book": "psalms                                  ",
    "chapter": "22",
    "verse": "6",
    "text": "Nhưng con đây chỉ là sâu bọ, chẳng phải người,"
  },
  {
    "id": 23082,
    "book": "psalms                                  ",
    "chapter": "22",
    "verse": "7",
    "text": "Ai thấy con cũng buông lời chế giễu."
  },
  {
    "id": 23083,
    "book": "psalms                                  ",
    "chapter": "22",
    "verse": "8",
    "text": "“Có phải nó giao thác đời mình cho Chúa Hằng Hữu?"
  },
  {
    "id": 23084,
    "book": "psalms                                  ",
    "chapter": "22",
    "verse": "9",
    "text": "Chúa đã đem con ra khỏi lòng mẹ"
  },
  {
    "id": 23085,
    "book": "psalms                                  ",
    "chapter": "22",
    "verse": "10",
    "text": "Từ lòng mẹ, con được giao cho Chúa."
  },
  {
    "id": 23086,
    "book": "psalms                                  ",
    "chapter": "22",
    "verse": "11",
    "text": "Tai ương cận kề không ai cứu giúp,"
  },
  {
    "id": 23087,
    "book": "psalms                                  ",
    "chapter": "22",
    "verse": "12",
    "text": "Kẻ thù địch đang vây quanh hung hãn;"
  },
  {
    "id": 23088,
    "book": "psalms                                  ",
    "chapter": "22",
    "verse": "13",
    "text": "Há rộng miệng muốn ăn tươi nuốt sống,"
  },
  {
    "id": 23089,
    "book": "psalms                                  ",
    "chapter": "22",
    "verse": "14",
    "text": "Thân con bủn rủn,"
  },
  {
    "id": 23090,
    "book": "psalms                                  ",
    "chapter": "22",
    "verse": "15",
    "text": "Năng lực con cằn cỗi như mảnh sành."
  },
  {
    "id": 23091,
    "book": "psalms                                  ",
    "chapter": "22",
    "verse": "16",
    "text": "Bầy chó săn lố nhố vây bọc con;"
  },
  {
    "id": 23092,
    "book": "psalms                                  ",
    "chapter": "22",
    "verse": "17",
    "text": "Con có thể đếm xương, từng chiếc."
  },
  {
    "id": 23093,
    "book": "psalms                                  ",
    "chapter": "22",
    "verse": "18",
    "text": "Y phục con, họ lấy chia làm phần,"
  },
  {
    "id": 23094,
    "book": "psalms                                  ",
    "chapter": "22",
    "verse": "19",
    "text": "Chúa Hằng Hữu ơi, xin đừng lìa xa con!"
  },
  {
    "id": 23095,
    "book": "psalms                                  ",
    "chapter": "22",
    "verse": "20",
    "text": "Xin cứu thân con thoát khỏi lưỡi gươm;"
  },
  {
    "id": 23096,
    "book": "psalms                                  ",
    "chapter": "22",
    "verse": "21",
    "text": "Cho con thoát sư tử mồm đang há,"
  },
  {
    "id": 23097,
    "book": "psalms                                  ",
    "chapter": "22",
    "verse": "22",
    "text": "Con sẽ truyền Danh Chúa cho anh chị em con."
  },
  {
    "id": 23098,
    "book": "psalms                                  ",
    "chapter": "22",
    "verse": "23",
    "text": "Hãy ngợi tôn Chúa Hằng Hữu, hỡi những người kính sợ Chúa!"
  },
  {
    "id": 23099,
    "book": "psalms                                  ",
    "chapter": "22",
    "verse": "24",
    "text": "Vì Chúa không khinh ghét người cùng khốn.22:24 Nt ghét hoạn nạn của người bị hoạn nạn"
  },
  {
    "id": 23100,
    "book": "psalms                                  ",
    "chapter": "22",
    "verse": "25",
    "text": "Tôi sẽ ca tụng Chúa giữa kỳ đại hội."
  },
  {
    "id": 23101,
    "book": "psalms                                  ",
    "chapter": "22",
    "verse": "26",
    "text": "Người khốn khổ sẽ ăn uống thỏa thuê."
  },
  {
    "id": 23102,
    "book": "psalms                                  ",
    "chapter": "22",
    "verse": "27",
    "text": "Cả địa cầu sẽ nhớ Chúa Hằng Hữu và quay về với Ngài."
  },
  {
    "id": 23103,
    "book": "psalms                                  ",
    "chapter": "22",
    "verse": "28",
    "text": "Vì việc thống trị là quyền Chúa Hằng Hữu."
  },
  {
    "id": 23104,
    "book": "psalms                                  ",
    "chapter": "22",
    "verse": "29",
    "text": "Tất cả người giàu trên thế gian ăn uống và thờ phượng."
  },
  {
    "id": 23105,
    "book": "psalms                                  ",
    "chapter": "22",
    "verse": "30",
    "text": "Con cháu chúng ta cũng sẽ phục vụ Ngài."
  },
  {
    "id": 23106,
    "book": "psalms                                  ",
    "chapter": "22",
    "verse": "31",
    "text": "Thế hệ tương lai sẽ rao truyền sự công chính của Chúa."
  }
]