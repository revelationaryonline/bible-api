[
  {
    "id": 22829,
    "book": "psalms                                  ",
    "chapter": "3",
    "verse": "1",
    "text": "Ôi Chúa Hằng Hữu, sao kẻ thù con vô số;"
  },
  {
    "id": 22830,
    "book": "psalms                                  ",
    "chapter": "3",
    "verse": "2",
    "text": "Họ cầu mong rằng:"
  },
  {
    "id": 22831,
    "book": "psalms                                  ",
    "chapter": "3",
    "verse": "3",
    "text": "Nhưng, lạy Chúa Hằng Hữu, Ngài là khiên thuẫn chở che con,"
  },
  {
    "id": 22832,
    "book": "psalms                                  ",
    "chapter": "3",
    "verse": "4",
    "text": "Tôi lớn tiếng kêu cầu cùng Chúa Hằng Hữu,"
  },
  {
    "id": 22833,
    "book": "psalms                                  ",
    "chapter": "3",
    "verse": "5",
    "text": "Tôi nằm xuống và ngủ yên giấc,"
  },
  {
    "id": 22834,
    "book": "psalms                                  ",
    "chapter": "3",
    "verse": "6",
    "text": "Tôi chẳng sợ sệt, kinh hoàng,"
  },
  {
    "id": 22835,
    "book": "psalms                                  ",
    "chapter": "3",
    "verse": "7",
    "text": "Chúa Hằng Hữu ôi, xin xuất hiện!"
  },
  {
    "id": 22836,
    "book": "psalms                                  ",
    "chapter": "3",
    "verse": "8",
