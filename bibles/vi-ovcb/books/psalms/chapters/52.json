[
  {
    "id": 23582,
    "book": "psalms                                  ",
    "chapter": "52",
    "verse": "1",
    "text": "Này, người mạnh sức, sao cả ngày cứ khoe khoang việc ác?"
  },
  {
    "id": 23583,
    "book": "psalms                                  ",
    "chapter": "52",
    "verse": "2",
    "text": "Cả ngày người âm mưu hủy diệt."
  },
  {
    "id": 23584,
    "book": "psalms                                  ",
    "chapter": "52",
    "verse": "3",
    "text": "Ngươi thích làm ác hơn làm lành,"
  },
  {
    "id": 23585,
    "book": "psalms                                  ",
    "chapter": "52",
    "verse": "4",
    "text": "Ngươi thích dùng lời độc hại, ngươi dối trá!"
