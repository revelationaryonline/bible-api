    "book": "psalms                                  ",
    "chapter": "52",
    "verse": "5",
    "text": "Nhưng Đức Chúa Trời sẽ khiến ngươi tàn bại."
  },
  {
    "id": 23587,
    "book": "psalms                                  ",
    "chapter": "52",
    "verse": "6",
    "text": "Người công chính sẽ nhìn và run sợ."
  },
  {
    "id": 23588,
    "book": "psalms                                  ",
    "chapter": "52",
    "verse": "7",
    "text": "“Hãy nhìn việc xảy ra cho người mạnh mẽ,"
  },
  {
    "id": 23589,
    "book": "psalms                                  ",
    "chapter": "52",
