[
  {
    "id": 23745,
    "book": "psalms                                  ",
    "chapter": "66",
    "verse": "1",
    "text": "Khắp đất hãy ca mừng chúc tụng Đức Chúa Trời!66:1 Nt làm ồn ào cách vui mừng"
  },
  {
    "id": 23746,
    "book": "psalms                                  ",
    "chapter": "66",
    "verse": "2",
    "text": "Hãy tôn vinh Danh Chúa!"
  },
  {
    "id": 23747,
    "book": "psalms                                  ",
    "chapter": "66",
    "verse": "3",
    "text": "Hãy thưa với Đức Chúa Trời: “Việc Chúa làm vô cùng vĩ đại!"
  },
  {
    "id": 23748,
    "book": "psalms                                  ",
    "chapter": "66",
    "verse": "4",
    "text": "Mọi tạo vật trên đất sẽ thờ phượng Chúa;"
  },
  {
    "id": 23749,
    "book": "psalms                                  ",
    "chapter": "66",
    "verse": "5",
    "text": "Hãy đến xem việc Đức Chúa Trời làm,"
  },
  {
    "id": 23750,
    "book": "psalms                                  ",
    "chapter": "66",
    "verse": "6",
    "text": "Chúa biến Biển Đỏ ra đất khô"
  },
  {
    "id": 23751,
    "book": "psalms                                  ",
    "chapter": "66",
    "verse": "7",
    "text": "Chúa dùng quyền năng cai trị đời đời."
  },
  {
    "id": 23752,
    "book": "psalms                                  ",
    "chapter": "66",
    "verse": "8",
    "text": "Hỡi cả trái đất, hãy chúc tụng Đức Chúa Trời"
  },
  {
    "id": 23753,
    "book": "psalms                                  ",
    "chapter": "66",
    "verse": "9",
    "text": "Mạng sống chúng con trong tay Ngài"
  },
  {
    "id": 23754,
    "book": "psalms                                  ",
    "chapter": "66",
    "verse": "10",
    "text": "Lạy Đức Chúa Trời, Ngài từng thử nghiệm chúng con;"
  },
  {
    "id": 23755,
    "book": "psalms                                  ",
    "chapter": "66",
    "verse": "11",
    "text": "Chúa để chúng con sa lưới,"
  },
  {
    "id": 23756,
    "book": "psalms                                  ",
    "chapter": "66",
    "verse": "12",
    "text": "Rồi Ngài khiến người ta cỡi trên đầu chúng con."
  },
  {
    "id": 23757,
    "book": "psalms                                  ",
    "chapter": "66",
    "verse": "13",
    "text": "Con sẽ đem tế lễ thiêu lên Đền Thờ Chúa,"
  },
  {
    "id": 23758,
    "book": "psalms                                  ",
    "chapter": "66",
    "verse": "14",
    "text": "phải, là những điều con hứa nguyện"
  },
  {
    "id": 23759,
    "book": "psalms                                  ",
    "chapter": "66",
    "verse": "15",
    "text": "Đó là tại sao con dâng lên Chúa tế lễ thiêu—"
  },
  {
    "id": 23760,
    "book": "psalms                                  ",
    "chapter": "66",
    "verse": "16",
    "text": "Hãy đến và nghe, hỡi những người kính sợ Đức Chúa Trời,"
  },
  {
    "id": 23761,
    "book": "psalms                                  ",
    "chapter": "66",
    "verse": "17",
    "text": "Miệng tôi kêu cầu và tôn cao Chúa,"
  },
  {
    "id": 23762,
    "book": "psalms                                  ",
    "chapter": "66",
    "verse": "18",
    "text": "Nếu lòng tôi xu hướng về tội ác,"
  },
  {
    "id": 23763,
    "book": "psalms                                  ",
    "chapter": "66",
    "verse": "19",
    "text": "Nhưng Đức Chúa Trời đã lắng nghe!"
  },
  {
    "id": 23764,
    "book": "psalms                                  ",
    "chapter": "66",
    "verse": "20",
    "text": "Ngợi tôn Đức Chúa Trời, Đấng không khước từ lời cầu nguyện,"
  }
]