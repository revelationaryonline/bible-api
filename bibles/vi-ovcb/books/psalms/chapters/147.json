[
  {
    "id": 25223,
    "book": "psalms                                  ",
    "chapter": "147",
    "verse": "1",
    "text": "Tán dương Chúa Hằng Hữu!"
  },
  {
    "id": 25224,
    "book": "psalms                                  ",
    "chapter": "147",
    "verse": "2",
    "text": "Chúa Hằng Hữu thiết lập Giê-ru-sa-lem"
  },
  {
    "id": 25225,
    "book": "psalms                                  ",
    "chapter": "147",
    "verse": "3",
    "text": "Chúa chữa lành tấm lòng tan vỡ"
  },
  {
    "id": 25226,
    "book": "psalms                                  ",
    "chapter": "147",
    "verse": "4",
    "text": "Chúa đếm các tinh tú"
  },
  {
    "id": 25227,
    "book": "psalms                                  ",
    "chapter": "147",
    "verse": "5",
    "text": "Chúa chúng ta vĩ đại! Quyền năng Ngài cao cả!"
  },
  {
    "id": 25228,
    "book": "psalms                                  ",
    "chapter": "147",
    "verse": "6",
    "text": "Chúa Hằng Hữu nâng cao người khiêm tốn,"
  },
  {
    "id": 25229,
    "book": "psalms                                  ",
    "chapter": "147",
    "verse": "7",
    "text": "Hãy hát cảm tạ Chúa Hằng Hữu;"
  },
  {
    "id": 25230,
    "book": "psalms                                  ",
    "chapter": "147",
    "verse": "8",
    "text": "Chúa giăng mây che phủ bầu trời,"
  },
  {
    "id": 25231,
    "book": "psalms                                  ",
    "chapter": "147",
    "verse": "9",
    "text": "Chúa ban lương thực cho thú hoang,"
  },
  {
    "id": 25232,
    "book": "psalms                                  ",
    "chapter": "147",
    "verse": "10",
    "text": "Chúa không thích sức mạnh của ngựa"
  },
  {
    "id": 25233,
    "book": "psalms                                  ",
    "chapter": "147",
    "verse": "11",
    "text": "Nhưng Chúa hài lòng những ai kính sợ Ngài,"
  },
  {
    "id": 25234,
    "book": "psalms                                  ",
    "chapter": "147",
    "verse": "12",
    "text": "Hỡi Giê-ru-sa-lem, hãy ngợi tôn Chúa Hằng Hữu!"
  },
  {
    "id": 25235,
    "book": "psalms                                  ",
    "chapter": "147",
    "verse": "13",
    "text": "Chúa làm kiên cố then cửa ngươi,"
  },
  {
    "id": 25236,
    "book": "psalms                                  ",
    "chapter": "147",
    "verse": "14",
    "text": "Chúa ban thanh bình nơi biên cương"
  },
  {
    "id": 25237,
    "book": "psalms                                  ",
    "chapter": "147",
    "verse": "15",
    "text": "Chúa ra lệnh cho cả thế giới—"
  },
  {
    "id": 25238,
    "book": "psalms                                  ",
    "chapter": "147",
    "verse": "16",
    "text": "Chúa làm tuyết rơi, trắng như lông chiên;"
  },
  {
    "id": 25239,
    "book": "psalms                                  ",
    "chapter": "147",
    "verse": "17",
    "text": "Chúa ném từng mảng băng giá xuống."
  },
  {
    "id": 25240,
    "book": "psalms                                  ",
    "chapter": "147",
    "verse": "18",
    "text": "Rồi Chúa truyền lệnh, băng tuyết tan ra."
  },
  {
    "id": 25241,
    "book": "psalms                                  ",
    "chapter": "147",
    "verse": "19",
    "text": "Chúa công bố lời Ngài cho Gia-cốp,"
  },
  {
    "id": 25242,
    "book": "psalms                                  ",
    "chapter": "147",
    "verse": "20",
    "text": "Chúa không làm như thế cho dân tộc nào khác;"
  }
]