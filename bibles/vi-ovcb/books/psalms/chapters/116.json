[
  {
    "id": 24720,
    "book": "psalms                                  ",
    "chapter": "116",
    "verse": "1",
    "text": "Tôi yêu mến Chúa Hằng Hữu vì Ngài nghe tiếng tôi cầu cứu.116:1 Ctd nghe tiếng nói và lời nài xin của tôi"
  },
  {
    "id": 24721,
    "book": "psalms                                  ",
    "chapter": "116",
    "verse": "2",
    "text": "Suốt đời, tôi sẽ kêu cầu Chúa,"
  },
  {
    "id": 24722,
    "book": "psalms                                  ",
    "chapter": "116",
    "verse": "3",
    "text": "Tôi mắc vào cạm bẫy tử thần;"
  },
  {
    "id": 24723,
    "book": "psalms                                  ",
    "chapter": "116",
    "verse": "4",
    "text": "Lúc ấy, tôi kêu cầu Danh Chúa Hằng Hữu:"
  },
  {
    "id": 24724,
    "book": "psalms                                  ",
    "chapter": "116",
    "verse": "5",
    "text": "Chúa Hằng Hữu đầy ân sủng và công chính!"
  },
  {
    "id": 24725,
    "book": "psalms                                  ",
    "chapter": "116",
    "verse": "6",
    "text": "Chúa Hằng Hữu bảo tồn người chân chất;"
  },
  {
    "id": 24726,
    "book": "psalms                                  ",
    "chapter": "116",
    "verse": "7",
    "text": "Hồn ta hỡi, hãy về nơi an nghỉ,"
  },
  {
    "id": 24727,
    "book": "psalms                                  ",
    "chapter": "116",
    "verse": "8",
    "text": "Chúa đã cứu linh hồn tôi khỏi chết,"
  },
  {
    "id": 24728,
    "book": "psalms                                  ",
    "chapter": "116",
    "verse": "9",
    "text": "Trọn đời tôi sẽ tiến bước theo Chúa Hằng Hữu,"
  },
  {
    "id": 24729,
    "book": "psalms                                  ",
    "chapter": "116",
    "verse": "10",
    "text": "Tôi vững tin nơi Ngài, nên nói:"
  },
  {
    "id": 24730,
    "book": "psalms                                  ",
    "chapter": "116",
    "verse": "11",
    "text": "Trong cơn bối rối, tôi kêu khóc với Ngài:"
  },
  {
    "id": 24731,
    "book": "psalms                                  ",
    "chapter": "116",
    "verse": "12",
    "text": "Giờ đây, Chúa đã ra tay cứu độ,"
  },
  {
    "id": 24732,
    "book": "psalms                                  ",
    "chapter": "116",
    "verse": "13",
    "text": "Tôi sẽ nâng chén cứu rỗi lên"
  },
  {
    "id": 24733,
    "book": "psalms                                  ",
    "chapter": "116",
    "verse": "14",
    "text": "Tôi sẽ trung tín giữ điều hứa nguyện với Chúa Hằng Hữu,"
  },
  {
    "id": 24734,
    "book": "psalms                                  ",
    "chapter": "116",
    "verse": "15",
    "text": "Chúa Hằng Hữu quý trọng mạng sống"
  },
  {
    "id": 24735,
    "book": "psalms                                  ",
    "chapter": "116",
    "verse": "16",
    "text": "Lạy Chúa Hằng Hữu, con là đầy tớ Ngài;"
  },
  {
    "id": 24736,
    "book": "psalms                                  ",
    "chapter": "116",
    "verse": "17",
    "text": "Con sẽ hiến dâng lễ vật tạ ơn Ngài"
  },
  {
    "id": 24737,
    "book": "psalms                                  ",
    "chapter": "116",
    "verse": "18",
    "text": "Con sẽ trung tín giữ điều hứa nguyện với Chúa Hằng Hữu,"
  },
  {
    "id": 24738,
    "book": "psalms                                  ",
    "chapter": "116",
    "verse": "19",
    "text": "tại hành lang của Chúa Hằng Hữu,"
  }
