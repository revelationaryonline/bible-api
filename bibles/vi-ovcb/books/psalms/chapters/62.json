[
  {
    "id": 23699,
    "book": "psalms                                  ",
    "chapter": "62",
    "verse": "1",
    "text": "Linh hồn tôi chỉ an nghỉ trong Đức Chúa Trời,"
  },
  {
    "id": 23700,
    "book": "psalms                                  ",
    "chapter": "62",
    "verse": "2",
    "text": "Chỉ có Chúa là tảng đá và sự giải cứu tôi."
  },
  {
    "id": 23701,
    "book": "psalms                                  ",
    "chapter": "62",
    "verse": "3",
    "text": "Các anh trấn áp một người bao lâu nữa—"
  },
  {
    "id": 23702,
    "book": "psalms                                  ",
    "chapter": "62",
    "verse": "4",
    "text": "Từ nơi cao họ hiệp nhau lật đổ người."
  },
  {
    "id": 23703,
    "book": "psalms                                  ",
    "chapter": "62",
    "verse": "5",
    "text": "Hồn ta hỡi, chỉ an nghỉ trong Đức Chúa Trời,"
  },
  {
    "id": 23704,
    "book": "psalms                                  ",
    "chapter": "62",
    "verse": "6",
    "text": "Chỉ Ngài là vầng đá và sự cứu rỗi của ta,"
  },
  {
    "id": 23705,
    "book": "psalms                                  ",
    "chapter": "62",
    "verse": "7",
    "text": "Việc giải cứu và danh dự của ta đều do Chúa."
  },
  {
    "id": 23706,
    "book": "psalms                                  ",
    "chapter": "62",
    "verse": "8",
    "text": "Hỡi chúng dân, hãy tin cậy Chúa mãi mãi."
  },
  {
    "id": 23707,
    "book": "psalms                                  ",
    "chapter": "62",
    "verse": "9",
    "text": "Người hạ lưu khác nào hư không,"
  },
  {
    "id": 23708,
    "book": "psalms                                  ",
    "chapter": "62",
    "verse": "10",
    "text": "Đừng trông nhờ vào tham nhũng,"
  },
  {
    "id": 23709,
    "book": "psalms                                  ",
    "chapter": "62",
    "verse": "11",
    "text": "Một lần Đức Chúa Trời đã phán dạy,"
  },
  {
    "id": 23710,
    "book": "psalms                                  ",
    "chapter": "62",
    "verse": "12",
    "text": "Chúa là Đấng Nhân Từ,"
  }
]