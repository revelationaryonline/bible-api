[
  {
    "id": 23679,
    "book": "psalms                                  ",
    "chapter": "60",
    "verse": "1",
    "text": "Lạy Đức Chúa Trời, Ngài lìa bỏ chúng con."
  },
  {
    "id": 23680,
    "book": "psalms                                  ",
    "chapter": "60",
    "verse": "2",
    "text": "Chúa làm đất chấn động, mặt đất nứt ra."
  },
  {
    "id": 23681,
    "book": "psalms                                  ",
    "chapter": "60",
    "verse": "3",
    "text": "Chúa khiến dân60:3 Nt dân Chúa chịu nhiều gian khổ,"
  },
  {
    "id": 23682,
    "book": "psalms                                  ",
    "chapter": "60",
    "verse": "4",
    "text": "Nhưng những ai kính sợ Chúa, được ban một ngọn cờ,"
  },
  {
    "id": 23683,
    "book": "psalms                                  ",
    "chapter": "60",
    "verse": "5",
    "text": "Để giải cứu dân Chúa yêu."
  },
  {
    "id": 23684,
    "book": "psalms                                  ",
    "chapter": "60",
    "verse": "6",
    "text": "Giữa nơi thánh Đức Chúa Trời từng phán:"
  },
  {
    "id": 23685,
    "book": "psalms                                  ",
    "chapter": "60",
    "verse": "7",
    "text": "Ga-la-át là của Ta,"
  },
  {
    "id": 23686,
    "book": "psalms                                  ",
    "chapter": "60",
    "verse": "8",
    "text": "Nhưng Mô-áp, bệ rửa chân Ta, sẽ là đầy tớ Ta,"
  },
  {
    "id": 23687,
    "book": "psalms                                  ",
    "chapter": "60",
    "verse": "9",
    "text": "Ai sẽ dẫn con vào thành lũy?"
  },
  {
    "id": 23688,
    "book": "psalms                                  ",
    "chapter": "60",
    "verse": "10",
    "text": "Lạy Đức Chúa Trời, chẳng phải Ngài đã từ bỏ chúng con sao?"
  },
  {
    "id": 23689,
    "book": "psalms                                  ",
    "chapter": "60",
    "verse": "11",
    "text": "Xin giúp chúng con chống lại quân thù,"
  },
  {
    "id": 23690,
    "book": "psalms                                  ",
    "chapter": "60",
    "verse": "12",
    "text": "Nhưng nhờ Đức Chúa Trời, chúng con sẽ chiến đấu anh dũng,"
  }
]