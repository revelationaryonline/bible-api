[
  {
    "id": 24421,
    "book": "psalms                                  ",
    "chapter": "103",
    "verse": "1",
    "text": "Hồn ta hỡi, hãy dâng tiếng ngợi ca Chúa Hằng Hữu;"
  },
  {
    "id": 24422,
    "book": "psalms                                  ",
    "chapter": "103",
    "verse": "2",
    "text": "Hồn ta hỡi, hãy dâng tiếng ngợi ca Chúa Hằng Hữu;"
  },
  {
    "id": 24423,
    "book": "psalms                                  ",
    "chapter": "103",
    "verse": "3",
    "text": "Chính Chúa tha thứ các tội ác"
  },
  {
    "id": 24424,
    "book": "psalms                                  ",
    "chapter": "103",
    "verse": "4",
    "text": "Chúa cứu khỏi chốn diệt vong"
  },
  {
    "id": 24425,
    "book": "psalms                                  ",
    "chapter": "103",
    "verse": "5",
    "text": "Ngài cho thỏa mãn điều tốt lành khao khát."
  },
  {
    "id": 24426,
    "book": "psalms                                  ",
    "chapter": "103",
    "verse": "6",
    "text": "Chúa Hằng Hữu đem công chính"
  },
  {
    "id": 24427,
    "book": "psalms                                  ",
    "chapter": "103",
    "verse": "7",
    "text": "Chúa hiển lộ cho Môi-se biết đường lối Chúa"
  },
  {
    "id": 24428,
    "book": "psalms                                  ",
    "chapter": "103",
    "verse": "8",
    "text": "Chúa Hằng Hữu xót thương và nhân ái,"
  },
  {
    "id": 24429,
    "book": "psalms                                  ",
    "chapter": "103",
    "verse": "9",
    "text": "Ngài không buộc tội luôn luôn,"
  },
  {
    "id": 24430,
    "book": "psalms                                  ",
    "chapter": "103",
    "verse": "10",
    "text": "Chúa không phạt tương xứng với tội chúng ta phạm;"
  },
  {
    "id": 24431,
    "book": "psalms                                  ",
    "chapter": "103",
    "verse": "11",
    "text": "Vì nhân từ Chúa rộng lớn đối với người kính sợ Ngài,"
  },
  {
    "id": 24432,
    "book": "psalms                                  ",
    "chapter": "103",
    "verse": "12",
    "text": "Vi phạm chúng ta Chúa bỏ xa ta,"
  },
  {
    "id": 24433,
    "book": "psalms                                  ",
    "chapter": "103",
    "verse": "13",
    "text": "Chúa Hằng Hữu thương xót người kính sợ Ngài,"
  },
  {
    "id": 24434,
    "book": "psalms                                  ",
    "chapter": "103",
    "verse": "14",
    "text": "Vì Ngài biết rõ bản chất chúng ta;"
  },
  {
    "id": 24435,
    "book": "psalms                                  ",
    "chapter": "103",
    "verse": "15",
    "text": "Ngày của chúng ta như cỏ dại;"
  },
  {
    "id": 24436,
    "book": "psalms                                  ",
    "chapter": "103",
    "verse": "16",
    "text": "Chỉ một ngọn gió thoảng đủ làm cho úa tàn—"
  },
  {
    "id": 24437,
    "book": "psalms                                  ",
    "chapter": "103",
    "verse": "17",
    "text": "Nhưng Chúa Hằng Hữu vẫn mãi nhân từ với những ai biết kính sợ Ngài."
  },
  {
    "id": 24438,
    "book": "psalms                                  ",
    "chapter": "103",
    "verse": "18",
    "text": "với những ai vâng giữ giao ước Ngài,"
  },
  {
    "id": 24439,
    "book": "psalms                                  ",
    "chapter": "103",
    "verse": "19",
    "text": "Chúa Hằng Hữu vững lập ngôi trên trời;"
  },
  {
    "id": 24440,
    "book": "psalms                                  ",
    "chapter": "103",
    "verse": "20",
    "text": "Các thiên sứ, hãy ca ngợi Chúa Hằng Hữu,"
  },
  {
    "id": 24441,
    "book": "psalms                                  ",
    "chapter": "103",
    "verse": "21",
    "text": "Hãy chúc tụng Chúa Hằng Hữu, hỡi cả thiên binh,"
  },
  {
    "id": 24442,
    "book": "psalms                                  ",
    "chapter": "103",
    "verse": "22",
    "text": "Hãy chúc tụng Chúa Hằng Hữu, hỡi các loài được Ngài tạo dựng,"
  }
]