[
  {
    "id": 24478,
    "book": "psalms                                  ",
    "chapter": "105",
    "verse": "1",
    "text": "Hãy cảm tạ Chúa Hằng Hữu và công bố sự vĩ đại Ngài."
  },
  {
    "id": 24479,
    "book": "psalms                                  ",
    "chapter": "105",
    "verse": "2",
    "text": "Hát khen Chúa; phải, hãy hát ngợi tôn Ngài."
  },
  {
    "id": 24480,
    "book": "psalms                                  ",
    "chapter": "105",
    "verse": "3",
    "text": "Hãy tự hào trong Danh Thánh Chúa;"
  },
  {
    "id": 24481,
    "book": "psalms                                  ",
    "chapter": "105",
    "verse": "4",
    "text": "Hãy tìm kiếm Chúa Hằng Hữu và sức mạnh Ngài;"
  },
  {
    "id": 24482,
    "book": "psalms                                  ",
    "chapter": "105",
    "verse": "5",
    "text": "Hãy ghi nhớ công việc Ngài thực hiện,"
  },
  {
    "id": 24483,
    "book": "psalms                                  ",
    "chapter": "105",
    "verse": "6",
    "text": "cho dòng dõi Áp-ra-ham, đầy tớ Chúa,"
  },
  {
    "id": 24484,
    "book": "psalms                                  ",
    "chapter": "105",
    "verse": "7",
    "text": "Ngài là Chúa Hằng Hữu, Đức Chúa Trời chúng con."
  },
  {
    "id": 24485,
    "book": "psalms                                  ",
    "chapter": "105",
    "verse": "8",
    "text": "Chúa ghi nhớ giao ước Ngài mãi mãi—"
  },
  {
    "id": 24486,
    "book": "psalms                                  ",
    "chapter": "105",
    "verse": "9",
    "text": "Là giao ước Chúa lập với Áp-ra-ham"
  },
  {
    "id": 24487,
    "book": "psalms                                  ",
    "chapter": "105",
    "verse": "10",
    "text": "Rồi Chúa xác nhận với Gia-cốp như một sắc lệnh,"
  },
  {
    "id": 24488,
    "book": "psalms                                  ",
    "chapter": "105",
    "verse": "11",
    "text": "“Ta sẽ ban đất Ca-na-an cho con"
  },
  {
    "id": 24489,
    "book": "psalms                                  ",
    "chapter": "105",
    "verse": "12",
    "text": "Lúc ấy họ chỉ là một số ít người,"
  },
  {
    "id": 24490,
    "book": "psalms                                  ",
    "chapter": "105",
    "verse": "13",
    "text": "Nước này, xứ khác, họ lang thang,"
  },
  {
    "id": 24491,
    "book": "psalms                                  ",
    "chapter": "105",
    "verse": "14",
    "text": "Nhưng Chúa không cho ai áp bức họ."
  },
  {
    "id": 24492,
    "book": "psalms                                  ",
    "chapter": "105",
    "verse": "15",
    "text": "“Người Ta xức dầu, không ai được xâm phạm,"
  },
  {
    "id": 24493,
    "book": "psalms                                  ",
    "chapter": "105",
    "verse": "16",
    "text": "Chúa đem nạn đói đến xứ Ca-na-an,"
  },
  {
    "id": 24494,
    "book": "psalms                                  ",
    "chapter": "105",
    "verse": "17",
    "text": "Chúa sai một người đến Ai Cập làm tiên phong—"
  },
  {
    "id": 24495,
    "book": "psalms                                  ",
    "chapter": "105",
    "verse": "18",
    "text": "Họ tra chân ông vào cùm"
  },
  {
    "id": 24496,
    "book": "psalms                                  ",
    "chapter": "105",
    "verse": "19",
    "text": "Đến khi điều người tiên đoán xảy ra,"
  },
  {
    "id": 24497,
    "book": "psalms                                  ",
    "chapter": "105",
    "verse": "20",
    "text": "Pha-ra-ôn sai thả Giô-sép ra khỏi ngục;"
  },
  {
    "id": 24498,
    "book": "psalms                                  ",
    "chapter": "105",
    "verse": "21",
    "text": "Giô-sép được giao trách nhiệm cai quản mọi việc trong triều vua;"
  },
  {
    "id": 24499,
    "book": "psalms                                  ",
    "chapter": "105",
    "verse": "22",
    "text": "Ông có quyền chỉ dẫn các triều thần,"
  },
  {
    "id": 24500,
    "book": "psalms                                  ",
    "chapter": "105",
    "verse": "23",
    "text": "Ít-ra-ên từng cư ngụ tại Ai Cập;"
  },
  {
    "id": 24501,
    "book": "psalms                                  ",
    "chapter": "105",
    "verse": "24",
    "text": "Chúa Hằng Hữu cho người Ít-ra-ên sinh sôi nhiều"
  },
  {
    "id": 24502,
    "book": "psalms                                  ",
    "chapter": "105",
    "verse": "25",
    "text": "Chúa khiến người Ai Cập ghét người Ít-ra-ên,"
  },
  {
    "id": 24503,
    "book": "psalms                                  ",
    "chapter": "105",
    "verse": "26",
    "text": "Nhưng Chúa sai Môi-se, đầy tớ Ngài,"
  },
  {
    "id": 24504,
    "book": "psalms                                  ",
    "chapter": "105",
    "verse": "27",
    "text": "Họ làm các phép lạ giữa Ai Cập,"
  },
  {
    "id": 24505,
    "book": "psalms                                  ",
    "chapter": "105",
    "verse": "28",
    "text": "Chúa Hằng Hữu bao trùm Ai Cập trong bóng tối,"
  },
  {
    "id": 24506,
    "book": "psalms                                  ",
    "chapter": "105",
    "verse": "29",
    "text": "Chúa biến nước thành máu,"
  },
  {
    "id": 24507,
    "book": "psalms                                  ",
    "chapter": "105",
    "verse": "30",
    "text": "Ếch nhái sinh ra nhung nhúc,"
  },
  {
    "id": 24508,
    "book": "psalms                                  ",
    "chapter": "105",
    "verse": "31",
    "text": "Chúa Hằng Hữu phán, ruồi mòng tràn đến Ai Cập,"
  },
  {
    "id": 24509,
    "book": "psalms                                  ",
    "chapter": "105",
    "verse": "32",
    "text": "Thay vì mưa, Chúa cho mưa đá,"
  },
  {
    "id": 24510,
    "book": "psalms                                  ",
    "chapter": "105",
    "verse": "33",
    "text": "Làm vườn nho, cây vả đều ngã rạp,"
  },
  {
    "id": 24511,
    "book": "psalms                                  ",
    "chapter": "105",
    "verse": "34",
    "text": "Theo lệnh Chúa, cào cào ào ạt đến—"
  },
  {
    "id": 24512,
    "book": "psalms                                  ",
    "chapter": "105",
    "verse": "35",
    "text": "Chúng cắn xả mọi cây xanh trong xứ,"
  },
  {
    "id": 24513,
    "book": "psalms                                  ",
    "chapter": "105",
    "verse": "36",
    "text": "Rồi Chúa giết mọi con trưởng của nhà Ai Cập,"
  },
  {
    "id": 24514,
    "book": "psalms                                  ",
    "chapter": "105",
    "verse": "37",
    "text": "Chúa Hằng Hữu đem dân Ngài khỏi Ai Cập, tay đầy bạc và vàng;"
  },
  {
    "id": 24515,
    "book": "psalms                                  ",
    "chapter": "105",
    "verse": "38",
    "text": "Ai Cập vui mừng khi họ rời đi,"
  },
  {
    "id": 24516,
    "book": "psalms                                  ",
    "chapter": "105",
    "verse": "39",
    "text": "Chúa Hằng Hữu giăng mây che chở họ"
  },
  {
    "id": 24517,
    "book": "psalms                                  ",
    "chapter": "105",
    "verse": "40",
    "text": "Khi họ cầu xin, Chúa cho chim cút đến,"
  },
  {
    "id": 24518,
    "book": "psalms                                  ",
    "chapter": "105",
    "verse": "41",
    "text": "Chúa mở đá cho nước tuôn trào,"
  },
  {
    "id": 24519,
    "book": "psalms                                  ",
    "chapter": "105",
    "verse": "42",
    "text": "Lời hứa thánh Chúa luôn ghi nhớ"
  },
  {
    "id": 24520,
    "book": "psalms                                  ",
    "chapter": "105",
    "verse": "43",
    "text": "Đưa dân Ngài vui mừng rời Ai Cập,"
  },
  {
    "id": 24521,
    "book": "psalms                                  ",
    "chapter": "105",
    "verse": "44",
    "text": "Chúa ban dân Ngài đất các nước làm sản nghiệp,"
  },
  {
    "id": 24522,
    "book": "psalms                                  ",
    "chapter": "105",
    "verse": "45",
    "text": "Mọi việc xảy ra để họ vâng giữ giới răn Ngài,"
  }
]