[
  {
    "id": 24350,
    "book": "psalms                                  ",
    "chapter": "97",
    "verse": "1",
    "text": "Chúa Hằng Hữu là Vua!"
  },
  {
    "id": 24351,
    "book": "psalms                                  ",
    "chapter": "97",
    "verse": "2",
    "text": "Mây đen vây quanh Chúa."
  },
  {
    "id": 24352,
    "book": "psalms                                  ",
    "chapter": "97",
    "verse": "3",
    "text": "Lửa bùng cháy trước Ngài"
  },
  {
    "id": 24353,
    "book": "psalms                                  ",
    "chapter": "97",
    "verse": "4",
    "text": "Ánh sáng Ngài chiếu rạng thế gian."
  },
  {
    "id": 24354,
    "book": "psalms                                  ",
    "chapter": "97",
    "verse": "5",
    "text": "Núi đồi tan như sáp trước Chúa Hằng Hữu,"
  },
  {
    "id": 24355,
    "book": "psalms                                  ",
    "chapter": "97",
    "verse": "6",
    "text": "Các tầng trời truyền rao đức công chính;"
  },
  {
    "id": 24356,
    "book": "psalms                                  ",
    "chapter": "97",
    "verse": "7",
    "text": "Những người thờ hình tượng đều bị sỉ nhục—"
  },
  {
    "id": 24357,
    "book": "psalms                                  ",
    "chapter": "97",
    "verse": "8",
    "text": "Si-ôn đã nghe và hân hoan,"
  },
  {
    "id": 24358,
    "book": "psalms                                  ",
    "chapter": "97",
    "verse": "9",
    "text": "Vì Ngài, lạy Chúa Hằng Hữu, là Đấng Chí Tôn trên hoàn vũ;"
  },
  {
    "id": 24359,
    "book": "psalms                                  ",
    "chapter": "97",
    "verse": "10",
    "text": "Ai kính yêu Chúa Hằng Hữu, ghét gian tà!"
  },
  {
    "id": 24360,
    "book": "psalms                                  ",
    "chapter": "97",
    "verse": "11",
    "text": "Ánh sáng bao bọc người công chính,"
  },
  {
    "id": 24361,
    "book": "psalms                                  ",
    "chapter": "97",
    "verse": "12",
    "text": "Nguyện những ai tin kính hãy vui mừng trong Chúa Hằng Hữu"
  }
]