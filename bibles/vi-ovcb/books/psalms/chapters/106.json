[
  {
    "id": 24523,
    "book": "psalms                                  ",
    "chapter": "106",
    "verse": "1",
    "text": "Ngợi tôn Chúa Hằng Hữu!"
  },
  {
    "id": 24524,
    "book": "psalms                                  ",
    "chapter": "106",
    "verse": "2",
    "text": "Ai có thể tường thuật phép lạ Chúa Hằng Hữu làm?"
  },
  {
    "id": 24525,
    "book": "psalms                                  ",
    "chapter": "106",
    "verse": "3",
    "text": "Phước cho người giữ theo đường ngay thẳng"
  },
  {
    "id": 24526,
    "book": "psalms                                  ",
    "chapter": "106",
    "verse": "4",
    "text": "Lạy Chúa Hằng Hữu, xin nhớ đến con, khi Chúa làm ơn cho dân Ngài;"
  },
  {
    "id": 24527,
    "book": "psalms                                  ",
    "chapter": "106",
    "verse": "5",
    "text": "Xin cho con thấy tuyển dân được hưng thịnh."
  },
  {
    "id": 24528,
    "book": "psalms                                  ",
    "chapter": "106",
    "verse": "6",
    "text": "Chúng con với tổ tiên đều mang trọng tội."
  },
  {
    "id": 24529,
    "book": "psalms                                  ",
    "chapter": "106",
    "verse": "7",
    "text": "Khi tổ tiên chúng con ở Ai Cập"
  },
  {
    "id": 24530,
    "book": "psalms                                  ",
    "chapter": "106",
    "verse": "8",
    "text": "Dù vậy, Chúa vẫn cứu họ—"
  },
  {
    "id": 24531,
    "book": "psalms                                  ",
    "chapter": "106",
    "verse": "9",
    "text": "Chúa ra lệnh, Biển Đỏ liền khai lối,"
  },
  {
    "id": 24532,
    "book": "psalms                                  ",
    "chapter": "106",
    "verse": "10",
    "text": "Chúa cứu họ khỏi kẻ thù của họ,"
  },
  {
    "id": 24533,
    "book": "psalms                                  ",
    "chapter": "106",
    "verse": "11",
    "text": "Nước đổ xuống nhận chìm quân địch;"
  },
  {
    "id": 24534,
    "book": "psalms                                  ",
    "chapter": "106",
    "verse": "12",
    "text": "Khi ấy dân Chúa mới tin lời Ngài hứa."
  },
  {
    "id": 24535,
    "book": "psalms                                  ",
    "chapter": "106",
    "verse": "13",
    "text": "Nhưng rồi họ quên thật nhanh những việc Ngài làm!"
  },
  {
    "id": 24536,
    "book": "psalms                                  ",
    "chapter": "106",
    "verse": "14",
    "text": "Tại hoang mạc dân Chúa để dục vọng mình nổi dậy không kiềm chế,"
  },
  {
    "id": 24537,
    "book": "psalms                                  ",
    "chapter": "106",
    "verse": "15",
    "text": "Vậy, Chúa ban cho điều họ mong ước,"
  },
  {
    "id": 24538,
    "book": "psalms                                  ",
    "chapter": "106",
    "verse": "16",
    "text": "Trong trại quân, họ ganh ghét Môi-se"
  },
  {
    "id": 24539,
    "book": "psalms                                  ",
    "chapter": "106",
    "verse": "17",
    "text": "Vì thế, đất liền há miệng;"
  },
  {
    "id": 24540,
    "book": "psalms                                  ",
    "chapter": "106",
    "verse": "18",
    "text": "Rồi lửa thiêu luôn cả bè đảng;"
  },
  {
    "id": 24541,
    "book": "psalms                                  ",
    "chapter": "106",
    "verse": "19",
    "text": "Tại Hô-rếp, dân chúng đúc tượng thần;"
  },
  {
    "id": 24542,
    "book": "psalms                                  ",
    "chapter": "106",
    "verse": "20",
    "text": "Từ bỏ Đức Chúa Trời vinh quang hằng sống,"
  },
  {
    "id": 24543,
    "book": "psalms                                  ",
    "chapter": "106",
    "verse": "21",
    "text": "Họ quên Đức Chúa Trời, Đấng giải cứu họ,"
  },
  {
    "id": 24544,
    "book": "psalms                                  ",
    "chapter": "106",
    "verse": "22",
    "text": "những việc diệu kỳ trong đất nước Cham,"
  },
  {
    "id": 24545,
    "book": "psalms                                  ",
    "chapter": "106",
    "verse": "23",
    "text": "Chúa tỏ ý muốn tiêu diệt hết."
  },
  {
    "id": 24546,
    "book": "psalms                                  ",
    "chapter": "106",
    "verse": "24",
    "text": "Dân coi thường việc vào đất hứa"
  },
  {
    "id": 24547,
    "book": "psalms                                  ",
    "chapter": "106",
    "verse": "25",
    "text": "Thay vào đó họ oán than trong trại,"
  },
  {
    "id": 24548,
    "book": "psalms                                  ",
    "chapter": "106",
    "verse": "26",
    "text": "Vì tội ác, Chúa đã thề nguyền"
  },
  {
    "id": 24549,
    "book": "psalms                                  ",
    "chapter": "106",
    "verse": "27",
    "text": "và làm cho dòng dõi họ tản mác khắp nơi,"
  },
  {
    "id": 24550,
    "book": "psalms                                  ",
    "chapter": "106",
    "verse": "28",
    "text": "Tổ phụ chúng con cùng thờ lạy Ba-anh tại Phê-ô;"
  },
  {
    "id": 24551,
    "book": "psalms                                  ",
    "chapter": "106",
    "verse": "29",
    "text": "Họ khiêu khích Chúa Hằng Hữu qua nhiều việc,"
  },
  {
    "id": 24552,
    "book": "psalms                                  ",
    "chapter": "106",
    "verse": "30",
    "text": "Cho đến lúc Phi-nê-a cầu xin"
  },
  {
    "id": 24553,
    "book": "psalms                                  ",
    "chapter": "106",
    "verse": "31",
    "text": "Việc ông làm được xem là công chính"
  },
  {
    "id": 24554,
    "book": "psalms                                  ",
    "chapter": "106",
    "verse": "32",
    "text": "Tại Mê-ri-ba, họ chọc giận Chúa Hằng Hữu,"
  },
  {
    "id": 24555,
    "book": "psalms                                  ",
    "chapter": "106",
    "verse": "33",
    "text": "Ông quẫn trí khi dân chúng gây rối,"
  },
  {
    "id": 24556,
    "book": "psalms                                  ",
    "chapter": "106",
    "verse": "34",
    "text": "Họ không tiêu diệt dân địa phương,"
  },
  {
    "id": 24557,
    "book": "psalms                                  ",
    "chapter": "106",
    "verse": "35",
    "text": "Nhưng đồng hóa với các dân ấy,"
  },
  {
    "id": 24558,
    "book": "psalms                                  ",
    "chapter": "106",
    "verse": "36",
    "text": "Thậm chí thờ phượng các tượng thần,"
  },
  {
    "id": 24559,
    "book": "psalms                                  ",
    "chapter": "106",
    "verse": "37",
    "text": "Nhẫn tâm sát hại chính con mình"
  },
  {
    "id": 24560,
    "book": "psalms                                  ",
    "chapter": "106",
    "verse": "38",
    "text": "Máu vô tội tràn lan khắp đất,"
  },
  {
    "id": 24561,
    "book": "psalms                                  ",
    "chapter": "106",
    "verse": "39",
    "text": "Chăm điều ác nên toàn dân nhơ nhuốc,"
  },
  {
    "id": 24562,
    "book": "psalms                                  ",
    "chapter": "106",
    "verse": "40",
    "text": "Chúa Hằng Hữu nổi giận vô cùng,"
  },
  {
    "id": 24563,
    "book": "psalms                                  ",
    "chapter": "106",
    "verse": "41",
    "text": "Ngài phó họ cho người ngoại quốc,"
  },
  {
    "id": 24564,
    "book": "psalms                                  ",
    "chapter": "106",
    "verse": "42",
    "text": "Và kẻ thù họ áp bức họ,"
  },
  {
    "id": 24565,
    "book": "psalms                                  ",
    "chapter": "106",
    "verse": "43",
    "text": "Nhiều lần Chúa ra tay giải cứu,"
  },
  {
    "id": 24566,
    "book": "psalms                                  ",
    "chapter": "106",
    "verse": "44",
    "text": "Dù vậy khi dân Ngài kêu la thảm thiết"
  },
  {
    "id": 24567,
    "book": "psalms                                  ",
    "chapter": "106",
    "verse": "45",
    "text": "Ngài nhớ lại những lời giao ước của Ngài,"
  },
  {
    "id": 24568,
    "book": "psalms                                  ",
    "chapter": "106",
    "verse": "46",
    "text": "Ngài khiến quân thù sinh lòng trắc ẩn,"
  },
  {
    "id": 24569,
    "book": "psalms                                  ",
    "chapter": "106",
    "verse": "47",
    "text": "Xin cứu chúng con, Chúa Hằng Hữu, Đức Chúa Trời chúng con ôi!"
  },
  {
    "id": 24570,
    "book": "psalms                                  ",
    "chapter": "106",
    "verse": "48",
    "text": "Chúc tụng Chúa Hằng Hữu, Đức Chúa Trời của Ít-ra-ên,"
  }
]