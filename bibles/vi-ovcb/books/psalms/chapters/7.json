[
  {
    "id": 22867,
    "book": "psalms                                  ",
    "chapter": "7",
    "verse": "1",
    "text": "Con ẩn trú nơi Chúa, lạy Chúa Hằng Hữu, Đức Chúa Trời con."
  },
  {
    "id": 22868,
    "book": "psalms                                  ",
    "chapter": "7",
    "verse": "2",
    "text": "Kẻo chúng nó vồ con như sư tử,"
  },
  {
    "id": 22869,
    "book": "psalms                                  ",
    "chapter": "7",
    "verse": "3",
    "text": "Lạy Chúa Hằng Hữu, Đức Chúa Trời con, nếu con làm việc dữ"
  },
  {
    "id": 22870,
    "book": "psalms                                  ",
    "chapter": "7",
    "verse": "4",
    "text": "nếu con xử tệ với người sống thuận hòa,"
  },
  {
    "id": 22871,
    "book": "psalms                                  ",
    "chapter": "7",
    "verse": "5",
    "text": "thì con đáng bị kẻ thù rượt bắt."
  },
  {
    "id": 22872,
    "book": "psalms                                  ",
    "chapter": "7",
    "verse": "6",
    "text": "Lạy Chúa Hằng Hữu, xin nổi cơn thịnh nộ!"
  },
  {
    "id": 22873,
    "book": "psalms                                  ",
    "chapter": "7",
    "verse": "7",
    "text": "Các dân tộc sẽ tụ họp quanh Chúa."
  },
  {
    "id": 22874,
    "book": "psalms                                  ",
    "chapter": "7",
    "verse": "8",
    "text": "Chúa Hằng Hữu sẽ xét xử muôn dân."
  },
  {
    "id": 22875,
    "book": "psalms                                  ",
    "chapter": "7",
    "verse": "9",
    "text": "Xin chấm dứt việc hung tàn người ác,"
  },
  {
    "id": 22876,
    "book": "psalms                                  ",
    "chapter": "7",
    "verse": "10",
    "text": "Đức Chúa Trời là khiên thuẫn chở che tôi,"
  },
  {
    "id": 22877,
    "book": "psalms                                  ",
    "chapter": "7",
    "verse": "11",
    "text": "Đức Chúa Trời là Thẩm Phán công minh.7:11 Nt Chúa sẽ xét đoán công minh cả thế giới"
  },
  {
    "id": 22878,
    "book": "psalms                                  ",
    "chapter": "7",
    "verse": "12",
    "text": "Nếu không hối cải ăn năn,"
  },
  {
    "id": 22879,
    "book": "psalms                                  ",
    "chapter": "7",
    "verse": "13",
    "text": "Bày ra khí giới hủy diệt,"
  },
  {
    "id": 22880,
    "book": "psalms                                  ",
    "chapter": "7",
    "verse": "14",
    "text": "Người gian ác cưu mang độc kế;"
  },
  {
    "id": 22881,
    "book": "psalms                                  ",
    "chapter": "7",
    "verse": "15",
    "text": "Họ đào hầm toan để hại người,"
  },
  {
    "id": 22882,
    "book": "psalms                                  ",
    "chapter": "7",
    "verse": "16",
    "text": "Điều tàn hại họ gây ra lại giáng trên họ."
  },
  {
    "id": 22883,
    "book": "psalms                                  ",
    "chapter": "7",
    "verse": "17",
    "text": "Tôi sẽ cảm tạ Chúa Hằng Hữu vì Ngài công chính;"
  }
]