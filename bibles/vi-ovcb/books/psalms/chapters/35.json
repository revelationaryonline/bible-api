[
  {
    "id": 23282,
    "book": "psalms                                  ",
    "chapter": "35",
    "verse": "1",
    "text": "Chúa Hằng Hữu ôi, xin tranh cãi cùng người tranh cãi lại con."
  },
  {
    "id": 23283,
    "book": "psalms                                  ",
    "chapter": "35",
    "verse": "2",
    "text": "Xin cầm khiên mộc,"
  },
  {
    "id": 23284,
    "book": "psalms                                  ",
    "chapter": "35",
    "verse": "3",
    "text": "Xin lấy giáo và lao cản đường người đuổi con."
  },
  {
    "id": 23285,
    "book": "psalms                                  ",
    "chapter": "35",
    "verse": "4",
    "text": "Cho người tìm giết con ê chề nhục nhã;"
  },
  {
    "id": 23286,
    "book": "psalms                                  ",
    "chapter": "35",
    "verse": "5",
    "text": "Xin thiên sứ của Chúa Hằng Hữu đuổi xua họ—"
  },
  {
    "id": 23287,
    "book": "psalms                                  ",
    "chapter": "35",
    "verse": "6",
    "text": "Cho đường họ tối tăm, trơn trợt,"
  },
  {
    "id": 23288,
    "book": "psalms                                  ",
    "chapter": "35",
    "verse": "7",
    "text": "Họ giăng lưới hại con vô cớ"
  },
  {
    "id": 23289,
    "book": "psalms                                  ",
    "chapter": "35",
    "verse": "8",
    "text": "Nguyện họ gặp tai ương khủng khiếp!"
  },
  {
    "id": 23290,
    "book": "psalms                                  ",
    "chapter": "35",
    "verse": "9",
    "text": "Con hân hoan trong Chúa Hằng Hữu,"
  },
  {
    "id": 23291,
    "book": "psalms                                  ",
    "chapter": "35",
    "verse": "10",
    "text": "Mỗi xương cốt trong thân thể con ngợi tôn Chúa:"
  },
  {
    "id": 23292,
    "book": "psalms                                  ",
    "chapter": "35",
    "verse": "11",
    "text": "Bọn chứng gian tiến lên cật vấn,"
  },
  {
    "id": 23293,
    "book": "psalms                                  ",
    "chapter": "35",
    "verse": "12",
    "text": "Họ lấy ác báo trả việc lành."
  },
  {
    "id": 23294,
    "book": "psalms                                  ",
    "chapter": "35",
    "verse": "13",
    "text": "Thế mà khi chúng bệnh hoạn, con mặc áo gai,"
  },
  {
    "id": 23295,
    "book": "psalms                                  ",
    "chapter": "35",
    "verse": "14",
    "text": "Con khóc chúng như anh em, bạn thiết,"
  },
  {
    "id": 23296,
    "book": "psalms                                  ",
    "chapter": "35",
    "verse": "15",
    "text": "Thế mà khi con khốn đốn, họ liên hoan"
  },
  {
    "id": 23297,
    "book": "psalms                                  ",
    "chapter": "35",
    "verse": "16",
    "text": "Như bọn vô đạo, họ chế nhạo con;"
  },
  {
    "id": 23298,
    "book": "psalms                                  ",
    "chapter": "35",
    "verse": "17",
    "text": "Chúa Hằng Hữu ôi, Chúa cứ lặng nhìn đến bao giờ?"
  },
  {
    "id": 23299,
    "book": "psalms                                  ",
    "chapter": "35",
    "verse": "18",
    "text": "Con sẽ cảm tạ Chúa giữa đại hội."
  },
  {
    "id": 23300,
    "book": "psalms                                  ",
    "chapter": "35",
    "verse": "19",
    "text": "Xin chớ để kẻ thù reo vui,"
  },
  {
    "id": 23301,
    "book": "psalms                                  ",
    "chapter": "35",
    "verse": "20",
    "text": "Vì họ không nói lời hòa hảo,"
  },
  {
    "id": 23302,
    "book": "psalms                                  ",
    "chapter": "35",
    "verse": "21",
    "text": "Họ la to: “Ha! Ha!"
  },
  {
    "id": 23303,
    "book": "psalms                                  ",
    "chapter": "35",
    "verse": "22",
    "text": "Chúa Hằng Hữu ôi, Ngài biết mọi việc."
  },
  {
    "id": 23304,
    "book": "psalms                                  ",
    "chapter": "35",
    "verse": "23",
    "text": "Xin thức giấc! Xin trỗi dậy bênh vực con!"
  },
  {
    "id": 23305,
    "book": "psalms                                  ",
    "chapter": "35",
    "verse": "24",
    "text": "Xin Chúa Công Chính xét xử công minh,"
  },
  {
    "id": 23306,
    "book": "psalms                                  ",
    "chapter": "35",
    "verse": "25",
    "text": "Đừng để họ nói rằng: “Hay quá, việc xảy ra như ta ao ước!"
  },
  {
    "id": 23307,
    "book": "psalms                                  ",
    "chapter": "35",
    "verse": "26",
    "text": "Nguyện những ai vui mừng khi con khốn đốn"
  },
  {
    "id": 23308,
    "book": "psalms                                  ",
    "chapter": "35",
    "verse": "27",
    "text": "Những ai mong con được minh oan,"
  },
  {
    "id": 23309,
    "book": "psalms                                  ",
    "chapter": "35",
    "verse": "28",
    "text": "Lưỡi con sẽ nói về đức công chính của Chúa,"
  }
]