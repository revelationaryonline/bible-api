[
  {
    "id": 24113,
    "book": "psalms                                  ",
    "chapter": "83",
    "verse": "1",
    "text": "Lạy Đức Chúa Trời, xin đừng nín lặng!"
  },
  {
    "id": 24114,
    "book": "psalms                                  ",
    "chapter": "83",
    "verse": "2",
    "text": "Chẳng lẽ Ngài không nghe tiếng quân thù nổi loạn?"
  },
  {
    "id": 24115,
    "book": "psalms                                  ",
    "chapter": "83",
    "verse": "3",
    "text": "Họ âm mưu lập kế diệt dân Ngài;"
  },
  {
    "id": 24116,
    "book": "psalms                                  ",
    "chapter": "83",
    "verse": "4",
    "text": "Họ nói: “Hãy đến tiêu diệt nước này,"
  },
  {
    "id": 24117,
    "book": "psalms                                  ",
    "chapter": "83",
    "verse": "5",
    "text": "Họ đồng thanh chấp thuận kế hoạch."
  },
  {
    "id": 24118,
    "book": "psalms                                  ",
    "chapter": "83",
    "verse": "6",
    "text": "dân tộc Ê-đôm và các sắc dân Ích-ma-ên;"
  },
  {
    "id": 24119,
    "book": "psalms                                  ",
    "chapter": "83",
    "verse": "7",
    "text": "người Ghê-banh, Am-môn, và A-ma-léc;"
  },
  {
    "id": 24120,
    "book": "psalms                                  ",
    "chapter": "83",
    "verse": "8",
    "text": "A-sy-ri cũng gia nhập liên minh,"
  },
  {
    "id": 24121,
    "book": "psalms                                  ",
    "chapter": "83",
    "verse": "9",
    "text": "Xin Chúa phạt họ như dân tộc Ma-đi-an,"
  },
  {
    "id": 24122,
    "book": "psalms                                  ",
    "chapter": "83",
    "verse": "10",
    "text": "Là đoàn quân bị tiêu diệt tại Ên-đô-rơ,"
  },
  {
    "id": 24123,
    "book": "psalms                                  ",
    "chapter": "83",
    "verse": "11",
    "text": "Xin đối xử với các quý tộc của họ như Ô-rép và Xê-ép."
  },
  {
    "id": 24124,
    "book": "psalms                                  ",
    "chapter": "83",
    "verse": "12",
    "text": "vì họ nói: “Chúng ta hãy chiếm đất cỏ xanh của Đức Chúa Trời"
  },
  {
    "id": 24125,
    "book": "psalms                                  ",
    "chapter": "83",
    "verse": "13",
    "text": "Lạy Đức Chúa Trời, xin làm họ như cỏ rác,"
  },
  {
    "id": 24126,
    "book": "psalms                                  ",
    "chapter": "83",
    "verse": "14",
    "text": "Như lửa đốt trụi rừng"
  },
  {
    "id": 24127,
    "book": "psalms                                  ",
    "chapter": "83",
    "verse": "15",
    "text": "thì xin phóng bão tố đánh đuổi họ,"
  },
  {
    "id": 24128,
    "book": "psalms                                  ",
    "chapter": "83",
    "verse": "16",
    "text": "Xin Chúa cho mặt họ bị sỉ nhục,"
  },
  {
    "id": 24129,
    "book": "psalms                                  ",
    "chapter": "83",
    "verse": "17",
    "text": "Nguyện họ bị hổ thẹn và kinh hoàng mãi mãi."
  },
  {
    "id": 24130,
    "book": "psalms                                  ",
    "chapter": "83",
    "verse": "18",
    "text": "Xin cho họ học biết chỉ có Ngài là Chúa Hằng Hữu,"
  }
]