[
  {
    "id": 22990,
    "book": "psalms                                  ",
    "chapter": "18",
    "verse": "1",
    "text": "Chúa Hằng Hữu là nguồn năng lực,"
  },
  {
    "id": 22991,
    "book": "psalms                                  ",
    "chapter": "18",
    "verse": "2",
    "text": "Chúa Hằng Hữu là vầng đá và đồn lũy tôi, Đấng giải cứu tôi;"
  },
  {
    "id": 22992,
    "book": "psalms                                  ",
    "chapter": "18",
    "verse": "3",
    "text": "Con kêu cầu Chúa Hằng Hữu, Đấng đáng ca ngợi,"
  },
  {
    "id": 22993,
    "book": "psalms                                  ",
    "chapter": "18",
    "verse": "4",
    "text": "Dây tử vong đã quấn lấy con;"
  },
  {
    "id": 22994,
    "book": "psalms                                  ",
    "chapter": "18",
    "verse": "5",
    "text": "Âm phủ thắt chặt dây oan nghiệt;"
  },
  {
    "id": 22995,
    "book": "psalms                                  ",
    "chapter": "18",
    "verse": "6",
    "text": "Trong lúc hiểm nguy, con kêu cầu Chúa Hằng Hữu;"
  },
  {
    "id": 22996,
    "book": "psalms                                  ",
    "chapter": "18",
    "verse": "7",
    "text": "Bỗng nhiên đất động và rung chuyển."
  },
  {
    "id": 22997,
    "book": "psalms                                  ",
    "chapter": "18",
    "verse": "8",
    "text": "Từ mũi Chúa, khói bay;"
  },
  {
    "id": 22998,
    "book": "psalms                                  ",
    "chapter": "18",
    "verse": "9",
    "text": "Chúa rẽ trời ngự giá;"
  },
  {
    "id": 22999,
    "book": "psalms                                  ",
    "chapter": "18",
    "verse": "10",
    "text": "Ngài cỡi chê-ru-bim và bay,"
  },
  {
    "id": 23000,
    "book": "psalms                                  ",
    "chapter": "18",
    "verse": "11",
    "text": "Ngài lấy bóng tối làm màn bao quanh,"
  },
  {
    "id": 23001,
    "book": "psalms                                  ",
    "chapter": "18",
    "verse": "12",
    "text": "Bỗng nhiên, mặt Chúa chiếu hào quang rực rỡ"
  },
  {
    "id": 23002,
    "book": "psalms                                  ",
    "chapter": "18",
    "verse": "13",
    "text": "Chúa Hằng Hữu cho sấm sét rền trời;"
  },
  {
    "id": 23003,
    "book": "psalms                                  ",
    "chapter": "18",
    "verse": "14",
    "text": "Chúa bắn tên, quân thù tán loạn;"
  },
  {
    "id": 23004,
    "book": "psalms                                  ",
    "chapter": "18",
    "verse": "15",
    "text": "Đáy biển lộ ra,"
  },
  {
    "id": 23005,
    "book": "psalms                                  ",
    "chapter": "18",
    "verse": "16",
    "text": "Chúa xuống từ trời cao;"
  },
  {
    "id": 23006,
    "book": "psalms                                  ",
    "chapter": "18",
    "verse": "17",
    "text": "Giải thoát con khỏi kẻ thù cường bạo,"
  },
  {
    "id": 23007,
    "book": "psalms                                  ",
    "chapter": "18",
    "verse": "18",
    "text": "Chúng tấn công con trong ngày gian truân,"
  },
  {
    "id": 23008,
    "book": "psalms                                  ",
    "chapter": "18",
    "verse": "19",
    "text": "Chúa đem con vào chỗ khoảng khoát;"
  },
  {
    "id": 23009,
    "book": "psalms                                  ",
    "chapter": "18",
    "verse": "20",
    "text": "Chúa Hằng Hữu đối đãi với con theo đức công chính,"
  },
  {
    "id": 23010,
    "book": "psalms                                  ",
    "chapter": "18",
    "verse": "21",
    "text": "Con tuân hành hết cả điều răn,"
  },
  {
    "id": 23011,
    "book": "psalms                                  ",
    "chapter": "18",
    "verse": "22",
    "text": "Luật lệ Chúa hằng ở trước mặt con,"
  },
  {
    "id": 23012,
    "book": "psalms                                  ",
    "chapter": "18",
    "verse": "23",
    "text": "Trước mặt Đức Chúa Trời, con chẳng gì đáng trách;"
  },
  {
    "id": 23013,
    "book": "psalms                                  ",
    "chapter": "18",
    "verse": "24",
    "text": "Chúa Hằng Hữu đối đãi với con theo đức công chính,"
  },
  {
    "id": 23014,
    "book": "psalms                                  ",
    "chapter": "18",
    "verse": "25",
    "text": "Chúa thành tín đối với ai trung tín,"
  },
  {
    "id": 23015,
    "book": "psalms                                  ",
    "chapter": "18",
    "verse": "26",
    "text": "Chúa thánh sạch đối với ai trong trắng,"
  },
  {
    "id": 23016,
    "book": "psalms                                  ",
    "chapter": "18",
    "verse": "27",
    "text": "Chúa cứu vớt những người khiêm tốn,"
  },
  {
    "id": 23017,
    "book": "psalms                                  ",
    "chapter": "18",
    "verse": "28",
    "text": "Xin cho đèn con sáng mãi,"
  },
  {
    "id": 23018,
    "book": "psalms                                  ",
    "chapter": "18",
    "verse": "29",
    "text": "Nhờ sức Chúa, con dẹp tan quân địch;"
  },
  {
    "id": 23019,
    "book": "psalms                                  ",
    "chapter": "18",
    "verse": "30",
    "text": "Đức Chúa Trời thật muôn phần hoàn hảo."
  },
  {
    "id": 23020,
    "book": "psalms                                  ",
    "chapter": "18",
    "verse": "31",
    "text": "Ngoài Chúa Hằng Hữu, ai là Đức Chúa Trời?"
  },
  {
    "id": 23021,
    "book": "psalms                                  ",
    "chapter": "18",
    "verse": "32",
    "text": "Đức Chúa Trời trang bị cho con năng lực,"
  },
  {
    "id": 23022,
    "book": "psalms                                  ",
    "chapter": "18",
    "verse": "33",
    "text": "Chân con nhanh nhẹn như chân nai,"
  },
  {
    "id": 23023,
    "book": "psalms                                  ",
    "chapter": "18",
    "verse": "34",
    "text": "Chúa luyện tay con chinh chiến,"
  },
  {
    "id": 23024,
    "book": "psalms                                  ",
    "chapter": "18",
    "verse": "35",
    "text": "Chúa trao con tấm khiên cứu rỗi,"
  },
  {
    "id": 23025,
    "book": "psalms                                  ",
    "chapter": "18",
    "verse": "36",
    "text": "Trước chân con, Chúa mở con đường,"
  },
  {
    "id": 23026,
    "book": "psalms                                  ",
    "chapter": "18",
    "verse": "37",
    "text": "Con đuổi theo bắt kịp quân thù;"
  },
  {
    "id": 23027,
    "book": "psalms                                  ",
    "chapter": "18",
    "verse": "38",
    "text": "Con đánh chúng đến khi ngưng đứng dậy;"
  },
  {
    "id": 23028,
    "book": "psalms                                  ",
    "chapter": "18",
    "verse": "39",
    "text": "Chúa trang bị con sức mạnh cho chiến trận,"
  },
  {
    "id": 23029,
    "book": "psalms                                  ",
    "chapter": "18",
    "verse": "40",
    "text": "Chúa khiến địch quay lưng trốn chạy,"
  },
  {
    "id": 23030,
    "book": "psalms                                  ",
    "chapter": "18",
    "verse": "41",
    "text": "Họ van xin, không ai tiếp cứu,"
  },
  {
    "id": 23031,
    "book": "psalms                                  ",
    "chapter": "18",
    "verse": "42",
    "text": "Con nghiền nát chúng ra như bụi,"
  },
  {
    "id": 23032,
    "book": "psalms                                  ",
    "chapter": "18",
    "verse": "43",
    "text": "Chúa cứu con khỏi sự công kích của con người,"
  },
  {
    "id": 23033,
    "book": "psalms                                  ",
    "chapter": "18",
    "verse": "44",
    "text": "Vừa nghe tiếng con họ vội vàng quy phục,"
  },
  {
    "id": 23034,
    "book": "psalms                                  ",
    "chapter": "18",
    "verse": "45",
    "text": "Chúng mất hết tinh thần, sức lực"
  },
  {
    "id": 23035,
    "book": "psalms                                  ",
    "chapter": "18",
    "verse": "46",
    "text": "Chúa Hằng Hữu hằng sống! Ngợi tôn Vầng Đá của con!"
  },
  {
    "id": 23036,
    "book": "psalms                                  ",
    "chapter": "18",
    "verse": "47",
    "text": "Ngài là Đấng công minh báo oán cho con."
  },
  {
    "id": 23037,
    "book": "psalms                                  ",
    "chapter": "18",
    "verse": "48",
    "text": "Cứu thoát con khỏi tay quân địch,"
  },
  {
    "id": 23038,
    "book": "psalms                                  ",
    "chapter": "18",
    "verse": "49",
    "text": "Chính vì thế, con hằng ca ngợi,"
  },
  {
    "id": 23039,
    "book": "psalms                                  ",
    "chapter": "18",
    "verse": "50",
    "text": "Chúa ban cho vua chiến thắng lớn lao"
  }
]