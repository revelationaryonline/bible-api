[
  {
    "id": 25135,
    "book": "psalms                                  ",
    "chapter": "140",
    "verse": "1",
    "text": "Cúi lạy Chúa Hằng Hữu, xin cứu con khỏi bọn gian ác."
  },
  {
    "id": 25136,
    "book": "psalms                                  ",
    "chapter": "140",
    "verse": "2",
    "text": "là những người mưu toan việc ác"
  },
  {
    "id": 25137,
    "book": "psalms                                  ",
    "chapter": "140",
    "verse": "3",
    "text": "Lưỡi họ nhọn như lưỡi rắn;"
  },
  {
    "id": 25138,
    "book": "psalms                                  ",
    "chapter": "140",
    "verse": "4",
    "text": "Lạy Chúa Hằng Hữu, xin gìn giữ con khỏi tay người ác."
  },
  {
    "id": 25139,
    "book": "psalms                                  ",
    "chapter": "140",
    "verse": "5",
    "text": "Bọn kiêu ngạo đặt bẫy bắt con;"
  },
  {
    "id": 25140,
    "book": "psalms                                  ",
    "chapter": "140",
    "verse": "6",
    "text": "Con thưa với Chúa Hằng Hữu: “Ngài là Đức Chúa Trời con!”"
  },
  {
    "id": 25141,
    "book": "psalms                                  ",
    "chapter": "140",
    "verse": "7",
    "text": "Lạy Chúa Hằng Hữu Chí Cao, là năng lực cứu rỗi con,"
  },
  {
    "id": 25142,
    "book": "psalms                                  ",
    "chapter": "140",
    "verse": "8",
    "text": "Lạy Chúa Hằng Hữu, xin đừng cho mưu mô người ác thành tựu."
  },
  {
    "id": 25143,
    "book": "psalms                                  ",
    "chapter": "140",
    "verse": "9",
    "text": "Nguyện kẻ thù con bị tiêu diệt"
  },
  {
    "id": 25144,
    "book": "psalms                                  ",
    "chapter": "140",
    "verse": "10",
    "text": "Xin cho than hồng rơi trên họ."
  },
  {
    "id": 25145,
    "book": "psalms                                  ",
    "chapter": "140",
    "verse": "11",
    "text": "Xin đừng để người nói lời độc hại sống trong đất chúng con."
  },
  {
    "id": 25146,
    "book": "psalms                                  ",
    "chapter": "140",
    "verse": "12",
    "text": "Con biết Chúa Hằng Hữu sẽ biện hộ cho người khốn cùng;"
  },
  {
    "id": 25147,
    "book": "psalms                                  ",
    "chapter": "140",
    "verse": "13",
    "text": "Người công chính sẽ cảm tạ Danh Chúa;"
  }
]