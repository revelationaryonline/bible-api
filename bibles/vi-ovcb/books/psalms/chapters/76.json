[
  {
    "id": 23953,
    "book": "psalms                                  ",
    "chapter": "76",
    "verse": "1",
    "text": "Trong Giu-đa người dân biết Đức Chúa Trời;"
  },
  {
    "id": 23954,
    "book": "psalms                                  ",
    "chapter": "76",
    "verse": "2",
    "text": "Sa-lem là nơi Chúa ngự;"
  },
  {
    "id": 23955,
    "book": "psalms                                  ",
    "chapter": "76",
    "verse": "3",
    "text": "Tại đó, Chúa bẻ gãy mũi tên quân thù,"
  },
  {
    "id": 23956,
    "book": "psalms                                  ",
    "chapter": "76",
    "verse": "4",
    "text": "Chúa rực rỡ vinh quang và oai nghi"
  },
  {
    "id": 23957,
    "book": "psalms                                  ",
    "chapter": "76",
    "verse": "5",
    "text": "Người dũng mãnh nhất cũng tàn sát."
  },
  {
    "id": 23958,
    "book": "psalms                                  ",
    "chapter": "76",
    "verse": "6",
    "text": "Lạy Đức Chúa Trời của Gia-cốp, khi Ngài quở trách"
  },
  {
    "id": 23959,
    "book": "psalms                                  ",
    "chapter": "76",
    "verse": "7",
    "text": "Chỉ mình Chúa thật đáng kính sợ!"
  },
  {
    "id": 23960,
    "book": "psalms                                  ",
    "chapter": "76",
    "verse": "8",
    "text": "Từ tầng trời xanh thẳm Chúa tuyên án;"
  },
  {
    "id": 23961,
    "book": "psalms                                  ",
    "chapter": "76",
    "verse": "9",
    "text": "Ngài đứng dậy phán xét ác nhân, ôi Đức Chúa Trời,"
  },
  {
    "id": 23962,
    "book": "psalms                                  ",
    "chapter": "76",
    "verse": "10",
    "text": "Cơn giận của loài người chỉ thêm chúc tụng Chúa,"
  },
  {
    "id": 23963,
    "book": "psalms                                  ",
    "chapter": "76",
    "verse": "11",
    "text": "Hãy hứa nguyện và giữ lời với Chúa Hằng Hữu, Đức Chúa Trời ngươi."
  },
  {
    "id": 23964,
    "book": "psalms                                  ",
    "chapter": "76",
    "verse": "12",
    "text": "Vì Ngài phá vỡ khí thế của các bậc cầm quyền,"
  }
]