[
  {
    "id": 23848,
    "book": "psalms                                  ",
    "chapter": "71",
    "verse": "1",
    "text": "Lạy Chúa Hằng Hữu, con hoàn toàn nương cậy Chúa;"
  },
  {
    "id": 23849,
    "book": "psalms                                  ",
    "chapter": "71",
    "verse": "2",
    "text": "Xin cứu con và giải thoát con"
  },
  {
    "id": 23850,
    "book": "psalms                                  ",
    "chapter": "71",
    "verse": "3",
    "text": "Nguyện Chúa làm vầng đá che chở"
  },
  {
    "id": 23851,
    "book": "psalms                                  ",
    "chapter": "71",
    "verse": "4",
    "text": "Lạy Đức Chúa Trời, xin giải thoát con"
  },
  {
    "id": 23852,
    "book": "psalms                                  ",
    "chapter": "71",
    "verse": "5",
    "text": "Lạy Chúa, chỉ có Ngài là nguồn hy vọng của con."
  },
  {
    "id": 23853,
    "book": "psalms                                  ",
    "chapter": "71",
    "verse": "6",
    "text": "Con nương cậy Ngài từ giờ phút lọt lòng;"
  },
  {
    "id": 23854,
    "book": "psalms                                  ",
    "chapter": "71",
    "verse": "7",
    "text": "Nhiều người kinh ngạc khi nhìn vào đời sống phước hạnh của con,"
  },
  {
    "id": 23855,
    "book": "psalms                                  ",
    "chapter": "71",
    "verse": "8",
    "text": "Suốt ngày, miệng con ca ngợi,"
  },
  {
    "id": 23856,
    "book": "psalms                                  ",
    "chapter": "71",
    "verse": "9",
    "text": "Xin Chúa đừng bỏ con trong tuổi già."
  },
  {
    "id": 23857,
    "book": "psalms                                  ",
    "chapter": "71",
    "verse": "10",
    "text": "Vì kẻ thù rỉ tai nói xấu."
  },
  {
    "id": 23858,
    "book": "psalms                                  ",
    "chapter": "71",
    "verse": "11",
    "text": "Họ bảo nhau: “Đức Chúa Trời bỏ hắn rồi."
  },
  {
    "id": 23859,
    "book": "psalms                                  ",
    "chapter": "71",
    "verse": "12",
    "text": "Lạy Đức Chúa Trời, xin đừng xa con,"
  },
  {
    "id": 23860,
    "book": "psalms                                  ",
    "chapter": "71",
    "verse": "13",
    "text": "Kẻ thù con hổ thẹn, tiêu tan,"
  },
  {
    "id": 23861,
    "book": "psalms                                  ",
    "chapter": "71",
    "verse": "14",
    "text": "Hy vọng con lại càng tươi sáng"
  },
  {
    "id": 23862,
    "book": "psalms                                  ",
    "chapter": "71",
    "verse": "15",
    "text": "Hằng ngày thuật71:15 Miệng tôi thuật những điều công chính"
  },
  {
    "id": 23863,
    "book": "psalms                                  ",
    "chapter": "71",
    "verse": "16",
    "text": "Con sẽ loan báo việc quyền năng, lạy Chúa Hằng Hữu Chí Cao."
  },
  {
    "id": 23864,
    "book": "psalms                                  ",
    "chapter": "71",
    "verse": "17",
    "text": "Lạy Đức Chúa Trời, Ngài dạy con từ tuổi ấu thơ,"
  },
  {
    "id": 23865,
    "book": "psalms                                  ",
    "chapter": "71",
    "verse": "18",
    "text": "Chúa ơi, xin đừng bỏ con khi tóc bạc,"
  },
  {
    "id": 23866,
    "book": "psalms                                  ",
    "chapter": "71",
    "verse": "19",
    "text": "Lạy Đức Chúa Trời, Đấng chí công chí thánh"
  },
  {
    "id": 23867,
    "book": "psalms                                  ",
    "chapter": "71",
    "verse": "20",
    "text": "Chúa đã đưa chúng con qua nhiều gian khổ,"
  },
  {
    "id": 23868,
    "book": "psalms                                  ",
    "chapter": "71",
    "verse": "21",
    "text": "Chúa sẽ cho con thêm vinh dự,"
  },
  {
    "id": 23869,
    "book": "psalms                                  ",
    "chapter": "71",
    "verse": "22",
    "text": "Lạy Chúa, con sẽ gảy đàn hạc ca ngợi Chúa,"
  },
  {
    "id": 23870,
    "book": "psalms                                  ",
    "chapter": "71",
    "verse": "23",
    "text": "Linh hồn được cứu chuộc sẽ mở môi"
  },
  {
    "id": 23871,
    "book": "psalms                                  ",
    "chapter": "71",
    "verse": "24",
    "text": "Suốt ngày, con thuật việc công minh"
  }
]