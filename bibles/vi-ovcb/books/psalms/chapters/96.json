[
  {
    "id": 24337,
    "book": "psalms                                  ",
    "chapter": "96",
    "verse": "1",
    "text": "Hãy dâng lên Chúa Hằng Hữu một bài ca mới!"
  },
  {
    "id": 24338,
    "book": "psalms                                  ",
    "chapter": "96",
    "verse": "2",
    "text": "Hãy ngợi ca Chúa Hằng Hữu, chúc tụng Danh Ngài."
  },
  {
    "id": 24339,
    "book": "psalms                                  ",
    "chapter": "96",
    "verse": "3",
    "text": "Tuyên dương vinh quang Ngài giữa các nước."
  },
  {
    "id": 24340,
    "book": "psalms                                  ",
    "chapter": "96",
    "verse": "4",
    "text": "Vĩ đại thay Chúa Hằng Hữu! Ngài là Đấng đáng ca tụng bật nhất!"
  },
  {
    "id": 24341,
    "book": "psalms                                  ",
    "chapter": "96",
    "verse": "5",
    "text": "Thần của các dân khác chỉ là hình tượng,"
  },
  {
    "id": 24342,
    "book": "psalms                                  ",
    "chapter": "96",
    "verse": "6",
    "text": "Vinh dự và uy nghiêm tỏa ra trước Chúa;"
  },
  {
    "id": 24343,
    "book": "psalms                                  ",
    "chapter": "96",
    "verse": "7",
    "text": "Hỡi các dân trên thế giới, hãy công nhận Chúa Hằng Hữu;"
  },
  {
    "id": 24344,
    "book": "psalms                                  ",
    "chapter": "96",
    "verse": "8",
    "text": "Hãy dâng lên Chúa Hằng Hữu vinh quang tuyệt đối!96:8 Ctd xứng đáng cho Danh Ngài"
  },
  {
    "id": 24345,
    "book": "psalms                                  ",
    "chapter": "96",
    "verse": "9",
    "text": "Hãy thờ phượng Chúa Hằng Hữu trong hào quang thánh."
  },
  {
    "id": 24346,
    "book": "psalms                                  ",
    "chapter": "96",
    "verse": "10",
    "text": "Hãy nói với các dân tộc: “Chúa Hằng Hữu tể trị!”"
  },
  {
    "id": 24347,
    "book": "psalms                                  ",
    "chapter": "96",
    "verse": "11",
    "text": "Hỡi tầng trời hãy vui mừng, hỡi đất hãy hớn hở!"
  },
  {
    "id": 24348,
    "book": "psalms                                  ",
    "chapter": "96",
    "verse": "12",
    "text": "Hỡi đồng xanh với các mọi vật trong đó cùng nhảy múa!"
  },
  {
    "id": 24349,
    "book": "psalms                                  ",
    "chapter": "96",
    "verse": "13",
    "text": "trước mặt Chúa Hằng Hữu, vì Ngài đang đến!"
  }
]