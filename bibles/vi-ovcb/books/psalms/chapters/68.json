[
  {
    "id": 23772,
    "book": "psalms                                  ",
    "chapter": "68",
    "verse": "1",
    "text": "Xin Đức Chúa Trời vùng dậy, đánh tan thù nghịch."
  },
  {
    "id": 23773,
    "book": "psalms                                  ",
    "chapter": "68",
    "verse": "2",
    "text": "Xin thổi họ lan như làn khói."
  },
  {
    "id": 23774,
    "book": "psalms                                  ",
    "chapter": "68",
    "verse": "3",
    "text": "Nhưng xin cho người công chính vui mừng."
  },
  {
    "id": 23775,
    "book": "psalms                                  ",
    "chapter": "68",
    "verse": "4",
    "text": "Hãy ngợi tôn Đức Chúa Trời và chúc tụng Danh Chúa,"
  },
  {
    "id": 23776,
    "book": "psalms                                  ",
    "chapter": "68",
    "verse": "5",
    "text": "Đức Chúa Trời ngự trong nơi thánh,"
  },
  {
    "id": 23777,
    "book": "psalms                                  ",
    "chapter": "68",
    "verse": "6",
    "text": "Đức Chúa Trời là nơi cho người cô đơn có tổ ấm gia đình;"
  },
  {
    "id": 23778,
    "book": "psalms                                  ",
    "chapter": "68",
    "verse": "7",
    "text": "Lạy Đức Chúa Trời, khi Chúa dắt dân Ngài ra khỏi Ai Cập,"
  },
  {
    "id": 23779,
    "book": "psalms                                  ",
    "chapter": "68",
    "verse": "8",
    "text": "thì đất động, mưa to như thác đổ"
  },
  {
    "id": 23780,
    "book": "psalms                                  ",
    "chapter": "68",
    "verse": "9",
    "text": "Chúa đã cho mưa dồi dào, lạy Đức Chúa Trời,"
  },
  {
    "id": 23781,
    "book": "psalms                                  ",
    "chapter": "68",
    "verse": "10",
    "text": "Dân Chúa tìm được nơi an định,"
  },
  {
    "id": 23782,
    "book": "psalms                                  ",
    "chapter": "68",
    "verse": "11",
    "text": "Chúa ra lệnh, vô số người tuân phục,"
  },
  {
    "id": 23783,
    "book": "psalms                                  ",
    "chapter": "68",
    "verse": "12",
    "text": "Các vua chúa và tướng lãnh đều bỏ chạy,"
  },
  {
    "id": 23784,
    "book": "psalms                                  ",
    "chapter": "68",
    "verse": "13",
    "text": "Khi họ an nghỉ giữa chuồng chiên,"
  },
  {
    "id": 23785,
    "book": "psalms                                  ",
    "chapter": "68",
    "verse": "14",
    "text": "Khi Đấng Toàn Năng đánh tan các vua,"
  },
  {
    "id": 23786,
    "book": "psalms                                  ",
    "chapter": "68",
    "verse": "15",
    "text": "Hỡi các dãy núi Ba-san hùng vĩ,"
  },
  {
    "id": 23787,
    "book": "psalms                                  ",
    "chapter": "68",
    "verse": "16",
    "text": "Sao ngươi nổi cơn ghen tị, hỡi các núi ghồ ghề,"
  },
  {
    "id": 23788,
    "book": "psalms                                  ",
    "chapter": "68",
    "verse": "17",
    "text": "Số chiến xa của Chúa nhiều hằng nghìn, hằng vạn,"
  },
  {
    "id": 23789,
    "book": "psalms                                  ",
    "chapter": "68",
    "verse": "18",
    "text": "Chúa đã lên nơi cao,"
  },
  {
    "id": 23790,
    "book": "psalms                                  ",
    "chapter": "68",
    "verse": "19",
    "text": "Ngợi tôn Chúa; chúc tụng Đức Chúa Trời, Đấng Cứu Độ chúng con!"
  },
  {
    "id": 23791,
    "book": "psalms                                  ",
    "chapter": "68",
    "verse": "20",
    "text": "Đức Chúa Trời chúng con là Đức Chúa Trời Cứu Rỗi!"
  },
  {
    "id": 23792,
    "book": "psalms                                  ",
    "chapter": "68",
    "verse": "21",
    "text": "Đức Chúa Trời giẫm nát đầu kẻ thù,"
  },
  {
    "id": 23793,
    "book": "psalms                                  ",
    "chapter": "68",
    "verse": "22",
    "text": "Chúa phán: “Ta sẽ đem dân Ta trở về"
  },
  {
    "id": 23794,
    "book": "psalms                                  ",
    "chapter": "68",
    "verse": "23",
    "text": "Các con, dân Ta, sẽ rửa chân mình trong máu quân thù,"
  },
  {
    "id": 23795,
    "book": "psalms                                  ",
    "chapter": "68",
    "verse": "24",
    "text": "Họ đã thấy Chúa uy nghi diễu hành, lạy Đức Chúa Trời,"
  },
  {
    "id": 23796,
    "book": "psalms                                  ",
    "chapter": "68",
    "verse": "25",
    "text": "Ban hợp ca đi trước, theo sau là các dàn nhạc;"
  },
  {
    "id": 23797,
    "book": "psalms                                  ",
    "chapter": "68",
    "verse": "26",
    "text": "Hãy chúc tụng Đức Chúa Trời, hỡi toàn dân Ít-ra-ên;"
  },
  {
    "id": 23798,
    "book": "psalms                                  ",
    "chapter": "68",
    "verse": "27",
    "text": "Kìa, đại tộc nhỏ nhất Bên-gia-min đi trước."
  },
  {
    "id": 23799,
    "book": "psalms                                  ",
    "chapter": "68",
    "verse": "28",
    "text": "Lạy Đức Chúa Trời, xin triệu tập lực lượng."
  },
  {
    "id": 23800,
    "book": "psalms                                  ",
    "chapter": "68",
    "verse": "29",
    "text": "Vì Đền Thờ của Chúa đặt tại Giê-ru-sa-lem,"
  },
  {
    "id": 23801,
    "book": "psalms                                  ",
    "chapter": "68",
    "verse": "30",
    "text": "Xin quở trách đội quân các nước—"
  },
  {
    "id": 23802,
    "book": "psalms                                  ",
    "chapter": "68",
    "verse": "31",
    "text": "Những phái đoàn sẽ đến từ Ai Cập;"
  },
  {
    "id": 23803,
    "book": "psalms                                  ",
    "chapter": "68",
    "verse": "32",
    "text": "Hãy ngợi tôn Đức Chúa Trời, hỡi các vương triều trên đất."
  },
  {
    "id": 23804,
    "book": "psalms                                  ",
    "chapter": "68",
    "verse": "33",
    "text": "Ngài cưỡi trên các tầng trời từ vạn cổ,"
  },
  {
    "id": 23805,
    "book": "psalms                                  ",
    "chapter": "68",
    "verse": "34",
    "text": "Hãy rao ra quyền năng của Đức Chúa Trời."
  },
  {
    "id": 23806,
    "book": "psalms                                  ",
    "chapter": "68",
    "verse": "35",
    "text": "Đức Chúa Trời thật đáng kính sợ trong nơi thánh."
  }
]