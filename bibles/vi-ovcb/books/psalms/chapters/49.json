[
  {
    "id": 23520,
    "book": "psalms                                  ",
    "chapter": "49",
    "verse": "1",
    "text": "Hãy nghe đây, tất cả các dân tộc!"
  },
  {
    "id": 23521,
    "book": "psalms                                  ",
    "chapter": "49",
    "verse": "2",
    "text": "Người sang hay hèn,"
  },
  {
    "id": 23522,
    "book": "psalms                                  ",
    "chapter": "49",
    "verse": "3",
    "text": "Miệng tôi sẽ nói lời khôn ngoan,49:3 Nt tri thức"
  },
  {
    "id": 23523,
    "book": "psalms                                  ",
    "chapter": "49",
    "verse": "4",
    "text": "Tôi sẽ lắng tai nghe nhiều châm ngôn,"
  },
  {
    "id": 23524,
    "book": "psalms                                  ",
    "chapter": "49",
    "verse": "5",
    "text": "Tại sao ta còn sợ ngày tai nạn"
  },
  {
    "id": 23525,
    "book": "psalms                                  ",
    "chapter": "49",
    "verse": "6",
    "text": "Họ là người đặt lòng tin nơi của cải mình"
  },
  {
    "id": 23526,
    "book": "psalms                                  ",
    "chapter": "49",
    "verse": "7",
    "text": "Không ai chuộc được sinh mạng của người khác,"
  },
  {
    "id": 23527,
    "book": "psalms                                  ",
    "chapter": "49",
    "verse": "8",
    "text": "Tiền chuộc mạng quá đắt,"
  },
  {
    "id": 23528,
    "book": "psalms                                  ",
    "chapter": "49",
    "verse": "9",
    "text": "để người ấy được sống mãi mãi,"
  },
  {
    "id": 23529,
    "book": "psalms                                  ",
    "chapter": "49",
    "verse": "10",
    "text": "Con người sẽ nhận thấy người khôn chết,"
  },
  {
    "id": 23530,
    "book": "psalms                                  ",
    "chapter": "49",
    "verse": "11",
    "text": "Mồ mả sẽ là nhà ở của họ mãi mãi,"
  },
  {
    "id": 23531,
    "book": "psalms                                  ",
    "chapter": "49",
    "verse": "12",
    "text": "nhưng con người, dù vinh hoa cũng chẳng lâu dài."
  },
  {
    "id": 23532,
    "book": "psalms                                  ",
    "chapter": "49",
    "verse": "13",
    "text": "Đó là số phận của những người tự phụ,"
  },
  {
    "id": 23533,
    "book": "psalms                                  ",
    "chapter": "49",
    "verse": "14",
    "text": "Họ như đàn chiên bị định xuống âm phủ,49:14 Nt thêm: và ngu ngốc"
  },
  {
    "id": 23534,
    "book": "psalms                                  ",
    "chapter": "49",
    "verse": "15",
    "text": "Nhưng, Đức Chúa Trời sẽ chuộc linh hồn tôi khỏi âm phủ."
  },
  {
    "id": 23535,
    "book": "psalms                                  ",
    "chapter": "49",
    "verse": "16",
    "text": "Đừng kinh sợ khi một người trở nên giàu có"
  },
  {
    "id": 23536,
    "book": "psalms                                  ",
    "chapter": "49",
    "verse": "17",
    "text": "Vì khi người ấy xuôi tay nhắm mắt, chẳng đem theo được gì."
  },
  {
    "id": 23537,
    "book": "psalms                                  ",
    "chapter": "49",
    "verse": "18",
    "text": "Dù khi còn sống tự coi mình là hạnh phúc,"
  },
  {
    "id": 23538,
    "book": "psalms                                  ",
    "chapter": "49",
    "verse": "19",
    "text": "Nhưng người sẽ về với các thế hệ đi trước"
  },
  {
    "id": 23539,
    "book": "psalms                                  ",
    "chapter": "49",
    "verse": "20",
    "text": "Người được vinh hoa, lại thiếu hiểu biết;"
  }
]