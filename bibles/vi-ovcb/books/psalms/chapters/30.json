[
  {
    "id": 23191,
    "book": "psalms                                  ",
    "chapter": "30",
    "verse": "1",
    "text": "Con tôn vinh Chúa Hằng Hữu, vì Ngài nâng con lên."
  },
  {
    "id": 23192,
    "book": "psalms                                  ",
    "chapter": "30",
    "verse": "2",
    "text": "Lạy Chúa Hằng Hữu, Đức Chúa Trời con, con kêu cầu Chúa,"
  },
  {
    "id": 23193,
    "book": "psalms                                  ",
    "chapter": "30",
    "verse": "3",
    "text": "Chúa đã đem con lên khỏi âm phủ, lạy Chúa Hằng Hữu."
  },
  {
    "id": 23194,
    "book": "psalms                                  ",
    "chapter": "30",
    "verse": "4",
    "text": "Các thánh ơi, hãy ngợi ca Chúa Hằng Hữu!"
  },
  {
    "id": 23195,
    "book": "psalms                                  ",
    "chapter": "30",
    "verse": "5",
    "text": "Chúa chỉ giận con trong giây phút,"
  },
  {
    "id": 23196,
    "book": "psalms                                  ",
    "chapter": "30",
    "verse": "6",
    "text": "Lúc hưng thịnh, tâm con tự nhủ:"
  },
  {
    "id": 23197,
    "book": "psalms                                  ",
    "chapter": "30",
    "verse": "7",
    "text": "Nhưng, nhờ ơn Chúa, núi con mới vững bền,"
  },
  {
    "id": 23198,
    "book": "psalms                                  ",
    "chapter": "30",
    "verse": "8",
    "text": "Con kêu xin Chúa, lạy Chúa Hằng Hữu."
  },
  {
    "id": 23199,
    "book": "psalms                                  ",
    "chapter": "30",
    "verse": "9",
    "text": "“Để con chết, ích gì cho Chúa,"
  },
  {
    "id": 23200,
    "book": "psalms                                  ",
    "chapter": "30",
    "verse": "10",
    "text": "Xin nghe con, lạy Chúa Hằng Hữu, thương xót con."
  },
  {
    "id": 23201,
    "book": "psalms                                  ",
    "chapter": "30",
    "verse": "11",
    "text": "Từ sầu muộn, Chúa cho con nhảy nhót."
  },
  {
    "id": 23202,
    "book": "psalms                                  ",
    "chapter": "30",
    "verse": "12",
    "text": "nên con ngợi tôn Ngài, không thể câm nín."
  }
]