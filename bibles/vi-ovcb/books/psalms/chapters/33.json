[
  {
    "id": 23238,
    "book": "psalms                                  ",
    "chapter": "33",
    "verse": "1",
    "text": "Người công chính, hãy hân hoan trong Chúa Hằng Hữu;"
  },
  {
    "id": 23239,
    "book": "psalms                                  ",
    "chapter": "33",
    "verse": "2",
    "text": "Hãy ca ngợi Chúa bằng đàn hạc;"
  },
  {
    "id": 23240,
    "book": "psalms                                  ",
    "chapter": "33",
    "verse": "3",
    "text": "Hãy hát cho Chúa một bài ca mới;"
  },
  {
    "id": 23241,
    "book": "psalms                                  ",
    "chapter": "33",
    "verse": "4",
    "text": "Vì lời Chúa Hằng Hữu là chân lý,33:4 Nt đúng"
  },
  {
    "id": 23242,
    "book": "psalms                                  ",
    "chapter": "33",
    "verse": "5",
    "text": "Chúa ưa điều công minh chính đáng;"
  },
  {
    "id": 23243,
    "book": "psalms                                  ",
    "chapter": "33",
    "verse": "6",
    "text": "Lời Chúa Hằng Hữu sáng lập vũ trụ,"
  },
  {
    "id": 23244,
    "book": "psalms                                  ",
    "chapter": "33",
    "verse": "7",
    "text": "Ngài góp nước thành đại dương,"
  },
  {
    "id": 23245,
    "book": "psalms                                  ",
    "chapter": "33",
    "verse": "8",
    "text": "Cả thế giới hãy kính sợ Chúa Hằng Hữu,"
  },
  {
    "id": 23246,
    "book": "psalms                                  ",
    "chapter": "33",
    "verse": "9",
    "text": "Chúa phán, vũ trụ liền xuất hiện!"
  },
  {
    "id": 23247,
    "book": "psalms                                  ",
    "chapter": "33",
    "verse": "10",
    "text": "Chúa Hằng Hữu phá hỏng kế hoạch các nước,"
  },
  {
    "id": 23248,
    "book": "psalms                                  ",
    "chapter": "33",
    "verse": "11",
    "text": "Nhưng kế hoạch Chúa Hằng Hữu tồn tại mãi mãi;"
  },
  {
    "id": 23249,
    "book": "psalms                                  ",
    "chapter": "33",
    "verse": "12",
    "text": "Phước cho nước nào tôn Đức Chúa Trời là Chúa Hằng Hữu,"
  },
  {
    "id": 23250,
    "book": "psalms                                  ",
    "chapter": "33",
    "verse": "13",
    "text": "Chúa Hằng Hữu từ trời nhìn xuống"
  },
  {
    "id": 23251,
    "book": "psalms                                  ",
    "chapter": "33",
    "verse": "14",
    "text": "Từ ngai Chúa ngự Ngài quan sát"
  },
  {
    "id": 23252,
    "book": "psalms                                  ",
    "chapter": "33",
    "verse": "15",
    "text": "Chúa tạo linh hồn nhân loại,"
  },
  {
    "id": 23253,
    "book": "psalms                                  ",
    "chapter": "33",
    "verse": "16",
    "text": "Không vua nào nhờ binh hùng tướng mạnh mà thắng trận;"
  },
  {
    "id": 23254,
    "book": "psalms                                  ",
    "chapter": "33",
    "verse": "17",
    "text": "Lúc lâm nguy chiến mã thành vô dụng—"
  },
  {
    "id": 23255,
    "book": "psalms                                  ",
    "chapter": "33",
    "verse": "18",
    "text": "Nhưng mắt Chúa Hằng Hữu nhìn người tin kính"
  },
  {
    "id": 23256,
    "book": "psalms                                  ",
    "chapter": "33",
    "verse": "19",
    "text": "Chúa giải thoát họ khỏi chết"
  },
  {
    "id": 23257,
    "book": "psalms                                  ",
    "chapter": "33",
    "verse": "20",
    "text": "Chúng con trông đợi Chúa Hằng Hữu."
  },
  {
    "id": 23258,
    "book": "psalms                                  ",
    "chapter": "33",
    "verse": "21",
    "text": "Lòng chúng con hân hoan trong Chúa,"
  },
  {
    "id": 23259,
    "book": "psalms                                  ",
    "chapter": "33",
    "verse": "22",
    "text": "Nguyện tình thương Chúa Hằng Hữu bao phủ chúng con,"
  }
]