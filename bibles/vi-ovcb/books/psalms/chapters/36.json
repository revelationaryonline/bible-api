[
  {
    "id": 23310,
    "book": "psalms                                  ",
    "chapter": "36",
    "verse": "1",
    "text": "Một lời nói trong lòng tôi về tội lỗi của người ác rằng:"
  },
  {
    "id": 23311,
    "book": "psalms                                  ",
    "chapter": "36",
    "verse": "2",
    "text": "Nó chỉ lo tâng bốc bản thân,"
  },
  {
    "id": 23312,
    "book": "psalms                                  ",
    "chapter": "36",
    "verse": "3",
    "text": "Miệng lưỡi nó đầy lời xảo trá,"
  },
  {
    "id": 23313,
    "book": "psalms                                  ",
    "chapter": "36",
    "verse": "4",
    "text": "Nằm trên giường tính toan điều ác,"
  },
  {
    "id": 23314,
    "book": "psalms                                  ",
    "chapter": "36",
    "verse": "5",
    "text": "Chúa Hằng Hữu ôi, lượng nhân từ bao la trời biển;"
  },
  {
    "id": 23315,
    "book": "psalms                                  ",
    "chapter": "36",
    "verse": "6",
    "text": "Đức công chính sừng sững non cao,"
  },
  {
    "id": 23316,
    "book": "psalms                                  ",
    "chapter": "36",
    "verse": "7",
    "text": "Lòng nhân từ Chúa quý biết bao, ôi Đức Chúa Trời!"
  },
  {
    "id": 23317,
    "book": "psalms                                  ",
    "chapter": "36",
    "verse": "8",
    "text": "Được thỏa mãn thức ăn dư dật trong nhà Chúa,"
  },
  {
    "id": 23318,
    "book": "psalms                                  ",
    "chapter": "36",
    "verse": "9",
    "text": "Vì Chúa chính là nguồn sống"
  },
  {
    "id": 23319,
    "book": "psalms                                  ",
    "chapter": "36",
    "verse": "10",
    "text": "Xin cứ thương yêu người biết Chúa;"
  },
  {
    "id": 23320,
    "book": "psalms                                  ",
    "chapter": "36",
    "verse": "11",
    "text": "Xin đừng cho người kiêu ngạo giẫm chân con"
  },
  {
    "id": 23321,
    "book": "psalms                                  ",
    "chapter": "36",
    "verse": "12",
    "text": "Kìa! Người làm ác ngã rạp!"
  }
]