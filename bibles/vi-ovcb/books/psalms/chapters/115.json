[
  {
    "id": 24702,
    "book": "psalms                                  ",
    "chapter": "115",
    "verse": "1",
    "text": "Lạy Chúa Hằng Hữu, không thuộc về chúng con,"
  },
  {
    "id": 24703,
    "book": "psalms                                  ",
    "chapter": "115",
    "verse": "2",
    "text": "Sao các dân tộc hỏi nhau:"
  },
  {
    "id": 24704,
    "book": "psalms                                  ",
    "chapter": "115",
    "verse": "3",
    "text": "Đức Chúa Trời chúng con ngự trên trời,"
  },
  {
    "id": 24705,
    "book": "psalms                                  ",
    "chapter": "115",
    "verse": "4",
    "text": "Còn thần chúng nó bằng bạc vàng,"
  },
  {
    "id": 24706,
    "book": "psalms                                  ",
    "chapter": "115",
    "verse": "5",
    "text": "Có miệng không nói năng,"
  },
  {
    "id": 24707,
    "book": "psalms                                  ",
    "chapter": "115",
    "verse": "6",
    "text": "Có tai nhưng không nghe được,"
  },
  {
    "id": 24708,
    "book": "psalms                                  ",
    "chapter": "115",
    "verse": "7",
    "text": "Tay lạnh lùng vô giác,"
  },
  {
    "id": 24709,
    "book": "psalms                                  ",
    "chapter": "115",
    "verse": "8",
    "text": "Người tạo ra hình tượng và người thờ tà thần"
  },
  {
    "id": 24710,
    "book": "psalms                                  ",
    "chapter": "115",
    "verse": "9",
    "text": "Ít-ra-ên, khá tin cậy Chúa Hằng Hữu!"
  },
  {
    "id": 24711,
    "book": "psalms                                  ",
    "chapter": "115",
    "verse": "10",
    "text": "Nhà A-rôn, hãy tin cậy Chúa Hằng Hữu!"
  },
  {
    "id": 24712,
    "book": "psalms                                  ",
    "chapter": "115",
    "verse": "11",
    "text": "Những ai kính sợ Chúa Hằng Hữu, hãy tin cậy Chúa Hằng Hữu!"
  },
  {
    "id": 24713,
    "book": "psalms                                  ",
    "chapter": "115",
    "verse": "12",
    "text": "Chúa Hằng Hữu ghi nhớ chúng ta và ban phước dồi dào."
  },
  {
    "id": 24714,
    "book": "psalms                                  ",
    "chapter": "115",
    "verse": "13",
    "text": "Chúa sẽ ban phước cho người kính sợ Chúa Hằng Hữu,"
  },
  {
    "id": 24715,
    "book": "psalms                                  ",
    "chapter": "115",
    "verse": "14",
    "text": "Nguyện cầu Chúa Hằng Hữu ban phước"
  },
  {
    "id": 24716,
    "book": "psalms                                  ",
    "chapter": "115",
    "verse": "15",
    "text": "Nguyện anh chị em được hưởng phước Chúa ban,"
  },
  {
    "id": 24717,
    "book": "psalms                                  ",
    "chapter": "115",
    "verse": "16",
    "text": "Trời thuộc về Chúa Hằng Hữu,"
  },
  {
    "id": 24718,
    "book": "psalms                                  ",
    "chapter": "115",
    "verse": "17",
    "text": "Người đã chết làm sao ca tụng Chúa Hằng Hữu,"
  },
  {
    "id": 24719,
    "book": "psalms                                  ",
    "chapter": "115",
    "verse": "18",
    "text": "Nhưng chúng con luôn chúc tụng Chúa Hằng Hữu,"
  }
]