[
  {
    "id": 24741,
    "book": "psalms                                  ",
    "chapter": "118",
    "verse": "1",
    "text": "Hãy cảm tạ Chúa Hằng Hữu, vì Ngài là thiện!"
  },
  {
    "id": 24742,
    "book": "psalms                                  ",
    "chapter": "118",
    "verse": "2",
    "text": "Hỡi nhà Ít-ra-ên hãy xưng tụng:"
  },
  {
    "id": 24743,
    "book": "psalms                                  ",
    "chapter": "118",
    "verse": "3",
    "text": "Hỡi con cháu A-rôn, thầy tế lễ, hãy tung hô:"
  },
  {
    "id": 24744,
    "book": "psalms                                  ",
    "chapter": "118",
    "verse": "4",
    "text": "Hỡi những người kính sợ Chúa, hãy đồng thanh:"
  },
  {
    "id": 24745,
    "book": "psalms                                  ",
    "chapter": "118",
    "verse": "5",
    "text": "Trong tuyệt vọng, tôi kêu cầu Chúa Hằng Hữu,"
  },
  {
    "id": 24746,
    "book": "psalms                                  ",
    "chapter": "118",
    "verse": "6",
    "text": "Chúa Hằng Hữu đứng với tôi, tôi không sợ hãi?"
  },
  {
    "id": 24747,
    "book": "psalms                                  ",
    "chapter": "118",
    "verse": "7",
    "text": "Phải, Chúa Hằng Hữu đứng bên; Ngài cứu giúp tôi."
  },
  {
    "id": 24748,
    "book": "psalms                                  ",
    "chapter": "118",
    "verse": "8",
    "text": "Thà ẩn náu trong Chúa Hằng Hữu"
  },
  {
    "id": 24749,
    "book": "psalms                                  ",
    "chapter": "118",
    "verse": "9",
    "text": "Nương thân trong Chúa Hằng Hữu"
  },
  {
    "id": 24750,
    "book": "psalms                                  ",
    "chapter": "118",
    "verse": "10",
    "text": "Các dân tộc bao vây tôi tràn ngập,"
  },
  {
    "id": 24751,
    "book": "psalms                                  ",
    "chapter": "118",
    "verse": "11",
    "text": "Họ tiến quân vây chặt quanh tôi,"
  },
  {
    "id": 24752,
    "book": "psalms                                  ",
    "chapter": "118",
    "verse": "12",
    "text": "Họ vây tôi như ong vỡ tổ;"
  },
  {
    "id": 24753,
    "book": "psalms                                  ",
    "chapter": "118",
    "verse": "13",
    "text": "Người ta đặt cạm bẫy cho tôi vấp ngã,"
  },
  {
    "id": 24754,
    "book": "psalms                                  ",
    "chapter": "118",
    "verse": "14",
    "text": "Chúa Hằng Hữu là nguồn sinh lực và bài ca của tôi;"
  },
  {
    "id": 24755,
    "book": "psalms                                  ",
    "chapter": "118",
    "verse": "15",
    "text": "Bài hát vui mừng và chiến thắng vang dội trong trại người công chính."
  },
  {
    "id": 24756,
    "book": "psalms                                  ",
    "chapter": "118",
    "verse": "16",
    "text": "Tay Chúa Hằng Hữu đưa cao làm việc lớn."
  },
  {
    "id": 24757,
    "book": "psalms                                  ",
    "chapter": "118",
    "verse": "17",
    "text": "Tôi không chết; nhưng còn sống mạnh,"
  },
  {
    "id": 24758,
    "book": "psalms                                  ",
    "chapter": "118",
    "verse": "18",
    "text": "Chúa Hằng Hữu trừng phạt tôi nặng biết bao,"
  },
  {
    "id": 24759,
    "book": "psalms                                  ",
    "chapter": "118",
    "verse": "19",
    "text": "Cửa công chính xin hãy mở ra,"
  },
  {
    "id": 24760,
    "book": "psalms                                  ",
    "chapter": "118",
    "verse": "20",
    "text": "Các cửa này dẫn vào nơi Chúa Hằng Hữu ngự,"
  },
  {
    "id": 24761,
    "book": "psalms                                  ",
    "chapter": "118",
    "verse": "21",
    "text": "Lạy Chúa, con cảm tạ Chúa vô cùng"
  },
  {
    "id": 24762,
    "book": "psalms                                  ",
    "chapter": "118",
    "verse": "22",
    "text": "Tảng Đá bị thợ nề loại bỏ,"
  },
  {
    "id": 24763,
    "book": "psalms                                  ",
    "chapter": "118",
    "verse": "23",
    "text": "Chỉ có Chúa Hằng Hữu làm việc ấy,"
  },
  {
    "id": 24764,
    "book": "psalms                                  ",
    "chapter": "118",
    "verse": "24",
    "text": "Đây là ngày Chúa Hằng Hữu tạo nên."
  },
  {
    "id": 24765,
    "book": "psalms                                  ",
    "chapter": "118",
    "verse": "25",
    "text": "Lạy Chúa Hằng Hữu, con xin Ngài giải cứu."
  },
  {
    "id": 24766,
    "book": "psalms                                  ",
    "chapter": "118",
    "verse": "26",
    "text": "Phước hạnh cho người đến trong Danh Chúa Hằng Hữu."
  },
  {
    "id": 24767,
    "book": "psalms                                  ",
    "chapter": "118",
    "verse": "27",
    "text": "Chúa Hằng Hữu là Đức Chúa Trời, soi sáng chúng con."
  },
  {
    "id": 24768,
    "book": "psalms                                  ",
    "chapter": "118",
    "verse": "28",
    "text": "Ngài là Đức Chúa Trời của con, con sẽ ngợi tôn Ngài!"
  },
  {
    "id": 24769,
    "book": "psalms                                  ",
    "chapter": "118",
    "verse": "29",
    "text": "Hãy cảm tạ Chúa Hằng Hữu, vì Ngài là thiện!"
  }
]