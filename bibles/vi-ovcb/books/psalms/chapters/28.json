[
  {
    "id": 23171,
    "book": "psalms                                  ",
    "chapter": "28",
    "verse": "1",
    "text": "Con kêu cầu Ngài, lạy Chúa Hằng Hữu, Vầng Đá của con."
  },
  {
    "id": 23172,
    "book": "psalms                                  ",
    "chapter": "28",
    "verse": "2",
    "text": "Xin vì lòng thương xót nghe lời cầu nguyện con,"
  },
  {
    "id": 23173,
    "book": "psalms                                  ",
    "chapter": "28",
    "verse": "3",
    "text": "Xin đừng phạt con chung với kẻ dữ—"
  },
  {
    "id": 23174,
    "book": "psalms                                  ",
    "chapter": "28",
    "verse": "4",
    "text": "Xin Chúa phạt họ theo hành vi của họ!"
  },
  {
    "id": 23175,
    "book": "psalms                                  ",
    "chapter": "28",
    "verse": "5",
    "text": "Vì họ chẳng quan tâm đến công việc Chúa Hằng Hữu,"
  },
  {
    "id": 23176,
    "book": "psalms                                  ",
    "chapter": "28",
    "verse": "6",
    "text": "Ngợi ca Chúa Hằng Hữu!"
