[
  {
    "id": 24675,
    "book": "psalms                                  ",
    "chapter": "112",
    "verse": "1",
    "text": "Ngợi tôn Chúa Hằng Hữu!"
  },
  {
    "id": 24676,
    "book": "psalms                                  ",
    "chapter": "112",
    "verse": "2",
    "text": "Hạt giống người gieo nứt mầm mạnh mẽ;"
  },
  {
    "id": 24677,
    "book": "psalms                                  ",
    "chapter": "112",
    "verse": "3",
    "text": "Nhà người tích lũy nhiều của cải,"
  },
  {
    "id": 24678,
    "book": "psalms                                  ",
    "chapter": "112",
    "verse": "4",
    "text": "Ánh sáng soi đường giữa tối tăm."
  },
  {
    "id": 24679,
    "book": "psalms                                  ",
    "chapter": "112",
    "verse": "5",
    "text": "Có lòng hào phóng, sẵn lòng cho mượn"
  },
  {
    "id": 24680,
    "book": "psalms                                  ",
    "chapter": "112",
    "verse": "6",
    "text": "Người chẳng bao giờ rúng động."
  },
  {
    "id": 24681,
    "book": "psalms                                  ",
    "chapter": "112",
    "verse": "7",
    "text": "Người không sợ tiếng đồn, tin dữ;"
  },
  {
    "id": 24682,
    "book": "psalms                                  ",
    "chapter": "112",
    "verse": "8",
    "text": "Người kiên tâm và không sợ hãi"
  },
  {
    "id": 24683,
    "book": "psalms                                  ",
    "chapter": "112",
    "verse": "9",
    "text": "Người phân chia của cải, cứu tế người có cần."
  },
  {
    "id": 24684,
    "book": "psalms                                  ",
    "chapter": "112",
    "verse": "10",
    "text": "Bọn gian ác thấy thế liền thất vọng."
  }
]