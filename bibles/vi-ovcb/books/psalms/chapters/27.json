[
  {
    "id": 23157,
    "book": "psalms                                  ",
    "chapter": "27",
    "verse": "1",
    "text": "Chúa Hằng Hữu là ánh sáng và cứu tinh của tôi—"
  },
  {
    "id": 23158,
    "book": "psalms                                  ",
    "chapter": "27",
    "verse": "2",
    "text": "Khi người ác xông vào tôi, hòng ăn nuốt tôi,"
  },
  {
    "id": 23159,
    "book": "psalms                                  ",
    "chapter": "27",
    "verse": "3",
    "text": "Dù cả đạo quân vây quanh tôi,"
  },
  {
    "id": 23160,
    "book": "psalms                                  ",
    "chapter": "27",
    "verse": "4",
    "text": "Tôi xin Chúa Hằng Hữu một điều—"
  },
  {
    "id": 23161,
    "book": "psalms                                  ",
    "chapter": "27",
    "verse": "5",
    "text": "Trong ngày hoạn nạn, Chúa sẽ che chở tôi,"
  },
  {
    "id": 23162,
    "book": "psalms                                  ",
    "chapter": "27",
    "verse": "6",
    "text": "Đầu tôi được nâng cao hơn kẻ thù,"
  },
  {
    "id": 23163,
    "book": "psalms                                  ",
    "chapter": "27",
    "verse": "7",
    "text": "Lạy Chúa Hằng Hữu ôi, xin nghe con kêu cầu."
  },
  {
    "id": 23164,
    "book": "psalms                                  ",
    "chapter": "27",
    "verse": "8",
    "text": "Con đã nghe Chúa phán: “Hãy đến và trò chuyện cùng Ta.”"
  },
  {
    "id": 23165,
    "book": "psalms                                  ",
    "chapter": "27",
    "verse": "9",
    "text": "Lạy Chúa, Đấng cứu rỗi của con!"
  },
  {
    "id": 23166,
    "book": "psalms                                  ",
    "chapter": "27",
    "verse": "10",
    "text": "Cho dù cha mẹ con giận bỏ, từ khước con,"
  },
  {
    "id": 23167,
    "book": "psalms                                  ",
    "chapter": "27",
    "verse": "11",
    "text": "Chúa Hằng Hữu ôi, xin dạy con đường lối Chúa,"
  },
  {
    "id": 23168,
    "book": "psalms                                  ",
    "chapter": "27",
    "verse": "12",
    "text": "Xin đừng giao con cho họ."
  },
  {
    "id": 23169,
    "book": "psalms                                  ",
    "chapter": "27",
    "verse": "13",
    "text": "Con tin chắc sẽ thấy ân lành của Chúa Hằng Hữu,"
  },
  {
    "id": 23170,
    "book": "psalms                                  ",
    "chapter": "27",
    "verse": "14",
    "text": "Cứ trông đợi Chúa Hằng Hữu."
  }
]