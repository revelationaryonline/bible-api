[
  {
    "id": 22857,
    "book": "psalms                                  ",
    "chapter": "6",
    "verse": "1",
    "text": "Chúa Hằng Hữu ôi, xin đừng quở trách con khi Chúa giận,"
  },
  {
    "id": 22858,
    "book": "psalms                                  ",
    "chapter": "6",
    "verse": "2",
    "text": "Xin xót thương con, lạy Chúa Hằng Hữu, vì con kiệt sức."
  },
  {
    "id": 22859,
    "book": "psalms                                  ",
    "chapter": "6",
    "verse": "3",
    "text": "Linh hồn con vô cùng bối rối."
  },
  {
    "id": 22860,
    "book": "psalms                                  ",
    "chapter": "6",
    "verse": "4",
    "text": "Xin trở lại, lạy Chúa Hằng Hữu, và đưa tay giải thoát con."
  },
  {
    "id": 22861,
    "book": "psalms                                  ",
    "chapter": "6",
    "verse": "5",
    "text": "Người đã chết làm sao nhớ Chúa."
  },
  {
    "id": 22862,
    "book": "psalms                                  ",
    "chapter": "6",
    "verse": "6",
    "text": "Con mòn mỏi vì than thở."
  },
  {
    "id": 22863,
    "book": "psalms                                  ",
    "chapter": "6",
    "verse": "7",
    "text": "Mắt mờ lòa vì sầu muộn khôn nguôi;"
  },
  {
    "id": 22864,
    "book": "psalms                                  ",
    "chapter": "6",
    "verse": "8",
    "text": "Hãy lìa xa, hỡi người gian ác,"
  },
  {
    "id": 22865,
    "book": "psalms                                  ",
    "chapter": "6",
    "verse": "9",
    "text": "Ta kêu xin, Chúa Hằng Hữu nhậm lời,"
  },
  {
    "id": 22866,
    "book": "psalms                                  ",
    "chapter": "6",
    "verse": "10",
    "text": "Nguyện kẻ thù tôi bị sỉ nhục và ruồng bỏ."
  }
]