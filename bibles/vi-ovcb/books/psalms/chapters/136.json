[
  {
    "id": 25068,
    "book": "psalms                                  ",
    "chapter": "136",
    "verse": "1",
    "text": "Hãy cảm tạ Chúa Hằng Hữu vì Ngài là thiện!"
  },
  {
    "id": 25069,
    "book": "psalms                                  ",
    "chapter": "136",
    "verse": "2",
    "text": "Hãy cảm tạ Đức Chúa Trời của các thần."
  },
  {
    "id": 25070,
    "book": "psalms                                  ",
    "chapter": "136",
    "verse": "3",
    "text": "Hãy cảm tạ Chúa của các chúa."
  },
  {
    "id": 25071,
    "book": "psalms                                  ",
    "chapter": "136",
    "verse": "4",
    "text": "Chỉ một mình Chúa làm phép lạ vĩ đại."
  },
  {
    "id": 25072,
    "book": "psalms                                  ",
    "chapter": "136",
    "verse": "5",
    "text": "Với óc khôn ngoan, Chúa sáng tạo bầu trời."
  },
  {
    "id": 25073,
    "book": "psalms                                  ",
    "chapter": "136",
    "verse": "6",
    "text": "Chúa trải đất ra bên biển cả."
  },
  {
    "id": 25074,
    "book": "psalms                                  ",
    "chapter": "136",
    "verse": "7",
    "text": "Chúa làm ra các thể sáng vĩ đại."
  },
  {
    "id": 25075,
    "book": "psalms                                  ",
    "chapter": "136",
    "verse": "8",
    "text": "Mặt trời cai quản ban ngày."
  },
  {
    "id": 25076,
    "book": "psalms                                  ",
    "chapter": "136",
    "verse": "9",
    "text": "Mặt trăng cai quản ban đêm."
  },
  {
    "id": 25077,
    "book": "psalms                                  ",
    "chapter": "136",
    "verse": "10",
    "text": "Chúa đánh giết con đầu lòng Ai Cập."
  },
  {
    "id": 25078,
    "book": "psalms                                  ",
    "chapter": "136",
    "verse": "11",
    "text": "Chúa giải thoát dân chúng Ít-ra-ên."
  },
  {
    "id": 25079,
    "book": "psalms                                  ",
    "chapter": "136",
    "verse": "12",
    "text": "Do cánh tay mạnh mẽ quyền năng của Ngài."
  },
  {
    "id": 25080,
    "book": "psalms                                  ",
    "chapter": "136",
    "verse": "13",
    "text": "Chúa chia Biển Đỏ làm đôi."
  },
  {
    "id": 25081,
    "book": "psalms                                  ",
    "chapter": "136",
    "verse": "14",
    "text": "Cho dân chúng Ít-ra-ên đi ngang qua."
  },
  {
    "id": 25082,
    "book": "psalms                                  ",
    "chapter": "136",
    "verse": "15",
    "text": "Xua Pha-ra-ôn và đạo quân xuống Biển Đỏ."
  },
  {
    "id": 25083,
    "book": "psalms                                  ",
    "chapter": "136",
    "verse": "16",
    "text": "Chúa đưa dân Ngài qua hoang mạc."
  },
  {
    "id": 25084,
    "book": "psalms                                  ",
    "chapter": "136",
    "verse": "17",
    "text": "Chúa đánh hạ các vua lớn."
  },
  {
    "id": 25085,
    "book": "psalms                                  ",
    "chapter": "136",
    "verse": "18",
    "text": "Chúa giết các vua danh tiếng."
  },
  {
    "id": 25086,
    "book": "psalms                                  ",
    "chapter": "136",
    "verse": "19",
    "text": "Si-hôn vua người A-mô-rít."
  },
  {
    "id": 25087,
    "book": "psalms                                  ",
    "chapter": "136",
    "verse": "20",
    "text": "Và Óc vua Ba-san."
  },
  {
    "id": 25088,
    "book": "psalms                                  ",
    "chapter": "136",
    "verse": "21",
    "text": "Chúa ban lãnh thổ họ làm cơ nghiệp."
  },
  {
    "id": 25089,
    "book": "psalms                                  ",
    "chapter": "136",
    "verse": "22",
    "text": "Cơ nghiệp cho Ít-ra-ên, đầy tớ Ngài."
  },
  {
    "id": 25090,
    "book": "psalms                                  ",
    "chapter": "136",
    "verse": "23",
    "text": "Chúa nhớ chúng con trong cảnh khốn cùng."
  },
  {
    "id": 25091,
    "book": "psalms                                  ",
    "chapter": "136",
    "verse": "24",
    "text": "Ngài giải cứu chúng con khỏi kẻ thù."
  },
  {
    "id": 25092,
    "book": "psalms                                  ",
    "chapter": "136",
    "verse": "25",
    "text": "Chúa ban lương thực cho mọi sinh vật."
  },
  {
    "id": 25093,
    "book": "psalms                                  ",
    "chapter": "136",
    "verse": "26",
    "text": "Hãy cảm tạ Đức Chúa Trời trên trời."
  }
]