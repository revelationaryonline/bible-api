[
  {
    "id": 24658,
    "book": "psalms                                  ",
    "chapter": "110",
    "verse": "1",
    "text": "Chúa Hằng Hữu đã phán về Chúa của con rằng:"
  },
  {
    "id": 24659,
    "book": "psalms                                  ",
    "chapter": "110",
    "verse": "2",
    "text": "Từ Si-ôn Chúa Hằng Hữu sẽ đưa đến quyền trượng sức mạnh cho Chúa."
  },
  {
    "id": 24660,
    "book": "psalms                                  ",
    "chapter": "110",
    "verse": "3",
    "text": "Đến ngày Chúa biểu dương quyền bính trên núi thánh,"
  },
  {
    "id": 24661,
    "book": "psalms                                  ",
    "chapter": "110",
    "verse": "4",
    "text": "Chúa Hằng Hữu đã thề hứa và sẽ không đổi ý rằng:"
  },
  {
    "id": 24662,
    "book": "psalms                                  ",
    "chapter": "110",
    "verse": "5",
    "text": "Chúa ngồi bên phải Chúa Hằng Hữu."
  },
  {
    "id": 24663,
    "book": "psalms                                  ",
    "chapter": "110",
    "verse": "6",
    "text": "Chúa sẽ xét đoán các dân"
  },
  {
    "id": 24664,
    "book": "psalms                                  ",
    "chapter": "110",
    "verse": "7",
    "text": "Ngài sẽ uống nước nơi dòng suối bên đường."
  }
]