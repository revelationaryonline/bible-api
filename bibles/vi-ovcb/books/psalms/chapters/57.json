[
  {
    "id": 23640,
    "book": "psalms                                  ",
    "chapter": "57",
    "verse": "1",
    "text": "Xin thương xót con, lạy Đức Chúa Trời, xin Ngài thương xót!"
  },
  {
    "id": 23641,
    "book": "psalms                                  ",
    "chapter": "57",
    "verse": "2",
    "text": "Con kêu van Đức Chúa Trời Chí Cao,"
  },
  {
    "id": 23642,
    "book": "psalms                                  ",
    "chapter": "57",
    "verse": "3",
    "text": "Từ trời Ngài gửi đến sự cứu chuộc,"
  },
  {
    "id": 23643,
    "book": "psalms                                  ",
    "chapter": "57",
    "verse": "4",
    "text": "Linh hồn con lạc vào hang sư tử,"
  },
  {
    "id": 23644,
    "book": "psalms                                  ",
    "chapter": "57",
    "verse": "5",
    "text": "Lạy Đức Chúa Trời, nguyện Ngài được tôn cao hơn các tầng trời!"
  },
  {
    "id": 23645,
    "book": "psalms                                  ",
    "chapter": "57",
    "verse": "6",
    "text": "Họ giăng lưới rình rập vây bắt.57:6 Nt chăng lưới cho bước chân con"
  },
  {
    "id": 23646,
    "book": "psalms                                  ",
    "chapter": "57",
    "verse": "7",
    "text": "Lạy Đức Chúa Trời, lòng con kiên định;"
  },
  {
    "id": 23647,
    "book": "psalms                                  ",
    "chapter": "57",
    "verse": "8",
    "text": "Vùng dậy, hồn ta hỡi!"
  },
  {
    "id": 23648,
    "book": "psalms                                  ",
    "chapter": "57",
    "verse": "9",
    "text": "Lạy Chúa, con sẽ cảm tạ Chúa giữa toàn dân,"
  },
  {
    "id": 23649,
    "book": "psalms                                  ",
    "chapter": "57",
    "verse": "10",
    "text": "Vì lòng thương Ngài cao như các tầng trời;"
  },
  {
    "id": 23650,
    "book": "psalms                                  ",
    "chapter": "57",
    "verse": "11",
    "text": "Lạy Đức Chúa Trời, nguyện Ngài được tôn cao trên các tầng trời."
  }
]