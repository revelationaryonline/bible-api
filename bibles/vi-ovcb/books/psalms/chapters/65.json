[
  {
    "id": 23732,
    "book": "psalms                                  ",
    "chapter": "65",
    "verse": "1",
    "text": "Lạy Đức Chúa Trời, ở Si-ôn người ta mong đợi,"
  },
  {
    "id": 23733,
    "book": "psalms                                  ",
    "chapter": "65",
    "verse": "2",
    "text": "vì Chúa nghe lời cầu nguyện."
  },
  {
    "id": 23734,
    "book": "psalms                                  ",
    "chapter": "65",
    "verse": "3",
    "text": "Khi con bị tội ác chi phối đè bẹp,"
  },
  {
    "id": 23735,
    "book": "psalms                                  ",
    "chapter": "65",
    "verse": "4",
    "text": "Phước cho người được Chúa chọn, cho đến gần,"
  },
  {
    "id": 23736,
    "book": "psalms                                  ",
    "chapter": "65",
    "verse": "5",
    "text": "Chúa nhậm lời, giải cứu chúng con bằng những công việc đáng sợ,"
  },
  {
    "id": 23737,
    "book": "psalms                                  ",
    "chapter": "65",
    "verse": "6",
    "text": "Sức mạnh65:6 Nt sức mạnh Ngài, khi Ngài thắt lưng bằng sức mạnh Chúa lập các núi cao,"
  },
  {
    "id": 23738,
    "book": "psalms                                  ",
    "chapter": "65",
    "verse": "7",
    "text": "Làm im tiếng gào của biển cả"
  },
  {
    "id": 23739,
    "book": "psalms                                  ",
    "chapter": "65",
    "verse": "8",
    "text": "Các dân ở những vùng đất xa xôi,"
  },
  {
    "id": 23740,
    "book": "psalms                                  ",
    "chapter": "65",
    "verse": "9",
    "text": "Chúa viếng thăm, tưới nước địa cầu,"
  },
  {
    "id": 23741,
    "book": "psalms                                  ",
    "chapter": "65",
    "verse": "10",
    "text": "Nhuần gội luống cày, cho đất nhuyễn,"
  },
  {
    "id": 23742,
    "book": "psalms                                  ",
    "chapter": "65",
    "verse": "11",
    "text": "Đức nhân từ Ngài như vương miện"
  },
  {
    "id": 23743,
    "book": "psalms                                  ",
    "chapter": "65",
    "verse": "12",
    "text": "Sương móc nhỏ giọt trên đồng nội,"
  },
  {
    "id": 23744,
    "book": "psalms                                  ",
    "chapter": "65",
    "verse": "13",
    "text": "Bò, chiên phủ khắp trên đồng cỏ,"
  }
]