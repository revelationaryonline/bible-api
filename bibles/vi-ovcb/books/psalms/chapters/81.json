[
  {
    "id": 24089,
    "book": "psalms                                  ",
    "chapter": "81",
    "verse": "1",
    "text": "Hãy ca tụng Đức Chúa Trời, sức mạnh của chúng ta."
  },
  {
    "id": 24090,
    "book": "psalms                                  ",
    "chapter": "81",
    "verse": "2",
    "text": "Hãy hát! Hãy đánh trống cơm."
  },
  {
    "id": 24091,
    "book": "psalms                                  ",
    "chapter": "81",
    "verse": "3",
    "text": "Hãy thổi kèn trong ngày trăng mới,"
  },
  {
    "id": 24092,
    "book": "psalms                                  ",
    "chapter": "81",
    "verse": "4",
    "text": "Đây là một định lễ cho Ít-ra-ên;"
  },
  {
    "id": 24093,
    "book": "psalms                                  ",
    "chapter": "81",
    "verse": "5",
    "text": "Một luật pháp Ngài lập với Giô-sép,"
  },
  {
    "id": 24094,
    "book": "psalms                                  ",
    "chapter": "81",
    "verse": "6",
    "text": "“Ta đã cất gánh nặng khỏi vai các con;"
  },
  {
    "id": 24095,
    "book": "psalms                                  ",
    "chapter": "81",
    "verse": "7",
    "text": "Trong gian truân các con kêu cầu, Ta đã giải cứu;"
  },
  {
    "id": 24096,
    "book": "psalms                                  ",
    "chapter": "81",
    "verse": "8",
    "text": "Hỡi dân Ta, hãy lắng tai nghe lời cảnh cáo."
  },
  {
    "id": 24097,
    "book": "psalms                                  ",
    "chapter": "81",
    "verse": "9",
    "text": "Giữa xứ các con, đừng có tà thần;"
  },
  {
    "id": 24098,
    "book": "psalms                                  ",
    "chapter": "81",
    "verse": "10",
    "text": "Vì Ta là Chúa Hằng Hữu, Đức Chúa Trời của các con,"
  },
  {
    "id": 24099,
    "book": "psalms                                  ",
    "chapter": "81",
    "verse": "11",
    "text": "Nhưng không, dân Ta không chịu nghe."
  },
  {
    "id": 24100,
    "book": "psalms                                  ",
    "chapter": "81",
    "verse": "12",
    "text": "Vì vậy Ta bỏ mặc họ theo lòng chai lì,"
  },
  {
    "id": 24101,
    "book": "psalms                                  ",
    "chapter": "81",
    "verse": "13",
    "text": "Ôi, ước gì dân Ta nghe tiếng Ta!"
  },
  {
    "id": 24102,
    "book": "psalms                                  ",
    "chapter": "81",
    "verse": "14",
    "text": "Ta sẽ nhanh chóng đánh bại quân thù họ!"
  },
  {
    "id": 24103,
    "book": "psalms                                  ",
    "chapter": "81",
    "verse": "15",
    "text": "Những người ghét Chúa Hằng Hữu sẽ thuận phục Ngài;"
  },
  {
    "id": 24104,
    "book": "psalms                                  ",
    "chapter": "81",
    "verse": "16",
    "text": "Ta sẽ nuôi các con bằng lúa thượng hạng."
  }
]