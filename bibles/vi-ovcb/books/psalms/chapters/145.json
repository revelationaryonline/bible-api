[
  {
    "id": 25192,
    "book": "psalms                                  ",
    "chapter": "145",
    "verse": "1",
    "text": "Con sẽ tôn vinh Vua, là Đức Chúa Trời con,"
  },
  {
    "id": 25193,
    "book": "psalms                                  ",
    "chapter": "145",
    "verse": "2",
    "text": "Con sẽ chúc tụng Chúa mỗi ngày;"
  },
  {
    "id": 25194,
    "book": "psalms                                  ",
    "chapter": "145",
    "verse": "3",
    "text": "Chúa Hằng Hữu thật cao cả! Ngài thật đáng tán dương!"
  },
  {
    "id": 25195,
    "book": "psalms                                  ",
    "chapter": "145",
    "verse": "4",
    "text": "Đời này sang đời kia sẽ ca tụng công đức Chúa,"
  },
  {
    "id": 25196,
    "book": "psalms                                  ",
    "chapter": "145",
    "verse": "5",
    "text": "Con sẽ nói về vinh quang Chúa uy nghi rực rỡ,"
  },
  {
    "id": 25197,
    "book": "psalms                                  ",
    "chapter": "145",
    "verse": "6",
    "text": "Người ta sẽ nói về những việc phi thường của Chúa,"
  },
  {
    "id": 25198,
    "book": "psalms                                  ",
    "chapter": "145",
    "verse": "7",
    "text": "Họ sẽ nhắc nhở đức từ ái lớn lao;"
  },
  {
    "id": 25199,
    "book": "psalms                                  ",
    "chapter": "145",
    "verse": "8",
    "text": "Chúa Hằng Hữu ban ơn, giàu lòng thương,"
  },
  {
    "id": 25200,
    "book": "psalms                                  ",
    "chapter": "145",
    "verse": "9",
    "text": "Chúa Hằng Hữu ban phước cho mọi người."
  },
  {
    "id": 25201,
    "book": "psalms                                  ",
    "chapter": "145",
    "verse": "10",
    "text": "Các công việc Chúa sẽ cảm tạ Chúa Hằng Hữu,"
  },
  {
    "id": 25202,
    "book": "psalms                                  ",
    "chapter": "145",
    "verse": "11",
    "text": "Họ sẽ nói về vinh quang vương quốc Chúa;"
  },
  {
    "id": 25203,
    "book": "psalms                                  ",
    "chapter": "145",
    "verse": "12",
    "text": "Để loài người biết năng lực Chúa,"
  },
  {
    "id": 25204,
    "book": "psalms                                  ",
    "chapter": "145",
    "verse": "13",
    "text": "Vương quốc Chúa tồn tại vĩnh cửu."
  },
  {
    "id": 25205,
    "book": "psalms                                  ",
    "chapter": "145",
    "verse": "14",
    "text": "Chúa Hằng Hữu đỡ người ngã,"
  },
  {
    "id": 25206,
    "book": "psalms                                  ",
    "chapter": "145",
    "verse": "15",
    "text": "Mắt muôn loài trông mong Chúa;"
  },
  {
    "id": 25207,
    "book": "psalms                                  ",
    "chapter": "145",
    "verse": "16",
    "text": "Chúa mở rộng tay,"
  },
  {
    "id": 25208,
    "book": "psalms                                  ",
    "chapter": "145",
    "verse": "17",
    "text": "Chúa Hằng Hữu công chính mọi đường,"
  },
  {
    "id": 25209,
    "book": "psalms                                  ",
    "chapter": "145",
    "verse": "18",
    "text": "Chúa Hằng Hữu ở gần người cầu khẩn,"
  },
  {
    "id": 25210,
    "book": "psalms                                  ",
    "chapter": "145",
    "verse": "19",
    "text": "Chúa làm cho những người kính sợ Chúa thỏa nguyện;"
  },
  {
    "id": 25211,
    "book": "psalms                                  ",
    "chapter": "145",
    "verse": "20",
    "text": "Chúa Hằng Hữu bảo vệ người yêu mến Ngài,"
  },
  {
    "id": 25212,
    "book": "psalms                                  ",
    "chapter": "145",
    "verse": "21",
    "text": "Miệng con sẽ ca tụng Chúa Hằng Hữu,"
  }
]