[
  {
    "id": 23397,
    "book": "psalms                                  ",
    "chapter": "40",
    "verse": "1",
    "text": "Tôi kiên nhẫn đợi chờ Chúa Hằng Hữu cứu giúp,"
  },
  {
    "id": 23398,
    "book": "psalms                                  ",
    "chapter": "40",
    "verse": "2",
    "text": "Ngài cứu tôi từ lòng hố diệt vong,"
  },
  {
    "id": 23399,
    "book": "psalms                                  ",
    "chapter": "40",
    "verse": "3",
    "text": "Ngài cho tôi một bài hát mới,"
  },
  {
    "id": 23400,
    "book": "psalms                                  ",
    "chapter": "40",
    "verse": "4",
    "text": "Phước cho người tin cậy Chúa Hằng Hữu,"
  },
  {
    "id": 23401,
    "book": "psalms                                  ",
    "chapter": "40",
    "verse": "5",
    "text": "Lạy Chúa Hằng Hữu, Đức Chúa Trời con, công ơn kỳ diệu vẫn trường tồn."
  },
  {
    "id": 23402,
    "book": "psalms                                  ",
    "chapter": "40",
    "verse": "6",
    "text": "Chúa chẳng thích lễ vật, sinh tế."
  },
  {
    "id": 23403,
    "book": "psalms                                  ",
    "chapter": "40",
    "verse": "7",
    "text": "Con xin xác nhận: “Này, con đến."
  },
  {
    "id": 23404,
    "book": "psalms                                  ",
    "chapter": "40",
    "verse": "8",
    "text": "Lạy Đức Chúa Trời, con hoan hỉ làm theo ý Chúa,"
  },
  {
    "id": 23405,
    "book": "psalms                                  ",
    "chapter": "40",
    "verse": "9",
    "text": "Con đã rao truyền cho dân Chúa về công chính của Ngài."
  },
  {
    "id": 23406,
    "book": "psalms                                  ",
    "chapter": "40",
    "verse": "10",
    "text": "Con không giấu tin mừng của Chúa trong lòng con;40:10 Phúc Âm thiên thượng"
  },
  {
    "id": 23407,
    "book": "psalms                                  ",
    "chapter": "40",
    "verse": "11",
    "text": "Chúa Hằng Hữu, xin tiếp tục thương xót, khoan nhân."
  },
  {
    "id": 23408,
    "book": "psalms                                  ",
    "chapter": "40",
    "verse": "12",
    "text": "Tai họa chung quanh con—"
  },
  {
    "id": 23409,
    "book": "psalms                                  ",
    "chapter": "40",
    "verse": "13",
    "text": "Chúa Hằng Hữu ôi, xin giải thoát con!"
  },
  {
    "id": 23410,
    "book": "psalms                                  ",
    "chapter": "40",
    "verse": "14",
    "text": "Xin cho người săn mạng con"
  },
  {
    "id": 23411,
    "book": "psalms                                  ",
    "chapter": "40",
    "verse": "15",
    "text": "Xin cho họ khiếp đảm vì tủi thẹn,"
  },
  {
    "id": 23412,
    "book": "psalms                                  ",
    "chapter": "40",
    "verse": "16",
    "text": "Nguyện những người tìm kiếm Chúa"
  },
  {
    "id": 23413,
    "book": "psalms                                  ",
    "chapter": "40",
    "verse": "17",
    "text": "Thân phận con nghèo hèn, thiếu thốn,"
  }
