[
  {
    "id": 23563,
    "book": "psalms                                  ",
    "chapter": "51",
    "verse": "1",
    "text": "Lạy Đức Chúa Trời, xin xót thương con,"
  },
  {
    "id": 23564,
    "book": "psalms                                  ",
    "chapter": "51",
    "verse": "2",
    "text": "Xin rửa sạch tì vít gian tà."
  },
  {
    "id": 23565,
    "book": "psalms                                  ",
    "chapter": "51",
    "verse": "3",
    "text": "Con xưng nhận những điều vi phạm,"
  },
  {
    "id": 23566,
    "book": "psalms                                  ",
    "chapter": "51",
    "verse": "4",
    "text": "Con đã phạm tội chống lại một mình Chúa;"
  },
  {
    "id": 23567,
    "book": "psalms                                  ",
    "chapter": "51",
    "verse": "5",
    "text": "Con sinh ra vốn người tội lỗi—"
  },
  {
    "id": 23568,
    "book": "psalms                                  ",
    "chapter": "51",
    "verse": "6",
    "text": "Chúa muốn tâm hồn con chân thật,"
  },
  {
    "id": 23569,
    "book": "psalms                                  ",
    "chapter": "51",
    "verse": "7",
    "text": "Xin tẩy con với chùm kinh giới,"
  },
  {
    "id": 23570,
    "book": "psalms                                  ",
    "chapter": "51",
    "verse": "8",
    "text": "Xin cho con nghe lại tiếng hân hoan;"
  },
  {
    "id": 23571,
    "book": "psalms                                  ",
    "chapter": "51",
    "verse": "9",
    "text": "Xin Chúa ngoảnh mặt khỏi tội con đã phạm."
  },
  {
    "id": 23572,
    "book": "psalms                                  ",
    "chapter": "51",
    "verse": "10",
    "text": "Lạy Đức Chúa Trời, xin dựng trong con tấm lòng trong sạch."
  },
  {
    "id": 23573,
    "book": "psalms                                  ",
    "chapter": "51",
    "verse": "11",
    "text": "Xin đừng loại con khỏi sự hiện diện Chúa,51:11 Nt đừng bỏ con khỏi mặt Ngài"
  },
  {
    "id": 23574,
    "book": "psalms                                  ",
    "chapter": "51",
    "verse": "12",
    "text": "Xin phục hồi niềm vui cứu chuộc cho con,"
  },
  {
    "id": 23575,
    "book": "psalms                                  ",
    "chapter": "51",
    "verse": "13",
    "text": "Khi ấy, con sẽ chỉ đường cho người phản loạn,"
  },
  {
    "id": 23576,
    "book": "psalms                                  ",
    "chapter": "51",
    "verse": "14",
    "text": "Xin tha con tội làm đổ máu, lạy Đức Chúa Trời, Đấng cứu rỗi;"
  },
  {
    "id": 23577,
    "book": "psalms                                  ",
    "chapter": "51",
    "verse": "15",
    "text": "Lạy Chúa, xin mở môi con,"
  },
  {
    "id": 23578,
    "book": "psalms                                  ",
    "chapter": "51",
    "verse": "16",
    "text": "Tế lễ có nghĩa gì với Chúa, dù con dâng hiến mãi."
  },
  {
    "id": 23579,
    "book": "psalms                                  ",
    "chapter": "51",
    "verse": "17",
    "text": "Sinh tế Chúa ưa thích là tâm hồn tan vỡ."
  },
  {
    "id": 23580,
    "book": "psalms                                  ",
    "chapter": "51",
    "verse": "18",
    "text": "Xin vui lòng cho Si-ôn phước hạnh;"
  },
  {
    "id": 23581,
    "book": "psalms                                  ",
    "chapter": "51",
    "verse": "19",
    "text": "Khi ấy, Chúa mới nhậm tế lễ công chính,"
  }
]