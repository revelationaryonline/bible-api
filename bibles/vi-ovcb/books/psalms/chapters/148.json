    "verse": "1",
    "text": "Tán dương Chúa Hằng Hữu!"
  },
  {
    "id": 25244,
    "book": "psalms                                  ",
    "chapter": "148",
    "verse": "2",
    "text": "Tất cả thiên sứ, hãy chúc tụng Chúa!"
  },
  {
    "id": 25245,
    "book": "psalms                                  ",
    "chapter": "148",
    "verse": "3",
    "text": "Mặt trời và mặt trăng, hãy ngợi khen Chúa!"
