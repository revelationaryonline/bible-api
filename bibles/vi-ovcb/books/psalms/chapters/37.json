[
  {
    "id": 23322,
    "book": "psalms                                  ",
    "chapter": "37",
    "verse": "1",
    "text": "Đừng bực tức vì người bất lương"
  },
  {
    "id": 23323,
    "book": "psalms                                  ",
    "chapter": "37",
    "verse": "2",
    "text": "Vì họ sẽ như cỏ héo úa."
  },
  {
    "id": 23324,
    "book": "psalms                                  ",
    "chapter": "37",
    "verse": "3",
    "text": "Hãy tin cậy Chúa Hằng Hữu và làm điều thiện."
  },
  {
    "id": 23325,
    "book": "psalms                                  ",
    "chapter": "37",
    "verse": "4",
    "text": "Hãy vui thỏa trong Chúa Hằng Hữu,"
  },
  {
    "id": 23326,
    "book": "psalms                                  ",
    "chapter": "37",
    "verse": "5",
    "text": "Hãy giao phó mọi việc cho Chúa Hằng Hữu."
  },
  {
    "id": 23327,
    "book": "psalms                                  ",
    "chapter": "37",
    "verse": "6",
    "text": "Ngài sẽ khiến sự công chính ngươi tỏa sáng như rạng đông,"
  },
  {
    "id": 23328,
    "book": "psalms                                  ",
    "chapter": "37",
    "verse": "7",
    "text": "Hãy yên lặng trước Chúa Hằng Hữu,"
  },
  {
    "id": 23329,
    "book": "psalms                                  ",
    "chapter": "37",
    "verse": "8",
    "text": "Hãy kìm hãm cơn nóng nảy!"
  },
  {
    "id": 23330,
    "book": "psalms                                  ",
    "chapter": "37",
    "verse": "9",
    "text": "Vì người ác rồi sẽ bị diệt vong,"
  },
  {
    "id": 23331,
    "book": "psalms                                  ",
    "chapter": "37",
    "verse": "10",
    "text": "Chẳng bao lâu, người ác sẽ biến mất."
  },
  {
    "id": 23332,
    "book": "psalms                                  ",
    "chapter": "37",
    "verse": "11",
    "text": "Nhưng người khiêm nhu sẽ thừa hưởng đất đai"
  },
  {
    "id": 23333,
    "book": "psalms                                  ",
    "chapter": "37",
    "verse": "12",
    "text": "Người ác âm mưu hại người tin kính;"
  },
  {
    "id": 23334,
    "book": "psalms                                  ",
    "chapter": "37",
    "verse": "13",
    "text": "Nhưng Chúa cười nhạo chúng,"
  },
  {
    "id": 23335,
    "book": "psalms                                  ",
    "chapter": "37",
    "verse": "14",
    "text": "Người ác tuốt gươm và giương cung"
  },
  {
    "id": 23336,
    "book": "psalms                                  ",
    "chapter": "37",
    "verse": "15",
    "text": "Nhưng gươm sẽ đâm ngược vào tim họ,"
  },
  {
    "id": 23337,
    "book": "psalms                                  ",
    "chapter": "37",
    "verse": "16",
    "text": "Chút đỉnh tài vật của người tin kính,"
  },
  {
    "id": 23338,
    "book": "psalms                                  ",
    "chapter": "37",
    "verse": "17",
    "text": "Vì tay người ác sẽ gãy nát,"
  },
  {
    "id": 23339,
    "book": "psalms                                  ",
    "chapter": "37",
    "verse": "18",
    "text": "Chúa Hằng Hữu biết số ngày người thiện lành,"
  },
  {
    "id": 23340,
    "book": "psalms                                  ",
    "chapter": "37",
    "verse": "19",
    "text": "Trong ngày tai họa họ không héo hắt;"
  },
  {
    "id": 23341,
    "book": "psalms                                  ",
    "chapter": "37",
    "verse": "20",
    "text": "Nhưng người ác sẽ hư mất."
  },
  {
    "id": 23342,
    "book": "psalms                                  ",
    "chapter": "37",
    "verse": "21",
    "text": "Người ác mượn mà không bao giờ trả,"
  },
  {
    "id": 23343,
    "book": "psalms                                  ",
    "chapter": "37",
    "verse": "22",
    "text": "Ai được Chúa Hằng Hữu ban phước sẽ thừa hưởng đất đai;"
  },
  {
    "id": 23344,
    "book": "psalms                                  ",
    "chapter": "37",
    "verse": "23",
    "text": "Chúa Hằng Hữu xếp đặt bước đi của người tin kính,"
  },
  {
    "id": 23345,
    "book": "psalms                                  ",
    "chapter": "37",
    "verse": "24",
    "text": "Dù vấp chân, họ cũng không té ngã,"
  },
  {
    "id": 23346,
    "book": "psalms                                  ",
    "chapter": "37",
    "verse": "25",
    "text": "Trước kia tôi còn trẻ, nay đến tuổi già."
  },
  {
    "id": 23347,
    "book": "psalms                                  ",
    "chapter": "37",
    "verse": "26",
    "text": "Họ luôn luôn rộng rãi cho vay,"
  },
  {
    "id": 23348,
    "book": "psalms                                  ",
    "chapter": "37",
    "verse": "27",
    "text": "Người bỏ điều ác và làm điều lành,"
  },
  {
    "id": 23349,
    "book": "psalms                                  ",
    "chapter": "37",
    "verse": "28",
    "text": "Vì Chúa Hằng Hữu yêu công lý,"
  },
  {
    "id": 23350,
    "book": "psalms                                  ",
    "chapter": "37",
    "verse": "29",
    "text": "Người tin kính sẽ thừa hưởng đất đai,"
  },
  {
    "id": 23351,
    "book": "psalms                                  ",
    "chapter": "37",
    "verse": "30",
    "text": "Người tin kính nói lời khôn ngoan;"
  },
  {
    "id": 23352,
    "book": "psalms                                  ",
    "chapter": "37",
    "verse": "31",
    "text": "Người gìn giữ luật pháp Đức Chúa Trời trong lòng,"
  },
  {
    "id": 23353,
    "book": "psalms                                  ",
    "chapter": "37",
    "verse": "32",
    "text": "Những người ác rình rập đợi chờ,"
  },
  {
    "id": 23354,
    "book": "psalms                                  ",
    "chapter": "37",
    "verse": "33",
    "text": "Nhưng Chúa Hằng Hữu không để họ được thành công,"
  },
  {
    "id": 23355,
    "book": "psalms                                  ",
    "chapter": "37",
    "verse": "34",
    "text": "Hãy chờ đợi Chúa Hằng Hữu."
  },
  {
    "id": 23356,
    "book": "psalms                                  ",
    "chapter": "37",
    "verse": "35",
    "text": "Ta đã chứng kiến người độc ác, bạo tàn"
  },
  {
    "id": 23357,
    "book": "psalms                                  ",
    "chapter": "37",
    "verse": "36",
    "text": "Nhưng chẳng bao lâu qua đi, không còn nữa!"
  },
  {
    "id": 23358,
    "book": "psalms                                  ",
    "chapter": "37",
    "verse": "37",
    "text": "Hãy nhìn người thiện hảo và ngay lành,"
  },
  {
    "id": 23359,
    "book": "psalms                                  ",
    "chapter": "37",
    "verse": "38",
    "text": "Còn người phạm tội ác cùng nhau bị diệt;"
  },
  {
    "id": 23360,
    "book": "psalms                                  ",
    "chapter": "37",
    "verse": "39",
    "text": "Chúa Hằng Hữu cứu người tin kính;"
  },
  {
    "id": 23361,
    "book": "psalms                                  ",
    "chapter": "37",
    "verse": "40",
    "text": "Chúa Hằng Hữu đưa tay cứu giúp,"
  }
]