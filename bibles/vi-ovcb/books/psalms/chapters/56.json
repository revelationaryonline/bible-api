[
  {
    "id": 23627,
    "book": "psalms                                  ",
    "chapter": "56",
    "verse": "1",
    "text": "Lạy Đức Chúa Trời, xin thương xót con,"
  },
  {
    "id": 23628,
    "book": "psalms                                  ",
    "chapter": "56",
    "verse": "2",
    "text": "Ngày nào họ cũng săn đuổi,"
  },
  {
    "id": 23629,
    "book": "psalms                                  ",
    "chapter": "56",
    "verse": "3",
    "text": "Những khi con sợ hãi,"
  },
  {
    "id": 23630,
    "book": "psalms                                  ",
    "chapter": "56",
    "verse": "4",
    "text": "Con ngợi tôn Đức Chúa Trời vì lời Ngài đã hứa."
  },
  {
    "id": 23631,
    "book": "psalms                                  ",
    "chapter": "56",
    "verse": "5",
    "text": "Suốt ngày họ bắt bẻ từng lời,"
  },
  {
    "id": 23632,
    "book": "psalms                                  ",
    "chapter": "56",
    "verse": "6",
    "text": "Họ luôn họp nhau, rình rập,"
  },
  {
    "id": 23633,
    "book": "psalms                                  ",
    "chapter": "56",
    "verse": "7",
    "text": "Xin đừng để họ thoát bất cứ vì lý do nào,"
  },
  {
    "id": 23634,
    "book": "psalms                                  ",
    "chapter": "56",
    "verse": "8",
    "text": "Xin Chúa ghi nhận tiếng con than thở,"
  },
  {
    "id": 23635,
    "book": "psalms                                  ",
    "chapter": "56",
    "verse": "9",
    "text": "Kẻ thù con lập tức bị đẩy lui khi con kêu cầu Chúa."
  },
  {
    "id": 23636,
    "book": "psalms                                  ",
    "chapter": "56",
    "verse": "10",
    "text": "Con ngợi tôn Đức Chúa Trời vì lời Ngài đã hứa;"
  },
  {
    "id": 23637,
    "book": "psalms                                  ",
    "chapter": "56",
    "verse": "11",
    "text": "Con tin cậy Đức Chúa Trời, vậy tại sao con phải sợ lo?"
  },
  {
    "id": 23638,
    "book": "psalms                                  ",
    "chapter": "56",
    "verse": "12",
    "text": "Lạy Đức Chúa Trời, con không quên những lời hứa nguyện,"
  },
  {
    "id": 23639,
    "book": "psalms                                  ",
    "chapter": "56",
    "verse": "13",
    "text": "Vì Chúa giải thoát con khỏi tay thần chết;"
  }
]