  {
    "id": 6420,
    "book": "lamentations                            ",
    "chapter": "3",
    "verse": "63",
    "text": "Xin nhìn họ! Bất cứ lúc họ đứng hay ngồi,"
  },
  {
    "id": 6421,
    "book": "lamentations                            ",
    "chapter": "3",
    "verse": "64",
    "text": "Xin báo trả họ, thưa Chúa Hằng Hữu,"
  },
  {
    "id": 6422,
    "book": "lamentations                            ",
    "chapter": "3",
    "verse": "65",
    "text": "Xin khiến lòng họ cứng cỏi và chai lì,"
  },
  {
    "id": 6423,
    "book": "lamentations                            ",
    "chapter": "3",
    "verse": "66",
    "text": "Xin đuổi theo họ trong cơn giận của Ngài,"
  }
