    "verse": "41",
    "text": "Hãy đưa lòng và tay chúng ta"
  },
  {
    "id": 6399,
    "book": "lamentations                            ",
    "chapter": "3",
    "verse": "42",
    "text": "“Chúng con đã phạm tội và phản nghịch Chúa,"
