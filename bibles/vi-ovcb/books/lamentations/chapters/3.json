  {
    "id": 6418,
    "book": "lamentations                            ",
    "chapter": "3",
    "verse": "61",
    "text": "Lạy Chúa Hằng Hữu, Ngài đã nghe những lời nguyền rủa thậm tệ."
  },
  {
    "id": 6419,
    "book": "lamentations                            ",
    "chapter": "3",
    "verse": "62",
    "text": "Kẻ thù con thì thầm và xầm xì cả ngày"
