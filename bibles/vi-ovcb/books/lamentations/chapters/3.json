    "text": "Sự bình an lìa khỏi tôi,"
  },
  {
    "id": 6375,
    "book": "lamentations                            ",
    "chapter": "3",
    "verse": "18",
    "text": "Tôi kêu khóc: “Huy hoàng tôi đã mất!"
  },
  {
    "id": 6376,
    "book": "lamentations                            ",
    "chapter": "3",
    "verse": "19",
    "text": "Xin Chúa nhớ cảnh hoạn nạn, khốn khổ"
