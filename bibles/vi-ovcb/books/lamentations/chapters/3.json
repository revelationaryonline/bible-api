    "book": "lamentations                            ",
    "chapter": "3",
    "verse": "27",
    "text": "Thật tốt cho người nào biết phục tùng trong tuổi thanh xuân,"
  },
  {
    "id": 6385,
    "book": "lamentations                            ",
    "chapter": "3",
    "verse": "28",
    "text": "Người ấy hãy ngồi một mình yên lặng,"
