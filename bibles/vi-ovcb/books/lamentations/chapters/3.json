  {
    "id": 6386,
    "book": "lamentations                            ",
    "chapter": "3",
    "verse": "29",
    "text": "Người ấy hãy nằm sắp mặt xuống đất,"
  },
  {
    "id": 6387,
    "book": "lamentations                            ",
    "chapter": "3",
    "verse": "30",
    "text": "Người ấy hãy đưa má cho người ta vả"
  },
  {
    "id": 6388,
    "book": "lamentations                            ",
    "chapter": "3",
    "verse": "31",
    "text": "Vì Chúa Hằng Hữu không"
  },
  {
    "id": 6389,
    "book": "lamentations                            ",
    "chapter": "3",
    "verse": "32",
    "text": "Dù đã làm cho đau buồn, Ngài vẫn thương xót"
  },
  {
    "id": 6390,
    "book": "lamentations                            ",
    "chapter": "3",
    "verse": "33",
    "text": "Vì Chúa không vui thích làm đau lòng loài người"
