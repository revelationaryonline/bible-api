  {
    "id": 6488,
    "book": "proverbs                                ",
    "chapter": "1",
    "verse": "21",
    "text": "Kêu gọi nơi công cộng,"
  },
  {
    "id": 6489,
    "book": "proverbs                                ",
    "chapter": "1",
    "verse": "22",
    "text": "“Hỡi người khờ dại, đến bao giờ"
