    "book": "proverbs                                ",
    "chapter": "1",
    "verse": "24",
    "text": "Nhưng, dù ta kêu gọi, các ngươi vẫn từ nan."
  },
  {
    "id": 6492,
    "book": "proverbs                                ",
    "chapter": "1",
    "verse": "25",
    "text": "Không ai để ý lời ta khuyên răn"
  },
  {
    "id": 6493,
    "book": "proverbs                                ",
    "chapter": "1",
    "verse": "26",
    "text": "Nên khi các người lâm nạn, ta sẽ cười!"
  },
  {
    "id": 6494,
    "book": "proverbs                                ",
    "chapter": "1",
    "verse": "27",
    "text": "khi kinh hoàng vụt đến tựa phong ba,"
  },
  {
    "id": 6495,
    "book": "proverbs                                ",
    "chapter": "1",
    "verse": "28",
    "text": "Họ sẽ kêu cầu ta, nhưng ta chẳng đáp lời."
  },
  {
    "id": 6496,
    "book": "proverbs                                ",
    "chapter": "1",
    "verse": "29",
    "text": "Chính vì họ thù ghét tri thức"
  },
  {
    "id": 6497,
    "book": "proverbs                                ",
    "chapter": "1",
    "verse": "30",
    "text": "Họ không muốn nghe ta khuyên dạy"
