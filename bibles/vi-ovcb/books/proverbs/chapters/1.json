[
  {
    "id": 6468,
    "book": "proverbs                                ",
    "chapter": "1",
    "verse": "1",
    "text": "Đây là những châm ngôn của Sa-lô-môn, con trai Đa-vít, vua Ít-ra-ên."
  },
  {
    "id": 6469,
    "book": "proverbs                                ",
    "chapter": "1",
    "verse": "2",
    "text": "Để người ta tìm đến khôn ngoan và tiếp thu lời khuyên dạy,"
  },
  {
    "id": 6470,
    "book": "proverbs                                ",
    "chapter": "1",
    "verse": "3",
    "text": "Để đạt đến một đời sống kỷ luật và cẩn trọng,"
  },
  {
    "id": 6471,
    "book": "proverbs                                ",
    "chapter": "1",
    "verse": "4",
    "text": "Để giúp người đơn sơ được sáng suốt,"
  },
  {
    "id": 6472,
    "book": "proverbs                                ",
    "chapter": "1",
    "verse": "5",
    "text": "Người khôn học hỏi châm ngôn để thêm khôn."
  },
  {
    "id": 6473,
    "book": "proverbs                                ",
    "chapter": "1",
    "verse": "6",
    "text": "nếu biết ứng dụng châm ngôn, ngụ ngôn"
  },
  {
    "id": 6474,
    "book": "proverbs                                ",
    "chapter": "1",
    "verse": "7",
    "text": "Kính sợ Chúa Hằng Hữu là khởi đầu của mọi tri thức,"
  },
  {
    "id": 6475,
    "book": "proverbs                                ",
    "chapter": "1",
    "verse": "8",
    "text": "Con ơi, phải nghe lời cha khuyên dạy."
  },
  {
    "id": 6476,
    "book": "proverbs                                ",
    "chapter": "1",
    "verse": "9",
    "text": "Đó là trang sức duyên dáng trên đầu con"
  },
  {
    "id": 6477,
    "book": "proverbs                                ",
    "chapter": "1",
    "verse": "10",
    "text": "Con ơi, khi người tội lỗi quyến rũ,"
  },
  {
    "id": 6478,
    "book": "proverbs                                ",
    "chapter": "1",
    "verse": "11",
    "text": "Khi họ bảo: “Hãy đến với chúng ta."
  },
  {
    "id": 6479,
    "book": "proverbs                                ",
    "chapter": "1",
    "verse": "12",
    "text": "Ta sẽ nuốt sống nó như âm phủ;"
  },
  {
    "id": 6480,
    "book": "proverbs                                ",
    "chapter": "1",
    "verse": "13",
    "text": "Ta sẽ lấy đủ mọi của báu."
  },
  {
    "id": 6481,
    "book": "proverbs                                ",
    "chapter": "1",
    "verse": "14",
    "text": "Bạn sẽ cùng chúng ta rút thăm chia của;"
  },
  {
    "id": 6482,
    "book": "proverbs                                ",
    "chapter": "1",
    "verse": "15",
    "text": "Thì con ơi, đừng nghe theo họ!"
  },
  {
    "id": 6483,
    "book": "proverbs                                ",
    "chapter": "1",
    "verse": "16",
    "text": "Vì họ nhanh chân theo điều ác."
  },
  {
    "id": 6484,
    "book": "proverbs                                ",
    "chapter": "1",
    "verse": "17",
    "text": "Khi người giăng lưới bắt chim,"
  },
  {
    "id": 6485,
    "book": "proverbs                                ",
    "chapter": "1",
    "verse": "18",
    "text": "Nhưng bọn người này tự giăng bẫy;"
