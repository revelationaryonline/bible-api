  {
    "id": 6498,
    "book": "proverbs                                ",
    "chapter": "1",
    "verse": "31",
    "text": "Vì thế, họ sẽ hứng chịu kết quả công việc mình,"
  },
  {
    "id": 6499,
    "book": "proverbs                                ",
    "chapter": "1",
    "verse": "32",
    "text": "Người ngây thơ chết vì lầm đường lạc lối."
  },
  {
    "id": 6500,
    "book": "proverbs                                ",
    "chapter": "1",
    "verse": "33",
    "text": "Nhưng ai nghe ta sẽ sống bình an,"
  }
