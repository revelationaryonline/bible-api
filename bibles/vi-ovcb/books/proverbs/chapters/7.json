[
  {
    "id": 6643,
    "book": "proverbs                                ",
    "chapter": "7",
    "verse": "1",
    "text": "Con ơi, hãy giữ lời ta;"
  },
  {
    "id": 6644,
    "book": "proverbs                                ",
    "chapter": "7",
    "verse": "2",
    "text": "Vâng giữ mệnh lệnh ta và sống!"
  },
  {
    "id": 6645,
    "book": "proverbs                                ",
    "chapter": "7",
    "verse": "3",
    "text": "Buộc chặt nó nơi ngón tay để nhắc nhớ."
  },
  {
    "id": 6646,
    "book": "proverbs                                ",
    "chapter": "7",
    "verse": "4",
    "text": "Phải thương yêu đức khôn ngoan như chị em mình;"
  },
  {
    "id": 6647,
    "book": "proverbs                                ",
    "chapter": "7",
    "verse": "5",
    "text": "Để con tránh được sự cám dỗ của dâm phụ,"
  },
  {
    "id": 6648,
    "book": "proverbs                                ",
    "chapter": "7",
    "verse": "6",
    "text": "Vì một hôm ở trong nhà,"
  },
  {
    "id": 6649,
    "book": "proverbs                                ",
    "chapter": "7",
    "verse": "7",
    "text": "thấy trong bọn ngây thơ,"
  },
  {
    "id": 6650,
    "book": "proverbs                                ",
    "chapter": "7",
    "verse": "8",
    "text": "Hắn đi ngang đường gần khu dâm phụ ở,"
  },
  {
    "id": 6651,
    "book": "proverbs                                ",
    "chapter": "7",
    "verse": "9",
    "text": "Nhằm lúc hoàng hôn tối trời,"
  },
  {
    "id": 6652,
    "book": "proverbs                                ",
    "chapter": "7",
    "verse": "10",
    "text": "Kìa, dâm phụ ra đón chào,"
  },
  {
    "id": 6653,
    "book": "proverbs                                ",
    "chapter": "7",
    "verse": "11",
    "text": "Tính tình ngang bướng, nói năng sỗ sàng;"
  },
  {
    "id": 6654,
    "book": "proverbs                                ",
    "chapter": "7",
    "verse": "12",
    "text": "Cứ thả lang thang ngoài hè phố,"
  },
  {
    "id": 6655,
    "book": "proverbs                                ",
    "chapter": "7",
    "verse": "13",
    "text": "Người đàn bà ôm hắn mà hôn,"
  },
  {
    "id": 6656,
    "book": "proverbs                                ",
    "chapter": "7",
    "verse": "14",
    "text": "“Em vừa dâng lễ cầu an"
  },
  {
    "id": 6657,
    "book": "proverbs                                ",
    "chapter": "7",
    "verse": "15",
    "text": "Anh là người mà em tìm kiếm!"
  },
  {
    "id": 6658,
    "book": "proverbs                                ",
    "chapter": "7",
    "verse": "16",
    "text": "Em đã trải mền Ai Cập"
  },
  {
    "id": 6659,
    "book": "proverbs                                ",
    "chapter": "7",
    "verse": "17",
    "text": "Và rắc một dược, lô hội, và nhục quế"
  },
  {
    "id": 6660,
    "book": "proverbs                                ",
    "chapter": "7",
    "verse": "18",
    "text": "Hãy đến, chúng ta cùng tận hưởng khoái lạc yêu đương."
  },
  {
    "id": 6661,
    "book": "proverbs                                ",
    "chapter": "7",
    "verse": "19",
    "text": "vì chồng em vắng nhà."
  },
  {
    "id": 6662,
    "book": "proverbs                                ",
    "chapter": "7",
    "verse": "20",
    "text": "Người mang theo rất nhiều tiền bạc,"
  },
  {
    "id": 6663,
    "book": "proverbs                                ",
    "chapter": "7",
    "verse": "21",
    "text": "Dùng lời đường mật, nàng quyến rũ,"
  },
  {
    "id": 6664,
    "book": "proverbs                                ",
    "chapter": "7",
    "verse": "22",
    "text": "Lập tức hắn đi theo nàng,"
  },
  {
    "id": 6665,
    "book": "proverbs                                ",
    "chapter": "7",
    "verse": "23",
    "text": "cho đến chừng mũi tên xuyên vào tim."
  },
  {
    "id": 6666,
    "book": "proverbs                                ",
    "chapter": "7",
    "verse": "24",
    "text": "Thế thì, con ơi, phải lắng tai,"
  },
  {
    "id": 6667,
    "book": "proverbs                                ",
    "chapter": "7",
    "verse": "25",
    "text": "Đừng để lòng con bị mê hoặc bởi người đàn bà ấy."
  },
  {
    "id": 6668,
    "book": "proverbs                                ",
    "chapter": "7",
    "verse": "26",
    "text": "Vì nó đã đánh gục nhiều người;"
  },
  {
    "id": 6669,
    "book": "proverbs                                ",
    "chapter": "7",
    "verse": "27",
    "text": "Nhà nó là đường đi địa ngục."
  }
]