[
  {
    "id": 7022,
    "book": "proverbs                                ",
    "chapter": "20",
    "verse": "1",
    "text": "Rượu xúi người nhạo báng, thức uống say gây tiếng ồn."
  },
  {
    "id": 7023,
    "book": "proverbs                                ",
    "chapter": "20",
    "verse": "2",
    "text": "Vua thịnh nộ như sư tử rống;"
  },
  {
    "id": 7024,
    "book": "proverbs                                ",
    "chapter": "20",
    "verse": "3",
    "text": "Tránh được tranh cạnh là điều vinh dự;"
  },
  {
    "id": 7025,
    "book": "proverbs                                ",
    "chapter": "20",
    "verse": "4",
    "text": "Người lười biếng không cày lúc mùa đông,"
  },
  {
    "id": 7026,
    "book": "proverbs                                ",
    "chapter": "20",
    "verse": "5",
    "text": "Mưu kế lòng người như giếng nước sâu,"
  },
  {
    "id": 7027,
    "book": "proverbs                                ",
    "chapter": "20",
    "verse": "6",
    "text": "Bao nhiêu người khoe nhân khoe nghĩa,"
  },
  {
    "id": 7028,
    "book": "proverbs                                ",
    "chapter": "20",
    "verse": "7",
    "text": "Một người ngay có lòng chân thật;"
  },
  {
    "id": 7029,
    "book": "proverbs                                ",
    "chapter": "20",
    "verse": "8",
    "text": "Vua ngồi xử đoán, mắt tinh vi,"
  },
  {
    "id": 7030,
    "book": "proverbs                                ",
    "chapter": "20",
    "verse": "9",
    "text": "Ai dám bảo: “Tôi có lòng trong sạch,"
  },
  {
    "id": 7031,
    "book": "proverbs                                ",
    "chapter": "20",
    "verse": "10",
    "text": "Người dùng cân lường gian trá—"
  },
  {
    "id": 7032,
    "book": "proverbs                                ",
    "chapter": "20",
    "verse": "11",
    "text": "Dù còn niên thiếu, tính tình đã bộc lộ,"
  },
  {
    "id": 7033,
    "book": "proverbs                                ",
    "chapter": "20",
    "verse": "12",
    "text": "Tai để nghe và mắt nhìn thấy—"
  },
  {
    "id": 7034,
    "book": "proverbs                                ",
    "chapter": "20",
    "verse": "13",
    "text": "Mê ngủ quá, con sẽ nên nghèo khó."
  },
  {
    "id": 7035,
    "book": "proverbs                                ",
    "chapter": "20",
    "verse": "14",
    "text": "Người mua luôn miệng chê: “Xấu, Xấu!”"
  },
  {
    "id": 7036,
    "book": "proverbs                                ",
    "chapter": "20",
    "verse": "15",
    "text": "Vàng bạc ngọc ngà không khó kiếm,"
  },
  {
    "id": 7037,
    "book": "proverbs                                ",
    "chapter": "20",
    "verse": "16",
    "text": "Phải nắm áo hắn vì hắn bảo lãnh cho người không quen,"
  },
  {
    "id": 7038,
    "book": "proverbs                                ",
    "chapter": "20",
    "verse": "17",
    "text": "Bánh gian lận mới ăn thì ngon ngọt,"
  },
  {
    "id": 7039,
    "book": "proverbs                                ",
    "chapter": "20",
    "verse": "18",
    "text": "Chỉ nhờ hội bàn mới thành kế hoạch;"
  },
  {
    "id": 7040,
    "book": "proverbs                                ",
    "chapter": "20",
    "verse": "19",
    "text": "Người mách lẻo tiết lộ điều bí mật,"
  },
  {
    "id": 7041,
    "book": "proverbs                                ",
    "chapter": "20",
    "verse": "20",
    "text": "Ngọn đèn của người chửi cha mắng mẹ,"
  },
  {
    "id": 7042,
    "book": "proverbs                                ",
    "chapter": "20",
    "verse": "21",
    "text": "Gia tài hưởng hấp tấp,"
  },
  {
    "id": 7043,
    "book": "proverbs                                ",
    "chapter": "20",
    "verse": "22",
    "text": "Đừng vội nói: “Thù tôi, tôi trả.”"
  },
  {
    "id": 7044,
    "book": "proverbs                                ",
    "chapter": "20",
    "verse": "23",
    "text": "Trái cân non, chiếc cân giả,"
  },
  {
    "id": 7045,
    "book": "proverbs                                ",
    "chapter": "20",
    "verse": "24",
    "text": "Chúa Hằng Hữu dẫn đưa từng bước một,"
  },
  {
    "id": 7046,
    "book": "proverbs                                ",
    "chapter": "20",
    "verse": "25",
    "text": "Khấn nguyện với Đức Chúa Trời mà không suy xét"
  },
  {
    "id": 7047,
    "book": "proverbs                                ",
    "chapter": "20",
    "verse": "26",
    "text": "Vua khôn ngoan áp dụng trọng hình,"
  },
  {
    "id": 7048,
    "book": "proverbs                                ",
    "chapter": "20",
    "verse": "27",
    "text": "Tâm linh con người là ngọn đèn của Chúa Hằng Hữu,"
  },
  {
    "id": 7049,
    "book": "proverbs                                ",
    "chapter": "20",
    "verse": "28",
    "text": "Chỉ có lòng bác ái, chân thành, độ lượng,"
  },
  {
    "id": 7050,
    "book": "proverbs                                ",
    "chapter": "20",
    "verse": "29",
    "text": "Trai tráng nhờ sức mạnh được vẻ vang;"
  },
  {
    "id": 7051,
    "book": "proverbs                                ",
    "chapter": "20",
    "verse": "30",
    "text": "Những thương tích làm sạch điều ác,"
  }
]