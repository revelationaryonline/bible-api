[
  {
    "id": 7352,
    "book": "proverbs                                ",
    "chapter": "31",
    "verse": "1",
    "text": "Châm ngôn của Vua Lê-mu-ên, do"
  },
  {
    "id": 7353,
    "book": "proverbs                                ",
    "chapter": "31",
    "verse": "2",
    "text": "Con ơi! Đứa con mà lòng dạ mẹ đã cưu mang,"
  },
  {
    "id": 7354,
    "book": "proverbs                                ",
    "chapter": "31",
    "verse": "3",
    "text": "đừng vì đàn bà mà tiêu hao năng lực,"
  },
  {
    "id": 7355,
    "book": "proverbs                                ",
    "chapter": "31",
    "verse": "4",
    "text": "Lê-mu-ên, con ơi, vua chúa không nên ham rượu."
  },
  {
    "id": 7356,
    "book": "proverbs                                ",
    "chapter": "31",
    "verse": "5",
    "text": "Uống vào, con sẽ quên hết luật lệ,"
  },
  {
    "id": 7357,
    "book": "proverbs                                ",
    "chapter": "31",
    "verse": "6",
    "text": "Hãy đem chất men cho người hấp hối"
  },
  {
    "id": 7358,
    "book": "proverbs                                ",
    "chapter": "31",
    "verse": "7",
    "text": "Họ uống cho quên đi nỗi khổ,"
  },
  {
    "id": 7359,
    "book": "proverbs                                ",
    "chapter": "31",
    "verse": "8",
    "text": "Hãy lên tiếng bênh vực người cô thế;"
  },
  {
    "id": 7360,
    "book": "proverbs                                ",
    "chapter": "31",
    "verse": "9",
    "text": "Con hãy phán xét công minh,"
  },
  {
    "id": 7361,
    "book": "proverbs                                ",
    "chapter": "31",
    "verse": "10",
    "text": "Một người vợ hiền đức, ai có thể tìm được?"
  },
  {
    "id": 7362,
    "book": "proverbs                                ",
    "chapter": "31",
    "verse": "11",
    "text": "Nàng được chồng tín nhiệm,"
  },
  {
    "id": 7363,
    "book": "proverbs                                ",
    "chapter": "31",
    "verse": "12",
    "text": "Nàng chẳng làm thương tổn,"
  },
  {
    "id": 7364,
    "book": "proverbs                                ",
    "chapter": "31",
    "verse": "13",
    "text": "Nàng bận bịu quay sợi,"
  },
  {
    "id": 7365,
    "book": "proverbs                                ",
    "chapter": "31",
    "verse": "14",
    "text": "Nàng giống như con tàu"
  },
  {
    "id": 7366,
    "book": "proverbs                                ",
    "chapter": "31",
    "verse": "15",
    "text": "Thức giấc khi trời chưa sáng,"
  },
  {
    "id": 7367,
    "book": "proverbs                                ",
    "chapter": "31",
    "verse": "16",
    "text": "Nàng lưu ý một thửa ruộng và mua nó,"
  },
  {
    "id": 7368,
    "book": "proverbs                                ",
    "chapter": "31",
    "verse": "17",
    "text": "Nàng đảm đang, chịu khó,"
  },
  {
    "id": 7369,
    "book": "proverbs                                ",
    "chapter": "31",
    "verse": "18",
    "text": "Thức làm việc đến khuya;"
  },
  {
    "id": 7370,
    "book": "proverbs                                ",
    "chapter": "31",
    "verse": "19",
    "text": "Nàng tra tay vào guồng kéo sợi,"
  },
  {
    "id": 7371,
    "book": "proverbs                                ",
    "chapter": "31",
    "verse": "20",
    "text": "Nàng đưa tay giúp người khốn khó,"
  },
  {
    "id": 7372,
    "book": "proverbs                                ",
    "chapter": "31",
    "verse": "21",
    "text": "Không sợ gia đình gặp tuyết giá,"
  },
  {
    "id": 7373,
    "book": "proverbs                                ",
    "chapter": "31",
    "verse": "22",
    "text": "Nàng dệt lấy chăn mền,"
  },
  {
    "id": 7374,
    "book": "proverbs                                ",
    "chapter": "31",
    "verse": "23",
    "text": "Chồng nàng được nổi danh,"
  },
  {
    "id": 7375,
    "book": "proverbs                                ",
    "chapter": "31",
    "verse": "24",
    "text": "Nàng sản xuất áo quần,"
  },
  {
    "id": 7376,
    "book": "proverbs                                ",
    "chapter": "31",
    "verse": "25",
    "text": "Là người có nghị lực và duyên dáng,"
  },
  {
    "id": 7377,
    "book": "proverbs                                ",
    "chapter": "31",
    "verse": "26",
    "text": "Nàng ăn nói khôn ngoan,"
  },
  {
    "id": 7378,
    "book": "proverbs                                ",
    "chapter": "31",
    "verse": "27",
    "text": "Nàng chăm sóc mọi việc trong nhà,"
  },
  {
    "id": 7379,
    "book": "proverbs                                ",
    "chapter": "31",
    "verse": "28",
    "text": "Con cái chúc nàng hạnh phước."
  },
  {
    "id": 7380,
    "book": "proverbs                                ",
    "chapter": "31",
    "verse": "29",
    "text": "“Có nhiều phụ nữ tài đức,"
  },
  {
    "id": 7381,
    "book": "proverbs                                ",
    "chapter": "31",
    "verse": "30",
    "text": "Duyên dáng thường giả trá, sắc đẹp cũng tàn phai;"
  },
  {
    "id": 7382,
    "book": "proverbs                                ",
    "chapter": "31",
    "verse": "31",
    "text": "Cùng được hưởng thành quả của công việc do tay mình làm ra."
  }
]