[
  {
    "id": 7112,
    "book": "proverbs                                ",
    "chapter": "23",
    "verse": "1",
    "text": "Khi con ngồi ăn uống với người quyền thế,"
  },
  {
    "id": 7113,
    "book": "proverbs                                ",
    "chapter": "23",
    "verse": "2",
    "text": "Nếu con ham ăn,"
  },
  {
    "id": 7114,
    "book": "proverbs                                ",
    "chapter": "23",
    "verse": "3",
    "text": "Chớ thèm các món cao lương mỹ vị,"
  },
  {
    "id": 7115,
    "book": "proverbs                                ",
    "chapter": "23",
    "verse": "4",
    "text": "Đừng nhọc công khổ trí làm giàu."
  },
  {
    "id": 7116,
    "book": "proverbs                                ",
    "chapter": "23",
    "verse": "5",
    "text": "Con có liếc mắt nhìn sự giàu sang,"
  },
  {
    "id": 7117,
    "book": "proverbs                                ",
    "chapter": "23",
    "verse": "6",
    "text": "Chớ ăn của người có lòng keo kiệt;"
  },
  {
    "id": 7118,
    "book": "proverbs                                ",
    "chapter": "23",
    "verse": "7",
    "text": "Miệng mời nhưng lòng họ chẳng muốn con ăn,"
  },
  {
    "id": 7119,
    "book": "proverbs                                ",
    "chapter": "23",
    "verse": "8",
    "text": "Con sẽ phải nôn hết món ăn ra,"
  },
  {
    "id": 7120,
    "book": "proverbs                                ",
    "chapter": "23",
    "verse": "9",
    "text": "Đừng tốn công nói với người dại,"
  },
  {
    "id": 7121,
    "book": "proverbs                                ",
    "chapter": "23",
    "verse": "10",
    "text": "Chớ dời ranh giới cũ;"
  },
  {
    "id": 7122,
    "book": "proverbs                                ",
    "chapter": "23",
    "verse": "11",
    "text": "Vì Đấng Cứu Chuộc họ là Đấng năng quyền;"
  },
  {
    "id": 7123,
    "book": "proverbs                                ",
    "chapter": "23",
    "verse": "12",
    "text": "Chuyên lòng tiếp nhận dạy dỗ;"
  },
  {
    "id": 7124,
    "book": "proverbs                                ",
    "chapter": "23",
    "verse": "13",
    "text": "Đừng bỏ qua việc sửa dạy con cái."
  },
  {
    "id": 7125,
    "book": "proverbs                                ",
    "chapter": "23",
    "verse": "14",
    "text": "Người dùng roi sửa dạy con,"
  },
  {
    "id": 7126,
    "book": "proverbs                                ",
    "chapter": "23",
    "verse": "15",
    "text": "Con ơi, nếu lòng con khôn ngoan,"
  },
  {
    "id": 7127,
    "book": "proverbs                                ",
    "chapter": "23",
    "verse": "16",
    "text": "Phải, lòng dạ ta sẽ mừng rỡ,"
  },
  {
    "id": 7128,
    "book": "proverbs                                ",
    "chapter": "23",
    "verse": "17",
    "text": "Chớ hiềm tị vì người gian được may mắn,"
  },
  {
    "id": 7129,
    "book": "proverbs                                ",
    "chapter": "23",
    "verse": "18",
    "text": "Tương lai con sẽ trong sáng;"
  },
  {
    "id": 7130,
    "book": "proverbs                                ",
    "chapter": "23",
    "verse": "19",
    "text": "Con ơi, hãy lắng nghe và trở nên khôn ngoan:"
  },
  {
    "id": 7131,
    "book": "proverbs                                ",
    "chapter": "23",
    "verse": "20",
    "text": "Chớ kết bạn với người nghiện rượu,"
  },
  {
    "id": 7132,
    "book": "proverbs                                ",
    "chapter": "23",
    "verse": "21",
    "text": "vì tương lai họ khó khăn, cơ hàn,"
  },
  {
    "id": 7133,
    "book": "proverbs                                ",
    "chapter": "23",
    "verse": "22",
    "text": "Lắng tai nghe lời khuyên dạy của cha,"
  },
  {
    "id": 7134,
    "book": "proverbs                                ",
    "chapter": "23",
    "verse": "23",
    "text": "Phải mua chân lý và đừng bao giờ bán nó;"
  },
  {
    "id": 7135,
    "book": "proverbs                                ",
    "chapter": "23",
    "verse": "24",
    "text": "Có con ngay lành, lòng cha mừng rỡ."
  },
  {
    "id": 7136,
    "book": "proverbs                                ",
    "chapter": "23",
    "verse": "25",
    "text": "Nguyện cha và mẹ con vui mừng!"
  },
  {
    "id": 7137,
    "book": "proverbs                                ",
    "chapter": "23",
    "verse": "26",
    "text": "Con hãy dâng lòng con cho cha."
  },
  {
    "id": 7138,
    "book": "proverbs                                ",
    "chapter": "23",
    "verse": "27",
    "text": "Vì gái điếm là hố sâu,"
  },
  {
    "id": 7139,
    "book": "proverbs                                ",
    "chapter": "23",
    "verse": "28",
    "text": "Nó rình rập mồi ngon,"
  },
  {
    "id": 7140,
    "book": "proverbs                                ",
    "chapter": "23",
    "verse": "29",
    "text": "Ai phiền muộn? Ai đau khổ?"
  },
  {
    "id": 7141,
    "book": "proverbs                                ",
    "chapter": "23",
    "verse": "30",
    "text": "Đó là người chè chén, la cà,"
  },
  {
    "id": 7142,
    "book": "proverbs                                ",
    "chapter": "23",
    "verse": "31",
    "text": "Chớ mê mẩn nhìn ly rượu hồng, nó đỏ đẹp thật,"
  },
  {
    "id": 7143,
    "book": "proverbs                                ",
    "chapter": "23",
    "verse": "32",
    "text": "Nhưng rồi ra con sẽ bị rượu cắn như rắn;"
  },
  {
    "id": 7144,
    "book": "proverbs                                ",
    "chapter": "23",
    "verse": "33",
    "text": "Mắt con sẽ thấy những điều kỳ lạ,"
  },
  {
    "id": 7145,
    "book": "proverbs                                ",
    "chapter": "23",
    "verse": "34",
    "text": "Con sẽ như người đi giữa biển cả,"
  },
  {
    "id": 7146,
    "book": "proverbs                                ",
    "chapter": "23",
    "verse": "35",
    "text": "Con nói: “Họ đánh tôi, nhưng sao tôi chẳng đau."
  }
]