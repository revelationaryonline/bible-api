[
  {
    "id": 7083,
    "book": "proverbs                                ",
    "chapter": "22",
    "verse": "1",
    "text": "Danh thơm tiếng tốt hơn giàu có;"
  },
  {
    "id": 7084,
    "book": "proverbs                                ",
    "chapter": "22",
    "verse": "2",
    "text": "Chúa Hằng Hữu tạo nên người nghèo lẫn người giàu,"
  },
  {
    "id": 7085,
    "book": "proverbs                                ",
    "chapter": "22",
    "verse": "3",
    "text": "Người khôn tránh né nguy nan."
  },
  {
    "id": 7086,
    "book": "proverbs                                ",
    "chapter": "22",
    "verse": "4",
    "text": "Ai kính sợ Chúa Hằng Hữu và khiêm nhường"
  },
  {
    "id": 7087,
    "book": "proverbs                                ",
    "chapter": "22",
    "verse": "5",
    "text": "Trên đường người gian tà đầy gai góc và cạm bẫy;"
  },
  {
    "id": 7088,
    "book": "proverbs                                ",
    "chapter": "22",
    "verse": "6",
    "text": "Dạy trẻ thơ nẻo chính đường ngay,"
  },
  {
    "id": 7089,
    "book": "proverbs                                ",
    "chapter": "22",
    "verse": "7",
    "text": "Giàu cai trị nghèo,"
  },
  {
    "id": 7090,
    "book": "proverbs                                ",
    "chapter": "22",
    "verse": "8",
    "text": "Người gieo bất công sẽ gặt tai họa,"
  },
  {
    "id": 7091,
    "book": "proverbs                                ",
    "chapter": "22",
    "verse": "9",
    "text": "Ai rộng lòng nuôi dưỡng người cơ cực"
  },
  {
    "id": 7092,
    "book": "proverbs                                ",
    "chapter": "22",
    "verse": "10",
    "text": "Đuổi người kiêu cường đi, xung đột sẽ dứt."
  },
  {
    "id": 7093,
    "book": "proverbs                                ",
    "chapter": "22",
    "verse": "11",
    "text": "Lòng trong sạch, môi thanh nhã,"
  },
  {
    "id": 7094,
    "book": "proverbs                                ",
    "chapter": "22",
    "verse": "12",
    "text": "Chúa Hằng Hữu bảo vệ người thông sáng,"
  },
  {
    "id": 7095,
    "book": "proverbs                                ",
    "chapter": "22",
    "verse": "13",
    "text": "Người lười nói: “Sư tử ngoài kia!"
  },
  {
    "id": 7096,
    "book": "proverbs                                ",
    "chapter": "22",
    "verse": "14",
    "text": "Miệng dâm phụ là cái hố sâu;"
  },
  {
    "id": 7097,
    "book": "proverbs                                ",
    "chapter": "22",
    "verse": "15",
    "text": "Nghiêm trị, răn dạy trẻ thơ,"
  },
  {
    "id": 7098,
    "book": "proverbs                                ",
    "chapter": "22",
    "verse": "16",
    "text": "Làm giàu bằng cách bóc lột người nghèo hay bằng hối lộ,"
  },
  {
    "id": 7099,
    "book": "proverbs                                ",
    "chapter": "22",
    "verse": "17",
    "text": "Con lắng tai nghe lời khôn sáng;"
  },
  {
    "id": 7100,
    "book": "proverbs                                ",
    "chapter": "22",
    "verse": "18",
    "text": "Con sẽ vui thích khi giữ nó trong lòng,"
  },
  {
    "id": 7101,
    "book": "proverbs                                ",
    "chapter": "22",
    "verse": "19",
    "text": "Ngày nay ta đã dạy cho con biết điều đó,"
  },
  {
    "id": 7102,
    "book": "proverbs                                ",
    "chapter": "22",
    "verse": "20",
    "text": "Ta há chẳng viết cho con ba mươi lần,"
  },
  {
    "id": 7103,
    "book": "proverbs                                ",
    "chapter": "22",
    "verse": "21",
    "text": "Để con tiếp nhận lời chân thật,"
  },
  {
    "id": 7104,
    "book": "proverbs                                ",
    "chapter": "22",
    "verse": "22",
    "text": "Đừng bóc lột người nghèo vì họ túng quẫn,"
  },
  {
    "id": 7105,
    "book": "proverbs                                ",
    "chapter": "22",
    "verse": "23",
    "text": "Vì Chúa Hằng Hữu sẽ đứng ra bênh vực."
  },
  {
    "id": 7106,
    "book": "proverbs                                ",
    "chapter": "22",
    "verse": "24",
    "text": "Thấy ai giận, con đừng phụ họa,"
  },
  {
    "id": 7107,
    "book": "proverbs                                ",
    "chapter": "22",
    "verse": "25",
    "text": "để con khỏi học tính nóng nảy"
  },
  {
    "id": 7108,
    "book": "proverbs                                ",
    "chapter": "22",
    "verse": "26",
    "text": "Chớ như người ra tay bảo đảm"
  },
  {
    "id": 7109,
    "book": "proverbs                                ",
    "chapter": "22",
    "verse": "27",
    "text": "Vì nếu con không có gì để trả"
  },
  {
    "id": 7110,
    "book": "proverbs                                ",
    "chapter": "22",
    "verse": "28",
    "text": "Chớ dời ranh giới cũ"
  },
  {
    "id": 7111,
    "book": "proverbs                                ",
    "chapter": "22",
    "verse": "29",
    "text": "Con có thấy người nào cần mẫn trong việc mình không?"
  }
]