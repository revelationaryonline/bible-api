[
  {
    "id": 7319,
    "book": "proverbs                                ",
    "chapter": "30",
    "verse": "1",
    "text": "Lời của A-gu-ra, con trai Gia-kê, nói với Y-thi-ên và U-can:"
  },
  {
    "id": 7320,
    "book": "proverbs                                ",
    "chapter": "30",
    "verse": "2",
    "text": "Tôi là người ngu dốt nhất,"
  },
  {
    "id": 7321,
    "book": "proverbs                                ",
    "chapter": "30",
    "verse": "3",
    "text": "Tôi chưa được học sự khôn ngoan,"
  },
  {
    "id": 7322,
    "book": "proverbs                                ",
    "chapter": "30",
    "verse": "4",
    "text": "Ai đã lên trời, rồi xuống đất?"
  },
  {
    "id": 7323,
    "book": "proverbs                                ",
    "chapter": "30",
    "verse": "5",
    "text": "Mọi lời của Đức Chúa Trời đều tinh luyện;"
  },
  {
    "id": 7324,
    "book": "proverbs                                ",
    "chapter": "30",
    "verse": "6",
    "text": "Đừng thêm gì vào lời của Ngài, kẻo Ngài bắt tội,"
  },
  {
    "id": 7325,
    "book": "proverbs                                ",
    "chapter": "30",
    "verse": "7",
    "text": "Đức Chúa Trời ôi, trước khi con chết,"
  },
  {
    "id": 7326,
    "book": "proverbs                                ",
    "chapter": "30",
    "verse": "8",
    "text": "Giúp con khỏi dối trá, giả hình."
  },
  {
    "id": 7327,
    "book": "proverbs                                ",
    "chapter": "30",
    "verse": "9",
    "text": "Nếu giàu có dư dật, con sẽ khước từ Chúa và hỏi: “Chúa Hằng Hữu là ai?”"
  },
  {
    "id": 7328,
    "book": "proverbs                                ",
    "chapter": "30",
    "verse": "10",
    "text": "Chớ vu khống người đầy tớ với chủ,"
  },
  {
    "id": 7329,
    "book": "proverbs                                ",
    "chapter": "30",
    "verse": "11",
    "text": "Có người rủa cha,"
  },
  {
    "id": 7330,
    "book": "proverbs                                ",
    "chapter": "30",
    "verse": "12",
    "text": "Có người tự thấy mình trong trắng,"
  },
  {
    "id": 7331,
    "book": "proverbs                                ",
    "chapter": "30",
    "verse": "13",
    "text": "Có người đôi mắt kiêu căng,"
  },
  {
    "id": 7332,
    "book": "proverbs                                ",
    "chapter": "30",
    "verse": "14",
    "text": "Có người răng sắc như gươm,"
  },
  {
    "id": 7333,
    "book": "proverbs                                ",
    "chapter": "30",
    "verse": "15",
    "text": "Con đỉa có hai miệng hút,"
  },
  {
    "id": 7334,
    "book": "proverbs                                ",
    "chapter": "30",
    "verse": "16",
    "text": "Âm phủ,"
  },
  {
    "id": 7335,
    "book": "proverbs                                ",
    "chapter": "30",
    "verse": "17",
    "text": "Mắt của người chế nhạo cha, khinh bỉ mẹ,"
  },
  {
    "id": 7336,
    "book": "proverbs                                ",
    "chapter": "30",
    "verse": "18",
    "text": "Có ba điều quá lạ lùng—"
  },
  {
    "id": 7337,
    "book": "proverbs                                ",
    "chapter": "30",
    "verse": "19",
    "text": "Đường đại bàng bay trên không,"
  },
  {
    "id": 7338,
    "book": "proverbs                                ",
    "chapter": "30",
    "verse": "20",
    "text": "Còn thêm một điều nữa: Người đàn bà ngoại tình,"
  },
  {
    "id": 7339,
    "book": "proverbs                                ",
    "chapter": "30",
    "verse": "21",
    "text": "Có ba điều làm đất rung chuyển—"
  },
  {
    "id": 7340,
    "book": "proverbs                                ",
    "chapter": "30",
    "verse": "22",
    "text": "Người nô lệ làm vua,"
  },
  {
    "id": 7341,
    "book": "proverbs                                ",
    "chapter": "30",
    "verse": "23",
    "text": "người đàn bà ghen ghét lấy được chồng,"
  },
  {
    "id": 7342,
    "book": "proverbs                                ",
    "chapter": "30",
    "verse": "24",
    "text": "Có bốn loài vật tuy nhỏ bé"
  },
  {
    "id": 7343,
    "book": "proverbs                                ",
    "chapter": "30",
    "verse": "25",
    "text": "Con kiến là loài yếu ớt,"
  },
  {
    "id": 7344,
    "book": "proverbs                                ",
    "chapter": "30",
    "verse": "26",
    "text": "Con chồn ít năng lực,"
  },
  {
    "id": 7345,
    "book": "proverbs                                ",
    "chapter": "30",
    "verse": "27",
    "text": "Con châu chấu tuy không có vua,"
  },
  {
    "id": 7346,
    "book": "proverbs                                ",
    "chapter": "30",
    "verse": "28",
    "text": "Con thằn lằn mà người ta lấy tay bắt được,"
  },
  {
    "id": 7347,
    "book": "proverbs                                ",
    "chapter": "30",
    "verse": "29",
    "text": "Có ba dã thú dáng đi hùng dũng đẹp đẽ—"
  },
  {
    "id": 7348,
    "book": "proverbs                                ",
    "chapter": "30",
    "verse": "30",
    "text": "Con sư tử, chúa sơn lâm, chẳng lùi bước trước loài nào cả,"
  },
  {
    "id": 7349,
    "book": "proverbs                                ",
    "chapter": "30",
    "verse": "31",
    "text": "con công,"
  },
  {
    "id": 7350,
    "book": "proverbs                                ",
    "chapter": "30",
    "verse": "32",
    "text": "Nếu con vì ngu dại mà tự kiêu hoặc mưu đồ việc ác,"
  },
  {
    "id": 7351,
    "book": "proverbs                                ",
    "chapter": "30",
    "verse": "33",
    "text": "Đánh sữa ra bơ"
  }
]