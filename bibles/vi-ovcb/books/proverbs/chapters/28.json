    "book": "proverbs                                ",
    "chapter": "28",
    "verse": "11",
    "text": "Người giàu thường tự thấy mình khôn ngoan,"
  },
  {
    "id": 7275,
    "book": "proverbs                                ",
    "chapter": "28",
    "verse": "12",
    "text": "Khi người liêm chính nắm quyền, mọi người đều hân hoan."
  },
  {
    "id": 7276,
    "book": "proverbs                                ",
    "chapter": "28",
    "verse": "13",
    "text": "Người che giấu lỗi mình sẽ không được may mắn"
  },
  {
    "id": 7277,
    "book": "proverbs                                ",
    "chapter": "28",
    "verse": "14",
    "text": "Người kính sợ Chúa luôn hưởng hạnh phước,"
  },
  {
    "id": 7278,
    "book": "proverbs                                ",
    "chapter": "28",
    "verse": "15",
    "text": "Người ác cai trị làm dân nghèo khốn khổ,"
  },
  {
    "id": 7279,
    "book": "proverbs                                ",
    "chapter": "28",
    "verse": "16",
    "text": "Một cai quản ngu dốt lo bóc lột dân mình,"
  },
  {
    "id": 7280,
    "book": "proverbs                                ",
    "chapter": "28",
    "verse": "17",
    "text": "Kẻ sát nhân luôn bị lương tâm dày vò, chạy trốn nơi vực thẳm."
  },
  {
    "id": 7281,
    "book": "proverbs                                ",
    "chapter": "28",
    "verse": "18",
