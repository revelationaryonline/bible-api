  {
    "id": 7284,
    "book": "proverbs                                ",
    "chapter": "28",
    "verse": "21",
    "text": "Thiên vị là xấu, bất kể lý do gì,"
  },
  {
    "id": 7285,
    "book": "proverbs                                ",
    "chapter": "28",
    "verse": "22",
    "text": "Người tham lam chạy theo của cải làm giàu,"
  },
  {
    "id": 7286,
    "book": "proverbs                                ",
    "chapter": "28",
    "verse": "23",
    "text": "Đến cuối cùng, người ta sẽ phân định"
  },
  {
    "id": 7287,
    "book": "proverbs                                ",
    "chapter": "28",
    "verse": "24",
    "text": "Ăn cắp cha mẹ mà nói: “Đâu tội vạ gì,”"
  },
  {
    "id": 7288,
    "book": "proverbs                                ",
    "chapter": "28",
    "verse": "25",
    "text": "Kiêu căng gây tranh cạnh,"
  },
  {
    "id": 7289,
    "book": "proverbs                                ",
    "chapter": "28",
    "verse": "26",
    "text": "Người ngu xuẩn tự thị tự mãn,"
