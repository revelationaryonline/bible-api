  {
    "id": 7290,
    "book": "proverbs                                ",
    "chapter": "28",
    "verse": "27",
    "text": "Người phân phát tài sản cho người nghèo chẳng hề thiếu thốn,"
  },
  {
    "id": 7291,
    "book": "proverbs                                ",
    "chapter": "28",
    "verse": "28",
    "text": "Khi người ác cầm quyền, người lành ẩn tránh."
  }
