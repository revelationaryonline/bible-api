    "text": "Quan chức bóc lột người nghèo nàn,"
  },
  {
    "id": 7267,
    "book": "proverbs                                ",
    "chapter": "28",
    "verse": "4",
    "text": "Người bỏ pháp luật đề cao tội ác;"
  },
  {
