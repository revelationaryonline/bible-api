    "book": "proverbs                                ",
    "chapter": "28",
    "verse": "6",
    "text": "Thà nghèo mà ngay thật,"
  },
  {
    "id": 7270,
    "book": "proverbs                                ",
    "chapter": "28",
    "verse": "7",
    "text": "Con khôn ngoan tôn trọng luật pháp;"
  },
  {
