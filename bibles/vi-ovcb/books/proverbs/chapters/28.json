    "book": "proverbs                                ",
    "chapter": "28",
    "verse": "8",
    "text": "Tài sản của người cho vay nặng lãi"
  },
  {
    "id": 7272,
    "book": "proverbs                                ",
    "chapter": "28",
    "verse": "9",
    "text": "Người coi thường, xây tai không nghe luật lệ,"
  },
  {
    "id": 7273,
    "book": "proverbs                                ",
    "chapter": "28",
