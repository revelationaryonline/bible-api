[
  {
    "id": 7292,
    "book": "proverbs                                ",
    "chapter": "29",
    "verse": "1",
    "text": "Người cứng lòng cứng cổ trước lời răn dạy"
  },
  {
    "id": 7293,
    "book": "proverbs                                ",
    "chapter": "29",
    "verse": "2",
    "text": "Người liêm chính cai trị, dân chúng hân hoan."
  },
  {
    "id": 7294,
    "book": "proverbs                                ",
    "chapter": "29",
    "verse": "3",
    "text": "Con khôn ngoan khiến cha vui lòng,"
  },
  {
    "id": 7295,
    "book": "proverbs                                ",
    "chapter": "29",
    "verse": "4",
    "text": "Vua công minh, nước cường thịnh,"
  },
  {
    "id": 7296,
    "book": "proverbs                                ",
    "chapter": "29",
    "verse": "5",
    "text": "Ai nịnh bợ hàng xóm láng giềng,"
  },
  {
    "id": 7297,
    "book": "proverbs                                ",
    "chapter": "29",
    "verse": "6",
    "text": "Người ác bị tội mình sập bẫy,"
  },
  {
    "id": 7298,
    "book": "proverbs                                ",
    "chapter": "29",
    "verse": "7",
    "text": "Người ngay tôn trọng quyền lợi của người nghèo khó;"
  },
  {
    "id": 7299,
    "book": "proverbs                                ",
    "chapter": "29",
    "verse": "8",
    "text": "Người kiêu cường khua mép làm cả thành náo động xôn xao,"
  },
  {
    "id": 7300,
    "book": "proverbs                                ",
    "chapter": "29",
    "verse": "9",
    "text": "Người khôn chẳng cần tranh luận với kẻ dại dột,"
  },
  {
    "id": 7301,
    "book": "proverbs                                ",
    "chapter": "29",
    "verse": "10",
    "text": "Người trọn vẹn bị bọn khát máu ghen ghét,"
  },
  {
    "id": 7302,
    "book": "proverbs                                ",
    "chapter": "29",
    "verse": "11",
    "text": "Người dại để cơn giận mình bùng nổ,"
  },
  {
    "id": 7303,
    "book": "proverbs                                ",
    "chapter": "29",
    "verse": "12",
    "text": "Nếu vua nghe lời giả dối, dối gạt,"
  },
  {
    "id": 7304,
    "book": "proverbs                                ",
    "chapter": "29",
    "verse": "13",
    "text": "Người nghèo và người giàu đều giống nhau ở điểm này:"
  },
  {
    "id": 7305,
    "book": "proverbs                                ",
    "chapter": "29",
    "verse": "14",
    "text": "Vua nào xử công minh cho người nghèo nàn,"
  },
  {
    "id": 7306,
    "book": "proverbs                                ",
    "chapter": "29",
    "verse": "15",
    "text": "Giáo huấn, đòn vọt rèn luyện trẻ thơ,"
  },
  {
    "id": 7307,
    "book": "proverbs                                ",
    "chapter": "29",
    "verse": "16",
    "text": "Số người ác càng nhiều, tội phạm càng gia tăng,"
  },
  {
    "id": 7308,
    "book": "proverbs                                ",
    "chapter": "29",
    "verse": "17",
    "text": "Muốn hưởng hạnh phước và tâm hồn được an tịnh,"
  },
  {
    "id": 7309,
    "book": "proverbs                                ",
    "chapter": "29",
    "verse": "18",
    "text": "Nước nào không được Chúa hướng dẫn sẽ bị xáo trộn."
  },
  {
    "id": 7310,
    "book": "proverbs                                ",
    "chapter": "29",
    "verse": "19",
    "text": "Lời nói suông không đủ điều khiển người giúp việc,"
  },
  {
    "id": 7311,
    "book": "proverbs                                ",
    "chapter": "29",
    "verse": "20",
    "text": "Con có thấy người nói quá hấp tấp?"
  },
  {
    "id": 7312,
    "book": "proverbs                                ",
    "chapter": "29",
    "verse": "21",
    "text": "Nếu nuông chiều người giúp việc từ thuở bé,"
  },
  {
    "id": 7313,
    "book": "proverbs                                ",
    "chapter": "29",
    "verse": "22",
    "text": "Người dễ giận suốt ngày gây gổ;"
  },
  {
    "id": 7314,
    "book": "proverbs                                ",
    "chapter": "29",
    "verse": "23",
    "text": "Tính kiêu căng đưa người xuống dốc,"
  },
  {
    "id": 7315,
    "book": "proverbs                                ",
    "chapter": "29",
    "verse": "24",
    "text": "Người đồng lõa với kẻ trộm, là gây hại cho bản thân."
  },
  {
    "id": 7316,
    "book": "proverbs                                ",
    "chapter": "29",
    "verse": "25",
    "text": "Lo sợ người phàm là một cạm bẫy,"
  },
  {
    "id": 7317,
    "book": "proverbs                                ",
    "chapter": "29",
    "verse": "26",
    "text": "Muốn công lý, cầu xin Chúa Hằng Hữu,"
  },
  {
    "id": 7318,
    "book": "proverbs                                ",
    "chapter": "29",
    "verse": "27",
    "text": "Người ngay ghét việc gian tà;"
  }
]