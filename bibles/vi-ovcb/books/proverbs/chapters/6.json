[
  {
    "id": 6608,
    "book": "proverbs                                ",
    "chapter": "6",
    "verse": "1",
    "text": "Con ơi, nếu con bảo lãnh bạn sơ giao,"
  },
  {
    "id": 6609,
    "book": "proverbs                                ",
    "chapter": "6",
    "verse": "2",
    "text": "Nếu con vướng mắc lời thề,"
  },
  {
    "id": 6610,
    "book": "proverbs                                ",
    "chapter": "6",
    "verse": "3",
    "text": "hãy nghe lời ta khuyên và tự cứu mình,"
  },
  {
    "id": 6611,
    "book": "proverbs                                ",
    "chapter": "6",
    "verse": "4",
    "text": "Đừng trì hoãn; con phải đi ngay!"
  },
  {
    "id": 6612,
    "book": "proverbs                                ",
    "chapter": "6",
    "verse": "5",
    "text": "Phải lo giải thoát lấy thân, như nai thoát tay thợ săn,"
  },
  {
    "id": 6613,
    "book": "proverbs                                ",
    "chapter": "6",
    "verse": "6",
    "text": "Này người lười biếng, hãy quan sát sinh hoạt loài kiến."
  },
  {
    "id": 6614,
    "book": "proverbs                                ",
    "chapter": "6",
    "verse": "7",
    "text": "Tuy không có thủ lãnh,"
  },
  {
    "id": 6615,
    "book": "proverbs                                ",
    "chapter": "6",
    "verse": "8",
    "text": "nhưng mùa hè, chúng biết dự trữ lương thực,"
  },
  {
    "id": 6616,
    "book": "proverbs                                ",
    "chapter": "6",
    "verse": "9",
    "text": "Nhưng người lười biếng kia, còn ngủ mãi sao?"
  },
  {
    "id": 6617,
    "book": "proverbs                                ",
    "chapter": "6",
    "verse": "10",
    "text": "Ngủ một chút, mơ màng thêm một chút,"
  },
  {
    "id": 6618,
    "book": "proverbs                                ",
    "chapter": "6",
    "verse": "11",
    "text": "cảnh nghèo đến như kẻ trộm;"
  },
  {
    "id": 6619,
    "book": "proverbs                                ",
    "chapter": "6",
    "verse": "12",
    "text": "Bọn vô lại độc ác thích điều gì?"
  },
  {
    "id": 6620,
    "book": "proverbs                                ",
    "chapter": "6",
    "verse": "13",
    "text": "nháy mắt, khều chân"
  },
  {
    "id": 6621,
    "book": "proverbs                                ",
    "chapter": "6",
    "verse": "14",
    "text": "Lòng đầy gian tà, mưu toan điều ác,"
  },
  {
    "id": 6622,
    "book": "proverbs                                ",
    "chapter": "6",
    "verse": "15",
    "text": "Nhưng họ sẽ bị tai họa bất ngờ,"
  },
  {
    "id": 6623,
    "book": "proverbs                                ",
    "chapter": "6",
    "verse": "16",
    "text": "Sáu điều Chúa Hằng Hữu ghét—"
  },
  {
    "id": 6624,
    "book": "proverbs                                ",
    "chapter": "6",
    "verse": "17",
    "text": "Mắt kiêu căng,"
  },
  {
    "id": 6625,
    "book": "proverbs                                ",
    "chapter": "6",
    "verse": "18",
    "text": "lòng mưu toan những việc hung tàn,"
  },
  {
    "id": 6626,
    "book": "proverbs                                ",
    "chapter": "6",
    "verse": "19",
    "text": "làm chứng gian khai mang hại người,"
  },
  {
    "id": 6627,
    "book": "proverbs                                ",
    "chapter": "6",
    "verse": "20",
    "text": "Con ơi, phải nghe lời cha khuyên dạy,"
  },
  {
    "id": 6628,
    "book": "proverbs                                ",
    "chapter": "6",
    "verse": "21",
    "text": "Phải luôn luôn ghi lòng tạc dạ."
  },
  {
    "id": 6629,
    "book": "proverbs                                ",
    "chapter": "6",
    "verse": "22",
    "text": "Nó sẽ dẫn dắt con khi đi."
  },
  {
    "id": 6630,
    "book": "proverbs                                ",
    "chapter": "6",
    "verse": "23",
    "text": "Vì sự khuyên dạy là ngọn đèn,"
  },
  {
    "id": 6631,
    "book": "proverbs                                ",
    "chapter": "6",
    "verse": "24",
    "text": "Gìn giữ con khỏi đàn bà tội lỗi,"
  },
  {
    "id": 6632,
    "book": "proverbs                                ",
    "chapter": "6",
    "verse": "25",
    "text": "Lòng con đừng thèm muốn nhan sắc nó."
  },
  {
    "id": 6633,
    "book": "proverbs                                ",
    "chapter": "6",
    "verse": "26",
    "text": "Mê kỹ nữ thì sẽ lâm cảnh vong gia bại sản,6:26 Nt chỉ còn một mẩu bánh"
  },
  {
    "id": 6634,
    "book": "proverbs                                ",
    "chapter": "6",
    "verse": "27",
    "text": "Có ai mang lửa trong lòng,"
  },
  {
    "id": 6635,
    "book": "proverbs                                ",
    "chapter": "6",
    "verse": "28",
    "text": "Có ai bước trên than hồng,"
  },
  {
    "id": 6636,
    "book": "proverbs                                ",
    "chapter": "6",
    "verse": "29",
    "text": "Ai ngoại tình với vợ người cũng vậy."
  },
  {
    "id": 6637,
    "book": "proverbs                                ",
    "chapter": "6",
    "verse": "30",
    "text": "Người ta có thể khoan hồng cho kẻ trộm,"
  },
  {
    "id": 6638,
    "book": "proverbs                                ",
    "chapter": "6",
    "verse": "31",
    "text": "Nhưng nếu bị bắt nó phải bồi thường gấp bảy lần,"
  },
  {
    "id": 6639,
    "book": "proverbs                                ",
    "chapter": "6",
    "verse": "32",
    "text": "Nhưng người phạm tội ngoại tình thật ngu dại,"
  },
  {
    "id": 6640,
    "book": "proverbs                                ",
    "chapter": "6",
    "verse": "33",
    "text": "Danh liệt, thân bại."
  },
  {
    "id": 6641,
    "book": "proverbs                                ",
    "chapter": "6",
    "verse": "34",
    "text": "Người chồng sẽ ghen tuông giận dữ,"
  },
  {
    "id": 6642,
    "book": "proverbs                                ",
    "chapter": "6",
    "verse": "35",
    "text": "Anh ta không nhận tiền chuộc lỗi,"
  }
]