[
  {
    "id": 6523,
    "book": "proverbs                                ",
    "chapter": "3",
    "verse": "1",
    "text": "Con ơi, đừng quên lời ta dạy."
  },
  {
    "id": 6524,
    "book": "proverbs                                ",
    "chapter": "3",
    "verse": "2",
    "text": "Nếu con làm vậy, con sẽ được gia tăng tuổi thọ,"
  },
  {
    "id": 6525,
    "book": "proverbs                                ",
    "chapter": "3",
    "verse": "3",
    "text": "Đừng để nhân từ, chân thật xa lìa con!"
  },
  {
    "id": 6526,
    "book": "proverbs                                ",
    "chapter": "3",
    "verse": "4",
    "text": "Như thế, trước mặt Đức Chúa Trời và loài người,"
  },
  {
    "id": 6527,
    "book": "proverbs                                ",
    "chapter": "3",
    "verse": "5",
    "text": "Hãy hết lòng tin cậy Chúa Hằng Hữu;"
  },
  {
    "id": 6528,
    "book": "proverbs                                ",
    "chapter": "3",
    "verse": "6",
    "text": "Trong các việc làm của con, hãy cầu xin Ngài,"
  },
  {
    "id": 6529,
    "book": "proverbs                                ",
    "chapter": "3",
    "verse": "7",
    "text": "Đừng khôn ngoan theo mắt mình."
  },
  {
    "id": 6530,
    "book": "proverbs                                ",
    "chapter": "3",
    "verse": "8",
    "text": "Như thế, thân xác con sẽ mạnh khỏe"
  },
  {
    "id": 6531,
    "book": "proverbs                                ",
    "chapter": "3",
    "verse": "9",
    "text": "Hãy dùng tài sản và hoa lợi đầu mùa"
  },
  {
    "id": 6532,
    "book": "proverbs                                ",
    "chapter": "3",
    "verse": "10",
    "text": "Như thế, kho thóc con đầy dẫy,"
  },
  {
    "id": 6533,
    "book": "proverbs                                ",
    "chapter": "3",
    "verse": "11",
    "text": "Con ơi, đừng coi thường sự sửa phạt của Chúa Hằng Hữu,"
  },
  {
    "id": 6534,
    "book": "proverbs                                ",
    "chapter": "3",
    "verse": "12",
    "text": "Vì Chúa Hằng Hữu sửa dạy người Ngài yêu,"
  },
  {
    "id": 6535,
    "book": "proverbs                                ",
    "chapter": "3",
    "verse": "13",
    "text": "Phước cho người tìm được khôn ngoan,"
  },
  {
    "id": 6536,
    "book": "proverbs                                ",
    "chapter": "3",
    "verse": "14",
    "text": "Vì được nó có ích hơn được bạc,"
  },
  {
    "id": 6537,
    "book": "proverbs                                ",
    "chapter": "3",
    "verse": "15",
    "text": "Khôn ngoan quý hơn hồng ngọc;"
  },
  {
    "id": 6538,
    "book": "proverbs                                ",
    "chapter": "3",
    "verse": "16",
    "text": "Tay phải của khôn ngoan có trường thọ,"
  },
  {
    "id": 6539,
    "book": "proverbs                                ",
    "chapter": "3",
    "verse": "17",
    "text": "Các đường của khôn ngoan đều thích thú;"
  },
  {
    "id": 6540,
    "book": "proverbs                                ",
    "chapter": "3",
    "verse": "18",
    "text": "Nó là cây vĩnh sinh cho người nắm lấy;"
  },
  {
    "id": 6541,
    "book": "proverbs                                ",
    "chapter": "3",
    "verse": "19",
    "text": "Chúa Hằng Hữu do khôn ngoan sáng tạo đất;"
  },
  {
    "id": 6542,
    "book": "proverbs                                ",
    "chapter": "3",
    "verse": "20",
    "text": "Do tri thức Ngài, biển sâu mở toang,"
  },
  {
    "id": 6543,
    "book": "proverbs                                ",
    "chapter": "3",
    "verse": "21",
    "text": "Con ơi, hãy giữ khôn ngoan thật và thận trọng."
  },
  {
    "id": 6544,
    "book": "proverbs                                ",
    "chapter": "3",
    "verse": "22",
    "text": "Nó là sức sống trong tâm hồn,"
  },
  {
    "id": 6545,
    "book": "proverbs                                ",
    "chapter": "3",
    "verse": "23",
    "text": "Nhờ đó, con tiến bước an toàn,"
  },
  {
    "id": 6546,
    "book": "proverbs                                ",
    "chapter": "3",
    "verse": "24",
    "text": "Khi nằm, con không phải lo lắng,"
  },
  {
    "id": 6547,
    "book": "proverbs                                ",
    "chapter": "3",
    "verse": "25",
    "text": "Khi thấy người ác gặp tai họa hay hủy diệt bất ngờ,"
  },
  {
    "id": 6548,
    "book": "proverbs                                ",
    "chapter": "3",
    "verse": "26",
    "text": "vì Chúa Hằng Hữu là Đấng con tin cậy."
  },
  {
    "id": 6549,
    "book": "proverbs                                ",
    "chapter": "3",
    "verse": "27",
    "text": "Đừng từ chối làm lành cho người xứng đáng"
  },
  {
    "id": 6550,
    "book": "proverbs                                ",
    "chapter": "3",
    "verse": "28",
    "text": "Nếu hiện tại con có thể giúp người láng giềng, thì đừng nói:"
  },
  {
    "id": 6551,
    "book": "proverbs                                ",
    "chapter": "3",
    "verse": "29",
    "text": "Đừng mưu đồ ám hại láng giềng,"
  },
  {
    "id": 6552,
    "book": "proverbs                                ",
    "chapter": "3",
    "verse": "30",
    "text": "Đừng vô cớ cáo tội ai,"
  },
  {
    "id": 6553,
    "book": "proverbs                                ",
    "chapter": "3",
    "verse": "31",
    "text": "Đừng thèm muốn địa vị người dữ dằn,"
  },
  {
    "id": 6554,
    "book": "proverbs                                ",
    "chapter": "3",
    "verse": "32",
    "text": "Vì Chúa Hằng Hữu ghét người hư hoại,"
  },
  {
    "id": 6555,
    "book": "proverbs                                ",
    "chapter": "3",
    "verse": "33",
    "text": "Chúa Hằng Hữu nguyền rủa nhà của người ác,"
  },
  {
    "id": 6556,
    "book": "proverbs                                ",
    "chapter": "3",
    "verse": "34",
    "text": "Chúa Hằng Hữu cười chê người kiêu căng báng bổ,"
  },
  {
    "id": 6557,
    "book": "proverbs                                ",
    "chapter": "3",
    "verse": "35",
    "text": "Vinh dự là gia tài Chúa dành cho người khôn,"
  }
]