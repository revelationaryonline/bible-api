[
  {
    "id": 7209,
    "book": "proverbs                                ",
    "chapter": "26",
    "verse": "1",
    "text": "Vinh dự đến với người khờ dại,"
  },
  {
    "id": 7210,
    "book": "proverbs                                ",
    "chapter": "26",
    "verse": "2",
    "text": "Lời nguyền rủa vô cớ chẳng tới đâu,"
  },
  {
    "id": 7211,
    "book": "proverbs                                ",
    "chapter": "26",
    "verse": "3",
    "text": "Roi dành cho ngựa, cương cho lừa,"
  },
  {
    "id": 7212,
    "book": "proverbs                                ",
    "chapter": "26",
    "verse": "4",
    "text": "Đừng đối đáp người khờ dại như sự khờ dại của nó,"
  },
  {
    "id": 7213,
    "book": "proverbs                                ",
    "chapter": "26",
    "verse": "5",
    "text": "Phải dùng lý luận ngớ ngẩn đáp người khờ dại,"
  },
  {
    "id": 7214,
    "book": "proverbs                                ",
    "chapter": "26",
    "verse": "6",
    "text": "Dùng một đần truyền tin tức,"
  },
  {
    "id": 7215,
    "book": "proverbs                                ",
    "chapter": "26",
    "verse": "7",
    "text": "Châm ngôn trong miệng người khờ dại,"
  },
  {
    "id": 7216,
    "book": "proverbs                                ",
    "chapter": "26",
    "verse": "8",
    "text": "Ca tụng người khờ dại"
  },
  {
    "id": 7217,
    "book": "proverbs                                ",
    "chapter": "26",
    "verse": "9",
    "text": "Châm ngôn trong miệng người ngu dại,"
  },
  {
    "id": 7218,
    "book": "proverbs                                ",
    "chapter": "26",
    "verse": "10",
    "text": "Mướn người dại, người lang thang làm lụng,"
  },
  {
    "id": 7219,
    "book": "proverbs                                ",
    "chapter": "26",
    "verse": "11",
    "text": "Người ngu lặp lại điều khờ dại nó đã trót làm,"
  },
  {
    "id": 7220,
    "book": "proverbs                                ",
    "chapter": "26",
    "verse": "12",
    "text": "Một người tự phụ cho mình là khôn,"
  },
  {
    "id": 7221,
    "book": "proverbs                                ",
    "chapter": "26",
    "verse": "13",
    "text": "Người lười biếng nói rằng: “Có con sư tử ngoài đường!"
  },
  {
    "id": 7222,
    "book": "proverbs                                ",
    "chapter": "26",
    "verse": "14",
    "text": "Cửa xoay trên bản lề thể nào,"
  },
  {
    "id": 7223,
    "book": "proverbs                                ",
    "chapter": "26",
    "verse": "15",
    "text": "Người biếng nhác đặt tay mình vào đĩa,"
  },
  {
    "id": 7224,
    "book": "proverbs                                ",
    "chapter": "26",
    "verse": "16",
    "text": "Tuy nhiên, hắn tự cho rằng mình khôn ngoan"
  },
  {
    "id": 7225,
    "book": "proverbs                                ",
    "chapter": "26",
    "verse": "17",
    "text": "Người đi ngoài đường thấy đám cãi nhau,"
  },
  {
    "id": 7226,
    "book": "proverbs                                ",
    "chapter": "26",
    "verse": "18",
    "text": "Người nào lừa gạt bạn mình"
  },
  {
    "id": 7227,
    "book": "proverbs                                ",
    "chapter": "26",
    "verse": "19",
    "text": "Cũng như người điên ném than lửa,"
  },
  {
    "id": 7228,
    "book": "proverbs                                ",
    "chapter": "26",
    "verse": "20",
    "text": "Không có lửa nếu không củi, không dầu,"
  },
  {
    "id": 7229,
    "book": "proverbs                                ",
    "chapter": "26",
    "verse": "21",
    "text": "Người nhanh giận nhạy chuyện rầy rà,"
  },
  {
    "id": 7230,
    "book": "proverbs                                ",
    "chapter": "26",
    "verse": "22",
    "text": "Lời rỉ tai như của ngon vật lạ,"
  },
  {
    "id": 7231,
    "book": "proverbs                                ",
    "chapter": "26",
    "verse": "23",
    "text": "Lời hoa mỹ che đậy lòng độc ác,"
  },
  {
    "id": 7232,
    "book": "proverbs                                ",
    "chapter": "26",
    "verse": "24",
    "text": "Người quỷ quyệt dùng lời xảo trá,"
  },
  {
    "id": 7233,
    "book": "proverbs                                ",
    "chapter": "26",
    "verse": "25",
    "text": "Khi nó nói lời dịu ngọt đừng tin,"
  },
  {
    "id": 7234,
    "book": "proverbs                                ",
    "chapter": "26",
    "verse": "26",
    "text": "Chúng nói nhân nói nghĩa đủ điều,"
  },
  {
    "id": 7235,
    "book": "proverbs                                ",
    "chapter": "26",
    "verse": "27",
    "text": "Ai gài bẫy sẽ rơi vào bẫy,"
  },
  {
    "id": 7236,
    "book": "proverbs                                ",
    "chapter": "26",
    "verse": "28",
    "text": "Nói dối, nói nịnh người nó chẳng thương,"
  }
]