    "book": "proverbs                                ",
    "chapter": "17",
    "verse": "7",
    "text": "Lời trang nhã không xứng người ngu;"
  },
  {
    "id": 6948,
    "book": "proverbs                                ",
    "chapter": "17",
    "verse": "8",
    "text": "Của hối lộ như cái bùa trong tay người cầu cạnh;"
  },
  {
