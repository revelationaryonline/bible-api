    "book": "proverbs                                ",
    "chapter": "17",
    "verse": "13",
    "text": "Người nỡ lấy ác báo thiện,"
  },
  {
    "id": 6954,
    "book": "proverbs                                ",
    "chapter": "17",
    "verse": "14",
    "text": "Tranh chấp khởi đầu như khơi nguồn nước chảy,"
  },
  {
    "id": 6955,
    "book": "proverbs                                ",
    "chapter": "17",
    "verse": "15",
    "text": "Tha cho người có tội và lên án người vô tội—"
