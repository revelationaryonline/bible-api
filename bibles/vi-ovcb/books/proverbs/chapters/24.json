[
  {
    "id": 7147,
    "book": "proverbs                                ",
    "chapter": "24",
    "verse": "1",
    "text": "Chớ ganh tị người ác,"
  },
  {
    "id": 7148,
    "book": "proverbs                                ",
    "chapter": "24",
    "verse": "2",
    "text": "Vì lòng chúng đầy âm mưu bạo tàn,"
  },
  {
    "id": 7149,
    "book": "proverbs                                ",
    "chapter": "24",
    "verse": "3",
    "text": "Nhà cửa xây trên nền khôn ngoan"
  },
  {
    "id": 7150,
    "book": "proverbs                                ",
    "chapter": "24",
    "verse": "4",
    "text": "Do tri thức các phòng"
  },
  {
    "id": 7151,
    "book": "proverbs                                ",
    "chapter": "24",
    "verse": "5",
    "text": "Người khôn ngoan là người có sức lớn,"
  },
  {
    "id": 7152,
    "book": "proverbs                                ",
    "chapter": "24",
    "verse": "6",
    "text": "Đánh giặc phải nhờ mưu khôn ngoan;"
  },
  {
    "id": 7153,
    "book": "proverbs                                ",
    "chapter": "24",
    "verse": "7",
    "text": "Với người dại, khôn ngoan là điều cao xa quá."
  },
  {
    "id": 7154,
    "book": "proverbs                                ",
    "chapter": "24",
    "verse": "8",
    "text": "Ai mưu tính điều ác,"
  },
  {
    "id": 7155,
    "book": "proverbs                                ",
    "chapter": "24",
    "verse": "9",
    "text": "Âm mưu của người dại là tội lỗi;"
  },
  {
    "id": 7156,
    "book": "proverbs                                ",
    "chapter": "24",
    "verse": "10",
    "text": "Chỉ người yếu hèn"
  },
  {
    "id": 7157,
    "book": "proverbs                                ",
    "chapter": "24",
    "verse": "11",
    "text": "Hãy cứu người bị đưa đến cõi chết;"
  },
  {
    "id": 7158,
    "book": "proverbs                                ",
    "chapter": "24",
    "verse": "12",
    "text": "Đừng tự nói: “Chúng tôi chẳng biết chuyện gì cả.”"
  },
  {
    "id": 7159,
    "book": "proverbs                                ",
    "chapter": "24",
    "verse": "13",
    "text": "Con ơi, hãy ăn mật ong vì nó tốt,"
  },
  {
    "id": 7160,
    "book": "proverbs                                ",
    "chapter": "24",
    "verse": "14",
    "text": "Cũng hãy biết rằng khôn ngoan ngọt ngào cho linh hồn con."
  },
  {
    "id": 7161,
    "book": "proverbs                                ",
    "chapter": "24",
    "verse": "15",
    "text": "Đừng rình rập nhà người công chính,"
  },
  {
    "id": 7162,
    "book": "proverbs                                ",
    "chapter": "24",
    "verse": "16",
    "text": "Vì người công chính vẫn đứng dậy, dù bị ngã bảy lần."
  },
  {
    "id": 7163,
    "book": "proverbs                                ",
    "chapter": "24",
    "verse": "17",
    "text": "Khi kẻ địch sa cơ, con chớ mừng;"
  },
  {
    "id": 7164,
    "book": "proverbs                                ",
    "chapter": "24",
    "verse": "18",
    "text": "Kẻo e Chúa Hằng Hữu không bằng lòng"
  },
  {
    "id": 7165,
    "book": "proverbs                                ",
    "chapter": "24",
    "verse": "19",
    "text": "Chớ nóng lòng vì công việc người ác,"
  },
  {
    "id": 7166,
    "book": "proverbs                                ",
    "chapter": "24",
    "verse": "20",
    "text": "Đời người ác không có tương lai;"
  },
  {
    "id": 7167,
    "book": "proverbs                                ",
    "chapter": "24",
    "verse": "21",
    "text": "Con ơi, phải kính sợ Chúa và tôn trọng vua."
  },
  {
    "id": 7168,
    "book": "proverbs                                ",
    "chapter": "24",
    "verse": "22",
    "text": "vì họa tai sẽ đến bất ngờ."
  },
  {
    "id": 7169,
    "book": "proverbs                                ",
    "chapter": "24",
    "verse": "23",
    "text": "Đây là lời của người khôn ngoan:"
  },
  {
    "id": 7170,
    "book": "proverbs                                ",
    "chapter": "24",
    "verse": "24",
    "text": "Ai tuyên bố với người ác rằng “Anh vô tội,”"
  },
  {
    "id": 7171,
    "book": "proverbs                                ",
    "chapter": "24",
    "verse": "25",
    "text": "Ai trách phạt người ác, sẽ được mọi người ưa thích;"
  },
  {
    "id": 7172,
    "book": "proverbs                                ",
    "chapter": "24",
    "verse": "26",
    "text": "Lời nói thẳng"
  },
  {
    "id": 7173,
    "book": "proverbs                                ",
    "chapter": "24",
    "verse": "27",
    "text": "Lo làm ăn trong ngoài chu tất,"
  },
  {
    "id": 7174,
    "book": "proverbs                                ",
    "chapter": "24",
    "verse": "28",
    "text": "Đừng vô cớ làm chứng hại láng giềng;"
  },
  {
    "id": 7175,
    "book": "proverbs                                ",
    "chapter": "24",
    "verse": "29",
    "text": "Chớ nói: “Tôi báo trả lại điều nó làm cho tôi!"
  },
  {
    "id": 7176,
    "book": "proverbs                                ",
    "chapter": "24",
    "verse": "30",
    "text": "Ta có qua ruộng một người kém siêng năng,"
  },
  {
    "id": 7177,
    "book": "proverbs                                ",
    "chapter": "24",
    "verse": "31",
    "text": "Cỏ mọc um tùm, gai phủ giăng."
  },
  {
    "id": 7178,
    "book": "proverbs                                ",
    "chapter": "24",
    "verse": "32",
    "text": "Quan sát cảnh ấy, ta để ý,"
  },
  {
    "id": 7179,
    "book": "proverbs                                ",
    "chapter": "24",
    "verse": "33",
    "text": "Ngủ một chút, mơ màng thêm một chút,"
  },
  {
    "id": 7180,
    "book": "proverbs                                ",
    "chapter": "24",
    "verse": "34",
    "text": "cảnh nghèo đến như kẻ trộm;"
  }
]