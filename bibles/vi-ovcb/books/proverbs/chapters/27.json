[
  {
    "id": 7237,
    "book": "proverbs                                ",
    "chapter": "27",
    "verse": "1",
    "text": "Chớ khoe khoang về ngày mai,"
  },
  {
    "id": 7238,
    "book": "proverbs                                ",
    "chapter": "27",
    "verse": "2",
    "text": "Hãy để người khác khen con, miệng con chẳng nên làm;"
  },
  {
    "id": 7239,
    "book": "proverbs                                ",
    "chapter": "27",
    "verse": "3",
    "text": "Đá thì nặng và cát cũng nặng,"
  },
  {
    "id": 7240,
    "book": "proverbs                                ",
    "chapter": "27",
    "verse": "4",
    "text": "Sự phẫn nộ thật độc ác, cơn giận thật bạo tàn,"
  },
  {
    "id": 7241,
    "book": "proverbs                                ",
    "chapter": "27",
    "verse": "5",
    "text": "Ra mặt quở trách tỏ tường"
  },
  {
    "id": 7242,
    "book": "proverbs                                ",
    "chapter": "27",
    "verse": "6",
    "text": "Thương tổn do bạn gây ra, ấy là bởi lòng thành;"
  },
  {
    "id": 7243,
    "book": "proverbs                                ",
    "chapter": "27",
    "verse": "7",
    "text": "Khi no, chê cả mật,"
  },
  {
    "id": 7244,
    "book": "proverbs                                ",
    "chapter": "27",
    "verse": "8",
    "text": "Người lưu lạc xa quê hương,"
  },
  {
    "id": 7245,
    "book": "proverbs                                ",
    "chapter": "27",
    "verse": "9",
    "text": "Dầu và thuốc thơm làm khoan khoái tâm hồn,"
  },
  {
    "id": 7246,
    "book": "proverbs                                ",
    "chapter": "27",
    "verse": "10",
    "text": "Chớ từ bỏ bạn—dù bạn mình hoặc bạn của cha."
  },
  {
    "id": 7247,
    "book": "proverbs                                ",
    "chapter": "27",
    "verse": "11",
    "text": "Con ơi, hãy khôn ngoan, và làm cho lòng cha sung sướng."
  },
  {
    "id": 7248,
    "book": "proverbs                                ",
    "chapter": "27",
    "verse": "12",
    "text": "Người khôn tránh né nguy nan."
  },
  {
    "id": 7249,
    "book": "proverbs                                ",
    "chapter": "27",
    "verse": "13",
    "text": "Phải nắm lấy áo ai bảo lãnh cho người không quen."
  },
  {
    "id": 7250,
    "book": "proverbs                                ",
    "chapter": "27",
    "verse": "14",
    "text": "Lớn tiếng chúc phước người hàng xóm lúc sáng sớm,"
  },
  {
    "id": 7251,
    "book": "proverbs                                ",
    "chapter": "27",
    "verse": "15",
    "text": "Nhà dột trong ngày mưa tháng gió"
  },
  {
    "id": 7252,
    "book": "proverbs                                ",
    "chapter": "27",
    "verse": "16",
    "text": "Bịt miệng nàng, khác chi đưa tay cản gió"
  },
  {
    "id": 7253,
    "book": "proverbs                                ",
    "chapter": "27",
    "verse": "17",
    "text": "Sắt mài sắt,"
  },
  {
    "id": 7254,
    "book": "proverbs                                ",
    "chapter": "27",
    "verse": "18",
    "text": "Săn sóc cây vả sẽ được ăn quả;"
  },
  {
    "id": 7255,
    "book": "proverbs                                ",
    "chapter": "27",
    "verse": "19",
    "text": "Nước phản chiếu khuôn mặt,"
  },
  {
    "id": 7256,
    "book": "proverbs                                ",
    "chapter": "27",
    "verse": "20",
    "text": "Mắt đầy tham vọng, chẳng bao giờ chán;"
  },
  {
    "id": 7257,
    "book": "proverbs                                ",
    "chapter": "27",
    "verse": "21",
    "text": "Lửa dùng thử bạc, thử vàng,"
  },
  {
    "id": 7258,
    "book": "proverbs                                ",
    "chapter": "27",
    "verse": "22",
    "text": "Dùng chày giã người dại như giã thóc,"
  },
  {
    "id": 7259,
    "book": "proverbs                                ",
    "chapter": "27",
    "verse": "23",
    "text": "Hãy biết rõ tình trạng bầy chiên của con,"
  },
  {
    "id": 7260,
    "book": "proverbs                                ",
    "chapter": "27",
    "verse": "24",
    "text": "vì giàu có chóng qua,"
  },
  {
    "id": 7261,
    "book": "proverbs                                ",
    "chapter": "27",
    "verse": "25",
    "text": "Khi cỏ khô đã cắt và cỏ non lại mọc,"
  },
  {
    "id": 7262,
    "book": "proverbs                                ",
    "chapter": "27",
    "verse": "26",
    "text": "thì chiên cung cấp cho con quần áo che thân,"
  },
  {
    "id": 7263,
    "book": "proverbs                                ",
    "chapter": "27",
    "verse": "27",
    "text": "Sữa dê sẽ dồi dào để nuôi con, nuôi cả gia đình"
  }
]