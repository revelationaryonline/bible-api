[
  {
    "id": 7052,
    "book": "proverbs                                ",
    "chapter": "21",
    "verse": "1",
    "text": "Lòng vua như nước trong tay Chúa Hằng Hữu;"
  },
  {
    "id": 7053,
    "book": "proverbs                                ",
    "chapter": "21",
    "verse": "2",
    "text": "Xét việc làm, tự cho ta phải,"
  },
  {
    "id": 7054,
    "book": "proverbs                                ",
    "chapter": "21",
    "verse": "3",
    "text": "Chúa Hằng Hữu muốn ta chính trực, công bằng,"
  },
  {
    "id": 7055,
    "book": "proverbs                                ",
    "chapter": "21",
    "verse": "4",
    "text": "Lòng tự đại, mắt kiêu cường,"
  },
  {
    "id": 7056,
    "book": "proverbs                                ",
    "chapter": "21",
    "verse": "5",
    "text": "Trù liệu và chăm chỉ thì no nê thịnh vượng;"
  },
  {
    "id": 7057,
    "book": "proverbs                                ",
    "chapter": "21",
    "verse": "6",
    "text": "Gia tài xây dựng bằng lưỡi dối trá,"
  },
  {
    "id": 7058,
    "book": "proverbs                                ",
    "chapter": "21",
    "verse": "7",
    "text": "Bọn bất lương chối việc công bằng,"
  },
  {
    "id": 7059,
    "book": "proverbs                                ",
    "chapter": "21",
    "verse": "8",
    "text": "Đường lối người phạm tội là quanh co;"
  },
  {
    "id": 7060,
    "book": "proverbs                                ",
    "chapter": "21",
    "verse": "9",
    "text": "Thà ở nơi góc mái nhà,"
  },
  {
    "id": 7061,
    "book": "proverbs                                ",
    "chapter": "21",
    "verse": "10",
    "text": "Người dữ chuyên làm ác,"
  },
  {
    "id": 7062,
    "book": "proverbs                                ",
    "chapter": "21",
    "verse": "11",
    "text": "Khi người nhạo báng bị hình phạt, người dại trở thành khôn ngoan;"
  },
  {
    "id": 7063,
    "book": "proverbs                                ",
    "chapter": "21",
    "verse": "12",
    "text": "Đấng Công Chính quan sát nhà người ác,"
  },
  {
    "id": 7064,
    "book": "proverbs                                ",
    "chapter": "21",
    "verse": "13",
    "text": "Bịt tai khi người nghèo khổ kêu ca,"
  },
  {
    "id": 7065,
    "book": "proverbs                                ",
    "chapter": "21",
    "verse": "14",
    "text": "Quà biếu âm thầm làm nguôi cơn giận;"
  },
  {
    "id": 7066,
    "book": "proverbs                                ",
    "chapter": "21",
    "verse": "15",
    "text": "Công lý đem vui mừng cho người lành,"
  },
  {
    "id": 7067,
    "book": "proverbs                                ",
    "chapter": "21",
    "verse": "16",
    "text": "Người từ bỏ lương tri,"
  },
  {
    "id": 7068,
    "book": "proverbs                                ",
    "chapter": "21",
    "verse": "17",
    "text": "Vui chơi khiến con nghèo nàn;"
  },
  {
    "id": 7069,
    "book": "proverbs                                ",
    "chapter": "21",
    "verse": "18",
    "text": "Người ác lãnh tai nạn thay cho người lành,"
  },
  {
    "id": 7070,
    "book": "proverbs                                ",
    "chapter": "21",
    "verse": "19",
    "text": "Thà ở nơi hoang mạc,"
  },
  {
    "id": 7071,
    "book": "proverbs                                ",
    "chapter": "21",
    "verse": "20",
    "text": "Trong tay người khôn, tài sản còn lại,"
  },
  {
    "id": 7072,
    "book": "proverbs                                ",
    "chapter": "21",
    "verse": "21",
    "text": "Hãy công bằng và nhân từ,"
  },
  {
    "id": 7073,
    "book": "proverbs                                ",
    "chapter": "21",
    "verse": "22",
    "text": "Người khôn tấn công thành trì người mạnh,"
  },
  {
    "id": 7074,
    "book": "proverbs                                ",
    "chapter": "21",
    "verse": "23",
    "text": "Ai kiểm soát miệng, cầm giữ lưỡi,"
  },
  {
    "id": 7075,
    "book": "proverbs                                ",
    "chapter": "21",
    "verse": "24",
    "text": "Người nhạo báng luôn kiêu căng, xấc xược;"
  },
  {
    "id": 7076,
    "book": "proverbs                                ",
    "chapter": "21",
    "verse": "25",
    "text": "Dục vọng của người lười biếng sẽ giết chết nó,"
  },
  {
    "id": 7077,
    "book": "proverbs                                ",
    "chapter": "21",
    "verse": "26",
    "text": "Người gian tham suốt ngày thèm thuồng"
  },
  {
    "id": 7078,
    "book": "proverbs                                ",
    "chapter": "21",
    "verse": "27",
    "text": "Của lễ người ác đã là điều đáng ghét;"
  },
  {
    "id": 7079,
    "book": "proverbs                                ",
    "chapter": "21",
    "verse": "28",
    "text": "Lời chứng dối tự nó triệt tiêu,"
  },
  {
    "id": 7080,
    "book": "proverbs                                ",
    "chapter": "21",
    "verse": "29",
    "text": "Người ác làm cho mặt mày chai đá,"
  },
  {
    "id": 7081,
    "book": "proverbs                                ",
    "chapter": "21",
    "verse": "30",
    "text": "Chẳng ai chống lại được Chúa Hằng Hữu,"
  },
  {
    "id": 7082,
    "book": "proverbs                                ",
    "chapter": "21",
    "verse": "31",
    "text": "Người ta chuẩn bị ngựa cho ngày chinh chiến,"
  }
]