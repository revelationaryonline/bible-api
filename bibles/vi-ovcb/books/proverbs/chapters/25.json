[
  {
    "id": 7181,
    "book": "proverbs                                ",
    "chapter": "25",
    "verse": "1",
    "text": "Sau đây là những châm ngôn của Sa-lô-môn, do triều thần của Vua Ê-xê-chia, nước Giu-đa sưu tầm và sao chép:"
  },
  {
    "id": 7182,
    "book": "proverbs                                ",
    "chapter": "25",
    "verse": "2",
    "text": "Vinh quang của Đức Chúa Trời là giữ kín một điều gì,"
  },
  {
    "id": 7183,
    "book": "proverbs                                ",
    "chapter": "25",
    "verse": "3",
    "text": "Không ai biết trời cao, đất thấp bao nhiêu,"
  },
  {
    "id": 7184,
    "book": "proverbs                                ",
    "chapter": "25",
    "verse": "4",
    "text": "Khi khử sạch cáu cặn khỏi bạc,"
  },
  {
    "id": 7185,
    "book": "proverbs                                ",
    "chapter": "25",
    "verse": "5",
    "text": "Khi trừ diệt người xấu trước mặt vua,"
  },
  {
    "id": 7186,
    "book": "proverbs                                ",
    "chapter": "25",
    "verse": "6",
    "text": "Trước mặt vua, con chớ phô trương,"
  },
  {
    "id": 7187,
    "book": "proverbs                                ",
    "chapter": "25",
    "verse": "7",
    "text": "Thà ngồi thấp, rồi được nhấc lên cao,"
  },
  {
    "id": 7188,
    "book": "proverbs                                ",
    "chapter": "25",
    "verse": "8",
    "text": "Đừng hấp tấp kiện thưa ai cả,"
  },
  {
    "id": 7189,
    "book": "proverbs                                ",
    "chapter": "25",
    "verse": "9",
    "text": "Tốt hơn cả là hai bên ngồi đối chất,"
  },
  {
    "id": 7190,
    "book": "proverbs                                ",
    "chapter": "25",
    "verse": "10",
    "text": "Kẻo đối phương nghe được, lên án con nói xấu,"
  },
  {
    "id": 7191,
    "book": "proverbs                                ",
    "chapter": "25",
    "verse": "11",
    "text": "Lời bàn đúng lúc,"
  },
  {
    "id": 7192,
    "book": "proverbs                                ",
    "chapter": "25",
    "verse": "12",
    "text": "Nghe lời chỉ trích của người khôn ngoan,"
  },
  {
    "id": 7193,
    "book": "proverbs                                ",
    "chapter": "25",
    "verse": "13",
    "text": "Một sứ giả trung tín làm thỏa dạ chủ mình."
  },
  {
    "id": 7194,
    "book": "proverbs                                ",
    "chapter": "25",
    "verse": "14",
    "text": "Hứa cho, nhưng chẳng giữ lời,"
  },
  {
    "id": 7195,
    "book": "proverbs                                ",
    "chapter": "25",
    "verse": "15",
    "text": "Lòng kiên nhẫn thắng hơn cường lực,"
  },
  {
    "id": 7196,
    "book": "proverbs                                ",
    "chapter": "25",
    "verse": "16",
    "text": "Con có thích mật ong?"
  },
  {
    "id": 7197,
    "book": "proverbs                                ",
    "chapter": "25",
    "verse": "17",
    "text": "Chớ đến nhà láng giềng thường quá,"
  },
  {
    "id": 7198,
    "book": "proverbs                                ",
    "chapter": "25",
    "verse": "18",
    "text": "Lời chứng gian vô cùng hiểm nguy,"
  },
  {
    "id": 7199,
    "book": "proverbs                                ",
    "chapter": "25",
    "verse": "19",
    "text": "Đặt lòng tin vào một người không đáng tin cậy,"
  },
  {
    "id": 7200,
    "book": "proverbs                                ",
    "chapter": "25",
    "verse": "20",
    "text": "Hát xướng trước người đang âu sầu buồn bã,"
  },
  {
    "id": 7201,
    "book": "proverbs                                ",
    "chapter": "25",
    "verse": "21",
    "text": "Đói cho ăn, khát cho uống,"
  },
  {
    "id": 7202,
    "book": "proverbs                                ",
    "chapter": "25",
    "verse": "22",
    "text": "Làm như vậy con sẽ chất than lửa đỏ trên đầu họ,"
  },
  {
    "id": 7203,
    "book": "proverbs                                ",
    "chapter": "25",
    "verse": "23",
    "text": "Gió bấc đem mưa,"
  },
  {
    "id": 7204,
    "book": "proverbs                                ",
    "chapter": "25",
    "verse": "24",
    "text": "Thà ở nơi góc mái nhà,"
  },
  {
    "id": 7205,
    "book": "proverbs                                ",
    "chapter": "25",
    "verse": "25",
    "text": "Được tin lành từ xứ xa đưa vào,"
  },
  {
    "id": 7206,
    "book": "proverbs                                ",
    "chapter": "25",
    "verse": "26",
    "text": "Người công chính ngã quỵ trước người gian ác,"
  },
  {
    "id": 7207,
    "book": "proverbs                                ",
    "chapter": "25",
    "verse": "27",
    "text": "Ăn nhiều mật có hại,"
  },
  {
    "id": 7208,
    "book": "proverbs                                ",
    "chapter": "25",
    "verse": "28",
    "text": "Ai không chế ngự lòng mình, chẳng lo tự chủ,"
  }
]