[
  {
    "id": 6585,
    "book": "proverbs                                ",
    "chapter": "5",
    "verse": "1",
    "text": "Con ơi, để ý nghe lời khôn ngoan ta;"
  },
  {
    "id": 6586,
    "book": "proverbs                                ",
    "chapter": "5",
    "verse": "2",
    "text": "Để con e dè thận trọng,"
  },
  {
    "id": 6587,
    "book": "proverbs                                ",
    "chapter": "5",
    "verse": "3",
    "text": "Vì môi dâm phụ ngọt như mật ong,"
  },
  {
    "id": 6588,
    "book": "proverbs                                ",
    "chapter": "5",
    "verse": "4",
    "text": "Nhưng về sau nó đắng như ngải cứu,"
  },
  {
    "id": 6589,
    "book": "proverbs                                ",
    "chapter": "5",
    "verse": "5",
    "text": "Chân nó đưa xuống âm ty;"
  },
  {
    "id": 6590,
    "book": "proverbs                                ",
    "chapter": "5",
    "verse": "6",
    "text": "Nó không nghĩ đến con đường sống."
  },
  {
    "id": 6591,
    "book": "proverbs                                ",
    "chapter": "5",
    "verse": "7",
    "text": "Vậy, hỡi các con, hãy nghe ta."
  },
  {
    "id": 6592,
    "book": "proverbs                                ",
    "chapter": "5",
    "verse": "8",
    "text": "Hãy tránh dâm phụ thật xa!"
  },
  {
    "id": 6593,
    "book": "proverbs                                ",
    "chapter": "5",
    "verse": "9",
    "text": "Kẻo con sẽ trao cả thanh danh cho người khác,"
  },
  {
    "id": 6594,
    "book": "proverbs                                ",
    "chapter": "5",
    "verse": "10",
    "text": "Kẻo người lạ no nê tài sản con,"
  },
  {
    "id": 6595,
    "book": "proverbs                                ",
    "chapter": "5",
    "verse": "11",
    "text": "Kẻo đến cuối cùng của đời con, con than van rên rỉ"
  },
  {
    "id": 6596,
    "book": "proverbs                                ",
    "chapter": "5",
    "verse": "12",
    "text": "Con sẽ nói: “Sao ta coi khinh sự khuyên răn!"
  },
  {
    "id": 6597,
    "book": "proverbs                                ",
    "chapter": "5",
    "verse": "13",
    "text": "Sao ta không chịu vâng lời thầy?"
  },
  {
    "id": 6598,
    "book": "proverbs                                ",
    "chapter": "5",
    "verse": "14",
    "text": "Hầu như ta bị mọi tai ương,"
  },
  {
    "id": 6599,
    "book": "proverbs                                ",
    "chapter": "5",
    "verse": "15",
    "text": "Hãy uống nước nơi bể con chứa—"
  },
  {
    "id": 6600,
    "book": "proverbs                                ",
    "chapter": "5",
    "verse": "16",
    "text": "Lẽ nào dòng suối con để chảy tràn trên đường phố?"
  },
  {
    "id": 6601,
    "book": "proverbs                                ",
    "chapter": "5",
    "verse": "17",
    "text": "Nước ấy là của riêng con."
  },
  {
    "id": 6602,
    "book": "proverbs                                ",
    "chapter": "5",
    "verse": "18",
    "text": "Nguyện suối nước của con được hưởng phước."
  },
  {
    "id": 6603,
    "book": "proverbs                                ",
    "chapter": "5",
    "verse": "19",
    "text": "Nàng như nai tơ dễ thương, hươu con duyên dáng."
  },
  {
    "id": 6604,
    "book": "proverbs                                ",
    "chapter": "5",
    "verse": "20",
    "text": "Con ơi, sao dại dột mê dâm phụ,"
  },
  {
    "id": 6605,
    "book": "proverbs                                ",
    "chapter": "5",
    "verse": "21",
    "text": "Vì đường lối con người, Chúa Hằng Hữu đều thấy rõ,"
  },
  {
    "id": 6606,
    "book": "proverbs                                ",
    "chapter": "5",
    "verse": "22",
    "text": "Người ác sẽ bị chính việc ác mình sập bẫy;"
  },
  {
    "id": 6607,
    "book": "proverbs                                ",
    "chapter": "5",
    "verse": "23",
    "text": "Hắn sẽ chết vì không nghe răn dạy;"
  }
]