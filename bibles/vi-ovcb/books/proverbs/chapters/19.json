    "book": "proverbs                                ",
    "chapter": "19",
    "verse": "4",
    "text": "Khi giàu có thu hút nhiều bè bạn;"
  },
  {
    "id": 6997,
    "book": "proverbs                                ",
    "chapter": "19",
    "verse": "5",
    "text": "Nhân chứng gian chắc chắn mang hình phạt,"
  },
  {
