    "book": "proverbs                                ",
    "chapter": "19",
    "verse": "14",
    "text": "Tài sản do cha ông để lại,"
  },
  {
    "id": 7007,
    "book": "proverbs                                ",
    "chapter": "19",
    "verse": "15",
    "text": "Vì làm biếng mà người ta mê ngủ,"
  },
  {
    "id": 7008,
    "book": "proverbs                                ",
    "chapter": "19",
    "verse": "16",
    "text": "Ai giữ điều răn, giữ lấy linh hồn mình;"
  },
  {
    "id": 7009,
    "book": "proverbs                                ",
    "chapter": "19",
    "verse": "17",
    "text": "Ai giúp người nghèo, tức cho Chúa Hằng Hữu vay mượn—"
  },
  {
    "id": 7010,
    "book": "proverbs                                ",
    "chapter": "19",
    "verse": "18",
    "text": "Sửa dạy con khi còn hy vọng."
  },
  {
    "id": 7011,
    "book": "proverbs                                ",
    "chapter": "19",
    "verse": "19",
    "text": "Người nóng tính sẽ mang hậu họa."
  },
  {
    "id": 7012,
    "book": "proverbs                                ",
    "chapter": "19",
    "verse": "20",
    "text": "Biết nghe lời khuyên răn chỉ giáo,"
  },
  {
    "id": 7013,
    "book": "proverbs                                ",
    "chapter": "19",
    "verse": "21",
    "text": "Lòng con người lo bày mưu tính kế,"
  },
  {
    "id": 7014,
    "book": "proverbs                                ",
    "chapter": "19",
    "verse": "22",
    "text": "Nhân hậu khiến mọi người mến phục."
  },
  {
    "id": 7015,
    "book": "proverbs                                ",
    "chapter": "19",
    "verse": "23",
    "text": "Kính sợ Chúa Hằng Hữu là nguồn sự sống,"
  },
  {
    "id": 7016,
    "book": "proverbs                                ",
    "chapter": "19",
    "verse": "24",
    "text": "Người biếng nhác đặt tay mình vào đĩa,"
  },
  {
    "id": 7017,
    "book": "proverbs                                ",
    "chapter": "19",
    "verse": "25",
    "text": "Trừng phạt người nhạo báng, người chân chất sẽ học khôn;"
  },
  {
    "id": 7018,
    "book": "proverbs                                ",
    "chapter": "19",
    "verse": "26",
    "text": "Hành hung cha và xô đuổi mẹ,"
  },
  {
    "id": 7019,
    "book": "proverbs                                ",
    "chapter": "19",
    "verse": "27",
    "text": "Con ơi, chớ nên nghe tà thuyết,"
  },
  {
    "id": 7020,
    "book": "proverbs                                ",
    "chapter": "19",
    "verse": "28",
    "text": "Nhân chứng gian nhạo cười công lý;"
  },
  {
    "id": 7021,
    "book": "proverbs                                ",
    "chapter": "19",
    "verse": "29",
    "text": "Hình phạt để dành cho người nhạo báng,"
  }
