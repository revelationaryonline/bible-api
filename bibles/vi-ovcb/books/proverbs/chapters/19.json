    "book": "proverbs                                ",
    "chapter": "19",
    "verse": "6",
    "text": "Bậc cao quý được lắm người cầu cạnh;"
  },
  {
    "id": 6999,
    "book": "proverbs                                ",
    "chapter": "19",
    "verse": "7",
    "text": "Khi nghèo ngặt, ruột thịt còn xa lánh;"
  },
  {
    "id": 7000,
    "book": "proverbs                                ",
    "chapter": "19",
    "verse": "8",
    "text": "Người khôn ngoan yêu mến linh hồn mình;"
  },
  {
    "id": 7001,
    "book": "proverbs                                ",
    "chapter": "19",
    "verse": "9",
    "text": "Nhân chứng gian lãnh hình phạt chắc chắn,"
  },
  {
    "id": 7002,
    "book": "proverbs                                ",
    "chapter": "19",
    "verse": "10",
    "text": "Người ngu dại sống giàu sang không thích hợp"
