  {
    "id": 7003,
    "book": "proverbs                                ",
    "chapter": "19",
    "verse": "11",
    "text": "Người khôn ngoan kiềm hãm cơn giận dữ;"
  },
  {
    "id": 7004,
    "book": "proverbs                                ",
    "chapter": "19",
    "verse": "12",
    "text": "Khi giận dữ, vua nạt nộ như sư tử rống,"
  },
  {
    "id": 7005,
    "book": "proverbs                                ",
    "chapter": "19",
    "verse": "13",
    "text": "Con ngỗ nghịch là tai họa cho cha;"
  },
  {
