[
  {
    "id": 6670,
    "book": "proverbs                                ",
    "chapter": "8",
    "verse": "1",
    "text": "Hãy lắng nghe tiếng Khôn Ngoan kêu gọi!"
  },
  {
    "id": 6671,
    "book": "proverbs                                ",
    "chapter": "8",
    "verse": "2",
    "text": "Sự khôn ngoan ở trên các đỉnh cao,"
  },
  {
    "id": 6672,
    "book": "proverbs                                ",
    "chapter": "8",
    "verse": "3",
    "text": "Nơi cổng thành, đường vào đô thị,"
  },
  {
    "id": 6673,
    "book": "proverbs                                ",
    "chapter": "8",
    "verse": "4",
    "text": "“Ta gọi ngươi, tất cả các ngươi!"
  },
  {
    "id": 6674,
    "book": "proverbs                                ",
    "chapter": "8",
    "verse": "5",
    "text": "Người đơn sơ nên hiểu lẽ khôn ngoan."
  },
  {
    "id": 6675,
    "book": "proverbs                                ",
    "chapter": "8",
    "verse": "6",
    "text": "Hãy lắng nghe! Ta có điều quan trọng nói với ngươi."
  },
  {
    "id": 6676,
    "book": "proverbs                                ",
    "chapter": "8",
    "verse": "7",
    "text": "miệng ta truyền chân lý,"
  },
  {
    "id": 6677,
    "book": "proverbs                                ",
    "chapter": "8",
    "verse": "8",
    "text": "Mọi lời ta đều ngay thật."
  },
  {
    "id": 6678,
    "book": "proverbs                                ",
    "chapter": "8",
    "verse": "9",
    "text": "Người thông sáng hiểu ra ngay,"
  },
  {
    "id": 6679,
    "book": "proverbs                                ",
    "chapter": "8",
    "verse": "10",
    "text": "Đón nhận kiến thức, khuyên dạy ta,"
  },
  {
    "id": 6680,
    "book": "proverbs                                ",
    "chapter": "8",
    "verse": "11",
    "text": "Vì khôn ngoan quý hơn hồng ngọc."
  },
  {
    "id": 6681,
    "book": "proverbs                                ",
    "chapter": "8",
    "verse": "12",
    "text": "Ta, Khôn Ngoan, đi chung với trí phán đoán."
  },
  {
    "id": 6682,
    "book": "proverbs                                ",
    "chapter": "8",
    "verse": "13",
    "text": "Kính sợ Chúa Hằng Hữu thì ghét điều ác."
  },
  {
    "id": 6683,
    "book": "proverbs                                ",
    "chapter": "8",
    "verse": "14",
    "text": "Mưu lược và khôn khéo thuộc về ta."
  },
  {
    "id": 6684,
    "book": "proverbs                                ",
    "chapter": "8",
    "verse": "15",
    "text": "Nhờ ta mà các vua cầm quyền,"
  },
  {
    "id": 6685,
    "book": "proverbs                                ",
    "chapter": "8",
    "verse": "16",
    "text": "Nhờ ta, nhà cầm quyền chăn dân,"
  },
  {
    "id": 6686,
    "book": "proverbs                                ",
    "chapter": "8",
    "verse": "17",
    "text": "Ta yêu những người yêu ta."
  },
  {
    "id": 6687,
    "book": "proverbs                                ",
    "chapter": "8",
    "verse": "18",
    "text": "Ta có giàu sang và tôn trọng,"
  },
  {
    "id": 6688,
    "book": "proverbs                                ",
    "chapter": "8",
    "verse": "19",
    "text": "Bông trái ta quý hơn vàng mười,"
  },
  {
    "id": 6689,
    "book": "proverbs                                ",
    "chapter": "8",
    "verse": "20",
    "text": "Ta bước đi trong công chính,"
  },
  {
    "id": 6690,
    "book": "proverbs                                ",
    "chapter": "8",
    "verse": "21",
    "text": "Ta cho người yêu ta hưởng giàu sang."
  },
  {
    "id": 6691,
    "book": "proverbs                                ",
    "chapter": "8",
    "verse": "22",
    "text": "Chúa Hằng Hữu đã có ta từ buổi ban đầu,"
  },
  {
    "id": 6692,
    "book": "proverbs                                ",
    "chapter": "8",
    "verse": "23",
    "text": "Ta hiện hữu, đời đời trong quá khứ,"
  },
  {
    "id": 6693,
    "book": "proverbs                                ",
    "chapter": "8",
    "verse": "24",
    "text": "Ta hiện hữu khi chưa có đại dương vực thẳm,"
  },
  {
    "id": 6694,
    "book": "proverbs                                ",
    "chapter": "8",
    "verse": "25",
    "text": "Trước khi núi non được hình thành,"
  },
  {
    "id": 6695,
    "book": "proverbs                                ",
    "chapter": "8",
    "verse": "26",
    "text": "trước khi Chúa dựng trời xanh và đồng ruộng"
  },
  {
    "id": 6696,
    "book": "proverbs                                ",
    "chapter": "8",
    "verse": "27",
    "text": "Ta đã hiện diện, khi Chúa dựng trời xanh,"
  },
  {
    "id": 6697,
    "book": "proverbs                                ",
    "chapter": "8",
    "verse": "28",
    "text": "Ta hiện diện khi Ngài giăng mây trời,"
  },
  {
    "id": 6698,
    "book": "proverbs                                ",
    "chapter": "8",
    "verse": "29",
    "text": "Ta hiện diện khi Ngài định giới ranh biển cả,"
  },
  {
    "id": 6699,
    "book": "proverbs                                ",
    "chapter": "8",
    "verse": "30",
    "text": "ta đã hiện diện bên Ngài, làm thợ cả."
  },
  {
    "id": 6700,
    "book": "proverbs                                ",
    "chapter": "8",
    "verse": "31",
    "text": "Vui mừng trong thế giới địa đàng,"
  },
  {
    "id": 6701,
    "book": "proverbs                                ",
    "chapter": "8",
    "verse": "32",
    "text": "Cho nên các con hãy nghe ta,"
  },
  {
    "id": 6702,
    "book": "proverbs                                ",
    "chapter": "8",
    "verse": "33",
    "text": "Chịu dạy dỗ, sống khôn ngoan."
  },
  {
    "id": 6703,
    "book": "proverbs                                ",
    "chapter": "8",
    "verse": "34",
    "text": "Phước cho người nghe lời ta,"
  },
  {
    "id": 6704,
    "book": "proverbs                                ",
    "chapter": "8",
    "verse": "35",
    "text": "Vì ai tìm ta thì được sự sống,"
  },
  {
    "id": 6705,
    "book": "proverbs                                ",
    "chapter": "8",
    "verse": "36",
    "text": "Ai xúc phạm ta là tự hủy mình."
  }
]