[
  {
    "id": 15850,
    "book": "psalms                                  ",
    "chapter": "116",
    "verse": "1",
    "text": "إِنِّي أُحِبُّ الرَّبَّ لأَنَّهُ يَسْمَعُ ابْتِهَالِي وَيَسْتَجِيبُ إِلَى تَضَرُّعَاتِي."
  },
  {
    "id": 15851,
    "book": "psalms                                  ",
    "chapter": "116",
    "verse": "2",
    "text": "أَمَالَ أُذُنَهُ إِلَيَّ لِذَلِكَ أَدْعُوهُ مَادُمْتُ حَيًّا."
  },
  {
    "id": 15852,
    "book": "psalms                                  ",
    "chapter": "116",
    "verse": "3",
    "text": "طَوَّقَتْنِي حِبَالُ الْمَوْتِ. أَطْبَقَ عَلَيَّ رُعْبُ الْهَاوِيَةِ. قَاسَيْتُ ضِيقاً وَحُزْناً."
  },
  {
    "id": 15853,
    "book": "psalms                                  ",
    "chapter": "116",
    "verse": "4",
    "text": "فَدَعَوْتُ الرَّبَّ: آهِ يَا رَبُّ نَجِّ نَفْسِي!"
  },
  {
    "id": 15854,
    "book": "psalms                                  ",
    "chapter": "116",
    "verse": "5",
    "text": "الرَّبُّ حَنُونٌ وَبَارٌّ. إِلَهُنَا رَحِيمٌ."
  },
  {
    "id": 15855,
    "book": "psalms                                  ",
    "chapter": "116",
    "verse": "6",
    "text": "الرَّبُّ حَافِظُ الْبُسَطَاءِ. تَذَلَّلْتُ فَخَلَّصَنِي."
  },
  {
    "id": 15856,
    "book": "psalms                                  ",
    "chapter": "116",
    "verse": "7",
    "text": "عُودِي يَا نَفْسِي إِلَى طُمَأْنِينَتِكِ، لأَنَّ الرَّبَّ قَدْ أَحْسَنَ إِلَيْكِ."
  },
  {
    "id": 15857,
    "book": "psalms                                  ",
    "chapter": "116",
    "verse": "8",
    "text": "لأَنَّكَ يَا رَبُّ أَنْقَذْتَ نَفْسِي مِنَ الْمَوْتِ، وَعَيْنِي مِنَ الدَّمْعِ، وَقَدَمَيَّ مِنَ التَّعَثُّرِ،"
  },
  {
    "id": 15858,
    "book": "psalms                                  ",
    "chapter": "116",
    "verse": "9",
    "text": "لِذَلِكَ أَسْلُكُ بِطَاعَةٍ أَمَامَ الرَّبِّ فِي دِيَارِ الأَحْيَاءِ."
  },
  {
    "id": 15859,
    "book": "psalms                                  ",
    "chapter": "116",
    "verse": "10",
    "text": "آمَنْتُ لِذَلِكَ تَكَلَّمْتُ. أَنَا عَانَيْتُ كَثِيراً."
  },
  {
    "id": 15860,
    "book": "psalms                                  ",
    "chapter": "116",
    "verse": "11",
    "text": "وَقُلْتُ فِي حَيْرَتِي: «جَمِيعُ الْبَشَرِ كَاذِبُونَ»."
  },
  {
    "id": 15861,
    "book": "psalms                                  ",
    "chapter": "116",
    "verse": "12",
    "text": "مَاذَا أَرُدُّ لِلرَّبِّ مُقَابِلَ كُلِّ مَا أَبْدَاهُ نَحْوي مِنْ حُسْنِ الصَّنِيعِ؟"
  },
  {
    "id": 15862,
    "book": "psalms                                  ",
    "chapter": "116",
    "verse": "13",
    "text": "سَأَتَنَاوَلُ كَأْسَ الْخَلاصِ، وَأَدْعُو بِاسْمِ الرَّبِّ."
  },
  {
    "id": 15863,
    "book": "psalms                                  ",
    "chapter": "116",
    "verse": "14",
    "text": "أُوْفِي نُذُورِي لِلرَّبِّ أَمَامَ كُلِّ شَعْبِهِ."
  },
  {
    "id": 15864,
    "book": "psalms                                  ",
    "chapter": "116",
    "verse": "15",
    "text": "عَزِيزٌ فِي عَيْنَي الرَّبِّ مَوْتُ قِدِّيسِيهِ."
  },
  {
    "id": 15865,
    "book": "psalms                                  ",
    "chapter": "116",
    "verse": "16",
    "text": "آهِ يَا رَبُّ أَنَا عَبْدُكَ. أَنَا عَبْدُكَ وَابْنُ أَمَتِكَ. أَنْتَ حَلَلْتَ قُيُودِي."
  },
  {
    "id": 15866,
    "book": "psalms                                  ",
    "chapter": "116",
    "verse": "17",
    "text": "لَكَ أُقَدِّمُ ذَبَائِحَ الشُّكْرِ، وَأَدْعُو بِاسْمِكَ."
  },
  {
    "id": 15867,
    "book": "psalms                                  ",
    "chapter": "116",
    "verse": "18",
    "text": "أُوْفِي نُذُورِي لِلرَّبِّ أَمَامَ كُلِّ شَعْبِهِ."
  },
  {
    "id": 15868,
    "book": "psalms                                  ",
    "chapter": "116",
    "verse": "19",
    "text": "فِي دِيَارِ بَيْتِ الرَّبِّ، فِي وَسَطِكِ يَا أُورُشَلِيمُ. هَلِّلُويَا."
  }
]
