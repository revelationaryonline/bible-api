[
  {
    "id": 28353,
    "book": "psalms                                  ",
    "chapter": "120",
    "verse": "1",
    "text": "Een bedevaartslied. Tot Jahweh riep ik in mijn nood, En Hij heeft mij verhoord."
  },
  {
    "id": 28354,
    "book": "psalms                                  ",
    "chapter": "120",
    "verse": "2",
    "text": "Verlos mij, Jahweh, van leugenlippen En lastertongen!"
  },
  {
    "id": 28355,
    "book": "psalms                                  ",
    "chapter": "120",
    "verse": "3",
    "text": "Wat kan een lastertong u al brengen, En wat er nog bij doen:"
  },
  {
    "id": 28356,
    "book": "psalms                                  ",
    "chapter": "120",
    "verse": "4",
    "text": "Scherpgepunte oorlogspijlen, Met gloeiende houtskool!"
  },
  {
    "id": 28357,
    "book": "psalms                                  ",
    "chapter": "120",
    "verse": "5",
    "text": "Wee mij, dat ik moet toeven In de tenten van Mésjek, En dat ik moet wonen In de tenten van Kedar!"
  },
  {
    "id": 28358,
    "book": "psalms                                  ",
    "chapter": "120",
    "verse": "6",
    "text": "Reeds te lang leef ik samen Met vredeverstoorders;"
  },
  {
    "id": 28359,
    "book": "psalms                                  ",
    "chapter": "120",
    "verse": "7",
    "text": "Als ìk over vrede wil spreken, Zoeken zij strijd!"
  }
